<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <add name="DefaultConnection" connectionString="Data Source=.;Initial Catalog=ClinicDb;Integrated Security=True;MultipleActiveResultSets=true;Persist Security Info=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="EncryptionKey" value="K3l9pQw8rT7yU2iO5jX1mN6bV4cZ9aS2dF8gH7nJ3kL5qW9eR4tY7uI2oP6vM0nB" />
    <add key="Environment" value="Development" />
    <add key="SeqUrl" value="http://localhost:5341" />
    <add key="SeqApiKey" value="" />
    <add key="Email:AdminEmail" value="admin@clinicapp.com" />
    <add key="Logging:EnableEmailAlerts" value="true" />
    <add key="Logging:EnableSeq" value="true" />
    <add key="Logging:EnableConsole" value="true" />
    <add key="Logging:EnableDatabase" value="true" />
    <add key="Logging:EnableFileLogging" value="true" />
    <add key="Asanak:Username" value="09022487373" />
    <add key="Asanak:Password" value="Dhcivh@2000" />
    <add key="Asanak:SourceNumber" value="989982008544" />
    <add key="Asanak:Enabled" value="true" />
    <add key="Asanak:TimeoutMs" value="15000" />
    <add key="Asanak:MaxRetries" value="3" />
    <add key="Asanak:RetryBaseDelayMs" value="400" />
    <!-- ارسال ایمیل با Gmail — آدرس: jiroftsoft@gmail.com ؛ رمز را از فرم تنظیمات ارسال خبرنامه یا اینجا قرار دهید (برای Gmail: App Password از حساب گوگل) -->
    <add key="Email:SmtpServer" value="smtp.gmail.com" />
    <add key="Email:Port" value="587" />
    <add key="Email:Username" value="jiroftsoft@gmail.com" />
    <add key="Email:Password" value="Dhcivh@1500" />
    <add key="Email:FromAddress" value="jiroftsoft@gmail.com" />
    <add key="Email:Enabled" value="true" />
    <add key="Email:EnableSsl" value="true" />
    <add key="Otp.Length" value="6" />
    <add key="Otp.ExpiryMinutes" value="2" />
    <add key="Otp.HashKey" value="ChangeMe-To-A-Different-Very-Strong-Key-For-Production" />
    <add key="Otp.MaxSendsPerNationalCodePer5Min" value="3" />
    <add key="Otp.MaxSendsPerIpPer5Min" value="10" />
    <add key="Otp.FailedMaxAttempts" value="5" />
    <add key="Otp.LockoutMinutes" value="15" />
    <add key="AppSettings:DefaultPageSize" value="15" />
    <add key="Reporting:MaxExportRecords" value="5000" />
    <add key="Reporting:DefaultDateRangeDays" value="30" />
    <add key="SoftDelete:RetentionPeriodDays" value="3650" />
    <add key="Performance:CacheExpirationMinutes" value="5" />
    <add key="Performance:CommandTimeoutSeconds" value="180" />
    <add key="AppVersion" value="1.0.0" />
    <!-- CKEditor Configuration - نسخه رایگان (Open Source - GPL/LGPL/MPL) -->
    <add key="CKEditor:UseCDN" value="false" />
    <!-- 
        CKEditor 4 یک ویرایشگر WYSIWYG متن-باز و کاملاً رایگان است.
        نسخه LTS (4.23.0+) نیاز به license دارد.
        - CKEditor:UseCDN = false: استفاده از فایل‌های محلی (پیش‌فرض - نسخه رایگان 4.22.1 Standard)
        - CKEditor:UseCDN = true: استفاده از CDN رایگان Standard (در صورت مشکل با فایل‌های محلی)
        
        توجه: نسخه محلی در Content/plugins/ckeditor باید نسخه رایگان (4.22.1 یا قبل از 4.23.0) باشد.
        نسخه‌های 4.23.0+ (LTS) نیاز به license دارند.
    -->
    <!-- Dynamic SQL Configuration -->
    <add key="DynamicSql:Enabled" value="true" />
    <add key="DynamicSql:Logging:Enabled" value="true" />
    <add key="DynamicSql:Logging:Level" value="Debug" />
    <add key="DynamicSql:Validation:Enabled" value="true" />
    <add key="DynamicSql:Caching:Enabled" value="false" />
    <add key="DynamicSql:Caching:ExpirationMinutes" value="30" />
    <add key="Audit:MaxLogRetentionDays" value="3650" />
    <add key="Audit:CriticalOperations" value="PatientCreate,ReceptionCreate,Payment,InsuranceChange,ServicePriceChange" />
    <add key="Iran:NationalCodeValidation" value="true" />
    <!-- Saman Kish POS SignalR Configuration -->
    <!-- URL باید به آدرس Windows Service اشاره کند -->
    <!-- ⚠️ نکته: Service ممکن است فقط localhost را بپذیرد (Invalid Hostname Error) -->
    <!-- اگر از IP خارجی خطای "Invalid Hostname" می‌گیرید، از localhost استفاده کنید -->
    <!-- HostUrl در SSP1126SignalRWindowsService.exe.config = 192.168.1.103 -->
    <!-- اما برای اتصال از Application، باید از localhost استفاده شود -->
    <!-- ⚠️ تغییر: Service روی Port 5000 listen می‌کند (نه Port 8080) -->
    <add key="SamanKishSignalRUrl" value="http://localhost:5000/signalr" />
    <!-- ZarinPal Payment Gateway Configuration -->
    <!-- ✅ Production: مرچنت ثبت‌شده در پنل زرین‌پال؛ با IsSandbox=false کاربر به صفحه اصلی وارد کردن کارت (https://www.zarinpal.com/pg/StartPay/) هدایت می‌شود -->
    <!-- ⚠️ تست روی localhost: برای اتصال به درگاه روی http://localhost باید Zarinpal:IsSandbox را true کنید؛ در این حالت CallbackUrl به صورت خودکار به همان localhost ساخته می‌شود -->
    <add key="ZarinpalMerchantId" value="156be6cd-e0a4-4af8-9113-83647771376f" />
    <!-- اختیاری: مرچنت سندباکس برای تست روی localhost. اگر خالی باشد روی localhost همان ZarinpalMerchantId استفاده می‌شود (ممکن است درگاه به‌خاطر مرچنت مخصوص mehranyad.ir درخواست را رد کند). برای تست محلی یک UUID دلخواه بگذارید، مثلاً: 00000000-0000-0000-0000-000000000001 -->
    <add key="Zarinpal:SandboxMerchantId" value="00000000-0000-0000-0000-000000000001" />
    <add key="Zarinpal:IsSandbox" value="false" />
    <!-- ✅ Production URLs: اتصال مستقیم به درگاه واقعی -->
    <add key="Zarinpal:RequestUrl" value="https://api.zarinpal.com/pg/v4/payment/request.json" />
    <add key="Zarinpal:VerifyUrl" value="https://api.zarinpal.com/pg/v4/payment/verify.json" />
    <add key="Zarinpal:StartPayUrl" value="https://www.zarinpal.com/pg/StartPay/" />
    <add key="Zarinpal:StatusUrl" value="https://api.zarinpal.com/pg/v4/payment/status.json" />
    <!-- Payment: در محیط عملیاتی فقط درگاه واقعی (زرین‌پال) استفاده شود؛ درگاه شبیه‌سازی فقط برای تست محلی -->
    <add key="Payment:AllowSimulatedGateway" value="false" />
    <!-- Payment Base URL Configuration -->
    <!-- ✅ Base URL برای ساخت CallbackUrl در درگاه‌های پرداخت -->
    <!-- این URL باید با دامنه ثبت شده در پنل ZarinPal مطابقت داشته باشد -->
    <!-- مثال Production: https://yourdomain.com (بدون trailing slash) -->
    <!-- اگر تنظیم نشده باشد، از Request.Url استفاده می‌شود (Fallback) -->
    <!-- ⚠️ برای Development: این مقدار را خالی بگذارید یا localhost را در پنل ZarinPal ثبت کنید -->
    <add key="Payment:BaseUrl" value="https://mehranyad.ir" />
    <!-- Appointment Settings (تنظیمات نوبت‌دهی) -->
    <!-- مدت زمان انقضای نوبت‌های Pending (به دقیقه) -->
    <!-- بعد از این مدت، نوبت‌های Pending منقضی می‌شوند و اسلات آزاد می‌شود -->
    <!-- مقدار پیش‌فرض: 5 دقیقه (حداقل زمان ممکن) -->
    <!-- محدوده مجاز: 3 تا 60 دقیقه -->
    <add key="Appointment:PendingExpirationMinutes" value="5" />
    <!-- Payment Security: Cooldown بین تلاش‌های پرداخت برای هر نوبت (دقیقه). پیش‌فرض 1 برای پروداکشن؛ 5 برای محیط‌های محافظه‌کارانه -->
    <add key="Payment:AppointmentCooldownMinutes" value="1" />
    <!-- Payment Security: حداکثر تعداد رکورد پرداخت (Pending+Failed+Successful) per appointment قبل از قفل. پیش‌فرض 3 -->
    <add key="Payment:MaxAttemptsPerAppointment" value="3" />
    <!-- Jitsi / مشاوره آنلاین تصویری (پروداکشن): شناسه دسته = 7، شماره موبایل پزشک در پروفایل پر شود -->
    <add key="Jitsi:EnableOnlineConsultation" value="true" />
    <add key="Jitsi:BaseUrl" value="https://meet.jit.si" />
    <add key="Jitsi:JoinAllowedMinutesBefore" value="15" />
    <add key="Jitsi:JoinAllowedMinutesAfter" value="120" />
    <add key="Jitsi:OnlineConsultationServiceCategoryId" value="7" />
  </appSettings>
  <system.web>
    <!-- تنظیمات machineKey برای Anti-Forgery Token -->
    <machineKey validationKey="A1B2C3D4E5F6789012345678901234567890ABCDEF1234567890ABCDEF1234567890ABCDEF1234567890ABCDEF1234567890ABCDEF1234567890ABCDEF" decryptionKey="1234567890ABCDEF1234567890ABCDEF" validation="HMACSHA256" decryption="AES" />
    <authentication mode="None" />
    <compilation debug="true" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Core, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" maxRequestLength="51200" executionTimeout="300" />
    <!-- تنظیمات فارسی‌سازی و Encoding برای سیستم‌های پزشکی ایرانی -->
    <globalization culture="fa-IR" uiCulture="fa-IR" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" enableClientBasedCulture="false" />
    <!-- تنظیمات صفحات خطای فارسی (Custom Errors) -->
    <!-- در حالت لوکال (RemoteOnly) خطای اصلی را می‌بینید، در سرور صفحه خطای فارسی نمایش داده می‌شود -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error">
      <error statusCode="404" redirect="~/Error/NotFound" />
      <error statusCode="500" redirect="~/Error/ServerError" />
      <error statusCode="403" redirect="~/Error/AccessDenied" />
    </customErrors>
    <!-- تنظیمات صفحه‌ها برای پشتیبانی بهتر از فارسی -->
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" enableViewState="true" validateRequest="false" pageBaseType="System.Web.Mvc.WebViewPage" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="FormsAuthentication" />
    </modules>
    <!-- Handler Mapping برای مسیرهای API بدون extension -->
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <!--تنظیمات امنیتی پیشرفته برای سیستم‌های پزشکی-->
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <requestLimits maxAllowedContentLength="52428800" />
        <!-- 50 MB for Uploads -->
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <!--هدرهای امنیتی برای سیستم‌های پزشکی-->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:5000 https://maps.googleapis.com; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:5000 https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://maps.googleapis.com; img-src 'self' data: blob: https://maps.googleapis.com https://maps.gstatic.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' http://localhost:5000 ws://localhost:5000 https://maps.googleapis.com; frame-src 'self' https://www.google.com https://maps.google.com https://maps.googleapis.com; frame-ancestors 'none'; form-action 'self' http://localhost:3560;" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!--تنظیمات Encoding برای پشتیبانی بهتر از فارسی-->
        <add name="Content-Type" value="text/html; charset=utf-8" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=(), usb=(), serial=(), hid=(), bluetooth=()" />
      </customHeaders>
    </httpProtocol>
    <!-- تنظیمات Encoding برای فایل‌ها و Static Content -->
    <staticContent>
      <!-- Font files -->
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".ttf" />
      <remove fileExtension=".eot" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".ttf" mimeType="application/font-ttf" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
      <!-- CSS files (CRITICAL FIX) -->
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
      <!-- JS files -->
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="application/javascript" />
      <!-- Web Manifest files -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- Source Map files -->
      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json" />
    </staticContent>
    <!-- تنظیمات Response Encoding -->
    <httpCompression>
      <scheme dll="%Windir%\system32\inetsrv\gzip.dll" name="gzip" />
      <dynamicTypes>
        <add enabled="true" mimeType="text/*" />
        <add enabled="true" mimeType="message/*" />
        <add enabled="true" mimeType="application/javascript" />
        <add enabled="true" mimeType="application/json" />
      </dynamicTypes>
      <staticTypes>
        <add enabled="true" mimeType="text/*" />
        <add enabled="true" mimeType="message/*" />
        <add enabled="true" mimeType="application/javascript" />
      </staticTypes>
    </httpCompression>
  </system.webServer>
