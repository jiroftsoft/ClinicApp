@model ClinicApp.ViewModels.DepartmentDetailsViewModel
@using ClinicApp.Models.Enums
@{
    ViewBag.Title = $"جزئیات دپارتمان: {Model.Name}";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    
    // تعیین رنگ و آیکون بر اساس نوع دپارتمان
    var typeInfo = GetDepartmentTypeInfo(Model.Type);
}

@functions {
    public dynamic GetDepartmentTypeInfo(DepartmentType type)
    {
        switch (type)
        {
            case DepartmentType.Medical:
                return new { Badge = "primary", Icon = "fa-stethoscope", Text = "درمانی" };
            case DepartmentType.Administrative:
                return new { Badge = "secondary", Icon = "fa-briefcase", Text = "اداری" };
            case DepartmentType.AdmissionDischarge:
                return new { Badge = "info", Icon = "fa-clipboard-check", Text = "پذیرش و ترخیص" };
            case DepartmentType.Paraclinical:
                return new { Badge = "cyan", Icon = "fa-microscope", Text = "پاراکلینیک" };
            case DepartmentType.Emergency:
                return new { Badge = "danger", Icon = "fa-ambulance", Text = "اورژانس" };
            case DepartmentType.Injection:
                return new { Badge = "warning", Icon = "fa-syringe", Text = "تزریقات" };
            case DepartmentType.Surgery:
                return new { Badge = "dark", Icon = "fa-procedures", Text = "جراحی" };
            case DepartmentType.Inpatient:
                return new { Badge = "indigo", Icon = "fa-bed", Text = "بستری" };
            case DepartmentType.Rehabilitation:
                return new { Badge = "success", Icon = "fa-wheelchair", Text = "توانبخشی" };
            case DepartmentType.Pharmacy:
                return new { Badge = "pink", Icon = "fa-pills", Text = "دارویی" };
            case DepartmentType.Other:
                return new { Badge = "light", Icon = "fa-ellipsis-h", Text = "سایر" };
            default:
                return new { Badge = "secondary", Icon = "fa-question", Text = "نامشخص" };
        }
    }
}

<div class="card shadow-lg" style="border: none; border-radius: 16px; overflow: hidden;">
    <div class="card-header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 30px; border: none;">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <div style="width: 70px; height: 70px; background: rgba(255,255,255,0.2); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-left: 20px;">
                    <i class="fas fa-hospital text-white" style="font-size: 32px;"></i>
                </div>
                <div>
                    <h3 class="mb-1 text-white"><strong>@Model.Name</strong></h3>
                    <p class="mb-0 text-white" style="opacity: 0.9;">
                        <i class="fas fa-building me-2"></i>@Model.ClinicName
                    </p>
                </div>
            </div>
            <div>
                <a href="@Url.Action("Edit", new { id = Model.DepartmentId })" 
                   class="btn me-2" 
                   style="background: rgba(255,255,255,0.2); color: white; border: 1px solid rgba(255,255,255,0.3); padding: 10px 20px; border-radius: 8px;"
                   onmouseover="this.style.background='rgba(255,255,255,0.3)';"
                   onmouseout="this.style.background='rgba(255,255,255,0.2)';">
                    <i class="fas fa-edit me-1"></i> ویرایش
                </a>
                <a href="@Url.Action("Index", new { clinicId = Model.ClinicId })" 
                   class="btn" 
                   style="background: rgba(255,255,255,0.2); color: white; border: 1px solid rgba(255,255,255,0.3); padding: 10px 20px; border-radius: 8px;"
                   onmouseover="this.style.background='rgba(255,255,255,0.3)';"
                   onmouseout="this.style.background='rgba(255,255,255,0.2)';">
                    <i class="fas fa-arrow-right me-1"></i> بازگشت
                </a>
            </div>
        </div>
    </div>
    <div class="card-body" style="padding: 40px;">
        <!-- کارت‌های آماری -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card" style="border: none; border-radius: 12px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 25px;">
                    <div class="text-center">
                        <i class="fas fa-tag text-white" style="font-size: 36px; margin-bottom: 15px;"></i>
                        <h6 class="text-white mb-2" style="opacity: 0.9;">نوع دپارتمان</h6>
                        <h4 class="text-white mb-0">@typeInfo.Text</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card" style="border: none; border-radius: 12px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); padding: 25px;">
                    <div class="text-center">
                        <i class="fas fa-toggle-on text-white" style="font-size: 36px; margin-bottom: 15px;"></i>
                        <h6 class="text-white mb-2" style="opacity: 0.9;">وضعیت</h6>
                        <h4 class="text-white mb-0">@(Model.IsActive ? "فعال" : "غیرفعال")</h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card" style="border: none; border-radius: 12px; background: linear-gradient(135deg, #3b82f6 0%, #1e40af 100%); padding: 25px;">
                    <div class="text-center">
                        <i class="fas fa-user-md text-white" style="font-size: 36px; margin-bottom: 15px;"></i>
                        <h6 class="text-white mb-2" style="opacity: 0.9;">تعداد پزشکان</h6>
                        <h4 class="text-white mb-0">@Model.DoctorCount <small style="font-size: 14px;">نفر</small></h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card" style="border: none; border-radius: 12px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); padding: 25px;">
                    <div class="text-center">
                        <i class="fas fa-clipboard-list text-white" style="font-size: 36px; margin-bottom: 15px;"></i>
                        <h6 class="text-white mb-2" style="opacity: 0.9;">تعداد خدمات</h6>
                        <h4 class="text-white mb-0">@Model.ServiceCategoryCount <small style="font-size: 14px;">مورد</small></h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- اطلاعات تفصیلی -->
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card" style="border: 1px solid #e5e7eb; border-radius: 12px; padding: 25px;">
                    <h5 class="mb-4">
                        <i class="fas fa-info-circle me-2" style="color: #667eea;"></i>
                        اطلاعات اصلی
                    </h5>
                    <div class="mb-3 pb-3" style="border-bottom: 1px solid #f3f4f6;">
                        <small style="color: #6b7280; font-size: 13px;">نام دپارتمان</small>
                        <h6 class="mb-0 mt-1" style="color: #1f2937;">@Model.Name</h6>
                    </div>
                    <div class="mb-3 pb-3" style="border-bottom: 1px solid #f3f4f6;">
                        <small style="color: #6b7280; font-size: 13px;">کلینیک مربوطه</small>
                        <h6 class="mb-0 mt-1" style="color: #1f2937;">@Model.ClinicName</h6>
                    </div>
                    <div>
                        <small style="color: #6b7280; font-size: 13px;">نوع دپارتمان</small>
                        <div class="mt-2">
                            <span class="badge" style="background: linear-gradient(135deg, var(--bs-@typeInfo.Badge) 0%, var(--bs-@typeInfo.Badge) 100%); padding: 10px 20px; border-radius: 8px; font-size: 14px;">
                                <i class="fas @typeInfo.Icon me-2"></i>@typeInfo.Text
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card" style="border: 1px solid #e5e7eb; border-radius: 12px; padding: 25px;">
                    <h5 class="mb-4">
                        <i class="fas fa-chart-bar me-2" style="color: #10b981;"></i>
                        آمار عملکرد
                    </h5>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span style="color: #6b7280; font-size: 13px;">پزشکان فعال</span>
                            <strong style="color: #1f2937; font-size: 20px;">@Model.DoctorCount</strong>
                        </div>
                        <div class="progress" style="height: 8px; border-radius: 4px; background: #f3f4f6;">
                            <div class="progress-bar" style="background: linear-gradient(90deg, #3b82f6 0%, #1e40af 100%); width: @((Model.DoctorCount > 0 ? Math.Min(Model.DoctorCount * 10, 100) : 0))%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span style="color: #6b7280; font-size: 13px;">دسته‌بندی خدمات</span>
                            <strong style="color: #1f2937; font-size: 20px;">@Model.ServiceCategoryCount</strong>
                        </div>
                        <div class="progress" style="height: 8px; border-radius: 4px; background: #f3f4f6;">
                            <div class="progress-bar" style="background: linear-gradient(90deg, #10b981 0%, #059669 100%); width: @((Model.ServiceCategoryCount > 0 ? Math.Min(Model.ServiceCategoryCount * 10, 100) : 0))%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- تاریخچه و ردیابی -->
        <div class="row">
            <div class="col-12">
                <div class="card" style="border: 1px solid #e5e7eb; border-radius: 12px; padding: 25px; background: #f9fafb;">
                    <h5 class="mb-4">
                        <i class="fas fa-history me-2" style="color: #f59e0b;"></i>
                        تاریخچه و ردیابی
                    </h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-center">
                                <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-left: 15px;">
                                    <i class="fas fa-user-plus text-white" style="font-size: 20px;"></i>
                                </div>
                                <div>
                                    <small style="color: #6b7280; font-size: 12px;">ایجاد شده توسط</small>
                                    <h6 class="mb-0 mt-1" style="color: #1f2937;">@(Model.CreatedByUser ?? "سیستم")</h6>
                                    <small style="color: #9ca3af; font-size: 11px;">
                                        <i class="fas fa-calendar me-1"></i>@Model.CreatedAtShamsi
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="d-flex align-items-center">
                                <div style="width: 48px; height: 48px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; margin-left: 15px;">
                                    <i class="fas fa-user-edit text-white" style="font-size: 20px;"></i>
                                </div>
                                <div>
                                    <small style="color: #6b7280; font-size: 12px;">آخرین ویرایش توسط</small>
                                    <h6 class="mb-0 mt-1" style="color: #1f2937;">@(Model.UpdatedByUser ?? "ویرایش نشده")</h6>
                                    <small style="color: #9ca3af; font-size: 11px;">
                                        @if (!string.IsNullOrEmpty(Model.UpdatedAtShamsi))
                                        {
                                            <text><i class="fas fa-calendar me-1"></i>@Model.UpdatedAtShamsi</text>
                                        }
                                        else
                                        {
                                            <text>---</text>
                                        }
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>