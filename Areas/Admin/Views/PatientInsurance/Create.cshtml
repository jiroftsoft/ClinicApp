         */
        function extractNameFromText(text) {
            if (!text) return 'نام نامشخص';
            
            // حذف کد ملی از داخل پرانتز
            var name = text.replace(/\([^)]*\)/g, '').trim();
            
            // اگر فقط فاصله یا خالی است، نام پیش‌فرض
            if (!name || name.length < 2) {
                return 'نام نامشخص';
            }
            
            return name;
        }
        
