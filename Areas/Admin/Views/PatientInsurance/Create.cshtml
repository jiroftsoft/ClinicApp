                // استفاده از داده‌های سمت سرور (شمسی و سن) با اعداد فارسی
                var ageText = '-';
                if (patient.birthDateShamsi && patient.age) {
                    ageText = toPersianNumber(patient.birthDateShamsi) + ' (' + toPersianNumber(patient.age) + ' سال)';
                } else if (patient.birthDateShamsi) {
                    ageText = toPersianNumber(patient.birthDateShamsi);
                } else if (patient.birthDate && patient.birthDate !== 'null' && patient.birthDate !== 'undefined') {
                    // Fallback: استفاده از JavaScript (در صورت عدم وجود داده‌های سمت سرور)
                    try {
                        var persianDate = formatPersianDate(patient.birthDate);
                        var age = calculateAge(patient.birthDate);
                        if (age && age !== 'undefined') {
