         */
        function calculateAge(birthDate) {
            if (!birthDate || birthDate === 'null' || birthDate === 'undefined' || birthDate === null || birthDate === undefined) {
                return '-';
            }
            
            try {
                var birth = new Date(birthDate);
                
                // بررسی معتبر بودن تاریخ
                if (isNaN(birth.getTime())) {
                    console.log('🏥 Medical Environment: Invalid birth date:', birthDate);
                    return '-';
                }
                
                var today = new Date();
                var age = today.getFullYear() - birth.getFullYear();
                var monthDiff = today.getMonth() - birth.getMonth();
                
                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birth.getDate())) {
                    age--;
                }
                
                // بررسی معتبر بودن سن
                if (isNaN(age) || age < 0 || age > 150) {
                    console.log('🏥 Medical Environment: Invalid age calculated:', age, 'for birth date:', birthDate);
                    return '-';
                }
                
                return age + ' سال';
            } catch (e) {
                console.error('🏥 Medical Environment: Error calculating age:', e, 'for birth date:', birthDate);
                return '-';
            }
        }
        
        /**
         * 🏥 Helper function to format Persian date
         */
        function formatPersianDate(dateString) {
            if (!dateString || dateString === 'null' || dateString === 'undefined' || dateString === null || dateString === undefined) {
                return '-';
            }
            
            try {
                var date = new Date(dateString);
                
                // بررسی معتبر بودن تاریخ
                if (isNaN(date.getTime())) {
                    console.log('🏥 Medical Environment: Invalid date for formatting:', dateString);
                    return '-';
                }
                
                var year = date.getFullYear();
                var month = date.getMonth() + 1;
                var day = date.getDate();
                
                // بررسی معتبر بودن مقادیر
                if (isNaN(year) || isNaN(month) || isNaN(day)) {
                    console.log('🏥 Medical Environment: Invalid date components:', {year: year, month: month, day: day});
                    return '-';
                }
                
                // تبدیل به تاریخ شمسی (تقریبی)
                var persianYear = year - 621;
                return persianYear + '/' + month + '/' + day;
            } catch (e) {
                console.error('🏥 Medical Environment: Error formatting Persian date:', e, 'for date:', dateString);
                return '-';
            }
        }
        
