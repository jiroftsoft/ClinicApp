@model ClinicApp.ViewModels.Admin.ReceptionistDashboard.ReceptionistDashboardPageViewModel
@{
    ViewBag.Title = "داشبورد منشی";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="receptionist-dashboard">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h4 mb-0">
            <i class="fas fa-user-nurse text-primary me-2"></i>داشبورد منشی
        </h1>
    </div>
    <div class="receptionist-dashboard-grid">
        <div class="receptionist-dashboard-item receptionist-dashboard-item--wide">
            @Html.Partial("Partials/_WidgetReceptionQuickActions", Model?.QuickActions)
        </div>
        <div class="receptionist-dashboard-item">
            @Html.Partial("Partials/_WidgetTodayStats", Model?.TodayStats)
        </div>
        <div class="receptionist-dashboard-item">
            @Html.Partial("Partials/_WidgetTodayAppointments", Model?.TodayAppointments)
        </div>
        <div class="receptionist-dashboard-item">
            @Html.Partial("Partials/_WidgetPendingReceptions", Model?.PendingReceptions)
        </div>
        <div class="receptionist-dashboard-item">
            @Html.Partial("Partials/_WidgetTodayDoctors", Model?.TodayDoctors)
        </div>
    </div>
</div>
<style>
    .receptionist-dashboard-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
    .receptionist-dashboard-item--wide { grid-column: 1 / -1; }
    .reception-dash-widget { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; }
    .reception-dash-widget-header { padding: 0.75rem 1rem; background: #f8fafc; font-weight: 600; display: flex; align-items: center; gap: 0.5rem; }
    .reception-dash-widget-body { padding: 1rem; }
</style>
