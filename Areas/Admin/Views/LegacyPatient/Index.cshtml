@{
    ViewBag.Title = "مدیریت بیماران Legacy";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-users"></i>
                        مدیریت بیماران قدیمی (Legacy Patients)
                    </h4>
                </div>
                <div class="card-body">
                    
                    <!-- توضیحات -->
                    <div class="alert alert-info">
                        <h5><i class="fas fa-info-circle"></i> راهنما</h5>
                        <p>
                            این صفحه برای مدیریت بیماران قدیمی که از سیستم قبلی Import شده‌اند، طراحی شده است.
                            <br>
                            پس از اجرای Migration، برای این بیماران حساب کاربری ایجاد شده اما هنوز رمز عبور تنظیم نکرده‌اند.
                        </p>
                    </div>

                    <!-- آمار -->
                    <div class="row mb-4" id="statistics-section">
                        <div class="col-md-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h3 class="mb-0" id="stat-total">...</h3>
                                    <p class="mb-0">کل بیماران Legacy</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <h3 class="mb-0" id="stat-with-phone">...</h3>
                                    <p class="mb-0">با شماره تلفن</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-info text-white">
                                <div class="card-body text-center">
                                    <h3 class="mb-0" id="stat-with-email">...</h3>
                                    <p class="mb-0">با ایمیل</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card bg-warning text-white">
                                <div class="card-body text-center">
                                    <h3 class="mb-0" id="stat-without-contact">...</h3>
                                    <p class="mb-0">بدون اطلاعات تماس</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- دکمه ارسال پیامک -->
                    <div class="text-center">
                        <button type="button" class="btn btn-lg btn-success" id="btn-send-welcome">
                            <i class="fas fa-paper-plane"></i>
                            ارسال پیامک خوش‌آمدگویی به همه
                        </button>
                    </div>

                    <!-- نتیجه -->
                    <div id="result-section" class="mt-4" style="display:none;">
                        <div class="alert" id="result-alert"></div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            
            // دریافت آمار
            loadStatistics();

            // ارسال پیامک
            $('#btn-send-welcome').click(function () {
                if (!confirm('آیا مطمئن هستید که می‌خواهید پیامک خوش‌آمدگویی به همه بیماران Legacy ارسال شود؟')) {
                    return;
                }

                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> در حال ارسال...');

                $.ajax({
                    url: '@Url.Action("SendWelcomeNotifications", "LegacyPatient")',
                    type: 'POST',
                    headers: {
                        '__RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.IsSuccessful) {
                            showResult('success', 'موفق!', response.Message);
                            loadStatistics(); // بروزرسانی آمار
                        } else {
                            showResult('danger', 'خطا!', response.Message);
                        }
                    },
                    error: function () {
                        showResult('danger', 'خطا!', 'خطای ارتباط با سرور. لطفاً دوباره تلاش کنید.');
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html('<i class="fas fa-paper-plane"></i> ارسال پیامک خوش‌آمدگویی به همه');
                    }
                });
            });

            function loadStatistics() {
                $.ajax({
                    url: '@Url.Action("GetStatistics", "LegacyPatient")',
                    type: 'GET',
                    success: function (response) {
                        if (response.IsSuccessful && response.Data) {
                            $('#stat-total').text(response.Data.TotalLegacyPatients.toLocaleString('fa-IR'));
                            $('#stat-with-phone').text(response.Data.PatientsWithPhone.toLocaleString('fa-IR'));
                            $('#stat-with-email').text(response.Data.PatientsWithEmail.toLocaleString('fa-IR'));
                            $('#stat-without-contact').text(response.Data.PatientsWithoutContact.toLocaleString('fa-IR'));
                        }
                    },
                    error: function () {
                        console.error('خطا در دریافت آمار');
                    }
                });
            }

            function showResult(type, title, message) {
                var $alert = $('#result-alert');
                $alert.removeClass('alert-success alert-danger alert-warning alert-info')
                      .addClass('alert-' + type)
                      .html('<strong>' + title + '</strong> ' + message);
                $('#result-section').slideDown();
            }
        });
    </script>
}

@Html.AntiForgeryToken()

