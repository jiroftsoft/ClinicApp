@*
    منوی یکپارچه ادمین — حداکثر ۲ سطح، مبتنی بر سناریو کاری
    Level 1: دسته (داشبورد، پذیرش و نوبت‌دهی، ...)
    Level 2: آیتم‌های منو
    منشی: فقط بخش‌های مجاز (بدون کاربران، CMS، تنظیمات سیستم)
    طبق UX حرفه‌ای HIS/Clinic ERP
*@
@using System.Web.Mvc
@using ClinicApp.Models.Core
@{
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var actionName = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var path = Request.Url?.AbsolutePath ?? "";
    var isInCms = path.IndexOf("/Admin/CMS", StringComparison.OrdinalIgnoreCase) >= 0;
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isReceptionist = User.IsInRole(AppRoles.Receptionist);
    var isReceptionistOnly = isReceptionist && !isAdmin;
    var cmsHomeUrl = Url.RouteUrl("Admin_CMS_Home");
    if (string.IsNullOrEmpty(cmsHomeUrl)) { cmsHomeUrl = "/Admin/CMS"; }
    var adminDashboardUrl = Url.RouteUrl("Admin_default", new { controller = "Dashboard", action = "Index" });
    if (string.IsNullOrEmpty(adminDashboardUrl)) { adminDashboardUrl = Url.Content("~/Admin/Dashboard"); }
    var adminDoctorDashboardUrl = Url.RouteUrl("Admin_default", new { controller = "DoctorDashboard", action = "Index" });
    if (string.IsNullOrEmpty(adminDoctorDashboardUrl)) { adminDoctorDashboardUrl = Url.Content("~/Admin/DoctorDashboard"); }

    Func<string, string, string, bool> isActive = (c, a, key) =>
    {
        if (key == "cms") return isInCms;
        if (!string.IsNullOrEmpty(a)) return controllerName.Equals(c, StringComparison.OrdinalIgnoreCase) && actionName.Equals(a, StringComparison.OrdinalIgnoreCase);
        return controllerName.Equals(c, StringComparison.OrdinalIgnoreCase);
    };

    Func<string, bool> sectionHasActive = (key) =>
    {
        switch (key)
        {
            case "dashboard": return controllerName.Equals("Dashboard", StringComparison.OrdinalIgnoreCase) || controllerName.Equals("DoctorDashboard", StringComparison.OrdinalIgnoreCase) || controllerName.Equals("ReceptionistDashboard", StringComparison.OrdinalIgnoreCase);
            case "reception": return controllerName.Equals("ReceptionV2", StringComparison.OrdinalIgnoreCase) || controllerName.Equals("EmergencyBooking", StringComparison.OrdinalIgnoreCase) || controllerName.Equals("AppointmentAvailability", StringComparison.OrdinalIgnoreCase) || controllerName.Equals("PromotionalEvent", StringComparison.OrdinalIgnoreCase) || controllerName.Equals("ScheduleOptimization", StringComparison.OrdinalIgnoreCase);
            case "reports": return controllerName.Equals("ReceptionistReports", StringComparison.OrdinalIgnoreCase);
            case "doctors": return new[] { "Doctor", "Specialization", "DoctorSchedule", "DoctorAssignment", "DoctorReporting", "DoctorDashboard" }.Any(c => string.Equals(c, controllerName, StringComparison.OrdinalIgnoreCase));
            case "services": return new[] { "Service", "ServiceComponent", "ServiceTemplate", "SharedService", "ServiceManagement" }.Any(c => string.Equals(c, controllerName, StringComparison.OrdinalIgnoreCase));
            case "insurance": return new[] { "InsuranceProvider", "InsurancePlan", "InsuranceTariff", "SupplementaryTariff", "PatientInsurance", "BusinessRule", "InsuranceCalculation", "CombinedInsuranceCalculation" }.Any(c => string.Equals(c, controllerName, StringComparison.OrdinalIgnoreCase));
            case "finance": return new[] { "PaymentManagement", "CashierDashboard", "CashierReport" }.Any(c => string.Equals(c, controllerName, StringComparison.OrdinalIgnoreCase));
            case "clinic": return new[] { "Clinic", "Department", "ClinicBankAccount" }.Any(c => string.Equals(c, controllerName, StringComparison.OrdinalIgnoreCase));
            case "users": return controllerName.Equals("UserManagement", StringComparison.OrdinalIgnoreCase);
            case "cms": return isInCms;
            case "settings": return new[] { "FactorSetting", "InsuranceTypeUpdate", "SystemSeed" }.Any(c => string.Equals(c, controllerName, StringComparison.OrdinalIgnoreCase));
            default: return false;
        }
    };

    var sections = new[]
    {
        new { Key = "dashboard", Title = "داشبورد", Icon = "fa-tachometer-alt", Items = new[] {
            new { Title = "داشبورد منشی", Url = Url.Action("Index", "ReceptionistDashboard", new { area = "Admin" }), Controller = "ReceptionistDashboard", Action = (string)null },
            new { Title = "داشبورد مدیریت", Url = adminDashboardUrl, Controller = "Dashboard", Action = (string)null },
            new { Title = "داشبورد پزشکان", Url = adminDoctorDashboardUrl, Controller = "DoctorDashboard", Action = (string)null }
        }},
        new { Key = "reception", Title = "پذیرش و نوبت‌دهی", Icon = "fa-calendar-check", Items = new[] {
            new { Title = "پذیرش بیمار", Url = Url.Content("~/ReceptionV2"), Controller = "ReceptionV2", Action = (string)null },
            new { Title = "نوبت‌های اضطراری", Url = Url.Action("Index", "EmergencyBooking", new { area = "Admin" }), Controller = "EmergencyBooking", Action = (string)null },
            new { Title = "دسترس‌پذیری نوبت", Url = Url.Action("Index", "AppointmentAvailability", new { area = "Admin" }), Controller = "AppointmentAvailability", Action = (string)null },
            new { Title = "ایونت‌های تبلیغاتی", Url = Url.Action("Index", "PromotionalEvent", new { area = "Admin" }), Controller = "PromotionalEvent", Action = (string)null },
            new { Title = "بهینه‌سازی برنامه", Url = Url.Action("Index", "ScheduleOptimization", new { area = "Admin" }), Controller = "ScheduleOptimization", Action = (string)null }
        }},
        new { Key = "reports", Title = "گزارش‌ها", Icon = "fa-file-alt", Items = new[] {
            new { Title = "نوبت‌های رزرو شده توسط بیماران", Url = Url.Action("PatientBookedAppointments", "ReceptionistReports", new { area = "Admin" }), Controller = "ReceptionistReports", Action = "PatientBookedAppointments" }
        }},
        new { Key = "doctors", Title = "پزشکان و پرسنل", Icon = "fa-user-md", Items = new[] {
            new { Title = "پزشکان", Url = Url.Action("Index", "Doctor", new { area = "Admin" }), Controller = "Doctor", Action = (string)null },
            new { Title = "تخصص‌ها", Url = Url.Action("Index", "Specialization", new { area = "Admin" }), Controller = "Specialization", Action = (string)null },
            new { Title = "برنامه زمانی", Url = Url.Action("Index", "DoctorSchedule", new { area = "Admin" }), Controller = "DoctorSchedule", Action = (string)null },
            new { Title = "اختصاص پزشکان", Url = Url.Action("Index", "DoctorAssignment", new { area = "Admin" }), Controller = "DoctorAssignment", Action = (string)null },
            new { Title = "داشبورد پزشک", Url = Url.Action("Index", "DoctorDashboard", new { area = "Admin" }), Controller = "DoctorDashboard", Action = (string)null },
            new { Title = "گزارشات پزشکان", Url = Url.Action("Index", "DoctorReporting", new { area = "Admin" }), Controller = "DoctorReporting", Action = (string)null }
        }},
        new { Key = "services", Title = "خدمات درمانی", Icon = "fa-stethoscope", Items = new[] {
            new { Title = "خدمات پزشکی", Url = Url.Action("Index", "Service", new { area = "Admin" }), Controller = "Service", Action = (string)null },
            new { Title = "دسته‌بندی خدمات", Url = Url.Action("Categories", "Service", new { area = "Admin" }), Controller = "Service", Action = "Categories" },
            new { Title = "اجزای خدمات", Url = Url.Action("Index", "ServiceComponent", new { area = "Admin" }), Controller = "ServiceComponent", Action = (string)null },
            new { Title = "Template خدمات", Url = Url.Action("Index", "ServiceTemplate", new { area = "Admin" }), Controller = "ServiceTemplate", Action = (string)null },
            new { Title = "خدمات مشترک", Url = Url.Action("Index", "SharedService", new { area = "Admin" }), Controller = "SharedService", Action = (string)null },
            new { Title = "مدیریت پیشرفته", Url = Url.Action("Index", "ServiceManagement", new { area = "Admin" }), Controller = "ServiceManagement", Action = (string)null }
        }},
        new { Key = "insurance", Title = "بیمه و قراردادها", Icon = "fa-shield-alt", Items = new[] {
            new { Title = "ارائه‌دهندگان بیمه", Url = Url.Action("Index", "InsuranceProvider", new { area = "Admin" }), Controller = "InsuranceProvider", Action = (string)null },
            new { Title = "پلن‌های بیمه", Url = Url.Action("Index", "InsurancePlan", new { area = "Admin" }), Controller = "InsurancePlan", Action = (string)null },
            new { Title = "بیمه بیماران", Url = Url.Action("Index", "PatientInsurance", new { area = "Admin" }), Controller = "PatientInsurance", Action = (string)null },
            new { Title = "تعرفه‌های بیمه", Url = Url.Action("Index", "InsuranceTariff", new { area = "Admin" }), Controller = "InsuranceTariff", Action = (string)null },
            new { Title = "تعرفه تکمیلی", Url = Url.Action("Index", "SupplementaryTariff", new { area = "Admin" }), Controller = "SupplementaryTariff", Action = (string)null },
            new { Title = "قوانین کسب‌وکار", Url = Url.Action("Index", "BusinessRule", new { area = "Admin" }), Controller = "BusinessRule", Action = (string)null },
            new { Title = "محاسبات بیمه", Url = Url.Action("Index", "InsuranceCalculation", new { area = "Admin" }), Controller = "InsuranceCalculation", Action = (string)null },
            new { Title = "محاسبه ترکیبی", Url = Url.Action("Index", "CombinedInsuranceCalculation", new { area = "Admin" }), Controller = "CombinedInsuranceCalculation", Action = (string)null }
        }},
        new { Key = "finance", Title = "مالی و صندوق", Icon = "fa-credit-card", Items = new[] {
            new { Title = "مدیریت پرداخت‌ها", Url = Url.Action("Index", "PaymentManagement", new { area = "Admin" }), Controller = "PaymentManagement", Action = (string)null },
            new { Title = "داشبورد منشی‌ها", Url = Url.Action("Index", "CashierDashboard"), Controller = "CashierDashboard", Action = (string)null },
            new { Title = "گزارشات صندوق", Url = Url.Action("Index", "CashierReport"), Controller = "CashierReport", Action = (string)null },
            new { Title = "حساب‌های بانکی", Url = Url.Action("Index", "ClinicBankAccount", new { area = "Admin" }), Controller = "ClinicBankAccount", Action = (string)null }
        }},
        new { Key = "clinic", Title = "مدیریت کلینیک", Icon = "fa-hospital", Items = new[] {
            new { Title = "کلینیک‌ها", Url = Url.Action("Index", "Clinic", new { area = "Admin" }), Controller = "Clinic", Action = (string)null },
            new { Title = "دپارتمان‌ها", Url = Url.Action("Index", "Department", new { area = "Admin" }), Controller = "Department", Action = (string)null }
        }},
        new { Key = "users", Title = "کاربران و امنیت", Icon = "fa-users-cog", Items = new[] {
            new { Title = "مدیریت کاربران", Url = Url.Action("Index", "UserManagement", new { area = "Admin" }), Controller = "UserManagement", Action = (string)null },
            new { Title = "کاربران حذف شده", Url = Url.Action("DeletedUsers", "UserManagement", new { area = "Admin" }), Controller = "UserManagement", Action = "DeletedUsers" }
        }},
        new { Key = "cms", Title = "وب‌سایت و CMS", Icon = "fa-sitemap", Items = new[] {
            new { Title = "مدیریت محتوا (CMS)", Url = cmsHomeUrl, Controller = "CmsHome", Action = (string)null }
        }},
        new { Key = "settings", Title = "تنظیمات سیستم", Icon = "fa-cog", Items = new[] {
            new { Title = "تنظیمات ضرایب", Url = Url.Action("Index", "FactorSetting", new { area = "Admin" }), Controller = "FactorSetting", Action = (string)null },
            new { Title = "به‌روزرسانی بیمه", Url = Url.Action("Index", "InsuranceTypeUpdate", new { area = "Admin" }), Controller = "InsuranceTypeUpdate", Action = (string)null },
            new { Title = "داده‌های اولیه", Url = Url.Action("Index", "SystemSeed", new { area = "Admin" }), Controller = "SystemSeed", Action = (string)null }
        }}
    };
}

<nav class="aside-menu" role="navigation" aria-label="منوی اصلی مدیریت">
    @foreach (var section in sections)
    {
        @* منشی فقط بخش‌های مجاز را ببیند (بدون کاربران، CMS، تنظیمات سیستم) *@
        if (isReceptionistOnly && (section.Key == "users" || section.Key == "cms" || section.Key == "settings"))
        {
            @* skip rendering *@
        }
        else
        {
            var expanded = sectionHasActive(section.Key);
            var sectionId = "aside-section-" + section.Key;
            <div class="aside-menu-section @(expanded ? "expanded" : "")" data-section="@(section.Key)">
                <button type="button" class="aside-menu-section-header" aria-expanded="@(expanded ? "true" : "false")" aria-controls="@(sectionId)" id="btn-@(sectionId)" data-aside-toggle>
                    <i class="fas @(section.Icon) aside-menu-section-icon" aria-hidden="true"></i>
                    <span class="aside-menu-section-title">@(section.Title)</span>
                    <i class="fas fa-chevron-down aside-menu-section-chevron" aria-hidden="true"></i>
                </button>
                <ul class="aside-menu-list" id="@(sectionId)" role="group" aria-label="@(section.Title)">
                    @foreach (var item in section.Items)
                    {
                        var showItem = !isReceptionistOnly || section.Key != "dashboard" || item.Controller.Equals("ReceptionistDashboard", StringComparison.OrdinalIgnoreCase);
                        if (showItem)
                        {
                            var itemActive = item.Title == "مدیریت محتوا (CMS)" ? isInCms : isActive(item.Controller, item.Action ?? "", section.Key);
                            var href = item.Title == "مدیریت محتوا (CMS)" ? cmsHomeUrl : item.Url;
                            if (string.IsNullOrEmpty(href)) { href = "#"; }
                            <li class="aside-menu-item">
                                <a href="@href" class="aside-menu-link @(itemActive ? "active" : "")" aria-current="@(itemActive ? "page" : null)">
                                    <span class="aside-menu-link-text">@item.Title</span>
                                    @if (itemActive) { <i class="fas fa-chevron-left aside-menu-link-indicator" aria-hidden="true"></i> }
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
        }
    }
</nav>

<style>
    /* Aside Menu - حداکثر ۲ سطح، Medical Blue */
    .aside-menu { padding: 0.25rem 0; }
    .aside-menu-section { margin-bottom: 0.25rem; border-radius: 8px; overflow: hidden; border: 1px solid var(--medical-border, #e2e8f0); }
    .aside-menu-section-header {
        display: flex; align-items: center; gap: 0.5rem; width: 100%;
        padding: 0.75rem 1rem; text-align: right; border: none; background: var(--medical-light, #f8fafc);
        color: var(--medical-text, #1e293b); font-weight: 600; font-size: 0.875rem; cursor: pointer;
        font-family: inherit; transition: background 0.2s, color 0.2s;
    }
    .aside-menu-section-header:hover { background: #e2e8f0; color: #1e3a8a; }
    .aside-menu-section.expanded .aside-menu-section-header { background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #fff; }
    .aside-menu-section.expanded .aside-menu-section-header:hover { background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%); color: #fff; }
    .aside-menu-section-icon { width: 1.25rem; text-align: center; flex-shrink: 0; }
    .aside-menu-section-title { flex: 1; }
    .aside-menu-section-chevron { font-size: 0.75rem; transition: transform 0.25s ease; flex-shrink: 0; }
    .aside-menu-section.expanded .aside-menu-section-chevron { transform: rotate(180deg); }
    .aside-menu-list { list-style: none; margin: 0; padding: 0.25rem 0; max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
    .aside-menu-section.expanded .aside-menu-list { max-height: 600px; }
    .aside-menu-item { margin: 0; }
    .aside-menu-link {
        display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 1rem 0.5rem 2rem;
        color: var(--medical-text, #475569); text-decoration: none; font-size: 0.8125rem; transition: all 0.2s;
        border-right: 3px solid transparent;
    }
    .aside-menu-link:hover { background: #f1f5f9; color: #1e3a8a; text-decoration: none; }
    .aside-menu-link.active { background: rgba(30, 58, 138, 0.08); color: #1e3a8a; border-right-color: #2563eb; font-weight: 600; }
    .aside-menu-link-indicator { font-size: 0.7rem; color: #2563eb; }
    @@media (max-width: 768px) { .aside-menu-link { padding: 0.5rem 0.75rem 0.5rem 1.25rem; } }
</style>

<script>
(function() {
    'use strict';
    var storageKey = 'adminAsideMenuSections';
    function loadState() { try { return JSON.parse(localStorage.getItem(storageKey) || '{}'); } catch (e) { return {}; } }
    function saveState(state) { try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch (e) {} }
    document.querySelectorAll('[data-aside-toggle]').forEach(function(btn) {
        var section = btn.closest('.aside-menu-section');
        var key = section && section.getAttribute('data-section');
        if (!section || !key) return;
        var state = loadState();
        if (state[key] === undefined) state[key] = section.classList.contains('expanded');
        if (!state[key]) section.classList.remove('expanded');
        btn.addEventListener('click', function() {
            var expanded = section.classList.toggle('expanded');
            btn.setAttribute('aria-expanded', expanded);
            state[key] = expanded;
            saveState(state);
        });
    });
})();
</script>
