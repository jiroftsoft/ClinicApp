        new { Name = "ServiceCategory", Title = "دسته‌بندی خدمات", Icon = "fa-layer-group", Controller = "Service", Action = "Categories", Category = "مدیریت خدمات" },
        new { Name = "ServiceComponent", Title = "اجزای خدمات", Icon = "fa-puzzle-piece", Controller = "ServiceComponent", Action = (string)null, Category = "مدیریت خدمات" },
        new { Name = "ServiceTemplate", Title = "Template خدمات", Icon = "fa-file-alt", Controller = "ServiceTemplate", Action = (string)null, Category = "مدیریت خدمات" },
        new { Name = "SharedService", Title = "خدمات مشترک", Icon = "fa-share-alt", Controller = "SharedService", Action = (string)null, Category = "مدیریت خدمات" },
        new { Name = "ServiceManagement", Title = "مدیریت پیشرفته", Icon = "fa-cogs", Controller = "ServiceManagement", Action = (string)null, Category = "مدیریت خدمات" },
        
        // 4️⃣ مدیریت بیمه
        new { Name = "InsuranceProvider", Title = "ارائه‌دهندگان بیمه", Icon = "fa-building", Controller = "InsuranceProvider", Action = (string)null, Category = "مدیریت بیمه" },
        new { Name = "InsurancePlan", Title = "پلن‌های بیمه", Icon = "fa-shield-alt", Controller = "InsurancePlan", Action = (string)null, Category = "مدیریت بیمه" },
        new { Name = "InsuranceTariff", Title = "تعرفه‌های بیمه", Icon = "fa-money-bill", Controller = "InsuranceTariff", Action = (string)null, Category = "مدیریت بیمه" },
        new { Name = "SupplementaryTariff", Title = "تعرفه تکمیلی", Icon = "fa-plus-circle", Controller = "SupplementaryTariff", Action = (string)null, Category = "مدیریت بیمه" },
