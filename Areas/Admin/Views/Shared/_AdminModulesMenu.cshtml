        new { Name = "Department", Title = "دپارتمان‌ها", Icon = "fa-building", Controller = "Department", Action = (string)null, Category = "مدیریت کلینیک" },
        new { Name = "ClinicBankAccount", Title = "حساب‌های بانکی", Icon = "fa-university", Controller = "ClinicBankAccount", Action = (string)null, Category = "مدیریت کلینیک" },
        
