        new { Name = "DoctorAssignment", Title = "اختصاص پزشکان", Icon = "fa-user-check", Controller = "DoctorAssignment", Action = (string)null, Category = "مدیریت پزشکان" },
        new { Name = "DoctorDashboard", Title = "داشبورد پزشک", Icon = "fa-tachometer-alt", Controller = "DoctorDashboard", Action = (string)null, Category = "مدیریت پزشکان" },
        new { Name = "DoctorReporting", Title = "گزارشات پزشکان", Icon = "fa-chart-line", Controller = "DoctorReporting", Action = (string)null, Category = "مدیریت پزشکان" },
        
