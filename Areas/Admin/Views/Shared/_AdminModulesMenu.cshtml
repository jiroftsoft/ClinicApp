        // 6️⃣ مدیریت مالی
        new { Name = "CashierDashboard", Title = "داشبورد منشی‌ها", Icon = "fa-tachometer-alt", Controller = "CashierDashboard", Action = (string)null, Category = "مدیریت مالی" },
        new { Name = "CashierReport", Title = "گزارشات صندوق", Icon = "fa-chart-bar", Controller = "CashierReport", Action = (string)null, Category = "مدیریت مالی" },
        
        // 7️⃣ تنظیمات سیستم
        new { Name = "FactorSetting", Title = "تنظیمات ضرایب", Icon = "fa-sliders-h", Controller = "FactorSetting", Action = (string)null, Category = "تنظیمات سیستم" },
        new { Name = "InsuranceTypeUpdate", Title = "به‌روزرسانی بیمه", Icon = "fa-sync-alt", Controller = "InsuranceTypeUpdate", Action = (string)null, Category = "تنظیمات سیستم" },
