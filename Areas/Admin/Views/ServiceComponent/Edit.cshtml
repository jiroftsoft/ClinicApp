@using ClinicApp.Extensions
@using ClinicApp.Helpers
@using ClinicApp.Models.Enums
@model ClinicApp.ViewModels.ServiceComponentCreateEditViewModel
@{
    ViewBag.Title = "ویرایش جزء خدمت";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link href="~/Content/plugins/select2/css/select2.min.css" rel="stylesheet" />
    <style>
        /* 🔤 فونت وزیر برای متن‌ها */
        @@font-face {
            font-family: 'Vazir';
            src: url('~/Content/Fonts/vazirmatn/Vazir.woff2') format('woff2'),
                 url('~/Content/Fonts/vazirmatn/Vazir.woff') format('woff'),
                 url('~/Content/Fonts/vazirmatn/Vazir.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        /* 🔢 فونت وزیر با اعداد فارسی */
        @@font-face {
            font-family: 'Vazir-FD';
            src: url('~/Content/Fonts/vazirmatn/Farsi-Digits/Vazir-FD.woff2') format('woff2'),
                 url('~/Content/Fonts/vazirmatn/Farsi-Digits/Vazir-FD.woff') format('woff'),
                 url('~/Content/Fonts/vazirmatn/Farsi-Digits/Vazir-FD.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        /* 🎨 رنگ‌های رسمی درمانی */
        :root {
            --medical-blue: #2c5aa0;
            --medical-blue-light: #e3f2fd;
            --medical-green: #2e7d32;
            --medical-green-light: #e8f5e9;
            --medical-orange: #f57c00;
            --medical-orange-light: #fff3e0;
            --medical-red: #c62828;
            --medical-red-light: #ffebee;
            --medical-gray: #6b7280;
            --medical-gray-light: #f3f4f6;
        }

        /* اعمال فونت به کل صفحه */
        body, .form-control, .form-label, .btn, h1, h2, h3, h4, h5, h6, p, span, div, input, textarea, select, .form-select, .breadcrumb {
            font-family: 'Vazir', Arial, sans-serif !important;
        }

        /* اعمال فونت با اعداد فارسی */
        .badge, .info-value, input[type="number"], .farsi-number, .coefficient-value {
            font-family: 'Vazir-FD', 'Vazir', Arial, sans-serif !important;
        }

        /* 🧭 سلسله‌مراتب ناوبری */
        .breadcrumb-custom {
            background: linear-gradient(135deg, var(--medical-blue) 0%, #1e3a6f 100%);
            padding: 1.5rem;
            border-radius: 12px;
            margin-bottom: 2rem;
            box-shadow: 0 4px 12px rgba(44, 90, 160, 0.15);
        }

        .breadcrumb-custom .breadcrumb {
            background: transparent;
            margin: 0;
            padding: 0;
        }

        .breadcrumb-custom .breadcrumb-item {
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.95rem;
        }

        .breadcrumb-custom .breadcrumb-item + .breadcrumb-item::before {
            content: "◀";
            color: rgba(255, 255, 255, 0.5);
            margin: 0 0.5rem;
        }

        .breadcrumb-custom .breadcrumb-item a {
            color: #ffffff;
            text-decoration: none;
            transition: all 0.2s;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
        }

        .breadcrumb-custom .breadcrumb-item a:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
        }

        .breadcrumb-custom .breadcrumb-item.active {
            color: #ffd700;
            font-weight: 500;
        }

        .breadcrumb-custom .breadcrumb-item i {
            margin-left: 0.25rem;
            font-size: 0.9rem;
        }

        /* 📝 بخش‌های فرم */
        .form-section {
            background-color: #ffffff;
            border-radius: 12px;
            padding: 1.75rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            margin-bottom: 1.5rem;
            border: 1px solid #e5e7eb;
            transition: all 0.3s;
        }

        .form-section:hover {
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
            border-color: var(--medical-blue);
        }

        .form-section-title {
            font-weight: 600;
            color: var(--medical-blue);
            margin-bottom: 1.25rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid var(--medical-blue-light);
            display: flex;
            align-items: center;
            font-size: 1.1rem;
        }

        .form-section-title i {
            margin-left: 0.5rem;
            font-size: 1.2rem;
            color: var(--medical-blue);
        }

        /* 🏷️ برچسب‌های فرم */
        .form-label {
            font-weight: 500;
            color: #374151;
            margin-bottom: 0.5rem;
            font-size: 0.95rem;
        }

        .required::after {
            content: " *";
            color: var(--medical-red);
            margin-right: 2px;
        }

        /* 📥 فیلدهای ورودی */
        .form-control, .form-select {
            border: 1.5px solid #d1d5db;
            border-radius: 8px;
            padding: 0.625rem 0.875rem;
            transition: all 0.2s;
            font-size: 0.95rem;
            background-color: #ffffff;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--medical-blue);
            box-shadow: 0 0 0 3px rgba(44, 90, 160, 0.1);
            outline: none;
        }

        .form-control:hover, .form-select:hover {
            border-color: var(--medical-blue);
        }

        /* ✅ دکمه‌های اصلی */
        .btn-submit {
            background: linear-gradient(135deg, var(--medical-blue) 0%, #1e3a6f 100%);
            color: white;
            border: none;
            padding: 0.75rem 2rem;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s;
            box-shadow: 0 4px 12px rgba(44, 90, 160, 0.2);
            font-size: 1rem;
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(44, 90, 160, 0.3);
            background: linear-gradient(135deg, #1e3a6f 0%, var(--medical-blue) 100%);
            color: white;
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .btn-cancel {
            background: linear-gradient(135deg, var(--medical-gray) 0%, #4b5563 100%);
            color: white;
            border: none;
            padding: 0.75rem 2rem;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
            box-shadow: 0 4px 12px rgba(107, 114, 128, 0.2);
            font-size: 1rem;
        }

        .btn-cancel:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(107, 114, 128, 0.3);
            background: linear-gradient(135deg, #4b5563 0%, var(--medical-gray) 100%);
        }

        .btn-cancel:active {
            transform: translateY(0);
        }

        /* 📊 نمایش اطلاعات فعلی */
        .current-values {
            background: linear-gradient(135deg, var(--medical-blue-light) 0%, #f0f9ff 100%);
            border-radius: 10px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            border: 1px solid #bfdbfe;
        }

        .current-values h6 {
            color: var(--medical-blue);
            margin-bottom: 0.875rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            font-size: 1rem;
        }

        .current-values h6 i {
            margin-left: 0.5rem;
            font-size: 1.1rem;
        }

        .current-values p {
            margin: 0.5rem 0;
            color: #1e3a8a;
            font-size: 0.9rem;
        }

        .current-values p strong {
            color: var(--medical-blue);
            font-weight: 600;
        }

        /* 💡 راهنما */
        .component-type-info {
            background: linear-gradient(135deg, var(--medical-green-light) 0%, #f1f8f4 100%);
            border-radius: 10px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            border: 1px solid #a5d6a7;
        }

        .component-type-info h6 {
            color: var(--medical-green);
            margin-bottom: 0.875rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            font-size: 1rem;
        }

        .component-type-info h6 i {
            margin-left: 0.5rem;
            font-size: 1.1rem;
        }

        .component-type-info p {
            margin: 0.5rem 0;
            color: #1b5e20;
            font-size: 0.9rem;
        }

        .component-type-info p strong {
            color: var(--medical-green);
            font-weight: 600;
        }

        /* ⚠️ خطاها */
        .validation-summary {
            background: linear-gradient(135deg, var(--medical-red-light) 0%, #fef2f2 100%);
            border: 1px solid #fecaca;
            color: var(--medical-red);
            padding: 1.25rem;
            border-radius: 10px;
            margin-bottom: 1.5rem;
        }

        .validation-summary h6 {
            font-weight: 600;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
        }

        .validation-summary h6 i {
            margin-left: 0.5rem;
        }

        .field-validation-error {
            color: var(--medical-red);
            font-size: 0.85rem;
            margin-top: 0.375rem;
            display: block;
        }

        .input-validation-error {
            border-color: var(--medical-red) !important;
            background-color: var(--medical-red-light) !important;
        }

        /* 🔢 فیلد ضریب */
        .coefficient-help {
            background: var(--medical-gray-light);
            padding: 0.75rem;
            border-radius: 6px;
            margin-top: 0.5rem;
            font-size: 0.85rem;
            color: var(--medical-gray);
        }

        .coefficient-help i {
            margin-left: 0.25rem;
            color: var(--medical-blue);
        }

        /* ✔️ Checkbox */
        .form-check-input:checked {
            background-color: var(--medical-green);
            border-color: var(--medical-green);
        }

        .form-check-input:focus {
            border-color: var(--medical-green);
            box-shadow: 0 0 0 0.2rem rgba(46, 125, 50, 0.25);
        }

        .form-check-label {
            color: #374151;
            font-weight: 500;
        }

        /* 📱 Responsive */
        @@media (max-width: 768px) {
            .form-section {
                padding: 1.25rem;
            }

            .breadcrumb-custom {
                padding: 1rem;
            }

            .breadcrumb-custom .breadcrumb-item {
                font-size: 0.85rem;
            }

            .btn-submit, .btn-cancel {
                width: 100%;
                margin-bottom: 0.75rem;
            }
        }
    </style>
}

<!-- 🧭 سلسله‌مراتب ناوبری -->
@if (ViewBag.ClinicId != null && ViewBag.DepartmentId != null && ViewBag.ServiceCategoryId != null && ViewBag.ServiceId != null)
{
    <div class="breadcrumb-custom">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Clinic")">
                        <i class="fas fa-hospital"></i>
                        @(ViewBag.ClinicName ?? "کلینیک")
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Department", new { clinicId = ViewBag.ClinicId })">
                        <i class="fas fa-building"></i>
                        @(ViewBag.DepartmentName ?? "دپارتمان")
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Categories", "Service", new { departmentId = ViewBag.DepartmentId })">
                        <i class="fas fa-layer-group"></i>
                        دسته‌بندی‌ها
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="@Url.Action("CategoryDetails", "Service", new { id = ViewBag.ServiceCategoryId })">
                        <i class="fas fa-folder-open"></i>
                        @(ViewBag.ServiceCategoryName ?? "دسته‌بندی")
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Service", new { serviceCategoryId = ViewBag.ServiceCategoryId })">
                        <i class="fas fa-list"></i>
                        لیست خدمات
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Details", "Service", new { id = ViewBag.ServiceId })">
                        <i class="fas fa-file-medical"></i>
                        @(ViewBag.ServiceTitle ?? "خدمت")
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "ServiceComponent")">
                        <i class="fas fa-puzzle-piece"></i>
                        اجزای خدمت
                    </a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    <i class="fas fa-edit"></i>
                    ویرایش جزء
                </li>
            </ol>
        </nav>
    </div>
}

<!-- Header Section -->
<div class="form-section">
    <h2 class="form-section-title">
        <i class="fas fa-edit"></i> ویرایش جزء خدمت
    </h2>
    <p class="text-muted">لطفاً اطلاعات جزء خدمت را با دقت ویرایش کنید. تمام فیلدهای دارای علامت ستاره (*) الزامی هستند.</p>
</div>

<!-- Validation Summary -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-summary">
        <h6><i class="fas fa-exclamation-triangle"></i> خطاهای اعتبارسنجی</h6>
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
}

<!-- Current Values Display -->
<div class="current-values">
    <h6><i class="fas fa-info-circle"></i> اطلاعات فعلی جزء خدمت</h6>
    <div class="row">
        <div class="col-md-4">
            <p><strong>شناسه جزء:</strong> <span class="farsi-number">@Model.ServiceComponentId</span></p>
        </div>
        <div class="col-md-4">
            <p><strong>خدمت:</strong> @ViewBag.ServiceTitle (@ViewBag.ServiceCode)</p>
        </div>
        <div class="col-md-4">
            <p><strong>نوع جزء:</strong> @ViewBag.ComponentTypeName</p>
        </div>
    </div>
</div>

<!-- Component Type Information -->
<div class="component-type-info">
    <h6><i class="fas fa-lightbulb"></i> راهنمای انواع اجزای خدمت</h6>
    <div class="row">
        <div class="col-md-6">
            <p><strong><i class="fas fa-tools"></i> جزء فنی:</strong> شامل هزینه‌های فنی، تجهیزات، مواد مصرفی و امکانات مورد نیاز برای ارائه خدمت</p>
        </div>
        <div class="col-md-6">
            <p><strong><i class="fas fa-user-md"></i> جزء حرفه‌ای:</strong> شامل دستمزد، تخصص و تجربه پزشک یا ارائه‌دهنده خدمت</p>
        </div>
    </div>
</div>

<!-- Edit Form -->
@using (Html.BeginForm("Edit", "ServiceComponent", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.ServiceComponentId)
    
    <!-- Service Selection -->
    <div class="form-section">
        <h4 class="form-section-title">
            <i class="fas fa-stethoscope"></i> انتخاب خدمت
        </h4>
        
        <div class="row">
            <div class="col-md-12">
                <label for="ServiceId" class="form-label required">خدمت</label>
                @Html.DropDownListFor(m => m.ServiceId, ViewBag.Services as SelectList, "انتخاب خدمت...", new { @class = "form-select", required = "required" })
                @Html.ValidationMessageFor(m => m.ServiceId, "", new { @class = "field-validation-error" })
                <small class="form-text text-muted mt-1">
                    <i class="fas fa-info-circle"></i>
                    خدمتی که این جزء به آن تعلق دارد را انتخاب کنید
                </small>
            </div>
        </div>
    </div>

    <!-- Component Details -->
    <div class="form-section">
        <h4 class="form-section-title">
            <i class="fas fa-cogs"></i> جزئیات جزء خدمت
        </h4>
        
        <div class="row">
            <div class="col-md-6">
                <label for="ComponentType" class="form-label required">نوع جزء</label>
                @{
                    var componentTypeItems = new List<SelectListItem>();
                    foreach (ServiceComponentType type in Enum.GetValues(typeof(ServiceComponentType)))
                    {
                        componentTypeItems.Add(new SelectListItem
                        {
                            Value = ((int)type).ToString(),
                            Text = type.GetDisplayName(),
                            Selected = Model.ComponentType == type
                        });
                    }
                }
                @Html.DropDownListFor(m => m.ComponentType, componentTypeItems, "انتخاب نوع جزء...", new { @class = "form-select", required = "required" })
                @Html.ValidationMessageFor(m => m.ComponentType, "", new { @class = "field-validation-error" })
                <small class="form-text text-muted mt-1">
                    <i class="fas fa-info-circle"></i>
                    نوع جزء (فنی یا حرفه‌ای) را انتخاب کنید
                </small>
            </div>
            
            <div class="col-md-6">
                <label for="Coefficient" class="form-label required">ضریب (کای)</label>
                @Html.TextBoxFor(m => m.Coefficient, "{0:0.##}", new { @class = "form-control coefficient-value", type = "number", step = "0.01", min = "0.01", max = "999999.99", required = "required", placeholder = "مثال: 1.25" })
                @Html.ValidationMessageFor(m => m.Coefficient, "", new { @class = "field-validation-error" })
                <div class="coefficient-help">
                    <i class="fas fa-calculator"></i>
                    ضریب باید بین <strong class="farsi-number">0.01</strong> تا <strong class="farsi-number">999,999.99</strong> باشد
                </div>
            </div>
        </div>
        
        <div class="row mt-3">
            <div class="col-md-12">
                <label for="Description" class="form-label">
                    <i class="fas fa-align-right"></i>
                    توضیحات
                </label>
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = "4", placeholder = "توضیحات تکمیلی در مورد این جزء خدمت (اختیاری)..." })
                @Html.ValidationMessageFor(m => m.Description, "", new { @class = "field-validation-error" })
                <small class="form-text text-muted mt-1">
                    <i class="fas fa-info-circle"></i>
                    حداکثر 500 کاراکتر
                </small>
            </div>
        </div>
        
        <div class="row mt-3">
            <div class="col-md-12">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    <label class="form-check-label" for="IsActive">
                        <i class="fas fa-check-circle"></i>
                        جزء خدمت فعال باشد
                    </label>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="form-section">
        <div class="d-flex justify-content-between flex-wrap">
            <a href="@Url.Action("Index")" class="btn-cancel">
                <i class="fas fa-times"></i> انصراف
            </a>
            
            <button type="submit" class="btn-submit">
                <i class="fas fa-save"></i> ذخیره تغییرات
            </button>
        </div>
    </div>
}

@section Scripts {
    <script src="~/Content/plugins/select2/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            // 🎨 Initialize Select2 با استایل سفارشی
            $('.form-select').select2({
                placeholder: "انتخاب کنید...",
                allowClear: true,
                dir: "rtl",
                language: {
                    noResults: function() {
                        return "نتیجه‌ای یافت نشد";
                    },
                    searching: function() {
                        return "در حال جستجو...";
                    }
                }
            });

            // ✅ Form validation
            (function() {
                'use strict';
                window.addEventListener('load', function() {
                    var forms = document.getElementsByClassName('needs-validation');
                    var validation = Array.prototype.filter.call(forms, function(form) {
                        form.addEventListener('submit', function(event) {
                            if (form.checkValidity() === false) {
                                event.preventDefault();
                                event.stopPropagation();
                                
                                // نمایش پیغام خطا
                                alert('لطفاً تمام فیلدهای الزامی را پر کنید.');
                            }
                            form.classList.add('was-validated');
                        }, false);
                    });
                }, false);
            })();

            // 🔢 Coefficient input validation - Real-time
            $('#Coefficient').on('input', function() {
                var value = parseFloat($(this).val());
                if (isNaN(value) || value < 0.01 || value > 999999.99) {
                    $(this).addClass('input-validation-error');
                    $(this).next('.coefficient-help').css('color', '#c62828');
                } else {
                    $(this).removeClass('input-validation-error');
                    $(this).next('.coefficient-help').css('color', '#6b7280');
                }
            });

            // 💡 Component type change handler - Dynamic placeholder
            $('#ComponentType').on('change', function() {
                var componentType = $(this).val();
                var $coefficient = $('#Coefficient');
                
                if (componentType === '1') { // Technical
                    $coefficient.attr('placeholder', 'مثال: 0.85 (جزء فنی)');
                } else if (componentType === '2') { // Professional
                    $coefficient.attr('placeholder', 'مثال: 1.25 (جزء حرفه‌ای)');
                } else {
                    $coefficient.attr('placeholder', 'مثال: 1.25');
                }
            });

            // ⚠️ Confirm before leaving if form has changes
            var formChanged = false;
            $('form input, form select, form textarea').on('change', function() {
                formChanged = true;
            });

            window.onbeforeunload = function() {
                if (formChanged) {
                    return 'آیا مطمئن هستید که می‌خواهید صفحه را ترک کنید؟ تغییرات ذخیره نشده ممکن است از بین برود.';
                }
            };

            $('form').on('submit', function() {
                formChanged = false;
                window.onbeforeunload = null;
            });

            // 🎯 Focus on first input
            setTimeout(function() {
                $('#ServiceId').focus();
            }, 500);
        });
    </script>
}
