@* صفحه مدیریت تاریخچه ورود کاربران *@
@using ClinicApp.ViewModels.Admin.Security
@model ClinicApp.Interfaces.PagedResult<LoginHistoryIndexViewModel>
@{
    ViewBag.Title = "تاریخچه ورود کاربران";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

@section Styles {
    <link href="~/Content/plugins/datatables/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/persian-datepicker/persian-datepicker.min.css" rel="stylesheet" />
    <link href="~/Content/css/login-history.css" rel="stylesheet" />
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fa fa-history"></i> تاریخچه ورود کاربران
                    </h3>
                </div>
                <div class="card-body">
                    @* فیلتر *@
                    @using (Html.BeginForm("Index", "LoginHistory", FormMethod.Get, new { @class = "mb-4" }))
                    {
                        <div class="row">
                            <div class="col-md-2">
                                @{
                                    ViewBag.PersianDatePickerId = "startDatePicker";
                                    ViewBag.PersianDatePickerName = "StartDate";
                                    ViewBag.PersianDatePickerValue = ViewBag.Filter?.StartDate;
                                    ViewBag.PersianDatePickerLabel = "از تاریخ";
                                    ViewBag.PersianDatePickerPlaceholder = "از تاریخ را انتخاب کنید";
                                    ViewBag.PersianDatePickerRequired = false;
                                }
                                @Html.Partial("_PersianDatePicker")
                            </div>
                            <div class="col-md-2">
                                @{
                                    ViewBag.PersianDatePickerId = "endDatePicker";
                                    ViewBag.PersianDatePickerName = "EndDate";
                                    ViewBag.PersianDatePickerValue = ViewBag.Filter?.EndDate;
                                    ViewBag.PersianDatePickerLabel = "تا تاریخ";
                                    ViewBag.PersianDatePickerPlaceholder = "تا تاریخ را انتخاب کنید";
                                    ViewBag.PersianDatePickerRequired = false;
                                }
                                @Html.Partial("_PersianDatePicker")
                            </div>
                            <div class="col-md-2">
                                <label>وضعیت</label>
                                <select name="IsSuccessful" class="form-control">
                                    <option value="">همه</option>
                                    <option value="true" @(ViewBag.Filter?.IsSuccessful == true ? "selected" : "")>موفق</option>
                                    <option value="false" @(ViewBag.Filter?.IsSuccessful == false ? "selected" : "")>ناموفق</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label>نوع دستگاه</label>
                                <select name="DeviceType" class="form-control">
                                    <option value="">همه</option>
                                    <option value="Mobile" @(ViewBag.Filter?.DeviceType == "Mobile" ? "selected" : "")>موبایل</option>
                                    <option value="Desktop" @(ViewBag.Filter?.DeviceType == "Desktop" ? "selected" : "")>دسکتاپ</option>
                                    <option value="Tablet" @(ViewBag.Filter?.DeviceType == "Tablet" ? "selected" : "")>تبلت</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label>جستجو</label>
                                <input type="text" name="SearchTerm" value="@(ViewBag.Filter?.SearchTerm)" class="form-control" placeholder="IP, UserAgent, ..." />
                            </div>
                            <div class="col-md-2">
                                <label>&nbsp;</label>
                                <button type="submit" class="btn btn-primary btn-block">
                                    <i class="fa fa-search"></i> جستجو
                                </button>
                            </div>
                        </div>
                    }

                    @* جدول تاریخچه ورودها با DataTables *@
                    <div class="table-responsive">
                        <table id="loginHistoryTable" class="table table-striped table-hover table-bordered">
                            <thead>
                                <tr>
                                    <th>شناسه</th>
                                    <th>کاربر</th>
                                    <th>کد ملی</th>
                                    <th>تاریخ ورود</th>
                                    <th>تاریخ خروج</th>
                                    <th>IP Address</th>
                                    <th>دستگاه</th>
                                    <th>مرورگر</th>
                                    <th>سیستم عامل</th>
                                    <th>وضعیت</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Items != null && Model.Items.Any())
                                {
                                    foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@item.UserFullName</td>
                                            <td>@item.UserNationalCode</td>
                                            <td>@item.LoginTimeShamsi</td>
                                            <td>@(item.LogoutTimeShamsi ?? "-")</td>
                                            <td>@item.IpAddress</td>
                                            <td>
                                                <span class="badge badge-info">@item.DeviceType</span>
                                            </td>
                                            <td>@item.BrowserName @item.BrowserVersion</td>
                                            <td>@item.OSName @item.OSVersion</td>
                                            <td>
                                                @if (item.IsSuccessful)
                                                {
                                                    <span class="badge badge-success">
                                                        <i class="fa fa-check"></i> موفق
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">
                                                        <i class="fa fa-times"></i> ناموفق
                                                    </span>
                                                    if (!string.IsNullOrWhiteSpace(item.FailureReason))
                                                    {
                                                        <br />
                                                        <small class="text-muted">@item.FailureReason</small>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-sm btn-info" title="مشاهده جزئیات">
                                                    <i class="fa fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="11" class="text-center">هیچ رکوردی یافت نشد</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* بارگذاری Script Persian DatePicker *@
    @Html.Partial("_PersianDatePickerScript")
    
    @* بارگذاری DataTables Scripts *@
    <script src="~/Content/plugins/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/Content/plugins/datatables/js/dataTables.bootstrap4.min.js"></script>
    
    @* بارگذاری Script اختصاصی صفحه *@
    <script src="~/Content/js/login-history-index.js"></script>
}

