@using ClinicApp.Extensions
@using ClinicApp.Helpers
@model ClinicApp.ViewModels.ServiceCreateEditViewModel
@{
    ViewBag.Title = "ایجاد خدمات جدید";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    
    // اطلاعات اضافی برای Medical Environment
    var serviceCategoryName = ViewBag.ServiceCategoryName as string ?? "دسته‌بندی انتخاب شده";
    var departmentName = ViewBag.DepartmentName as string ?? "دپارتمان";
}

<!-- بسته‌های CSS مورد نیاز -->
@section Styles {
    <link href="~/Content/plugins/select2/css/select2.min.css" rel="stylesheet" />
    <style>
        /* 🔤 فونت وزیر برای متن‌ها */
        @@font-face {
            font-family: 'Vazir';
            src: url('~/Content/Fonts/vazirmatn/Vazir.woff2') format('woff2'),
                 url('~/Content/Fonts/vazirmatn/Vazir.woff') format('woff'),
                 url('~/Content/Fonts/vazirmatn/Vazir.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        /* 🔢 فونت وزیر با اعداد فارسی */
        @@font-face {
            font-family: 'Vazir-FD';
            src: url('~/Content/Fonts/vazirmatn/Farsi-Digits/Vazir-FD.woff2') format('woff2'),
                 url('~/Content/Fonts/vazirmatn/Farsi-Digits/Vazir-FD.woff') format('woff'),
                 url('~/Content/Fonts/vazirmatn/Farsi-Digits/Vazir-FD.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
            font-display: swap;
        }

        /* اعمال فونت به کل صفحه */
        body, .form-control, .form-label, .btn, h1, h2, h3, h4, h5, h6, p, span, div, input, textarea, select {
            font-family: 'Vazir', Arial, sans-serif !important;
        }

        /* اعمال فونت با اعداد فارسی به اعداد */
        .badge, .info-value, input[type="number"] {
            font-family: 'Vazir-FD', 'Vazir', Arial, sans-serif !important;
        }

        /* 🎨 رنگ‌های رسمی پزشکی */
        :root {
            --medical-blue: #2c5aa0;
            --medical-blue-light: #3d6bb3;
            --medical-green: #10b981;
            --medical-orange: #f59e0b;
            --medical-red: #ef4444;
            --medical-gray: #6b7280;
            --medical-gray-light: #f3f4f6;
        }

        /* 🧭 سلسله‌مراتب ناوبری */
        .breadcrumb-custom {
            background: linear-gradient(135deg, #e3f2fd 0%, #ffffff 100%);
            border: 1px solid #bbdefb;
            border-radius: 10px;
            padding: 1rem 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 2px 4px rgba(44, 90, 160, 0.05);
        }

        .breadcrumb-custom .breadcrumb {
            margin-bottom: 0;
            background: transparent;
            padding: 0;
        }

        .breadcrumb-custom .breadcrumb-item {
            font-size: 1rem;
            font-weight: 500;
        }

        .breadcrumb-custom .breadcrumb-item + .breadcrumb-item::before {
            content: "◄";
            color: var(--medical-blue);
            font-weight: bold;
            padding: 0 0.75rem;
        }

        .breadcrumb-custom .breadcrumb-item a {
            color: var(--medical-blue);
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .breadcrumb-custom .breadcrumb-item a:hover {
            color: var(--medical-blue-light);
            transform: translateX(3px);
        }

        .breadcrumb-custom .breadcrumb-item.active {
            color: var(--medical-gray);
            font-weight: 600;
        }

        .breadcrumb-custom i {
            font-size: 0.9rem;
        }

        /* استایل‌های اختصاصی برای فرم ایجاد خدمات پزشکی */
        .form-section {
            background-color: #fff;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 2px 8px rgba(44, 90, 160, 0.08);
            margin-bottom: 1.5rem;
            border: 1px solid #e5e7eb;
        }

        .form-section-title {
            font-weight: 600;
            color: var(--medical-blue);
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid var(--medical-gray-light);
            display: flex;
            align-items: center;
        }

            .form-section-title i {
                margin-left: 0.5rem;
                font-size: 1.2rem;
            }

        .required:after {
            content: " *";
            color: #d32f2f;
            margin-right: 2px;
        }

        .btn-submit {
            background: linear-gradient(135deg, var(--medical-blue) 0%, var(--medical-blue-light) 100%);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            box-shadow: 0 4px 6px rgba(44, 90, 160, 0.2);
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(44, 90, 160, 0.4);
                background: linear-gradient(135deg, var(--medical-blue-light) 0%, var(--medical-blue) 100%);
            }

            .btn-submit i {
                margin-left: 0.5rem;
            }

        .btn-cancel {
            background: linear-gradient(135deg, var(--medical-gray-light) 0%, #ffffff 100%);
            color: var(--medical-gray);
            border: 2px solid var(--medical-gray-light);
            border-radius: 8px;
            padding: 12px 30px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            font-weight: 600;
        }

            .btn-cancel:hover {
                background: var(--medical-gray-light);
                border-color: var(--medical-gray);
                color: var(--medical-gray);
                transform: translateY(-2px);
                box-shadow: 0 4px 6px rgba(107, 114, 128, 0.2);
            }

            .btn-cancel i {
                margin-left: 0.5rem;
            }

        .form-control:focus {
            border-color: var(--medical-blue);
            box-shadow: 0 0 0 0.25rem rgba(44, 90, 160, 0.15);
        }

        .select2-container .select2-selection--single {
            height: 42px;
            padding: 6px 12px;
            font-size: 1rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 28px;
            padding-right: 10px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 40px;
        }

        .form-note {
            font-size: 0.85rem;
            color: #6c757d;
            margin-top: 4px;
            font-style: italic;
        }

        .validation-summary-errors {
            background-color: #ffebee;
            border-radius: 6px;
            padding: 12px;
            margin-bottom: 15px;
            border-right: 3px solid #d32f2f;
        }

            .validation-summary-errors ul {
                margin-bottom: 0;
                padding-left: 20px;
            }

            .validation-summary-errors li {
                margin-bottom: 4px;
            }

        .form-floating > label {
            padding: 1rem 0.75rem;
        }

        .medical-highlight {
            background-color: #e3f2fd;
            border-left: 3px solid #1a6dcc;
            padding: 15px;
            border-radius: 0 4px 4px 0;
            margin-bottom: 15px;
        }

            .medical-highlight h5 {
                margin-top: 0;
                color: #1a6dcc;
            }

            .medical-highlight ul {
                padding-right: 20px;
            }

            .medical-highlight li {
                margin-bottom: 8px;
            }

        .form-actions {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }

        /* استایل‌های موبایل */
        @@media (max-width: 768px) {
            .form-section {
                padding: 15px;
            }

            .btn-submit, .btn-cancel {
                width: 100%;
                margin-bottom: 10px;
            }

            .form-note {
                font-size: 0.8rem;
            }

            .form-actions {
                flex-direction: column;
            }

            .medical-highlight {
                padding: 12px;
            }
        }

        /* استایل‌های مربوط به محیط پزشکی */
        .medical-environment {
            background-color: #f8f9fa;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
        }

            .medical-environment h5 {
                color: #1a6dcc;
                margin-bottom: 12px;
                display: flex;
                align-items: center;
            }

                .medical-environment h5 i {
                    margin-left: 8px;
                }

            .medical-environment .info-item {
                display: flex;
                align-items: center;
                margin-bottom: 8px;
                padding: 8px 0;
            }

                .medical-environment .info-item i {
                    margin-left: 10px;
                    color: #1a6dcc;
                    width: 20px;
                }

            .medical-environment .info-value {
                font-weight: 500;
            }

        /* استایل‌های مربوط به امنیت اطلاعات پزشکی */
        .security-badge {
            display: inline-block;
            background-color: #e8f5e9;
            color: #2e7d32;
            padding: 3px 10px;
            border-radius: 15px;
            font-size: 0.85rem;
            margin-right: 5px;
        }

        .sensitive-data {
            background-color: #fff8e1;
            border-left: 3px solid #ffa000;
            padding: 10px 15px;
            border-radius: 0 4px 4px 0;
            margin: 10px 0;
        }

            .sensitive-data h6 {
                margin-top: 0;
                color: #ef6c00;
                display: flex;
                align-items: center;
            }

                .sensitive-data h6 i {
                    margin-left: 8px;
                }
    </style>
}

<div class="page-content">
    <div class="container-fluid">
        <!-- هدر صفحه - Medical Environment -->
        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <h1 class="page-title mb-0">
                    <i class="fas fa-concierge-bell text-primary me-2"></i>
                    🏥 ایجاد خدمات جدید
                </h1>
                <p class="text-muted mb-0">
                    افزودن خدمت جدید به دسته‌بندی: <strong>@serviceCategoryName</strong> 
                    <span class="text-muted">(دپارتمان: @departmentName)</span>
                </p>
            </div>
            <div class="col-md-6 text-md-end mt-2 mt-md-0">
                <a href="@Url.Action("Index", "Service", new { serviceCategoryId = Model?.ServiceCategoryId })" class="btn btn-cancel">
                    <i class="fas fa-arrow-right me-1"></i> بازگشت به لیست
                </a>
            </div>
        </div>

        <!-- 🧭 سلسله‌مراتب ناوبری -->
        @if (ViewBag.ClinicId != null && ViewBag.DepartmentId != null && ViewBag.ServiceCategoryId != null)
        {
            <div class="breadcrumb-custom">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Clinic")">
                                <i class="fas fa-hospital"></i>
                                @(ViewBag.ClinicName ?? "کلینیک")
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Department", new { clinicId = ViewBag.ClinicId })">
                                <i class="fas fa-building"></i>
                                @(ViewBag.DepartmentName ?? "دپارتمان")
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Categories", "Service", new { departmentId = ViewBag.DepartmentId })">
                                <i class="fas fa-layer-group"></i>
                                دسته‌بندی‌ها
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("CategoryDetails", "Service", new { id = ViewBag.ServiceCategoryId })">
                                <i class="fas fa-folder-open"></i>
                                @(ViewBag.ServiceCategoryName ?? "دسته‌بندی")
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Service", new { serviceCategoryId = ViewBag.ServiceCategoryId })">
                                <i class="fas fa-list"></i>
                                لیست خدمات
                            </a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">
                            <i class="fas fa-plus-circle"></i>
                            ایجاد خدمت جدید
                        </li>
                    </ol>
                </nav>
            </div>
        }

        <!-- هشدارهای امنیتی پزشکی -->
        <div class="alert alert-info mb-4">
            <div class="d-flex align-items-center">
                <i class="fas fa-shield-alt fa-2x me-3 text-primary"></i>
                <div>
                    <h5 class="mb-1">رعایت استانداردهای امنیتی پزشکی</h5>
                    <p class="mb-0">در هنگام ایجاد خدمات پزشکی، لطفاً اطلاعات حساس را با دقت وارد کنید. تمام اطلاعات پزشکی تحت پوشش قانون حفظ حریم خصوصی ایران قرار دارند.</p>
                </div>
            </div>
        </div>

        <!-- فرم ایجاد خدمات -->
        <div class="row">
            <div class="col-lg-8">
                @using (Html.BeginForm("Create", "Service", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-section">
                        <h5 class="form-section-title">
                            <i class="fas fa-edit"></i> اطلاعات اصلی خدمات
                        </h5>

                        @Html.ValidationSummary(false, "", new { @class = "validation-summary-errors" })

                        <div class="mb-4">
                            @Html.LabelFor(model => model.Title, new { @class = "form-label required" })
                            @Html.TextBoxFor(model => model.Title, new { 
                                @class = "form-control form-control-lg", 
                                placeholder = "عنوان خدمات را وارد کنید", 
                                autofocus = "autofocus",
                                required = "required",
                                minlength = "3",
                                maxlength = "250",
                                pattern = "^[\\u0600-\\u06FF\\u0750-\\u077F\\u08A0-\\u08FF\\uFB50-\\uFDFF\\uFE70-\\uFEFF\\s\\w\\d\\-\\(\\)\\,\\.\\!\\?]+$"
                            })
                            @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger small mt-1" })
                            <div class="form-note">مثال: "معاینه اولیه دندانپزشکی"، "تزریق واکسن آنفلوانزا" (حداقل 3 کاراکتر، حداکثر 250 کاراکتر)</div>
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(model => model.ServiceCode, "کد خدمت (فقط اعداد)", new { @class = "form-label required" })
                            @Html.TextBoxFor(model => model.ServiceCode, new { 
                                @class = "form-control form-control-lg", 
                                placeholder = "کد خدمات را وارد کنید (فقط عدد)", 
                                required = "required",
                                minlength = "3",
                                maxlength = "10",
                                pattern = "^\\d{3,10}$",
                                title = "کد خدمات فقط باید شامل اعداد باشد (3-10 رقم)"
                            })
                            @Html.ValidationMessageFor(model => model.ServiceCode, "", new { @class = "text-danger small mt-1" })
                            <div class="form-note">مثال: "978001"، "100001" - فقط اعداد مجاز است (3-10 رقم)</div>
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(model => model.ServiceCategoryId, new { @class = "form-label required" })
                            @if (ViewBag.ServiceCategories != null && ((IEnumerable<SelectListItem>)ViewBag.ServiceCategories).Any())
                            {
                                @Html.DropDownListFor(model => model.ServiceCategoryId, (IEnumerable<SelectListItem>)ViewBag.ServiceCategories, "انتخاب دسته‌بندی", new { @class = "form-control form-control-lg select2", id = "ServiceCategoryId" })
                            }
                            else
                            {
                                <select class="form-control form-control-lg select2" id="ServiceCategoryId" name="ServiceCategoryId">
                                    <option value="">در حال بارگذاری دسته‌بندی‌ها...</option>
                                </select>
                            }
                            @Html.ValidationMessageFor(model => model.ServiceCategoryId, "", new { @class = "text-danger small mt-1" })
                            <div class="form-note">دسته‌بندی مربوط به این خدمات را انتخاب کنید</div>
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(model => model.Price, "قیمت خدمت (ریال)", new { @class = "form-label required" })
                            @Html.TextBoxFor(model => model.Price, new { 
                                @class = "form-control form-control-lg", 
                                type = "number", 
                                required = "required",
                                min = "1", 
                                max = "9999999999",
                                step = "1", 
                                placeholder = "قیمت به ریال را وارد کنید - مثال: 85800",
                                title = "قیمت باید بین 1 تا 9,999,999,999 ریال باشد"
                            })
                            @Html.ValidationMessageFor(model => model.Price, "", new { @class = "text-danger small mt-1" })
                            <div class="form-note">قیمت خدمات به ریال (بدون علامت و بدون اعشار) - مثال: 85800، 5000000</div>
                        </div>

                        <!-- بخش محاسبه قیمت بر اساس اجزای فنی و حرفه‌ای -->
                        <div class="form-section">
                            <h5 class="form-section-title">
                                <i class="fas fa-calculator"></i>
                                محاسبه قیمت بر اساس اجزای فنی و حرفه‌ای
                            </h5>
                            
                            <div class="row">
                                <div class="col-12">
                                    <div class="alert alert-info">
                                        <i class="fas fa-info-circle"></i>
                                        <strong>نکته:</strong> با وارد کردن ضرایب فنی و حرفه‌ای، اجزای خدمت به صورت خودکار ایجاد می‌شوند و قیمت خدمت محاسبه می‌گردد.
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(model => model.TechnicalCoefficient, new { @class = "form-label" })
                                        @Html.TextBoxFor(model => model.TechnicalCoefficient, "{0:0.##}", new { 
                                            @class = "form-control farsi-number", 
                                            @type = "number", 
                                            step = "0.01", 
                                            min = "0.01", 
                                            max = "999999.99", 
                                            placeholder = "مثال: 0.5",
                                            @id = "TechnicalCoefficient"
                                        })
                                        @Html.ValidationMessageFor(model => model.TechnicalCoefficient, "", new { @class = "text-danger small mt-1" })
                                        <div class="form-note">ضریب فنی برای محاسبه قیمت (اختیاری - می‌توانید بعداً اضافه کنید)</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(model => model.ProfessionalCoefficient, new { @class = "form-label" })
                                        @Html.TextBoxFor(model => model.ProfessionalCoefficient, "{0:0.##}", new { 
                                            @class = "form-control farsi-number", 
                                            @type = "number", 
                                            step = "0.01", 
                                            min = "0.01", 
                                            max = "999999.99", 
                                            placeholder = "مثال: 1.3",
                                            @id = "ProfessionalCoefficient"
                                        })
                                        @Html.ValidationMessageFor(model => model.ProfessionalCoefficient, "", new { @class = "text-danger small mt-1" })
                                        <div class="form-note">ضریب حرفه‌ای برای محاسبه قیمت (اختیاری - می‌توانید بعداً اضافه کنید)</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Container برای نمایش محاسبات داینامیک -->
                            <div class="row">
                                <div class="col-12">
                                    <div id="service-calculation-container" class="service-calculation" style="display: none;">
                                        <!-- محاسبات داینامیک در اینجا نمایش داده می‌شود -->
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(model => model.IsHashtagged, new { @class = "form-label" })
                                        <div class="form-check">
                                            @Html.CheckBoxFor(model => model.IsHashtagged, new { @class = "form-check-input" })
                                            @Html.LabelFor(model => model.IsHashtagged, "آیا این خدمت هشتگ‌دار است؟", new { @class = "form-check-label" })
                                        </div>
                                        @Html.ValidationMessageFor(model => model.IsHashtagged, "", new { @class = "text-danger small mt-1" })
                                        <div class="form-note">خدمات هشتگ‌دار از کای‌های متفاوتی استفاده می‌کنند</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(model => model.PriceCalculationType, new { @class = "form-label" })
                                        @Html.DropDownListFor(model => model.PriceCalculationType, 
                                            new SelectList(new[] {
                                                new { Value = "1", Text = "قیمت ثابت" },
                                                new { Value = "2", Text = "محاسبه بر اساس اجزای فنی و حرفه‌ای" }
                                            }, "Value", "Text", "2"), 
                                            new { @class = "form-control" })
                                        @Html.ValidationMessageFor(model => model.PriceCalculationType, "", new { @class = "text-danger small mt-1" })
                                        <div class="form-note">نوع محاسبه قیمت خدمت</div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- نمایش محاسبه قیمت -->
                            <div class="alert alert-info" id="price-calculation-info" style="display: none;">
                                <h6><i class="fas fa-info-circle"></i> محاسبه قیمت</h6>
                                <p class="mb-0" id="price-calculation-text"></p>
                            </div>
                        </div>

                        <div class="mb-4">
                            @Html.LabelFor(model => model.Description, new { @class = "form-label" })
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control form-control-lg", rows = "4", placeholder = "توضیحات خدمات را وارد کنید" })
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger small mt-1" })
                            <div class="form-note">توضیحات تکمیلی درباره این خدمات (اختیاری)</div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-submit">
                                <i class="fas fa-save"></i> ذخیره خدمات
                            </button>
                            <a href="@Url.Action("Index", "Service")" class="btn btn-cancel">
                                <i class="fas fa-times"></i> انصراف
                            </a>
                        </div>
                    </div>

                    <!-- بخش راهنمای سریع برای محیط پزشکی -->
                    <div class="medical-highlight">
                        <h5><i class="fas fa-lightbulb"></i> راهنمای سریع برای محیط پزشکی</h5>
                        <ul>
                            <li>برای افزایش سرعت در محیط پزشکی، از کلیدهای میانبر استفاده کنید: <strong>Tab</strong> برای حرکت بین فیلدها و <strong>Ctrl + Enter</strong> برای ذخیره سریع</li>
                            <li>کدهای خدمات باید فقط شامل اعداد باشند و بین 3 تا 10 رقم داشته باشند (مثال: 978001 برای ویزیت)</li>
                            <li>قیمت‌ها باید با افزایش 10,000 ریالی وارد شوند (برای ساده‌سازی محاسبات در محیط پزشکی)</li>
                            <li>توضیحات خدمات باید شامل نکات ایمنی و پروتکل‌های مربوطه باشد</li>
                        </ul>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <!-- راهنمای استفاده -->
                <div class="form-section">
                    <h5 class="form-section-title">
                        <i class="fas fa-info-circle"></i> راهنمای استفاده
                    </h5>
                    <div class="text-muted">
                        <p class="mb-3">
                            <i class="fas fa-info-circle text-primary me-1"></i>
                            خدمات پزشکی برای سازماندهی خدمات کلینیک شما در دسته‌بندی‌های مختلف استفاده می‌شوند.
                        </p>
                        <p class="mb-3">
                            <i class="fas fa-info-circle text-primary me-1"></i>
                            مثال‌هایی از خدمات: "معاینه اولیه"، "تزریق واکسن"، "آزمایش خون"
                        </p>
                        <p class="mb-3">
                            <i class="fas fa-exclamation-triangle text-warning me-1"></i>
                            عنوان خدمات نباید تکراری باشد و حداکثر 250 کاراکتر می‌تواند باشد.
                        </p>
                        <p class="mb-3">
                            <i class="fas fa-exclamation-triangle text-warning me-1"></i>
                            کد خدمات باید منحصر به فرد باشد و فقط می‌تواند شامل اعداد باشد (3-10 رقم).
                        </p>
                        <p class="mb-3">
                            <i class="fas fa-exclamation-triangle text-warning me-1"></i>
                            قیمت خدمات نمی‌تواند منفی باشد و باید به ریال وارد شود (مضرب 10,000).
                        </p>
                        <p class="mb-0">
                            <i class="fas fa-exclamation-triangle text-warning me-1"></i>
                            دسته‌بندی‌های خدمات بر اساس دپارتمان‌های کلینیک تعریف می‌شوند.
                        </p>
                    </div>
                </div>

                <!-- اطلاعات سیستم -->
                <div class="form-section">
                    <h5 class="form-section-title">
                        <i class="fas fa-history"></i> اطلاعات سیستم
                    </h5>
                    <div class="text-muted">
                        <div class="medical-environment">
                            <div class="info-item">
                                <i class="fas fa-user"></i>
                                <span class="info-value">@ViewBag.CurrentUserName</span>
                            </div>
                            <div class="info-item">
                                <i class="fas fa-calendar-alt"></i>
                                <span class="info-value">@DateTime.Now.ToPersianDateTime()</span>
                            </div>
                            <div class="info-item">
                                <i class="fas fa-clock"></i>
                                <span class="info-value">@DateTime.Now.ToString("HH:mm")</span>
                            </div>
                            <div class="info-item">
                                <i class="fas fa-info-circle"></i>
                                <span class="info-value">این خدمات به صورت پیش‌فرض فعال خواهد بود</span>
                            </div>
                        </div>

                        <div class="sensitive-data">
                            <h6><i class="fas fa-lock"></i> امنیت اطلاعات پزشکی</h6>
                            <p class="mb-0">تمام اطلاعات وارد شده تحت پوشش قانون حفظ حریم خصوصی ایران قرار دارند و تنها توسط کاربران مجاز قابل دسترسی هستند.</p>
                        </div>

                        <div class="d-flex align-items-center mt-3">
                            <i class="fas fa-shield-alt text-success me-2"></i>
                            <span class="security-badge">داده‌های پزشکی رمزگذاری شده</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Content/plugins/select2/js/select2.full.min.js"></script>
    <script src="~/Content/plugins/select2/js/i18n/fa.min.js"></script>
    <script src="~/Scripts/app/service-calculation.js"></script>
    <link href="~/Content/css/service-calculation.css" rel="stylesheet" />

    <script>
        $(document).ready(function () {
            console.log('🏥 MEDICAL: شروع راه‌اندازی فرم ایجاد خدمت');
            
            // فعال‌سازی select2 برای انتخاب دسته‌بندی - Medical Environment
            $('.select2').select2({
                placeholder: "انتخاب دسته‌بندی",
                language: "fa",
                width: '100%',
                minimumResultsForSearch: -1,
                allowClear: true
            });

            // اطمینان از انتخاب صحیح دسته‌بندی
            var selectedCategoryId = @(Model?.ServiceCategoryId ?? 0);
            if (selectedCategoryId > 0) {
                console.log('🏥 MEDICAL: دسته‌بندی انتخاب شده:', selectedCategoryId);
                $('#ServiceCategoryId').val(selectedCategoryId).trigger('change');
            }

            // بررسی وضعیت dropdown
            var dropdown = $('#ServiceCategoryId');
            if (dropdown.length > 0) {
                var options = dropdown.find('option');
                console.log('🏥 MEDICAL: تعداد گزینه‌های dropdown:', options.length);
                
                if (options.length <= 1) {
                    console.warn('🏥 MEDICAL: dropdown خالی است یا فقط یک گزینه دارد');
                    // تلاش برای بارگذاری مجدد
                    setTimeout(function() {
                        location.reload();
                    }, 2000);
                }
            }

            // اعتبارسنجی فرم
            (function () {
                'use strict';
                window.addEventListener('load', function () {
                    var forms = document.getElementsByClassName('needs-validation');
                    Array.prototype.filter.call(forms, function (form) {
                        form.addEventListener('submit', function (event) {
                            if (form.checkValidity() === false) {
                                event.preventDefault();
                                event.stopPropagation();
                            }
                            form.classList.add('was-validated');
                        }, false);
                    });
                }, false);
            })();

            // افزودن کلیدهای میانبر برای محیط پزشکی
            $(document).keydown(function(e) {
                // کلیدهای میانبر برای محیط پزشکی
                if (e.ctrlKey && e.key === 'Enter') {
                    // ذخیره سریع با Ctrl + Enter
                    $('form button[type="submit"]').click();
                    return false;
                }
            });

            // فرمت‌دهی قیمت - Medical Environment (فقط نمایش، نه ورود)
            $('#Price').on('blur', function() {
                var value = $(this).val();
                if (value && !isNaN(value)) {
                    // فقط نمایش فرمت شده، بدون تغییر مقدار اصلی
                    var numericValue = parseInt(value);
                    if (numericValue > 0) {
                        // نمایش فرمت شده در tooltip
                        $(this).attr('title', 'مبلغ: ' + numericValue.toLocaleString('fa-IR') + ' ریال');
                    }
                }
            });

            // محاسبه قیمت بر اساس اجزای فنی و حرفه‌ای
            function calculatePriceFromComponents() {
                // فیلدهای TechnicalPart و ProfessionalPart حذف شدند
                // محاسبه از طریق ServiceComponents انجام می‌شود
                var isHashtagged = $('#IsHashtagged').is(':checked');
                var calculationType = $('#PriceCalculationType').val();

                if (calculationType === '2') {
                    // محاسبه از طریق ServiceComponents - نیاز به UI جدید
                    $('#price-calculation-info').hide();
                    showServiceComponentsInfo();
                } else {
                    $('#price-calculation-info').hide();
                }
            }

            // نمایش اطلاعات ServiceComponents
            function showServiceComponentsInfo() {
                $('#price-calculation-text').html(
                    '<div class="alert alert-warning">' +
                    '<i class="fas fa-exclamation-triangle"></i> ' +
                    '<strong>توجه:</strong> برای محاسبه قیمت بر اساس اجزای فنی و حرفه‌ای، ' +
                    'پس از ایجاد خدمت، اجزای محاسباتی را در بخش مدیریت اجزای خدمات اضافه کنید.' +
                    '</div>'
                );
                $('#price-calculation-info').show();
            }

            // دریافت کای‌ها از سرور
            function fetchKaiFactors(technicalPart, professionalPart, isHashtagged) {
                var currentYear = 1404; // سال مالی جاری

                // نمایش لودینگ
                $('#price-calculation-text').html('<i class="fas fa-spinner fa-spin"></i> در حال محاسبه...');
                $('#price-calculation-info').show();

                // درخواست‌های موازی برای دریافت کای‌های فنی و حرفه‌ای
                var technicalPromise = $.get('@Url.Action("GetFactorsByType", "FactorSetting")', {
                    factorType: 1, // Technical
                    financialYear: currentYear
                });

                var professionalPromise = $.get('@Url.Action("GetFactorsByType", "FactorSetting")', {
                    factorType: 2, // Professional
                    financialYear: currentYear
                });

                $.when(technicalPromise, professionalPromise).done(function(technicalResponse, professionalResponse) {
                    var technicalFactors = technicalResponse[0];
                    var professionalFactors = professionalResponse[0];

                    // پیدا کردن کای مناسب
                    var technicalKai = findAppropriateKai(technicalFactors, isHashtagged);
                    var professionalKai = findAppropriateKai(professionalFactors, isHashtagged);

                    if (technicalKai && professionalKai) {
                        calculateAndDisplayPrice(technicalPart, professionalPart, technicalKai, professionalKai);
                    } else {
                        showKaiNotFoundError(isHashtagged, currentYear);
                    }
                }).fail(function() {
                    $('#price-calculation-text').html('<span class="text-danger">خطا در دریافت کای‌ها از سرور</span>');
                });
            }

            // پیدا کردن کای مناسب
            function findAppropriateKai(factors, isHashtagged) {
                // بررسی اینکه factors یک آرایه است
                if (!Array.isArray(factors) || factors.length === 0) {
                    console.warn('⚠️ findAppropriateKai: factors is not an array or is empty:', factors);
                    return null;
                }

                // ابتدا کای مطابق با وضعیت هشتگ را جستجو کن
                var exactMatch = factors.find(function(f) {
                    return f && f.isActive && f.isHashtagged === isHashtagged;
                });

                if (exactMatch) {
                    return exactMatch;
                }

                // اگر یافت نشد، اولین کای فعال را برگردان
                var fallback = factors.find(function(f) {
                    return f && f.isActive;
                });

                return fallback;
            }

            // محاسبه و نمایش قیمت
            function calculateAndDisplayPrice(technicalPart, professionalPart, technicalKai, professionalKai) {
                var technicalTotal = technicalPart * technicalKai.value;
                var professionalTotal = professionalPart * professionalKai.value;
                var calculatedPrice = technicalTotal + professionalTotal;

                var calculationHtml = '';
                
                if (technicalPart > 0) {
                    calculationHtml += 'جزء فنی: ' + technicalPart + ' × کای فنی (' + technicalKai.name + '): ' + 
                                     technicalKai.value.toFixed(2) + ' = ' + technicalTotal.toFixed(0) + ' ریال<br>';
                    calculationHtml += '<small style="color: #666;">(' + (technicalTotal / 10).toFixed(0) + ' تومان)</small><br>';
                }
                
                if (professionalPart > 0) {
                    calculationHtml += 'جزء حرفه‌ای: ' + professionalPart + ' × کای حرفه‌ای (' + professionalKai.name + '): ' + 
                                     professionalKai.value.toFixed(2) + ' = ' + professionalTotal.toFixed(0) + ' ریال<br>';
                    calculationHtml += '<small style="color: #666;">(' + (professionalTotal / 10).toFixed(0) + ' تومان)</small><br>';
                }
                
                calculationHtml += '<hr><strong>قیمت کل: ' + calculatedPrice.toFixed(0) + ' ریال</strong><br>';
                calculationHtml += '<small style="color: #666;">(' + (calculatedPrice / 10).toFixed(0) + ' تومان)</small>';

                $('#price-calculation-text').html(calculationHtml);
                $('#price-calculation-info').show();

                // به‌روزرسانی فیلد قیمت
                $('#Price').val(Math.round(calculatedPrice));
            }

            // نمایش خطای عدم وجود کای
            function showKaiNotFoundError(isHashtagged, currentYear) {
                var hashtagText = isHashtagged ? 'هشتگ‌دار' : 'عادی';
                $('#price-calculation-text').html(
                    '<span class="text-warning">' +
                    '<i class="fas fa-exclamation-triangle"></i> ' +
                    'کای‌های مورد نیاز برای خدمات ' + hashtagText + ' در سال مالی ' + currentYear + ' یافت نشد.<br>' +
                    'لطفاً ابتدا کای‌های مربوطه را در <a href="@Url.Action("Index", "FactorSetting")" target="_blank">بخش مدیریت کای‌ها</a> تعریف کنید.' +
                    '</span>'
                );
            }

            // محاسبه خودکار قیمت بر اساس ضرایب فنی و حرفه‌ای
            function calculatePriceFromCoefficients() {
                var technicalCoeff = parseFloat($('#TechnicalCoefficient').val()) || 0;
                var professionalCoeff = parseFloat($('#ProfessionalCoefficient').val()) || 0;
                var isHashtagged = $('#IsHashtagged').is(':checked');

                if (technicalCoeff <= 0 && professionalCoeff <= 0) {
                    $('#price-calculation-info').hide();
                    return;
                }

                // دریافت K-Factors از سرور
                var currentYear = 1404;
                var technicalPromise = $.ajax({
                    url: '@Url.Action("GetFactorsByType", "FactorSetting")',
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        factorType: 1, // Technical
                        financialYear: currentYear
                    }
                });

                var professionalPromise = $.ajax({
                    url: '@Url.Action("GetFactorsByType", "FactorSetting")',
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        factorType: 2, // Professional
                        financialYear: currentYear
                    }
                });

                $.when(technicalPromise, professionalPromise).done(function(technicalResponse, professionalResponse) {
                    // $.when() پاسخ‌ها را به صورت [data, statusText, jqXHR] برمی‌گرداند
                    var technicalFactors = Array.isArray(technicalResponse[0]) ? technicalResponse[0] : [];
                    var professionalFactors = Array.isArray(professionalResponse[0]) ? professionalResponse[0] : [];

                    // بررسی اینکه آیا پاسخ آرایه است
                    if (!Array.isArray(technicalFactors)) {
                        console.error('❌ Technical Factors is not an array:', technicalFactors);
                        $('#price-calculation-text').html(
                            '<div class="alert alert-danger">خطا در دریافت K-Factors فنی از سرور</div>'
                        );
                        $('#price-calculation-info').show();
                        return;
                    }

                    if (!Array.isArray(professionalFactors)) {
                        console.error('❌ Professional Factors is not an array:', professionalFactors);
                        $('#price-calculation-text').html(
                            '<div class="alert alert-danger">خطا در دریافت K-Factors حرفه‌ای از سرور</div>'
                        );
                        $('#price-calculation-info').show();
                        return;
                    }

                    // پیدا کردن K-Factor مناسب
                    var technicalK = findAppropriateKai(technicalFactors, isHashtagged);
                    var professionalK = findAppropriateKai(professionalFactors, isHashtagged);

                    if (technicalK && professionalK) {
                        var technicalAmount = technicalCoeff * technicalK.value;
                        var professionalAmount = professionalCoeff * professionalK.value;
                        var calculatedPrice = technicalAmount + professionalAmount;

                        // نمایش محاسبه
                        var hashtagText = isHashtagged ? '<span class="badge bg-warning text-dark">هشتگ‌دار</span>' : '<span class="badge bg-info">عادی</span>';
                        var calculationHtml = '<div class="alert alert-success">';
                        calculationHtml += '<h6><i class="fas fa-calculator"></i> محاسبه قیمت ' + hashtagText + '</h6>';
                        calculationHtml += '<small class="text-muted">نوع خدمت: ' + (isHashtagged ? 'هشتگ‌دار (استفاده از K-Factors هشتگ‌دار)' : 'عادی (استفاده از K-Factors عادی)') + '</small><hr>';
                        
                        if (technicalCoeff > 0) {
                            calculationHtml += '<p>جزء فنی: <strong>' + technicalCoeff + '</strong> × <strong>' + 
                                technicalK.value.toLocaleString('fa-IR') + '</strong> ریال = <strong>' + 
                                technicalAmount.toLocaleString('fa-IR') + '</strong> ریال</p>';
                            calculationHtml += '<small class="text-muted">(K-Factor فنی ' + (isHashtagged ? 'هشتگ‌دار' : 'عادی') + ': ' + technicalK.value.toLocaleString('fa-IR') + ' ریال)</small>';
                        }
                        
                        if (professionalCoeff > 0) {
                            calculationHtml += '<p>جزء حرفه‌ای: <strong>' + professionalCoeff + '</strong> × <strong>' + 
                                professionalK.value.toLocaleString('fa-IR') + '</strong> ریال = <strong>' + 
                                professionalAmount.toLocaleString('fa-IR') + '</strong> ریال</p>';
                            calculationHtml += '<small class="text-muted">(K-Factor حرفه‌ای ' + (isHashtagged ? 'هشتگ‌دار' : 'عادی') + ': ' + professionalK.value.toLocaleString('fa-IR') + ' ریال)</small>';
                        }
                        
                        calculationHtml += '<hr><p class="mb-0"><strong>قیمت کل: ' + 
                            calculatedPrice.toLocaleString('fa-IR') + ' ریال</strong></p>';
                        calculationHtml += '</div>';

                        $('#price-calculation-text').html(calculationHtml);
                        $('#price-calculation-info').show();

                        // به‌روزرسانی فیلد قیمت
                        $('#Price').val(Math.round(calculatedPrice));
                    } else {
                        $('#price-calculation-text').html(
                            '<div class="alert alert-warning">' +
                            '<i class="fas fa-exclamation-triangle"></i> ' +
                            'K-Factors مورد نیاز یافت نشد. لطفاً ابتدا K-Factors را در بخش FactorSettings تعریف کنید.' +
                            '</div>'
                        );
                        $('#price-calculation-info').show();
                    }
                }).fail(function(xhr, status, error) {
                    console.error('❌ Error fetching K-Factors:', { xhr: xhr, status: status, error: error });
                    $('#price-calculation-text').html(
                        '<div class="alert alert-danger">' +
                        '<i class="fas fa-exclamation-triangle"></i> ' +
                        'خطا در دریافت K-Factors از سرور. لطفاً دوباره تلاش کنید.' +
                        '</div>'
                    );
                    $('#price-calculation-info').show();
                });
            }

            // رویدادهای محاسبه قیمت
            $('#IsHashtagged, #PriceCalculationType').on('change', function() {
                var calculationType = $('#PriceCalculationType').val();
                if (calculationType === '2') { // ComponentBased
                    // اگر ضرایب وارد شده باشند، محاسبه کن
                    var technicalCoeff = parseFloat($('#TechnicalCoefficient').val()) || 0;
                    var professionalCoeff = parseFloat($('#ProfessionalCoefficient').val()) || 0;
                    if (technicalCoeff > 0 || professionalCoeff > 0) {
                        calculatePriceFromCoefficients();
                    } else {
                        calculatePriceFromComponents();
                    }
                } else {
                    calculatePriceFromComponents();
                }
            });

            // محاسبه خودکار هنگام تغییر ضرایب
            $('#TechnicalCoefficient, #ProfessionalCoefficient').on('input change', function() {
                var calculationType = $('#PriceCalculationType').val();
                if (calculationType === '2') { // ComponentBased
                    calculatePriceFromCoefficients();
                }
            });

            // حذف محدودیت‌های اضافی برای ورود مستقیم
            $('#Price').on('keypress', function(e) {
                // اجازه ورود اعداد، نقطه و کلیدهای کنترل
                if (e.which != 8 && e.which != 0 && (e.which < 48 || e.which > 57)) {
                    e.preventDefault();
                }
            });

            // 🔒 اعتبارسنجی پیشرفته کد خدمات - Medical Environment
            $('#ServiceCode').on('blur', function() {
                var serviceCode = $(this).val();
                var $field = $(this);
                
                // حذف خطاهای قبلی
                $field.removeClass('is-invalid').addClass('is-valid');
                $field.siblings('.text-danger').remove();
                
                if (!serviceCode) {
                    showFieldError($field, 'کد خدمت الزامی است');
                    return;
                }
                
                // اعتبارسنجی الگو - Medical Environment (فقط اعداد)
                if (!/^\d+$/.test(serviceCode)) {
                    showFieldError($field, 'کد خدمت باید فقط شامل اعداد باشد');
                    return;
                }
                
                // اعتبارسنجی طول - Medical Environment
                if (serviceCode.length < 3 || serviceCode.length > 10) {
                    showFieldError($field, 'کد خدمت باید بین 3 تا 10 رقم باشد');
                    return;
                }
                
                // بررسی تکراری بودن
                $.ajax({
                    url: '@Url.Action("CheckServiceCode", "Service")',
                    type: 'POST',
                    dataType: 'json',
                    contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                    data: { 
                        serviceCode: serviceCode,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        console.log('🏥 MEDICAL: CheckServiceCode response:', response);
                        if (!response.isAvailable) {
                            showFieldError($field, response.message || 'این کد خدمت قبلاً استفاده شده است');
                        } else {
                            $field.removeClass('is-invalid').addClass('is-valid');
                            $field.siblings('.text-danger').remove();
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('🏥 MEDICAL: CheckServiceCode error:', {xhr, status, error});
                        showFieldError($field, 'خطا در بررسی کد خدمت');
                    }
                });
            });

            // 🔒 اعتبارسنجی پیشرفته قیمت - Medical Environment
            $('#Price').on('blur', function() {
                var price = $(this).val();
                var $field = $(this);
                
                // حذف خطاهای قبلی
                $field.removeClass('is-invalid').addClass('is-valid');
                $field.siblings('.text-danger').remove();
                
                if (!price || price <= 0) {
                    showFieldError($field, 'قیمت خدمت باید بزرگتر از صفر باشد');
                    return;
                }
                
                var numericPrice = parseInt(price);
                
                // اعتبارسنجی محدوده
                if (numericPrice > 9999999999) {
                    showFieldError($field, 'قیمت خدمت نمی‌تواند بیشتر از 9,999,999,999 ریال باشد');
                    return;
                }
                
                // ✅ حذف اعتبارسنجی مضرب 10000 - قیمت‌ها به ریال هستند و می‌توانند هر مقدار صحیحی داشته باشند
                // قیمت‌های محاسبه شده ممکن است مضرب 10000 نباشند (مثلاً 2,376,000 ریال)
                
                $field.removeClass('is-invalid').addClass('is-valid');
            });

            // 🔒 اعتبارسنجی پیشرفته عنوان - Medical Environment
            $('#Title').on('blur', function() {
                var title = $(this).val();
                var $field = $(this);
                
                // حذف خطاهای قبلی
                $field.removeClass('is-invalid').addClass('is-valid');
                $field.siblings('.text-danger').remove();
                
                if (!title || title.trim().length === 0) {
                    showFieldError($field, 'عنوان خدمت الزامی است');
                    return;
                }
                
                if (title.trim().length < 3) {
                    showFieldError($field, 'عنوان خدمت باید حداقل 3 کاراکتر باشد');
                    return;
                }
                
                if (title.length > 250) {
                    showFieldError($field, 'عنوان خدمت نمی‌تواند بیشتر از 250 کاراکتر باشد');
                    return;
                }
                
                $field.removeClass('is-invalid').addClass('is-valid');
            });

            // 🔒 اعتبارسنجی پیشرفته دسته‌بندی - Medical Environment
            $('#ServiceCategoryId').on('change', function() {
                var categoryId = $(this).val();
                var $field = $(this);
                
                // حذف خطاهای قبلی
                $field.removeClass('is-invalid').addClass('is-valid');
                $field.siblings('.text-danger').remove();
                
                if (!categoryId || categoryId === '') {
                    showFieldError($field, 'انتخاب دسته‌بندی الزامی است');
                    return;
                }
                
                $field.removeClass('is-invalid').addClass('is-valid');
            });

            // 🔒 اعتبارسنجی پیشرفته توضیحات - Medical Environment
            $('#Description').on('blur', function() {
                var description = $(this).val();
                var $field = $(this);
                
                // حذف خطاهای قبلی
                $field.removeClass('is-invalid').addClass('is-valid');
                $field.siblings('.text-danger').remove();
                
                if (description && description.length > 1000) {
                    showFieldError($field, 'توضیحات خدمت نمی‌تواند بیشتر از 1000 کاراکتر باشد');
                    return;
                }
                
                if (description && description.trim().length > 0) {
                    $field.removeClass('is-invalid').addClass('is-valid');
                }
            });

            // 🔒 تابع نمایش خطا - Medical Environment
            function showFieldError($field, message) {
                $field.removeClass('is-valid').addClass('is-invalid');
                var errorDiv = $('<div class="text-danger small mt-1">' + message + '</div>');
                $field.after(errorDiv);
                
                // Log برای debugging
                console.log('🏥 MEDICAL: خطای اعتبارسنجی - ' + $field.attr('id') + ': ' + message);
            }

            // 🔒 اعتبارسنجی کامل فرم قبل از ارسال - Medical Environment
            $('form').on('submit', function(e) {
                var isValid = true;
                var $form = $(this);
                
                console.log('🏥 MEDICAL: شروع اعتبارسنجی کامل فرم');
                
                // بررسی تمام فیلدهای اجباری
                $form.find('[required]').each(function() {
                    var $field = $(this);
                    var value = $field.val();
                    
                    if (!value || value.trim() === '') {
                        showFieldError($field, 'این فیلد الزامی است');
                        isValid = false;
                    }
                });
                
                // بررسی قیمت
                var price = $('#Price').val();
                if (price && parseInt(price) <= 0) {
                    showFieldError($('#Price'), 'قیمت خدمت باید بزرگتر از صفر باشد');
                    isValid = false;
                }
                // ✅ حذف اعتبارسنجی مضرب 10000 - قیمت‌ها به ریال هستند و می‌توانند هر مقدار صحیحی داشته باشند
                
                // بررسی کد خدمت - Medical Environment (فقط اعداد)
                var serviceCode = $('#ServiceCode').val();
                if (serviceCode && !/^\d+$/.test(serviceCode)) {
                    showFieldError($('#ServiceCode'), 'کد خدمت باید فقط شامل اعداد باشد');
                    isValid = false;
                }
                
                if (!isValid) {
                    e.preventDefault();
                    console.warn('🏥 MEDICAL: فرم دارای خطاهای اعتبارسنجی است');
                    
                    // نمایش پیام کلی
                    if (!$('.alert-danger').length) {
                        var alertDiv = $('<div class="alert alert-danger mt-3">' +
                            '<i class="fas fa-exclamation-triangle me-2"></i>' +
                            'لطفاً خطاهای اعتبارسنجی را برطرف کنید' +
                            '</div>');
                        $form.prepend(alertDiv);
                    }
                    
                    // اسکرول به اولین خطا
                    $('html, body').animate({
                        scrollTop: $form.find('.is-invalid').first().offset().top - 100
                    }, 500);
                    
                    return false;
                }
                
                console.log('🏥 MEDICAL: اعتبارسنجی فرم موفق');
                return true;
            });
        });
    </script>
}