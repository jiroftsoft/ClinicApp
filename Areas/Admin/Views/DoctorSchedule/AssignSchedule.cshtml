@model ClinicApp.ViewModels.DoctorManagementVM.DoctorScheduleViewModel
@using ClinicApp.Helpers
@{
    ViewBag.Title = "تنظیم برنامه کاری پزشک";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link href="~/Content/js/plugins/SweetAlert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/Content/js/plugins/select2/css/select2.min.css" rel="stylesheet" />
    <!-- ✅ فونت‌های رسمی درمانی - استفاده از فونت‌های محلی -->
    <link href="~/Content/css/local-fonts.css" rel="stylesheet" />
    <style>
        /* ✅ فونت‌های رسمی درمانی - استفاده از فونت‌های محلی */
        * {
            font-family: 'Vazirmatn', 'Vazir', 'Shabnam', 'Tahoma', 'Arial', sans-serif !important;
        }

        body {
            font-size: 15px;
            line-height: 1.7;
            color: var(--medical-text);
            font-weight: 400;
        }

        h1, h2, h3, h4, h5, h6 {
            font-weight: 700;
            color: var(--medical-primary);
            line-height: 1.4;
        }

        h1 { font-size: 2rem; }
        h2 { font-size: 1.75rem; }
        h3 { font-size: 1.5rem; }
        h4 { font-size: 1.25rem; }
        h5 { font-size: 1.1rem; }
        h6 { font-size: 1rem; }

        /* ✅ رنگ‌های رسمی درمانی - یکسان‌سازی با استانداردهای پروژه */
        :root {
            --medical-primary: #2c5aa0;        /* آبی - اطلاعات (رسمی) */
            --medical-primary-light: #3d6bb3;  /* آبی روشن */
            --medical-secondary: #6c757d;      /* خاکستری - ثانویه */
            --medical-success: #28a745;        /* سبز - موفقیت/فعال */
            --medical-warning: #ffc107;        /* زرد - هشدار */
            --medical-danger: #dc3545;         /* قرمز - هشدار/خطا */
            --medical-info: #17a2b8;           /* آبی روشن - اطلاعات */
            --medical-light: #f8f9fa;         /* پس‌زمینه روشن */
            --medical-dark: #343a40;           /* متن تیره */
            --medical-bg: #f8f9fa;             /* پس‌زمینه */
            --medical-text: #495057;           /* متن اصلی */
            --medical-text-muted: #6c757d;     /* متن کم‌رنگ */
            --medical-border: #dee2e6;         /* حاشیه */
        }

        /* ✅ Schedule Form */
        .schedule-form {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(44, 90, 160, 0.1);
            padding: 2rem;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid var(--medical-border);
        }

        .schedule-form:hover {
            box-shadow: 0 8px 24px rgba(44, 90, 160, 0.15);
        }

        /* ✅ Form Section */
        .form-section {
            border-left: 5px solid var(--medical-primary);
            padding: 1.5rem 1.5rem 1.5rem 2rem;
            margin-bottom: 2.5rem;
            background: var(--medical-light);
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .form-section:hover {
            border-left-color: var(--medical-primary-light);
            box-shadow: 0 2px 8px rgba(44, 90, 160, 0.1);
        }

        .form-section h5 {
            color: var(--medical-primary);
            font-weight: 700;
            font-size: 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-section h5 i {
            font-size: 1.1rem;
        }

        /* ✅ Doctor Info Card */
        .doctor-info-card {
            background: linear-gradient(135deg, var(--medical-primary) 0%, var(--medical-primary-light) 100%);
            color: white;
            border-radius: 16px;
            padding: 2rem;
            box-shadow: 0 4px 16px rgba(44, 90, 160, 0.25);
            position: relative;
            overflow: hidden;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .doctor-info-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
            pointer-events: none;
            transition: all 0.5s ease;
        }

        .doctor-info-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(44, 90, 160, 0.35);
        }

        .doctor-info-card:hover::before {
            top: -30%;
            right: -30%;
        }

        .doctor-info-card h4 {
            color: white;
            font-weight: 700;
            margin-bottom: 0.75rem;
        }

        /* ✅ Work Day Card */
        .work-day-card {
            border: 2px solid var(--medical-border);
            border-radius: 12px;
            margin-bottom: 1.25rem;
            padding: 1.5rem;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            background: white;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        }

        .work-day-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(44, 90, 160, 0.1);
        }

        .work-day-card.active {
            border-color: var(--medical-primary);
            background: linear-gradient(135deg, rgba(44, 90, 160, 0.05) 0%, rgba(61, 107, 179, 0.05) 100%);
            box-shadow: 0 4px 12px rgba(44, 90, 160, 0.15);
        }

        .work-day-card.active:hover {
            border-color: var(--medical-primary-light);
            box-shadow: 0 6px 16px rgba(44, 90, 160, 0.2);
        }

        /* ✅ Highlight برای روز امروز */
        .work-day-card.today-highlight {
            border-color: var(--medical-warning);
            background: #fff3cd;
            box-shadow: 0 2px 8px rgba(255, 193, 7, 0.2);
        }

        .work-day-card.today-highlight:hover {
            border-color: #ffb300;
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
        }

        .work-day-card.today-highlight.active {
            border-color: var(--medical-success);
            background: #d4edda;
        }

        .work-day-card.today-highlight.active:hover {
            border-color: #28a745;
            box-shadow: 0 6px 16px rgba(40, 167, 69, 0.25);
        }

        /* ✅ Time Range Item */
        .time-range-item {
            background: var(--medical-light);
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 0.75rem;
            border: 1px solid var(--medical-border);
            transition: all 0.3s ease;
        }

        .time-range-item:hover {
            background: white;
            box-shadow: 0 2px 6px rgba(44, 90, 160, 0.1);
            border-color: var(--medical-primary);
        }

        /* ✅ Buttons */
        .btn-submit {
            border-radius: 10px;
            font-weight: 600;
            padding: 0.875rem 2.25rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            letter-spacing: 0.3px;
            min-width: 150px;
        }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(44, 90, 160, 0.3);
        }

        .btn-submit:active {
            transform: translateY(-1px);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--medical-primary) 0%, var(--medical-primary-light) 100%);
            border: none;
            box-shadow: 0 4px 12px rgba(44, 90, 160, 0.3);
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, var(--medical-primary-light) 0%, var(--medical-primary) 100%);
        }

        .btn-outline-secondary {
            border: 2px solid var(--medical-secondary);
            color: var(--medical-secondary);
            font-weight: 600;
        }

        .btn-outline-secondary:hover {
            background: var(--medical-secondary);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(108, 117, 125, 0.3);
        }

        .btn-outline-primary {
            border: 2px solid var(--medical-primary);
            color: var(--medical-primary);
            font-weight: 600;
        }

        .btn-outline-primary:hover {
            background: var(--medical-primary);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(44, 90, 160, 0.3);
        }

        .btn-outline-danger {
            border: 2px solid var(--medical-danger);
            color: var(--medical-danger);
            font-weight: 600;
        }

        .btn-outline-danger:hover {
            background: var(--medical-danger);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.3);
        }

        /* ✅ Form Controls */
        .form-control, .form-select {
            border-radius: 10px;
            border: 2px solid var(--medical-border);
            transition: all 0.3s ease;
            font-size: 15px;
            padding: 0.75rem 1rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--medical-primary);
            box-shadow: 0 0 0 0.2rem rgba(44, 90, 160, 0.25);
            outline: none;
        }

        .form-label {
            font-weight: 600;
            color: var(--medical-text);
            margin-bottom: 0.5rem;
        }

        /* ✅ Validation Summary */
        .validation-summary {
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, rgba(220, 53, 69, 0.1) 0%, rgba(220, 53, 69, 0.05) 100%);
            border-left: 5px solid var(--medical-danger);
            padding: 1.25rem;
            margin-bottom: 2rem;
        }

        /* ✅ Loading Overlay */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.95);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            backdrop-filter: blur(4px);
        }

        .loading-overlay.active {
            display: flex;
        }

        .loading-spinner {
            border: 4px solid var(--medical-border);
            border-top: 4px solid var(--medical-primary);
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* ✅ Responsive Design */
        @@media (max-width: 768px) {
            body {
                font-size: 14px;
            }

            .schedule-form {
                padding: 1.5rem;
                border-radius: 12px;
            }

            .form-section {
                padding: 1.25rem 1.25rem 1.25rem 1.75rem;
                margin-bottom: 2rem;
            }

            .doctor-info-card {
                padding: 1.5rem;
            }

            .work-day-card {
                padding: 1.25rem;
            }

            .btn-submit {
                padding: 0.75rem 1.5rem;
                min-width: 120px;
                font-size: 14px;
            }
        }

        @@media (max-width: 576px) {
            .schedule-form {
                padding: 1rem;
            }

            .form-section {
                padding: 1rem 1rem 1rem 1.5rem;
            }

            .doctor-info-card {
                padding: 1.25rem;
            }

            .work-day-card {
                padding: 1rem;
            }

            .btn-submit {
                width: 100%;
                margin-bottom: 0.5rem;
            }
        }

        /* ✅ Time Display Persian */
        .time-display-persian {
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--medical-primary);
            display: inline-block;
            margin-top: 0.25rem;
            margin-right: 0.5rem;
        }

        .time-input-wrapper {
            position: relative;
        }

        /* ✅ Accessibility */
        .btn:focus,
        .form-control:focus,
        .form-select:focus {
            outline: 2px solid var(--medical-primary);
            outline-offset: 2px;
        }
    </style>
}

<!-- ✅ Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="loading-spinner"></div>
</div>

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="mb-0">
                        <i class="fas fa-calendar-alt me-2"></i>
                        تنظیم برنامه کاری پزشک
                    </h2>
                    <p class="text-muted mb-0 mt-2">تنظیم برنامه کاری هفتگی و زمان‌های کاری پزشک</p>
                </div>
                <div>
                    <a href="@Url.Action("Index", "DoctorSchedule", new { area = "Admin" })" class="btn btn-outline-secondary btn-submit">
                        <i class="fas fa-arrow-right me-2"></i>
                        بازگشت به لیست
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Doctor Information Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="doctor-info-card">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h4 class="mb-2">
                            <i class="fas fa-user-md me-2"></i>
                            @ViewBag.Doctor.FirstName @ViewBag.Doctor.LastName
                        </h4>
                        <p class="mb-0">
                            <i class="fas fa-id-card me-2"></i>
                            کد ملی: @ViewBag.Doctor.NationalCode
                        </p>
                    </div>
                    <div class="col-md-4 text-end">
                        <div class="badge bg-light text-dark fs-6">
                            <i class="fas fa-user-md me-1"></i>
                            پزشک
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Schedule Form -->
    <div class="row">
        <div class="col-12">
            <div class="schedule-form p-4">
                @using (Html.BeginForm("AssignSchedule", "DoctorSchedule", FormMethod.Post, 
                       new { id = "scheduleForm", @class = "needs-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.DoctorId)

                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger validation-summary" })

                    <!-- Appointment Duration -->
                    <div class="form-section">
                        <h5>
                            <i class="fas fa-clock me-2"></i>
                            تنظیمات نوبت‌دهی
                        </h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    @Html.LabelFor(m => m.AppointmentDuration, "مدت زمان هر نوبت (دقیقه)", new { @class = "form-label fw-bold" })
                                    @Html.DropDownListFor(m => m.AppointmentDuration, 
                                        new SelectList(new[] { 10, 15, 20, 30, 45, 60, 90, 120 }, Model.AppointmentDuration), 
                                        new { @class = "form-select" })
                                    @Html.ValidationMessageFor(m => m.AppointmentDuration, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">زمان پیش‌فرض روز کاری</label>
                                    <div class="row">
                                        <div class="col-6">
                                            <label class="form-label">شروع</label>
                                            @{
                                                var defaultStartTimeValue = Model.DefaultStartTime.HasValue 
                                                    ? $"{Model.DefaultStartTime.Value.Hours:D2}:{Model.DefaultStartTime.Value.Minutes:D2}" 
                                                    : "07:00";
                                            }
                                            @Html.TextBoxFor(m => m.DefaultStartTime, 
                                                new { 
                                                    @class = "form-control time-input", 
                                                    type = "time",
                                                    id = "defaultStartTime",
                                                    @Value = defaultStartTimeValue
                                                })
                                            @Html.ValidationMessageFor(m => m.DefaultStartTime, "", new { @class = "text-danger" })
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label">پایان</label>
                                            @{
                                                var defaultEndTimeValue = Model.DefaultEndTime.HasValue 
                                                    ? $"{Model.DefaultEndTime.Value.Hours:D2}:{Model.DefaultEndTime.Value.Minutes:D2}" 
                                                    : "17:00";
                                            }
                                            @Html.TextBoxFor(m => m.DefaultEndTime, 
                                                new { 
                                                    @class = "form-control time-input", 
                                                    type = "time",
                                                    id = "defaultEndTime",
                                                    @Value = defaultEndTimeValue
                                                })
                                            @Html.ValidationMessageFor(m => m.DefaultEndTime, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 mt-3">
                                <div class="mb-3">
                                    @Html.LabelFor(m => m.ConsultationFee, "مبلغ حق ویزیت (ریال)", new { @class = "form-label fw-bold" })
                                    @Html.TextBoxFor(m => m.ConsultationFee,
                                        new {
                                            @class = "form-control",
                                            type = "number",
                                            min = "0",
                                            max = "10000000",
                                            step = "1000",
                                            placeholder = "مثال: 500000",
                                            id = "consultationFeeInput"
                                        })
                                    @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        مبلغ حق ویزیت برای نوبت‌های این برنامه به ریال. در نوبت‌دهی و محاسبه قیمت استفاده می‌شود.
                                    </small>
                                    <div id="consultationFeeGuide" class="alert alert-light border mt-2 mb-0 consultation-fee-guide" style="border-right: 4px solid var(--medical-primary); background-color: #f8f9fa;">
                                        <strong class="text-primary"><i class="fas fa-calculator me-2"></i>راهنما برای منشی:</strong>
                                        <span id="consultationFeeGuideText">
                                            @if (Model.ConsultationFee > 0)
                                            {
                                                <text>معادل <strong>@MoneyDisplayHelper.FormatTomanDisplay(Model.ConsultationFee)</strong> — مبلغ به حروف: <strong>@MoneyDisplayHelper.AmountToWordsToman(Model.ConsultationFee)</strong></text>
                                            }
                                            else
                                            {
                                                <span class="text-muted">مبلغ را وارد کنید تا معادل تومان و مبلغ به حروف نمایش داده شود.</span>
                                            }
                                        </span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    @Html.LabelFor(m => m.OnlineConsultationFee, "مبلغ مشاوره آنلاین (ریال)", new { @class = "form-label fw-bold" })
                                    @Html.TextBoxFor(m => m.OnlineConsultationFee,
                                        new {
                                            @class = "form-control",
                                            type = "number",
                                            min = "0",
                                            max = "10000000",
                                            step = "1000",
                                            placeholder = "خالی = همان مبلغ ویزیت حضوری",
                                            id = "onlineConsultationFeeInput"
                                        })
                                    @Html.ValidationMessageFor(m => m.OnlineConsultationFee, "", new { @class = "text-danger" })
                                    <small class="form-text text-muted">
                                        اگر این پزشک امکان «مشاوره آنلاین تصویری» دارد و مبلغ آن با ویزیت حضوری متفاوت است، اینجا وارد کنید. خالی یا صفر = استفاده از همان مبلغ حق ویزیت بالا.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Work Days -->
                    <div class="form-section">
                        <!-- ✅ راهنمایی کامل برای منشی -->
                        <div class="alert alert-info border-info mb-4" style="border-right: 5px solid #17a2b8; background-color: #d1ecf1;">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-info-circle fa-2x text-info me-3 mt-1"></i>
                                <div class="flex-grow-1">
                                    <h6 class="alert-heading fw-bold mb-2" style="color: #0c5460;">
                                        <i class="fas fa-lightbulb me-2"></i>
                                        راهنمای تنظیم برنامه کاری
                                    </h6>
                                    <div style="color: #0c5460; line-height: 1.8;">
                                        <p class="mb-2">
                                            <strong>📅 امروز:</strong> 
                                            <span class="badge bg-info text-white fs-6 me-2">@ViewBag.TodayDayOfWeekName</span>
                                            <span class="badge bg-primary text-white fs-6">@ViewBag.TodayPersianDate</span>
                                        </p>
                                        <hr class="my-2" style="border-color: #17a2b8;">
                                        <p class="mb-2 fw-bold">📋 دو روش تنظیم برنامه:</p>
                                        <ol class="mb-2 ps-3" style="list-style-type: decimal;">
                                            <li class="mb-2">
                                                <strong>برنامه هفتگی:</strong> برای تنظیم برنامه <strong>فقط برای هفته جاری</strong> (7 روز آینده)
                                                <br>
                                                <small class="text-muted">مثال: اگر "شنبه" را فعال کنید، پزشک فقط در <strong>شنبه این هفته</strong> (1404/10/13) نوبت خواهد داشت. برای شنبه‌های هفته‌های آینده از بخش "تاریخ‌های خاص" استفاده کنید.</small>
                                            </li>
                                            <li class="mb-2">
                                                <strong>تاریخ خاص:</strong> برای تنظیم برنامه برای <strong>هفته‌های آینده</strong> یا <strong>تاریخ‌های خاص</strong>
                                                <br>
                                                <small class="text-muted">مثال: اگر می‌خواهید برای چهارشنبه هفته آینده (1404/10/24) یا هر تاریخ دیگری در آینده برنامه تنظیم کنید، از این بخش استفاده کنید.</small>
                                            </li>
                                        </ol>
                                        <p class="mb-0 fw-bold text-success">
                                            ✅ <strong>نکته:</strong> کنار هر روز هفته، تاریخ آن روز در هفته جاری نمایش داده شده است تا اشتباه نکنید.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">
                                <i class="fas fa-calendar-week me-2"></i>
                                روزهای کاری هفتگی
                            </h5>
                            <div class="alert alert-info mb-0 py-2 px-3" style="font-size: 0.9rem;">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>راهنما:</strong> برای هر روز کاری که فعال می‌کنید، به صورت خودکار یک بازه زمانی با زمان‌های پیش‌فرض ایجاد می‌شود. می‌توانید با دکمه ➕ بازه‌های بیشتری اضافه کنید.
                            </div>
                        </div>
                        <div class="row">
                            @for (int i = 0; i < Model.WorkDays.Count; i++)
                            {
                                var workDay = Model.WorkDays[i];
                                // ✅ محاسبه اینکه آیا این روز امروز است یا نه
                                var isToday = ViewBag.Today != null && (int)((DateTime)ViewBag.Today).DayOfWeek == workDay.DayOfWeek;
                                // ✅ دریافت تاریخ این روز در هفته جاری
                                var weekDates = ViewBag.WeekDates as Dictionary<int, string>;
                                var dayDate = weekDates != null && weekDates.ContainsKey(workDay.DayOfWeek) 
                                    ? weekDates[workDay.DayOfWeek] 
                                    : "";
                                <div class="col-md-6 mb-3">
                                    <div class="work-day-card p-3 @(workDay.IsActive ? "active" : "") @(isToday ? "today-highlight" : "")" id="workDay-@i">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(m => m.WorkDays[i].IsActive, new { @class = "form-check-input work-day-toggle", data_day = i })
                                                <label class="form-check-label fw-bold" for="@Html.IdFor(m => m.WorkDays[i].IsActive)">
                                                    @workDay.DayName
                                                    @if (!string.IsNullOrEmpty(dayDate))
                                                    {
                                                        <span class="badge bg-secondary ms-2" style="font-size: 0.75rem; font-weight: normal;">
                                                            @dayDate
                                                        </span>
                                                    }
                                                    @if (isToday)
                                                    {
                                                        <span class="badge bg-success ms-2" style="font-size: 0.7rem;">
                                                            <i class="fas fa-calendar-check me-1"></i>
                                                            امروز
                                                        </span>
                                                    }
                                                </label>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-primary add-time-range" data-day="@i">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </div>
                                        
                                        @Html.HiddenFor(m => m.WorkDays[i].DayOfWeek)
                                        @Html.HiddenFor(m => m.WorkDays[i].DayName)
                                        
                                        <div class="time-ranges" id="timeRanges-@i">
                                            @for (int j = 0; j < workDay.TimeRanges.Count; j++)
                                            {
                                                var startTimeValue = $"{workDay.TimeRanges[j].StartTime.Hours:D2}:{workDay.TimeRanges[j].StartTime.Minutes:D2}";
                                                var endTimeValue = $"{workDay.TimeRanges[j].EndTime.Hours:D2}:{workDay.TimeRanges[j].EndTime.Minutes:D2}";
                                                
                                                <div class="time-range-item">
                                                    @* ✅ Hidden field برای TimeRangeId - برای شناسایی TimeRange های در حال ویرایش *@
                                                    @Html.HiddenFor(m => m.WorkDays[i].TimeRanges[j].Id)
                                                    
                                                    <div class="row">
                                                        <div class="col-5">
                                                            <label class="form-label">شروع</label>
                                                            @Html.TextBoxFor(m => m.WorkDays[i].TimeRanges[j].StartTime, 
                                                                new { 
                                                                    @class = "form-control time-input", 
                                                                    type = "time",
                                                                    @Value = startTimeValue
                                                                })
                                                        </div>
                                                        <div class="col-5">
                                                            <label class="form-label">پایان</label>
                                                            @Html.TextBoxFor(m => m.WorkDays[i].TimeRanges[j].EndTime, 
                                                                new { 
                                                                    @class = "form-control time-input", 
                                                                    type = "time",
                                                                    @Value = endTimeValue
                                                                })
                                                        </div>
                                                        <div class="col-2">
                                                            <label class="form-label">&nbsp;</label>
                                                            <button type="button" class="btn btn-sm btn-outline-danger remove-time-range">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Specific Dates Section -->
                    <div class="form-section">
                        <div class="alert alert-success border-success mb-4" style="border-right: 5px solid #28a745; background-color: #d4edda;">
                            <div class="d-flex align-items-start">
                                <i class="fas fa-calendar-day fa-2x text-success me-3 mt-1"></i>
                                <div class="flex-grow-1">
                                    <h6 class="alert-heading fw-bold mb-2" style="color: #155724;">
                                        <i class="fas fa-calendar-alt me-2"></i>
                                        تنظیم برنامه برای تاریخ‌های خاص
                                    </h6>
                                    <div style="color: #155724; line-height: 1.8;">
                                        <p class="mb-2">
                                            <strong>📅 استفاده از این بخش:</strong> برای تنظیم برنامه برای <strong>هفته‌های آینده</strong> یا <strong>تاریخ‌های خاص</strong> (مثلاً چهارشنبه 1404/10/24) از این بخش استفاده کنید.
                                        </p>
                                        <p class="mb-2">
                                            <strong>💡 مثال:</strong> اگر می‌خواهید برای <strong>چهارشنبه هفته آینده (1404/10/24)</strong> یا هر تاریخ دیگری در آینده برنامه تنظیم کنید، تاریخ را در این بخش انتخاب کنید.
                                        </p>
                                        <p class="mb-0 text-muted" style="font-size: 0.9rem;">
                                            <i class="fas fa-info-circle me-1"></i>
                                            <strong>نکته:</strong> این برنامه فقط برای همان تاریخ خاص اعمال می‌شود و برای هفته‌های آینده تکرار نمی‌شود.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">
                                <i class="fas fa-calendar-day me-2"></i>
                                تاریخ‌های خاص
                            </h5>
                            <button type="button" class="btn btn-sm btn-success add-specific-date" id="addSpecificDateBtn">
                                <i class="fas fa-plus me-1"></i>
                                افزودن تاریخ
                            </button>
                        </div>

                        <div id="specificDatesContainer">
                            <!-- ✅ تاریخ‌های خاص به صورت داینامیک اضافه می‌شوند -->
                            <div class="alert alert-light border mb-3" id="noSpecificDatesMessage">
                                <i class="fas fa-info-circle me-2"></i>
                                هنوز تاریخی اضافه نشده است. برای افزودن تاریخ خاص، روی دکمه "افزودن تاریخ" کلیک کنید.
                            </div>
                        </div>
                    </div>

                    <!-- Submit Buttons -->
                    <div class="form-section">
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between">
                                    <a href="@Url.Action("Index", "DoctorSchedule", new { area = "Admin" })" class="btn btn-outline-secondary btn-submit">
                                        <i class="fas fa-times me-2"></i>
                                        انصراف
                                    </a>
                                    <button type="submit" class="btn btn-primary btn-submit">
                                        <i class="fas fa-save me-2"></i>
                                        ذخیره برنامه کاری
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/plugins/SweetAlert2/sweetalert2@11.js"></script>
    @* ✅ Enterprise: لود کردن JalaliDatePicker Enterprise Component *@
    @Html.Partial("~/Areas/Admin/Views/Shared/_PersianDatePickerScript.cshtml")
    <script>
        // ✅ Helper Functions برای تبدیل ساعت به فارسی
        function formatTimeToPersian(timeString) {
            if (!timeString) return '';
            
            var parts = timeString.split(':');
            if (parts.length < 2) return timeString;
            
            var hour = parseInt(parts[0]);
            var minute = parseInt(parts[1]);
            
            if (isNaN(hour) || isNaN(minute)) return timeString;
            
            var period = '';
            var displayHour = hour;
            
            if (hour === 0) {
                displayHour = 12;
                period = 'قبل از ظهر';
            } else if (hour < 12) {
                displayHour = hour;
                period = 'قبل از ظهر';
            } else if (hour === 12) {
                displayHour = 12;
                period = 'بعد از ظهر';
            } else {
                displayHour = hour - 12;
                period = 'بعد از ظهر';
            }
            
            return displayHour + ':' + (minute < 10 ? '0' + minute : minute) + ' ' + period;
        }

        function updateTimeDisplay(input) {
            var $input = $(input);
            var timeValue = $input.val();
            var $display = $input.siblings('.time-display-persian');
            
            if (timeValue) {
                var persianTime = formatTimeToPersian(timeValue);
                if ($display.length === 0) {
                    $display = $('<span class="time-display-persian text-primary fw-bold ms-2"></span>');
                    $input.after($display);
                }
                $display.text(persianTime);
            } else {
                $display.remove();
            }
        }

        $(document).ready(function () {
            // ✅ Initialize time displays for existing inputs
            $('.time-input').each(function() {
                updateTimeDisplay(this);
            });

            // ✅ Update time display on change
            $(document).on('change', '.time-input', function() {
                updateTimeDisplay(this);
            });

            // ✅ راهنمای مبلغ حق ویزیت (تومان + مبلغ به حروف) — به‌روزرسانی زنده برای منشی
            function updateConsultationFeeGuide() {
                var rial = parseInt($('#consultationFeeInput').val(), 10) || 0;
                if (rial < 0) rial = 0;
                var $text = $('#consultationFeeGuideText');
                if (rial === 0) {
                    $text.html('<span class="text-muted">مبلغ را وارد کنید تا معادل تومان و مبلغ به حروف نمایش داده شود.</span>');
                    return;
                }
                $.ajax({
                    url: '@Url.Action("GetConsultationFeeDisplay", "DoctorSchedule", new { area = "Admin" })',
                    data: { amountRial: rial },
                    type: 'GET',
                    dataType: 'json',
                    success: function(data) {
                        var ok = data.success === true || data.Success === true;
                        var toman = data.tomanDisplay || data.TomanDisplay || '';
                        var words = data.amountInWords || data.AmountInWords || '';
                        if (ok && toman && words) {
                            $('#consultationFeeGuideText').html('معادل <strong>' + toman + '</strong> — مبلغ به حروف: <strong>' + words + '</strong>');
                        }
                    },
                    error: function() {
                        $('#consultationFeeGuideText').html('<span class="text-muted">مبلغ را وارد کنید تا معادل تومان و مبلغ به حروف نمایش داده شود.</span>');
                    }
                });
            }
            $('#consultationFeeInput').on('blur input', function() {
                var self = this;
                clearTimeout(self._consultationFeeGuideTimer);
                self._consultationFeeGuideTimer = setTimeout(updateConsultationFeeGuide, 350);
            });
            // ✅ بار اول: اگر فیلد از قبل مقدار دارد، راهنما را به‌روز کن
            if ($('#consultationFeeInput').val() && parseInt($('#consultationFeeInput').val(), 10) > 0) {
                updateConsultationFeeGuide();
            }

            // ✅ Toggle work day active state - با ایجاد خودکار TimeRange پیش‌فرض
            $('.work-day-toggle').on('change', function() {
                var dayIndex = $(this).data('day');
                var workDayCard = $('#workDay-' + dayIndex);
                var timeRangesContainer = $('#timeRanges-' + dayIndex);
                
                if ($(this).is(':checked')) {
                    workDayCard.addClass('active');
                    
                    // ✅ اگر TimeRange وجود ندارد، به صورت خودکار یک TimeRange با مقادیر پیش‌فرض ایجاد می‌کنیم
                    if (timeRangesContainer.find('.time-range-item').length === 0) {
                        var defaultStartTime = $('#defaultStartTime').val() || '07:00';
                        var defaultEndTime = $('#defaultEndTime').val() || '17:00';
                        
                        var newTimeRange = `
                            <div class="time-range-item" style="opacity: 0; transform: translateY(-10px);">
                                <input type="hidden" name="WorkDays[${dayIndex}].TimeRanges[0].Id" value="0" />
                                <div class="row">
                                    <div class="col-5">
                                        <label class="form-label">شروع</label>
                                        <input type="time" class="form-control time-input" name="WorkDays[${dayIndex}].TimeRanges[0].StartTime" value="${defaultStartTime}" />
                                    </div>
                                    <div class="col-5">
                                        <label class="form-label">پایان</label>
                                        <input type="time" class="form-control time-input" name="WorkDays[${dayIndex}].TimeRanges[0].EndTime" value="${defaultEndTime}" />
                                    </div>
                                    <div class="col-2">
                                        <label class="form-label">&nbsp;</label>
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-time-range">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        `;
                        
                        var $newItem = $(newTimeRange);
                        timeRangesContainer.append($newItem);
                        
                        // ✅ Animation برای نمایش
                        setTimeout(function() {
                            $newItem.css({
                                'opacity': '1',
                                'transform': 'translateY(0)',
                                'transition': 'all 0.3s ease'
                            });
                            
                            // ✅ Initialize time displays for new inputs
                            $newItem.find('.time-input').each(function() {
                                updateTimeDisplay(this);
                            });
                        }, 10);
                    }
                } else {
                    workDayCard.removeClass('active');
                }
            });

            // ✅ Add time range با Animation - با استفاده از مقادیر پیش‌فرض
            $('.add-time-range').on('click', function() {
                var dayIndex = $(this).data('day');
                var timeRangesContainer = $('#timeRanges-' + dayIndex);
                var timeRangeCount = timeRangesContainer.find('.time-range-item').length;
                
                // ✅ استفاده از مقادیر پیش‌فرض یا آخرین TimeRange
                var defaultStartTime = $('#defaultStartTime').val() || '07:00';
                var defaultEndTime = $('#defaultEndTime').val() || '17:00';
                
                // ✅ اگر TimeRange قبلی وجود دارد، از EndTime آن به عنوان StartTime جدید استفاده می‌کنیم
                var lastTimeRange = timeRangesContainer.find('.time-range-item').last();
                if (lastTimeRange.length > 0) {
                    var lastEndTime = lastTimeRange.find('input[name*="EndTime"]').val();
                    if (lastEndTime) {
                        defaultStartTime = lastEndTime;
                    }
                }
                
                var newTimeRange = `
                    <div class="time-range-item" style="opacity: 0; transform: translateY(-10px);">
                        <input type="hidden" name="WorkDays[${dayIndex}].TimeRanges[${timeRangeCount}].Id" value="0" />
                        <div class="row">
                            <div class="col-5">
                                <label class="form-label">شروع</label>
                                <input type="time" class="form-control time-input" name="WorkDays[${dayIndex}].TimeRanges[${timeRangeCount}].StartTime" value="${defaultStartTime}" />
                            </div>
                            <div class="col-5">
                                <label class="form-label">پایان</label>
                                <input type="time" class="form-control time-input" name="WorkDays[${dayIndex}].TimeRanges[${timeRangeCount}].EndTime" value="${defaultEndTime}" />
                            </div>
                            <div class="col-2">
                                <label class="form-label">&nbsp;</label>
                                <button type="button" class="btn btn-sm btn-outline-danger remove-time-range" title="حذف بازه زمانی">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
                
                var $newItem = $(newTimeRange);
                timeRangesContainer.append($newItem);
                
                // ✅ Animation برای نمایش
                setTimeout(function() {
                    $newItem.css({
                        'opacity': '1',
                        'transform': 'translateY(0)',
                        'transition': 'all 0.3s ease'
                    });
                    
                    // ✅ Initialize time displays for new inputs
                    $newItem.find('.time-input').each(function() {
                        updateTimeDisplay(this);
                    });
                }, 10);
            });

            // ✅ Remove time range با Animation
            $(document).on('click', '.remove-time-range', function() {
                var $item = $(this).closest('.time-range-item');
                $item.css({
                    'opacity': '0',
                    'transform': 'translateX(-20px)',
                    'transition': 'all 0.3s ease'
                });
                
                setTimeout(function() {
                    $item.remove();
                }, 300);
            });

            // ✅ Add specific date functionality
            var specificDateIndex = 0;
            $('#addSpecificDateBtn').on('click', function() {
                var container = $('#specificDatesContainer');
                var noMessage = $('#noSpecificDatesMessage');
                
                if (noMessage.length > 0) {
                    noMessage.remove();
                }
                
                var defaultStartTime = $('#defaultStartTime').val() || '07:00';
                var defaultEndTime = $('#defaultEndTime').val() || '17:00';
                var appointmentDuration = @Model.AppointmentDuration;
                
                var specificDateHtml = `
                    <div class="specific-date-card p-3 mb-3 border rounded" data-index="${specificDateIndex}" style="background: #f8f9fa; border-color: #28a745 !important;">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">
                                <i class="fas fa-calendar-day me-2 text-success"></i>
                                تاریخ خاص #${specificDateIndex + 1}
                            </h6>
                            <button type="button" class="btn btn-sm btn-outline-danger remove-specific-date" data-index="${specificDateIndex}">
                                <i class="fas fa-trash me-1"></i>
                                حذف
                            </button>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">تاریخ <span class="text-danger">*</span></label>
                                <input type="text" class="form-control persian-date-input" 
                                       name="SpecificDates[${specificDateIndex}].PersianDate" 
                                       placeholder="مثال: 1404/10/17" 
                                       required 
                                       data-index="${specificDateIndex}" 
                                       data-jdp
                                       data-jdp-theme="medical"
                                       data-jdp-size="medium"
                                       data-no-default-date="true"
                                       autocomplete="off" />
                                <small class="text-muted d-block mt-1">
                                    <i class="fas fa-info-circle me-1"></i>
                                    تاریخ را به صورت شمسی وارد کنید (مثلاً: 1404/10/17)
                                </small>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">زمان شروع</label>
                                <input type="time" class="form-control time-input" 
                                       name="SpecificDates[${specificDateIndex}].StartTime" 
                                       value="${defaultStartTime}" />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label fw-bold">زمان پایان</label>
                                <input type="time" class="form-control time-input" 
                                       name="SpecificDates[${specificDateIndex}].EndTime" 
                                       value="${defaultEndTime}" />
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label fw-bold">مدت نوبت (دقیقه)</label>
                                <input type="number" class="form-control" 
                                       name="SpecificDates[${specificDateIndex}].AppointmentDuration" 
                                       value="${appointmentDuration}" 
                                       min="5" max="120" />
                            </div>
                        </div>
                    </div>
                `;
                
                var $newItem = $(specificDateHtml);
                container.append($newItem);
                
                // ✅ Enterprise: Initialize JalaliDatePickerEnterprise for the new input
                setTimeout(function() {
                    if (typeof JalaliDatePickerEnterprise !== 'undefined' && typeof jalaliDatepicker !== 'undefined') {
                        $newItem.find('.persian-date-input').each(function() {
                            var input = this;
                            // ✅ استفاده از Enterprise Component
                            JalaliDatePickerEnterprise.init(input, {
                                theme: 'medical',
                                size: 'medium',
                                noDefaultDate: true
                            });
                        });
                    } else {
                        console.warn('⚠️ JalaliDatePickerEnterprise not loaded yet. Retrying...');
                        var retryCount = 0;
                        var maxRetries = 10;
                        var retryInterval = setInterval(function() {
                            retryCount++;
                            if (typeof JalaliDatePickerEnterprise !== 'undefined' && typeof jalaliDatepicker !== 'undefined') {
                                clearInterval(retryInterval);
                                $newItem.find('.persian-date-input').each(function() {
                                    var input = this;
                                    JalaliDatePickerEnterprise.init(input, {
                                        theme: 'medical',
                                        size: 'medium',
                                        noDefaultDate: true
                                    });
                                });
                            } else if (retryCount >= maxRetries) {
                                clearInterval(retryInterval);
                                console.error('❌ JalaliDatePickerEnterprise failed to load after ' + maxRetries + ' retries');
                            }
                        }, 200);
                    }
                }, 100);
                
                // ✅ Initialize time displays
                $newItem.find('.time-input').each(function() {
                    updateTimeDisplay(this);
                });
                
                specificDateIndex++;
            });
            
            // ✅ Remove specific date
            $(document).on('click', '.remove-specific-date', function() {
                var $card = $(this).closest('.specific-date-card');
                $card.fadeOut(300, function() {
                    $card.remove();
                    
                    // ✅ اگر هیچ تاریخی باقی نماند، پیغام را نمایش بده
                    if ($('#specificDatesContainer .specific-date-card').length === 0) {
                        $('#specificDatesContainer').html(`
                            <div class="alert alert-light border mb-3" id="noSpecificDatesMessage">
                                <i class="fas fa-info-circle me-2"></i>
                                هنوز تاریخی اضافه نشده است. برای افزودن تاریخ خاص، روی دکمه "افزودن تاریخ" کلیک کنید.
                            </div>
                        `);
                        specificDateIndex = 0; // Reset index
                    }
                });
            });

            // Form submission
            $('#scheduleForm').on('submit', function (e) {
                e.preventDefault();
                
                if (!$(this)[0].checkValidity()) {
                    e.stopPropagation();
                    $(this).addClass('was-validated');
                    return false;
                }

                // ✅ Show loading overlay
                $('#loadingOverlay').addClass('active');

                // Submit form
                this.submit();
            });

            // Success message
            @if (TempData["Success"] != null)
            {
                var successMessage = TempData["Success"].ToString();
                <text>
                Swal.fire({
                    title: 'موفقیت',
                    text: @Html.Raw(Json.Encode(successMessage)),
                    icon: 'success',
                    confirmButtonText: 'باشه'
                });
                </text>
            }

            // Error message
            @if (TempData["Error"] != null)
            {
                var errorMessage = TempData["Error"].ToString();
                <text>
                Swal.fire({
                    title: 'خطا',
                    text: @Html.Raw(Json.Encode(errorMessage)),
                    icon: 'error',
                    confirmButtonText: 'باشه'
                });
                </text>
            }
        });
    </script>
}
