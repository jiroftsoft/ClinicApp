@* صفحه ویرایش برنامه کاری پزشک - طراحی Ultimate برای محیط درمانی *@
@model ClinicApp.ViewModels.DoctorManagementVM.DoctorScheduleViewModel
@using ClinicApp.Helpers
@{
    ViewBag.Title = "ویرایش برنامه کاری پزشک";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link href="~/Content/js/plugins/SweetAlert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/Content/js/plugins/persian-datepicker/persian-datepicker.min.css" rel="stylesheet" />
    <style>
        /* ✅ پالت رسمی درمانی — طبق 03-Development-Contract-Quick-Guide، بدون گرادینت فانتزی */
        .doctor-header {
            background-color: #2c5aa0;
            border-radius: 12px;
            padding: 2rem;
            color: white;
            margin-bottom: 2rem;
        }
        
        .edit-form {
            background: white;
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            border: 1px solid #dee2e6;
        }
        
        .work-day-section {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            border-right: 4px solid #2c5aa0;
        }
        
        .time-range-section {
            background: white;
            border-radius: 6px;
            padding: 1rem;
            margin-bottom: 0.5rem;
            border-right: 3px solid #2c5aa0;
        }
        
        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
            margin-top: 2rem;
        }
        
        .btn-action {
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-weight: 500;
        }
        
        .form-group {
            margin-bottom: 1.5rem;
        }
        
        .form-label {
            font-weight: 600;
            color: #212529;
            margin-bottom: 0.5rem;
        }
        
        .form-control {
            border-radius: 6px;
            border: 1px solid #dee2e6;
        }
        
        .form-control:focus {
            border-color: #2c5aa0;
            box-shadow: 0 0 0 0.2rem rgba(44, 90, 160, 0.25);
        }
    </style>
}

<div class="container-fluid">
    <!-- Doctor Header -->
    <div class="doctor-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="mb-2">
                    <i class="fas fa-edit me-2"></i>
                    ویرایش برنامه کاری پزشک
                </h2>
                <p class="mb-0 opacity-75">@(Model.DoctorName ?? "پزشک")</p>
            </div>
                    <div class="col-md-4 text-end">
                <a href="@Url.Action("AssignSchedule", "DoctorSchedule", new { area = "Admin", doctorId = Model.DoctorId })" class="btn btn-light me-2">
                    <i class="fas fa-calendar-alt me-2"></i>
                    تنظیم برنامه
                </a>
                <a href="@Url.Action("Details", "DoctorSchedule", new { area = "Admin", id = Model.Id })" class="btn btn-light">
                    <i class="fas fa-arrow-left me-2"></i>
                    بازگشت به جزئیات
                </a>
            </div>
        </div>
    </div>

    <!-- Edit Form -->
    <div class="edit-form">
        @using (Html.BeginForm("AssignSchedule", "DoctorSchedule", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate", id = "editScheduleForm" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.DoctorId)
            <input type="hidden" name="operation" value="update" />
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
            
            <div class="row">
                <div class="col-12">
                    <h4 class="mb-3">
                        <i class="fas fa-calendar-alt me-2"></i>
                        ویرایش برنامه کاری
                    </h4>
                    
                    @if (Model.WorkDays != null && Model.WorkDays.Any())
                    {
                        for (int i = 0; i < Model.WorkDays.Count; i++)
                        {
                            var workDay = Model.WorkDays[i];
                            <div class="work-day-section">
                                @* ✅ Hidden fields برای WorkDay - برای شناسایی WorkDay های در حال ویرایش *@
                                @Html.HiddenFor(m => m.WorkDays[i].Id)
                                @Html.HiddenFor(m => m.WorkDays[i].DayOfWeek)
                                @Html.HiddenFor(m => m.WorkDays[i].DayName)
                                
                                <div class="row">
                                    <div class="col-md-3">
                                        <h6 class="mb-2">@workDay.DayName</h6>
                                        <div class="form-check">
                                            @Html.CheckBoxFor(m => m.WorkDays[i].IsActive, new { @class = "form-check-input" })
                                            <label class="form-check-label" for="@($"WorkDays_{i}__IsActive")">
                                                فعال
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-9">
                                        @if (workDay.TimeRanges != null && workDay.TimeRanges.Any())
                                        {
                                            for (int j = 0; j < workDay.TimeRanges.Count; j++)
                                            {
                                                var timeRange = workDay.TimeRanges[j];
                                                var startTimeValue = $"{workDay.TimeRanges[j].StartTime.Hours:D2}:{workDay.TimeRanges[j].StartTime.Minutes:D2}";
                                                var endTimeValue = $"{workDay.TimeRanges[j].EndTime.Hours:D2}:{workDay.TimeRanges[j].EndTime.Minutes:D2}";
                                                
                                                <div class="time-range-section">
                                                    @* ✅ Hidden field برای TimeRangeId - برای شناسایی TimeRange های در حال ویرایش *@
                                                    @Html.HiddenFor(m => m.WorkDays[i].TimeRanges[j].Id)
                                                    
                                                    <div class="row">
                                                        <div class="col-md-4">
                                                            <label class="form-label">زمان شروع</label>
                                                            @Html.TextBoxFor(m => m.WorkDays[i].TimeRanges[j].StartTime, 
                                                                new { 
                                                                    @class = "form-control", 
                                                                    type = "time",
                                                                    @Value = startTimeValue
                                                                })
                                                        </div>
                                                        <div class="col-md-4">
                                                            <label class="form-label">زمان پایان</label>
                                                            @Html.TextBoxFor(m => m.WorkDays[i].TimeRanges[j].EndTime, 
                                                                new { 
                                                                    @class = "form-control", 
                                                                    type = "time",
                                                                    @Value = endTimeValue
                                                                })
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label class="form-label">وضعیت</label>
                                                            <div class="form-check">
                                                                @Html.CheckBoxFor(m => m.WorkDays[i].TimeRanges[j].IsActive, new { @class = "form-check-input" })
                                                                <label class="form-check-label" for="@($"WorkDays_{i}__TimeRanges_{j}__IsActive")">
                                                                    فعال
                                                                </label>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-1">
                                                            <button type="button" class="btn btn-sm btn-danger" onclick="removeTimeRange(this)" title="حذف بازه زمانی" aria-label="حذف بازه زمانی">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                        <button type="button" class="btn btn-sm btn-success" onclick="addTimeRange(@i)">
                                            <i class="fas fa-plus me-1"></i>
                                            افزودن بازه زمانی
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-calendar-times fa-3x mb-3"></i>
                            <h5>هیچ برنامه کاری تعریف نشده است</h5>
                            <p>برای این پزشک هنوز برنامه کاری تنظیم نشده است.</p>
                        </div>
                    }
                </div>
            </div>
            
            <!-- تنظیمات عمومی برنامه کاری -->
            <div class="row mt-4">
                <div class="col-12">
                    <h4 class="mb-3">
                        <i class="fas fa-cog me-2"></i>
                        تنظیمات عمومی
                    </h4>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-clock me-2"></i>
                            مدت زمان هر نوبت (دقیقه)
                        </label>
                        @Html.TextBoxFor(m => m.AppointmentDuration, 
                            new { 
                                @class = "form-control", 
                                type = "number",
                                min = "5",
                                max = "120",
                                step = "5",
                                placeholder = "مثال: 30"
                            })
                        @Html.ValidationMessageFor(m => m.AppointmentDuration, "", new { @class = "text-danger" })
                        <small class="form-text text-muted">
                            مدت زمان هر نوبت به دقیقه (حداقل 5 و حداکثر 120 دقیقه)
                        </small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-money-bill-wave me-2"></i>
                            مبلغ حق ویزیت (ریال)
                        </label>
                        @Html.TextBoxFor(m => m.ConsultationFee, 
                            new { 
                                @class = "form-control", 
                                type = "number",
                                min = "0",
                                max = "10000000",
                                step = "1000",
                                placeholder = "مثال: 500000",
                                id = "consultationFeeInput"
                            })
                        @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
                        <small class="form-text text-muted">
                            مبلغ حق ویزیت به ریال. در نوبت‌دهی و محاسبه قیمت استفاده می‌شود.
                        </small>
                        <div id="consultationFeeGuide" class="alert alert-light border mt-2 mb-0" style="border-right: 4px solid #2c5aa0; background-color: #f8f9fa;">
                            <strong class="text-primary"><i class="fas fa-calculator me-2"></i>راهنما برای منشی:</strong>
                            <span id="consultationFeeGuideText">
                                @if (Model.ConsultationFee > 0)
                                {
                                    <text>معادل <strong>@MoneyDisplayHelper.FormatTomanDisplay(Model.ConsultationFee)</strong> — مبلغ به حروف: <strong>@MoneyDisplayHelper.AmountToWordsToman(Model.ConsultationFee)</strong></text>
                                }
                                else
                                {
                                    <span class="text-muted">مبلغ را وارد کنید تا معادل تومان و مبلغ به حروف نمایش داده شود.</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-video me-2"></i>
                            مبلغ مشاوره آنلاین (ریال)
                        </label>
                        @Html.TextBoxFor(m => m.OnlineConsultationFee, 
                            new { 
                                @class = "form-control", 
                                type = "number",
                                min = "0",
                                max = "10000000",
                                step = "1000",
                                placeholder = "خالی = همان مبلغ ویزیت حضوری",
                                id = "onlineConsultationFeeInput"
                            })
                        @Html.ValidationMessageFor(m => m.OnlineConsultationFee, "", new { @class = "text-danger" })
                        <small class="form-text text-muted">
                            برای نوبت «مشاوره آنلاین تصویری». صفر یا خالی = همان مبلغ حق ویزیت.
                        </small>
                    </div>
                </div>
            </div>
            
            <!-- Action Buttons -->
            <div class="action-buttons">
                <a href="@Url.Action("Details", "DoctorSchedule", new { area = "Admin", id = Model.Id })" class="btn btn-secondary btn-action">
                    <i class="fas fa-times me-2"></i>
                    انصراف
                </a>
                <button type="submit" class="btn btn-primary btn-action">
                    <i class="fas fa-save me-2"></i>
                    ذخیره تغییرات
                </button>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/plugins/SweetAlert2/sweetalert2@11.js"></script>
    <script>
        function addTimeRange(workDayIndex) {
            const workDaySection = document.querySelectorAll('.work-day-section')[workDayIndex];
            const timeRangesContainer = workDaySection.querySelector('.col-md-9');
            const timeRangeCount = timeRangesContainer.querySelectorAll('.time-range-section').length;
            
            const newTimeRange = document.createElement('div');
            newTimeRange.className = 'time-range-section';
            newTimeRange.innerHTML = `
                <input type="hidden" name="WorkDays[${workDayIndex}].TimeRanges[${timeRangeCount}].Id" value="0" />
                <div class="row">
                    <div class="col-md-4">
                        <label class="form-label">زمان شروع</label>
                        <input type="time" class="form-control" name="WorkDays[${workDayIndex}].TimeRanges[${timeRangeCount}].StartTime" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">زمان پایان</label>
                        <input type="time" class="form-control" name="WorkDays[${workDayIndex}].TimeRanges[${timeRangeCount}].EndTime" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">وضعیت</label>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="WorkDays[${workDayIndex}].TimeRanges[${timeRangeCount}].IsActive" checked />
                            <label class="form-check-label">فعال</label>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeTimeRange(this)" title="حذف بازه زمانی" aria-label="حذف بازه زمانی">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            `;
            
            // درج قبل از دکمه افزودن
            const addButton = timeRangesContainer.querySelector('.btn-success');
            timeRangesContainer.insertBefore(newTimeRange, addButton);
        }
        
        function removeTimeRange(button) {
            const timeRangeSection = button.closest('.time-range-section');
            timeRangeSection.remove();
        }
        
        // ✅ راهنمای مبلغ حق ویزیت (تومان + مبلغ به حروف) — به‌روزرسانی زنده برای منشی
        function updateConsultationFeeGuide() {
            var rial = parseInt($('#consultationFeeInput').val(), 10) || 0;
            if (rial < 0) rial = 0;
            var $text = $('#consultationFeeGuideText');
            if (rial === 0) {
                $text.html('<span class="text-muted">مبلغ را وارد کنید تا معادل تومان و مبلغ به حروف نمایش داده شود.</span>');
                return;
            }
            $.ajax({
                url: '@Url.Action("GetConsultationFeeDisplay", "DoctorSchedule", new { area = "Admin" })',
                data: { amountRial: rial },
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    var ok = data.success === true || data.Success === true;
                    var toman = data.tomanDisplay || data.TomanDisplay || '';
                    var words = data.amountInWords || data.AmountInWords || '';
                    if (ok && toman && words) {
                        $('#consultationFeeGuideText').html('معادل <strong>' + toman + '</strong> — مبلغ به حروف: <strong>' + words + '</strong>');
                    }
                },
                error: function() {
                    $('#consultationFeeGuideText').html('<span class="text-muted">مبلغ را وارد کنید تا معادل تومان و مبلغ به حروف نمایش داده شود.</span>');
                }
            });
        }
        $(document).ready(function() {
            $('#consultationFeeInput').on('blur input', function() {
                var self = this;
                clearTimeout(self._consultationFeeGuideTimer);
                self._consultationFeeGuideTimer = setTimeout(updateConsultationFeeGuide, 350);
            });
            if ($('#consultationFeeInput').val() && parseInt($('#consultationFeeInput').val(), 10) > 0) {
                updateConsultationFeeGuide();
            }
        });

        // اعتبارسنجی فرم
        $('#editScheduleForm').on('submit', function(e) {
            if (!this.checkValidity()) {
                e.preventDefault();
                e.stopPropagation();
                Swal.fire({
                    icon: 'error',
                    title: 'خطا در فرم',
                    text: 'لطفاً تمام فیلدهای الزامی را پر کنید.'
                });
            }
            this.classList.add('was-validated');
        });
    </script>
}
