@* صفحه جزئیات برنامه کاری پزشک — طراحی رسمی و خوانا مطابق قراردادهای پروژه *@
@model ClinicApp.ViewModels.DoctorManagementVM.DoctorScheduleViewModel
@using ClinicApp.Helpers
@{
    ViewBag.Title = "جزئیات برنامه کاری پزشک";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link href="~/Content/js/plugins/SweetAlert2/sweetalert2.min.css" rel="stylesheet" />
    <style>
        /* پالت رسمی درمانی — بدون گرادینت فانتزی، مطابق 03-Development-Contract-Quick-Guide */
        .doctor-header {
            background-color: var(--medical-primary, #2c5aa0);
            border-radius: 12px;
            padding: 2rem;
            color: white;
            margin-bottom: 2rem;
        }
        
        .schedule-details {
            background: white;
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            border: 1px solid #dee2e6;
        }
        
        .schedule-details h4, .schedule-details h5 {
            color: #212529;
            font-weight: 600;
        }
        
        .work-day-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            border-right: 4px solid var(--medical-primary, #2c5aa0);
        }
        
        .work-day-card.inactive {
            border-right-color: #6c757d;
            opacity: 0.85;
        }
        
        .time-range-item {
            background: white;
            border-radius: 6px;
            padding: 1rem 1.25rem;
            margin-bottom: 0.5rem;
            border-right: 3px solid var(--medical-primary, #2c5aa0);
            border: 1px solid #e9ecef;
        }
        
        .action-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            justify-content: flex-end;
            margin-top: 2rem;
        }
        
        .btn-action {
            padding: 0.6rem 1.25rem;
            border-radius: 8px;
            font-weight: 500;
        }
        
        .stats-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            margin-top: 1.5rem;
        }
        
        .stat-item {
            text-align: center;
            padding: 0.75rem 1.25rem;
            background: rgba(255,255,255,0.15);
            border-radius: 8px;
            min-width: 100px;
        }
        
        .stat-item .value {
            font-size: 1.25rem;
            font-weight: 600;
        }
        
        .stat-item .label {
            font-size: 0.8rem;
            opacity: 0.9;
        }
        
        .settings-card {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            border-right: 4px solid var(--medical-primary, #2c5aa0);
        }
        
        .settings-card .row dd, .settings-card .row dt {
            padding: 0.25rem 0;
        }
        
        .settings-card dt {
            font-weight: 600;
            color: #495057;
        }
    </style>
}

<div class="container-fluid">
    <!-- هدر پزشک -->
    <div class="doctor-header">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2 class="mb-2">
                    <i class="fas fa-user-md me-2" aria-hidden="true"></i>
                    @(Model.DoctorName ?? "پزشک")
                </h2>
                <p class="mb-0 opacity-75">جزئیات برنامه کاری و زمان‌بندی</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="@Url.Action("Index", "DoctorSchedule", new { area = "Admin" })" class="btn btn-light" title="بازگشت به لیست برنامه‌ها" aria-label="بازگشت به لیست برنامه‌ها">
                    <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>
                    بازگشت به لیست
                </a>
            </div>
        </div>
        
        <div class="stats-row">
            <div class="stat-item">
                <div class="value">@Model.TotalSchedules</div>
                <div class="label">کل برنامه‌ها</div>
            </div>
            <div class="stat-item">
                <div class="value">@Model.ActiveSchedules</div>
                <div class="label">برنامه‌های فعال</div>
            </div>
            <div class="stat-item">
                <div class="value">@Model.TotalTimeSlots</div>
                <div class="label">زمان‌های کاری</div>
            </div>
            <div class="stat-item">
                <div class="value">@Model.WeeklyHours</div>
                <div class="label">ساعت هفتگی</div>
            </div>
        </div>
    </div>

    <!-- تنظیمات نوبت‌دهی -->
    <div class="schedule-details">
        <h4 class="mb-3">
            <i class="fas fa-cog me-2" aria-hidden="true"></i>
            تنظیمات نوبت‌دهی
        </h4>
        <div class="settings-card">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">مدت نوبت (دقیقه)</dt>
                        <dd class="col-sm-8">@Model.AppointmentDuration</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">حق ویزیت (ریال)</dt>
                        <dd class="col-sm-8">@(Model.ConsultationFee > 0 ? Model.ConsultationFee.ToString("N0") : "—")</dd>
                    </dl>
                    @if (Model.ConsultationFee > 0)
                    {
                        <p class="mb-0 mt-1 text-muted small">
                            معادل <strong>@MoneyDisplayHelper.FormatTomanDisplay(Model.ConsultationFee)</strong>
                            — مبلغ به حروف: <strong>@MoneyDisplayHelper.AmountToWordsToman(Model.ConsultationFee)</strong>
                        </p>
                    }
                </div>
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">مبلغ مشاوره آنلاین (ریال)</dt>
                        <dd class="col-sm-8">@(Model.OnlineConsultationFee > 0 ? Model.OnlineConsultationFee.ToString("N0") : "— (همان حق ویزیت)")</dd>
                    </dl>
                    @if (Model.OnlineConsultationFee > 0)
                    {
                        <p class="mb-0 mt-1 text-muted small">
                            معادل <strong>@MoneyDisplayHelper.FormatTomanDisplay(Model.OnlineConsultationFee)</strong>
                        </p>
                    }
                </div>
            </div>
        </div>

        <h4 class="mb-3 mt-4">
            <i class="fas fa-calendar-alt me-2" aria-hidden="true"></i>
            برنامه هفتگی
        </h4>
        
        @if (Model.WorkDays != null && Model.WorkDays.Any())
        {
            foreach (var workDay in Model.WorkDays.OrderBy(w => w.DayOrder))
            {
                <div class="work-day-card @(!workDay.IsActive ? "inactive" : "")">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <h6 class="mb-2">@workDay.DayName</h6>
                            <span class="badge bg-@(workDay.IsActive ? "success" : "secondary")">
                                @(workDay.IsActive ? "فعال" : "غیرفعال")
                            </span>
                        </div>
                        <div class="col-md-9">
                            @if (workDay.TimeRanges != null && workDay.TimeRanges.Any())
                            {
                                foreach (var timeRange in workDay.TimeRanges.OrderBy(t => t.StartTime))
                                {
                                    if (timeRange.StartTime != TimeSpan.Zero && timeRange.EndTime != TimeSpan.Zero)
                                    {
                                        <div class="time-range-item">
                                            <div class="row align-items-center">
                                                <div class="col-md-4">
                                                    <strong>
                                                        @timeRange.StartTime.ToString(@"hh\:mm") – @timeRange.EndTime.ToString(@"hh\:mm")
                                                    </strong>
                                                </div>
                                                <div class="col-md-4">
                                                    <span class="badge bg-@(timeRange.IsActive ? "success" : "secondary")">
                                                        @(timeRange.IsActive ? "فعال" : "غیرفعال")
                                                    </span>
                                                </div>
                                                <div class="col-md-4 text-end">
                                                    <small class="text-muted">
                                                        مدت: @((timeRange.EndTime - timeRange.StartTime).TotalMinutes) دقیقه
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                <div class="text-muted">
                                    <i class="fas fa-info-circle me-1" aria-hidden="true"></i>
                                    هیچ بازه زمانی تعریف نشده است
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="fas fa-calendar-times fa-3x mb-3" aria-hidden="true"></i>
                <h5>هیچ برنامه کاری تعریف نشده است</h5>
                <p class="mb-0">برای این پزشک هنوز برنامه کاری تنظیم نشده است.</p>
            </div>
        }
        
        <!-- دکمه‌های عملیات -->
        <div class="action-buttons">
            @Html.AntiForgeryToken()
            <a href="@Url.Action("Edit", "DoctorSchedule", new { area = "Admin", id = Model.Id })" 
               class="btn btn-primary btn-action" 
               title="ویرایش برنامه کاری" 
               aria-label="ویرایش برنامه کاری">
                <i class="fas fa-edit me-2" aria-hidden="true"></i>
                ویرایش برنامه
            </a>
            <a href="@Url.Action("Schedule", "DoctorSchedule", new { area = "Admin", doctorId = Model.DoctorId })" 
               class="btn btn-info btn-action" 
               title="مشاهده برنامه در تقویم" 
               aria-label="مشاهده برنامه در تقویم">
                <i class="fas fa-calendar me-2" aria-hidden="true"></i>
                مشاهده برنامه
            </a>
            <button type="button" class="btn btn-warning btn-action" 
                    onclick="deactivateSchedule(@Model.Id)" 
                    title="غیرفعال کردن برنامه" 
                    aria-label="غیرفعال کردن برنامه">
                <i class="fas fa-pause me-2" aria-hidden="true"></i>
                غیرفعال کردن
            </button>
            <button type="button" class="btn btn-danger btn-action" 
                    onclick="removeSchedule(@Model.Id)" 
                    title="حذف برنامه (غیرقابل بازگشت)" 
                    aria-label="حذف برنامه">
                <i class="fas fa-trash me-2" aria-hidden="true"></i>
                حذف برنامه
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Content/js/plugins/SweetAlert2/sweetalert2@11.js"></script>
    <script>
        function deactivateSchedule(scheduleId) {
            Swal.fire({
                title: 'غیرفعال کردن برنامه',
                text: 'آیا از غیرفعال کردن این برنامه اطمینان دارید؟',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، غیرفعال کن',
                cancelButtonText: 'انصراف',
                reverseButtons: true
            }).then(function(result) {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("DeactivateSchedule", "DoctorSchedule", new { area = "Admin" })',
                        type: 'POST',
                        data: { 
                            scheduleId: scheduleId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'موفق',
                                    text: 'برنامه با موفقیت غیرفعال شد',
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(function() {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'خطا',
                                    text: response.message || 'خطا در غیرفعال کردن برنامه'
                                });
                            }
                        },
                        error: function() {
                            Swal.fire({
                                icon: 'error',
                                title: 'خطا',
                                text: 'خطا در ارتباط با سرور'
                            });
                        }
                    });
                }
            });
        }

        function removeSchedule(scheduleId) {
            Swal.fire({
                title: 'حذف برنامه',
                text: 'آیا از حذف این برنامه اطمینان دارید؟ این عملیات غیرقابل بازگشت است.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف کن',
                cancelButtonText: 'انصراف',
                reverseButtons: true,
                confirmButtonColor: '#dc3545'
            }).then(function(result) {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("RemoveSchedule", "DoctorSchedule", new { area = "Admin" })',
                        type: 'POST',
                        data: { 
                            scheduleId: scheduleId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'موفق',
                                    text: 'برنامه با موفقیت حذف شد',
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(function() {
                                    window.location.href = '@Url.Action("Index", "DoctorSchedule", new { area = "Admin" })';
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'خطا',
                                    text: response.message || 'خطا در حذف برنامه'
                                });
                            }
                        },
                        error: function() {
                            Swal.fire({
                                icon: 'error',
                                title: 'خطا',
                                text: 'خطا در ارتباط با سرور'
                            });
                        }
                    });
                }
            });
        }
    </script>
}
