                            text: 'توکن امنیتی یافت نشد. لطفاً صفحه را رفرش کنید.',
                            confirmButtonText: 'باشه'
                        });
                        return;
                    }
                    
                    $.ajax({
                        url: '@Url.Action("ActivateSchedule", "DoctorSchedule", new { area = "Admin" })',
                        type: 'POST',
                        dataType: 'json',
                        contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                        data: {
                            scheduleId: id,
                            __RequestVerificationToken: token
                        },
                        success: function (data) {
                            hideLoading();
                            console.log('ActivateSchedule Response:', data);
                            if (data && data.success === true) {
                                Swal.fire({
                                    icon: 'success',
