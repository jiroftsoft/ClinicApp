        function loadPage(page) {
            showLoading(); // ✅ نمایش Loading State
            var url = '@Url.Action("Index", "DoctorSchedule", new { area = "Admin" })?page=' + page;
            var filters = {
                doctorId: $('#doctorFilter').val(),
                dayOfWeek: $('#dayOfWeekFilter').val(),
                isActive: $('#statusFilter').val()
            };

            $.each(filters, function (key, value) {
                if (value) {
                    url += '&' + key + '=' + value;
                }
            });

            window.location.href = url;
        }

        // ✅ توابع Loading State
        function showLoading() {
            var overlay = $('.loading-overlay');
            if (overlay.length === 0) {
                // ایجاد overlay اگر وجود نداشته باشد
                $('body').append('<div class="loading-overlay"><div class="loading-spinner"></div></div>');
            }
            $('.loading-overlay').addClass('active');
        }

        function hideLoading() {
            $('.loading-overlay').removeClass('active');
        }
    </script>
