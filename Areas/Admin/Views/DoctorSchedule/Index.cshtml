                                    text: data.message || 'برنامه کاری با موفقیت فعال شد.',
                                    confirmButtonText: 'باشه'
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'خطا!',
                                    text: data && data.message ? data.message : 'خطا در فعال کردن برنامه کاری',
                                    confirmButtonText: 'باشه'
                                });
                            }
                        },
                        error: function(xhr, status, error) {
                            hideLoading();
                            console.error('ActivateSchedule Error:', {xhr: xhr, status: status, error: error, responseText: xhr.responseText});
                            
                            var errorMessage = 'خطا در ارتباط با سرور';
                            if (xhr.status === 400) {
                                errorMessage = 'درخواست نامعتبر است. لطفاً صفحه را رفرش کنید و دوباره تلاش کنید.';
                            } else if (xhr.status === 404) {
