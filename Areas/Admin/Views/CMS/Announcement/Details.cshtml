@model ClinicApp.ViewModels.CMS.AnnouncementDetailsViewModel
@{
    ViewBag.Title = "جزئیات اطلاعیه";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">جزئیات اطلاعیه</h1>
        <div>
            <a href="@Url.Action("Edit", new { id = Model.AnnouncementId })" class="btn btn-primary">
                <i class="fas fa-edit"></i> ویرایش
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> بازگشت به لیست
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4 @(Model.IsImportant ? "border-warning" : "")">
                <div class="card-header py-3 @(Model.IsImportant ? "bg-warning" : "")">
                    <h6 class="m-0 font-weight-bold @(Model.IsImportant ? "text-dark" : "text-primary")">
                        @Model.Title
                        @if (Model.IsImportant)
                        {
                            <span class="badge badge-danger mr-2">مهم</span>
                        }
                    </h6>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-4 text-center">
                            <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded" style="max-height: 400px; width: 100%; object-fit: cover;">
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Content))
                    {
                        <div class="mb-3">
                            <h5>محتوا</h5>
                            <p class="text-muted">@Model.Content</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.LinkUrl))
                    {
                        <div class="mb-3">
                            <h5>لینک</h5>
                            <p><a href="@Model.LinkUrl" target="_blank">@Model.LinkUrl</a></p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-left-primary shadow mb-3">
                <div class="card-body">
                    <h6 class="font-weight-bold text-primary mb-3">اطلاعات اطلاعیه</h6>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>شناسه:</strong></td>
                            <td>@Model.AnnouncementId</td>
                        </tr>
                        <tr>
                            <td><strong>نوع:</strong></td>
                            <td>
                                <span class="badge badge-@(Model.Type == "warning" ? "warning" : Model.Type == "error" ? "danger" : Model.Type == "success" ? "success" : "info")">
                                    @(Model.Type ?? "info")
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>مخاطب:</strong></td>
                            <td>@(Model.TargetAudience ?? "all")</td>
                        </tr>
                        <tr>
                            <td><strong>وضعیت:</strong></td>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge badge-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">غیرفعال</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td><strong>ترتیب نمایش:</strong></td>
                            <td>@Model.DisplayOrder</td>
                        </tr>
                        <tr>
                            <td><strong>تاریخ شروع:</strong></td>
                            <td>@(Model.StartDate?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                        </tr>
                        <tr>
                            <td><strong>تاریخ پایان:</strong></td>
                            <td>@(Model.EndDate?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="card border-left-secondary shadow">
                <div class="card-body">
                    <h6 class="font-weight-bold text-secondary mb-3">اطلاعات سیستم</h6>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>تاریخ ایجاد:</strong></td>
                            <td>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        </tr>
                        <tr>
                            <td><strong>ایجاد کننده:</strong></td>
                            <td>@Model.CreatedByUserName</td>
                        </tr>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <tr>
                                <td><strong>آخرین ویرایش:</strong></td>
                                <td>@Model.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")</td>
                            </tr>
                            <tr>
                                <td><strong>ویرایش کننده:</strong></td>
                                <td>@(Model.UpdatedByUserName ?? "-")</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

