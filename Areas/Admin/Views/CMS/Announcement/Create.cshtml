@model ClinicApp.ViewModels.CMS.AnnouncementCreateEditViewModel
@{
    ViewBag.Title = "ایجاد اطلاعیه جدید";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">ایجاد اطلاعیه جدید</h1>
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> بازگشت به لیست
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Create", "Announcement", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Title, new { @class = "required" })
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "عنوان اطلاعیه" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Content)
                            @Html.TextAreaFor(m => m.Content, new { @class = "form-control", rows = "5", placeholder = "محتوا و متن اطلاعیه" })
                            @Html.ValidationMessageFor(m => m.Content, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.ImageUrl)
                            @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control", placeholder = "/Content/Images/announcements/..." })
                            @Html.ValidationMessageFor(m => m.ImageUrl, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.LinkUrl)
                            @Html.TextBoxFor(m => m.LinkUrl, new { @class = "form-control", placeholder = "لینک مقصد (اختیاری)" })
                            @Html.ValidationMessageFor(m => m.LinkUrl, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Type)
                            @Html.DropDownListFor(m => m.Type, new SelectList(new[] { 
                                new SelectListItem { Text = "اطلاعات", Value = "info" },
                                new SelectListItem { Text = "هشدار", Value = "warning" },
                                new SelectListItem { Text = "موفقیت", Value = "success" },
                                new SelectListItem { Text = "خطا", Value = "error" }
                            }, "Value", "Text", Model.Type), new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.TargetAudience)
                            @Html.DropDownListFor(m => m.TargetAudience, new SelectList(new[] { 
                                new SelectListItem { Text = "همه", Value = "all" },
                                new SelectListItem { Text = "بیماران", Value = "patients" },
                                new SelectListItem { Text = "پزشکان", Value = "doctors" },
                                new SelectListItem { Text = "کارکنان", Value = "staff" }
                            }, "Value", "Text", Model.TargetAudience), new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.TargetAudience, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            @Html.LabelFor(m => m.DisplayOrder, new { @class = "required" })
                            @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", type = "number", @Value = "0" })
                            @Html.ValidationMessageFor(m => m.DisplayOrder, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <div class="form-check mt-4">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                                @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                            </div>
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.IsImportant, new { @class = "form-check-input" })
                                @Html.LabelFor(m => m.IsImportant, new { @class = "form-check-label" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.StartDate)
                            @Html.TextBoxFor(m => m.StartDate, new { @class = "form-control", type = "datetime-local" })
                            @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.EndDate)
                            @Html.TextBoxFor(m => m.EndDate, new { @class = "form-control", type = "datetime-local" })
                            @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> ذخیره
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-times"></i> انصراف
                    </a>
                </div>
            }
        </div>
    </div>
</div>

