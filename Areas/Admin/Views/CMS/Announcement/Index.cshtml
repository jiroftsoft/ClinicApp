@model List<ClinicApp.ViewModels.CMS.AnnouncementIndexViewModel>
@using ClinicApp.Helpers
@{
    ViewBag.Title = "مدیریت اطلاعیه‌ها";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">مدیریت اطلاعیه‌ها</h1>
        <div>
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus"></i> اطلاعیه جدید
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Filter -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="includeInactive" @(ViewBag.IncludeInactive == true ? "checked" : "") onchange="toggleInactive()">
                <label class="form-check-label" for="includeInactive">
                    نمایش اطلاعیه‌های غیرفعال
                </label>
            </div>
        </div>
    </div>

    <!-- Announcements List -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">لیست اطلاعیه‌ها (@Model.Count مورد)</h6>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>عنوان</th>
                                <th>نوع</th>
                                <th>مخاطب</th>
                                <th>وضعیت</th>
                                <th>مهم</th>
                                <th>ترتیب</th>
                                <th>تاریخ شروع</th>
                                <th>تاریخ پایان</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.IsImportant ? "table-warning" : "")">
                                    <td>
                                        <strong>@item.Title</strong>
                                        @if (!string.IsNullOrEmpty(item.Content))
                                        {
                                            <br />
                                            <small class="text-muted">@StringHelper.StripHtmlAndTruncate(item.Content, 100)</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-@(item.Type == "warning" ? "warning" : item.Type == "error" ? "danger" : item.Type == "success" ? "success" : "info")">
                                            @(item.Type ?? "info")
                                        </span>
                                    </td>
                                    <td>@(item.TargetAudience ?? "all")</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge badge-success">فعال</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">غیرفعال</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsImportant)
                                        {
                                            <span class="badge badge-danger">مهم</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">عادی</span>
                                        }
                                    </td>
                                    <td>@item.DisplayOrder</td>
                                    <td>@(item.StartDate.HasValue ? ClinicApp.Helpers.PersianDateHelper.ToPersianDate(item.StartDate.Value) : "-")</td>
                                    <td>@(item.EndDate.HasValue ? ClinicApp.Helpers.PersianDateHelper.ToPersianDate(item.EndDate.Value) : "-")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Details", new { id = item.AnnouncementId })" class="btn btn-sm btn-info" title="جزئیات">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", new { id = item.AnnouncementId })" class="btn btn-sm btn-primary" title="ویرایش">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (item.IsActive)
                                            {
                                                using (Html.BeginForm("Deactivate", "Announcement", new { id = item.AnnouncementId }, FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-warning" title="غیرفعال">
                                                        <i class="fas fa-pause"></i>
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                using (Html.BeginForm("Activate", "Announcement", new { id = item.AnnouncementId }, FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="فعال">
                                                        <i class="fas fa-play"></i>
                                                    </button>
                                                }
                                            }
                                            @using (Html.BeginForm("Delete", "Announcement", new { id = item.AnnouncementId }, FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" title="حذف" onclick="return confirm('آیا از حذف این اطلاعیه اطمینان دارید؟')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> هیچ اطلاعیه‌ای یافت نشد.
                </div>
            }
        </div>
    </div>
</div>

<script>
    function toggleInactive() {
        var includeInactive = document.getElementById('includeInactive').checked;
        window.location.href = '@Url.Action("Index")?includeInactive=' + includeInactive;
    }
</script>

