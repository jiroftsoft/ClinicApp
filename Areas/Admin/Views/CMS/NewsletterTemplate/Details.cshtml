@model ClinicApp.ViewModels.CMS.NewsletterTemplateDetailsViewModel
@using ClinicApp.Helpers
@{
    ViewBag.Title = "جزئیات Template";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@* ============================================
   Newsletter Template Details - Production Ready
   ============================================
   - SRP: نمایش جزئیات Template
   - Strongly-Typed: استفاده از ViewModel
   - UI/UX: طراحی ماژولار و کامپوننت محور
   ============================================ *@

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-file-alt text-primary"></i> جزئیات Template
        </h1>
        <div>
            <a href="@Url.Action("Preview", new { id = Model.NewsletterTemplateId })" class="btn btn-info" target="_blank">
                <i class="fas fa-eye"></i> پیش‌نمایش
            </a>
            <a href="@Url.Action("Edit", new { id = Model.NewsletterTemplateId })" class="btn btn-warning">
                <i class="fas fa-edit"></i> ویرایش
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> بازگشت به لیست
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-info-circle"></i> اطلاعات Template
                    </h6>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">نام:</dt>
                        <dd class="col-sm-8"><strong>@Model.Name</strong></dd>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <dt class="col-sm-4">توضیحات:</dt>
                            <dd class="col-sm-8">@Model.Description</dd>
                        }

                        <dt class="col-sm-4">وضعیت:</dt>
                        <dd class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge badge-success">
                                    <i class="fas fa-check-circle"></i> فعال
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">
                                    <i class="fas fa-ban"></i> غیرفعال
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-4">تاریخ ایجاد:</dt>
                        <dd class="col-sm-8">@PersianDateHelper.ToPersianDate(Model.CreatedAt)</dd>

                        @if (Model.UpdatedAt.HasValue)
                        {
                            <dt class="col-sm-4">آخرین به‌روزرسانی:</dt>
                            <dd class="col-sm-8">@PersianDateHelper.ToPersianDate(Model.UpdatedAt.Value)</dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-code"></i> محتوای Template
                    </h6>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Content))
                    {
                        <div class="template-preview-content" style="border: 1px solid #dee2e6; padding: 1rem; border-radius: 4px; background: #f8f9fa;">
                            @Html.Raw(Model.Content)
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">بدون محتوا</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-cog"></i> اطلاعات سیستم
                    </h6>
                </div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt>ایجاد شده توسط:</dt>
                        <dd>@(Model.CreatedByUserName ?? "سیستم")</dd>

                        @if (Model.UpdatedAt.HasValue)
                        {
                            <dt>به‌روزرسانی شده توسط:</dt>
                            <dd>@(Model.UpdatedByUserName ?? "-")</dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-bolt"></i> عملیات سریع
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.IsActive)
                    {
                        using (Html.BeginForm("Deactivate", "NewsletterTemplate", new { id = Model.NewsletterTemplateId }, FormMethod.Post, new { @class = "mb-2" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning btn-block" onclick="return confirm('آیا مطمئن هستید؟')">
                                <i class="fas fa-ban"></i> غیرفعال کردن
                            </button>
                        }
                    }
                    else
                    {
                        using (Html.BeginForm("Activate", "NewsletterTemplate", new { id = Model.NewsletterTemplateId }, FormMethod.Post, new { @class = "mb-2" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-block" onclick="return confirm('آیا مطمئن هستید؟')">
                                <i class="fas fa-check"></i> فعال کردن
                            </button>
                        }
                    }

                    @using (Html.BeginForm("Delete", "NewsletterTemplate", new { id = Model.NewsletterTemplateId }, FormMethod.Post, new { @class = "mb-0" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-block" onclick="return confirm('آیا مطمئن هستید که می‌خواهید این Template را حذف کنید؟')">
                            <i class="fas fa-trash"></i> حذف
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

