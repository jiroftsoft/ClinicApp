@model ClinicApp.ViewModels.CMS.ContactFormDetailsViewModel
@{
    ViewBag.Title = "جزئیات فرم تماس";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@* ============================================
   Contact Form Details - Production Ready
   ============================================
   - SRP: نمایش جزئیات فرم تماس
   - Strongly-Typed: استفاده از ViewModel
   - UI/UX: طراحی رسمی و حرفه‌ای
   - Notification: استفاده از Toastr
   ============================================ *@

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-envelope text-primary"></i>
            جزئیات فرم تماس
        </h1>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> بازگشت به لیست
            </a>
        </div>
    </div>

    @* پیام‌ها با استفاده از Toastr نمایش داده می‌شوند - در _AdminLayout.cshtml *@

    <div class="row">
        <div class="col-md-8">
            <!-- Contact Form Details -->
            <div class="card shadow mb-4">
                <div class="card-header py-3" style="background-color: var(--medical-primary); color: white;">
                    <h6 class="m-0 font-weight-bold">
                        <i class="fas fa-info-circle"></i> اطلاعات فرم تماس
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>نام و نام خانوادگی:</strong>
                            <p>@Model.FullName</p>
                        </div>
                        <div class="col-md-6">
                            <strong>ایمیل:</strong>
                            <p><a href="mailto:@Model.Email">@Model.Email</a></p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>شماره تماس:</strong>
                            <p><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></p>
                        </div>
                        <div class="col-md-6">
                            <strong>دسته‌بندی:</strong>
                            <p><span class="badge badge-info">@Model.CategoryDisplay</span></p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <strong>موضوع:</strong>
                            <p>@Model.Subject</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <strong>پیام:</strong>
                            <div class="border p-3 rounded" style="background-color: var(--medical-light); min-height: 100px;">
                                @Model.Message
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>وضعیت:</strong>
                            <p>
                                @{
                                    var statusClass = "badge-secondary";
                                    if (Model.Status == ClinicApp.Models.Enums.ContactFormStatus.New)
                                    {
                                        statusClass = "badge-danger";
                                    }
                                    else if (Model.Status == ClinicApp.Models.Enums.ContactFormStatus.InProgress)
                                    {
                                        statusClass = "badge-warning";
                                    }
                                    else if (Model.Status == ClinicApp.Models.Enums.ContactFormStatus.Replied)
                                    {
                                        statusClass = "badge-success";
                                    }
                                    else if (Model.Status == ClinicApp.Models.Enums.ContactFormStatus.Closed)
                                    {
                                        statusClass = "badge-secondary";
                                    }
                                }
                                <span class="badge @statusClass">@Model.StatusDisplay</span>
                            </p>
                        </div>
                        <div class="col-md-6">
                            <strong>خوانده شده:</strong>
                            <p>
                                @if (Model.IsRead)
                                {
                                    <span class="badge badge-success">
                                        <i class="fas fa-check"></i> خوانده شده
                                    </span>
                                    if (Model.ReadAt.HasValue)
                                    {
                                        <br />
                                        <small class="text-muted">@ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.ReadAt.Value)</small>
                                    }
                                }
                                else
                                {
                                    <span class="badge badge-danger">
                                        <i class="fas fa-times"></i> خوانده نشده
                                    </span>
                                }
                            </p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>تاریخ ارسال:</strong>
                            <p>@ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.CreatedAt)</p>
                        </div>
                        <div class="col-md-6">
                            <strong>ایجاد کننده:</strong>
                            <p>@Model.CreatedByUserName</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.IpAddress))
                    {
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>IP Address:</strong>
                                <p><code>@Model.IpAddress</code></p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Reply Section -->
            @if (!string.IsNullOrEmpty(Model.ReplyMessage))
            {
                <div class="card shadow mb-4">
                    <div class="card-header py-3" style="background-color: var(--medical-success); color: white;">
                        <h6 class="m-0 font-weight-bold">
                            <i class="fas fa-reply"></i> پاسخ داده شده
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="border p-3 rounded" style="background-color: #f0f9ff; min-height: 100px;">
                            @Model.ReplyMessage
                        </div>
                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="fas fa-clock"></i> تاریخ پاسخ: 
                                @if (Model.RepliedAt.HasValue)
                                {
                                    @ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.RepliedAt.Value)
                                }
                                @if (!string.IsNullOrEmpty(Model.RepliedByUserName))
                                {
                                    <span> | پاسخ دهنده: @Model.RepliedByUserName</span>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <!-- Actions -->
            <div class="card shadow mb-4">
                <div class="card-header py-3" style="background-color: var(--medical-primary); color: white;">
                    <h6 class="m-0 font-weight-bold">
                        <i class="fas fa-cog"></i> عملیات
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        @if (string.IsNullOrEmpty(Model.ReplyMessage))
                        {
                            <a href="@Url.Action("Reply", new { id = Model.ContactFormId })" class="btn btn-primary btn-block">
                                <i class="fas fa-reply"></i> پاسخ دادن
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("Reply", new { id = Model.ContactFormId })" class="btn btn-warning btn-block">
                                <i class="fas fa-edit"></i> ویرایش پاسخ
                            </a>
                        }

                        @if (!Model.IsRead)
                        {
                            using (Html.BeginForm("MarkAsRead", "ContactForm", new { id = Model.ContactFormId }, FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-block">
                                    <i class="fas fa-check"></i> علامت‌گذاری به عنوان خوانده شده
                                </button>
                            }
                        }
                        else
                        {
                            using (Html.BeginForm("MarkAsUnread", "ContactForm", new { id = Model.ContactFormId }, FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-secondary btn-block">
                                    <i class="fas fa-times"></i> علامت‌گذاری به عنوان خوانده نشده
                                </button>
                            }
                        }

                        <!-- Change Status -->
                        <div class="dropdown">
                            <button class="btn btn-info btn-block dropdown-toggle" type="button" id="statusDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-exchange-alt"></i> تغییر وضعیت
                            </button>
                            <div class="dropdown-menu" aria-labelledby="statusDropdown">
                                @using (Html.BeginForm("ChangeStatus", "ContactForm", new { id = Model.ContactFormId, status = ClinicApp.Models.Enums.ContactFormStatus.New }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item" @(Model.Status == ClinicApp.Models.Enums.ContactFormStatus.New ? "disabled" : "")>
                                        <i class="fas fa-circle text-danger"></i> جدید
                                    </button>
                                }
                                @using (Html.BeginForm("ChangeStatus", "ContactForm", new { id = Model.ContactFormId, status = ClinicApp.Models.Enums.ContactFormStatus.InProgress }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item" @(Model.Status == ClinicApp.Models.Enums.ContactFormStatus.InProgress ? "disabled" : "")>
                                        <i class="fas fa-circle text-warning"></i> در حال بررسی
                                    </button>
                                }
                                @using (Html.BeginForm("ChangeStatus", "ContactForm", new { id = Model.ContactFormId, status = ClinicApp.Models.Enums.ContactFormStatus.Replied }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item" @(Model.Status == ClinicApp.Models.Enums.ContactFormStatus.Replied ? "disabled" : "")>
                                        <i class="fas fa-circle text-success"></i> پاسخ داده شده
                                    </button>
                                }
                                @using (Html.BeginForm("ChangeStatus", "ContactForm", new { id = Model.ContactFormId, status = ClinicApp.Models.Enums.ContactFormStatus.Closed }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item" @(Model.Status == ClinicApp.Models.Enums.ContactFormStatus.Closed ? "disabled" : "")>
                                        <i class="fas fa-circle text-secondary"></i> بسته شده
                                    </button>
                                }
                            </div>
                        </div>

                        @using (Html.BeginForm("Delete", "ContactForm", new { id = Model.ContactFormId }, FormMethod.Post, new { @class = "d-inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger btn-block" onclick="return confirmDelete()">
                                <i class="fas fa-trash"></i> حذف
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            return Swal.fire({
                title: 'آیا از حذف این فرم تماس اطمینان دارید؟',
                text: 'این عملیات قابل بازگشت نیست',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'بله، حذف کن',
                cancelButtonText: 'خیر، انصراف',
                reverseButtons: true
            }).then(function(result) {
                return result.isConfirmed;
            });
        }
    </script>
}

