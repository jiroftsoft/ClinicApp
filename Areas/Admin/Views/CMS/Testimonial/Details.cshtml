@model ClinicApp.ViewModels.CMS.TestimonialDetailsViewModel
@{
    ViewBag.Title = "جزئیات نظر";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@* ============================================
   Testimonial Details - Production Ready
   ============================================
   - SRP: نمایش جزئیات نظر
   - Strongly-Typed: استفاده از ViewModel
   - UI/UX: طراحی رسمی و حرفه‌ای
   ============================================ *@

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-eye text-primary"></i>
            جزئیات نظر
        </h1>
        <div>
            <a href="@Url.Action("Edit", new { id = Model.TestimonialId })" class="btn btn-primary">
                <i class="fas fa-edit"></i> ویرایش
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> بازگشت به لیست
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4 @(Model.IsFeatured ? "border-info" : "")">
                <div class="card-header py-3 @(Model.IsFeatured ? "bg-info text-white" : "")">
                    <h6 class="m-0 font-weight-bold">
                        <i class="fas fa-comments"></i>
                        نظر @Model.PatientName
                        @if (Model.IsFeatured)
                        {
                            <span class="badge badge-light mr-2">
                                <i class="fas fa-star"></i> ویژه
                            </span>
                        }
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.PatientInitials))
                        {
                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mr-3" 
                                 style="width: 80px; height: 80px; font-size: 2rem; font-weight: bold;"
                                 title="@Model.PatientName"
                                 aria-label="آواتار @Model.PatientName">
                                @Model.PatientInitials
                            </div>
                        }
                        <div>
                            <h4>@Model.PatientName</h4>
                            @if (!string.IsNullOrEmpty(Model.DoctorName))
                            {
                                <p class="text-muted mb-0">
                                    <i class="fas fa-user-md"></i> پزشک: @Model.DoctorName
                                </p>
                            }
                            <div class="mt-2">
                                <div class="d-inline-block" role="img" aria-label="امتیاز @Model.Rating از 5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= Model.Rating ? "text-warning" : "text-muted")" 
                                           style="font-size: 1.5rem;"
                                           aria-hidden="true"></i>
                                    }
                                </div>
                                <span class="ml-2">(@Model.Rating از 5)</span>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Comment))
                    {
                        <div class="mb-4">
                            <h5>
                                <i class="fas fa-comment-dots text-primary"></i> نظر
                            </h5>
                            <div class="card bg-light p-3">
                                <p class="mb-0" style="font-size: 1.1rem; line-height: 1.8; color: #495057;">
                                    @Model.Comment
                                </p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                    {
                        <div class="mb-3">
                            <h5>
                                <i class="fas fa-image text-primary"></i> تصویر
                            </h5>
                            <img src="@Model.PhotoUrl" 
                                 alt="@Model.PatientName" 
                                 class="img-fluid rounded shadow-sm" 
                                 style="max-height: 400px; cursor: pointer;"
                                 onclick="openImageModal('@Model.PhotoUrl')"
                                 title="کلیک برای مشاهده در اندازه بزرگ">
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.VideoUrl))
                    {
                        <div class="mb-3">
                            <h5>
                                <i class="fas fa-video text-primary"></i> ویدیو
                            </h5>
                            <a href="@Model.VideoUrl" 
                               target="_blank" 
                               class="btn btn-primary"
                               rel="noopener noreferrer"
                               aria-label="مشاهده ویدیو در صفحه جدید">
                                <i class="fas fa-play"></i> مشاهده ویدیو
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Testimonial Info Card -->
            <div class="card border-left-primary shadow mb-3">
                <div class="card-body">
                    <h6 class="font-weight-bold text-primary mb-3">
                        <i class="fas fa-info-circle"></i> اطلاعات نظر
                    </h6>
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <td><strong>شناسه:</strong></td>
                            <td>@Model.TestimonialId</td>
                        </tr>
                        <tr>
                            <td><strong>وضعیت:</strong></td>
                            <td>
                                @if (Model.IsApproved)
                                {
                                    <span class="badge badge-success">
                                        <i class="fas fa-check-circle"></i> تایید شده
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">
                                        <i class="fas fa-clock"></i> در انتظار تایید
                                    </span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td><strong>ویژه:</strong></td>
                            <td>
                                @if (Model.IsFeatured)
                                {
                                    <span class="badge badge-info">
                                        <i class="fas fa-star"></i> ویژه
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">عادی</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td><strong>ترتیب نمایش:</strong></td>
                            <td>@Model.DisplayOrder</td>
                        </tr>
                        <tr>
                            <td><strong>تاریخ تایید:</strong></td>
                            <td>
                                @if (Model.ApprovedAt.HasValue)
                                {
                                    <span title="@Model.ApprovedAt.Value.ToString("yyyy/MM/dd HH:mm")">
                                        @ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.ApprovedAt.Value)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- System Info Card -->
            <div class="card border-left-secondary shadow">
                <div class="card-body">
                    <h6 class="font-weight-bold text-secondary mb-3">
                        <i class="fas fa-cog"></i> اطلاعات سیستم
                    </h6>
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <td><strong>تاریخ ایجاد:</strong></td>
                            <td>
                                <span title="@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")">
                                    @ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.CreatedAt)
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>ایجاد کننده:</strong></td>
                            <td>@(Model.CreatedByUserName ?? "-")</td>
                        </tr>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <tr>
                                <td><strong>آخرین ویرایش:</strong></td>
                                <td>
                                    <span title="@Model.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")">
                                        @ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.UpdatedAt.Value)
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>ویرایش کننده:</strong></td>
                                <td>@(Model.UpdatedByUserName ?? "-")</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">تصویر بیمار</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="بستن">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" alt="تصویر بیمار" class="img-fluid">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openImageModal(imageUrl) {
            $('#modalImage').attr('src', imageUrl);
            $('#imageModal').modal('show');
        }
    </script>
}
