@model List<ClinicApp.ViewModels.CMS.GalleryItemIndexViewModel>
@{
    ViewBag.Title = "مدیریت گالری";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">مدیریت گالری</h1>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="fas fa-plus"></i> آیتم جدید
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Filter by Category -->
    @if (ViewBag.Categories != null && ((List<string>)ViewBag.Categories).Any())
    {
        <div class="card shadow mb-4">
            <div class="card-body">
                <div class="btn-group" role="group">
                    <a href="@Url.Action("Index")" class="btn btn-@(ViewBag.SelectedCategory == null ? "primary" : "secondary")">همه</a>
                    @foreach (var cat in ViewBag.Categories)
                    {
                        <a href="@Url.Action("Index", new { category = cat })" class="btn btn-@(ViewBag.SelectedCategory == cat ? "primary" : "secondary")">@cat</a>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Gallery Items Grid -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">لیست آیتم‌های گالری (@Model.Count مورد)</h6>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="row">
                    @foreach (var item in Model)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100">
                                @if (!string.IsNullOrEmpty(item.ThumbnailUrl))
                                {
                                    <img src="@item.ThumbnailUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                                }
                                else if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                                }
                                <div class="card-body">
                                    <h5 class="card-title">@item.Title</h5>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <p class="card-text">@(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)</p>
                                    }
                                    <div class="mb-2">
                                        <span class="badge badge-info">@(item.Category ?? "clinic")</span>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge badge-success">فعال</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">غیرفعال</span>
                                        }
                                    </div>
                                    <div class="btn-group w-100" role="group">
                                        <a href="@Url.Action("Details", new { id = item.GalleryItemId })" class="btn btn-sm btn-info" title="جزئیات">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Edit", new { id = item.GalleryItemId })" class="btn btn-sm btn-primary" title="ویرایش">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        @if (item.IsActive)
                                        {
                                            using (Html.BeginForm("Deactivate", "Gallery", new { id = item.GalleryItemId }, FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-warning" title="غیرفعال">
                                                    <i class="fas fa-pause"></i>
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            using (Html.BeginForm("Activate", "Gallery", new { id = item.GalleryItemId }, FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success" title="فعال">
                                                    <i class="fas fa-play"></i>
                                                </button>
                                            }
                                        }
                                        @using (Html.BeginForm("Delete", "Gallery", new { id = item.GalleryItemId }, FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" title="حذف" onclick="return confirm('آیا از حذف این آیتم گالری اطمینان دارید؟')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> هیچ آیتم گالری‌ای یافت نشد.
                </div>
            }
        </div>
    </div>
</div>

