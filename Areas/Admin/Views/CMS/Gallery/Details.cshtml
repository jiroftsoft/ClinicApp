@model ClinicApp.ViewModels.CMS.GalleryItemDetailsViewModel
@{
    ViewBag.Title = "جزئیات آیتم گالری";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">جزئیات آیتم گالری</h1>
        <div>
            <a href="@Url.Action("Edit", new { id = Model.GalleryItemId })" class="btn btn-primary">
                <i class="fas fa-edit"></i> ویرایش
            </a>
            <a href="@Url.Action("Index", new { category = Model.Category })" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> بازگشت به لیست
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">@Model.Title</h6>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-4 text-center">
                            <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded" style="max-height: 600px; width: 100%; object-fit: contain;">
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-3">
                            <h5>توضیحات</h5>
                            <p class="text-muted">@Model.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-left-primary shadow mb-3">
                <div class="card-body">
                    <h6 class="font-weight-bold text-primary mb-3">اطلاعات آیتم</h6>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>شناسه:</strong></td>
                            <td>@Model.GalleryItemId</td>
                        </tr>
                        <tr>
                            <td><strong>دسته‌بندی:</strong></td>
                            <td><span class="badge badge-info">@(Model.Category ?? "clinic")</span></td>
                        </tr>
                        <tr>
                            <td><strong>وضعیت:</strong></td>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge badge-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">غیرفعال</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td><strong>ترتیب نمایش:</strong></td>
                            <td>@Model.DisplayOrder</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="card border-left-secondary shadow">
                <div class="card-body">
                    <h6 class="font-weight-bold text-secondary mb-3">اطلاعات سیستم</h6>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>تاریخ ایجاد:</strong></td>
                            <td>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        </tr>
                        <tr>
                            <td><strong>ایجاد کننده:</strong></td>
                            <td>@Model.CreatedByUserName</td>
                        </tr>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <tr>
                                <td><strong>آخرین ویرایش:</strong></td>
                                <td>@Model.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")</td>
                            </tr>
                            <tr>
                                <td><strong>ویرایش کننده:</strong></td>
                                <td>@(Model.UpdatedByUserName ?? "-")</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

