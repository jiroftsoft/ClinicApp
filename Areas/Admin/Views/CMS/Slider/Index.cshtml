@model List<ClinicApp.ViewModels.CMS.SliderIndexViewModel>
@{
    ViewBag.Title = "مدیریت اسلایدرها";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">مدیریت اسلایدرها</h1>
        <div>
            <a href="@Url.Action("Create", new { position = ViewBag.Position })" class="btn btn-primary">
                <i class="fas fa-plus"></i> اسلایدر جدید
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Filter by Position -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="btn-group" role="group">
                <a href="@Url.Action("Index")" class="btn btn-@(ViewBag.Position == null ? "primary" : "secondary")">همه</a>
                <a href="@Url.Action("Index", new { position = "hero" })" class="btn btn-@(ViewBag.Position == "hero" ? "primary" : "secondary")">Hero</a>
                <a href="@Url.Action("Index", new { position = "sidebar" })" class="btn btn-@(ViewBag.Position == "sidebar" ? "primary" : "secondary")">Sidebar</a>
                <a href="@Url.Action("Index", new { position = "footer" })" class="btn btn-@(ViewBag.Position == "footer" ? "primary" : "secondary")">Footer</a>
            </div>
        </div>
    </div>

    <!-- Sliders List -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">لیست اسلایدرها (@Model.Count مورد)</h6>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>ترتیب</th>
                                <th>تصویر</th>
                                <th>عنوان</th>
                                <th>موقعیت</th>
                                <th>وضعیت</th>
                                <th>تاریخ شروع</th>
                                <th>تاریخ پایان</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderBy(s => s.DisplayOrder))
                            {
                                <tr>
                                    <td>@item.DisplayOrder</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Title" style="width: 100px; height: 60px; object-fit: cover; border-radius: 4px;">
                                        }
                                        else
                                        {
                                            <span class="text-muted">بدون تصویر</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@item.Title</strong>
                                        @if (!string.IsNullOrEmpty(item.Description))
                                        {
                                            <br />
                                            <small class="text-muted">@(item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-info">@(item.Position ?? "hero")</span>
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge badge-success">فعال</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">غیرفعال</span>
                                        }
                                    </td>
                                    <td>@(item.StartDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                    <td>@(item.EndDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Details", new { id = item.SliderId })" class="btn btn-sm btn-info" title="جزئیات">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", new { id = item.SliderId })" class="btn btn-sm btn-primary" title="ویرایش">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            @if (item.IsActive)
                                            {
                                                using (Html.BeginForm("Deactivate", "Slider", new { id = item.SliderId }, FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-warning" title="غیرفعال">
                                                        <i class="fas fa-pause"></i>
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                using (Html.BeginForm("Activate", "Slider", new { id = item.SliderId }, FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success" title="فعال">
                                                        <i class="fas fa-play"></i>
                                                    </button>
                                                }
                                            }
                                            @using (Html.BeginForm("Delete", "Slider", new { id = item.SliderId }, FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger" title="حذف" onclick="return confirm('آیا از حذف این اسلایدر اطمینان دارید؟')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> هیچ اسلایدری یافت نشد.
                </div>
            }
        </div>
    </div>
</div>

