@model ClinicApp.ViewModels.CMS.BlogPostDetailsWithCommentsViewModel
@{
    ViewBag.Title = "جزئیات مقاله";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">جزئیات مقاله</h1>
        <div>
            <a href="@Url.Action("Edit", new { id = Model.BlogPost.BlogPostId })" class="btn btn-primary">
                <i class="fas fa-edit"></i> ویرایش
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> بازگشت به لیست
            </a>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">@Model.BlogPost.Title</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    @if (!string.IsNullOrEmpty(Model.BlogPost.ImageUrl))
                    {
                        <div class="mb-4">
                            <img src="@Model.BlogPost.ImageUrl" alt="@Model.BlogPost.Title" class="img-fluid rounded" style="max-height: 400px; width: 100%; object-fit: cover;">
                        </div>
                    }

                    <div class="mb-3">
                        <h4>خلاصه</h4>
                        <p class="text-muted">@(string.IsNullOrEmpty(Model.BlogPost.Summary) ? "-" : Model.BlogPost.Summary)</p>
                    </div>

                    <div class="mb-3">
                        <h4>محتوا</h4>
                        <div class="border p-3 rounded" style="background-color: #f8f9fa;">
                            @Html.Raw(Model.BlogPost.Content)
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-left-primary shadow mb-3">
                        <div class="card-body">
                            <h6 class="font-weight-bold text-primary mb-3">اطلاعات مقاله</h6>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>شناسه:</strong></td>
                                    <td>@Model.BlogPost.BlogPostId</td>
                                </tr>
                                <tr>
                                    <td><strong>دسته‌بندی:</strong></td>
                                    <td>@(Model.BlogPost.CategoryName ?? "-")</td>
                                </tr>
                                <tr>
                                    <td><strong>نویسنده:</strong></td>
                                    <td>@(Model.BlogPost.AuthorName ?? "-")</td>
                                </tr>
                                <tr>
                                    <td><strong>وضعیت:</strong></td>
                                    <td>
                                        @if (Model.BlogPost.IsPublished)
                                        {
                                            <span class="badge badge-success">منتشر شده</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-warning">منتشر نشده</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>ویژه:</strong></td>
                                    <td>
                                        @if (Model.BlogPost.IsFeatured)
                                        {
                                            <span class="badge badge-info">ویژه</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">عادی</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>تاریخ انتشار:</strong></td>
                                    <td>@(Model.BlogPost.PublishedAt?.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                                </tr>
                                <tr>
                                    <td><strong>بازدید:</strong></td>
                                    <td>@Model.BlogPost.ViewCount</td>
                                </tr>
                                <tr>
                                    <td><strong>ترتیب نمایش:</strong></td>
                                    <td>@(Model.BlogPost.DisplayOrder ?? 0)</td>
                                </tr>
                                <tr>
                                    <td><strong>Slug:</strong></td>
                                    <td>@(Model.BlogPost.Slug ?? "-")</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="card border-left-info shadow mb-3">
                        <div class="card-body">
                            <h6 class="font-weight-bold text-info mb-3">اطلاعات SEO</h6>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>عنوان متا:</strong></td>
                                    <td>@(string.IsNullOrEmpty(Model.BlogPost.MetaTitle) ? "-" : Model.BlogPost.MetaTitle)</td>
                                </tr>
                                <tr>
                                    <td><strong>توضیحات متا:</strong></td>
                                    <td>@(string.IsNullOrEmpty(Model.BlogPost.MetaDescription) ? "-" : Model.BlogPost.MetaDescription)</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="card border-left-secondary shadow">
                        <div class="card-body">
                            <h6 class="font-weight-bold text-secondary mb-3">اطلاعات سیستم</h6>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>تاریخ ایجاد:</strong></td>
                                    <td>@Model.BlogPost.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                </tr>
                                <tr>
                                    <td><strong>ایجاد کننده:</strong></td>
                                    <td>@Model.BlogPost.CreatedByUserName</td>
                                </tr>
                                @if (Model.BlogPost.UpdatedAt.HasValue)
                                {
                                    <tr>
                                        <td><strong>آخرین ویرایش:</strong></td>
                                        <td>@Model.BlogPost.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")</td>
                                    </tr>
                                    <tr>
                                        <td><strong>ویرایش کننده:</strong></td>
                                        <td>@(Model.BlogPost.UpdatedByUserName ?? "-")</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Comments Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-comments"></i> کامنت‌ها
                        <a href="@Url.Action("Index", "BlogPostComment", new { BlogPostId = Model.BlogPost.BlogPostId })" class="btn btn-sm btn-primary float-left">
                            <i class="fas fa-cog"></i> مدیریت کامنت‌ها
                        </a>
                    </h5>
                </div>
                <div class="card-body">
                    @Html.Partial("~/Areas/Admin/Views/CMS/BlogPostComment/_CommentsList.cshtml", Model.Comments)
                </div>
            </div>
        </div>
    </div>
</div>

