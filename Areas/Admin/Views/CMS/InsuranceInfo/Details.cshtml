@model ClinicApp.ViewModels.CMS.InsuranceInfoDetailsViewModel
@{
    ViewBag.Title = "جزئیات اطلاعات بیمه";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-shield-alt text-primary"></i>
            جزئیات اطلاعات بیمه
        </h1>
        <div>
            <a href="@Url.Action("Edit", new { id = Model.InsuranceInfoId })" class="btn btn-primary">
                <i class="fas fa-edit"></i> ویرایش
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> بازگشت به لیست
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4 @(Model.IsFeatured ? "border-info" : "")">
                <div class="card-header py-3 @(Model.IsFeatured ? "bg-info text-white" : "")">
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(Model.LogoUrl))
                        {
                            <img src="@Model.LogoUrl" alt="@Model.InsuranceName" class="mr-3" style="max-height: 50px;">
                        }
                        <h6 class="m-0 font-weight-bold">
                            @Model.InsuranceName
                            @if (Model.IsFeatured)
                            {
                                <span class="badge badge-light mr-2">ویژه</span>
                            }
                        </h6>
                    </div>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-3">
                            <h5>توضیحات کوتاه</h5>
                            <p class="text-muted">@Model.Description</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.FullDescription))
                    {
                        <div class="mb-3">
                            <h5>توضیحات کامل</h5>
                            <div class="border p-3 rounded" style="background-color: #f8f9fa;">
                                @Html.Raw(Model.FullDescription)
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-left-primary shadow mb-3">
                <div class="card-body">
                    <h6 class="font-weight-bold text-primary mb-3">اطلاعات بیمه</h6>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>شناسه:</strong></td>
                            <td>@Model.InsuranceInfoId</td>
                        </tr>
                        <tr>
                            <td><strong>نوع:</strong></td>
                            <td>
                                <span class="badge badge-info">@(GetTypeDisplayName(Model.InsuranceType))</span>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>درصد پوشش:</strong></td>
                            <td>
                                @if (Model.CoveragePercentage.HasValue)
                                {
                                    <span class="badge badge-success">@Model.CoveragePercentage.Value%</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td><strong>وضعیت:</strong></td>
                            <td>
                                @if (Model.IsActive)
                                {
                                    <span class="badge badge-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">غیرفعال</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td><strong>ویژه:</strong></td>
                            <td>
                                @if (Model.IsFeatured)
                                {
                                    <span class="badge badge-info">ویژه</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">عادی</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td><strong>بازدید:</strong></td>
                            <td>@Model.ViewCount</td>
                        </tr>
                        <tr>
                            <td><strong>ترتیب نمایش:</strong></td>
                            <td>@Model.DisplayOrder</td>
                        </tr>
                        <tr>
                            <td><strong>Slug:</strong></td>
                            <td>@(Model.Slug ?? "-")</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="card border-left-info shadow mb-3">
                <div class="card-body">
                    <h6 class="font-weight-bold text-info mb-3">اطلاعات تماس</h6>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>شماره تماس:</strong></td>
                            <td>@(string.IsNullOrEmpty(Model.ContactPhone) ? "-" : Model.ContactPhone)</td>
                        </tr>
                        <tr>
                            <td><strong>وب‌سایت:</strong></td>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                                {
                                    <a href="@Model.WebsiteUrl" target="_blank">@Model.WebsiteUrl</a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td><strong>آدرس:</strong></td>
                            <td>@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="card border-left-secondary shadow mb-3">
                <div class="card-body">
                    <h6 class="font-weight-bold text-secondary mb-3">اطلاعات SEO</h6>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>عنوان متا:</strong></td>
                            <td>@(string.IsNullOrEmpty(Model.MetaTitle) ? "-" : Model.MetaTitle)</td>
                        </tr>
                        <tr>
                            <td><strong>توضیحات متا:</strong></td>
                            <td>@(string.IsNullOrEmpty(Model.MetaDescription) ? "-" : Model.MetaDescription)</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="card border-left-secondary shadow">
                <div class="card-body">
                    <h6 class="font-weight-bold text-secondary mb-3">اطلاعات سیستم</h6>
                    <table class="table table-sm">
                        <tr>
                            <td><strong>تاریخ ایجاد:</strong></td>
                            <td>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        </tr>
                        <tr>
                            <td><strong>ایجاد کننده:</strong></td>
                            <td>@Model.CreatedByUserName</td>
                        </tr>
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <tr>
                                <td><strong>آخرین ویرایش:</strong></td>
                                <td>@Model.UpdatedAt.Value.ToString("yyyy/MM/dd HH:mm")</td>
                            </tr>
                            <tr>
                                <td><strong>ویرایش کننده:</strong></td>
                                <td>@(Model.UpdatedByUserName ?? "-")</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetTypeDisplayName(string insuranceType)
    {
        return insuranceType switch
        {
            "basic" => "بیمه پایه",
            "supplementary" => "بیمه تکمیلی",
            "private" => "بیمه خصوصی",
            "government" => "بیمه دولتی",
            _ => insuranceType ?? "عمومی"
        };
    }
}

