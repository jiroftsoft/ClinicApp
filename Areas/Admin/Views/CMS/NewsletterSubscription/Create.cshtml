@model ClinicApp.ViewModels.CMS.NewsletterSubscriptionCreateEditViewModel
@using ClinicApp.Models.Enums
@{
    ViewBag.Title = "افزودن اشتراک جدید";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@* ============================================
   Newsletter Subscription Create - Production Ready
   ============================================
   - SRP: فرم ایجاد اشتراک جدید
   - Strongly-Typed: استفاده از ViewModel
   - UI/UX: طراحی ماژولار و کامپوننت محور
   ============================================ *@

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-plus text-primary"></i>
            افزودن اشتراک جدید
        </h1>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> بازگشت به لیست
            </a>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-user-plus"></i> اطلاعات اشتراک
            </h6>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Create", "NewsletterSubscription", FormMethod.Post, new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Email, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "example@email.com", dir = "ltr" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.FullName, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "نام و نام خانوادگی" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.PhoneNumber, new { @class = "control-label" })
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "09123456789" })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Source, new { @class = "control-label" })
                            @Html.DropDownListFor(m => m.Source, 
                                Enum.GetValues(typeof(NewsletterSubscriptionSource))
                                    .Cast<NewsletterSubscriptionSource>()
                                    .Select(e => new SelectListItem
                                    {
                                        Text = e.GetDisplayName(),
                                        Value = ((int)e).ToString(),
                                        Selected = e == Model.Source
                                    }), 
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Source, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            @Html.LabelFor(m => m.SelectedCategories, new { @class = "control-label" })
                            <div class="form-check-group">
                                @foreach (NewsletterCategory category in Enum.GetValues(typeof(NewsletterCategory)))
                                {
                                    <div class="form-check form-check-inline">
                                        <input type="checkbox" 
                                               class="form-check-input" 
                                               name="SelectedCategories" 
                                               value="@((int)category)"
                                               id="category_@((int)category)"
                                               @(Model.SelectedCategories != null && Model.SelectedCategories.Contains(category) ? "checked" : "")>
                                        <label class="form-check-label" for="category_@((int)category)">
                                            @category.GetDisplayName()
                                        </label>
                                    </div>
                                }
                            </div>
                            <small class="form-text text-muted">می‌توانید چند دسته‌بندی را انتخاب کنید</small>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                                @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                            </div>
                            <small class="form-text text-muted">اشتراک‌های غیرفعال در ارسال Campaign ها شرکت نمی‌کنند</small>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> ذخیره
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">
                        <i class="fas fa-times"></i> لغو
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

