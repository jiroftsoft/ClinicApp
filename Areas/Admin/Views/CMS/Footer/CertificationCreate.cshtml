@model ClinicApp.ViewModels.CMS.FooterCertificationCreateEditViewModel
@{
    ViewBag.Title = "افزودن مجوز";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var clinicId = ViewBag.ClinicId as int?;
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-plus text-success"></i> افزودن مجوز</h1>
        <a href="@Url.Action("CertificationIndex", new { clinicId })" class="btn btn-secondary"><i class="fas fa-arrow-right"></i> بازگشت</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @using (Html.BeginForm("CertificationCreate", "Footer", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.Hidden("clinicId", clinicId)

                <div class="form-group">
                    @Html.LabelFor(m => m.Title)
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Description)
                    @Html.TextAreaFor(m => m.Description, 3, 10, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.ImageUrl)
                        @Html.TextBoxFor(m => m.ImageUrl, new { @class = "form-control", placeholder = "/Content/Images/..." })
                        @Html.ValidationMessageFor(m => m.ImageUrl, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-6">
                        @Html.LabelFor(m => m.LinkUrl)
                        @Html.TextBoxFor(m => m.LinkUrl, new { @class = "form-control", placeholder = "https://..." })
                        @Html.ValidationMessageFor(m => m.LinkUrl, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-4">
                        @Html.LabelFor(m => m.LicenseNumber)
                        @Html.TextBoxFor(m => m.LicenseNumber, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.LicenseNumber, "", new { @class = "text-danger" })
                    </div>
                    <div class="form-group col-md-4">
                        @Html.LabelFor(m => m.DisplayOrder)
                        @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control", type = "number", min = "0" })
                    </div>
                    <div class="form-group col-md-4 d-flex align-items-center">
                        <div class="form-check mt-4">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", id = "IsActive" })
                            <label class="form-check-label" for="IsActive">فعال</label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> ذخیره</button>
            }
        </div>
    </div>
</div>

