@model ClinicApp.ViewModels.CMS.NewsletterSettingsEditViewModel
@{
    ViewBag.Title = "تنظیمات ارسال خبرنامه";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    @Html.Partial("~/Areas/Admin/Views/CMS/NewsletterCampaign/_NewsletterCampaignUX.cshtml")
    <style>
        .newsletter-settings-module .form-label { font-weight: 600; color: var(--ncm-text); }
        .newsletter-settings-module .form-control { font-size: 0.9375rem; }
    </style>
}

<div class="container-fluid newsletter-campaign-module newsletter-settings-module">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="page-title mb-1">
                <i class="fas fa-cog text-primary me-2" aria-hidden="true"></i>
                تنظیمات ارسال خبرنامه
            </h1>
            <p class="page-subtitle mb-0">تنظیمات ایمیل (SMTP) و پیامک — ذخیره در پایگاه داده (بدون نیاز به Web.config)</p>
        </div>
        <div>
            <a href="@Url.RouteUrl("Admin_CMS_Default", new { controller = "NewsletterCampaign", action = "Index" })" class="btn btn-secondary">
                <i class="fas fa-arrow-right me-1"></i> بازگشت به کمپین‌ها
            </a>
        </div>
    </div>

    @* پیام موفقیت/خطا با Toaster در _AdminLayout نمایش داده می‌شود (NotificationHelper) *@

    <div class="alert alert-info mb-4" role="alert">
        <i class="fas fa-info-circle me-2"></i>
        <strong>پروداکشن:</strong>
        مقادیر زیر در <strong>پایگاه داده</strong> ذخیره می‌شوند و ارسال ایمیل/پیامک از همین تنظیمات استفاده می‌کند. در صورت خالی بودن، مقدار از Web.config خوانده می‌شود. رمز را خالی بگذارید تا تغییر نکند.
    </div>

    @using (Html.BeginForm("Index", "NewsletterSettings", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header" style="background: linear-gradient(135deg, var(--ncm-primary) 0%, #153a5e 100%); color: #fff;">
                        <h6 class="m-0 font-weight-bold">
                            <i class="fas fa-envelope me-2"></i>تنظیمات ایمیل (SMTP)
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            @Html.LabelFor(m => m.EmailFromAddress, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EmailFromAddress, new { @class = "form-control", placeholder = "noreply@example.com", dir = "ltr" })
                            @Html.ValidationMessageFor(m => m.EmailFromAddress, null, new { @class = "text-danger small" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.EmailNoReplyDisplayName, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EmailNoReplyDisplayName, new { @class = "form-control", placeholder = "مثال: فناوران جنوب - سیستم خودکار" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.EmailSubjectPrefix, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EmailSubjectPrefix, new { @class = "form-control", placeholder = "مثال: [فناوران جنوب] - " })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.EmailBccAddresses, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EmailBccAddresses, new { @class = "form-control", placeholder = "ایمیل‌ها با ; یا , جدا شوند", dir = "ltr" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.EmailSmtpServer, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EmailSmtpServer, new { @class = "form-control", placeholder = "smtp.example.com", dir = "ltr" })
                            @Html.ValidationMessageFor(m => m.EmailSmtpServer, null, new { @class = "text-danger small" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.EmailPort, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EmailPort, new { @class = "form-control", placeholder = "587", dir = "ltr" })
                            @Html.ValidationMessageFor(m => m.EmailPort, null, new { @class = "text-danger small" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.EmailUsername, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.EmailUsername, new { @class = "form-control", dir = "ltr" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.EmailPassword, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.EmailPassword, new { @class = "form-control", placeholder = "خالی = بدون تغییر", autocomplete = "new-password" })
                        </div>
                        <div class="mb-3 form-check">
                            @Html.CheckBoxFor(m => m.EmailEnabled, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.EmailEnabled, new { @class = "form-check-label" })
                        </div>
                        <div class="mb-3 form-check">
                            @Html.CheckBoxFor(m => m.EmailEnableSsl, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.EmailEnableSsl, new { @class = "form-check-label" })
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                @Html.LabelFor(m => m.EmailMaxRetries, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.EmailMaxRetries, new { @class = "form-control", type = "number", min = 1, max = 10 })
                            </div>
                            <div class="col-6 mb-3">
                                @Html.LabelFor(m => m.EmailTimeoutMs, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.EmailTimeoutMs, new { @class = "form-control", type = "number", min = 1000 })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header" style="background: linear-gradient(135deg, #0e7490 0%, #0c5a6e 100%); color: #fff;">
                        <h6 class="m-0 font-weight-bold">
                            <i class="fas fa-sms me-2"></i>تنظیمات پیامک (آسانک)
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            @Html.LabelFor(m => m.SmsUsername, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.SmsUsername, new { @class = "form-control", dir = "ltr" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.SmsPassword, new { @class = "form-label" })
                            @Html.PasswordFor(m => m.SmsPassword, new { @class = "form-control", placeholder = "خالی = بدون تغییر", autocomplete = "new-password" })
                        </div>
                        <div class="mb-3">
                            @Html.LabelFor(m => m.SmsSourceNumber, new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.SmsSourceNumber, new { @class = "form-control", placeholder = "3000...", dir = "ltr" })
                        </div>
                        <div class="mb-3 form-check">
                            @Html.CheckBoxFor(m => m.SmsEnabled, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.SmsEnabled, new { @class = "form-check-label" })
                        </div>
                        <div class="row">
                            <div class="col-6 mb-3">
                                @Html.LabelFor(m => m.SmsTimeoutMs, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.SmsTimeoutMs, new { @class = "form-control", type = "number", min = 1000 })
                            </div>
                            <div class="col-6 mb-3">
                                @Html.LabelFor(m => m.SmsMaxRetries, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.SmsMaxRetries, new { @class = "form-control", type = "number", min = 1, max = 10 })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mb-4">
            <a href="@Url.RouteUrl("Admin_CMS_Default", new { controller = "NewsletterCampaign", action = "Index" })" class="btn btn-secondary">انصراف</a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i> ذخیره تنظیمات
            </button>
        </div>
    }

    <div class="card border-secondary">
        <div class="card-body small text-muted">
            <strong>راهنما:</strong>
            اگر ارسال ایمیل یا پیامک انجام نمی‌شود، «فعال بودن» را بررسی کنید؛ آدرس فرستنده و سرور SMTP را صحیح وارد کنید و در صورت نیاز رمز را دوباره وارد کنید.
        </div>
    </div>
</div>
