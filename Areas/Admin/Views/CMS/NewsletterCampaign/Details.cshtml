@model ClinicApp.ViewModels.CMS.NewsletterCampaignDetailsViewModel
@using ClinicApp.Models.Enums
@using ClinicApp.Helpers
@{
    ViewBag.Title = "جزئیات کمپین";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@* ============================================
   Newsletter Campaign Details - Production Ready
   ============================================
   - SRP: نمایش جزئیات Campaign
   - Strongly-Typed: استفاده از ViewModel
   - UI/UX: طراحی ماژولار و کامپوننت محور
   ============================================ *@

@section Styles {
    @Html.Partial("~/Areas/Admin/Views/CMS/NewsletterCampaign/_NewsletterCampaignUX.cshtml")
    <style>
        .newsletter-campaign-module .details-page-title { font-size: 1.35rem; font-weight: 700; color: var(--ncm-text); line-height: 1.45; margin-bottom: 0.25rem; }
        .newsletter-campaign-module .details-page-subtitle { font-size: 1rem; color: var(--ncm-text-muted); line-height: 1.5; }
        .newsletter-campaign-module .details-card .card-header { font-weight: 600; font-size: 1rem; color: var(--ncm-text); }
        .newsletter-campaign-module .details-card .card-body dl { font-size: 1rem; line-height: 1.7; }
        .newsletter-campaign-module .details-card dt { font-weight: 600; color: var(--ncm-text); margin-bottom: 0.25rem; }
        .newsletter-campaign-module .details-card dd { color: var(--ncm-text); margin-bottom: 0.85rem; }
        .newsletter-campaign-module .details-card dd:last-child { margin-bottom: 0; }
        .newsletter-campaign-module .details-value-title { font-size: 1.05rem; font-weight: 700; color: var(--ncm-primary); }
        .newsletter-campaign-module .details-value-text { font-size: 1rem; color: var(--ncm-text); }
        .newsletter-campaign-module .details-value-template { font-size: 1rem; font-weight: 600; color: #0f172a; background: #e0e7ff; padding: 0.4rem 0.75rem; border-radius: 6px; border: 1px solid #a5b4fc; display: inline-block; }
        .newsletter-campaign-module .details-categories { font-size: 0.9375rem; font-weight: 500; color: var(--ncm-text); padding: 0.5rem 0.75rem; background: var(--ncm-bg-subtle); border: 1px solid var(--ncm-border); border-radius: 6px; line-height: 1.6; }
        .newsletter-campaign-module .stat-item { text-align: center; padding: 0.5rem; }
        .newsletter-campaign-module .stat-value { font-size: 1.5rem; font-weight: 700; color: var(--ncm-primary); }
        .newsletter-campaign-module .stat-label { font-size: 0.875rem; font-weight: 500; color: var(--ncm-text-muted); }
        .newsletter-campaign-module .campaign-content-preview { border: 1px solid var(--ncm-border); padding: 1.25rem; border-radius: 8px; background: var(--ncm-bg-subtle); direction: rtl; text-align: right; font-size: 1rem; line-height: 1.75; color: var(--ncm-text); }
        .newsletter-campaign-module .badge-status-sending { background: linear-gradient(135deg, #c2410c 0%, #ea580c 100%) !important; color: #fff !important; font-weight: 700; font-size: 0.9375rem; padding: 0.5rem 1rem; border: 1px solid #b43a0a; box-shadow: 0 1px 3px rgba(194, 65, 12, 0.35); animation: ncm-pulse-sending 1.8s ease-in-out infinite; }
        .newsletter-campaign-module .badge-status-sending .fa-paper-plane { animation: ncm-icon-sending 0.6s ease-in-out infinite; }
        @@keyframes ncm-pulse-sending { 0%, 100% { opacity: 1; } 50% { opacity: 0.92; } }
        @@keyframes ncm-icon-sending { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(-2px); } }
    </style>
}

<div class="container-fluid newsletter-campaign-module">
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
        <div class="flex-grow-1">
            <h1 class="page-title mb-1">
                <i class="fas fa-eye text-primary me-2" aria-hidden="true"></i>جزئیات کمپین
            </h1>
            <p class="details-page-title mb-0">@Model.Title</p>
            <p class="details-page-subtitle mb-0 mt-1">@Model.Subject</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.Status == NewsletterCampaignStatus.Draft || Model.Status == NewsletterCampaignStatus.Scheduled)
            {
                <a href="@Url.Action("Send", new { id = Model.NewsletterCampaignId })" class="btn btn-success">
                    <i class="fas fa-paper-plane"></i> ارسال
                </a>
                <a href="@Url.Action("Edit", new { id = Model.NewsletterCampaignId })" class="btn btn-warning">
                    <i class="fas fa-edit"></i> ویرایش
                </a>
            }
            @if (Model.CanRetry)
            {
                using (Html.BeginForm("RetrySend", "NewsletterCampaign", new { area = "Admin", id = Model.NewsletterCampaignId }, FormMethod.Post, new { @class = "d-inline", role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-warning" aria-label="ارسال مجدد">
                        <i class="fas fa-redo me-1"></i> ارسال مجدد
                    </button>
                }
            }
            <a href="@Url.Action("Statistics", new { id = Model.NewsletterCampaignId })" class="btn btn-info">
                <i class="fas fa-chart-bar"></i> آمار
            </a>
            <a href="@Url.Action("Index")" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> بازگشت به لیست
            </a>
        </div>
    </div>

    @if (Model.Status == NewsletterCampaignStatus.Sending && Model.CanRetry)
    {
        <div class="alert alert-info mb-4 d-flex align-items-start" role="alert">
            <i class="fas fa-info-circle mt-1 me-2" aria-hidden="true"></i>
            <div>
                <strong>ارسال در پس‌زمینه انجام می‌شود.</strong>
                @if (Model.PendingCount > 0)
                {
                    <span>@Model.PendingCount نفر در صف ارسال هستند.</span>
                }
                اگر پس از چند دقیقه وضعیت عوض نشد، دکمه <strong>«ارسال مجدد»</strong> را بزنید یا تنظیمات ایمیل/سرور (Web.config) را بررسی کنید.
            </div>
        </div>
    }

    @if (Model.SendErrors != null && Model.SendErrors.Any())
    {
        <div class="card border-danger mb-4 details-card">
            <div class="card-header bg-danger text-white py-2">
                <i class="fas fa-exclamation-triangle me-2"></i>خطاهای ارسال — برای مدیر
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">برای گیرندگانی که ارسال ناموفق بوده، دلیل خطا در جدول زیر نمایش داده شده است. پس از رفع مشکل (مثلاً تنظیم SMTP یا اصلاح ایمیل مشترک) می‌توانید «ارسال مجدد» را بزنید.</p>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th scope="col">ایمیل گیرنده</th>
                                <th scope="col">دلیل خطا</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var err in Model.SendErrors)
                            {
                                <tr>
                                    <td class="font-weight-bold">@err.RecipientEmail</td>
                                    <td class="text-danger">@err.ErrorMessage</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <!-- Campaign Information -->
            <div class="card shadow mb-4 details-card">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold">
                        <i class="fas fa-info-circle text-primary me-2"></i>اطلاعات کمپین
                    </h6>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">عنوان</dt>
                        <dd class="col-sm-8 details-value-title">@Model.Title</dd>

                        <dt class="col-sm-4">موضوع ایمیل</dt>
                        <dd class="col-sm-8 details-value-text">@Model.Subject</dd>

                        @if (Model.NewsletterTemplateId.HasValue)
                        {
                            <dt class="col-sm-4">قالب</dt>
                            <dd class="col-sm-8">
                                <span class="details-value-template">@Model.TemplateName</span>
                            </dd>
                        }

                        <dt class="col-sm-4">ارسال به</dt>
                        <dd class="col-sm-8">
                            @if (Model.SendToAll)
                            {
                                <span class="badge badge-success">تمام مشترکین فعال</span>
                            }
                            else
                            {
                                <span class="details-categories d-inline-block">@Model.CategoriesDisplay</span>
                            }
                        </dd>

                        <dt class="col-sm-4">وضعیت</dt>
                        <dd class="col-sm-8">
                            @{
                                var statusClass = "badge-secondary";
                                var statusIcon = "fa-circle";
                                if (Model.Status == NewsletterCampaignStatus.Draft)
                                {
                                    statusClass = "badge-secondary";
                                    statusIcon = "fa-file-alt";
                                }
                                else if (Model.Status == NewsletterCampaignStatus.Scheduled)
                                {
                                    statusClass = "badge-info";
                                    statusIcon = "fa-clock";
                                }
                                else if (Model.Status == NewsletterCampaignStatus.Sending)
                                {
                                    statusClass = "badge-status-sending";
                                    statusIcon = "fa-paper-plane";
                                }
                                else if (Model.Status == NewsletterCampaignStatus.Sent)
                                {
                                    statusClass = "badge-success";
                                    statusIcon = "fa-check-circle";
                                }
                                else if (Model.Status == NewsletterCampaignStatus.Failed)
                                {
                                    statusClass = "badge-danger";
                                    statusIcon = "fa-exclamation-circle";
                                }
                            }
                            <span class="badge @statusClass" role="status">
                                <i class="fas @statusIcon me-1"></i>@Model.StatusDisplay
                            </span>
                        </dd>

                        @if (Model.ScheduledAt.HasValue)
                        {
                            <dt class="col-sm-4">زمان‌بندی شده برای</dt>
                            <dd class="col-sm-8 details-value-text">@PersianDateHelper.ToPersianDate(Model.ScheduledAt.Value)</dd>
                        }

                        @if (Model.SentAt.HasValue)
                        {
                            <dt class="col-sm-4">ارسال شده در</dt>
                            <dd class="col-sm-8 details-value-text">@PersianDateHelper.ToPersianDate(Model.SentAt.Value)</dd>
                        }

                        <dt class="col-sm-4">تاریخ ایجاد</dt>
                        <dd class="col-sm-8 details-value-text">@PersianDateHelper.ToPersianDate(Model.CreatedAt)</dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm mb-4 details-card">
                <div class="card-header">
                    <span class="section-header mb-0"><i class="fas fa-code text-primary me-2" aria-hidden="true"></i>محتوای کمپین</span>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.Content))
                    {
                        <div class="campaign-content-preview">
                            @Html.Raw(Model.Content)
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">بدون محتوا</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm mb-4 details-card">
                <div class="card-header" style="background: linear-gradient(135deg, var(--ncm-primary) 0%, #153a5e 100%); color: #fff;">
                    <span class="section-header mb-0" style="color: #fff;"><i class="fas fa-chart-bar me-2" aria-hidden="true"></i>آمار کمپین</span>
                </div>
                <div class="card-body">
                    <div class="stat-item mb-3">
                        <div class="stat-value">@Model.TotalRecipients</div>
                        <div class="stat-label">کل گیرندگان</div>
                    </div>
                    <div class="stat-item mb-3">
                        <div class="stat-value text-success">@Model.SentCount</div>
                        <div class="stat-label">ارسال شده</div>
                    </div>
                    <div class="stat-item mb-3">
                        <div class="stat-value text-danger">@Model.FailedCount</div>
                        <div class="stat-label">ناموفق</div>
                    </div>
                    <div class="stat-item mb-3">
                        <div class="stat-value text-info">@Model.OpenedCount</div>
                        <div class="stat-label">باز شده</div>
                    </div>
                    <div class="stat-item mb-3">
                        <div class="stat-value text-warning">@Model.ClickedCount</div>
                        <div class="stat-label">کلیک شده</div>
                    </div>
                    <hr>
                    <div class="stat-item mb-3">
                        <div class="stat-value">@Model.OpenRate.ToString("F2")%</div>
                        <div class="stat-label">نرخ باز شدن</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">@Model.ClickRate.ToString("F2")%</div>
                        <div class="stat-label">نرخ کلیک</div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4 details-card">
                <div class="card-header">
                    <span class="section-header mb-0"><i class="fas fa-cog text-primary me-2" aria-hidden="true"></i>اطلاعات سیستم</span>
                </div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt>ایجاد شده توسط</dt>
                        <dd class="details-value-text">@(Model.CreatedByUserName ?? "سیستم")</dd>

                        @if (Model.UpdatedAt.HasValue)
                        {
                            <dt>آخرین به‌روزرسانی</dt>
                            <dd class="details-value-text">@PersianDateHelper.ToPersianDate(Model.UpdatedAt.Value)</dd>
                            <dt>به‌روزرسانی شده توسط</dt>
                            <dd class="details-value-text">@(Model.UpdatedByUserName ?? "-")</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

