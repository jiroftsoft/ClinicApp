@model ClinicApp.ViewModels.CMS.NewsletterCampaignIndexPageViewModel
@using ClinicApp.Models.Enums
@using ClinicApp.Helpers
@{
    ViewBag.Title = "مدیریت کمپین‌های خبرنامه";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@Html.AntiForgeryToken()

@section Styles {
    @Html.Partial("~/Areas/Admin/Views/CMS/NewsletterCampaign/_NewsletterCampaignUX.cshtml")
    <style>
        /* دکمه جستجو — اندازه و خوانایی */
        .newsletter-campaign-module .btn-search-filter {
            min-width: 7rem;
            padding: 0.6rem 1.25rem;
            font-size: 1rem;
            font-weight: 600;
        }
        /* جدول کمپین — بدون اسکرول، تمام ستون‌ها در عرض صفحه */
        .newsletter-campaign-module #campaignsTable {
            font-size: 0.875rem;
            border-collapse: collapse;
            table-layout: fixed;
            width: 100%;
        }
        .newsletter-campaign-module #campaignsTable thead th {
            background: var(--ncm-primary);
            color: #fff !important;
            font-weight: 600;
            font-size: 0.75rem;
            padding: 0.5rem 0.4rem;
            border: none;
            white-space: nowrap;
            vertical-align: middle;
        }
        .newsletter-campaign-module #campaignsTable thead th:first-child { border-radius: var(--ncm-radius) 0 0 0; }
        .newsletter-campaign-module #campaignsTable thead th:last-child { border-radius: 0 var(--ncm-radius) 0 0; }
        .newsletter-campaign-module #campaignsTable tbody tr {
            transition: background-color 0.12s ease;
            background-color: var(--ncm-bg-table);
        }
        .newsletter-campaign-module #campaignsTable tbody tr:nth-child(even) {
            background-color: var(--ncm-bg-table-alt);
        }
        .newsletter-campaign-module #campaignsTable tbody tr:hover {
            background-color: var(--ncm-bg-table-hover) !important;
        }
        .newsletter-campaign-module #campaignsTable tbody td {
            padding: 0.5rem 0.4rem;
            border-bottom: 1px solid var(--ncm-border);
            vertical-align: middle !important;
        }
        /* ستون‌ها با عرض درصدی — بدون اسکرول */
        .newsletter-campaign-module #campaignsTable th.col-title,
        .newsletter-campaign-module #campaignsTable .cell-title { width: 14%; }
        .newsletter-campaign-module #campaignsTable th.col-subject,
        .newsletter-campaign-module #campaignsTable .cell-subject { width: 12%; }
        .newsletter-campaign-module #campaignsTable th.col-status,
        .newsletter-campaign-module #campaignsTable .cell-status { width: 10%; }
        .newsletter-campaign-module #campaignsTable th.col-num,
        .newsletter-campaign-module #campaignsTable .cell-num { width: 5%; }
        .newsletter-campaign-module #campaignsTable th.col-rate,
        .newsletter-campaign-module #campaignsTable .cell-rate { width: 5%; }
        .newsletter-campaign-module #campaignsTable th.col-date,
        .newsletter-campaign-module #campaignsTable .cell-date { width: 8%; }
        .newsletter-campaign-module #campaignsTable th.col-actions,
        .newsletter-campaign-module #campaignsTable .cell-actions {
            width: 22%;
            text-align: center;
            vertical-align: middle;
            border-inline-start: 1px solid var(--ncm-border);
        }
        .newsletter-campaign-module #campaignsTable .cell-title {
            font-weight: 600;
            color: var(--ncm-text);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 100%;
        }
        .newsletter-campaign-module #campaignsTable .cell-subject {
            color: var(--ncm-text-muted);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 100%;
        }
        .newsletter-campaign-module #campaignsTable .cell-num {
            text-align: center;
            font-variant-numeric: tabular-nums;
            font-weight: 500;
        }
        .newsletter-campaign-module #campaignsTable .cell-rate {
            text-align: center;
            font-variant-numeric: tabular-nums;
            font-weight: 600;
            color: var(--ncm-primary);
        }
        .newsletter-campaign-module #campaignsTable .cell-date {
            font-variant-numeric: tabular-nums;
            color: var(--ncm-text-muted);
            white-space: nowrap;
            font-size: 0.875rem;
        }
        .newsletter-campaign-module #campaignsTable .cell-actions .actions-wrap {
            display: inline-flex;
            flex-wrap: wrap;
            gap: 0.25rem;
            justify-content: center;
            align-items: center;
        }
        .newsletter-campaign-module #campaignsTable .cell-actions .btn-action {
            padding: 0.3rem 0.4rem;
            font-size: 0.75rem;
            min-width: auto;
            border-width: 1px;
            font-weight: 500;
        }
        .newsletter-campaign-module #campaignsTable .cell-actions .btn-action .fa {
            margin-inline-end: 0.15rem;
        }
        .newsletter-campaign-module #campaignsTable .cell-actions .btn-action span {
            font-size: 0.7rem;
        }
        .newsletter-campaign-module .table-responsive {
            border: 1px solid var(--ncm-border);
            border-radius: var(--ncm-radius);
            overflow: visible;
            background: var(--ncm-bg);
        }
        .newsletter-campaign-module .card-body {
            overflow-x: visible;
        }
        /* وضعیت «در حال ارسال» — کاملاً مشخص و خوانا */
        .newsletter-campaign-module .badge-status-sending {
            background: linear-gradient(135deg, #c2410c 0%, #ea580c 100%) !important;
            color: #fff !important;
            font-weight: 700;
            font-size: 0.875rem;
            padding: 0.45rem 0.85rem;
            border: 1px solid #b43a0a;
            box-shadow: 0 1px 3px rgba(194, 65, 12, 0.35);
            animation: ncm-pulse-sending 1.8s ease-in-out infinite;
        }
        .newsletter-campaign-module .badge-status-sending .fa-paper-plane {
            animation: ncm-icon-sending 0.6s ease-in-out infinite;
        }
        @@keyframes ncm-pulse-sending {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.92; }
        }
        @@keyframes ncm-icon-sending {
            0%, 100% { transform: translateX(0); }
            50% { transform: translateX(-2px); }
        }
    </style>
}

<div class="container-fluid newsletter-campaign-module">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="page-title mb-1">
                <i class="fas fa-paper-plane text-primary me-2" aria-hidden="true"></i>
                مدیریت کمپین‌های خبرنامه
            </h1>
            <p class="page-subtitle mb-0">مناسب برای واحد تبلیغات و فروش — ایجاد، زمان‌بندی و ارسال کمپین به مشترکین</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.RouteUrl("Admin_CMS_Default", new { controller = "NewsletterSettings", action = "Index" })" class="btn btn-outline-secondary" title="مشاهده تنظیمات ایمیل و پیامک">
                <i class="fas fa-cog me-1"></i> تنظیمات ارسال
            </a>
            <a href="@Url.Action("Create")" class="btn btn-primary" role="button">
                <i class="fas fa-plus me-1"></i> کمپین جدید
            </a>
        </div>
    </div>

    <!-- فیلتر و جستجو -->
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex align-items-center">
            <i class="fas fa-filter text-primary me-2" aria-hidden="true"></i>
            <span>فیلتر و جستجو</span>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Index", "NewsletterCampaign", FormMethod.Get, new { @class = "form-horizontal" }))
            {
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">جستجو</label>
                        <input type="text" name="SearchTerm" class="form-control" placeholder="عنوان یا موضوع کمپین..." value="@(Model.SearchModel?.SearchTerm ?? "")" aria-label="جستجو">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">وضعیت</label>
                        <select name="Status" class="form-control form-select" aria-label="وضعیت کمپین">
                            <option value="">همه وضعیت‌ها</option>
                            <option value="1" @(Model.SearchModel?.Status == NewsletterCampaignStatus.Draft ? "selected" : "")>پیش‌نویس</option>
                            <option value="2" @(Model.SearchModel?.Status == NewsletterCampaignStatus.Scheduled ? "selected" : "")>زمان‌بندی شده</option>
                            <option value="3" @(Model.SearchModel?.Status == NewsletterCampaignStatus.Sending ? "selected" : "")>در حال ارسال</option>
                            <option value="4" @(Model.SearchModel?.Status == NewsletterCampaignStatus.Sent ? "selected" : "")>ارسال شده</option>
                            <option value="5" @(Model.SearchModel?.Status == NewsletterCampaignStatus.Failed ? "selected" : "")>ناموفق</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">از تاریخ</label>
                            @{
                                ViewBag.PersianDatePickerId = "fromDatePicker";
                                ViewBag.PersianDatePickerName = "FromDate";
                                ViewBag.PersianDatePickerValue = Model.SearchModel?.FromDate;
                                ViewBag.PersianDatePickerLabel = "";
                                ViewBag.PersianDatePickerPlaceholder = "از تاریخ";
                                ViewBag.PersianDatePickerHelpText = "";
                                ViewBag.PersianDatePickerRequired = false;
                                ViewBag.PersianDatePickerCssClass = "form-control";
                            }
                            @Html.Partial("_PersianDatePicker")
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">تا تاریخ</label>
                            @{
                                ViewBag.PersianDatePickerId = "toDatePicker";
                                ViewBag.PersianDatePickerName = "ToDate";
                                ViewBag.PersianDatePickerValue = Model.SearchModel?.ToDate;
                                ViewBag.PersianDatePickerLabel = "";
                                ViewBag.PersianDatePickerPlaceholder = "تا تاریخ";
                                ViewBag.PersianDatePickerHelpText = "";
                                ViewBag.PersianDatePickerRequired = false;
                                ViewBag.PersianDatePickerCssClass = "form-control";
                            }
                            @Html.Partial("_PersianDatePicker")
                    </div>
                    <div class="col-md-3 col-lg-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary btn-search-filter w-100" aria-label="اعمال فیلتر">
                            <i class="fas fa-search me-2"></i> جستجو
                        </button>
                    </div>
                </div>
                @Html.HiddenFor(m => m.SearchModel.PageNumber)
                @Html.HiddenFor(m => m.SearchModel.PageSize)
            }
        </div>
    </div>

    <!-- لیست کمپین‌ها -->
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span class="section-header mb-0">
                <i class="fas fa-list text-primary me-2" aria-hidden="true"></i>
                لیست کمپین‌ها
            </span>
            <span class="badge bg-primary rounded-pill">@Model.Campaigns.TotalCount</span>
        </div>
        <div class="card-body">
            @if (Model.Campaigns.Items != null && Model.Campaigns.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle" id="campaignsTable" role="grid" aria-label="لیست کمپین‌های خبرنامه">
                        <thead>
                            <tr>
                                <th scope="col" class="col-title">عنوان</th>
                                <th scope="col" class="col-subject">موضوع</th>
                                <th scope="col" class="col-status text-center">وضعیت</th>
                                <th scope="col" class="col-num text-center" title="گیرندگان">گیرنده</th>
                                <th scope="col" class="col-num text-center" title="ارسال‌شده">ارسال</th>
                                <th scope="col" class="col-num text-center" title="بازشده">باز</th>
                                <th scope="col" class="col-num text-center" title="کلیک‌شده">کلیک</th>
                                <th scope="col" class="col-rate text-center" title="نرخ باز شدن">باز%</th>
                                <th scope="col" class="col-rate text-center" title="نرخ کلیک">کلیک%</th>
                                <th scope="col" class="col-date" title="تاریخ ایجاد">تاریخ</th>
                                <th scope="col" class="col-actions text-center">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Campaigns.Items)
                            {
                                <tr>
                                    <td class="cell-title" title="@item.Title">@item.Title</td>
                                    <td class="cell-subject" title="@item.Subject">@item.Subject</td>
                                    <td class="cell-status">
                                        @{
                                            var statusClass = "badge-secondary";
                                            var statusIcon = "fa-circle";
                                            if (item.Status == NewsletterCampaignStatus.Draft)
                                            {
                                                statusClass = "badge-secondary";
                                                statusIcon = "fa-file-alt";
                                            }
                                            else if (item.Status == NewsletterCampaignStatus.Scheduled)
                                            {
                                                statusClass = "badge-info";
                                                statusIcon = "fa-clock";
                                            }
                                            else if (item.Status == NewsletterCampaignStatus.Sending)
                                            {
                                                statusClass = "badge-status-sending";
                                                statusIcon = "fa-paper-plane";
                                            }
                                            else if (item.Status == NewsletterCampaignStatus.Sent)
                                            {
                                                statusClass = "badge-success";
                                                statusIcon = "fa-check-circle";
                                            }
                                            else if (item.Status == NewsletterCampaignStatus.Failed)
                                            {
                                                statusClass = "badge-danger";
                                                statusIcon = "fa-exclamation-circle";
                                            }
                                        }
                                        <span class="badge @statusClass" role="status" aria-live="polite">
                                            <i class="fas @statusIcon me-1" aria-hidden="true"></i>@item.StatusDisplay
                                        </span>
                                    </td>
                                    <td class="cell-num">@item.TotalRecipients</td>
                                    <td class="cell-num">@item.SentCount</td>
                                    <td class="cell-num">@item.OpenedCount</td>
                                    <td class="cell-num">@item.ClickedCount</td>
                                    <td class="cell-rate">@item.OpenRate.ToString("F2")%</td>
                                    <td class="cell-rate">@item.ClickRate.ToString("F2")%</td>
                                    <td class="cell-date">@PersianDateHelper.ToPersianDate(item.CreatedAt)</td>
                                    <td class="cell-actions">
                                        <div class="actions-wrap" role="group" aria-label="عملیات کمپین">
                                            <a href="@Url.Action("Details", new { id = item.NewsletterCampaignId })" class="btn btn-outline-primary btn-action" title="@(item.Status == NewsletterCampaignStatus.Sending || item.Status == NewsletterCampaignStatus.Failed ? "جزئیات، مشاهده خطا و ارسال مجدد" : "جزئیات")"><i class="fas fa-eye" aria-hidden="true"></i><span>جزئیات</span></a>
                                            @if (item.Status == NewsletterCampaignStatus.Draft || item.Status == NewsletterCampaignStatus.Scheduled || item.Status == NewsletterCampaignStatus.Failed)
                                            {
                                                <a href="@Url.Action("Edit", new { id = item.NewsletterCampaignId })" class="btn btn-outline-warning btn-action" title="ویرایش"><i class="fas fa-edit" aria-hidden="true"></i><span>ویرایش</span></a>
                                                <a href="@Url.Action("Send", new { id = item.NewsletterCampaignId })" class="btn btn-outline-success btn-action" title="@(item.Status == NewsletterCampaignStatus.Failed ? "ارسال مجدد" : "ارسال")"><i class="fas fa-paper-plane" aria-hidden="true"></i><span>@(item.Status == NewsletterCampaignStatus.Failed ? "ارسال مجدد" : "ارسال")</span></a>
                                            }
                                            @if (item.Status == NewsletterCampaignStatus.Scheduled)
                                            {
                                                <button type="button" class="btn btn-outline-secondary btn-action" onclick="cancelSchedule(@item.NewsletterCampaignId)" title="لغو زمان‌بندی"><i class="fas fa-ban" aria-hidden="true"></i><span>لغو</span></button>
                                            }
                                            <a href="@Url.Action("Statistics", new { id = item.NewsletterCampaignId })" class="btn btn-outline-info btn-action" title="آمار"><i class="fas fa-chart-bar" aria-hidden="true"></i><span>آمار</span></a>
                                            @if (item.Status != NewsletterCampaignStatus.Sending)
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-action" onclick="deleteCampaign(@item.NewsletterCampaignId)" title="حذف"><i class="fas fa-trash" aria-hidden="true"></i><span>حذف</span></button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                if (Model.Campaigns.TotalPages > 1)
                {
                    <nav aria-label="صفحه‌بندی">
                        <ul class="pagination justify-content-center">
                            @if (Model.Campaigns.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="javascript:void(0);" onclick="goToPage(@(Model.Campaigns.PageNumber - 1))">
                                        <i class="fas fa-chevron-right"></i> قبلی
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link"><i class="fas fa-chevron-right"></i> قبلی</span>
                                </li>
                            }

                            @for (int i = 1; i <= Model.Campaigns.TotalPages; i++)
                            {
                                if (i == Model.Campaigns.PageNumber)
                                {
                                    <li class="page-item active">
                                        <span class="page-link">@i</span>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="javascript:void(0);" onclick="goToPage(@i)">@i</a>
                                    </li>
                                }
                            }

                            @if (Model.Campaigns.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="javascript:void(0);" onclick="goToPage(@(Model.Campaigns.PageNumber + 1))">
                                        بعدی <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">بعدی <i class="fas fa-chevron-left"></i></span>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="alert alert-info d-flex align-items-center mb-0" role="alert">
                    <i class="fas fa-info-circle me-2" aria-hidden="true"></i>
                    <span>هیچ کمپینی یافت نشد. با دکمه «کمپین جدید» اولین کمپین را ایجاد کنید.</span>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_PersianDatePickerScript")
    <script>
        // تابع برای رفتن به صفحه با حفظ فیلترها
        function goToPage(pageNumber) {
            var form = $('<form></form>');
            form.attr('method', 'GET');
            form.attr('action', '@Url.Action("Index")');
            
            // اضافه کردن فیلترهای جستجو
            var searchTerm = $('input[name="SearchTerm"]').val();
            if (searchTerm) {
                form.append($('<input>').attr('type', 'hidden').attr('name', 'SearchTerm').val(searchTerm));
            }
            
            var status = $('select[name="Status"]').val();
            if (status) {
                form.append($('<input>').attr('type', 'hidden').attr('name', 'Status').val(status));
            }
            
            // اضافه کردن تاریخ‌ها از hidden inputs
            var fromDateHidden = $('input[name="FromDate_Hidden"]').val();
            if (fromDateHidden) {
                form.append($('<input>').attr('type', 'hidden').attr('name', 'FromDate_Hidden').val(fromDateHidden));
            }
            
            var toDateHidden = $('input[name="ToDate_Hidden"]').val();
            if (toDateHidden) {
                form.append($('<input>').attr('type', 'hidden').attr('name', 'ToDate_Hidden').val(toDateHidden));
            }
            
            form.append($('<input>').attr('type', 'hidden').attr('name', 'PageNumber').val(pageNumber));
            form.append($('<input>').attr('type', 'hidden').attr('name', 'PageSize').val('@Model.Campaigns.PageSize'));
            
            $('body').append(form);
            form.submit();
        }

        function cancelSchedule(id) {
            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: 'زمان‌بندی این Campaign لغو خواهد شد',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ffc107',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'بله، لغو کن',
                cancelButtonText: 'انصراف'
            }).then((result) => {
                if (result.isConfirmed) {
                    var form = $('<form></form>');
                    form.attr('method', 'POST');
                    form.attr('action', '@Url.Action("CancelSchedule")');
                    form.append($('<input>').attr('type', 'hidden').attr('name', 'id').val(id));
                    form.append($('@Html.AntiForgeryToken()'));
                    $('body').append(form);
                    form.submit();
                }
            });
        }

        function deleteCampaign(id) {
            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: 'این Campaign حذف خواهد شد',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'بله، حذف کن',
                cancelButtonText: 'لغو'
            }).then((result) => {
                if (result.isConfirmed) {
                    var form = $('<form></form>');
                    form.attr('method', 'POST');
                    form.attr('action', '@Url.Action("Delete")');
                    form.append($('<input>').attr('type', 'hidden').attr('name', 'id').val(id));
                    form.append($('@Html.AntiForgeryToken()'));
                    $('body').append(form);
                    form.submit();
                }
            });
        }
    </script>
}

