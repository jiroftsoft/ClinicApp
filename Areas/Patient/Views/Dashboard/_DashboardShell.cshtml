@model ClinicApp.ViewModels.Patient.DashboardViewModel
@{
    Layout = null; // ✅ Partial View - No Layout
}

<!-- ✅ Dashboard Shell - Component-Based Architecture -->
<div id="patientDashboard" class="dashboard-container">
    
    <!-- ✅ Header Section -->
    <section class="dashboard-header">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-12 col-md-8">
                    <h1 class="dashboard-title">
                        <i class="fas fa-tachometer-alt ml-2"></i>
                        داشبورد من
                    </h1>
                    <p class="dashboard-subtitle text-muted">
                        مشاهده و مدیریت اطلاعات پزشکی شما
                    </p>
                </div>
                <div class="col-12 col-md-4 text-left text-md-right mt-3 mt-md-0">
                    <a href="@Url.Action("Available", "Appointment", new { area = "Patient" })" 
                       class="btn btn-primary btn-sm" data-ajax="true">
                        <i class="fas fa-calendar-plus ml-1"></i>
                        رزرو نوبت جدید
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ✅ Quick Stats Section (AJAX Loaded) -->
    <section class="dashboard-stats-section">
        <div class="container-fluid">
            <div id="quickStatsContainer" class="row" data-dashboard-section="quickStats">
                <!-- ✅ Loading State -->
                <div class="col-12">
                    <div class="dashboard-loading">
                        @Html.Partial("~/Areas/Patient/Views/Shared/_ShafaBrandLoading.cshtml")
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ✅ Main Content Sections -->
    <section class="dashboard-content-section">
        <div class="container-fluid">
            <div class="row">
                
                <!-- ✅ Recent Appointments Section (AJAX Loaded) -->
                <div class="col-12 col-lg-6 mb-4">
                    <div class="dashboard-card" data-dashboard-section="recentAppointments">
                        <div class="dashboard-card-header">
                            <h3 class="dashboard-card-title">
                                <i class="fas fa-calendar-check ml-2"></i>
                                نوبت‌های اخیر
                            </h3>
                            <a href="@Url.Action("MyAppointments", "Appointment", new { area = "Patient" })" 
                               class="btn btn-link btn-sm" data-ajax="true">
                                مشاهده همه
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </div>
                        <div class="dashboard-card-body">
                            <!-- ✅ Loading State -->
                            <div class="dashboard-section-loading">
                                @Html.Partial("~/Areas/Patient/Views/Shared/_ShafaBrandLoading.cshtml")
                            </div>
                            <!-- ✅ Content will be loaded via AJAX -->
                            <div class="dashboard-section-content" style="display: none;"></div>
                            <!-- ✅ Empty State -->
                            <div class="dashboard-section-empty" style="display: none;">
                                <p class="text-muted text-center py-4">
                                    <i class="fas fa-calendar-times fa-2x mb-2"></i>
                                    <br>
                                    هیچ نوبتی یافت نشد
                                </p>
                            </div>
                            <!-- ✅ Error State -->
                            <div class="dashboard-section-error" style="display: none;">
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-circle ml-1"></i>
                                    <span class="error-message">خطا در بارگذاری</span>
                                    <button class="btn btn-sm btn-outline-danger mt-2" onclick="PatientDashboard.reloadSection('recentAppointments')">
                                        تلاش مجدد
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ✅ Upcoming Appointments Section (AJAX Loaded) -->
                <div class="col-12 col-lg-6 mb-4">
                    <div class="dashboard-card" data-dashboard-section="upcomingAppointments">
                        <div class="dashboard-card-header">
                            <h3 class="dashboard-card-title">
                                <i class="fas fa-calendar-alt ml-2"></i>
                                نوبت‌های آینده
                            </h3>
                            <a href="@Url.Action("MyAppointments", "Appointment", new { area = "Patient" })" 
                               class="btn btn-link btn-sm" data-ajax="true">
                                مشاهده همه
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </div>
                        <div class="dashboard-card-body">
                            <!-- ✅ Loading State -->
                            <div class="dashboard-section-loading">
                                @Html.Partial("~/Areas/Patient/Views/Shared/_ShafaBrandLoading.cshtml")
                            </div>
                            <!-- ✅ Content will be loaded via AJAX -->
                            <div class="dashboard-section-content" style="display: none;"></div>
                            <!-- ✅ Empty State -->
                            <div class="dashboard-section-empty" style="display: none;">
                                <p class="text-muted text-center py-4">
                                    <i class="fas fa-calendar-times fa-2x mb-2"></i>
                                    <br>
                                    هیچ نوبت آینده‌ای وجود ندارد
                                </p>
                            </div>
                            <!-- ✅ Error State -->
                            <div class="dashboard-section-error" style="display: none;">
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-circle ml-1"></i>
                                    <span class="error-message">خطا در بارگذاری</span>
                                    <button class="btn btn-sm btn-outline-danger mt-2" onclick="PatientDashboard.reloadSection('upcomingAppointments')">
                                        تلاش مجدد
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ✅ Recent Receptions Section (AJAX Loaded) -->
                <div class="col-12 col-lg-6 mb-4">
                    <div class="dashboard-card" data-dashboard-section="recentReceptions">
                        <div class="dashboard-card-header">
                            <h3 class="dashboard-card-title">
                                <i class="fas fa-file-medical ml-2"></i>
                                پذیرش‌های اخیر
                            </h3>
                        </div>
                        <div class="dashboard-card-body">
                            <!-- ✅ Loading State -->
                            <div class="dashboard-section-loading">
                                @Html.Partial("~/Areas/Patient/Views/Shared/_ShafaBrandLoading.cshtml")
                            </div>
                            <!-- ✅ Content will be loaded via AJAX -->
                            <div class="dashboard-section-content" style="display: none;"></div>
                            <!-- ✅ Empty State -->
                            <div class="dashboard-section-empty" style="display: none;">
                                <p class="text-muted text-center py-4">
                                    <i class="fas fa-file-medical fa-2x mb-2"></i>
                                    <br>
                                    هیچ پذیرشی یافت نشد
                                </p>
                            </div>
                            <!-- ✅ Error State -->
                            <div class="dashboard-section-error" style="display: none;">
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-circle ml-1"></i>
                                    <span class="error-message">خطا در بارگذاری</span>
                                    <button class="btn btn-sm btn-outline-danger mt-2" onclick="PatientDashboard.reloadSection('recentReceptions')">
                                        تلاش مجدد
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

</div>

