@* ✅ Profile Tab Content - Enterprise-Grade Form *@

<div class="profile-tab-container">
    
    <!-- Tab Header -->
    <div class="tab-header mb-4">
        <h2 class="tab-title">
            <i class="fas fa-user-circle ml-2"></i>
            پروفایل من
        </h2>
        <p class="tab-subtitle text-muted">مشاهده و ویرایش اطلاعات شخصی</p>
    </div>

    <!-- Profile Content -->
    <div class="row">
        
        <!-- Profile Card -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle ml-2 text-primary"></i>
                        اطلاعات شخصی
                    </h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("UpdateProfile", "Dashboard", new { area = "Patient" }, FormMethod.Post, new { @class = "profile-form", data_ajax = "true", id = "profileForm" }))
                    {
                        @Html.AntiForgeryToken()
                        
                        <div class="row">
                            <!-- First Name -->
                            <div class="col-12 col-md-6 mb-3">
                                <label for="FirstName" class="form-label">
                                    <i class="fas fa-user ml-1"></i>
                                    نام <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" id="FirstName" name="FirstName" 
                                       required maxlength="50" placeholder="نام خود را وارد کنید" />
                                <span class="text-danger field-validation-error" data-valmsg-for="FirstName"></span>
                            </div>

                            <!-- Last Name -->
                            <div class="col-12 col-md-6 mb-3">
                                <label for="LastName" class="form-label">
                                    <i class="fas fa-user ml-1"></i>
                                    نام خانوادگی <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" id="LastName" name="LastName" 
                                       required maxlength="50" placeholder="نام خانوادگی خود را وارد کنید" />
                                <span class="text-danger field-validation-error" data-valmsg-for="LastName"></span>
                            </div>

                            <!-- National Code -->
                            <div class="col-12 col-md-6 mb-3">
                                <label for="NationalCode" class="form-label">
                                    <i class="fas fa-id-card ml-1"></i>
                                    کد ملی
                                </label>
                                <input type="text" class="form-control" id="NationalCode" name="NationalCode" 
                                       readonly placeholder="کد ملی شما" />
                                <small class="form-text text-muted">کد ملی قابل تغییر نیست</small>
                            </div>

                            <!-- Phone Number -->
                            <div class="col-12 col-md-6 mb-3">
                                <label for="PhoneNumber" class="form-label">
                                    <i class="fas fa-phone ml-1"></i>
                                    شماره تماس <span class="text-danger">*</span>
                                </label>
                                <input type="tel" class="form-control" id="PhoneNumber" name="PhoneNumber" 
                                       required pattern="^\+98\d{10}$" placeholder="+989123456789" 
                                       dir="ltr" style="text-align: left;" />
                                <small class="form-text text-muted">فرمت: +989123456789</small>
                                <span class="text-danger field-validation-error" data-valmsg-for="PhoneNumber"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-12 col-md-6 mb-3">
                                <label for="Email" class="form-label">
                                    <i class="fas fa-envelope ml-1"></i>
                                    ایمیل
                                </label>
                                <input type="email" class="form-control" id="Email" name="Email" 
                                       maxlength="100" placeholder="example@domain.com" 
                                       dir="ltr" style="text-align: left;" />
                                <span class="text-danger field-validation-error" data-valmsg-for="Email"></span>
                            </div>

                            <!-- Birth Date -->
                            <div class="col-12 col-md-6 mb-3">
                                <label for="BirthDate" class="form-label">
                                    <i class="fas fa-calendar ml-1"></i>
                                    تاریخ تولد
                                </label>
                                <input type="text" class="form-control persianDatepicker" id="BirthDate" name="BirthDate" 
                                       placeholder="1370/01/01" dir="ltr" style="text-align: left;" />
                                <span class="text-danger field-validation-error" data-valmsg-for="BirthDate"></span>
                            </div>

                            <!-- Gender -->
                            <div class="col-12 mb-3">
                                <label class="form-label">
                                    <i class="fas fa-venus-mars ml-1"></i>
                                    جنسیت <span class="text-danger">*</span>
                                </label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="Gender" id="GenderMale" value="Male" required />
                                        <label class="form-check-label" for="GenderMale">مرد</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="Gender" id="GenderFemale" value="Female" required />
                                        <label class="form-check-label" for="GenderFemale">زن</label>
                                    </div>
                                </div>
                                <span class="text-danger field-validation-error" data-valmsg-for="Gender"></span>
                            </div>

                            <!-- Address -->
                            <div class="col-12 mb-3">
                                <label for="Address" class="form-label">
                                    <i class="fas fa-map-marker-alt ml-1"></i>
                                    آدرس
                                </label>
                                <textarea class="form-control" id="Address" name="Address" rows="3" 
                                          maxlength="500" placeholder="آدرس کامل خود را وارد کنید"></textarea>
                                <span class="text-danger field-validation-error" data-valmsg-for="Address"></span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-secondary" onclick="UnifiedDashboard.switchTab('overview')">
                                <i class="fas fa-times ml-1"></i>
                                انصراف
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save ml-1"></i>
                                ذخیره تغییرات
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Profile Sidebar -->
        <div class="col-12 col-lg-4">
            <!-- Profile Summary Card -->
            <div class="card shadow-sm mb-3">
                <div class="card-body text-center">
                    <div class="profile-avatar-large mb-3">
                        <i class="fas fa-user-circle fa-5x text-primary"></i>
                    </div>
                    <h5 class="card-title mb-1" id="displayFullName">نام کاربر</h5>
                    <p class="text-muted small mb-0" id="displayNationalCode">کد ملی: -</p>
                </div>
            </div>

            <!-- Quick Info Card -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="fas fa-info-circle ml-1"></i>
                        راهنما
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success ml-1"></i>
                            اطلاعات خود را کامل کنید
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success ml-1"></i>
                            شماره تماس را به‌روز نگه دارید
                        </li>
                        <li class="mb-0">
                            <i class="fas fa-check-circle text-success ml-1"></i>
                            آدرس ایمیل معتبر وارد کنید
                        </li>
                    </ul>
                </div>
            </div>
        </div>

    </div>

</div>

<script>
    // ✅ Load Profile Data via AJAX
    $(document).ready(function() {
        // Load existing profile data
        $.ajax({
            url: '/Patient/Api/Profile/GetProfile',
            method: 'GET',
            dataType: 'json'
        })
        .done(function(response) {
            if (response.success && response.data) {
                var profile = response.data;
                $('#FirstName').val(profile.FirstName);
                $('#LastName').val(profile.LastName);
                $('#NationalCode').val(profile.NationalCode);
                $('#PhoneNumber').val(profile.PhoneNumber);
                $('#Email').val(profile.Email);
                $('#BirthDate').val(profile.BirthDate);
                $('#Address').val(profile.Address);
                
                if (profile.Gender) {
                    $('input[name="Gender"][value="' + profile.Gender + '"]').prop('checked', true);
                }
                
                // Update display
                $('#displayFullName').text(profile.FirstName + ' ' + profile.LastName);
                $('#displayNationalCode').text('کد ملی: ' + profile.NationalCode);
            }
        })
        .fail(function() {
            if (window.NotificationHelper) {
                NotificationHelper.showWarning('خطا در بارگذاری اطلاعات پروفایل');
            }
        });
        
        // Initialize Persian Datepicker (if available)
        if ($.fn.pDatepicker) {
            $('.persianDatepicker').pDatepicker({
                format: 'YYYY/MM/DD',
                autoClose: true
            });
        }
    });
</script>

