@model ClinicApp.ViewModels.Patient.DashboardViewModel
@{
    ViewBag.Title = "داشبورد من";
}

@section Styles {
    <link href="~/Content/css/patient-dashboard-unified.css" rel="stylesheet" />
}

<!-- ✅ Unified Dashboard - Tab-Based SPA Architecture -->
<div id="unifiedDashboard" class="unified-dashboard-container">
    
    <!-- ✅ Dashboard Header with Tab Navigation -->
    <section class="dashboard-header-unified">
        <div class="container-fluid">
            <div class="row align-items-center mb-3">
                <div class="col-12 col-md-8">
                    <h1 class="dashboard-title-main">
                        <i class="fas fa-tachometer-alt ml-2"></i>
                        پنل بیمار
                    </h1>
                    <p class="dashboard-subtitle-main text-muted">
                        مدیریت جامع اطلاعات پزشکی و نوبت‌ها
                    </p>
                </div>
                <div class="col-12 col-md-4 text-left text-md-right mt-3 mt-md-0">
                    <button type="button" class="btn btn-primary btn-sm" id="btnQuickAppointment">
                        <i class="fas fa-calendar-plus ml-1"></i>
                        رزرو نوبت جدید
                    </button>
                </div>
            </div>
            
            <!-- ✅ Tab Navigation - مثل AWS Console -->
            <ul class="nav nav-tabs dashboard-tabs" id="dashboardTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-overview" data-bs-toggle="tab" data-bs-target="#content-overview" 
                            type="button" role="tab" data-tab-name="overview">
                        <i class="fas fa-home ml-1"></i>
                        <span>خانه</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-profile" data-bs-toggle="tab" data-bs-target="#content-profile" 
                            type="button" role="tab" data-tab-name="profile">
                        <i class="fas fa-user-circle ml-1"></i>
                        <span>پروفایل من</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-appointments" data-bs-toggle="tab" data-bs-target="#content-appointments" 
                            type="button" role="tab" data-tab-name="appointments">
                        <i class="fas fa-calendar-check ml-1"></i>
                        <span>نوبت‌ها</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-medical-record" data-bs-toggle="tab" data-bs-target="#content-medical-record" 
                            type="button" role="tab" data-tab-name="medical-record">
                        <i class="fas fa-file-medical ml-1"></i>
                        <span>پرونده پزشکی</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-settings" data-bs-toggle="tab" data-bs-target="#content-settings" 
                            type="button" role="tab" data-tab-name="settings">
                        <i class="fas fa-cog ml-1"></i>
                        <span>تنظیمات</span>
                    </button>
                </li>
            </ul>
        </div>
    </section>

    <!-- ✅ Tab Content Container -->
    <div class="tab-content dashboard-tab-content" id="dashboardTabContent">
        
        <!-- Tab 1: Overview (Dashboard اصلی) -->
        <div class="tab-pane fade show active" id="content-overview" role="tabpanel">
            <div class="container-fluid">
                @Html.Partial("_DashboardOverview")
            </div>
        </div>

        <!-- Tab 2: Profile -->
        <div class="tab-pane fade" id="content-profile" role="tabpanel">
            <div class="container-fluid">
                <div class="tab-loading" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <p class="mt-2">در حال بارگذاری پروفایل...</p>
                </div>
                <div class="tab-content-area"></div>
            </div>
        </div>

        <!-- Tab 3: Appointments -->
        <div class="tab-pane fade" id="content-appointments" role="tabpanel">
            <div class="container-fluid">
                <div class="tab-loading" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <p class="mt-2">در حال بارگذاری نوبت‌ها...</p>
                </div>
                <div class="tab-content-area"></div>
            </div>
        </div>

        <!-- Tab 4: Medical Record -->
        <div class="tab-pane fade" id="content-medical-record" role="tabpanel">
            <div class="container-fluid">
                <div class="tab-loading" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <p class="mt-2">در حال بارگذاری پرونده...</p>
                </div>
                <div class="tab-content-area"></div>
            </div>
        </div>

        <!-- Tab 5: Settings -->
        <div class="tab-pane fade" id="content-settings" role="tabpanel">
            <div class="container-fluid">
                <div class="tab-loading" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <p class="mt-2">در حال بارگذاری تنظیمات...</p>
                </div>
                <div class="tab-content-area"></div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <!-- ✅ Dashboard Stats Module -->
    <script src="~/Content/js/patient-dashboard.js"></script>
    
    <!-- ✅ Unified Dashboard SPA Module -->
    <script src="~/Content/js/unified-dashboard.js"></script>
    
    <script>
        // ✅ Initialize Modules
        $(document).ready(function() {
            // Initialize Dashboard Stats (for Overview tab)
            if (typeof PatientDashboard !== 'undefined') {
                PatientDashboard.init();
            }
            
            // Initialize Unified Dashboard (Tab management)
            if (typeof UnifiedDashboard !== 'undefined') {
                UnifiedDashboard.init();
            }
        });
    </script>
}
