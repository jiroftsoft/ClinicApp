@model ClinicApp.ViewModels.Patient.DoctorSelectionViewModel
@{
    ViewBag.Title = "انتخاب پزشک";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayoutPro.cshtml";
    ViewBag.BookingStep = 1; // ✅ Progress Indicator: Step 1/4
    ViewBag.BookingTotal = 4;
}

@section Styles {
    <link href="~/Content/css/appointment-booking-progress.css" rel="stylesheet" />
    <link href="~/Content/css/appointment-booking-views.css" rel="stylesheet" />
    <link href="~/Content/css/local-fonts.css" rel="stylesheet" />
    <link href="~/Content/css/medical-forms.css" rel="stylesheet" />
    <link href="~/Content/js/plugins/SweetAlert2/sweetalert2.min.css" rel="stylesheet" />
    <!-- ✅ CRITICAL FIX: حذف Inline Styles - انتقال به appointment-booking-views.css -->
}

<div class="appointment-page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-user-md me-2"></i>
                انتخاب پزشک
            </h2>
            <p class="mb-0 opacity-75">لطفاً پزشک مورد نظر خود را انتخاب کنید</p>
        </div>
        <a href="@Url.Action("MyAppointments", "Appointment", new { area = "Patient" })" class="btn btn-light">
            <i class="fas fa-arrow-right me-1"></i>
            بازگشت
        </a>
    </div>
</div>

<!-- جستجو و فیلتر -->
<div class="search-card">
    <form id="searchForm" method="get" action="@Url.Action("SelectDoctor")">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">جستجوی پزشک</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" 
                           name="searchTerm" 
                           class="form-control" 
                           placeholder="نام پزشک، تخصص..." 
                           value="@Model.SearchTerm"
                           id="searchInput" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">بخش</label>
                <select name="departmentId" class="form-select" id="departmentFilter">
                    <option value="">همه بخش‌ها</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.DepartmentId" @(Model.SelectedDepartmentId == dept.DepartmentId ? "selected" : "")>
                            @dept.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i>
                    جستجو
                </button>
            </div>
        </div>
    </form>
</div>

@* ✅ PRODUCTION: بلوک تشخیص احراز هویت حذف شد — در پروداکشن نباید userId/نقش‌ها در UI نمایش داده شوند. برای عیب‌یابی از لاگ سرور یا endpoint امن استفاده شود. *@

<!-- لیست پزشکان -->
<div class="doctors-container" id="doctorsContainer">
    @if (Model.Doctors != null && Model.Doctors.Any())
    {
        foreach (var doctor in Model.Doctors)
        {
            @Html.Partial("_DoctorCard", doctor)
        }
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-user-md"></i>
            <h4>پزشکی یافت نشد</h4>
            <p class="text-muted">لطفاً فیلترهای جستجو را تغییر دهید</p>
        </div>
    }
</div>

<!-- Loading State -->
<div id="loadingState" class="loading-spinner" style="display: none;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">در حال بارگذاری...</span>
    </div>
    <p class="mt-3 text-muted">در حال جستجوی پزشکان...</p>
</div>

@section Scripts {
    <script src="~/Content/js/plugins/SweetAlert2/sweetalert2@11.js"></script>
    <script>
        // ✅ فاز ۳.۱: مسیرها از سرور (بدون hardcode در JS)
        window.appConfig = window.appConfig || {};
        window.appConfig.appointmentBooking = window.appConfig.appointmentBooking || {};
        window.appConfig.appointmentBooking.selectDateUrlTemplate = '@Url.Action("SelectDate", "AppointmentBooking", new { area = "Patient", doctorId = 0 })';
        window.appConfig.appointmentBooking.getAvailableDoctorsUrl = '@Url.Action("GetAvailableDoctors", "DoctorSearchApi", new { area = "Patient" })';
    </script>
    <script src="~/Scripts/patient/doctor-selection.js"></script>
    <script>
        // ✅ Display NotificationHelper messages
        $(document).ready(function () {
            @{
                var successMsg = ClinicApp.Helpers.NotificationHelper.GetSuccess(TempData);
                var errorMsg = ClinicApp.Helpers.NotificationHelper.GetError(TempData);
                var warningMsg = ClinicApp.Helpers.NotificationHelper.GetWarning(TempData);
                var infoMsg = ClinicApp.Helpers.NotificationHelper.GetInfo(TempData);
            }
            @if (successMsg != null)
            {
                <text>
                if (typeof toastr !== 'undefined') {
                    toastr.success('@Html.Raw(successMsg.Message)', '@Html.Raw(successMsg.Title)');
                }
                </text>
            }
            @if (errorMsg != null)
            {
                <text>
                if (typeof toastr !== 'undefined') {
                    toastr.error('@Html.Raw(errorMsg.Message)', '@Html.Raw(errorMsg.Title)');
                }
                </text>
            }
            @if (warningMsg != null)
            {
                <text>
                if (typeof toastr !== 'undefined') {
                    toastr.warning('@Html.Raw(warningMsg.Message)', '@Html.Raw(warningMsg.Title)');
                }
                </text>
            }
            @if (infoMsg != null)
            {
                <text>
                if (typeof toastr !== 'undefined') {
                    toastr.info('@Html.Raw(infoMsg.Message)', '@Html.Raw(infoMsg.Title)');
                }
                </text>
            }
        });
    </script>
}

