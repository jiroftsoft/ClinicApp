@model ClinicApp.ViewModels.Patient.DoctorSelectionViewModel
@{
    ViewBag.Title = "انتخاب پزشک";
}

@section Styles {
    <link href="~/Content/css/local-fonts.css" rel="stylesheet" />
    <link href="~/Content/css/medical-forms.css" rel="stylesheet" />
    <link href="~/Content/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <style>
        :root {
            --medical-primary: #2c5aa0;
            --medical-primary-light: #3d6bb3;
            --medical-border: #dee2e6;
            --medical-text: #495057;
        }

        .page-header {
            background: linear-gradient(135deg, var(--medical-primary) 0%, var(--medical-primary-light) 100%);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            color: white;
            box-shadow: 0 4px 16px rgba(44, 90, 160, 0.25);
        }

        .search-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .doctors-container {
            min-height: 400px;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--medical-text);
        }

        .empty-state i {
            font-size: 4rem;
            color: var(--medical-border);
            margin-bottom: 1rem;
        }

        .loading-spinner {
            text-align: center;
            padding: 3rem;
        }

        .loading-spinner .spinner-border {
            width: 3rem;
            height: 3rem;
            border-width: 0.3rem;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .page-header {
                padding: 1.5rem;
            }

            .page-header h2 {
                font-size: 1.5rem;
            }

            .search-card {
                padding: 1rem;
            }

            .doctors-container {
                min-height: 300px;
            }
        }

        /* Animation */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .doctor-card {
            animation: fadeIn 0.3s ease-in-out;
        }
    </style>
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-user-md me-2"></i>
                انتخاب پزشک
            </h2>
            <p class="mb-0 opacity-75">لطفاً پزشک مورد نظر خود را انتخاب کنید</p>
        </div>
        <a href="@Url.Action("MyAppointments", "Appointment")" class="btn btn-light">
            <i class="fas fa-arrow-right me-1"></i>
            بازگشت
        </a>
    </div>
</div>

<!-- جستجو و فیلتر -->
<div class="search-card">
    <form id="searchForm" method="get" action="@Url.Action("SelectDoctor")">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">جستجوی پزشک</label>
                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" 
                           name="searchTerm" 
                           class="form-control" 
                           placeholder="نام پزشک، تخصص..." 
                           value="@Model.SearchTerm"
                           id="searchInput" />
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">بخش</label>
                <select name="departmentId" class="form-select" id="departmentFilter">
                    <option value="">همه بخش‌ها</option>
                    @foreach (var dept in Model.Departments)
                    {
                        <option value="@dept.DepartmentId" @(Model.SelectedDepartmentId == dept.DepartmentId ? "selected" : "")>
                            @dept.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i>
                    جستجو
                </button>
            </div>
        </div>
    </form>
</div>

<!-- لیست پزشکان -->
<div class="doctors-container" id="doctorsContainer">
    @if (Model.Doctors != null && Model.Doctors.Any())
    {
        foreach (var doctor in Model.Doctors)
        {
            @Html.Partial("_DoctorCard", doctor)
        }
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-user-md"></i>
            <h4>پزشکی یافت نشد</h4>
            <p class="text-muted">لطفاً فیلترهای جستجو را تغییر دهید</p>
        </div>
    }
</div>

<!-- Loading State -->
<div id="loadingState" class="loading-spinner" style="display: none;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">در حال بارگذاری...</span>
    </div>
    <p class="mt-3 text-muted">در حال جستجوی پزشکان...</p>
</div>

@section Scripts {
    <script src="~/Content/plugins/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/Scripts/patient/doctor-selection.js"></script>
}

