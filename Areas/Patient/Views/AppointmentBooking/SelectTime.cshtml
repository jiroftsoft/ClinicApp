@using ClinicApp.Extensions
@model ClinicApp.ViewModels.Patient.TimeSlotSelectionViewModel
@{
    ViewBag.Title = "انتخاب زمان";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayoutPro.cshtml";
    ViewBag.BookingStep = 3; // ✅ Progress Indicator: Step 3/4
    ViewBag.BookingTotal = 4;
}

@section Styles {
    <link href="~/Content/css/appointment-booking-progress.css" rel="stylesheet" />
    <link href="~/Content/css/appointment-booking-views.css" rel="stylesheet" />
    <link href="~/Content/css/local-fonts.css" rel="stylesheet" />
    <link href="~/Content/css/medical-forms.css" rel="stylesheet" />
    <link href="~/Content/js/plugins/SweetAlert2/sweetalert2.min.css" rel="stylesheet" />
    <!-- ✅ CRITICAL FIX: حذف Inline Styles - انتقال به appointment-booking-views.css -->
}

<div class="appointment-page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-clock me-2"></i>
                انتخاب زمان نوبت
            </h2>
            <p class="mb-0 opacity-75">لطفاً زمان مورد نظر خود را انتخاب کنید</p>
        </div>
        <a href="@Url.Action("SelectDate", new { doctorId = Model.DoctorId })" class="btn btn-light">
            <i class="fas fa-arrow-right me-1"></i>
            بازگشت
        </a>
    </div>
</div>

<!-- اطلاعات -->
<div class="info-card">
    <div class="row">
        <div class="col-md-6">
            <h5 class="mb-3">
                <i class="fas fa-user-md me-2 text-primary"></i>
                @Model.DoctorName
            </h5>
            <p class="text-muted mb-1">
                <i class="fas fa-calendar-alt me-1"></i>
                تاریخ: <strong>@Model.SelectedDate.ToPersianDate()</strong>
            </p>
            <p class="text-muted mb-0">
                <i class="fas fa-hourglass-half me-1"></i>
                مدت زمان هر نوبت: <strong>@Model.AppointmentDuration دقیقه</strong>
            </p>
        </div>
        <div class="col-md-6 text-end">
            <div class="alert alert-info mb-0">
                <i class="fas fa-info-circle me-1"></i>
                <small>اسلات‌های سبز رنگ در دسترس هستند</small>
            </div>
        </div>
    </div>
</div>

<!-- اسلات‌های زمانی -->
<div class="info-card">
    <h5 class="mb-3">
        <i class="fas fa-list me-2"></i>
        اسلات‌های زمانی در دسترس
    </h5>
    
    <div class="time-slots-grid" id="timeSlotsGrid">
        @if (Model.AvailableSlots != null && Model.AvailableSlots.Any())
        {
            foreach (var slot in Model.AvailableSlots)
            {
                @Html.Partial("_TimeSlotCard", slot)
            }
        }
        else
        {
            <div class="empty-state col-12">
                <i class="fas fa-clock"></i>
                <h4>اسلات زمانی در دسترس نیست</h4>
                <p class="text-muted">برای این تاریخ اسلات زمانی در دسترس وجود ندارد</p>
                <a href="@Url.Action("SelectDate", new { doctorId = Model.DoctorId })" class="btn btn-primary mt-3">
                    <i class="fas fa-arrow-right me-1"></i>
                    انتخاب تاریخ دیگر
                </a>
            </div>
        }
    </div>
</div>

<!-- اطلاعات اسلات انتخاب شده -->
<div class="selected-slot-info" id="selectedSlotInfo">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h6 class="mb-1">زمان انتخاب شده:</h6>
            <p class="mb-0" id="selectedTimeDisplay"></p>
        </div>
        <button type="button" class="btn btn-light btn-sm" id="clearSelectionBtn">
            <i class="fas fa-times me-1"></i>
            پاک کردن
        </button>
    </div>
</div>

<!-- ✅ Desktop: دکمه ادامه (در موبایل sticky bottom bar نمایش داده می‌شود) -->
<div class="text-center mt-4 d-none d-md-block">
    <button type="button" class="btn btn-primary btn-lg" id="continueToConfirmBtn" disabled>
        <i class="fas fa-arrow-left me-1"></i>
        ادامه به تایید نهایی
    </button>
</div>

<!-- ✅ Mobile: Sticky Bottom Bar (فقط در موبایل نمایش داده می‌شود) -->
<div class="sticky-bottom-bar d-md-none" id="stickyBottomBar">
    <div class="container-fluid px-3">
        <div class="d-flex justify-content-between align-items-center">
            <div class="selected-time-display" id="stickySelectedTime" style="display: none;">
                <small class="text-muted d-block mb-1">زمان انتخاب شده:</small>
                <strong id="stickyTimeDisplay"></strong>
            </div>
            <button type="button" class="btn btn-primary btn-lg" id="continueToConfirmBtnMobile" disabled>
                <i class="fas fa-arrow-left me-1"></i>
                ادامه
            </button>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()
<input type="hidden" id="doctorId" value="@Model.DoctorId" />
<input type="hidden" id="selectedDate" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
<input type="hidden" id="selectedStartTime" />
<input type="hidden" id="selectedEndTime" />

@{
    // ✅ CRITICAL FIX: استفاده از Route system به جای Hardcode URLs
    var confirmBookingUrl = Url.Action("ConfirmBooking", "AppointmentBooking", new { area = "Patient" });
    var checkSlotAvailabilityUrl = Url.Action("CheckSlotAvailability", "DoctorSearchApi", new { area = "Patient" });
    var getAvailableSlotsUrl = Url.Action("GetAvailableTimeSlots", "DoctorSearchApi", new { area = "Patient" });
}

@section Scripts {
    <script src="~/Content/js/plugins/SweetAlert2/sweetalert2@11.js"></script>
    <script>
        // ✅ CRITICAL FIX: Pass Route URLs to JavaScript (طبق قرارداد - No Hardcode URLs)
        window.appConfig = window.appConfig || {};
        window.appConfig.appointmentBooking = window.appConfig.appointmentBooking || {};
        window.appConfig.appointmentBooking.confirmBookingUrl = '@confirmBookingUrl';
        window.appConfig.appointmentBooking.checkSlotAvailabilityUrl = '@checkSlotAvailabilityUrl';
        window.appConfig.appointmentBooking.getAvailableSlotsUrl = '@getAvailableSlotsUrl';
    </script>
    <script src="~/Scripts/patient/time-selection.js"></script>
}

