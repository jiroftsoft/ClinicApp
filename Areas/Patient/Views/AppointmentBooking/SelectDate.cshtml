@model ClinicApp.ViewModels.Patient.DateSelectionViewModel
@{
    ViewBag.Title = "انتخاب تاریخ";
}

@section Styles {
    <link href="~/Content/css/local-fonts.css" rel="stylesheet" />
    <link href="~/Content/css/medical-forms.css" rel="stylesheet" />
    <link href="~/Content/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/persian-datepicker/persian-datepicker.min.css" rel="stylesheet" />
    <style>
        :root {
            --medical-primary: #2c5aa0;
            --medical-primary-light: #3d6bb3;
            --medical-border: #dee2e6;
            --medical-text: #495057;
        }

        .page-header {
            background: linear-gradient(135deg, var(--medical-primary) 0%, var(--medical-primary-light) 100%);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            color: white;
            box-shadow: 0 4px 16px rgba(44, 90, 160, 0.25);
        }

        .doctor-info-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            border-right: 4px solid var(--medical-primary);
        }

        .calendar-container {
            background: white;
            border-radius: 12px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .date-picker-wrapper {
            text-align: center;
        }

        .available-dates-list {
            margin-top: 2rem;
        }

        .date-item {
            border: 2px solid var(--medical-border);
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            background: white;
        }

        .date-item:hover {
            border-color: var(--medical-primary);
            box-shadow: 0 4px 12px rgba(44, 90, 160, 0.15);
            transform: translateY(-2px);
        }

        .date-item.selected {
            border-color: var(--medical-primary);
            background: linear-gradient(135deg, var(--medical-primary-light) 0%, var(--medical-primary) 100%);
            color: white;
        }

        .date-item.unavailable {
            opacity: 0.5;
            cursor: not-allowed;
            background: #f5f5f5;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .page-header {
                padding: 1.5rem;
            }

            .doctor-info-card {
                padding: 1rem;
            }

            .calendar-container {
                padding: 1rem;
            }
        }

        /* Animation */
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .date-item {
            animation: slideIn 0.3s ease-in-out;
        }
    </style>
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-calendar-alt me-2"></i>
                انتخاب تاریخ نوبت
            </h2>
            <p class="mb-0 opacity-75">لطفاً تاریخ مورد نظر خود را انتخاب کنید</p>
        </div>
        <a href="@Url.Action("SelectDoctor")" class="btn btn-light">
            <i class="fas fa-arrow-right me-1"></i>
            بازگشت
        </a>
    </div>
</div>

<!-- اطلاعات پزشک -->
<div class="doctor-info-card">
    <div class="d-flex align-items-center">
        <div class="doctor-avatar me-3">
            <i class="fas fa-user-md text-white fs-2"></i>
        </div>
        <div>
            <h5 class="mb-1">@Model.DoctorName</h5>
            <p class="text-muted mb-0">
                <i class="fas fa-stethoscope me-1"></i>
                @Model.DoctorSpecialization
            </p>
        </div>
    </div>
</div>

<!-- تقویم -->
<div class="calendar-container">
    <div class="date-picker-wrapper">
        <label class="form-label mb-3">
            <i class="fas fa-calendar me-1"></i>
            انتخاب تاریخ
        </label>
        <input type="text" 
               id="persianDatePicker" 
               class="form-control form-control-lg text-center" 
               placeholder="روی اینجا کلیک کنید" 
               readonly />
    </div>

    <div class="available-dates-list" id="availableDatesList">
        <!-- تاریخ‌های در دسترس از طریق JavaScript لود می‌شوند -->
    </div>
</div>

<!-- دکمه ادامه -->
<div class="text-center mt-4">
    <button type="button" class="btn btn-primary btn-lg" id="continueToTimeBtn" disabled>
        <i class="fas fa-arrow-left me-1"></i>
        ادامه به انتخاب زمان
    </button>
</div>

<input type="hidden" id="doctorId" value="@Model.DoctorId" />
<input type="hidden" id="selectedDate" />

@section Scripts {
    <script src="~/Content/plugins/sweetalert2/sweetalert2@11.js"></script>
    <script src="~/Content/plugins/persian-datepicker/persian-datepicker.min.js"></script>
    <script src="~/Scripts/patient/date-selection.js"></script>
}

