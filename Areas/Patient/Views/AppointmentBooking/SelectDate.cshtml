@model ClinicApp.ViewModels.Patient.DateSelectionViewModel
@{
    ViewBag.Title = "انتخاب تاریخ نوبت";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayoutPro.cshtml";
    ViewBag.BookingStep = 2; // ✅ Progress Indicator: Step 2/4
    ViewBag.BookingTotal = 4;
}

@section Styles {
    <link href="~/Content/css/appointment-booking-progress.css" rel="stylesheet" />
    <link href="~/Content/css/appointment-booking-views.css" rel="stylesheet" />
    <link href="~/Content/css/local-fonts.css" rel="stylesheet" />
    <link href="~/Content/css/medical-forms.css" rel="stylesheet" />
    <link href="~/Content/js/plugins/SweetAlert2/sweetalert2.min.css" rel="stylesheet" />
    <!-- ✅ CRITICAL FIX: حذف Inline Styles - انتقال به appointment-booking-views.css -->
}

<div class="container-fluid px-3 px-sm-4 px-md-5">
    <!-- ✅ Page Header - Mobile-First -->
    <div class="appointment-page-header">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center">
            <div class="mb-3 mb-sm-0">
                <h2 class="mb-2 mb-sm-1">
                    <i class="fas fa-calendar-alt me-2"></i>
                    انتخاب تاریخ نوبت
                </h2>
                <p class="mb-0">لطفاً تاریخ مورد نظر خود را انتخاب کنید</p>
            </div>
            <a href="@Url.Action("SelectDoctor", "AppointmentBooking", new { area = "Patient" })" 
               class="btn btn-light btn-sm">
                <i class="fas fa-arrow-right me-1"></i>
                بازگشت
            </a>
        </div>
    </div>

    <!-- ✅ Doctor Info Card - Mobile-First -->
    <div class="doctor-info-card">
        <div class="d-flex align-items-center">
            <div class="doctor-avatar me-3">
                <i class="fas fa-user-md text-white fs-4"></i>
            </div>
            <div class="flex-grow-1">
                <h5 class="mb-1 fw-bold">@Model.DoctorName</h5>
                <p class="text-muted mb-0 small">
                    <i class="fas fa-stethoscope me-1"></i>
                    @Model.DoctorSpecialization
                </p>
            </div>
        </div>
    </div>

    <!-- ✅ Calendar Container - Mobile-First -->
    <div class="calendar-container">
        <div class="date-picker-wrapper">
            @{
                // ✅ مهم: initialValue را null می‌گذاریم تا تاریخ امروز به اشتباه نمایش داده نشود
                ViewBag.PersianDatePickerId = "appointmentDatePicker";
                ViewBag.PersianDatePickerName = "SelectedDate";
                ViewBag.PersianDatePickerValue = (DateTime?)null; // ✅ No initial value - user must select
                ViewBag.PersianDatePickerLabel = "انتخاب تاریخ";
                ViewBag.PersianDatePickerPlaceholder = "روی اینجا کلیک کنید تا تاریخ را انتخاب کنید";
                ViewBag.PersianDatePickerHelpText = "لطفاً تاریخ مورد نظر خود را از تقویم انتخاب کنید";
                ViewBag.PersianDatePickerRequired = true;
                ViewBag.PersianDatePickerCssClass = "form-control form-control-lg text-center";
            }
            @Html.Partial("~/Areas/Admin/Views/Shared/_PersianDatePicker.cshtml")
        </div>

        <!-- ✅ Feedback when date is selected -->
        <div class="date-selected-feedback" id="dateSelectedFeedback">
            <i class="fas fa-check-circle me-2"></i>
            <span id="selectedDateDisplay"></span>
        </div>
    </div>

    <!-- ✅ Continue Button - Mobile-First -->
    <div class="text-center mb-4">
        <button type="button" 
                class="btn btn-primary btn-lg btn-continue" 
                id="continueToTimeBtn" 
                disabled>
            <i class="fas fa-arrow-left me-2"></i>
            ادامه به انتخاب زمان
        </button>
    </div>
</div>

<!-- ✅ Hidden Fields -->
<input type="hidden" id="doctorId" value="@Model.DoctorId" />
<input type="hidden" id="selectedDateGregorian" />

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Content/js/plugins/SweetAlert2/sweetalert2@11.js"></script>
    @* ✅ Enterprise: استفاده از Enterprise Component که در Layout لود شده است *@
    @* نیازی به لود مجدد نیست - فقط اگر در Layout لود نشده باشد *@
    @if (false) // ✅ Enterprise Component در Layout لود می‌شود
    {
        @Html.Partial("~/Areas/Admin/Views/Shared/_PersianDatePickerScript.cshtml")
    }
    <!-- ✅ CRITICAL FIX: انتقال JavaScript به فایل جداگانه (طبق APPOINTMENT_BOOKING_VIEWS_REVIEW.md) -->
    <!-- ✅ CRITICAL FIX: منتظر می‌مانیم تا pDatepicker لود شود -->
    <script>
        // ✅ Enterprise: Wait for JalaliDatePickerEnterprise to be loaded before initializing date-selection module
        function waitForJalaliDatePickerEnterprise(callback, maxAttempts) {
            maxAttempts = maxAttempts || 50; // 5 seconds max
            var attempts = 0;
            
            function check() {
                attempts++;
                // ✅ Enterprise: بررسی JalaliDatePickerEnterprise و jalaliDatepicker
                // همچنین بررسی می‌کنیم که DatePicker initialize شده باشد
                var $datePicker = $('#appointmentDatePicker');
                var datePickerElement = $datePicker[0];
                
                if (typeof jalaliDatepicker !== 'undefined' && 
                    typeof JalaliDatePickerEnterprise !== 'undefined' &&
                    datePickerElement && 
                    (datePickerElement.dataset.jdpInitialized === 'true' || attempts > 10)) {
                    // ✅ اگر بعد از 10 تلاش هنوز initialize نشده، ادامه می‌دهیم (ممکن است بعداً initialize شود)
                    callback();
                } else if (attempts < maxAttempts) {
                    setTimeout(check, 100);
                } else {
                    console.error('❌ JalaliDatePickerEnterprise failed to load after ' + maxAttempts + ' attempts');
                    console.error('jalaliDatepicker:', typeof jalaliDatepicker);
                    console.error('JalaliDatePickerEnterprise:', typeof JalaliDatePickerEnterprise);
                    console.error('DatePicker Element:', datePickerElement);
                    console.error('Initialized:', datePickerElement ? datePickerElement.dataset.jdpInitialized : 'N/A');
                    // ✅ حتی اگر لود نشده باشد، callback را فراخوانی می‌کنیم تا date-selection.js لود شود
                    callback();
                }
            }
            check();
        }
        
        // ✅ Load date-selection.js after JalaliDatePickerEnterprise is ready
        waitForJalaliDatePickerEnterprise(function() {
            // Load the module script dynamically
            var script = document.createElement('script');
            script.src = '@Url.Content("~/Scripts/patient/date-selection.js")';
            script.onload = function() {
                // ✅ Pass Razor-generated URL to JavaScript module
                if (window.DateSelectionModule) {
                    window.appConfig = window.appConfig || {};
                    window.appConfig.appointmentBooking = window.appConfig.appointmentBooking || {};
                    window.appConfig.appointmentBooking.selectTimeUrl = '@Url.Action("SelectTime", "AppointmentBooking", new { area = "Patient" })';
                    
                    // Initialize the module
                    if (typeof jQuery !== 'undefined') {
                        $(document).ready(function () {
                            if (window.DateSelectionModule && typeof window.DateSelectionModule.init === 'function') {
                                window.DateSelectionModule.init();
                            }
                        });
                    }
                }
            };
            script.onerror = function() {
                console.error('❌ Failed to load date-selection.js');
            };
            document.head.appendChild(script);
        });
    </script>
}
