@using ClinicApp.Extensions
@using ClinicApp.Helpers
@model ClinicApp.ViewModels.Patient.AppointmentBookingViewModel
@{
    ViewBag.Title = "تایید نهایی رزرو";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayoutPro.cshtml";
    ViewBag.BookingStep = 4; // ✅ Progress Indicator: Step 4/4
    ViewBag.BookingTotal = 4;
}

@section Styles {
    <link href="~/Content/css/appointment-booking-progress.css" rel="stylesheet" />
    <link href="~/Content/css/appointment-booking-views.css" rel="stylesheet" />
    <link href="~/Content/css/local-fonts.css" rel="stylesheet" />
    <link href="~/Content/css/medical-forms.css" rel="stylesheet" />
    <link href="~/Content/js/plugins/SweetAlert2/sweetalert2.min.css" rel="stylesheet" />
    <!-- ✅ CRITICAL FIX: حذف Inline Styles - انتقال به appointment-booking-views.css -->
}

<div class="appointment-page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-check-circle me-2"></i>
                تایید نهایی رزرو
            </h2>
            <p class="mb-0 opacity-75">لطفاً اطلاعات را بررسی و تایید کنید</p>
        </div>
        <a href="@Url.Action("SelectTime", new { doctorId = Model.DoctorId, date = Model.AppointmentDate })" class="btn btn-light">
            <i class="fas fa-arrow-right me-1"></i>
            بازگشت
        </a>
    </div>
</div>

<!-- خلاصه اطلاعات -->
<div class="summary-card medical-form">
    <fieldset class="medical-form-section">
        <legend>خلاصه اطلاعات نوبت</legend>
        <div class="medical-form-summary">
            <div class="medical-form-summary-item">
                <span class="medical-form-summary-label">پزشک:</span>
                <span class="medical-form-summary-value">@Model.DoctorName</span>
            </div>
            <div class="medical-form-summary-item">
                <span class="medical-form-summary-label">تخصص:</span>
                <span class="medical-form-summary-value">@Model.DoctorSpecialization</span>
            </div>
            <div class="medical-form-summary-item">
                <span class="medical-form-summary-label">تاریخ:</span>
                <span class="medical-form-summary-value">@Model.AppointmentDate.ToPersianDate()</span>
            </div>
            <div class="medical-form-summary-item">
                <span class="medical-form-summary-label">زمان:</span>
                <span class="medical-form-summary-value">
                    @ClinicApp.Helpers.TimeFormatHelper.FormatTimeToPersian(Model.StartTime) - @ClinicApp.Helpers.TimeFormatHelper.FormatTimeToPersian(Model.EndTime)
                </span>
            </div>
            <div class="price-section">
                <div class="medical-form-summary-item">
                    <span class="medical-form-summary-label">مبلغ نوبت:</span>
                    <span class="price-total">@Model.Price.ToString("N0") تومان</span>
                </div>
            </div>
        </div>
    </fieldset>
</div>

<!-- فرم پرداخت -->
<div class="payment-form medical-form">
    <form id="bookingForm" method="post" action="@Url.Action("Reserve", "AppointmentBooking", new { area = "Patient" })">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.DoctorId)
        @Html.HiddenFor(m => m.AppointmentDate)
        @Html.HiddenFor(m => m.StartTime)
        @Html.HiddenFor(m => m.EndTime)
        @Html.HiddenFor(m => m.Price)
        @Html.HiddenFor(m => m.ServiceCategoryId)
        @Html.HiddenFor(m => m.Description)
        <!-- ✅ CRITICAL FIX: Idempotency Key for duplicate request prevention -->
        <input type="hidden" name="idempotencyKey" id="idempotencyKey" value="@Guid.NewGuid().ToString()" />

        <fieldset class="medical-form-section">
            <legend>روش پرداخت</legend>
            
            <div class="form-group">
                <div class="payment-method-card selected" data-method="online">
                    <div class="d-flex align-items-center">
                        <div>
                            <h6 class="mb-1">پرداخت آنلاین</h6>
                            <small class="form-text">پرداخت از طریق درگاه بانکی</small>
                        </div>
                    </div>
                </div>
            </div>

            @{
                var serviceCategories = ViewBag.ServiceCategories as IEnumerable<ClinicApp.Models.DTOs.Appointment.ServiceCategoryLookupDto>;
                var hasServiceCategories = serviceCategories != null && serviceCategories.Any();
            }
            @if (hasServiceCategories)
            {
                <div class="form-group">
                    <label for="ServiceCategoryIdSelect" class="form-label">نوع ویزیت</label>
                    <select id="ServiceCategoryIdSelect" class="form-select">
                        <option value="">— انتخاب کنید —</option>
                        @foreach (var item in serviceCategories)
                        {
                            <option value="@item.Id" @(Model.ServiceCategoryId == item.Id ? "selected" : "")>@item.Name</option>
                        }
                    </select>
                    <small class="form-text text-muted">برای مشاوره آنلاین، نوع ویزیت «مشاوره آنلاین» را انتخاب کنید.</small>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="form-group">
                    <label for="Description" class="form-label">توضیحات (اختیاری)</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = "توضیحات اضافی..." })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "invalid-feedback" })
                </div>
            }

            <div class="form-group mt-4">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
                <button type="submit" class="btn btn-primary w-100" id="confirmBookingBtn">
                    <i class="fas fa-check-circle me-1"></i>
                    تایید و پرداخت
                </button>
                <a href="@Url.Action("SelectTime", "AppointmentBooking", new { area = "Patient", doctorId = Model.DoctorId, date = Model.AppointmentDate })" class="btn btn-outline-secondary w-100 mt-2">
                    <i class="fas fa-arrow-right me-1"></i>
                    بازگشت
                </a>
            </div>
        </fieldset>
    </form>
</div>

@section Scripts {
    <script>
        // ✅ CRITICAL FIX: Pass Reserve URL to JavaScript (instead of hardcoded)
        window.appConfig = window.appConfig || {};
        window.appConfig.appointmentBooking = window.appConfig.appointmentBooking || {};
        window.appConfig.appointmentBooking.reserveUrl = '@Url.Action("Reserve", "AppointmentBooking", new { area = "Patient" })';
        window.appConfig.appointmentBooking.selectTimeBaseUrl = '@Url.Action("SelectTime", "AppointmentBooking", new { area = "Patient" })';
        window.appConfig.appointmentBooking.selectDoctorUrl = '@Url.Action("SelectDoctor", "AppointmentBooking", new { area = "Patient" })';
        window.appConfig.appointmentBooking.myAppointmentsUrl = '@Url.Action("MyAppointments", "Appointment", new { area = "Patient" })';
        window.appConfig.appointmentBooking.processPaymentUrl = '@Url.Action("ProcessPayment", "AppointmentBooking", new { area = "Patient" })';
        // ✅ فاز ۲.۲: همگام‌سازی انتخاب نوع ویزیت با فیلد مخفی ارسالی به سرور
        (function () {
            var sel = document.getElementById('ServiceCategoryIdSelect');
            var hid = document.getElementById('ServiceCategoryId');
            if (sel && hid) {
                sel.addEventListener('change', function () { hid.value = this.value || ''; });
                hid.value = sel.value || '';
            }
        })();
    </script>
    <script src="~/Content/js/plugins/SweetAlert2/sweetalert2@11.js"></script>
    <script src="~/Scripts/patient/confirm-booking.js"></script>
    <script src="~/Scripts/patient/appointment-payment.js"></script>
}

