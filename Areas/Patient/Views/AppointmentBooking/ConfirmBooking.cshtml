@using ClinicApp.Extensions
@using ClinicApp.Helpers
@model ClinicApp.ViewModels.Patient.AppointmentBookingViewModel
@{
    ViewBag.Title = "تایید نهایی رزرو";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayout.cshtml";
}

@section Styles {
    <link href="~/Content/css/local-fonts.css" rel="stylesheet" />
    <link href="~/Content/css/medical-forms.css" rel="stylesheet" />
    <link href="~/Content/plugins/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <style>
        /* ✅ Mobile-First: Base styles for mobile */
        .page-header {
            background: linear-gradient(135deg, var(--medical-primary) 0%, var(--medical-primary-light) 100%);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            color: white;
            box-shadow: 0 2px 8px rgba(44, 90, 160, 0.2);
        }

        .page-header h2 {
            font-size: 1.5rem;
        }

        .summary-card {
            padding: 1rem;
        }

        .payment-form {
            padding: 1rem;
        }

        /* ✅ Tablet: 768px and up */
        @@media (min-width: 768px) {
            .page-header {
                padding: 2rem;
            }

            .page-header h2 {
                font-size: 2rem;
            }

            .summary-card {
                padding: 1.5rem;
            }

            .payment-form {
                padding: 1.5rem;
            }
        }

        /* ✅ Desktop: 992px and up */
        @@media (min-width: 992px) {
            .page-header {
                padding: 2.5rem;
            }
        }

        .summary-card {
            background: var(--medical-bg);
            border: 1px solid var(--medical-border-light);
            border-radius: 6px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .summary-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.75rem 0;
            border-bottom: 1px solid var(--medical-border-light);
        }

        .summary-item:last-child {
            border-bottom: none;
        }

        .summary-item-label {
            color: var(--medical-text-light);
            font-weight: 600;
        }

        .summary-item-value {
            color: var(--medical-text);
            font-weight: 400;
            text-align: left;
        }

        .price-section {
            background: var(--medical-bg-light);
            border: 1px solid var(--medical-border-light);
            border-radius: 6px;
            padding: 1.5rem;
            margin-top: 1rem;
        }

        .price-total {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--medical-primary);
        }

        .payment-form {
            background: var(--medical-bg);
            border: 1px solid var(--medical-border-light);
            border-radius: 6px;
            padding: 1.5rem;
        }

        .payment-method-card {
            border: 1px solid var(--medical-border);
            border-radius: 4px;
            padding: 1rem;
            margin-bottom: 1rem;
            cursor: pointer;
            transition: border-color 0.15s ease-in-out;
        }

        .payment-method-card:hover {
            border-color: var(--medical-primary);
        }

        .payment-method-card.selected {
            border-color: var(--medical-primary);
            background-color: rgba(0, 86, 179, 0.05);
        }
    </style>
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-check-circle me-2"></i>
                تایید نهایی رزرو
            </h2>
            <p class="mb-0 opacity-75">لطفاً اطلاعات را بررسی و تایید کنید</p>
        </div>
        <a href="@Url.Action("SelectTime", new { doctorId = Model.DoctorId, date = Model.AppointmentDate })" class="btn btn-light">
            <i class="fas fa-arrow-right me-1"></i>
            بازگشت
        </a>
    </div>
</div>

<!-- خلاصه اطلاعات -->
<div class="summary-card medical-form">
    <fieldset class="medical-form-section">
        <legend>خلاصه اطلاعات نوبت</legend>
        <div class="medical-form-summary">
            <div class="medical-form-summary-item">
                <span class="medical-form-summary-label">پزشک:</span>
                <span class="medical-form-summary-value">@Model.DoctorName</span>
            </div>
            <div class="medical-form-summary-item">
                <span class="medical-form-summary-label">تخصص:</span>
                <span class="medical-form-summary-value">@Model.DoctorSpecialization</span>
            </div>
            <div class="medical-form-summary-item">
                <span class="medical-form-summary-label">تاریخ:</span>
                <span class="medical-form-summary-value">@Model.AppointmentDate.ToPersianDate()</span>
            </div>
            <div class="medical-form-summary-item">
                <span class="medical-form-summary-label">زمان:</span>
                <span class="medical-form-summary-value">
                    @ClinicApp.Helpers.TimeFormatHelper.FormatTimeToPersian(Model.StartTime) - @ClinicApp.Helpers.TimeFormatHelper.FormatTimeToPersian(Model.EndTime)
                </span>
            </div>
            <div class="price-section">
                <div class="medical-form-summary-item">
                    <span class="medical-form-summary-label">مبلغ نوبت:</span>
                    <span class="price-total">@Model.Price.ToString("N0") تومان</span>
                </div>
            </div>
        </div>
    </fieldset>
</div>

<!-- فرم پرداخت -->
<div class="payment-form medical-form">
    <form id="bookingForm" method="post" action="@Url.Action("Reserve", "AppointmentBooking")">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.DoctorId)
        @Html.HiddenFor(m => m.AppointmentDate)
        @Html.HiddenFor(m => m.StartTime)
        @Html.HiddenFor(m => m.EndTime)
        @Html.HiddenFor(m => m.Price)
        @Html.HiddenFor(m => m.ServiceCategoryId)
        @Html.HiddenFor(m => m.Description)

        <fieldset class="medical-form-section">
            <legend>روش پرداخت</legend>
            
            <div class="form-group">
                <div class="payment-method-card selected" data-method="online">
                    <div class="d-flex align-items-center">
                        <div>
                            <h6 class="mb-1">پرداخت آنلاین</h6>
                            <small class="form-text">پرداخت از طریق درگاه بانکی</small>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="form-group">
                    <label for="Description" class="form-label">توضیحات (اختیاری)</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 3, placeholder = "توضیحات اضافی..." })
                    @Html.ValidationMessageFor(m => m.Description, "", new { @class = "invalid-feedback" })
                </div>
            }

            <div class="form-group mt-4">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
                <button type="submit" class="btn btn-primary w-100" id="confirmBookingBtn">
                    <i class="fas fa-check-circle me-1"></i>
                    تایید و پرداخت
                </button>
                <a href="@Url.Action("SelectTime", "AppointmentBooking", new { area = "Patient", doctorId = Model.DoctorId, date = Model.AppointmentDate })" class="btn btn-outline-secondary w-100 mt-2">
                    <i class="fas fa-arrow-right me-1"></i>
                    بازگشت
                </a>
            </div>
        </fieldset>
    </form>
</div>

@section Scripts {
    <script src="~/Content/plugins/sweetalert2/sweetalert2@11.js"></script>
    <script src="~/Scripts/patient/confirm-booking.js"></script>
    <script src="~/Scripts/patient/appointment-payment.js"></script>
}

