@using ClinicApp.Helpers
@using Microsoft.AspNet.Identity
@using System.Web
@{
    var appName = "کلینیک درمانی شفا";
    var title = ViewBag.Title ?? "پنل بیمار";
    var metaDescription = ViewBag.MetaDescription ?? "کلینیک درمانی شفا - رزرو نوبت آنلاین";
    var userId = User.Identity.GetUserId();
    var userName = User.Identity.GetUserName();
    var firstName = User.Identity.GetFirstName() ?? "";
    var lastName = User.Identity.GetLastName() ?? "";
    var fullName = !string.IsNullOrEmpty(firstName) && !string.IsNullOrEmpty(lastName) 
        ? $"{firstName} {lastName}" 
        : (!string.IsNullOrEmpty(firstName) ? firstName : userName);
    var userInitials = !string.IsNullOrEmpty(firstName) && !string.IsNullOrEmpty(lastName)
        ? $"{firstName[0]}{lastName[0]}"
        : (!string.IsNullOrEmpty(firstName) ? firstName[0].ToString() : "U");
}

<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    <meta name="description" content="@metaDescription">
    <meta name="author" content="@appName">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <!-- Security Headers -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:;">
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">

    <title>@title - @appName</title>

    <!-- ============================================
         CSS Loading Order (Enterprise Pattern)
         1. Fonts (Local first)
         2. Framework (Bootstrap)
         3. Plugins (SweetAlert, Toastr)
         4. Custom Styles (Page-specific)
    ============================================= -->
    
    <!-- 1️⃣ Fonts (Local - No CDN for Performance & Security) -->
    <link rel="stylesheet" href="~/Content/css/local-fonts.css">
    <link rel="stylesheet" href="~/Content/Fonts/fontawesome-free-6.7.2-web/css/all.min.css">

    <!-- 2️⃣ Framework CSS -->
    <link href="~/Content/bootstrap.rtl.min.css" rel="stylesheet" />

    <!-- 3️⃣ Plugin CSS -->
    <link href="~/Content/js/plugins/SweetAlert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/Content/js/plugins/toastr/toastr.min.css" rel="stylesheet" />

    <!-- Patient Portal Layout — حرفه‌ای، مدرن، درمانی (اعتماد، راحتی، خرسندی) -->
    <link rel="stylesheet" href="~/Content/css/patient-layout.css" />

    @RenderSection("Styles", required: false)
</head>
<body class="patient-portal-body" data-booking-step="@ViewBag.BookingStep" data-booking-total="@ViewBag.BookingTotal">
    <!-- Top Navbar -->
    <nav class="patient-navbar-top">
        <div class="navbar-left">
            <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="باز و بسته کردن منوی کناری" aria-expanded="false" aria-controls="patientSidebar">
                <i class="fas fa-bars"></i>
            </button>
            <a class="navbar-brand" href="@Url.Action("Index", "Home", new { area = "" })">
                <i class="fas fa-hospital"></i>
                <span>@appName</span>
            </a>
        </div>

        <div class="navbar-right">
            <div class="navbar-notifications dropdown" role="group" aria-label="اعلان‌ها">
                <button type="button" class="navbar-notifications-btn dropdown-toggle" id="patientNotificationsToggle" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true" title="اعلان‌ها">
                    <i class="fas fa-bell"></i>
                    <span class="notification-badge" id="patientNotificationBadge" style="display: none;">0</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end patient-notifications-dropdown" aria-labelledby="patientNotificationsToggle" id="patientNotificationsList">
                    <li class="dropdown-header text-muted small">در حال بارگذاری...</li>
                </ul>
            </div>

            <div class="navbar-user dropdown">
                <button class="navbar-user-button" type="button" id="userMenuToggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="user-avatar">@userInitials</div>
                    <span class="user-name">@fullName</span>
                    <i class="fas fa-chevron-down"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end user-dropdown" aria-labelledby="userMenuToggle">
                    <li class="dropdown-header">
                        <div class="user-info-header">
                            <div class="user-avatar-large">@userInitials</div>
                            <div>
                                <div class="user-name-large">@fullName</div>
                                <div class="user-email-small">@userName</div>
                            </div>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })#overview"><i class="fas fa-tachometer-alt ml-2"></i> داشبورد</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })#profile"><i class="fas fa-user-circle ml-2"></i> پروفایل من</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })#appointments"><i class="fas fa-calendar-check ml-2"></i> نوبت‌های من</a></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })#medical-record"><i class="fas fa-file-medical ml-2"></i> پرونده الکترونیک</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })#settings"><i class="fas fa-cog ml-2"></i> تنظیمات</a></li>
                    <li>
                        <form method="POST" action="@Url.Action("LogOff", "Account", new { area = "" })" id="topbarLogoutForm">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="fas fa-sign-out-alt ml-2"></i> خروج
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    <aside class="patient-sidebar" id="patientSidebar">
        <div class="sidebar-header">
            <div class="sidebar-user-avatar">@userInitials</div>
            <div class="sidebar-user-name">@fullName</div>
            <div class="sidebar-user-role">بیمار</div>
        </div>

        <nav class="sidebar-nav">
            <div class="sidebar-nav-item">
                <a href="@Url.Action("Index", "Dashboard", new { area = "Patient" })" class="sidebar-nav-link">
                    <i class="sidebar-nav-icon fas fa-tachometer-alt"></i>
                    <span class="sidebar-nav-text">داشبورد</span>
                </a>
            </div>

            <div class="sidebar-nav-item">
                <a href="@(Url.Action("Index", "Dashboard", new { area = "Patient" }))#profile" class="sidebar-nav-link" data-dashboard-tab="profile">
                    <i class="sidebar-nav-icon fas fa-user"></i>
                    <span class="sidebar-nav-text">پروفایل من</span>
                </a>
            </div>

            <div class="sidebar-nav-item">
                <a href="@(Url.Action("Index", "Dashboard", new { area = "Patient" }))#appointments" class="sidebar-nav-link" data-dashboard-tab="appointments">
                    <i class="sidebar-nav-icon fas fa-calendar-check"></i>
                    <span class="sidebar-nav-text">نوبت‌های من</span>
                </a>
            </div>

            <div class="sidebar-nav-item">
                <a href="@Url.Action("SelectDoctor", "AppointmentBooking", new { area = "Patient" })" class="sidebar-nav-link">
                    <i class="sidebar-nav-icon fas fa-calendar-plus"></i>
                    <span class="sidebar-nav-text">رزرو نوبت جدید</span>
                </a>
            </div>

            <div class="sidebar-nav-item">
                <a href="@(Url.Action("Index", "Dashboard", new { area = "Patient" }))#medical-record" class="sidebar-nav-link" data-dashboard-tab="medical-record">
                    <i class="sidebar-nav-icon fas fa-file-medical"></i>
                    <span class="sidebar-nav-text">پرونده الکترونیک</span>
                </a>
            </div>

            <div class="sidebar-nav-item">
                <a href="#" class="sidebar-nav-link">
                    <i class="sidebar-nav-icon fas fa-chart-bar"></i>
                    <span class="sidebar-nav-text">گزارش‌ها</span>
                </a>
            </div>

            <div class="sidebar-nav-item">
                <a href="@(Url.Action("Index", "Dashboard", new { area = "Patient" }))#settings" class="sidebar-nav-link" data-dashboard-tab="settings">
                    <i class="sidebar-nav-icon fas fa-cog"></i>
                    <span class="sidebar-nav-text">تنظیمات</span>
                </a>
            </div>

            <hr style="margin: 1rem 1rem; border-color: var(--sidebar-border);" />

            <div class="sidebar-nav-item">
                <a href="#" class="sidebar-nav-link" id="sidebarHelpLink" data-bs-toggle="modal" data-bs-target="#patientHelpModal" aria-label="راهنما">
                    <i class="sidebar-nav-icon fas fa-question-circle"></i>
                    <span class="sidebar-nav-text">راهنما</span>
                </a>
            </div>

            <div class="sidebar-nav-item">
                <form id="logoutFormSidebar" method="post" action="@Url.Content("~/Account/LogOff")" style="margin: 0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" id="sidebarLogoutBtn" class="sidebar-nav-link" style="width: 100%; background: none; border: none; cursor: pointer; text-align: right; font: inherit;">
                        <i class="sidebar-nav-icon fas fa-sign-out-alt"></i>
                        <span class="sidebar-nav-text">خروج</span>
                    </button>
                </form>
            </div>
        </nav>
    </aside>

    <!-- Sidebar Overlay (Mobile) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Main Content -->
    <main class="patient-content" id="patientContent">
        <!-- Breadcrumb -->
        <div class="breadcrumb-container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home", new { area = "" })">خانه</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@title</li>
                </ol>
            </nav>
        </div>

        @RenderBody()
    </main>

    <!-- ✅ Loading Overlay (برای showLoading/hideLoading) -->
    <div id="loadingOverlay" class="loading-overlay patient-layout-loading">
        <div class="loading-spinner">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">در حال بارگذاری...</span>
            </div>
            <p class="mt-3 mb-0" style="color: #2c5aa0; font-weight: 600;">در حال پردازش...</p>
        </div>
    </div>

    <!-- Footer -->
    <footer class="patient-footer" role="contentinfo">
        <p class="mb-0 patient-footer-brand">
            <i class="fas fa-hospital me-2" aria-hidden="true"></i>
            @appName — تمامی حقوق محفوظ است
        </p>
        <p class="mb-0 mt-2 patient-footer-year">
            © @DateTime.Now.Year
        </p>
        <p class="mb-0 mt-1 patient-footer-trust small">
            حریم خصوصی و امنیت اطلاعات شما برای ما اهمیت دارد.
        </p>
    </footer>

    <!-- ✅ مودال راهنمای داشبورد بیمار -->
    <div class="modal fade" id="patientHelpModal" tabindex="-1" aria-labelledby="patientHelpModalLabel" aria-hidden="true" dir="rtl">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="patientHelpModalLabel">
                        <i class="fas fa-question-circle me-2"></i>
                        راهنمای پنل بیمار
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="بستن"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-4">
                        <h6 class="text-primary border-bottom pb-2 mb-2">
                            <i class="fas fa-home me-1"></i>
                            خانه (داشبورد)
                        </h6>
                        <p class="text-muted small mb-0">خلاصه وضعیت، نوبت‌های پیش‌رو و دسترسی سریع به بخش‌های مختلف را مشاهده می‌کنید.</p>
                    </div>
                    <div class="mb-4">
                        <h6 class="text-primary border-bottom pb-2 mb-2">
                            <i class="fas fa-user me-1"></i>
                            پروفایل من
                        </h6>
                        <p class="text-muted small mb-0">اطلاعات شخصی، شماره تماس، ایمیل و تاریخ تولد را ویرایش کنید.</p>
                    </div>
                    <div class="mb-4">
                        <h6 class="text-primary border-bottom pb-2 mb-2">
                            <i class="fas fa-calendar-check me-1"></i>
                            نوبت‌های من
                        </h6>
                        <p class="text-muted small mb-0">لیست نوبت‌های رزرو شده، فیلتر بر اساس تاریخ و وضعیت، و امکان مشاهده جزئیات هر نوبت.</p>
                    </div>
                    <div class="mb-4">
                        <h6 class="text-primary border-bottom pb-2 mb-2">
                            <i class="fas fa-calendar-plus me-1"></i>
                            رزرو نوبت جدید
                        </h6>
                        <p class="text-muted small mb-0">انتخاب پزشک، تاریخ و ساعت برای رزرو نوبت جدید.</p>
                    </div>
                    <div class="mb-4">
                        <h6 class="text-primary border-bottom pb-2 mb-2">
                            <i class="fas fa-file-medical me-1"></i>
                            پرونده الکترونیک
                        </h6>
                        <p class="text-muted small mb-0">مشاهده تریاژ، سوابق ویزیت‌ها و اطلاعات پرونده پزشکی شما.</p>
                    </div>
                    <div class="mb-4">
                        <h6 class="text-primary border-bottom pb-2 mb-2">
                            <i class="fas fa-cog me-1"></i>
                            تنظیمات
                        </h6>
                        <p class="text-muted small mb-0">تنظیمات حساب کاربری و اعلان‌ها (ایمیل، پیامک، یادآوری نوبت).</p>
                    </div>
                    <div class="alert alert-info mb-0 small">
                        <i class="fas fa-info-circle me-1"></i>
                        برای پشتیبانی با واحد پذیرش کلینیک تماس بگیرید.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================
         JavaScript Loading Order (Enterprise Pattern)
         1. Core Libraries (jQuery, Bootstrap) - MUST be first
         2. Plugins (SweetAlert, Toastr)
         3. Helper Modules (NotificationHelper)
         4. Page-specific Scripts (RenderSection)
         
         CRITICAL: jQuery MUST load before any jQuery-dependent code
    ============================================= -->
    
    <!-- 1️⃣ Core Libraries (Foundation) -->
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    
    <!-- 2️⃣ UI Plugins -->
    <script src="~/Content/js/plugins/SweetAlert2/sweetalert2@11.js"></script>
    <script src="~/Content/js/plugins/toastr/toastr.min.js"></script>
    
    <!-- 3️⃣ Application Helpers -->
    <script src="~/Content/js/notification-helper.js"></script>
    <script src="~/Content/js/patient-profile.js"></script>
    
    <!-- ✅ JalaliDatePicker Enterprise (Production-Ready) -->
    <!-- طبق قراردادها - Docs/DEVELOPMENT_CONTRACT.md -->
    <link href="~/Content/js/plugins/PersianDateTimePicker/jalalidatepicker.min.css" rel="stylesheet" />
    <link href="~/Content/css/jalali-datepicker-enterprise.css" rel="stylesheet" />
    <!-- ✅ CRITICAL: jalaali.js باید قبل از jalalidatepicker.min.js لود شود -->
    <script src="~/Content/js/plugins/PersianDateTimePicker/jalaali.js"></script>
    <script src="~/Content/js/plugins/PersianDateTimePicker/jalalidatepicker.min.js"></script>
    <script src="~/Content/js/jalali-datepicker-enterprise.js"></script>

    <!-- 4️⃣ Page-Specific Scripts (Loaded AFTER all dependencies) -->
    @RenderSection("Scripts", required: false)

    <!-- ✅ Appointment Booking Progress Indicator (Auto-init) -->
    @if (ViewBag.BookingStep != null)
    {
        <script src="~/Content/js/appointment-booking-progress.js"></script>
    }

    <script>
        // ✅ Global loading overlay functions (برای استفاده در time-selection.js)
        function showLoading() {
            var $overlay = $('#loadingOverlay');
            if ($overlay.length === 0) {
                // ✅ اگر loadingOverlay وجود ندارد، ایجاد می‌کنیم
                $('body').append(`
                    <div id="loadingOverlay" class="loading-overlay patient-layout-loading">
                        <div class="loading-spinner">
                            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">در حال بارگذاری...</span>
                            </div>
                            <p class="mt-3 mb-0" style="color: #2c5aa0; font-weight: 600;">در حال پردازش...</p>
                        </div>
                    </div>
                `);
                $overlay = $('#loadingOverlay');
            }
            $overlay.addClass('active');
        }

        function hideLoading() {
            $('#loadingOverlay').removeClass('active');
        }

        // ✅ Sidebar and other initialization
        (function() {
            'use strict';

            // ✅ Sidebar Toggle
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('patientSidebar');
            const sidebarOverlay = document.getElementById('sidebarOverlay');
            const content = document.getElementById('patientContent');

            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', function() {
                    var isOpen = sidebar.classList.toggle('show');
                    sidebarOverlay.classList.toggle('show', isOpen);
                    sidebarToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                });
            }

            if (sidebarOverlay) {
                sidebarOverlay.addEventListener('click', function() {
                    sidebar.classList.remove('show');
                    sidebarOverlay.classList.remove('show');
                    if (sidebarToggle) sidebarToggle.setAttribute('aria-expanded', 'false');
                });
            }

            // ✅ Active Menu Highlighting (فقط لینک‌های <a> تا با دکمه خروج تداخل نگیرد)
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.sidebar-nav-item a.sidebar-nav-link');
            navLinks.forEach(link => {
                var href = link.getAttribute('href') || '';
                if (href === currentPath || (currentPath.indexOf('/Patient/Dashboard') !== -1 && href.indexOf('#') !== -1 && link.getAttribute('data-dashboard-tab'))) {
                    link.classList.add('active');
                }
            });

            // ✅ راهنما: جلوگیری از اضافه شدن # به آدرس با کلیک روی لینک راهنما
            var helpLink = document.getElementById('sidebarHelpLink');
            if (helpLink) {
                helpLink.addEventListener('click', function(e) {
                    if (this.getAttribute('href') === '#') e.preventDefault();
                });
            }

            // ✅ اعلان‌های ویزیت آنلاین (زنگوله)
            (function loadPatientNotifications() {
                var apiUrl = '@Url.Action("GetOnlineConsultationNotifications", "PatientDashboardApi", new { area = "Patient" })';
                var listEl = document.getElementById('patientNotificationsList');
                var badgeEl = document.getElementById('patientNotificationBadge');
                if (!listEl || !apiUrl) return;
                fetch(apiUrl, { credentials: 'same-origin' })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (!data || !data.success) {
                            listEl.innerHTML = '<li class="dropdown-header text-muted small">اعلانی نیست</li>';
                            return;
                        }
                        var payload = data.data || {};
                        var items = payload.items || [];
                        var count = payload.count != null ? payload.count : items.length;
                        if (badgeEl) {
                            badgeEl.textContent = count > 99 ? '99+' : count;
                            badgeEl.style.display = count > 0 ? '' : 'none';
                        }
                        if (items.length === 0) {
                            listEl.innerHTML = '<li class="dropdown-header text-muted small">اعلانی نیست</li>';
                            return;
                        }
                        listEl.innerHTML = items.map(function(item) {
                            return '<li><a class="dropdown-item d-flex align-items-center" href="' + (item.joinUrl || '#') + '"><i class="fas fa-video ml-2 text-primary"></i><span><strong>ویزیت آنلاین</strong> — ' + (item.doctorName || 'پزشک') + '<br><small class="text-muted">' + (item.dateShamsi || '') + ' ' + (item.timeText || '') + '</small></span></a></li>';
                        }).join('') + '<li><hr class="dropdown-divider"></li><li><a class="dropdown-item small text-center" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })#appointments"><i class="fas fa-calendar-check ml-1"></i> همه نوبت‌ها</a></li>';
                    })
                    .catch(function() {
                        listEl.innerHTML = '<li class="dropdown-header text-muted small">خطا در بارگذاری اعلان‌ها</li>';
                    });
            })();

            // ✅ Toastr Configuration
            if (typeof toastr !== 'undefined') {
                toastr.options = {
                    closeButton: true,
                    progressBar: true,
                    positionClass: 'toast-top-left',
                    timeOut: 5000
                };
            }

            // ✅ CRITICAL FIX: Display TempData Notifications (طبق قرارداد)
            // استفاده از NotificationHelper.Get* به جای دسترسی مستقیم به TempData
            @{
                var successMsg = ClinicApp.Helpers.NotificationHelper.GetSuccess(TempData);
                var errorMsg = ClinicApp.Helpers.NotificationHelper.GetError(TempData);
                var warningMsg = ClinicApp.Helpers.NotificationHelper.GetWarning(TempData);
                var infoMsg = ClinicApp.Helpers.NotificationHelper.GetInfo(TempData);
            }
            @if (successMsg != null)
            {
                <text>
                if (typeof Notify !== 'undefined') {
                    Notify.success('@Html.Raw(HttpUtility.JavaScriptStringEncode(successMsg.Message))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(successMsg.Title))');
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(successMsg.Title))',
                        text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(successMsg.Message))',
                        icon: 'success',
                        confirmButtonText: 'باشه'
                    });
                }
                </text>
            }
            @if (errorMsg != null)
            {
                <text>
                if (typeof Notify !== 'undefined') {
                    Notify.error('@Html.Raw(HttpUtility.JavaScriptStringEncode(errorMsg.Message))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(errorMsg.Title))');
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(errorMsg.Title))',
                        text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(errorMsg.Message))',
                        icon: 'error',
                        confirmButtonText: 'باشه'
                    });
                }
                </text>
            }
            @if (warningMsg != null)
            {
                <text>
                if (typeof Notify !== 'undefined') {
                    Notify.warning('@Html.Raw(HttpUtility.JavaScriptStringEncode(warningMsg.Message))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(warningMsg.Title))');
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(warningMsg.Title))',
                        text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(warningMsg.Message))',
                        icon: 'warning',
                        confirmButtonText: 'باشه'
                    });
                }
                </text>
            }
            @if (infoMsg != null)
            {
                <text>
                if (typeof Notify !== 'undefined') {
                    Notify.info('@Html.Raw(HttpUtility.JavaScriptStringEncode(infoMsg.Message))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(infoMsg.Title))');
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(infoMsg.Title))',
                        text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(infoMsg.Message))',
                        icon: 'info',
                        confirmButtonText: 'باشه'
                    });
                }
                </text>
            }
        })();
    </script>
</body>
</html>

