@model ClinicApp.Models.DTOs.Appointment.AvailableTimeSlotDto

@* ✅ PREMIUM DESIGN: طراحی حرفه‌ای و جذاب با انیمیشن‌های نرم *@
<div class="time-slot-premium @(Model.IsAvailable ? "slot-available" : "slot-booked")" 
     data-start-time="@Model.StartTime.ToString(@"hh\:mm")" 
     data-end-time="@Model.EndTime.ToString(@"hh\:mm")"
     data-is-available="@Model.IsAvailable.ToString().ToLower()">
    <div class="slot-header">
        <div class="slot-time-wrapper">
            <span class="slot-time-display">@Model.DisplayTime</span>
            <span class="slot-duration-badge">@Model.Duration دقیقه</span>
        </div>
        @if (Model.IsAvailable)
        {
            <div class="slot-status-indicator available-indicator">
                <i class="fas fa-circle"></i>
                <span>در دسترس</span>
            </div>
        }
        else
        {
            <div class="slot-status-indicator booked-indicator">
                <i class="fas fa-lock"></i>
                <span>رزرو شده</span>
            </div>
        }
    </div>
    
    <div class="slot-range-display">
        @Model.DisplayRange
    </div>
    
    @if (Model.IsAvailable)
    {
        <button type="button" class="btn-slot-premium">
            <i class="fas fa-check-circle"></i>
            <span>انتخاب این زمان</span>
        </button>
    }
    else
    {
        <div class="slot-booked-premium">
            <i class="fas fa-user-check"></i>
            <span>این زمان رزرو شده است</span>
        </div>
    }
</div>

