@model ClinicApp.Models.DTOs.Appointment.AvailableTimeSlotDto

@* Partial View برای نمایش کارت اسلات زمانی - رعایت SRP: فقط نمایش یک اسلات زمانی *@
<div class="time-slot-card @(Model.IsAvailable ? "available" : "unavailable")" 
     data-start-time="@Model.StartTime.ToString(@"hh\:mm")" 
     data-end-time="@Model.EndTime.ToString(@"hh\:mm")"
     data-is-available="@Model.IsAvailable.ToString().ToLower()">
    <div class="slot-content">
        <div class="slot-time">
            <i class="fas fa-clock me-2"></i>
            <strong>@Model.DisplayTime</strong>
        </div>
        <div class="slot-range text-muted small">
            @Model.DisplayRange
        </div>
        <div class="slot-duration text-muted small">
            <i class="fas fa-hourglass-half me-1"></i>
            @Model.Duration دقیقه
        </div>
        @if (Model.IsAvailable)
        {
            <button type="button" class="btn btn-sm btn-primary select-slot-btn w-100 mt-2">
                <i class="fas fa-check-circle me-1"></i>
                انتخاب
            </button>
        }
        else
        {
            <button type="button" class="btn btn-sm btn-secondary w-100 mt-2" disabled>
                <i class="fas fa-times-circle me-1"></i>
                غیرقابل رزرو
            </button>
        }
    </div>
</div>

<style>
    .time-slot-card {
        border: 2px solid var(--medical-border);
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        background: white;
        cursor: pointer;
        text-align: center;
    }

    .time-slot-card.available {
        border-color: var(--medical-success);
        background: linear-gradient(135deg, #f8fff9 0%, #ffffff 100%);
    }

    .time-slot-card.available:hover {
        border-color: var(--medical-primary);
        box-shadow: 0 4px 16px rgba(44, 90, 160, 0.15);
        transform: translateY(-2px);
        background: linear-gradient(135deg, #e8f5e9 0%, #ffffff 100%);
    }

    .time-slot-card.unavailable {
        border-color: #e0e0e0;
        background: #f5f5f5;
        opacity: 0.6;
        cursor: not-allowed;
    }

    .slot-content {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .slot-time {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--medical-primary);
        margin-bottom: 0.5rem;
    }

    .slot-range {
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
    }

    .slot-duration {
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
    }

    .select-slot-btn {
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .select-slot-btn:hover {
        transform: scale(1.05);
        box-shadow: 0 4px 12px rgba(44, 90, 160, 0.3);
    }

    .time-slot-card.selected {
        border-color: var(--medical-primary);
        background: linear-gradient(135deg, var(--medical-primary-light) 0%, var(--medical-primary) 100%);
        color: white;
    }

    .time-slot-card.selected .slot-time,
    .time-slot-card.selected .slot-range,
    .time-slot-card.selected .slot-duration {
        color: white;
    }
</style>

