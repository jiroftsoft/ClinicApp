@model ClinicApp.Models.DTOs.Appointment.AvailableTimeSlotDto

@* Partial View برای نمایش کارت اسلات زمانی - رعایت SRP: فقط نمایش یک اسلات زمانی *@
<div class="time-slot-card @(Model.IsAvailable ? "available" : "unavailable")" 
     data-start-time="@Model.StartTime.ToString(@"hh\:mm")" 
     data-end-time="@Model.EndTime.ToString(@"hh\:mm")"
     data-is-available="@Model.IsAvailable.ToString().ToLower()">
    <div class="slot-content">
        <div class="slot-time">
            <i class="fas fa-clock me-2"></i>
            <strong>@Model.DisplayTime</strong>
        </div>
        <div class="slot-range text-muted small">
            @Model.DisplayRange
        </div>
        <div class="slot-duration text-muted small">
            <i class="fas fa-hourglass-half me-1"></i>
            @Model.Duration دقیقه
        </div>
        @if (Model.IsAvailable)
        {
            <button type="button" class="btn btn-sm btn-primary select-slot-btn w-100 mt-2">
                <i class="fas fa-check-circle me-1"></i>
                انتخاب
            </button>
        }
        else
        {
            <button type="button" class="btn btn-sm btn-secondary w-100 mt-2" disabled>
                <i class="fas fa-times-circle me-1"></i>
                غیرقابل رزرو
            </button>
        }
    </div>
</div>
