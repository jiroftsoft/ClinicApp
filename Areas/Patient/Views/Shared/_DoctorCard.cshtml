@model ClinicApp.Models.DTOs.Appointment.DoctorSearchResultDto

@* Partial View برای نمایش کارت پزشک - رعایت SRP: فقط نمایش یک پزشک *@
<div class="doctor-card card mb-3" data-doctor-id="@Model.DoctorId">
    <div class="card-body">
        <div class="row">
            <div class="col-md-8">
                <div class="d-flex align-items-center mb-2">
                    <div class="doctor-avatar me-3">
                        <i class="fas fa-user-md text-primary fs-1"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-1">@Model.FullName</h5>
                        <p class="text-muted mb-1">
                            <i class="fas fa-stethoscope me-1"></i>
                            @Model.Specialization
                        </p>
                        @if (!string.IsNullOrEmpty(Model.MedicalCouncilCode))
                        {
                            <p class="text-muted mb-0 small">
                                <i class="fas fa-id-card me-1"></i>
                                کد نظام پزشکی: @Model.MedicalCouncilCode
                            </p>
                        }
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.DepartmentName))
                {
                    <p class="text-muted mb-2">
                        <i class="fas fa-building me-1"></i>
                        @Model.DepartmentName
                    </p>
                }
                <p class="text-info mb-0">
                    <i class="fas fa-calendar-check me-1"></i>
                    @Model.ScheduleInfo
                </p>
            </div>
            <div class="col-md-4 text-end d-flex flex-column justify-content-between">
                <div>
                    @if (Model.HasActiveSchedule)
                    {
                        <span class="badge bg-success mb-2">
                            <i class="fas fa-check-circle me-1"></i>
                            در دسترس
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary mb-2">
                            <i class="fas fa-times-circle me-1"></i>
                            غیرفعال
                        </span>
                    }
                </div>
                @if (Model.HasActiveSchedule)
                {
                    // ✅ CRITICAL FIX: استفاده از Url.Action با area برای اطمینان از Route Resolution صحیح
                    // مشکل: Url.RouteUrl برای Area routes ممکن است area را در نظر نگیرد
                    var selectDateUrl = Url.Action("SelectDate", "AppointmentBooking", new { area = "Patient", doctorId = Model.DoctorId });
                    
                    // ✅ Fallback 1: اگر Url.Action null برگرداند، از RouteUrl استفاده کن
                    if (string.IsNullOrEmpty(selectDateUrl))
                    {
                        selectDateUrl = Url.RouteUrl("Patient_AppointmentBooking_SelectDate", new { area = "Patient", doctorId = Model.DoctorId });
                    }
                    
                    // ✅ Fallback 2: اگر هنوز null است، از route pattern مستقیم استفاده کن
                    if (string.IsNullOrEmpty(selectDateUrl))
                    {
                        selectDateUrl = $"/Patient/Appointment/Book/SelectDate/{Model.DoctorId}";
                    }
                    
                    // ✅ CRITICAL FIX: اطمینان از اینکه URL معتبر است و به Home اشاره نمی‌کند
                    if (string.IsNullOrEmpty(selectDateUrl) || 
                        selectDateUrl == "/" || 
                        selectDateUrl.Contains("/Home") || 
                        !selectDateUrl.Contains("SelectDate"))
                    {
                        // ✅ Final Fallback: استفاده از route pattern مستقیم
                        selectDateUrl = $"/Patient/Appointment/Book/SelectDate/{Model.DoctorId}";
                    }
                    
                    <a href="@selectDateUrl" 
                       class="btn btn-primary w-100 select-doctor-btn" 
                       data-doctor-id="@Model.DoctorId"
                       data-href="@selectDateUrl">
                        <i class="fas fa-calendar-plus me-1"></i>
                        انتخاب پزشک
                    </a>
                    
                    @* ✅ DEBUGGING: نمایش URL تولید شده (فقط در Debug Mode) *@
                    if (this.Context.IsDebuggingEnabled)
                    {
                        <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                            🔍 Debug: URL = @selectDateUrl
                        </small>
                    }
                }
                else
                {
                    <button type="button" class="btn btn-secondary w-100" disabled>
                        <i class="fas fa-times-circle me-1"></i>
                        غیرفعال
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .doctor-card {
        border: 1px solid var(--medical-border);
        border-radius: 12px;
        transition: all 0.3s ease;
        background: white;
    }

    .doctor-card:hover {
        box-shadow: 0 4px 16px rgba(44, 90, 160, 0.12);
        transform: translateY(-2px);
        border-color: var(--medical-primary);
    }

    .doctor-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        /* ✅ FIX Issue 6: حذف Gradient و استفاده از رنگ ساده (طبق SELECT_DOCTOR_MODULE_REVIEW.md) */
        background: var(--medical-primary, #2c5aa0);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white !important;
    }

    .select-doctor-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>

