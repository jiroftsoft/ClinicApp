@using ClinicApp.Extensions
@model ClinicApp.Models.DTOs.Appointment.PatientAppointmentDto

@* ✅ Partial View برای نمایش کارت نوبت - طبق پرامپت *@
<div class="appointment-card-medical mb-3" data-appointment-id="@Model.AppointmentId">
    <div class="card-body p-3 p-md-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center mb-2">
                    <i class="fas fa-user-md text-medical-primary me-2 fs-4"></i>
                    <h5 class="card-title mb-0 text-medical-primary">@Model.DoctorName</h5>
                </div>
                <p class="text-medical-text-muted mb-1">
                    <i class="fas fa-stethoscope me-1"></i>
                    @Model.DoctorSpecialization
                </p>
                <p class="text-medical-text-muted mb-1">
                    <i class="fas fa-calendar-alt me-1"></i>
                    @Model.AppointmentDate.ToPersianDate()
                </p>
                <p class="text-medical-text-muted mb-1">
                    <i class="fas fa-clock me-1"></i>
                    @Model.AppointmentTime
                </p>
                <p class="text-medical-text-muted mb-0">
                    <i class="fas fa-hospital me-1"></i>
                    @Model.ClinicName - @Model.DepartmentName
                </p>
            </div>
            <div class="col-md-4 text-end">
                @switch (Model.Status)
                {
                    case ClinicApp.Models.Enums.AppointmentStatus.Scheduled:
                        <span class="badge badge-medical-success mb-2">
                            <i class="fas fa-check-circle ml-1"></i>
                            @Model.StatusDisplay
                        </span>
                        break;
                    case ClinicApp.Models.Enums.AppointmentStatus.Completed:
                        <span class="badge badge-medical-info mb-2">
                            <i class="fas fa-check-double ml-1"></i>
                            @Model.StatusDisplay
                        </span>
                        break;
                    case ClinicApp.Models.Enums.AppointmentStatus.Cancelled:
                        <span class="badge badge-medical-danger mb-2">
                            <i class="fas fa-times-circle ml-1"></i>
                            @Model.StatusDisplay
                        </span>
                        break;
                    case ClinicApp.Models.Enums.AppointmentStatus.Pending:
                        <span class="badge badge-medical-warning mb-2">
                            <i class="fas fa-clock ml-1"></i>
                            @Model.StatusDisplay
                        </span>
                        break;
                }
                <p class="mb-2">
                    <strong class="text-medical-primary">@Model.Price.ToString("N0")</strong> <small>تومان</small>
                </p>
                <div class="btn-group-vertical w-100" role="group">
                    <button type="button" class="btn btn-sm btn-outline-medical-info view-details-btn" data-appointment-id="@Model.AppointmentId">
                        <i class="fas fa-eye ml-1"></i>
                        جزئیات
                    </button>
                    @if (Model.Status == ClinicApp.Models.Enums.AppointmentStatus.Scheduled)
                    {
                        <button type="button" class="btn btn-sm btn-outline-medical-danger cancel-appointment-btn mt-2" data-appointment-id="@Model.AppointmentId">
                            <i class="fas fa-times ml-1"></i>
                            لغو نوبت
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

