@using Org.BouncyCastle.Asn1.Ocsp
@model ClinicApp.ViewModels.Patient.DoctorDetailsViewModel
@{
    ViewBag.Title = "جزئیات پزشک";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayout.cshtml";
}

@section Styles {
    <link href="~/Content/plugins/persian-datepicker/persian-datepicker.min.css" rel="stylesheet" />
    <link href="~/Content/plugins/toastr/toastr.min.css" rel="stylesheet" />
    <link href="~/Content/css/local-fonts.css" rel="stylesheet" />
    <style>
        :root {
            --medical-primary: #2c5aa0;
            --medical-primary-light: #3d6bb3;
            --medical-secondary: #6c757d;
            --medical-success: #28a745;
            --medical-border: #dee2e6;
            --medical-text: #495057;
            --medical-bg: #f8f9fa;
        }

        * {
            font-family: 'Vazir', 'Tahoma', Arial, sans-serif;
        }

        .page-header {
            background: linear-gradient(135deg, var(--medical-primary) 0%, var(--medical-primary-light) 100%);
            border-radius: 20px;
            padding: 2.5rem;
            margin-bottom: 2rem;
            color: white;
            box-shadow: 0 8px 24px rgba(44, 90, 160, 0.3);
        }

        .doctor-profile-card {
            background: white;
            border-radius: 20px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 4px 16px rgba(0,0,0,0.1);
        }

        .doctor-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--medical-primary) 0%, var(--medical-primary-light) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 3rem;
            font-weight: bold;
            margin: 0 auto 1.5rem;
        }

        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(44, 90, 160, 0.2);
            border-color: var(--medical-primary);
        }

        .stat-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--medical-primary);
            margin-bottom: 0.5rem;
        }

        .stat-label {
            font-size: 0.9rem;
            color: var(--medical-secondary);
        }

        .schedule-card {
            background: white;
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .schedule-day {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem;
            margin-bottom: 0.5rem;
            border-radius: 12px;
            background: var(--medical-bg);
            transition: all 0.2s ease;
        }

        .schedule-day:hover {
            background: #e9ecef;
        }

        .time-slot-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .time-slot {
            padding: 1rem;
            border: 2px solid var(--medical-border);
            border-radius: 12px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            background: white;
            font-weight: 500;
        }

        .time-slot:hover {
            border-color: var(--medical-primary);
            background: #f0f7ff;
            transform: scale(1.05);
        }

        .time-slot.selected {
            border-color: var(--medical-success);
            background: #d4edda;
            color: var(--medical-success);
            font-weight: bold;
        }

        .time-slot.unavailable {
            opacity: 0.6;
            cursor: not-allowed;
            background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
            border-color: #ffc107;
            position: relative;
        }

        .time-slot.unavailable::after {
            content: 'پر شده';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(255, 193, 7, 0.9);
            color: #856404;
            padding: 0.25rem 0.5rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: bold;
            z-index: 1;
        }

        .time-slot.unavailable:hover {
            transform: none;
            border-color: #ffc107;
        }

        .selected-date-display {
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            border-radius: 16px;
            padding: 1.25rem 1.5rem;
            margin-bottom: 1.5rem;
            border-right: 4px solid var(--medical-primary);
            box-shadow: 0 4px 12px rgba(44, 90, 160, 0.15);
            animation: slideInDown 0.4s ease-out;
        }

        .selected-date-content {
            display: flex;
            align-items: center;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--medical-primary);
        }

        .selected-date-content i {
            font-size: 1.3rem;
            color: var(--medical-primary);
        }

        .slots-count-badge {
            background: var(--medical-primary);
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
            margin-right: 0.5rem;
        }

        @@keyframes slideInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .bio-section {
            background: white;
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--medical-primary) 0%, var(--medical-primary-light) 100%);
            border: none;
            border-radius: 12px;
            padding: 1rem 2rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(44, 90, 160, 0.3);
        }

        @@media (max-width: 768px) {
            .time-slot-grid {
                grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
                gap: 0.5rem;
            }

            .page-header {
                padding: 1.5rem;
            }

            .doctor-profile-card {
                padding: 1.5rem;
            }
        }
    </style>
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h2 class="mb-2" style="font-weight: 700;">
                <i class="fas fa-user-md me-2"></i>
                جزئیات پزشک
            </h2>
            <p class="mb-0 opacity-90">مشاهده اطلاعات، رزومه و رزرو نوبت</p>
        </div>
        <a href="@Url.Action("Available")" class="btn btn-light mt-2 mt-md-0">
            <i class="fas fa-arrow-right me-1"></i>
            بازگشت
        </a>
    </div>
</div>

@if (Model.Doctor != null)
{
    <div class="doctor-profile-card">
        <div class="doctor-avatar">
            @Model.Doctor.FullName.Substring(0, 1)
        </div>
        <div class="text-center">
            <h3 class="mb-2" style="font-weight: 700; color: var(--medical-primary);">
                @Model.Doctor.FullName
            </h3>
            <p class="text-muted mb-3">
                <i class="fas fa-stethoscope me-2"></i>
                @(Model.Doctor.SpecializationNames != null && Model.Doctor.SpecializationNames.Any() 
                    ? string.Join("، ", Model.Doctor.SpecializationNames) 
                    : "نامشخص")
            </p>
            @if (!string.IsNullOrEmpty(Model.Doctor.MedicalCouncilCode))
            {
                <p class="text-muted">
                    <i class="fas fa-id-card me-2"></i>
                    کد نظام پزشکی: @Model.Doctor.MedicalCouncilCode
                </p>
            }
        </div>
    </div>

    <!-- آمار پزشک -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-value">@Model.TotalAppointments</div>
                <div class="stat-label">کل نوبت‌ها</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-value">@Model.TodayAppointments</div>
                <div class="stat-label">نوبت‌های امروز</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-value">@Model.AverageRating.ToString("0.0")</div>
                <div class="stat-label">امتیاز</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-value">@Model.ExperienceYears</div>
                <div class="stat-label">سال تجربه</div>
            </div>
        </div>
    </div>

    <!-- بیوگرافی -->
    if (!string.IsNullOrEmpty(Model.Doctor.Bio))
    {
        <div class="bio-section">
            <h5 class="mb-3" style="font-weight: 600; color: var(--medical-primary);">
                <i class="fas fa-user-circle me-2"></i>
                درباره پزشک
            </h5>
            <p style="line-height: 1.8; color: var(--medical-text);">
                @Model.Doctor.Bio
            </p>
        </div>
    }

    <!-- برنامه کاری -->
    if (Model.ScheduleDetails != null)
    {
        @Html.Partial("_DoctorSchedule", Model.ScheduleDetails)
    }
    else
    {
        <div class="no-schedule-message" style="text-align: center; padding: 3rem 2rem; color: #6c757d; animation: fadeIn 0.6s ease-out; background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%); border-radius: 16px; margin: 2rem 0; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);">
            <i class="fas fa-calendar-times" style="font-size: 4rem; margin-bottom: 1rem; opacity: 0.5; color: #adb5bd;"></i>
            <p style="font-size: 1.1rem; margin: 0; font-weight: 500;">برنامه کاری برای این پزشک تعریف نشده است.</p>
        </div>
    }

    <!-- انتخاب تاریخ و زمان -->
    <div class="schedule-card">
        <h5 class="mb-3" style="font-weight: 600; color: var(--medical-primary);">
            <i class="fas fa-calendar-check me-2"></i>
            انتخاب تاریخ و زمان نوبت
        </h5>
        
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">تاریخ نوبت</label>
                <input type="text" id="appointmentDate" class="form-control" 
                       placeholder="تاریخ را انتخاب کنید" />
            </div>
        </div>

        <!-- نمایش تاریخ انتخاب شده -->
        <div id="selectedDateDisplay" class="selected-date-display" style="display: none;">
            <div class="selected-date-content">
                <i class="fas fa-calendar-alt me-2"></i>
                <span id="selectedDateText"></span>
            </div>
        </div>

        <div id="timeSlotsContainer">
            <h6 class="mb-3">
                <i class="fas fa-clock me-2"></i>
                زمان‌های در دسترس:
                <span id="slotsCount" class="slots-count-badge"></span>
            </h6>
            <div class="time-slot-grid" id="timeSlotsGrid">
                @if (Model.AvailableSlots != null && Model.AvailableSlots.Any())
                {
                    foreach (var slot in Model.AvailableSlots)
                    {
                        <div class="time-slot @(slot.IsAvailable ? "available" : "unavailable")" 
                             data-start="@slot.StartTime.ToString(@"hh\:mm")"
                             data-end="@slot.EndTime.ToString(@"hh\:mm")"
                             @(!slot.IsAvailable ? "data-disabled=true" : "")>
                            @slot.DisplayTime
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">لطفاً ابتدا تاریخ را انتخاب کنید</p>
                }
            </div>
        </div>

        @if (!User.Identity.IsAuthenticated)
        {
            <div class="alert alert-warning mt-4" role="alert">
                <i class="fas fa-info-circle me-2"></i>
                برای رزرو نوبت، لطفاً ابتدا <a href="@Url.Action("Register", "Account", new { area = "", returnUrl = Request.Url?.ToString() })" class="alert-link">ثبت‌نام</a> کنید یا <a href="@Url.Action("Login", "Account", new { area = "", returnUrl = Request.Url?.ToString() })" class="alert-link">وارد</a> شوید.
            </div>
        }
        else
        {
            <div class="text-center mt-4">
                <button type="button" id="bookAppointmentBtn" class="btn btn-primary btn-lg" disabled>
                    <i class="fas fa-calendar-plus me-2"></i>
                    رزرو نوبت
                </button>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/Content/plugins/persian-datepicker/jalaali.min.js"></script>
    <script src="~/Content/plugins/persian-datepicker/persian-date.min.js"></script>
    <script src="~/Content/plugins/persian-datepicker/persian-datepicker.min.js"></script>
    <script src="~/Content/plugins/toastr/toastr.min.js"></script>
    <script>
        $(document).ready(function () {
            // تنظیمات Toastr
            toastr.options = {
                "closeButton": true,
                "debug": false,
                "newestOnTop": true,
                "progressBar": true,
                "positionClass": "toast-top-left",
                "preventDuplicates": false,
                "onclick": null,
                "showDuration": "300",
                "hideDuration": "1000",
                "timeOut": "5000",
                "extendedTimeOut": "1000",
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",
                "hideMethod": "fadeOut",
                "rtl": true
            };

            var selectedDate = '@Model.SelectedDate.ToString("yyyy/MM/dd")';
            var selectedTime = null;
            var doctorId = @Model.DoctorId;

            // محاسبه و نمایش خودکار تاریخ برای هر روز
            function initializeDayDates() {
                $('.schedule-day-card.clickable').each(function () {
                    var $card = $(this);
                    var dayOfWeek = parseInt($card.data('day')); // 0 = یکشنبه, 6 = شنبه
                    var targetDate = getNextDateForDayOfWeek(dayOfWeek);
                    
                    if (targetDate) {
                        var persianDate = convertToPersianDate(targetDate);
                        if (persianDate) {
                            // تبدیل به string در صورت نیاز
                            var persianDateStr = String(persianDate);
                            $card.find('.day-date-text').html('<strong style="color: var(--medical-primary); font-weight: 600;">' + persianDateStr + '</strong>');
                        } else {
                            $card.find('.day-date-text').html('<span style="color: #6c757d;">برای انتخاب کلیک کنید</span>');
                        }
                    } else {
                        $card.find('.day-date-text').html('<span style="color: #6c757d;">برای انتخاب کلیک کنید</span>');
                    }
                });
            }

            // راه‌اندازی Persian DatePicker
            var datePicker = $("#appointmentDate").pDatepicker({
                observer: true,
                format: 'YYYY/MM/DD',
                altField: '#appointmentDateAlt',
                altFormat: 'YYYY/MM/DD',
                initialValue: false,
                initialValueType: 'persian',
                calendarType: 'persian',
                calendar: {
                    persian: {
                        locale: 'fa',
                        showHint: true,
                        leapYearMode: 'algorithmic'
                    }
                },
                onSelect: function (selectedDateValue) {
                    // تاریخ انتخاب شده به فرمت YYYY/MM/DD است
                    selectedDate = selectedDateValue;
                    if (selectedDate) {
                        // نمایش تاریخ انتخاب شده
                        displaySelectedDate(selectedDateValue);
                        loadTimeSlots(doctorId, selectedDate);
                    }
                }
            });

            // محاسبه و نمایش خودکار تاریخ برای هر روز بعد از initialize شدن datepicker
            // چند بار تلاش می‌کنیم تا مطمئن شویم datepicker و jalaali آماده هستند
            var initAttempts = 0;
            var maxAttempts = 10;
            
            function tryInitializeDayDates() {
                initAttempts++;
                
                // بررسی آماده بودن datepicker و jalaali
                var datePickerReady = $("#appointmentDate").data('pDatepicker') !== undefined;
                var jalaaliReady = typeof jalaali !== 'undefined' && typeof jalaali.toJalaali === 'function';
                
                if (datePickerReady || jalaaliReady || initAttempts >= maxAttempts) {
                    initializeDayDates();
                } else {
                    setTimeout(tryInitializeDayDates, 200);
                }
            }
            
            // شروع تلاش برای initialize
            setTimeout(tryInitializeDayDates, 300);

            // کلیک روی روزهای برنامه کاری برای انتخاب تاریخ
            $(document).on('click', '.schedule-day-card.clickable', function (e) {
                e.preventDefault();
                e.stopPropagation();
                
                var dayOfWeek = parseInt($(this).data('day')); // 0 = یکشنبه, 6 = شنبه
                var dayName = $(this).data('day-name');
                
                // پیدا کردن تاریخ آینده برای این روز هفته
                var targetDate = getNextDateForDayOfWeek(dayOfWeek);
                
                if (targetDate) {
                    // تبدیل به تاریخ شمسی
                    var persianDate = convertToPersianDate(targetDate);
                    
                    if (persianDate) {
                        // تبدیل به string در صورت نیاز
                        var persianDateStr = String(persianDate);
                        
                        // تنظیم تاریخ در datepicker
                        var datePickerInstance = $("#appointmentDate").data('pDatepicker');
                        if (datePickerInstance) {
                            try {
                                // تبدیل تاریخ میلادی به شمسی برای datepicker
                                if (typeof persianDateStr.split !== 'function') {
                                    console.error('persianDate is not a string:', persianDate, typeof persianDate);
                                    toastr.error('خطا در تبدیل تاریخ', 'خطا');
                                    return;
                                }
                                
                                var persianParts = persianDateStr.split('/');
                                if (persianParts.length === 3) {
                                    var year = parseInt(persianParts[0]);
                                    var month = parseInt(persianParts[1]);
                                    var day = parseInt(persianParts[2]);
                                    
                                    // تنظیم تاریخ در datepicker
                                    datePickerInstance.setDate([year, month, day]);
                                    
                                    // نمایش تاریخ انتخاب شده
                                    displaySelectedDate(persianDateStr);
                                    
                                    // بارگذاری اسلات‌های زمانی
                                    loadTimeSlots(doctorId, persianDateStr);
                                    
                                    // نمایش پیام موفقیت
                                    toastr.success(dayName + ' - تاریخ: ' + persianDateStr, 'تاریخ انتخاب شد', {
                                        timeOut: 3000
                                    });
                                    
                                    // به‌روزرسانی نمایش تاریخ در کارت روز
                                    $(this).find('.day-date-text').html('<strong style="color: var(--medical-primary);">' + persianDateStr + '</strong>');
                                    
                                    // اضافه کردن کلاس برای نمایش تاریخ انتخاب شده
                                    $('.schedule-day-card').removeClass('selected-day');
                                    $(this).addClass('selected-day');
                                }
                            } catch (err) {
                                console.error('خطا در تنظیم تاریخ:', err);
                                toastr.error('خطا در انتخاب تاریخ', 'خطا');
                            }
                        } else {
                            // اگر datepicker هنوز initialize نشده، فقط تاریخ را نمایش می‌دهیم
                            var persianDateStr = String(persianDate);
                            displaySelectedDate(persianDateStr);
                            loadTimeSlots(doctorId, persianDateStr);
                            toastr.success(dayName + ' - تاریخ: ' + persianDateStr, 'تاریخ انتخاب شد');
                        }
                    } else {
                        toastr.warning('خطا در تبدیل تاریخ', 'هشدار');
                    }
                } else {
                    toastr.warning('خطا در محاسبه تاریخ', 'هشدار');
                }
            });

            // پیدا کردن تاریخ آینده برای یک روز هفته مشخص
            function getNextDateForDayOfWeek(targetDayOfWeek) {
                var today = new Date();
                var currentDayOfWeek = today.getDay(); // 0 = یکشنبه, 6 = شنبه
                
                // محاسبه تعداد روزهای باقی‌مانده تا روز هدف
                var daysUntilTarget = (targetDayOfWeek - currentDayOfWeek + 7) % 7;
                
                // اگر امروز همان روز است، 7 روز بعد را انتخاب می‌کنیم
                if (daysUntilTarget === 0) {
                    daysUntilTarget = 7;
                }
                
                var targetDate = new Date(today);
                targetDate.setDate(today.getDate() + daysUntilTarget);
                
                return targetDate;
            }

            // تبدیل تاریخ میلادی به شمسی
            function convertToPersianDate(gregorianDate) {
                // بررسی ورودی
                if (!gregorianDate) {
                    console.error('convertToPersianDate: gregorianDate is null or undefined');
                    return null;
                }
                
                // تبدیل به Date object در صورت نیاز
                if (!(gregorianDate instanceof Date)) {
                    console.error('convertToPersianDate: gregorianDate is not a Date object:', gregorianDate, typeof gregorianDate);
                    return null;
                }
                
                try {
                    // استفاده از jalaali.js که در persian-datepicker موجود است
                    if (typeof jalaali !== 'undefined' && typeof jalaali.toJalaali === 'function') {
                        try {
                            var jDate = jalaali.toJalaali(
                                gregorianDate.getFullYear(),
                                gregorianDate.getMonth() + 1,
                                gregorianDate.getDate()
                            );
                            
                            if (jDate && typeof jDate === 'object' && jDate.jy && jDate.jm && jDate.jd) {
                                var year = String(jDate.jy).padStart(4, '0');
                                var month = String(jDate.jm).padStart(2, '0');
                                var day = String(jDate.jd).padStart(2, '0');
                                return year + '/' + month + '/' + day;
                            }
                        } catch (e) {
                            console.error('خطا در تبدیل با jalaali:', e);
                        }
                    }
                    
                    // استفاده از persian-datepicker API
                    var datePickerInstance = $("#appointmentDate").data('pDatepicker');
                    if (datePickerInstance && datePickerInstance.calendar) {
                        var calendar = datePickerInstance.calendar;
                        
                        if (calendar.persian && typeof calendar.persian.toPersian === 'function') {
                            try {
                                var persianDateObj = calendar.persian.toPersian(
                                    gregorianDate.getFullYear(),
                                    gregorianDate.getMonth() + 1,
                                    gregorianDate.getDate()
                                );
                                
                                if (persianDateObj && Array.isArray(persianDateObj) && persianDateObj.length >= 3) {
                                    var year = persianDateObj[0].toString().padStart(4, '0');
                                    var month = persianDateObj[1].toString().padStart(2, '0');
                                    var day = persianDateObj[2].toString().padStart(2, '0');
                                    return year + '/' + month + '/' + day;
                                }
                            } catch (e) {
                                console.log('خطا در تبدیل با persian-datepicker:', e);
                            }
                        }
                    }
                    
                    // Fallback: استفاده از API datepicker برای تبدیل
                    try {
                        var tempInput = $('<input>').css('display', 'none');
                        $('body').append(tempInput);
                        
                        var tempPicker = tempInput.pDatepicker({
                            calendarType: 'persian',
                            format: 'YYYY/MM/DD'
                        });
                        
                        // تنظیم تاریخ میلادی
                        tempPicker.setDate(gregorianDate);
                        
                        // دریافت تاریخ شمسی
                        var persianDateStr = tempInput.val();
                        tempInput.remove();
                        
                        if (persianDateStr) {
                            return persianDateStr;
                        }
                    } catch (e) {
                        console.error('خطا در تبدیل با datepicker:', e);
                    }
                } catch (e) {
                    console.error('خطا در تبدیل تاریخ:', e);
                }
                
                // آخرین Fallback: استفاده از محاسبه تقریبی
                try {
                    var year = gregorianDate.getFullYear();
                    var month = gregorianDate.getMonth() + 1;
                    var day = gregorianDate.getDate();
                    
                    // تبدیل تقریبی
                    var persianYear = year - 621;
                    if (month <= 3) {
                        persianYear = year - 622;
                    }
                    
                    var yearStr = String(persianYear).padStart(4, '0');
                    var monthStr = String(month).padStart(2, '0');
                    var dayStr = String(day).padStart(2, '0');
                    
                    return yearStr + '/' + monthStr + '/' + dayStr;
                } catch (e) {
                    console.error('خطا در Fallback تبدیل تاریخ:', e);
                    return null;
                }
            }

            // انتخاب زمان
            $(document).on('click', '.time-slot.available', function () {
                if ($(this).data('disabled')) return;

                $('.time-slot').removeClass('selected');
                $(this).addClass('selected');
                selectedTime = $(this).data('start');
                $('#bookAppointmentBtn').prop('disabled', false);

                toastr.success('زمان انتخاب شد: ' + $(this).text(), 'موفق');
            });

            // نمایش تاریخ انتخاب شده
            function displaySelectedDate(persianDate) {
                if (!persianDate) return;
                
                // تبدیل به string در صورت نیاز
                var persianDateStr = String(persianDate);
                
                // تبدیل تاریخ شمسی به میلادی برای محاسبه DayOfWeek
                if (typeof persianDateStr.split !== 'function') {
                    console.error('persianDate is not a string:', persianDate, typeof persianDate);
                    // Fallback: نمایش فقط تاریخ
                    $('#selectedDateText').text('تاریخ: ' + persianDateStr);
                    $('#selectedDateDisplay').fadeIn(300);
                    return;
                }
                
                var parts = persianDateStr.split('/');
                if (parts.length !== 3) {
                    // Fallback: نمایش فقط تاریخ
                    $('#selectedDateText').text('تاریخ: ' + persianDateStr);
                    $('#selectedDateDisplay').fadeIn(300);
                    return;
                }
                
                var year = parseInt(parts[0]);
                var month = parseInt(parts[1]);
                var day = parseInt(parts[2]);
                
                // استفاده از persian-datepicker برای تبدیل
                var datePicker = $("#appointmentDate").data('pDatepicker');
                if (datePicker && datePicker.selected) {
                    // دریافت تاریخ میلادی از datepicker
                    var gregorianDate = datePicker.selected.gD || new Date();
                    var dayOfWeek = gregorianDate.getDay();
                    
                    // دریافت نام روز هفته
                    var dayNames = ['یکشنبه', 'دوشنبه', 'سه‌شنبه', 'چهارشنبه', 'پنج‌شنبه', 'جمعه', 'شنبه'];
                    var dayName = dayNames[dayOfWeek] || '';
                    
                    // نمایش تاریخ
                    var dateText = dayName + ' تاریخ: ' + persianDateStr;
                    $('#selectedDateText').text(dateText);
                    $('#selectedDateDisplay').fadeIn(300);
                } else {
                    // Fallback: نمایش فقط تاریخ
                    $('#selectedDateText').text('تاریخ: ' + persianDateStr);
                    $('#selectedDateDisplay').fadeIn(300);
                }
            }

            // بارگذاری اسلات‌های زمانی
            function loadTimeSlots(doctorId, date) {
                if (!date) {
                    toastr.warning('لطفاً تاریخ را انتخاب کنید', 'هشدار');
                    return;
                }

                // نمایش loading
                $('#timeSlotsGrid').html('<div class="text-center p-4"><i class="fas fa-spinner fa-spin me-2"></i>در حال بارگذاری...</div>');
                $('#slotsCount').text('');

                $.ajax({
                    url: '@Url.Action("GetTimeSlots", "Appointment")',
                    type: 'GET',
                    data: { doctorId: doctorId, date: date },
                    success: function (response) {
                        console.log('Response from GetTimeSlots:', response);
                        
                        if (response.success && response.slots && response.slots.length > 0) {
                            var html = '';
                            var availableCount = 0;
                            var unavailableCount = 0;
                            
                            response.slots.forEach(function (slot) {
                                var cssClass = slot.isAvailable ? 'available' : 'unavailable';
                                var disabled = slot.isAvailable ? '' : 'data-disabled=true';
                                
                                if (slot.isAvailable) {
                                    availableCount++;
                                } else {
                                    unavailableCount++;
                                }
                                
                                html += '<div class="time-slot ' + cssClass + '" ' +
                                    'data-start="' + slot.startTime + '" ' +
                                    'data-end="' + slot.endTime + '" ' +
                                    disabled + '>' +
                                    slot.displayTime +
                                    '</div>';
                            });
                            
                            $('#timeSlotsGrid').html(html);
                            
                            // نمایش تعداد اسلات‌ها
                            var countText = '';
                            if (availableCount > 0) {
                                countText = availableCount + ' نوبت خالی';
                            }
                            if (unavailableCount > 0) {
                                if (countText) countText += ' • ';
                                countText += unavailableCount + ' نوبت پر شده';
                            }
                            $('#slotsCount').text(countText);
                            
                            selectedTime = null;
                            $('#bookAppointmentBtn').prop('disabled', true);
                        } else {
                            var message = response.message || 'زمانی در دسترس نیست';
                            console.warn('No slots available:', message);
                            console.warn('Response details:', JSON.stringify(response, null, 2));
                            
                            // بررسی اینکه آیا این روز در برنامه کاری پزشک است
                            var helpfulMessage = message;
                            if (message === 'زمانی در دسترس نیست' || !message || message === 'خطا در دریافت اسلات‌های در دسترس') {
                                helpfulMessage = 'برای این تاریخ زمانی در دسترس نیست. لطفاً یکی از روزهای کاری پزشک را انتخاب کنید.';
                            }
                            
                            $('#timeSlotsGrid').html('<div class="text-center p-4 text-muted"><i class="fas fa-info-circle me-2"></i>' + helpfulMessage + '</div>');
                            $('#slotsCount').text('');
                            toastr.info(helpfulMessage, 'اطلاعات', { timeOut: 5000 });
                        }
                    },
                    error: function () {
                        $('#timeSlotsGrid').html('<div class="text-center p-4 text-danger"><i class="fas fa-exclamation-triangle me-2"></i>خطا در ارتباط با سرور</div>');
                        $('#slotsCount').text('');
                        toastr.error('خطا در ارتباط با سرور', 'خطا');
                    }
                });
            }

            // رزرو نوبت
            $('#bookAppointmentBtn').on('click', function () {
                @if (!User.Identity.IsAuthenticated)
                {
                    <text>
                    toastr.warning('برای رزرو نوبت، لطفاً ابتدا ثبت‌نام کنید', 'نیاز به ثبت‌نام');
                    window.location.href = '@Url.Action("Register", "Account", new { area = "", returnUrl = Request.Url?.ToString() })';
                    </text>
                }
                else
                {
                    <text>
                    if (!selectedDate || !selectedTime) {
                        toastr.warning('لطفاً تاریخ و زمان را انتخاب کنید', 'هشدار');
                        return;
                    }

                    window.location.href = '@Url.Action("SelectDate", "AppointmentBooking")?doctorId=' + doctorId + '&date=' + selectedDate + '&time=' + selectedTime;
                    </text>
                }
            });

            // نمایش پیغام‌های TempData
            @if (TempData["Success"] != null)
            {
                <text>
                toastr.success('@TempData["Success"]', 'موفق');
                </text>
            }
            @if (TempData["Error"] != null)
            {
                <text>
                toastr.error('@TempData["Error"]', 'خطا');
                </text>
            }
            @if (TempData["Info"] != null)
            {
                <text>
                toastr.info('@TempData["Info"]', 'اطلاعات');
                </text>
            }
        });
    </script>
}

