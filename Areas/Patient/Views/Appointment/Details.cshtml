@model ClinicApp.Models.DTOs.Appointment.PatientAppointmentDto
@{
    ViewBag.Title = "جزئیات نوبت";
    Layout = "~/Areas/Patient/Views/Shared/_PatientLayout.cshtml";
}

@section Styles {
    <link href="~/Content/css/local-fonts.css" rel="stylesheet" />
    <link href="~/Content/css/medical-forms.css" rel="stylesheet" />
    <link href="~/Content/css/appointment-views.css" rel="stylesheet" />
}

<div class="appointment-views-container py-4">
    <nav class="mb-3" aria-label="مسیر">
        <a href="@Url.Action("Index", "Dashboard", new { area = "Patient" })">داشبورد</a>
        <span class="text-muted mx-1">/</span>
        <a href="@Url.Action("MyAppointments")">نوبت‌های من</a>
        <span class="text-muted mx-1">/</span>
        <span aria-current="page">جزئیات نوبت</span>
    </nav>

    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
        <h1 class="h4 mb-0 text-medical-primary">
            <i class="fas fa-calendar-check ml-2"></i>
            جزئیات نوبت
        </h1>
        <a href="@Url.Action("MyAppointments")" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-arrow-right ml-1"></i>
            بازگشت به نوبت‌های من
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="row mb-3">
                <div class="col-12 col-md-4 text-muted"><strong>پزشک</strong></div>
                <div class="col-12 col-md-8">@(Model?.DoctorName ?? "—")</div>
            </div>
            <div class="row mb-3">
                <div class="col-12 col-md-4 text-muted"><strong>تخصص</strong></div>
                <div class="col-12 col-md-8">@(Model?.DoctorSpecialization ?? "—")</div>
            </div>
            @if (!string.IsNullOrEmpty(Model?.MedicalCouncilCode))
            {
                <div class="row mb-3">
                    <div class="col-12 col-md-4 text-muted"><strong>کد نظام پزشکی</strong></div>
                    <div class="col-12 col-md-8">@Model.MedicalCouncilCode</div>
                </div>
            }
            <div class="row mb-3">
                <div class="col-12 col-md-4 text-muted"><strong>تاریخ</strong></div>
                <div class="col-12 col-md-8">@(Model?.AppointmentDate.ToString("yyyy/MM/dd") ?? "—")</div>
            </div>
            <div class="row mb-3">
                <div class="col-12 col-md-4 text-muted"><strong>زمان</strong></div>
                <div class="col-12 col-md-8">@(Model?.AppointmentTime ?? "—")</div>
            </div>
            <div class="row mb-3">
                <div class="col-12 col-md-4 text-muted"><strong>وضعیت</strong></div>
                <div class="col-12 col-md-8">@(Model?.StatusDisplay ?? "—")</div>
            </div>
            <div class="row mb-3">
                <div class="col-12 col-md-4 text-muted"><strong>مبلغ</strong></div>
                <div class="col-12 col-md-8">@(Model?.Price.ToString("N0") ?? "0") ریال</div>
            </div>
            @if (!string.IsNullOrEmpty(Model?.ClinicName) && Model.ClinicName != "نامشخص")
            {
                <div class="row mb-3">
                    <div class="col-12 col-md-4 text-muted"><strong>کلینیک</strong></div>
                    <div class="col-12 col-md-8">@Model.ClinicName</div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model?.DepartmentName) && Model.DepartmentName != "نامشخص")
            {
                <div class="row mb-3">
                    <div class="col-12 col-md-4 text-muted"><strong>بخش</strong></div>
                    <div class="col-12 col-md-8">@Model.DepartmentName</div>
                </div>
            }
            @if (Model?.Duration > 0)
            {
                <div class="row mb-3">
                    <div class="col-12 col-md-4 text-muted"><strong>مدت ویزیت</strong></div>
                    <div class="col-12 col-md-8">@Model.Duration دقیقه</div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model?.Description))
            {
                <div class="row mb-3">
                    <div class="col-12 col-md-4 text-muted"><strong>توضیحات</strong></div>
                    <div class="col-12 col-md-8">@Model.Description</div>
                </div>
            }
        </div>
    </div>
</div>
