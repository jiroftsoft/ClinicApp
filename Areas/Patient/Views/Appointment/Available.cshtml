                applyFilters: function(date, doctorId, searchTerm) {
                    // ✅ جلوگیری از duplicate calls
                    if (AppState.isLoading) {
                        console.log('⚠️ Already loading, skipping filter application');
                        return;
                    }
                    
                    // ✅ دریافت searchTerm از input
                    if (!searchTerm || searchTerm === '') {
                        var $searchInput = $("#searchTerm");
                        if ($searchInput.length > 0) {
                            searchTerm = $searchInput.val();
                            if (searchTerm) {
                                searchTerm = searchTerm.trim();
                                if (searchTerm === '') {
                                    searchTerm = null;
                                }
                            } else {
                                searchTerm = null;
                            }
                        }
                    }
                    
                    // ✅ Normalize date - استفاده از روش‌های مختلف برای دریافت تاریخ
                    if (!date || date === '') {
                        // اگر تاریخ خالی است، از date picker بگیر
                        var $dateInput = $("#date");
                        if ($dateInput.length > 0) {
                            var dateValue = $dateInput.val();
                            if (dateValue) {
                                date = convertPersianToEnglishNumbers(dateValue);
                            } else {
                                // اگر input هم خالی است، از date picker instance بگیر
                                try {
                                    var datePickerInstance = $dateInput.data('pDatepicker');
                                    if (datePickerInstance) {
                                        var formattedDate = datePickerInstance.getFormattedDate('YYYY/MM/DD');
                                        if (formattedDate) {
                                            date = convertPersianToEnglishNumbers(formattedDate);
                                        }
                                    }
                                } catch (e) {
                                    console.warn('Error getting date from datePicker:', e);
                                }
                            }
                        }
                    }
                    
                    // ✅ Normalize date format
                    if (date) {
                        date = convertPersianToEnglishNumbers(date);
                        if (!date.match(/^\d{4}\/\d{2}\/\d{2}$/)) {
                            console.warn('⚠️ Invalid date format:', date);
                            date = null;
                        }
                    }
                    
                    // ✅ Normalize doctorId
                    if (doctorId === '' || doctorId === '0' || doctorId === null || doctorId === undefined) {
                        doctorId = null;
                    } else {
                        // تبدیل به عدد برای اطمینان
                        doctorId = parseInt(doctorId, 10);
                        if (isNaN(doctorId) || doctorId <= 0) {
                            doctorId = null;
                        }
                    }
                    
                    console.log('✅ Applying filters:', { date: date, doctorId: doctorId, searchTerm: searchTerm });
                    
                    // ✅ Update state
                    AppState.selectedDate = date;
                    AppState.selectedDoctorId = doctorId;
                    
