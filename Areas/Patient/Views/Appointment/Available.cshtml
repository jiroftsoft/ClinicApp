                                            }
                                        }
                                        
                                        // ✅ اعمال فیلتر با تاریخ امروز
                                        applyClearFilter(todayDate);
                                    }, 100); // تاخیر کوتاه برای اطمینان از به‌روزرسانی date picker
                                    return; // خروج از تابع تا setTimeout اجرا شود
