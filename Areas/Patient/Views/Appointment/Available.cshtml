                                if (datePickerInstance) {
                                    // ✅ Reset date picker به تاریخ امروز
                                    var today = new Date();
                                    datePickerInstance.setDate(today);
                                    
                                    // ✅ دریافت تاریخ شمسی امروز از date picker
                                    setTimeout(function() {
                                        var todayPersian = getPersianDateFromPicker(datePickerInstance, false);
                                        if (todayPersian) {
                                            $dateInput.val(todayPersian);
                                            todayDate = todayPersian;
                                            console.log('✅ Date picker reset to today:', todayPersian);
                                        } else {
                                            // Fallback: استفاده از getFormattedDate
                                            var formattedDate = datePickerInstance.getFormattedDate('YYYY/MM/DD');
                                            if (formattedDate) {
                                                $dateInput.val(formattedDate);
                                                todayDate = formattedDate;
