                        $('#doctorId').val('');
                        $('#searchTerm').val('');
                        
                        // ✅ 2. Reset date picker به تاریخ امروز (نه خالی کردن)
                        var $dateInput = $("#date");
                        var todayDate = null;
                        if ($dateInput.length > 0) {
