            // ✅ Filter Module (SRP: Filter Management) - ضد گلوله و تست شده
            var FilterModule = {
                // ✅ Validation Helper برای تاریخ
                validateDate: function(date) {
                    if (!date || date === '') {
                        return { valid: false, value: null, error: null };
                    }
                    
                    // تبدیل اعداد فارسی به انگلیسی
                    date = convertPersianToEnglishNumbers(date);
                    
                    // بررسی فرمت
                    if (!date.match(/^\d{4}\/\d{2}\/\d{2}$/)) {
                        return { valid: false, value: null, error: 'فرمت تاریخ نامعتبر است. لطفاً تاریخ را به صورت YYYY/MM/DD وارد کنید.' };
                    }
                    
                    // بررسی معتبر بودن تاریخ
                    var parts = date.split('/');
                    var year = parseInt(parts[0], 10);
                    var month = parseInt(parts[1], 10);
                    var day = parseInt(parts[2], 10);
                    
                    if (isNaN(year) || isNaN(month) || isNaN(day)) {
                        return { valid: false, value: null, error: 'تاریخ نامعتبر است.' };
                    }
                    
                    if (year < 1300 || year > 1500) {
                        return { valid: false, value: null, error: 'سال باید بین 1300 تا 1500 باشد.' };
                    }
                    
                    if (month < 1 || month > 12) {
                        return { valid: false, value: null, error: 'ماه باید بین 1 تا 12 باشد.' };
                    }
                    
                    if (day < 1 || day > 31) {
                        return { valid: false, value: null, error: 'روز باید بین 1 تا 31 باشد.' };
                    }
                    
                    return { valid: true, value: date, error: null };
                },
                
                // ✅ Validation Helper برای doctorId
                validateDoctorId: function(doctorId) {
                    if (!doctorId || doctorId === '' || doctorId === '0' || doctorId === null || doctorId === undefined) {
                        return { valid: true, value: null, error: null }; // null معتبر است (همه پزشکان)
                    }
                    
                    var id = parseInt(doctorId, 10);
                    if (isNaN(id) || id <= 0) {
                        return { valid: false, value: null, error: 'شناسه پزشک نامعتبر است.' };
                    }
                    
                    return { valid: true, value: id, error: null };
                },
                
                // ✅ Validation Helper برای searchTerm
                validateSearchTerm: function(searchTerm) {
                    if (!searchTerm || searchTerm === '') {
                        return { valid: true, value: null, error: null }; // null معتبر است
                    }
                    
                    searchTerm = searchTerm.trim();
                    
                    if (searchTerm === '') {
                        return { valid: true, value: null, error: null };
                    }
                    
                    // بررسی طول
                    if (searchTerm.length < 2) {
                        return { valid: false, value: null, error: 'حداقل 2 کاراکتر برای جستجو لازم است.' };
                    }
                    
                    if (searchTerm.length > 100) {
                        return { valid: false, value: null, error: 'حداکثر 100 کاراکتر برای جستجو مجاز است.' };
                    }
                    
                    // بررسی کاراکترهای خطرناک (XSS prevention)
                    var dangerousChars = /[<>\"'&]/;
                    if (dangerousChars.test(searchTerm)) {
                        return { valid: false, value: null, error: 'کاراکترهای غیرمجاز در جستجو یافت شد.' };
                    }
                    
                    return { valid: true, value: searchTerm, error: null };
                },
                
                applyFilters: function(date, doctorId, searchTerm) {
                    try {
                        if (AppState.isLoading) {
                            log('Already loading, skipping filter application');
                            return;
                        }
                        
                        // ✅ دریافت searchTerm از input
                        if (!searchTerm || searchTerm === '') {
                            var $searchInput = $("#searchTerm");
                            if ($searchInput.length > 0) {
                                searchTerm = $searchInput.val();
                            }
                        }
                        
                        // ✅ Validation searchTerm
                        var searchValidation = this.validateSearchTerm(searchTerm);
                        if (!searchValidation.valid) {
                            if (typeof toastr !== 'undefined') {
                                toastr.warning(searchValidation.error, 'خطا در جستجو');
                            }
                            return;
                        }
                        searchTerm = searchValidation.value;
                        
                        // ✅ Normalize date - استفاده از روش‌های مختلف برای دریافت تاریخ
                        if (!date || date === '') {
                            // اگر تاریخ خالی است، از date picker بگیر
                            var $dateInput = $("#date");
                            if ($dateInput.length > 0) {
                                var dateValue = $dateInput.val();
                                if (dateValue) {
                                    date = dateValue;
                                } else {
                                    // اگر input هم خالی است، از date picker instance بگیر
                                    try {
                                        var datePickerInstance = $dateInput.data('pDatepicker');
                                        if (datePickerInstance) {
                                            var formattedDate = datePickerInstance.getFormattedDate('YYYY/MM/DD');
                                            if (formattedDate) {
                                                date = formattedDate;
                                            }
                                        }
                                    } catch (e) {
                                        console.warn('Error getting date from datePicker:', e);
                                    }
                                }
                            }
                        }
                        
                        // ✅ Validation date
                        var dateValidation = this.validateDate(date);
                        if (!dateValidation.valid && date) { // فقط اگر تاریخ وارد شده باشد
                            if (typeof toastr !== 'undefined') {
                                toastr.warning(dateValidation.error || 'تاریخ نامعتبر است', 'خطا در تاریخ');
                            }
                            // تاریخ نامعتبر را null می‌کنیم و ادامه می‌دهیم
                            date = null;
                        } else {
                            date = dateValidation.value;
                        }
                        
                        // ✅ Validation doctorId
                        var doctorValidation = this.validateDoctorId(doctorId);
                        if (!doctorValidation.valid) {
                            if (typeof toastr !== 'undefined') {
                                toastr.warning(doctorValidation.error, 'خطا در انتخاب پزشک');
                            }
                            return;
                        }
                        doctorId = doctorValidation.value;
                        
                        log('Applying filters (validated):', { date: date, doctorId: doctorId, searchTerm: searchTerm });
                        
                        // ✅ Update state
                        AppState.selectedDate = date;
                        AppState.selectedDoctorId = doctorId;
                        
                        // ✅ Fetch data via AJAX
                        DataModule.fetchAvailableData(date, doctorId, searchTerm);
                    } catch (error) {
                        console.error('❌ Error in applyFilters:', error);
                        if (typeof toastr !== 'undefined') {
                            toastr.error('خطا در اعمال فیلترها. لطفاً دوباره تلاش کنید.', 'خطا');
                        }
                    }
                }
            };
            
            // ✅ Event Handlers Module (SRP: Event Management)
            var EventHandlersModule = {
