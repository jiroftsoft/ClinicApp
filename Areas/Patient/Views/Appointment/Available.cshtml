                        var searchTerm = $(this).val();
                        
                        // ✅ Debounce برای جلوگیری از درخواست‌های زیاد
                        if (searchTimeout) {
                            clearTimeout(searchTimeout);
                        }
                        
                        searchTimeout = setTimeout(function() {
                            log('Search term changed:', searchTerm);
                            var doctorId = $('#doctorId').val();
                            var date = null;
                            
                            // ✅ دریافت تاریخ از date picker
                            var $dateInput = $("#date");
                            if ($dateInput.length > 0) {
                                var dateValue = $dateInput.val();
                                if (dateValue) {
                                    date = convertPersianToEnglishNumbers(dateValue);
                                } else {
                                    try {
                                        var datePickerInstance = $dateInput.data('pDatepicker');
                                        if (datePickerInstance) {
                                            var formattedDate = datePickerInstance.getFormattedDate('YYYY/MM/DD');
                                            if (formattedDate) {
                                                date = convertPersianToEnglishNumbers(formattedDate);
                                            }
                                        }
                                    } catch (e) {
                                        console.warn('Error getting date from datePicker:', e);
                                    }
                                }
                            }
                            
                            // ✅ اعمال فیلتر
                            FilterModule.applyFilters(date, doctorId, searchTerm);
                        }, 500); // 500ms debounce
                    });
                    
                    // ✅ Doctor filter change - ضد گلوله برای حالت "همه پزشکان"
                    $('#doctorId').off('change.doctorFilter').on('change.doctorFilter', function() {
