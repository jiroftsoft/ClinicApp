                        if ($dateInput.length > 0) {
                            var dateValue = $dateInput.val();
                            if (dateValue) {
                                date = convertPersianToEnglishNumbers(dateValue);
                            } else {
                                // اگر input خالی است، از date picker instance بگیر
                                try {
                                    var datePickerInstance = $dateInput.data('pDatepicker');
                                    if (datePickerInstance) {
                                        var formattedDate = datePickerInstance.getFormattedDate('YYYY/MM/DD');
                                        if (formattedDate) {
                                            date = convertPersianToEnglishNumbers(formattedDate);
                                        }
                                    }
                                } catch (e) {
                                    console.warn('Error getting date from datePicker:', e);
                                }
                            }
                        }
                        
                        // ✅ اعمال فیلتر
                        FilterModule.applyFilters(date, doctorId, searchTerm);
                    });
                    
                    // ✅ Attach initial handlers
                    this.attachDoctorCardHandlers();
                    this.attachTimeSlotHandlers();
                    this.attachBookAppointmentHandlers(); // ✅ Event handler برای دکمه "رزرو نوبت"
                }
            };
            
            // ✅ Legacy function برای backward compatibility (حذف redirect)
            function applyFilters(date, doctorId) {
                FilterModule.applyFilters(date, doctorId);
            }

            // ✅ استفاده از کامپوننت اصولی Persian DatePicker
            // کامپوننت خودش initialize می‌کند
            // برای فرم GET، نیازی به hidden input نیست، فقط تاریخ شمسی را در query string ارسال می‌کنیم
            // منتظر می‌مانیم تا کامپوننت initialize شود
            var datePickerInitCheck = setInterval(function() {
                var $dateInput = $("#date");
                if ($dateInput.length && $dateInput.data('pDatepicker-initialized')) {
                    clearInterval(datePickerInitCheck);
                    datePickerInitialized = true;
                    console.log('✅ DatePicker initialized by component');
                    
                    // ✅ اضافه کردن onSelect handler به datePicker instance
                    var datePickerInstance = $dateInput.data('pDatepicker');
                    if (datePickerInstance && datePickerInstance.config) {
                        // ذخیره onSelect قبلی
                        var originalOnSelect = datePickerInstance.config.onSelect;
                        
                        // ✅ تنظیم onSelect handler جدید - روش حرفه‌ای برای جلوگیری از مشکل timezone
                        datePickerInstance.config.onSelect = function(selectedDateValue) {
                            console.log('✅ onSelect called with:', selectedDateValue, typeof selectedDateValue);
                            
                            // فراخوانی onSelect قبلی (اگر وجود داشته باشد)
                            if (originalOnSelect && typeof originalOnSelect === 'function') {
                                originalOnSelect.call(this, selectedDateValue);
                            }
                    
                            // ✅ فعال کردن polling وقتی کاربر تاریخ را انتخاب می‌کند
                            if (!pollingEnabled) {
                                pollingEnabled = true;
                                startDatePolling();
                            }
                            AppState.isInitialLoad = false;
                            isInitialLoad = false; // Legacy compatibility
                    
                            // ✅ پردازش تاریخ - استفاده مستقیم از تاریخ شمسی (بدون تبدیل unix timestamp)
                            // ⚠️ مهم: استفاده از unix timestamp باعث مشکل timezone می‌شود
                            // ✅ راه حل حرفه‌ای: استفاده مستقیم از selected.jy/jm/jd که مستقیماً تاریخ شمسی است
                            if (dateChangeTimeout) {
                                clearTimeout(dateChangeTimeout);
                            }
                            
                            // ✅ تابع helper برای پردازش تاریخ انتخاب شده (تعریف قبل از setTimeout برای دسترسی)
                            function processSelectedDate(persianDateStr) {
                                // ✅ اگر تاریخ معتبر پیدا شد، اعمال فیلتر
                                lastProcessedDate = persianDateStr;
                                console.log('✅ [onSelect] Processing selected date (timezone-safe):', persianDateStr);
                                
                                // ✅ اعمال فیلتر به صورت خودکار (فقط اگر بارگذاری اولیه نباشد)
                                if (!AppState.isInitialLoad) {
                                    var doctorId = $('#doctorId').val();
                                    var searchTerm = $('#searchTerm').val();
                                    if (searchTerm) {
                                        searchTerm = searchTerm.trim();
                                        if (searchTerm === '') {
                                            searchTerm = null;
                                        }
                                    } else {
                                        searchTerm = null;
                                    }
                                    console.log('✅ [onSelect] Applying filters with date:', persianDateStr, 'doctorId:', doctorId, 'searchTerm:', searchTerm);
                                    FilterModule.applyFilters(persianDateStr, doctorId, searchTerm);
                                } else {
                                    // در بارگذاری اولیه، فقط تاریخ را ذخیره می‌کنیم
                                    AppState.selectedDate = persianDateStr;
                                    console.log('✅ [onSelect] Initial load - Date set:', persianDateStr);
                                }
                            }
                            
                            // ✅ تاخیر برای اطمینان از به‌روزرسانی datePicker instance (مخصوصاً برای دکمه "امروز")
                            // ⚠️ مهم: این delay برای اطمینان از به‌روزرسانی selected.jy/jm/jd است
                            dateChangeTimeout = setTimeout(function() {
                                // ✅ استفاده از تابع helper مرکزی که از timezone مستقل است
                                // ⚠️ مهم: استفاده از useDelay=true برای اطمینان از به‌روزرسانی selected object
                                var persianDateStr = getPersianDateFromPicker(datePickerInstance, true);
                                
                                // ✅ اگر تابع helper تاریخ نداد، یک بار دیگر با delay بیشتر تلاش می‌کنیم
                                // این مخصوصاً برای دکمه "امروز" مهم است
                                if (!persianDateStr) {
                                    setTimeout(function() {
                                        persianDateStr = getPersianDateFromPicker(datePickerInstance, false);
                                        if (!persianDateStr) {
                                            // Fallback: استفاده از processDateFromInput
                                            console.warn('⚠️ [onSelect] Could not get date from datePicker helper after retry, using processDateFromInput');
                                            processDateFromInput(true);
                                            return;
                                        }
                                        processSelectedDate(persianDateStr);
                                    }, 50); // delay بیشتر برای retry
                                    return;
                                }
                                
                                // ✅ Validation: بررسی فرمت تاریخ
                                if (!persianDateStr.match(/^\d{4}\/\d{2}\/\d{2}$/)) {
                                    console.warn('⚠️ [onSelect] Invalid date format from helper:', persianDateStr);
                                    processDateFromInput(true);
                                    return;
                                }
                                
                                // ✅ پردازش تاریخ انتخاب شده
                                processSelectedDate(persianDateStr);
                            }, 100); // ✅ تاخیر اولیه برای اطمینان از به‌روزرسانی datePicker instance
                        };
                    }
                }
            }, 100);
            
            // Timeout برای جلوگیری از infinite loop
            setTimeout(function() {
                clearInterval(datePickerInitCheck);
            }, 5000);

            // ✅ Event Listeners Enterprise-Level (مطمئن‌ترین روش در پروژه‌های enterprise)
            // 1. change event - وقتی کاربر تاریخ را انتخاب می‌کند
            $("#date").on('change', function() {
                console.log('✅ [Enterprise] change event triggered');
                // ✅ فعال کردن polling وقتی کاربر تاریخ را تغییر می‌دهد
                if (!pollingEnabled) {
                    pollingEnabled = true;
                    startDatePolling();
                }
                AppState.isInitialLoad = false;
                isInitialLoad = false; // Legacy compatibility
                processDateFromInput(true); // force process
            });
            
            // 2. input event - برای تغییرات real-time
            $("#date").on('input', function() {
                var inputValue = $(this).val();
                var englishValue = convertPersianToEnglishNumbers(inputValue);
                if (englishValue && englishValue.match(/^\d{4}\/\d{2}\/\d{2}$/)) {
                    // ✅ فعال کردن polling وقتی کاربر تاریخ را تغییر می‌دهد
                    if (!pollingEnabled) {
                        pollingEnabled = true;
                        startDatePolling();
                    }
                    AppState.isInitialLoad = false;
                    isInitialLoad = false; // Legacy compatibility
                    
                    if (dateChangeTimeout) {
                        clearTimeout(dateChangeTimeout);
                    }
                    dateChangeTimeout = setTimeout(function() {
                        processDateFromInput(true); // force process
                    }, 300); // debounce برای input event
                }
            });
            
            // 3. blur event - وقتی کاربر از input خارج می‌شود
            $("#date").on('blur', function() {
                console.log('✅ [Enterprise] blur event triggered');
                // ✅ فعال کردن polling وقتی کاربر تاریخ را تغییر می‌دهد
                if (!pollingEnabled) {
                    pollingEnabled = true;
                    startDatePolling();
                }
                AppState.isInitialLoad = false;
                isInitialLoad = false; // Legacy compatibility
                processDateFromInput(true); // force process
            });
            
            // 4. focus event - وقتی کاربر روی input کلیک می‌کند (فقط برای tracking)
            $("#date").on('focus', function() {
                console.log('✅ [Enterprise] focus event triggered');
                // ✅ فعال کردن polling وقتی کاربر روی input کلیک می‌کند
                if (!pollingEnabled) {
                    pollingEnabled = true;
                    startDatePolling();
                }
            });

            // ✅ Polling Mechanism Enterprise-Level (برای اطمینان از پردازش تاریخ)
            var pollingInterval = null;
            var lastPolledValue = null;
            
            function startDatePolling() {
                // ✅ فقط اگر polling فعال باشد
                if (!pollingEnabled) {
                    return;
                }
                
                if (pollingInterval) {
                    clearInterval(pollingInterval);
                }
                
                pollingInterval = setInterval(function() {
                    // ✅ فقط اگر polling فعال باشد
                    if (!pollingEnabled) {
                        return;
                    }
                    
                    var currentValue = $("#date").val();
                    if (currentValue && currentValue !== lastPolledValue) {
                        var englishValue = convertPersianToEnglishNumbers(currentValue);
                        if (englishValue.match(/^\d{4}\/\d{2}\/\d{2}$/)) {
                            console.log('✅ [Polling] Date changed detected:', englishValue);
                            lastPolledValue = currentValue;
                            processDateFromInput(true); // force process
                        }
                    }
                }, 500); // هر 500ms چک می‌کند
            }
            
            // ✅ Initialize Module (SRP: Initialization)
            var InitModule = {
                init: function() {
                    // ✅ Initialize Event Handlers
                    EventHandlersModule.init();
            
            // ✅ Initialize تاریخ اولیه و تنظیم flags
                    this.initializeDateState();
                },
                
                initializeDateState: function() {
                    // منتظر می‌مانیم تا کامپوننت تاریخ امروز را از سرور بگیرد
            setTimeout(function() {
                // تنظیم تاریخ اولیه در lastProcessedDate و lastPolledValue
                var initialDate = $("#date").val();
                if (initialDate) {
                    initialDate = convertPersianToEnglishNumbers(initialDate);
                    if (initialDate.match(/^\d{4}\/\d{2}\/\d{2}$/)) {
                        lastProcessedDate = initialDate;
                        lastPolledValue = $("#date").val();
                        console.log('✅ [Initial Load] Date initialized:', initialDate);
                    }
                } else {
                    // اگر تاریخ خالی است، منتظر می‌مانیم تا کامپوننت تاریخ امروز را تنظیم کند
                    var dateCheckInterval = setInterval(function() {
                        var currentDate = $("#date").val();
                        if (currentDate) {
                            clearInterval(dateCheckInterval);
                            var normalizedDate = convertPersianToEnglishNumbers(currentDate);
                            if (normalizedDate.match(/^\d{4}\/\d{2}\/\d{2}$/)) {
                                lastProcessedDate = normalizedDate;
                                lastPolledValue = currentDate;
                                console.log('✅ [Component] Date set from server:', normalizedDate);
                            }
                        }
                    }, 100);
                    
                    setTimeout(function() {
                        clearInterval(dateCheckInterval);
                    }, 3000);
                }
                
                // ✅ بعد از 2 ثانیه، بارگذاری اولیه تمام شده است
                setTimeout(function() {
                            AppState.isInitialLoad = false;
                            isInitialLoad = false; // Legacy compatibility
                            pollingEnabled = true;
                    datePickerInitialized = true;
                            console.log('✅ DatePicker initialized by component, polling enabled');
                }, 2000);
                    }, 1500); // تاخیر بیشتر برای اطمینان از initialize شدن کامپوننت
                }
            };
            
            // ✅ Initialize Application
            InitModule.init();

            // نمایش پیغام‌های NotificationHelper
            @{
                var successMsg = NotificationHelper.GetSuccess(TempData);
                var errorMsg = NotificationHelper.GetError(TempData);
                var warningMsg = NotificationHelper.GetWarning(TempData);
                var infoMsg = NotificationHelper.GetInfo(TempData);
            }
            @if (successMsg != null)
                {
                    <text>
                toastr.success('@Html.Raw(successMsg.Message)', '@Html.Raw(successMsg.Title)');
                    </text>
                }
            @if (errorMsg != null)
                {
                    <text>
                toastr.error('@Html.Raw(errorMsg.Message)', '@Html.Raw(errorMsg.Title)');
                    </text>
                }
            @if (warningMsg != null)
            {
                <text>
                toastr.warning('@Html.Raw(warningMsg.Message)', '@Html.Raw(warningMsg.Title)');
                </text>
            }
            @if (infoMsg != null)
            {
                <text>
                toastr.info('@Html.Raw(infoMsg.Message)', '@Html.Raw(infoMsg.Title)');
                </text>
            }
        });
    </script>
}
