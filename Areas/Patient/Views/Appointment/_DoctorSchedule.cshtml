@model ClinicApp.Models.DTOs.Appointment.DoctorScheduleDisplayDto

@if (Model != null && Model.WorkDays != null && Model.WorkDays.Any())
{
    <div class="doctor-schedule-container" data-schedule-id="@Model.ScheduleId">
        <!-- Header -->
        <div class="schedule-header">
            <div class="schedule-header-content">
                <i class="fas fa-calendar-alt schedule-icon"></i>
                <h3 class="schedule-title">برنامه کاری هفتگی</h3>
                @if (Model.AppointmentDuration > 0)
                {
                    <span class="appointment-duration-badge">
                        <i class="fas fa-clock"></i>
                        مدت زمان هر نوبت: @Model.AppointmentDuration دقیقه
                    </span>
                }
            </div>
        </div>

        <!-- Schedule Grid -->
        <div class="schedule-grid">
            @foreach (var workDay in Model.WorkDays)
            {
                <div class="schedule-day-card clickable" data-day="@workDay.DayOfWeek" data-day-name="@workDay.DayName" title="برای انتخاب تاریخ این روز کلیک کنید">
                    <div class="day-header">
                        <div class="day-name">@workDay.DayName</div>
                        <div class="day-name-short">@workDay.DayNameShort</div>
                    </div>
                    <div class="day-date-preview">
                        <i class="fas fa-calendar-alt"></i>
                        <span class="day-date-text" data-day-of-week="@workDay.DayOfWeek">در حال محاسبه...</span>
                    </div>
                    
                    @if (workDay.TimeRanges != null && workDay.TimeRanges.Any())
                    {
                        <div class="time-ranges-container">
                            @foreach (var timeRange in workDay.TimeRanges)
                            {
                                <div class="time-range-item" data-range-id="@timeRange.TimeRangeId">
                                    <div class="time-range-content">
                                        <i class="fas fa-clock time-icon"></i>
                                        <span class="time-display">@timeRange.DisplayRange</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="no-time-ranges">
                            <i class="fas fa-times-circle"></i>
                            <span>تعطیل</span>
                        </div>
                    }
                </div>
            }
        </div>

        @if (Model.ConsultationFee > 0)
        {
            <div class="consultation-fee-info">
                <i class="fas fa-money-bill-wave"></i>
                <span>هزینه ویزیت: @Model.ConsultationFee.ToString("N0") ریال</span>
            </div>
        }
    </div>
}
else
{
    <div class="no-schedule-message">
        <i class="fas fa-calendar-times"></i>
        <p>برنامه کاری برای این پزشک تعریف نشده است.</p>
    </div>
}

<style>
    /* ✅ Doctor Schedule Styles - طبق پرامپت (بدون گرادینت فانتزی) */
    .doctor-schedule-container {
        background-color: var(--medical-bg);
        border: 1px solid var(--medical-border);
        border-radius: 12px;
        padding: 1.5rem;
        margin: 1.5rem 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        position: relative;
    }

    .doctor-schedule-container::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background-color: var(--medical-primary);
    }

    /* Header */
    .schedule-header {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid var(--medical-border);
    }

    .schedule-header-content {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .schedule-icon {
        font-size: 2rem;
        color: var(--medical-primary);
    }

    .schedule-title {
        font-size: 1.5rem;
        font-weight: var(--font-weight-bold);
        color: var(--medical-text);
        margin: 0;
        flex: 1;
    }

    .appointment-duration-badge {
        background-color: var(--medical-info);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: var(--font-weight-medium);
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 2px 8px rgba(23, 162, 184, 0.2);
    }

    /* Schedule Grid */
    .schedule-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    /* Day Card */
    .schedule-day-card {
        background-color: var(--medical-bg);
        border: 1px solid var(--medical-border);
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        position: relative;
        cursor: pointer;
    }
    
    .schedule-day-card.clickable {
        cursor: pointer;
    }
    
    .schedule-day-card.clickable:hover {
        background-color: #e3f2fd;
        border-color: var(--medical-primary);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(44, 90, 160, 0.15);
    }

    .schedule-day-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background-color: var(--medical-primary);
        transform: scaleY(0);
        transition: transform 0.3s ease;
    }

    .schedule-day-card:hover::before {
        transform: scaleY(1);
    }
    
    .schedule-day-card.clickable:active {
        transform: translateY(0);
    }
    
    .day-date-preview {
        font-size: 0.85rem;
        color: var(--medical-text-muted);
        margin-top: 0.5rem;
        text-align: center;
        font-style: italic;
        transition: all 0.3s ease;
        min-height: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
    }
    
    .day-date-preview i {
        margin-left: 0.25rem;
    }
    
    .schedule-day-card.clickable:hover .day-date-preview {
        color: var(--medical-primary);
        font-weight: 500;
    }
    
    .schedule-day-card.clickable:hover .day-date-preview i {
        color: var(--medical-primary);
    }
    
    .schedule-day-card.selected-day {
        background-color: #e3f2fd;
        border: 2px solid var(--medical-primary);
        box-shadow: 0 4px 12px rgba(44, 90, 160, 0.2);
    }
    
    .schedule-day-card.selected-day::before {
        transform: scaleY(1);
        width: 6px;
    }

    /* ✅ Animation delays حذف شد - برای محیط درمانی مناسب نیست */

    /* Day Header */
    .day-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--medical-border);
    }

    .day-name {
        font-size: 1.1rem;
        font-weight: var(--font-weight-bold);
        color: var(--medical-text);
    }

    .day-name-short {
        font-size: 0.85rem;
        color: var(--medical-text-muted);
        background-color: var(--medical-bg-light);
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
    }

    /* Time Ranges */
    .time-ranges-container {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .time-range-item {
        background-color: var(--medical-bg-light);
        border: 1px solid var(--medical-border);
        border-radius: 8px;
        padding: 0.75rem;
        transition: all 0.2s ease;
    }

    .time-range-item:hover {
        background-color: #e3f2fd;
        border-color: var(--medical-primary);
        transform: translateX(3px);
        box-shadow: 0 2px 8px rgba(44, 90, 160, 0.1);
    }

    .time-range-content {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .time-icon {
        color: var(--medical-primary);
        font-size: 0.9rem;
    }

    .time-display {
        font-size: 0.95rem;
        color: var(--medical-text);
        font-weight: var(--font-weight-medium);
    }

    /* No Time Ranges */
    .no-time-ranges {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        color: #adb5bd;
        gap: 0.5rem;
    }

    .no-time-ranges i {
        font-size: 2rem;
        opacity: 0.5;
    }

    /* Consultation Fee */
    .consultation-fee-info {
        background-color: #fff3cd;
        border: 1px solid var(--medical-warning);
        border-radius: 8px;
        padding: 1rem;
        margin-top: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: var(--font-weight-bold);
        color: #856404;
    }

    .consultation-fee-info i {
        font-size: 1.25rem;
    }

    /* No Schedule Message */
    .no-schedule-message {
        text-align: center;
        padding: 3rem 2rem;
        color: var(--medical-text-muted);
    }

    .no-schedule-message i {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
        color: var(--medical-border);
    }

    .no-schedule-message p {
        font-size: 1.1rem;
        margin: 0;
    }

    /* ✅ Animations حذف شد - برای محیط درمانی مناسب نیست */

    /* ========== Responsive Design ========== */
    @@media (max-width: 768px) {
        .doctor-schedule-container {
            padding: 1.5rem;
            margin: 1rem 0;
        }

        .schedule-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .schedule-header-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .schedule-title {
            font-size: 1.25rem;
        }

        .schedule-day-card {
            padding: 1.25rem;
        }
    }

    @@media (max-width: 480px) {
        .doctor-schedule-container {
            padding: 1rem;
        }

        .schedule-day-card {
            padding: 1rem;
        }

        .time-range-item {
            padding: 0.5rem;
        }
    }
</style>

