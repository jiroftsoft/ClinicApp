@model ClinicApp.ViewModels.Patient.MedicalRecord.MedicalRecordIndexViewModel
@{
    Layout = null; // ✅ Partial View - No Layout
}

@* ✅ URLهای API از سرور برای جلوگیری از 404 (virtual path / route changes) *@
<!-- ✅ Medical Record Shell - Component-Based Architecture -->
<div id="medicalRecordShell" class="medical-record-shell"
     data-api-create="@Url.Action("CreateMedicalHistory", "MedicalRecordApi", new { area = "Patient" })"
     data-api-update="@Url.Action("UpdateMedicalHistory", "MedicalRecordApi", new { area = "Patient" })"
     data-api-base="@(Url.Action("GetMedicalHistories", "MedicalRecordApi", new { area = "Patient" })?.Replace("/GetMedicalHistories", "") ?? "/Patient/Api/MedicalRecord")">
    
    <!-- ✅ Header Section -->
    <section class="medical-record-header">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-12 col-md-8">
                    <h2 class="medical-record-title">
                        <i class="fas fa-file-medical-alt ml-2"></i>
                        پرونده الکترونیک سلامت
                    </h2>
                    <p class="medical-record-subtitle text-muted">
                        مشاهده و مدیریت اطلاعات پزشکی شما
                    </p>
                </div>
                <div class="col-12 col-md-4 text-left text-md-right mt-3 mt-md-0">
                    <div class="btn-group" role="group">
                        <button class="btn btn-primary btn-sm refresh-medical-record">
                            <i class="fas fa-sync-alt ml-1"></i>
                            به‌روزرسانی
                        </button>
                        <button type="button" class="btn btn-primary btn-sm dropdown-toggle dropdown-toggle-split" data-toggle="dropdown">
                            <span class="sr-only">Toggle Dropdown</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a class="dropdown-item no-print" href="#" id="medicalRecordPrintBtn" role="button">
                                <i class="fas fa-print ml-1"></i>
                                نسخه قابل چاپ
                            </a>
                            <div class="dropdown-divider no-print"></div>
                            <a class="dropdown-item" href="@Url.Action("ExportPdf", "MedicalRecord", new { area = "Patient" })" target="_blank">
                                <i class="fas fa-file-pdf ml-1"></i>
                                خروجی PDF
                            </a>
                            <a class="dropdown-item" href="@Url.Action("ExportExcel", "MedicalRecord", new { area = "Patient" })">
                                <i class="fas fa-file-excel ml-1"></i>
                                خروجی Excel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ✅ کارت خلاصه پرونده (فاز ۲.۱) -->
    <section class="medical-record-summary-card border rounded bg-white p-3 mb-3 shadow-sm">
        <h6 class="text-muted mb-2"><i class="fas fa-chart-pie ml-1"></i> خلاصه پرونده</h6>
        <div class="row g-2 small">
            <div class="col-6 col-md-3">
                <span class="text-muted">تاریخچه پزشکی:</span>
                <strong id="medicalRecordSummaryMedicalHistory" data-summary="medicalHistory">–</strong>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted">نوبت‌ها:</span>
                <strong id="medicalRecordSummaryAppointments" data-summary="appointments">–</strong>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted">پذیرش‌ها:</span>
                <strong id="medicalRecordSummaryReceptions" data-summary="receptions">–</strong>
            </div>
            <div class="col-6 col-md-3">
                <span class="text-muted">تریاژ:</span>
                <strong id="medicalRecordSummaryTriage" data-summary="triage">–</strong>
            </div>
        </div>
    </section>

    <!-- ✅ سوییچ نمای سکشن / تایم‌لاین (فاز ۲.۳) -->
    <section class="medical-record-view-mode mb-2">
        <div class="btn-group btn-group-sm" role="group" aria-label="نما">
            <button type="button" class="btn btn-outline-secondary active" id="medicalRecordViewSections" data-view="sections" aria-pressed="true">
                <i class="fas fa-th-large ml-1"></i>
                نمای سکشن‌ها
            </button>
            <button type="button" class="btn btn-outline-secondary" id="medicalRecordViewTimeline" data-view="timeline" aria-pressed="false">
                <i class="fas fa-stream ml-1"></i>
                نمای تایم‌لاین
            </button>
        </div>
    </section>

    <!-- ✅ نوار فیلتر یکپارچه (فاز ۲.۲) -->
    <section class="medical-record-filter-bar border-bottom bg-light py-3 mb-3">
        <div class="container-fluid">
            <div class="row align-items-center g-2">
                <div class="col-12 col-md-auto">
                    <label class="form-label small text-muted mb-0">بازه زمانی</label>
                    <select id="medicalRecordFilterDateRange" class="form-control form-control-sm" style="min-width: 140px;">
                        <option value="all" selected>همه</option>
                        <option value="3m">۳ ماه اخیر</option>
                        <option value="6m">۶ ماه اخیر</option>
                        <option value="1y">امسال</option>
                    </select>
                </div>
                <div class="col-12 col-md">
                    <label class="form-label small text-muted mb-0">جستجو در متن</label>
                    <input type="text" id="medicalRecordFilterSearch" class="form-control form-control-sm" placeholder="عنوان، توضیحات، یادداشت..." aria-label="جستجو در پرونده پزشکی" title="برای فوکوس سریع: Alt+ج" />
                </div>
                <div class="col-12 col-md-auto">
                    <label class="form-label small text-muted mb-0">نوع</label>
                    <select id="medicalRecordFilterType" class="form-control form-control-sm" style="min-width: 140px;">
                        <option value="all" selected>همه</option>
                        <option value="medicalHistory">تاریخچه پزشکی</option>
                        <option value="appointments">نوبت‌ها</option>
                        <option value="receptions">پذیرش‌ها</option>
                        <option value="triage">تریاژ</option>
                    </select>
                </div>
                <div class="col-12 col-md-auto pt-2 pt-md-0">
                    <button type="button" id="medicalRecordFilterApply" class="btn btn-primary btn-sm">
                        <i class="fas fa-filter ml-1"></i>
                        اعمال فیلتر
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ✅ نمای تایم‌لاین (بهینه‌شده) -->
    <section class="medical-record-timeline-view" id="medicalRecordTimelineView" style="display: none;">
        <div class="container-fluid">
            <div class="medical-record-timeline-loading" style="display: none;" role="status" aria-live="polite">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mb-0 mt-2 text-muted">در حال بارگذاری تایم‌لاین...</p>
            </div>
            <div class="medical-record-timeline-empty" style="display: none;">
                <i class="fas fa-stream d-block mb-2" aria-hidden="true"></i>
                <p class="text-muted mb-1">در بازه انتخاب‌شده رکوردی یافت نشد.</p>
                <p class="small text-muted mb-0">فیلترها را تغییر دهید یا نمای سکشن‌ها را امتحان کنید.</p>
            </div>
            <div class="medical-record-timeline-content"></div>
        </div>
    </section>

    <!-- ✅ Medical History Section (AJAX Loaded) -->
    <section class="medical-record-sections" id="medicalRecordSections">
        <div class="container-fluid">
            <div class="row">
                
                <!-- ✅ Component: Medical History -->
                <div class="col-12 mb-4">
                    <div class="medical-record-card" data-medical-record-section="medicalHistory">
                        <div class="medical-record-card-header">
                            <h3 class="medical-record-card-title">
                                <i class="fas fa-history ml-2"></i>
                                تاریخچه پزشکی
                            </h3>
                            <button type="button" class="btn btn-link btn-sm add-medical-history" data-bs-toggle="modal" data-bs-target="#medicalHistoryModal" aria-label="افزودن تاریخچه پزشکی">
                                <i class="fas fa-plus me-1"></i>
                                افزودن
                            </button>
                        </div>
                        <div class="medical-record-card-body">
                            <!-- ✅ Loading State -->
                            <div class="medical-record-section-loading">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">در حال بارگذاری...</span>
                                </div>
                                <span class="ml-2">در حال بارگذاری تاریخچه پزشکی...</span>
                            </div>
                            <!-- ✅ Content will be loaded via AJAX -->
                            <div class="medical-record-section-content" style="display: none;"></div>
                            <!-- ✅ Empty State -->
                            <div class="medical-record-section-empty" style="display: none;">
                                <p class="text-muted text-center py-4">
                                    <i class="fas fa-file-medical fa-2x mb-2"></i>
                                    <br>
                                    هیچ تاریخچه پزشکی ثبت نشده است
                                    <br>
                                    <button type="button" class="btn btn-primary btn-sm mt-3 add-medical-history" data-bs-toggle="modal" data-bs-target="#medicalHistoryModal">
                                        <i class="fas fa-plus me-1"></i>
                                        افزودن تاریخچه پزشکی
                                    </button>
                                </p>
                            </div>
                            <!-- ✅ Error State -->
                            <div class="medical-record-section-error" style="display: none;">
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-circle ml-1"></i>
                                    <span class="error-message">خطا در بارگذاری</span>
                                    <button class="btn btn-sm btn-outline-danger mt-2 reload-section" data-section="medicalHistory">
                                        تلاش مجدد
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ✅ Component: Appointments (AJAX Loaded) -->
                <div class="col-12 col-lg-6 mb-4">
                    <div class="medical-record-card" data-medical-record-section="appointments">
                        <div class="medical-record-card-header">
                            <h3 class="medical-record-card-title">
                                <i class="fas fa-calendar-check ml-2"></i>
                                نوبت‌های پزشکی
                            </h3>
                            <a href="@Url.Action("MyAppointments", "Appointment", new { area = "Patient" })" 
                               class="btn btn-link btn-sm" data-ajax="true">
                                مشاهده همه
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        </div>
                        <div class="medical-record-card-body">
                            <!-- ✅ Loading State -->
                            <div class="medical-record-section-loading">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">در حال بارگذاری...</span>
                                </div>
                                <span class="ml-2">در حال بارگذاری نوبت‌ها...</span>
                            </div>
                            <!-- ✅ Content will be loaded via AJAX -->
                            <div class="medical-record-section-content" style="display: none;"></div>
                            <!-- ✅ Empty State -->
                            <div class="medical-record-section-empty" style="display: none;">
                                <p class="text-muted text-center py-4">
                                    <i class="fas fa-calendar-times fa-2x mb-2"></i>
                                    <br>
                                    هیچ نوبتی یافت نشد
                                </p>
                            </div>
                            <!-- ✅ Error State -->
                            <div class="medical-record-section-error" style="display: none;">
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-circle ml-1"></i>
                                    <span class="error-message">خطا در بارگذاری</span>
                                    <button class="btn btn-sm btn-outline-danger mt-2 reload-section" data-section="appointments">
                                        تلاش مجدد
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ✅ Component: Receptions (AJAX Loaded) -->
                <div class="col-12 col-lg-6 mb-4">
                    <div class="medical-record-card" data-medical-record-section="receptions">
                        <div class="medical-record-card-header">
                            <h3 class="medical-record-card-title">
                                <i class="fas fa-file-medical ml-2"></i>
                                پذیرش‌ها
                            </h3>
                        </div>
                        <div class="medical-record-card-body">
                            <!-- ✅ Loading State -->
                            <div class="medical-record-section-loading">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">در حال بارگذاری...</span>
                                </div>
                                <span class="ml-2">در حال بارگذاری پذیرش‌ها...</span>
                            </div>
                            <!-- ✅ Content will be loaded via AJAX -->
                            <div class="medical-record-section-content" style="display: none;"></div>
                            <!-- ✅ Empty State -->
                            <div class="medical-record-section-empty" style="display: none;">
                                <p class="text-muted text-center py-4">
                                    <i class="fas fa-file-medical fa-2x mb-2"></i>
                                    <br>
                                    هیچ پذیرشی یافت نشد
                                </p>
                            </div>
                            <!-- ✅ Error State -->
                            <div class="medical-record-section-error" style="display: none;">
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-circle ml-1"></i>
                                    <span class="error-message">خطا در بارگذاری</span>
                                    <button class="btn btn-sm btn-outline-danger mt-2 reload-section" data-section="receptions">
                                        تلاش مجدد
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ✅ Component: Triage / علائم حیاتی (AJAX Loaded) -->
                <div class="col-12 mb-4">
                    <div class="medical-record-card" data-medical-record-section="triage">
                        <div class="medical-record-card-header">
                            <h3 class="medical-record-card-title">
                                <i class="fas fa-stethoscope ml-2"></i>
                                ارزیابی تریاژ و علائم حیاتی
                            </h3>
                        </div>
                        <div class="medical-record-card-body">
                            <div class="medical-record-section-loading">
                                <div class="spinner-border spinner-border-sm text-primary" role="status">
                                    <span class="visually-hidden">در حال بارگذاری...</span>
                                </div>
                                <span class="ml-2">در حال بارگذاری ارزیابی تریاژ...</span>
                            </div>
                            <div class="medical-record-section-content" style="display: none;"></div>
                            <div class="medical-record-section-empty" style="display: none;">
                                <p class="text-muted text-center py-4">
                                    <i class="fas fa-stethoscope fa-2x mb-2"></i>
                                    <br>
                                    هیچ ارزیابی تریاژی ثبت نشده است
                                </p>
                            </div>
                            <div class="medical-record-section-error" style="display: none;">
                                <div class="alert alert-danger">
                                    <i class="fas fa-exclamation-circle ml-1"></i>
                                    <span class="error-message">خطا در بارگذاری</span>
                                    <button class="btn btn-sm btn-outline-danger mt-2 reload-section" data-section="triage">
                                        تلاش مجدد
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ✅ مودال تاریخچه پزشکی داخل Shell تا در داشبورد (AJAX) هم موجود باشد - مسیر کامل چون از Dashboard لود می‌شود -->
    @Html.Partial("~/Areas/Patient/Views/MedicalRecord/_MedicalHistoryModal.cshtml", new ClinicApp.ViewModels.Patient.MedicalRecord.MedicalHistoryCreateEditViewModel())

</div>

