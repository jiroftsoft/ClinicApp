@{
    ViewBag.Title = "تنظیمات";
    var activeTab = ViewBag.ActiveTab ?? "account";
}

@section Styles {
    <style>
        /* ============================================
           Settings Page Styles
           ============================================ */
        .settings-container {
            padding: 1rem 0;
        }

        .settings-tabs {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .settings-tabs .nav-tabs {
            border-bottom: 2px solid #e9ecef;
            padding: 1rem 1rem 0;
        }

        .settings-tabs .nav-link {
            border: none;
            color: #6c757d;
            font-weight: 500;
            padding: 0.75rem 1.5rem;
            margin-bottom: -2px;
            border-bottom: 3px solid transparent;
            transition: all 0.3s;
        }

        .settings-tabs .nav-link:hover {
            color: var(--medical-primary);
            background: transparent;
        }

        .settings-tabs .nav-link.active {
            color: var(--medical-primary);
            background: transparent;
            border-bottom-color: var(--medical-primary);
            font-weight: 600;
        }

        .settings-tabs .tab-content {
            padding: 2rem;
        }

        .settings-section {
            margin-bottom: 2rem;
        }

        .settings-section-title {
            font-size: 1.125rem;
            font-weight: 600;
            color: #212529;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #e9ecef;
        }

        .settings-item {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 1.25rem;
            margin-bottom: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .settings-item-content {
            flex: 1;
        }

        .settings-item-title {
            font-weight: 600;
            color: #212529;
            margin-bottom: 0.25rem;
        }

        .settings-item-description {
            font-size: 0.875rem;
            color: #6c757d;
            margin: 0;
        }

        .settings-item-action {
            margin-right: 1rem;
        }

        /* Toggle Switch */
        .custom-switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
        }

        .custom-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .switch-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: 0.4s;
            border-radius: 26px;
        }

        .switch-slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: 0.4s;
            border-radius: 50%;
        }

        input:checked + .switch-slider {
            background-color: var(--medical-success);
        }

        input:checked + .switch-slider:before {
            transform: translateX(24px);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .settings-tabs .nav-tabs {
                flex-wrap: nowrap;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            .settings-tabs .nav-link {
                padding: 0.75rem 1rem;
                white-space: nowrap;
            }

            .settings-tabs .tab-content {
                padding: 1.5rem;
            }

            .settings-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .settings-item-action {
                margin-right: 0;
                margin-top: 1rem;
            }
        }
    </style>
}

<div class="settings-container">
    <!-- Page Header -->
    <div class="content-card-header">
        <i class="fas fa-cog me-2"></i>
        تنظیمات
    </div>

    <!-- Settings Tabs -->
    <div class="settings-tabs mt-3">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "account" ? "active" : "")" 
                        id="account-tab" 
                        data-bs-toggle="tab" 
                        data-bs-target="#account" 
                        type="button" 
                        role="tab">
                    <i class="fas fa-user me-1"></i>
                    حساب کاربری
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "notifications" ? "active" : "")" 
                        id="notifications-tab" 
                        data-bs-toggle="tab" 
                        data-bs-target="#notifications" 
                        type="button" 
                        role="tab">
                    <i class="fas fa-bell me-1"></i>
                    اعلان‌ها
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "privacy" ? "active" : "")" 
                        id="privacy-tab" 
                        data-bs-toggle="tab" 
                        data-bs-target="#privacy" 
                        type="button" 
                        role="tab">
                    <i class="fas fa-shield-alt me-1"></i>
                    حریم خصوصی
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "security" ? "active" : "")" 
                        id="security-tab" 
                        data-bs-toggle="tab" 
                        data-bs-target="#security" 
                        type="button" 
                        role="tab">
                    <i class="fas fa-lock me-1"></i>
                    امنیت
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <!-- Account Settings Tab -->
            <div class="tab-pane fade @(activeTab == "account" ? "show active" : "")" 
                 id="account" 
                 role="tabpanel">
                <div class="settings-section">
                    <h3 class="settings-section-title">اطلاعات حساب</h3>
                    
                    <div class="settings-item">
                        <div class="settings-item-content">
                            <div class="settings-item-title">پروفایل من</div>
                            <p class="settings-item-description">مشاهده و ویرایش اطلاعات شخصی</p>
                        </div>
                        <div class="settings-item-action">
                            <a href="@(Url.Action("Index", "Dashboard", new { area = "Patient" }))#profile" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-edit me-1"></i>
                                ویرایش
                            </a>
                        </div>
                    </div>

                    <div class="settings-item">
                        <div class="settings-item-content">
                                <div class="settings-item-title">ورود با کد یکبار مصرف (OTP)</div>
                            <p class="settings-item-description">ورود شما با ارسال کد تأیید به موبایل انجام می‌شود؛ نیازی به رمز عبور نیست.</p>
                        </div>
                        <div class="settings-item-action">
                            <span class="badge bg-success">فعال</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Notifications Settings Tab -->
            <div class="tab-pane fade @(activeTab == "notifications" ? "show active" : "")" 
                 id="notifications" 
                 role="tabpanel">
                <div class="settings-section">
                    <h3 class="settings-section-title">تنظیمات اعلان‌ها</h3>
                    
                    @using (Html.BeginForm("UpdateNotifications", "Settings", FormMethod.Post, new { id = "notificationsForm" }))
                    {
                        @Html.AntiForgeryToken()
                        
                        <div class="settings-item">
                            <div class="settings-item-content">
                                <div class="settings-item-title">اعلان‌های ایمیل</div>
                                <p class="settings-item-description">دریافت اعلان‌ها از طریق ایمیل</p>
                            </div>
                            <div class="settings-item-action">
                                <label class="custom-switch">
                                    <input type="checkbox" name="emailNotifications" id="emailNotifications" checked>
                                    <span class="switch-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-item">
                            <div class="settings-item-content">
                                <div class="settings-item-title">اعلان‌های پیامکی</div>
                                <p class="settings-item-description">دریافت اعلان‌ها از طریق پیامک</p>
                            </div>
                            <div class="settings-item-action">
                                <label class="custom-switch">
                                    <input type="checkbox" name="smsNotifications" id="smsNotifications" checked>
                                    <span class="switch-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-item">
                            <div class="settings-item-content">
                                <div class="settings-item-title">یادآوری نوبت</div>
                                <p class="settings-item-description">دریافت یادآوری قبل از نوبت پزشکی</p>
                            </div>
                            <div class="settings-item-action">
                                <label class="custom-switch">
                                    <input type="checkbox" name="appointmentReminders" id="appointmentReminders" checked>
                                    <span class="switch-slider"></span>
                                </label>
                            </div>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-1"></i>
                                ذخیره تغییرات
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Privacy Settings Tab -->
            <div class="tab-pane fade @(activeTab == "privacy" ? "show active" : "")" 
                 id="privacy" 
                 role="tabpanel">
                <div class="settings-section">
                    <h3 class="settings-section-title">تنظیمات حریم خصوصی</h3>
                    
                    <div class="settings-item">
                        <div class="settings-item-content">
                            <div class="settings-item-title">اشتراک‌گذاری اطلاعات پزشکی</div>
                            <p class="settings-item-description">اجازه اشتراک‌گذاری اطلاعات پزشکی با پزشکان</p>
                        </div>
                        <div class="settings-item-action">
                            <label class="custom-switch">
                                <input type="checkbox" checked>
                                <span class="switch-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="settings-item">
                        <div class="settings-item-content">
                            <div class="settings-item-title">نمایش نام در نظرات</div>
                            <p class="settings-item-description">نمایش نام واقعی در نظرات و بازخوردها</p>
                        </div>
                        <div class="settings-item-action">
                            <label class="custom-switch">
                                <input type="checkbox" checked>
                                <span class="switch-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="alert alert-info mt-3">
                        <i class="fas fa-info-circle me-1"></i>
                        اطلاعات پزشکی شما با رعایت کامل استانداردهای حفظ حریم خصوصی نگهداری می‌شود.
                    </div>
                </div>
            </div>

            <!-- Security Settings Tab -->
            <div class="tab-pane fade @(activeTab == "security" ? "show active" : "")" 
                 id="security" 
                 role="tabpanel">
                <div class="settings-section">
                    <h3 class="settings-section-title">تنظیمات امنیتی</h3>
                    
                    <div class="settings-item">
                        <div class="settings-item-content">
                            <div class="settings-item-title">ورود با کد یکبار مصرف (OTP)</div>
                            <p class="settings-item-description">ورود شما با ارسال کد تأیید به شماره موبایل ثبت‌شده انجام می‌شود.</p>
                        </div>
                        <div class="settings-item-action">
                            <span class="badge bg-success">فعال</span>
                        </div>
                    </div>

                    <div class="settings-item">
                        <div class="settings-item-content">
                            <div class="settings-item-title">احراز هویت دو مرحله‌ای</div>
                            <p class="settings-item-description">افزایش امنیت با احراز هویت دو مرحله‌ای</p>
                        </div>
                        <div class="settings-item-action">
                            <span class="badge bg-secondary">به زودی</span>
                        </div>
                    </div>

                    <div class="alert alert-info mt-3">
                        <i class="fas fa-mobile-alt me-1"></i>
                        <strong>نکته امنیتی:</strong> کد تأیید ارسال‌شده به موبایل را با دیگران به اشتراک نگذارید.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // ✅ Handle tab navigation
            var activeTab = '@activeTab';
            if (activeTab) {
                var tabEl = document.getElementById(activeTab + '-tab');
                if (tabEl) {
                    var tab = new bootstrap.Tab(tabEl);
                    tab.show();
                }
            }

            // ✅ Handle notifications form submission
            $('#notificationsForm').on('submit', function(e) {
                // Form will submit normally
                console.log('📝 Submitting notifications settings...');
            });

            // ✅ Handle switch toggle
            $('.custom-switch input').on('change', function() {
                var label = $(this).closest('.settings-item').find('.settings-item-title').text();
                var isChecked = $(this).is(':checked');
                console.log('🔄 ' + label + ': ' + (isChecked ? 'فعال' : 'غیرفعال'));
            });
        });
    </script>
}

