@model List<ClinicApp.ViewModels.CMS.HealthTipPublicViewModel>
@{
    ViewBag.Title = "نکات سلامت";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="health-tips-page py-5" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); min-height: 70vh;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h1 class="display-4 mb-3">
                    <i class="fas fa-heartbeat text-danger"></i>
                    نکات سلامت
                </h1>
                <p class="lead text-muted">راهنمایی‌های مفید برای حفظ سلامت و تندرستی شما</p>
            </div>
        </div>

        <!-- Category Filter -->
        @if (ViewBag.Categories != null && ((List<ClinicApp.ViewModels.CMS.HealthTipCategoryViewModel>)ViewBag.Categories).Any())
        {
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="btn-group flex-wrap" role="group">
                                <a href="@Url.Action("Index")" class="btn btn-@(ViewBag.SelectedCategory == null ? "primary" : "outline-primary") mb-2">
                                    <i class="fas fa-list"></i> همه (@(Model?.Count) ?? 0)
                                </a>
                                @foreach (var cat in ViewBag.Categories)
                                {
                                    <a href="@Url.Action("Index", new { category = cat.Category })" class="btn btn-@(ViewBag.SelectedCategory == cat.Category ? "primary" : "outline-primary") mb-2">
                                        <i class="@cat.IconClass"></i> @cat.DisplayName (@cat.Count)
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Search Box -->
        <div class="row mb-4">
            <div class="col-md-8 offset-md-2">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="input-group">
                            <input type="text" id="healthTipSearchInput" class="form-control form-control-lg" placeholder="جستجو در نکات سلامت...">
                            <div class="input-group-append">
                                <button class="btn btn-primary btn-lg" type="button" onclick="searchHealthTips()">
                                    <i class="fas fa-search"></i> جستجو
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Health Tips Grid -->
        <div class="row" id="healthTipsContainer">
            @if (Model != null && Model.Any())
            {
                foreach (var tip in Model)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="card health-tip-card h-100 shadow-lg border-0">
                            @if (!string.IsNullOrEmpty(tip.ThumbnailUrl))
                            {
                                <img src="@tip.ThumbnailUrl" class="card-img-top" alt="@tip.Title" style="height: 200px; object-fit: cover;">
                            }
                            else if (!string.IsNullOrEmpty(tip.ImageUrl))
                            {
                                <img src="@tip.ImageUrl" class="card-img-top" alt="@tip.Title" style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="card-img-top bg-gradient-primary d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <i class="fas fa-heartbeat fa-3x text-white"></i>
                                </div>
                            }
                            
                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    <span class="badge badge-primary">
                                        <i class="@GetCategoryIcon(tip.Category)"></i>
                                        @tip.CategoryDisplayName
                                    </span>
                                </div>
                                
                                <h5 class="card-title font-weight-bold">@tip.Title</h5>
                                
                                @if (!string.IsNullOrEmpty(tip.Summary))
                                {
                                    <p class="card-text text-muted flex-grow-1">@(tip.Summary.Length > 120 ? tip.Summary.Substring(0, 120) + "..." : tip.Summary)</p>
                                }
                                
                                <div class="mt-auto pt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <small class="text-muted">
                                            <i class="fas fa-eye"></i> @tip.ViewCount
                                        </small>
                                        <small class="text-muted">
                                            <i class="fas fa-share-alt"></i> @tip.ShareCount
                                        </small>
                                    </div>
                                    
                                    <a href="@Url.Action("Details", new { slug = tip.Slug })" class="btn btn-primary btn-block" onclick="incrementHealthTipView(@tip.HealthTipId)">
                                        <i class="fas fa-arrow-left"></i> مطالعه بیشتر
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle fa-2x mb-3"></i>
                        <h4>هیچ نکته سلامتی یافت نشد</h4>
                        <p class="mb-0">لطفاً دسته‌بندی دیگری را انتخاب کنید یا کلمه جستجوی دیگری وارد کنید.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function incrementHealthTipView(healthTipId) {
            $.ajax({
                url: '@Url.Action("IncrementView", "HealthTip")',
                type: 'POST',
                data: { id: healthTipId },
                success: function() {
                    // ViewCount افزایش یافت
                }
            });
        }

        function searchHealthTips() {
            var searchTerm = $('#healthTipSearchInput').val();
            if (!searchTerm || searchTerm.trim() === '') {
                alert('لطفاً کلمه‌ای برای جستجو وارد کنید');
                return;
            }

            $.ajax({
                url: '@Url.Action("Search", "HealthTip")',
                type: 'POST',
                data: { searchTerm: searchTerm },
                success: function(response) {
                    if (response.success && response.data && response.data.length > 0) {
                        displaySearchResults(response.data);
                    } else {
                        alert('نتیجه‌ای یافت نشد');
                    }
                },
                error: function() {
                    alert('خطا در جستجو');
                }
            });
        }

        function displaySearchResults(results) {
            var html = '';
            for (var i = 0; i < results.length; i++) {
                var tip = results[i];
                html += '<div class="col-lg-4 col-md-6 mb-4">';
                html += '<div class="card health-tip-card h-100 shadow-lg border-0">';
                if (tip.ThumbnailUrl) {
                    html += '<img src="' + tip.ThumbnailUrl + '" class="card-img-top" alt="' + tip.Title + '" style="height: 200px; object-fit: cover;">';
                } else {
                    html += '<div class="card-img-top bg-gradient-primary d-flex align-items-center justify-content-center" style="height: 200px;"><i class="fas fa-heartbeat fa-3x text-white"></i></div>';
                }
                html += '<div class="card-body d-flex flex-column">';
                html += '<h5 class="card-title font-weight-bold">' + tip.Title + '</h5>';
                if (tip.Summary) {
                    html += '<p class="card-text text-muted flex-grow-1">' + (tip.Summary.length > 120 ? tip.Summary.substring(0, 120) + '...' : tip.Summary) + '</p>';
                }
                html += '<a href="/HealthTip/Details?slug=' + tip.Slug + '" class="btn btn-primary btn-block mt-auto"><i class="fas fa-arrow-left"></i> مطالعه بیشتر</a>';
                html += '</div></div></div>';
            }
            $('#healthTipsContainer').html(html);
        }

        // جستجو با Enter
        $('#healthTipSearchInput').on('keypress', function(e) {
            if (e.which === 13) {
                searchHealthTips();
            }
        });
    </script>

    <style>
        .health-tips-page {
            position: relative;
        }

        .health-tip-card {
            border-radius: 15px;
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .health-tip-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.3) !important;
        }

        .health-tip-card .card-img-top {
            transition: transform 0.3s ease;
        }

        .health-tip-card:hover .card-img-top {
            transform: scale(1.1);
        }

        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
}

@functions {
    private string GetCategoryIcon(string category)
    {
        return category switch
        {
            "prevention" => "fas fa-shield-alt",
            "nutrition" => "fas fa-apple-alt",
            "exercise" => "fas fa-running",
            "diseases" => "fas fa-stethoscope",
            "general" => "fas fa-heart",
            _ => "fas fa-info-circle"
        };
    }
}

