@{
    ViewBag.Title = "تست دستگاه POS";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section MetaTags {
    <!-- Override CSP for SignalR (این صفحه نیاز به اتصال به localhost:5000 دارد) -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:5000; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:5000; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' http://localhost:5000 ws://localhost:5000; frame-ancestors 'none';">
}

<div class="container-fluid" dir="rtl">
    <div class="row">
        <div class="col-12">
            <!-- ✅ بخش ۱: هدر صفحه -->
            <div class="card border-primary mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-credit-card me-2"></i>
                        تست دستگاه POS
                    </h4>
                </div>
                <div class="card-body">
                    <p class="mb-0">
                        این صفحه برای تست و بررسی عملکرد دستگاه POS قبل از استفاده در ماژول پذیرش طراحی شده است.
                        لطفاً ترمینال مورد نظر را انتخاب کنید و تست‌ها را اجرا کنید.
                    </p>
                </div>
            </div>

            <!-- ✅ بخش ۲: انتخاب ترمینال -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-info">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-list me-2"></i>
                                انتخاب ترمینال
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <label for="terminalSelect" class="form-label">ترمینال POS:</label>
                                    <select id="terminalSelect" class="form-select">
                                        <option value="">-- انتخاب ترمینال --</option>
                                        @if (ViewBag.Terminals != null)
                                        {
                                            foreach (var terminal in (List<ClinicApp.Models.Entities.Payment.PosTerminal>)ViewBag.Terminals)
                                            {
                                                <option value="@terminal.PosTerminalId" 
                                                        data-terminal-id="@terminal.TerminalId"
                                                        data-merchant-id="@terminal.MerchantId"
                                                        data-ip="@terminal.IpAddress"
                                                        data-port="@terminal.Port"
                                                        data-provider="@terminal.Provider"
                                                        @(ViewBag.DefaultTerminal != null && ViewBag.DefaultTerminal.PosTerminalId == terminal.PosTerminalId ? "selected" : "")>
                                                    @terminal.Title - @terminal.TerminalId (@terminal.Provider)
                                                </option>
                                            }
                                        }
                                    </select>
                                    <small class="form-text text-muted">
                                        @if (ViewBag.TerminalCount != null && (int)ViewBag.TerminalCount == 0)
                                        {
                                            <span class="text-danger">
                                                <i class="fas fa-exclamation-triangle me-1"></i>
                                                هیچ ترمینالی یافت نشد. لطفاً ابتدا ترمینال را ایجاد کنید.
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                <i class="fas fa-info-circle me-1"></i>
                                                تعداد ترمینال‌های فعال: @(ViewBag.TerminalCount ?? 0)
                                            </span>
                                        }
                                    </small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">اطلاعات ترمینال:</label>
                                    <div id="terminalInfo" class="alert alert-light">
                                        <i class="fas fa-info-circle me-2"></i>
                                        لطفاً یک ترمینال را انتخاب کنید
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ✅ بخش ۳: کنترل‌های تست -->
            <div class="row">
                <div class="col-md-6">
                    <div class="card border-success">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-plug me-2"></i>
                                تست اتصال
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">
                                این تست فقط اتصال به دستگاه POS را بررسی می‌کند.
                            </p>
                            <button type="button" class="btn btn-success" id="testConnectionBtn">
                                <i class="fas fa-plug me-2"></i>
                                تست اتصال
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-warning">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">
                                <i class="fas fa-money-bill-wave me-2"></i>
                                تست پرداخت
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="testAmount" class="form-label">مبلغ تست (ریال):</label>
                                <input type="number" class="form-control" id="testAmount" value="1000" min="1" step="1">
                                <small class="form-text text-muted">مبلغ تستی برای ارسال به دستگاه</small>
                            </div>
                            <button type="button" class="btn btn-warning" id="testPaymentBtn">
                                <i class="fas fa-money-bill-wave me-2"></i>
                                تست پرداخت
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ✅ بخش ۴: نتایج تست -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card border-secondary">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-chart-line me-2"></i>
                                نتایج تست
                            </h5>
                        </div>
                        <div class="card-body">
                            <div id="testResults">
                                <div class="text-center text-muted">
                                    <i class="fas fa-info-circle fa-2x mb-3"></i>
                                    <p>هنوز تستی اجرا نشده است. لطفاً یکی از دکمه‌های بالا را کلیک کنید.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ✅ Anti-Forgery Token Form (Hidden) -->
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "antiForgeryForm", style = "display: none;" }))
{
    @Html.AntiForgeryToken()
}

<!-- ✅ بخش ۵: JavaScript -->
@section Scripts {
    <!-- SweetAlert2 -->
    <link href="~/Content/plugins/SweetAlert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/Content/plugins/SweetAlert2/sweetalert2@11.js"></script>
    
    <!-- SignalR Scripts (Client-Side) - طبق مستندات SSP1126 -->
    <script src="~/Scripts/jquery.signalR-2.4.2.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // ============================================
            // CLIENT-SIDE SIGNALR IMPLEMENTATION
            // طبق مستندات SSP1126-WebBased (PDF)
            // ============================================
            
            var posHub = null;
            var isConnected = false;
            var serverMessage = '';
            var currentTerminalInfo = null;
            
            // تنظیم آدرس SignalR Hub
            @{
                var signalRUrlFromConfig = System.Configuration.ConfigurationManager.AppSettings["SamanKishSignalRUrl"] ?? "http://localhost:5000/signalr";
                var signalRHubsUrl = signalRUrlFromConfig + "/hubs";
            }
            var signalRUrl = '@(signalRUrlFromConfig)';
            var signalRHubsUrl = '@(signalRHubsUrl)';
            
            // بارگذاری dynamic hubs script (برای رفع مشکل CSP)
            var hubsScript = document.createElement('script');
            hubsScript.src = signalRHubsUrl;
            hubsScript.onerror = function(error) {
                console.error('❌ Failed to load SignalR hubs from:', signalRHubsUrl);
                
                // ✅ تشخیص نوع خطا و ارائه راه‌حل دقیق‌تر
                var errorMessage = 'عدم امکان بارگذاری SignalR Hubs.\n\n';
                errorMessage += '🔍 وضعیت:\n';
                errorMessage += '• Service در حال اجرا است (Status: Running)\n';
                errorMessage += '• اما Port 5000 باز نیست (netstat خروجی ندارد)\n\n';
                errorMessage += '🔧 راه‌حل:\n';
                errorMessage += '1. Service را با دسترسی Admin Restart کنید:\n';
                errorMessage += '   PowerShell (Admin): Restart-Service -Name "SSP1126Service1" -Force\n\n';
                errorMessage += '2. بررسی کنید که Service روی Port 5000 listen می‌کند:\n';
                errorMessage += '   PowerShell: netstat -ano | findstr :5000 | findstr LISTENING\n\n';
                errorMessage += '3. بررسی Log های Service:\n';
                errorMessage += '   PowerShell: Get-Content "C:\\Log\\*.log" -Tail 50\n\n';
                errorMessage += '4. اگر مشکل ادامه داشت، Service را Stop و Start کنید:\n';
                errorMessage += '   PowerShell (Admin):\n';
                errorMessage += '   Stop-Service -Name "SSP1126Service1" -Force\n';
                errorMessage += '   Start-Service -Name "SSP1126Service1"';
                
                Swal.fire({
                    icon: 'error',
                    title: 'خطا در بارگذاری SignalR',
                    html: '<div dir="rtl" style="text-align: right; font-family: Tahoma; font-size: 12px;">' + 
                          errorMessage.replace(/\n/g, '<br>') + 
                          '</div>',
                    confirmButtonText: 'تأیید',
                    confirmButtonColor: '#dc3545',
                    width: '700px'
                });
            };
            hubsScript.onload = function() {
                console.log('✅ SignalR hubs loaded successfully');
                // تنظیم URL برای SignalR Connection
                $.connection.hub.url = signalRUrl;
                
                // ایجاد اتصال به Hub (SSP1126HUB)
                posHub = $.connection.SSP1126HUB;
                
                // ادامه initialization بعد از بارگذاری hubs
                initializeSignalRConnection();
            };
            document.head.appendChild(hubsScript);
            
            // تابع initialization که بعد از بارگذاری hubs فراخوانی می‌شود
            function initializeSignalRConnection() {
                // ============================================
                // EVENT HANDLERS (Client Callbacks)
                // ============================================
                
                // GetSystemResponse: پاسخ اولیه از Initial
                posHub.client.GetSystemResponse = function(message) {
                console.log('🔔 GetSystemResponse received:', message);
                serverMessage = message;
            };
            
            // GetCardSwiped: کارت کشیده شد
            posHub.client.GetCardSwiped = function(terminalId, cardNumberHash, cardNumberMask, purchaseTypes, encryptedNationalCode) {
                console.log('🔔 GetCardSwiped received:', {
                    terminalId: terminalId,
                    cardMask: cardNumberMask
                });
                
                // به‌روزرسانی پیام Loading
                Swal.update({
                    title: 'کارت کشیده شد',
                    html: '<div class="text-center"><i class="fas fa-credit-card fa-3x text-success"></i><p class="mt-3">لطفاً رمز کارت را وارد کنید...</p></div>'
                });
            };
            
            // GetTransactionResponse: پاسخ نهایی تراکنش (موفق، کنسل، خطا)
            posHub.client.GetTransactionResponse = function(terminalId, responseCode, serialId, rrn, responseDescription, txnDate, amount, cardNumberMask) {
                console.log('🔔🔔🔔 GetTransactionResponse CALLBACK INVOKED!!!', {
                    terminalId: terminalId,
                    responseCode: responseCode,
                    serialId: serialId,
                    rrn: rrn,
                    responseDescription: responseDescription,
                    txnDate: txnDate,
                    amount: amount,
                    cardNumberMask: cardNumberMask
                });
                
                // بستن Loading
                Swal.close();
                
                // بررسی کد پاسخ طبق مستندات SSP1126
                var isSuccess = responseCode === '0' || responseCode === '00';
                var message = '';
                var icon = 'info';
                
                if (isSuccess) {
                    message = responseDescription || 'تراکنش با موفقیت انجام شد';
                    icon = 'success';
                } else if (responseCode === '98') {
                    message = 'عملیات توسط کاربر لغو شد';
                    icon = 'warning';
                } else if (responseCode === '55') {
                    message = 'رمز کارت نامعتبر است';
                    icon = 'error';
                } else if (responseCode === '51') {
                    message = 'موجودی حساب کافی نیست';
                    icon = 'error';
                } else {
                    message = responseDescription || ('خطا: ' + responseCode);
                    icon = 'error';
                }
                
                // نمایش نتیجه با جزئیات
                var htmlContent = '<div style="text-align: right; direction: rtl;">';
                htmlContent += '<p style="font-size: 1.1rem; margin-bottom: 1rem; color: ' + (isSuccess ? '#28a745' : '#dc3545') + ';">' + message + '</p>';
                
                if (isSuccess) {
                    htmlContent += '<hr style="margin: 1rem 0;">';
                    htmlContent += '<h6 style="color: #2e5c8a; margin-bottom: 0.75rem;">اطلاعات تراکنش:</h6>';
                    htmlContent += '<div style="background: #d4edda; border-right: 4px solid #28a745; padding: 1rem; border-radius: 8px;">';
                    htmlContent += '<strong>RRN:</strong> ' + (rrn || 'نامشخص') + '<br>';
                    htmlContent += '<strong>Trace No:</strong> ' + (serialId || 'نامشخص') + '<br>';
                    htmlContent += '<strong>Card Last 4:</strong> ' + (cardNumberMask ? cardNumberMask.slice(-4) : 'نامشخص') + '<br>';
                    htmlContent += '<strong>Amount:</strong> ' + (amount ? parseFloat(amount).toLocaleString('fa-IR') + ' ریال' : 'نامشخص') + '<br>';
                    htmlContent += '<strong>Date:</strong> ' + (txnDate || 'نامشخص');
                    htmlContent += '</div>';
                } else {
                    htmlContent += '<hr style="margin: 1rem 0;">';
                    htmlContent += '<h6 style="color: #2e5c8a; margin-bottom: 0.75rem;">جزئیات خطا:</h6>';
                    htmlContent += '<div style="background: #f8d7da; border-right: 4px solid #dc3545; padding: 1rem; border-radius: 8px;">';
                    htmlContent += '<strong>Response Code:</strong> ' + responseCode + '<br>';
                    htmlContent += '<strong>Description:</strong> ' + (responseDescription || 'نامشخص');
                    htmlContent += '</div>';
                }
                
                htmlContent += '</div>';
                
                Swal.fire({
                    icon: icon,
                    title: isSuccess ? 'پرداخت موفق' : (responseCode === '98' ? 'لغو شد' : 'خطا'),
                    html: htmlContent,
                    confirmButtonText: 'تأیید',
                    confirmButtonColor: isSuccess ? '#28a745' : (responseCode === '98' ? '#ffc107' : '#dc3545'),
                    width: '700px'
                });
                
                // به‌روزرسانی UI
                $('#testPaymentBtn').prop('disabled', false).html('<i class="fas fa-money-bill-wave me-2"></i>تست پرداخت');
            };
            
            // ============================================
            // CONNECTION MANAGEMENT
            // ============================================
            
            // شروع اتصال به Hub
            $.connection.hub.start().done(function() {
                console.log('✅ Connected to POS SignalR Hub');
                isConnected = true;
            }).fail(function(error) {
                console.error('❌ Failed to connect to POS SignalR Hub:', error);
                isConnected = false;
                
                Swal.fire({
                    icon: 'error',
                    title: 'خطا در اتصال',
                    text: 'عدم ارتباط با سرویس پوز. آیا سرویس SSP1126 در حال اجراست؟',
                    confirmButtonText: 'تأیید',
                    confirmButtonColor: '#dc3545'
                });
            });
            
            // مدیریت تغییرات اتصال
            $.connection.hub.connectionSlow(function() {
                console.warn('⚠️ Connection slow');
            });
            
            $.connection.hub.reconnecting(function() {
                console.warn('⚠️ Reconnecting...');
            });
            
            $.connection.hub.reconnected(function() {
                console.log('✅ Reconnected');
                isConnected = true;
            });
            
            $.connection.hub.disconnected(function() {
                console.error('❌ Disconnected');
                isConnected = false;
            });
            } // پایان تابع initializeSignalRConnection
            
            // ============================================
            // EXISTING CODE
            // ============================================
            // تنظیمات اولیه - دریافت Anti-Forgery Token
            var token = $('input[name="__RequestVerificationToken"]').val();
            
            // اگر token وجود نداشت، صفحه را رفرش کن
            if (!token) {
                Swal.fire({
                    icon: 'error',
                    title: 'خطای امنیتی',
                    text: 'توکن امنیتی یافت نشد. در حال نوسازی صفحه...',
                    confirmButtonText: 'تأیید',
                    confirmButtonColor: '#dc3545',
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then(() => {
                    location.reload();
                });
                return;
            }

            // نمایش اطلاعات ترمینال
            $('#terminalSelect').change(function() {
                var selectedOption = $(this).find('option:selected');
                var terminalId = selectedOption.val();
                
                if (!terminalId) {
                    $('#terminalInfo').html('<i class="fas fa-info-circle me-2"></i>لطفاً یک ترمینال را انتخاب کنید');
                    return;
                }

                var info = `
                    <div class="row">
                        <div class="col-md-6">
                            <strong>شماره ترمینال:</strong> ${selectedOption.data('terminal-id') || 'نامشخص'}<br>
                            <strong>شماره پذیرنده:</strong> ${selectedOption.data('merchant-id') || 'نامشخص'}<br>
                            <strong>IP Address:</strong> ${selectedOption.data('ip') || 'نامشخص'}
                        </div>
                        <div class="col-md-6">
                            <strong>Port:</strong> ${selectedOption.data('port') || 'نامشخص'}<br>
                            <strong>Provider:</strong> ${selectedOption.data('provider') || 'نامشخص'}<br>
                            <strong>شناسه:</strong> ${terminalId}
                        </div>
                    </div>
                `;
                $('#terminalInfo').html(info);
            });

            // تست اتصال
            $('#testConnectionBtn').click(function() {
                console.log('🔍 Frontend: دکمه تست اتصال کلیک شد');
                var terminalId = $('#terminalSelect').val();
                console.log('🔍 Frontend: terminalId از select خوانده شد:', terminalId);
                
                if (!terminalId) {
                    console.warn('⚠️ Frontend: terminalId خالی است');
                    Swal.fire({
                        icon: 'warning',
                        title: 'هشدار',
                        text: 'لطفاً ابتدا یک ترمینال را انتخاب کنید',
                        confirmButtonText: 'تأیید',
                        confirmButtonColor: '#ffc107'
                    });
                    return;
                }
                
                console.log('🔍 Frontend: terminalId معتبر است:', terminalId);

                var btn = $(this);
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>در حال تست...');
                
                // نمایش Loading با SweetAlert
                Swal.fire({
                    title: 'در حال تست اتصال...',
                    html: '<div class="text-center"><i class="fas fa-spinner fa-spin fa-3x text-primary"></i><p class="mt-3">در حال برقراری ارتباط با دستگاه POS</p></div>',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                
                console.log('🔍 Frontend: ارسال AJAX Request - URL: @Url.Action("TestConnection", "PosTest")');
                console.log('🔍 Frontend: Data:', { __RequestVerificationToken: token ? 'present' : 'missing', terminalId: terminalId });
                
                $.ajax({
                    url: '@Url.Action("TestConnection", "PosTest")',
                    type: 'POST',
                    dataType: 'json', // مهم: برای parse کردن JSON response
                    contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
                    timeout: 120000, // 2 minutes timeout (برای SignalR و تست پورت‌ها)
                    data: {
                        __RequestVerificationToken: token,
                        terminalId: terminalId
                    },
                    beforeSend: function(xhr) {
                        console.log('🔍 Frontend: قبل از ارسال Request');
                        console.log('🔍 Frontend: Headers:', xhr.getAllResponseHeaders ? 'present' : 'not available');
                    },
                    success: function(response) {
                        console.log('🔍 Frontend: Response دریافت شد:', response);
                        console.log('🔍 Frontend: typeof response:', typeof response);
                        console.log('🔍 Frontend: response.Success:', response?.Success);
                        console.log('🔍 Frontend: response.success:', response?.success);
                        console.log('🔍 Frontend: response.Data:', response?.Data);
                        console.log('🔍 Frontend: response.data:', response?.data);
                        
                        // اگر response یک string است، آن را parse کن
                        if (typeof response === 'string') {
                            console.log('⚠️ Frontend: Response یک string است، در حال parse کردن...');
                            try {
                                response = JSON.parse(response);
                                console.log('✅ Frontend: Response parse شد:', response);
                            } catch (e) {
                                console.error('❌ Frontend: خطا در parse کردن Response:', e);
                                Swal.fire({
                                    icon: 'error',
                                    title: 'خطا در تست اتصال',
                                    text: 'خطا در پردازش پاسخ سرور',
                                    confirmButtonText: 'تأیید',
                                    confirmButtonColor: '#dc3545'
                                });
                                return;
                            }
                        }
                        
                        Swal.close();
                        
                        // بررسی Success با دقت بیشتر
                        var isSuccess = response && (
                            (response.Success === true) || 
                            (response.success === true) || 
                            (response.Success !== false && response.Success !== undefined)
                        );
                        
                        console.log('🔍 Frontend: isSuccess:', isSuccess);
                        
                        if (isSuccess) {
                            // استخراج data از response
                            var data = response.Data || response.data || response;
                            console.log('🔍 Frontend: data استخراج شد:', data);
                            
                            // اگر data یک object با connectionStatus است، مستقیماً استفاده کن
                            // در غیر این صورت، از response استفاده کن
                            if (!data.connectionStatus && response.Data && response.Data.connectionStatus) {
                                data = response.Data;
                                console.log('🔍 Frontend: استفاده از response.Data:', data);
                            }
                            
                            console.log('🔍 Frontend: نمایش نتیجه موفق - connectionStatus:', data?.connectionStatus);
                            showConnectionResultWithSweetAlert(data);
                            showConnectionResult(data);
                        } else {
                            var errorMsg = (response && response.Message) || (response && response.message) || 'خطا در تست اتصال';
                            console.error('❌ Frontend: خطا در Response - ErrorMsg:', errorMsg);
                            Swal.fire({
                                icon: 'error',
                                title: 'خطا در تست اتصال',
                                html: '<div style="text-align: right; direction: rtl;">' + errorMsg + '</div>',
                                confirmButtonText: 'تأیید',
                                confirmButtonColor: '#dc3545'
                            });
                            showError(errorMsg);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('❌ Frontend: خطا در AJAX Request');
                        console.error('❌ Frontend: Status:', status);
                        console.error('❌ Frontend: Error:', error);
                        console.error('❌ Frontend: Status Code:', xhr.status);
                        console.error('❌ Frontend: Response Text:', xhr.responseText);
                        console.error('❌ Frontend: Response JSON:', xhr.responseJSON);
                        
                        Swal.close();
                        var errorMsg = 'خطا در ارتباط با سرور';
                        var errorDetails = [];
                        var metadata = {};
                        
                        // بررسی Timeout
                        if (status === 'timeout') {
                            console.error('❌ Frontend: Timeout - زمان اتصال به پایان رسید');
                            errorMsg = 'زمان اتصال به پایان رسید. لطفاً بررسی کنید:\n' +
                                '• Windows Service SSP1126SignalRWindowsService در حال اجرا است\n' +
                                '• Port 8080 باز است\n' +
                                '• آدرس SignalR در Web.config صحیح است\n' +
                                '• دستگاه POS در شبکه قابل دسترس است';
                            errorDetails.push('<strong>نوع خطا:</strong> Timeout');
                            errorDetails.push('<strong>زمان انتظار:</strong> 120 ثانیه');
                        } else if (status === 'error') {
                            errorMsg = 'خطا در ارتباط با سرور: ' + (error || 'خطای نامشخص');
                        }
                        
                        if (xhr.responseJSON) {
                            if (xhr.responseJSON.Message) {
                                errorMsg = xhr.responseJSON.Message;
                            } else if (xhr.responseJSON.message) {
                                errorMsg = xhr.responseJSON.message;
                            }
                            
                            // Extract metadata for detailed error display
                            if (xhr.responseJSON.Metadata) {
                                metadata = xhr.responseJSON.Metadata;
                                if (metadata.IpAddress) errorDetails.push('<strong>IP:</strong> ' + metadata.IpAddress);
                                if (metadata.Port) errorDetails.push('<strong>Port:</strong> ' + metadata.Port);
                                if (metadata.TerminalId) errorDetails.push('<strong>Terminal ID:</strong> ' + metadata.TerminalId);
                                if (metadata.Provider) errorDetails.push('<strong>Provider:</strong> ' + metadata.Provider);
                                if (metadata.SocketErrorCode) errorDetails.push('<strong>Socket Error:</strong> ' + metadata.SocketErrorCode);
                                if (metadata.SocketErrorCodeNumber) errorDetails.push('<strong>Error Code:</strong> ' + metadata.SocketErrorCodeNumber);
                                if (metadata.NativeErrorCode) errorDetails.push('<strong>Native Error:</strong> ' + metadata.NativeErrorCode);
                                if (metadata.ExceptionType) errorDetails.push('<strong>Exception Type:</strong> ' + metadata.ExceptionType);
                            }
                            
                            if (xhr.responseJSON.Code === 'ANTIFORGERY_MISSING') {
                                errorMsg = 'توکن امنیتی منقضی شده است. لطفاً صفحه را نوسازی کنید.';
                                Swal.fire({
                                    icon: 'error',
                                    title: 'خطای امنیتی',
                                    html: '<div style="text-align: right; direction: rtl;">' + errorMsg + '</div>',
                                    confirmButtonText: 'نوسازی صفحه',
                                    confirmButtonColor: '#dc3545'
                                }).then(() => {
                                    location.reload();
                                });
                                return;
                            }
                        }
                        
                        // Build detailed error HTML
                        var errorHtml = '<div style="text-align: right; direction: rtl;">';
                        errorHtml += '<p style="font-size: 1.1rem; margin-bottom: 1rem; color: #dc3545;">' + errorMsg + '</p>';
                        
                        if (errorDetails.length > 0) {
                            errorHtml += '<hr style="margin: 1rem 0;">';
                            errorHtml += '<h6 style="color: #2e5c8a; margin-bottom: 0.75rem;">جزئیات خطا:</h6>';
                            errorHtml += '<div style="background: #f8d7da; border-right: 4px solid #dc3545; padding: 1rem; border-radius: 8px;">';
                            errorHtml += errorDetails.join('<br>');
                            errorHtml += '</div>';
                        }
                        
                        errorHtml += '</div>';
                        
                        Swal.fire({
                            icon: 'error',
                            title: 'خطا در تست اتصال',
                            html: errorHtml,
                            confirmButtonText: 'تأیید',
                            confirmButtonColor: '#dc3545',
                            width: '700px'
                        });
                        showError(errorMsg);
                    },
                    complete: function() {
                        btn.prop('disabled', false).html('<i class="fas fa-plug me-2"></i>تست اتصال');
                    }
                });
            });

            // تست پرداخت (CLIENT-SIDE - طبق مستندات SSP1126)
            $('#testPaymentBtn').click(function() {
                var terminalId = $('#terminalSelect').val();
                var amount = parseFloat($('#testAmount').val());
                var selectedOption = $('#terminalSelect').find('option:selected');
                
                if (!terminalId) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'هشدار',
                        text: 'لطفاً ابتدا یک ترمینال را انتخاب کنید',
                        confirmButtonText: 'تأیید',
                        confirmButtonColor: '#ffc107'
                    });
                    return;
                }
                
                if (!amount || amount <= 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'هشدار',
                        text: 'لطفاً مبلغ معتبری وارد کنید',
                        confirmButtonText: 'تأیید',
                        confirmButtonColor: '#ffc107'
                    });
                    return;
                }
                
                // بررسی اتصال به SignalR
                if (!isConnected || !posHub) {
                    Swal.fire({
                        icon: 'error',
                        title: 'خطا',
                        text: 'اتصال به سرویس پوز برقرار نیست. لطفاً صفحه را نوسازی کنید.',
                        confirmButtonText: 'تأیید',
                        confirmButtonColor: '#dc3545'
                    });
                    return;
                }

                // تأیید با SweetAlert
                Swal.fire({
                    title: 'تأیید تست پرداخت',
                    html: '<div style="text-align: right; direction: rtl;">' +
                          '<p style="font-size: 1.1rem; margin-bottom: 1rem;">آیا مطمئن هستید که می‌خواهید مبلغ زیر را به دستگاه ارسال کنید؟</p>' +
                          '<div style="background: #f0f7ff; border-right: 4px solid #4a90e2; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">' +
                          '<strong style="color: #2e5c8a; font-size: 1.2rem;">' + amount.toLocaleString('fa-IR') + ' ریال</strong>' +
                          '</div>' +
                          '<div style="background: #fff3e0; border-right: 4px solid #f0ad4e; padding: 0.75rem; border-radius: 8px;">' +
                          '<i class="fas fa-exclamation-triangle" style="color: #f0ad4e; margin-left: 0.5rem;"></i>' +
                          '<strong style="color: #f0ad4e;">توجه:</strong> این یک تست واقعی است و مبلغ به دستگاه ارسال می‌شود!' +
                          '</div>' +
                          '</div>',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'بله، ارسال کن',
                    cancelButtonText: 'انصراف',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#dc3545',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        var btn = $('#testPaymentBtn');
                        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>در حال پردازش...');
                        
                        // ذخیره اطلاعات ترمینال
                        currentTerminalInfo = {
                            terminalId: selectedOption.data('terminal-id'),
                            ipAddress: selectedOption.data('ip'),
                            amount: amount
                        };
                        
                        // نمایش Loading
                        Swal.fire({
                            title: 'در حال اتصال...',
                            html: '<div class="text-center"><i class="fas fa-spinner fa-spin fa-3x text-primary"></i><p class="mt-3">در حال اتصال به دستگاه POS</p></div>',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            showConfirmButton: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });
                        
                        console.log('🔍 Client-Side Payment: شروع فرایند پرداخت');
                        console.log('🔍 Client-Side Payment: TerminalId:', currentTerminalInfo.terminalId);
                        console.log('🔍 Client-Side Payment: IP:', currentTerminalInfo.ipAddress);
                        console.log('🔍 Client-Side Payment: Amount:', amount);
                        
                        // Step 1: Initial (طبق مستندات SSP1126)
                        // پارامترها: MediaType (1=Network), IP, COM (null), AccountType (0=Single), Language (0=Farsi), Additional ("0")
                        serverMessage = '';
                        posHub.server.Initial(
                            1, // MediaType: Network
                            currentTerminalInfo.ipAddress, // IP
                            null, // COM Port (null for Network)
                            0, // AccountType: Single
                            0, // Language: Farsi
                            '0' // Additional
                        );
                        
                        console.log('🔍 Client-Side Payment: Initial invoked, waiting for GetSystemResponse...');
                        
                        // منتظر GetSystemResponse (1 ثانیه)
                        setTimeout(function() {
                            if (serverMessage === '0') {
                                console.log('✅ Client-Side Payment: Initial successful, sending amount...');
                                
                                // به‌روزرسانی Loading
                                Swal.update({
                                    title: 'در حال ارسال مبلغ...',
                                    html: '<div class="text-center"><i class="fas fa-spinner fa-spin fa-3x text-warning"></i><p class="mt-3">در حال ارسال مبلغ ' + amount.toLocaleString('fa-IR') + ' ریال به دستگاه POS</p><p class="mt-2 text-muted">لطفاً کارت را روی دستگاه بکشید...</p></div>'
                                });
                                
                                // Step 2: SendAmount1Step (طبق مستندات SSP1126)
                                // پارامترها: Amount, Amounts (null), Additional (null), Reference (null), PurchaseID (null), TerminalID
                                posHub.server.SendAmount1Step(
                                    amount.toString(), // Main Amount
                                    null, // Amounts (null for Single Account)
                                    null, // Additional Data
                                    null, // Reference Data
                                    null, // PurchaseID
                                    currentTerminalInfo.terminalId // TerminalID
                                );
                                
                                console.log('✅ Client-Side Payment: SendAmount1Step invoked, waiting for GetTransactionResponse...');
                            } else {
                                console.error('❌ Client-Side Payment: Initial failed - Response:', serverMessage);
                                Swal.close();
                                btn.prop('disabled', false).html('<i class="fas fa-money-bill-wave me-2"></i>تست پرداخت');
                                
                                Swal.fire({
                                    icon: 'error',
                                    title: 'خطا در اتصال',
                                    text: 'خطا در اتصال به دستگاه POS. کد خطا: ' + serverMessage,
                                    confirmButtonText: 'تأیید',
                                    confirmButtonColor: '#dc3545'
                                });
                            }
                        }, 1000); // 1 second delay after Initial (طبق مستندات)
                    }
                });
            });
            
            // ============================================
            // TEST CONNECTION (Server-Side - نگه داشته شده)
            // ============================================

            // نمایش نتیجه تست اتصال
            function showConnectionResult(data) {
                console.log('🔍 Frontend: showConnectionResult فراخوانی شد - data:', data);
                console.log('🔍 Frontend: data.connectionStatus:', data?.connectionStatus);
                console.log('🔍 Frontend: data.message:', data?.message);
                console.log('🔍 Frontend: data.terminalInfo:', data?.terminalInfo);
                
                var statusClass = data && data.connectionStatus === 'موفق' ? 'success' : 'danger';
                var statusIcon = data && data.connectionStatus === 'موفق' ? 'check-circle' : 'times-circle';
                console.log('🔍 Frontend: statusClass:', statusClass, 'statusIcon:', statusIcon);
                
                var terminalInfoHtml = '';
                if (data && data.terminalInfo) {
                    terminalInfoHtml = `
                        <hr>
                        <h6>اطلاعات ترمینال:</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>شماره ترمینال:</strong> ${data.terminalInfo.terminalId || 'نامشخص'}<br>
                                <strong>شماره پذیرنده:</strong> ${data.terminalInfo.merchantId || 'نامشخص'}<br>
                                <strong>IP Address:</strong> ${data.terminalInfo.ipAddress || 'نامشخص'}
                            </div>
                            <div class="col-md-6">
                                <strong>Port:</strong> ${data.terminalInfo.port || 'نامشخص'}<br>
                                <strong>Provider:</strong> ${data.terminalInfo.provider || 'نامشخص'}
                            </div>
                        </div>
                    `;
                }

                var paymentInfoHtml = '';
                if (data.paymentStatus === 'موفق') {
                    paymentInfoHtml = `
                        <hr>
                        <h6>اطلاعات پرداخت:</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>RRN:</strong> ${data.rrn || 'نامشخص'}<br>
                                <strong>Trace No:</strong> ${data.traceNo || 'نامشخص'}
                            </div>
                            <div class="col-md-6">
                                <strong>Card Last 4:</strong> ${data.cardLast4 || 'نامشخص'}<br>
                                <strong>پیام:</strong> ${data.message || 'نامشخص'}
                            </div>
                        </div>
                    `;
                }

                var html = `
                    <div class="alert alert-${statusClass}">
                        <h6><i class="fas fa-${statusIcon} me-2"></i>وضعیت اتصال: ${data && data.connectionStatus ? data.connectionStatus : 'نامشخص'}</h6>
                        ${data && data.message ? `<p class="mb-0">${data.message}</p>` : ''}
                        ${terminalInfoHtml}
                        ${paymentInfoHtml}
                    </div>
                `;
                
                console.log('🔍 Frontend: نمایش نتیجه در #testResults - html length:', html.length);
                $('#testResults').html(html);
                console.log('🔍 Frontend: نتیجه در #testResults نمایش داده شد');
            }

            // نمایش نتیجه تست پرداخت
            function showPaymentResult(data) {
                console.log('🔍 Frontend: showPaymentResult فراخوانی شد - data:', data);
                
                var isSuccess = data.success !== false && (data.paymentStatus === 'موفق' || data.success === true);
                var statusClass = isSuccess ? 'success' : 'danger';
                var statusIcon = isSuccess ? 'check-circle' : 'times-circle';
                
                var durationHtml = '';
                if (data.durationMs) {
                    durationHtml = `<strong>زمان پردازش:</strong> ${(data.durationMs / 1000).toFixed(2)} ثانیه<br>`;
                }
                
                var retryHtml = '';
                if (data.retryCount !== undefined && data.retryCount > 0) {
                    retryHtml = `<strong>تعداد تلاش:</strong> ${data.retryCount + 1}<br>`;
                }
                
                var operationIdHtml = '';
                if (data.operationId) {
                    operationIdHtml = `<strong>Operation ID:</strong> ${data.operationId}<br>`;
                }
                
                var html = `
                    <div class="alert alert-${statusClass}">
                        <h6><i class="fas fa-${statusIcon} me-2"></i>نتیجه تست پرداخت: ${isSuccess ? 'موفق' : 'ناموفق'}</h6>
                        ${data.message ? `<p class="mb-2"><strong>پیام:</strong> ${data.message}</p>` : ''}
                        <hr>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>RRN:</strong> ${data.rrn || 'نامشخص'}<br>
                                <strong>Trace No:</strong> ${data.traceNo || 'نامشخص'}<br>
                                <strong>Card Last 4:</strong> ${data.cardLast4 || 'نامشخص'}<br>
                                <strong>Terminal ID:</strong> ${data.terminalId || 'نامشخص'}
                            </div>
                            <div class="col-md-6">
                                <strong>مبلغ:</strong> ${data.amount ? parseFloat(data.amount).toLocaleString('fa-IR') + ' ریال' : 'نامشخص'}<br>
                                ${durationHtml}
                                ${retryHtml}
                                ${operationIdHtml}
                            </div>
                        </div>
                        ${data.terminalInfo ? `
                            <hr>
                            <h6>اطلاعات ترمینال:</h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>شماره ترمینال:</strong> ${data.terminalInfo.terminalId || 'نامشخص'}<br>
                                    <strong>شماره پذیرنده:</strong> ${data.terminalInfo.merchantId || 'نامشخص'}<br>
                                    <strong>IP Address:</strong> ${data.terminalInfo.ipAddress || 'نامشخص'}
                                </div>
                                <div class="col-md-6">
                                    <strong>Port:</strong> ${data.terminalInfo.port || 'نامشخص'}<br>
                                    <strong>Provider:</strong> ${data.terminalInfo.provider || 'نامشخص'}
                                </div>
                            </div>
                        ` : ''}
                    </div>
                `;
                
                console.log('🔍 Frontend: نمایش نتیجه در #testResults');
                $('#testResults').html(html);
            }

            // نمایش خطا
            function showError(message) {
                var html = `
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        ${message}
                    </div>
                `;
                $('#testResults').html(html);
            }

            // نمایش نتیجه تست اتصال با SweetAlert
            function showConnectionResultWithSweetAlert(data) {
                console.log('🔍 Frontend: showConnectionResultWithSweetAlert فراخوانی شد - data:', data);
                var isSuccess = data && data.connectionStatus === 'موفق';
                console.log('🔍 Frontend: isSuccess در showConnectionResultWithSweetAlert:', isSuccess);
                
                var htmlContent = '<div style="text-align: right; direction: rtl;">';
                
                if (data && data.message) {
                    htmlContent += '<p style="font-size: 1.1rem; margin-bottom: 1rem;">' + data.message + '</p>';
                }
                
                if (data.terminalInfo) {
                    htmlContent += '<hr style="margin: 1rem 0;">';
                    htmlContent += '<h6 style="color: #2e5c8a; margin-bottom: 0.75rem;">اطلاعات ترمینال:</h6>';
                    htmlContent += '<div style="background: #f0f7ff; border-right: 4px solid #4a90e2; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">';
                    htmlContent += '<strong>شماره ترمینال:</strong> ' + (data.terminalInfo.terminalId || 'نامشخص') + '<br>';
                    htmlContent += '<strong>شماره پذیرنده:</strong> ' + (data.terminalInfo.merchantId || 'نامشخص') + '<br>';
                    htmlContent += '<strong>IP Address:</strong> ' + (data.terminalInfo.ipAddress || 'نامشخص') + '<br>';
                    htmlContent += '<strong>Port:</strong> ' + (data.terminalInfo.port || 'نامشخص') + '<br>';
                    htmlContent += '<strong>Provider:</strong> ' + (data.terminalInfo.provider || 'نامشخص');
                    htmlContent += '</div>';
                }
                
                if (data.paymentStatus === 'موفق') {
                    htmlContent += '<hr style="margin: 1rem 0;">';
                    htmlContent += '<h6 style="color: #28a745; margin-bottom: 0.75rem;">اطلاعات پرداخت:</h6>';
                    htmlContent += '<div style="background: #d4edda; border-right: 4px solid #28a745; padding: 1rem; border-radius: 8px;">';
                    htmlContent += '<strong>RRN:</strong> ' + (data.rrn || 'نامشخص') + '<br>';
                    htmlContent += '<strong>Trace No:</strong> ' + (data.traceNo || 'نامشخص') + '<br>';
                    htmlContent += '<strong>Card Last 4:</strong> ' + (data.cardLast4 || 'نامشخص');
                    htmlContent += '</div>';
                }
                
                htmlContent += '</div>';
                
                console.log('🔍 Frontend: نمایش SweetAlert - isSuccess:', isSuccess, 'htmlContent length:', htmlContent.length);
                
                Swal.fire({
                    icon: isSuccess ? 'success' : 'error',
                    title: isSuccess ? 'اتصال موفق' : 'اتصال ناموفق',
                    html: htmlContent,
                    confirmButtonText: 'تأیید',
                    confirmButtonColor: isSuccess ? '#28a745' : '#dc3545',
                    width: '600px'
                }).then((result) => {
                    console.log('🔍 Frontend: SweetAlert بسته شد - result:', result);
                });
            }

            // نمایش نتیجه تست پرداخت با SweetAlert
            function showPaymentResultWithSweetAlert(data, amount) {
                console.log('🔍 Frontend: showPaymentResultWithSweetAlert فراخوانی شد - data:', data, 'amount:', amount);
                
                var isSuccess = data.success !== false && (data.paymentStatus === 'موفق' || data.success === true);
                console.log('🔍 Frontend: isSuccess در showPaymentResultWithSweetAlert:', isSuccess);
                
                var htmlContent = '<div style="text-align: right; direction: rtl;">';
                
                if (data.message) {
                    htmlContent += '<p style="font-size: 1.1rem; margin-bottom: 1rem; color: ' + (isSuccess ? '#28a745' : '#dc3545') + ';">' + data.message + '</p>';
                }
                
                htmlContent += '<hr style="margin: 1rem 0;">';
                htmlContent += '<h6 style="color: #2e5c8a; margin-bottom: 0.75rem;">اطلاعات پرداخت:</h6>';
                htmlContent += '<div style="background: ' + (isSuccess ? '#d4edda' : '#f8d7da') + '; border-right: 4px solid ' + (isSuccess ? '#28a745' : '#dc3545') + '; padding: 1rem; border-radius: 8px; margin-bottom: 1rem;">';
                htmlContent += '<strong>مبلغ:</strong> ' + (amount ? parseFloat(amount).toLocaleString('fa-IR') + ' ریال' : 'نامشخص') + '<br>';
                htmlContent += '<strong>RRN:</strong> ' + (data.rrn || 'نامشخص') + '<br>';
                htmlContent += '<strong>Trace No:</strong> ' + (data.traceNo || 'نامشخص') + '<br>';
                htmlContent += '<strong>Card Last 4:</strong> ' + (data.cardLast4 || 'نامشخص') + '<br>';
                htmlContent += '<strong>Terminal ID:</strong> ' + (data.terminalId || 'نامشخص');
                
                if (data.durationMs) {
                    htmlContent += '<br><strong>زمان پردازش:</strong> ' + (data.durationMs / 1000).toFixed(2) + ' ثانیه';
                }
                
                if (data.retryCount !== undefined && data.retryCount > 0) {
                    htmlContent += '<br><strong>تعداد تلاش:</strong> ' + (data.retryCount + 1);
                }
                
                if (data.operationId) {
                    htmlContent += '<br><strong>Operation ID:</strong> ' + data.operationId;
                }
                
                htmlContent += '</div>';
                
                if (data.terminalInfo) {
                    htmlContent += '<hr style="margin: 1rem 0;">';
                    htmlContent += '<h6 style="color: #2e5c8a; margin-bottom: 0.75rem;">اطلاعات ترمینال:</h6>';
                    htmlContent += '<div style="background: #f0f7ff; border-right: 4px solid #4a90e2; padding: 1rem; border-radius: 8px;">';
                    htmlContent += '<strong>شماره ترمینال:</strong> ' + (data.terminalInfo.terminalId || 'نامشخص') + '<br>';
                    htmlContent += '<strong>شماره پذیرنده:</strong> ' + (data.terminalInfo.merchantId || 'نامشخص') + '<br>';
                    htmlContent += '<strong>IP Address:</strong> ' + (data.terminalInfo.ipAddress || 'نامشخص') + '<br>';
                    htmlContent += '<strong>Port:</strong> ' + (data.terminalInfo.port || 'نامشخص') + '<br>';
                    htmlContent += '<strong>Provider:</strong> ' + (data.terminalInfo.provider || 'نامشخص');
                    htmlContent += '</div>';
                }
                
                htmlContent += '</div>';
                
                console.log('🔍 Frontend: نمایش SweetAlert - isSuccess:', isSuccess, 'htmlContent length:', htmlContent.length);
                
                Swal.fire({
                    icon: isSuccess ? 'success' : 'error',
                    title: isSuccess ? 'پرداخت موفق' : 'پرداخت ناموفق',
                    html: htmlContent,
                    confirmButtonText: 'تأیید',
                    confirmButtonColor: isSuccess ? '#28a745' : '#dc3545',
                    width: '700px'
                }).then((result) => {
                    console.log('🔍 Frontend: SweetAlert بسته شد - result:', result);
                });
            }

            // بارگذاری اولیه اطلاعات ترمینال در صورت وجود ترمینال پیش‌فرض
            @if (ViewBag.DefaultTerminal != null)
            {
                <text>
                $('#terminalSelect').trigger('change');
                </text>
            }
        });
    </script>
}

