@model List<ClinicApp.ViewModels.CMS.MedicalServiceInfoPublicViewModel>
@{
    ViewBag.Title = "خدمات پزشکی";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="medical-services-page py-5" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); min-height: 70vh;">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h1 class="display-4 mb-3">
                    <i class="fas fa-stethoscope text-success"></i>
                    خدمات پزشکی ما
                </h1>
                <p class="lead text-muted">خدمات تخصصی و حرفه‌ای برای سلامت و تندرستی شما</p>
            </div>
        </div>

        <!-- Search Box -->
        <div class="row mb-4">
            <div class="col-md-8 offset-md-2">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="input-group">
                            <input type="text" id="serviceSearchInput" class="form-control form-control-lg" placeholder="جستجو در خدمات پزشکی...">
                            <div class="input-group-append">
                                <button class="btn btn-primary btn-lg" type="button" onclick="searchServices()">
                                    <i class="fas fa-search"></i> جستجو
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Medical Services Grid -->
        <div class="row" id="servicesContainer">
            @if (Model != null && Model.Any())
            {
                @foreach (var service in Model)
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="card medical-service-card h-100 shadow-lg border-0">
                            @if (!string.IsNullOrEmpty(service.ThumbnailUrl))
                            {
                                <img src="@service.ThumbnailUrl" class="card-img-top" alt="@service.ServiceTitle" style="height: 200px; object-fit: cover;">
                            }
                            else if (!string.IsNullOrEmpty(service.ImageUrl))
                            {
                                <img src="@service.ImageUrl" class="card-img-top" alt="@service.ServiceTitle" style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="card-img-top bg-gradient-primary d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <i class="fas fa-stethoscope fa-3x text-white"></i>
                                </div>
                            }
                            
                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    <span class="badge badge-primary">
                                        <i class="fas fa-tag"></i>
                                        @service.ServiceCategoryName
                                    </span>
                                </div>
                                
                                <h5 class="card-title font-weight-bold">@service.ServiceTitle</h5>
                                
                                @if (!string.IsNullOrEmpty(service.Description))
                                {
                                    <p class="card-text text-muted flex-grow-1">@(service.Description.Length > 120 ? service.Description.Substring(0, 120) + "..." : service.Description)</p>
                                }
                                
                                @if (service.Features != null && service.Features.Any())
                                {
                                    <div class="mb-3">
                                        <small class="text-muted">
                                            <i class="fas fa-check-circle text-success"></i>
                                            @string.Join(", ", service.Features.Take(2))
                                        </small>
                                    </div>
                                }
                                
                                <div class="mt-auto pt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        @if (service.Price.HasValue)
                                        {
                                            <span class="badge badge-success">
                                                <i class="fas fa-money-bill-wave"></i>
                                                @(service.Price.Value.ToString("N0")) ریال
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(service.EstimatedDuration))
                                        {
                                            <small class="text-muted">
                                                <i class="fas fa-clock"></i> @service.EstimatedDuration
                                            </small>
                                        }
                                    </div>
                                    
                                    <a href="@Url.Action("Details", new { slug = service.Slug })" class="btn btn-primary btn-block" onclick="incrementServiceView(@service.MedicalServiceInfoId)">
                                        <i class="fas fa-arrow-left"></i> اطلاعات بیشتر
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle fa-2x mb-3"></i>
                        <h4>هیچ خدمت پزشکی یافت نشد</h4>
                        <p class="mb-0">لطفاً کلمه جستجوی دیگری وارد کنید.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function incrementServiceView(serviceInfoId) {
            $.ajax({
                url: '@Url.Action("IncrementView", "MedicalServiceInfo")',
                type: 'POST',
                data: { id: serviceInfoId },
                success: function() {
                    // ViewCount افزایش یافت
                }
            });
        }

        function searchServices() {
            var searchTerm = $('#serviceSearchInput').val();
            if (!searchTerm || searchTerm.trim() === '') {
                alert('لطفاً کلمه‌ای برای جستجو وارد کنید');
                return;
            }

            $.ajax({
                url: '@Url.Action("Search", "MedicalServiceInfo")',
                type: 'POST',
                data: { searchTerm: searchTerm },
                success: function(response) {
                    if (response.success && response.data && response.data.length > 0) {
                        displaySearchResults(response.data);
                    } else {
                        alert('نتیجه‌ای یافت نشد');
                    }
                },
                error: function() {
                    alert('خطا در جستجو');
                }
            });
        }

        function displaySearchResults(results) {
            var html = '';
            for (var i = 0; i < results.length; i++) {
                var service = results[i];
                html += '<div class="col-lg-4 col-md-6 mb-4">';
                html += '<div class="card medical-service-card h-100 shadow-lg border-0">';
                if (service.ThumbnailUrl) {
                    html += '<img src="' + service.ThumbnailUrl + '" class="card-img-top" alt="' + service.ServiceTitle + '" style="height: 200px; object-fit: cover;">';
                } else {
                    html += '<div class="card-img-top bg-gradient-primary d-flex align-items-center justify-content-center" style="height: 200px;"><i class="fas fa-stethoscope fa-3x text-white"></i></div>';
                }
                html += '<div class="card-body d-flex flex-column">';
                html += '<h5 class="card-title font-weight-bold">' + service.ServiceTitle + '</h5>';
                if (service.Description) {
                    html += '<p class="card-text text-muted flex-grow-1">' + (service.Description.length > 120 ? service.Description.substring(0, 120) + '...' : service.Description) + '</p>';
                }
                html += '<a href="/MedicalServiceInfo/Details?slug=' + service.Slug + '" class="btn btn-primary btn-block mt-auto"><i class="fas fa-arrow-left"></i> اطلاعات بیشتر</a>';
                html += '</div></div></div>';
            }
            $('#servicesContainer').html(html);
        }

        // جستجو با Enter
        $('#serviceSearchInput').on('keypress', function(e) {
            if (e.which === 13) {
                searchServices();
            }
        });
    </script>

    <style>
        .medical-services-page {
            position: relative;
        }

        .medical-service-card {
            border-radius: 15px;
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .medical-service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.2) !important;
        }

        .medical-service-card .card-img-top {
            transition: transform 0.3s ease;
        }

        .medical-service-card:hover .card-img-top {
            transform: scale(1.1);
        }

        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
}

