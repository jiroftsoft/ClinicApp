@model ClinicApp.ViewModels.CMS.MedicalServiceInfoPublicIndexPageViewModel
@{
    ViewBag.Title = "خدمات پزشکی";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/medical-service-info-pages.css")" />

<div class="medical-service-info-wrap" role="main" aria-label="خدمات پزشکی">
    @Html.AntiForgeryToken()
    <div class="container">
        <header class="medical-service-info-header">
            <h1 class="medical-service-info-title">
                <i class="fas fa-stethoscope" aria-hidden="true"></i>
                خدمات پزشکی ما
            </h1>
            <p class="medical-service-info-subtitle">خدمات تخصصی و حرفه‌ای برای سلامت و تندرستی شما</p>
        </header>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="medical-service-info-alert" role="alert">
                <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <div class="medical-service-info-search">
            <form class="medical-service-info-search-form" role="search" aria-label="جستجو در خدمات" onsubmit="return false;">
                <label for="serviceSearchInput" class="sr-only">جستجو در خدمات پزشکی</label>
                <input type="search"
                       id="serviceSearchInput"
                       class="medical-service-info-search-input"
                       placeholder="جستجو در خدمات پزشکی..."
                       aria-label="جستجو در خدمات پزشکی"
                       autocomplete="off" />
                <button type="button" class="medical-service-info-search-btn" id="serviceSearchBtn" aria-label="اجرای جستجو">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    جستجو
                </button>
            </form>
        </div>

        <div class="medical-service-info-grid" id="servicesContainer">
            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var service in Model.Items)
                {
                    <article class="medical-service-info-card" aria-label="@service.ServiceTitle">
                        <div class="medical-service-info-card-img-wrap">
                            @if (!string.IsNullOrEmpty(service.ThumbnailUrl))
                            {
                                <img src="@service.ThumbnailUrl" alt="@service.ServiceTitle" loading="lazy" width="400" height="240" />
                            }
                            else if (!string.IsNullOrEmpty(service.ImageUrl))
                            {
                                <img src="@service.ImageUrl" alt="@service.ServiceTitle" loading="lazy" width="400" height="240" />
                            }
                            else
                            {
                                <div class="medical-service-info-card-placeholder">
                                    <i class="fas fa-stethoscope" aria-hidden="true"></i>
                                </div>
                            }
                        </div>
                        <div class="medical-service-info-card-body">
                            <span class="medical-service-info-card-category">@(string.IsNullOrEmpty(service.ServiceCategoryName) ? "بدون دسته‌بندی" : service.ServiceCategoryName)</span>
                            <h2 class="medical-service-info-card-title">@service.ServiceTitle</h2>
                            @if (!string.IsNullOrEmpty(service.Description))
                            {
                                var desc = service.Description.Length > 120 ? service.Description.Substring(0, 120) + "…" : service.Description;
                                <p class="medical-service-info-card-description">@desc</p>
                            }
                            @if (service.Features != null && service.Features.Any())
                            {
                                <div class="medical-service-info-card-features">
                                    @foreach (var f in service.Features.Take(3))
                                    {
                                        <span><i class="fas fa-check-circle" aria-hidden="true"></i> @f</span>
                                    }
                                </div>
                            }
                            <div class="medical-service-info-card-meta">
                                @if (service.Price.HasValue)
                                {
                                    <span class="medical-service-info-card-price"><i class="fas fa-money-bill-wave" aria-hidden="true"></i> @(service.Price.Value.ToString("N0")) ریال</span>
                                }
                                else
                                {
                                    <span class="medical-service-info-card-price"><i class="fas fa-info-circle" aria-hidden="true"></i> قیمت تماس بگیرید</span>
                                }
                                @if (!string.IsNullOrEmpty(service.EstimatedDuration))
                                {
                                    <span class="medical-service-info-card-duration"><i class="fas fa-clock" aria-hidden="true"></i> @service.EstimatedDuration</span>
                                }
                            </div>
                            <a href="@Url.Action("Details", new { slug = service.Slug })"
                               class="medical-service-info-card-btn"
                               aria-label="اطلاعات بیشتر: @service.ServiceTitle"
                               data-service-id="@service.MedicalServiceInfoId">
                                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                                اطلاعات بیشتر
                            </a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="medical-service-info-empty">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    <h2>هیچ خدمت پزشکی یافت نشد</h2>
                    <p>لطفاً کلمه جستجوی دیگری وارد کنید.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var indexUrl = '@Url.Action("Index")';
            var detailsBaseUrl = '@Url.Action("Details", "MedicalServiceInfo")';
            var searchUrl = '@Url.Action("Search", "MedicalServiceInfo")';
            var incrementUrl = '@Url.Action("IncrementView", "MedicalServiceInfo")';

            function incrementView(id) {
                if (!id) return;
                var xhr = new XMLHttpRequest();
                xhr.open('POST', incrementUrl, true);
                xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
                xhr.send('id=' + encodeURIComponent(id) + '&__RequestVerificationToken=' + encodeURIComponent(document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''));
            }

            document.getElementById('servicesContainer').addEventListener('click', function(e) {
                var link = e.target.closest('a[data-service-id]');
                if (link) incrementView(link.getAttribute('data-service-id'));
            });

            document.getElementById('serviceSearchBtn').addEventListener('click', doSearch);
            document.getElementById('serviceSearchInput').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') { e.preventDefault(); doSearch(); }
            });

            function escapeHtml(s) {
                if (!s) return '';
                var div = document.createElement('div');
                div.textContent = s;
                return div.innerHTML;
            }

            function doSearch() {
                var term = (document.getElementById('serviceSearchInput').value || '').trim();
                if (!term) {
                    alert('لطفاً کلمه‌ای برای جستجو وارد کنید');
                    return;
                }
                var container = document.getElementById('servicesContainer');
                container.innerHTML = '<div class="medical-service-info-empty" style="grid-column:1/-1"><i class="fas fa-spinner fa-spin"></i><p>در حال جستجو...</p></div>';
                var formData = new FormData();
                formData.append('searchTerm', term);
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
                fetch(searchUrl, { method: 'POST', body: formData })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.success && data.data && data.data.length > 0) {
                            var html = '';
                            data.data.forEach(function(s) {
                                var cat = escapeHtml(s.ServiceCategoryName || 'بدون دسته‌بندی');
                                var desc = s.Description ? (s.Description.length > 120 ? s.Description.substring(0, 120) + '…' : s.Description) : '';
                                var priceHtml = s.Price ?
                                    '<span class="medical-service-info-card-price"><i class="fas fa-money-bill-wave"></i> ' + new Intl.NumberFormat('fa-IR').format(s.Price) + ' ریال</span>' :
                                    '<span class="medical-service-info-card-price"><i class="fas fa-info-circle"></i> قیمت تماس بگیرید</span>';
                                var durationHtml = s.EstimatedDuration ? '<span class="medical-service-info-card-duration"><i class="fas fa-clock"></i> ' + escapeHtml(s.EstimatedDuration) + '</span>' : '';
                                html += '<article class="medical-service-info-card"><div class="medical-service-info-card-img-wrap">';
                                if (s.ThumbnailUrl) html += '<img src="' + escapeHtml(s.ThumbnailUrl) + '" alt="' + escapeHtml(s.ServiceTitle) + '" loading="lazy">';
                                else if (s.ImageUrl) html += '<img src="' + escapeHtml(s.ImageUrl) + '" alt="' + escapeHtml(s.ServiceTitle) + '" loading="lazy">';
                                else html += '<div class="medical-service-info-card-placeholder"><i class="fas fa-stethoscope"></i></div>';
                                html += '</div><div class="medical-service-info-card-body">';
                                html += '<span class="medical-service-info-card-category">' + cat + '</span>';
                                html += '<h2 class="medical-service-info-card-title">' + escapeHtml(s.ServiceTitle) + '</h2>';
                                if (desc) html += '<p class="medical-service-info-card-description">' + escapeHtml(desc) + '</p>';
                                html += '<div class="medical-service-info-card-meta">' + priceHtml + durationHtml + '</div>';
                                html += '<a href="' + detailsBaseUrl + '?slug=' + encodeURIComponent(s.Slug) + '" class="medical-service-info-card-btn" data-service-id="' + s.MedicalServiceInfoId + '"><i class="fas fa-arrow-left"></i> اطلاعات بیشتر</a>';
                                html += '</div></article>';
                            });
                            container.innerHTML = '<div class="medical-service-info-empty" style="grid-column:1/-1;margin-bottom:1rem;">نمایش نتایج جستجو برای «' + escapeHtml(term) + '» — <a href="' + indexUrl + '">پاک کردن و بازگشت</a></div>' + html;
                        } else {
                            container.innerHTML = '<div class="medical-service-info-empty"><i class="fas fa-info-circle"></i><h2>نتیجه‌ای یافت نشد</h2><p>لطفاً عبارت دیگری جستجو کنید یا <a href="' + indexUrl + '">به لیست بازگردید</a>.</p></div>';
                        }
                    })
                    .catch(function() {
                        container.innerHTML = '<div class="medical-service-info-empty"><i class="fas fa-exclamation-triangle"></i><h2>خطا در جستجو</h2><p><a href="' + indexUrl + '">بارگذاری مجدد صفحه</a></p></div>';
                    });
            }
        })();
    </script>
}
