@model ClinicApp.ViewModels.CMS.MedicalServiceInfoPublicViewModel
@{
    ViewBag.Title = Model.ServiceTitle;
    ViewBag.MetaDescription = Model.Description;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/medical-service-info-pages.css")" />

<div class="medical-service-info-wrap" role="main" aria-label="جزئیات خدمت پزشکی">
    <div class="container">
        <article class="medical-service-detail-article" itemscope itemtype="https://schema.org/MedicalProcedure">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="medical-service-detail-hero">
                    <img src="@Model.ImageUrl" alt="@Model.ServiceTitle" itemprop="image" />
                </div>
            }

            <div class="medical-service-detail-body">
                <div class="medical-service-detail-meta">
                    <span class="badge badge-primary">@(string.IsNullOrEmpty(Model.ServiceCategoryName) ? "بدون دسته‌بندی" : Model.ServiceCategoryName)</span>
                    <span class="badge badge-secondary"><i class="fas fa-barcode" aria-hidden="true"></i> کد: @Model.ServiceCode</span>
                </div>

                <h1 class="medical-service-detail-title" itemprop="name">@Model.ServiceTitle</h1>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="medical-service-detail-summary" aria-label="خلاصه">
                        <strong>خلاصه:</strong> @Model.Description
                    </div>
                }

                @if (Model.Price.HasValue)
                {
                    <div class="medical-service-detail-price-box">
                        <strong><i class="fas fa-money-bill-wave" aria-hidden="true"></i> قیمت:</strong>
                        <span>@(Model.Price.Value.ToString("N0")) ریال</span>
                    </div>
                }

                @if (Model.Features != null && Model.Features.Any())
                {
                    <div class="medical-service-detail-section">
                        <h4><i class="fas fa-check-circle text-success" aria-hidden="true"></i> ویژگی‌های خدمت</h4>
                        <ul class="medical-service-detail-list">
                            @foreach (var feature in Model.Features)
                            {
                                <li><i class="fas fa-check text-success" aria-hidden="true"></i> @feature</li>
                            }
                        </ul>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.FullDescription))
                {
                    <div class="medical-service-detail-section">
                        <h4>توضیحات کامل</h4>
                        <div class="medical-service-detail-content">
                            @Html.Raw(Model.FullDescription)
                        </div>
                    </div>
                }

                @if (Model.InsuranceCoverage != null && Model.InsuranceCoverage.Any())
                {
                    <div class="medical-service-detail-section">
                        <h4><i class="fas fa-shield-alt text-primary" aria-hidden="true"></i> پوشش بیمه</h4>
                        <ul class="medical-service-detail-list">
                            @foreach (var coverage in Model.InsuranceCoverage)
                            {
                                <li><i class="fas fa-check-circle text-primary" aria-hidden="true"></i> @coverage</li>
                            }
                        </ul>
                    </div>
                }

                @if (Model.RequiredDocuments != null && Model.RequiredDocuments.Any())
                {
                    <div class="medical-service-detail-section">
                        <h4><i class="fas fa-file-alt text-info" aria-hidden="true"></i> مدارک مورد نیاز</h4>
                        <ul class="medical-service-detail-list">
                            @foreach (var doc in Model.RequiredDocuments)
                            {
                                <li><i class="fas fa-file text-info" aria-hidden="true"></i> @doc</li>
                            }
                        </ul>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.EstimatedDuration))
                {
                    <div class="medical-service-detail-section">
                        <h4><i class="fas fa-clock text-warning" aria-hidden="true"></i> مدت زمان تقریبی</h4>
                        <p class="medical-service-detail-content">@Model.EstimatedDuration</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.VideoUrl))
                {
                    <div class="medical-service-detail-section">
                        <a href="@Model.VideoUrl" target="_blank" rel="noopener noreferrer" class="medical-service-info-card-btn" style="display:inline-flex;text-decoration:none;" aria-label="مشاهده ویدیو آموزشی">
                            <i class="fas fa-play" aria-hidden="true"></i> مشاهده ویدیو آموزشی
                        </a>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.RelatedLinkUrl))
                {
                    <div class="medical-service-detail-section">
                        <a href="@Model.RelatedLinkUrl" target="_blank" rel="noopener noreferrer" class="medical-service-info-card-btn" style="display:inline-flex;text-decoration:none;" aria-label="اطلاعات بیشتر">
                            <i class="fas fa-external-link-alt" aria-hidden="true"></i> اطلاعات بیشتر
                        </a>
                    </div>
                }

                <div class="medical-service-detail-section" style="margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--ms-border);display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1rem;">
                    <span class="medical-service-info-card-duration"><i class="fas fa-eye" aria-hidden="true"></i> @Model.ViewCount بازدید</span>
                    <a href="@Url.Action("Index")" class="medical-service-detail-back" aria-label="بازگشت به لیست خدمات">
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        بازگشت به لیست خدمات
                    </a>
                </div>
            </div>
        </article>
    </div>
</div>
