        // ✅ دیباگ: بررسی Stories
        System.Diagnostics.Debug.WriteLine($"[Layout] Stories Count: {layoutData?.Stories?.Count ?? 0}");
        if (layoutData?.Stories != null && layoutData.Stories.Any())
        {
            System.Diagnostics.Debug.WriteLine($"[Layout] Stories found: {string.Join(", ", layoutData.Stories.Select(s => s.Title))}");
        }
        else
        {
            System.Diagnostics.Debug.WriteLine("[Layout] No stories found or Stories is null");
        }
    }

