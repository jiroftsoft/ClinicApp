@using ClinicApp.Helpers
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
    <!-- Medical Environment: No Cache Policy -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate, max-age=0">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <meta http-equiv="Last-Modified" content="@DateTime.UtcNow.ToString("R")">
    <meta name="cache-control" content="no-cache">
    <meta name="expires" content="0">
    <meta name="pragma" content="no-cache">
    <title>@(string.IsNullOrEmpty(ViewBag.Title) ? "کلینیک شفا جیرفت | بهترین خدمات درمانی" : ViewBag.Title + " - کلینیک شفا جیرفت")</title>
    
    <!-- Meta Tags Section (CSP can be overridden here) -->
    @RenderSection("MetaTags", required: false)
    
    <!-- Content Security Policy for Production (Optimized for Local Fonts) -->
    <!-- Only apply default CSP if not already set in MetaTags section -->
    @if (!IsSectionDefined("MetaTags"))
    {
        <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:5000 https://cdn.ckeditor.com https://maps.googleapis.com; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:5000 https://cdn.ckeditor.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.ckeditor.com https://maps.googleapis.com; img-src 'self' data: blob: https://maps.googleapis.com https://maps.gstatic.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; connect-src 'self' http://localhost:5000 ws://localhost:5000 https://maps.googleapis.com; frame-src 'self' https://www.google.com https://maps.google.com https://maps.googleapis.com; object-src 'none'; base-uri 'self'; form-action 'self';">
    }
    
    <meta name="description" content="کلینیک شفا جیرفت با ارائه خدمات درمانی تخصصی، پزشکان باتجربه و تجهیزات پیشرفته. رزرو آنلاین نوبت، مشاوره پزشکی و خدمات درمانی با کیفیت در شهر جیرفت." />
    <meta name="keywords" content="کلینیک شفا جیرفت, کلینیک درمانی جیرفت, رزرو نوبت جیرفت, پزشکان جیرفت, خدمات درمانی جیرفت, کلینیک شفا, پزشک متخصص جیرفت, درمان در جیرفت" />
    <meta name="author" content="کلینیک شفا جیرفت" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.placename" content="جیرفت" />
    <meta name="geo.region" content="IR-Kerman" />
    <meta property="og:title" content="@(string.IsNullOrEmpty(ViewBag.Title) ? "کلینیک شفا جیرفت | بهترین خدمات درمانی" : ViewBag.Title)" />
    <meta property="og:description" content="رزرو آنلاین نوبت و مشاوره با پزشکان متخصص کلینیک شفا در جیرفت." />
    <meta property="og:type" content="website" />
    @{
        var baseUrl = $"{Request.Url?.Scheme}://{Request.Url?.Authority}";
        var logoAbs = baseUrl + Url.Content("~/Content/Images/shafa-logo.png");
        var pageUrl = Request.Url?.AbsoluteUri ?? (baseUrl + Url.Content("~/"));
    }
    <meta property="og:url" content="@pageUrl" />
    <meta property="og:image" content="@logoAbs" />
    <meta property="og:site_name" content="کلینیک شفا جیرفت" />
    <meta property="og:locale" content="fa_IR" />
    
    <!-- Canonical URL for SEO -->
    <link rel="canonical" href="@pageUrl">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@(string.IsNullOrEmpty(ViewBag.Title) ? "کلینیک شفا جیرفت | بهترین خدمات درمانی" : ViewBag.Title)">
    <meta name="twitter:description" content="رزرو آنلاین نوبت و مشاوره با پزشکان متخصص کلینیک شفا در جیرفت.">
    <meta name="twitter:image" content="@logoAbs">
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "MedicalOrganization",
        "name": "کلینیک شفا جیرفت",
        "url": "@pageUrl",
        "logo": {
            "@@type": "ImageObject",
            "url": "@logoAbs",
            "width": 200,
            "height": 200
        },
        "telephone": "+983432221234",
        "email": "info@shafa-jiroft.com",
        "address": {
            "@@type": "PostalAddress",
            "streetAddress": "جیرفت، خیابان اصلی، کوچه شفا، پلاک 10",
            "addressLocality": "جیرفت",
            "addressRegion": "کرمان",
            "postalCode": "78511",
            "addressCountry": "IR"
        },
        "openingHours": [
            "Mo-Fr 08:00-20:00",
            "Sa 08:00-16:00"
        ],
        "medicalSpecialty": [
            "General Medicine",
            "Cardiology",
            "Dentistry",
            "Laboratory Services"
        ],
        "sameAs": [
            "https://www.instagram.com/shafa_jiroft",
            "https://www.telegram.me/shafa_jiroft"
        ],
        "hasOfferCatalog": {
            "@@type": "OfferCatalog",
            "name": "خدمات درمانی",
            "itemListElement": [
                {
                    "@@type": "Offer",
                    "itemOffered": {
                        "@@type": "MedicalProcedure",
                        "name": "معاینه عمومی"
                    }
                },
                {
                    "@@type": "Offer",
                    "itemOffered": {
                        "@@type": "MedicalProcedure",
                        "name": "آزمایشگاه"
                    }
                }
            ]
        }
    }
    </script>
