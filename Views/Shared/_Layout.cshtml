    <!-- Force Cache Clear for Medical Environment -->
    <script>
        // Force clear all caches
        if ('caches' in window) {
            caches.keys().then(function(names) {
                names.forEach(function(name) {
                    caches.delete(name);
                });
            });
        }
        
        // Force reload if cached (using modern API)
        const navEntry = performance.getEntriesByType('navigation')[0];
        if (navEntry && navEntry.type === 'back_forward') {
            window.location.reload();
        }
        
        // Global Error Handler - Consolidated
        window.addEventListener('error', function(event) {
            const errorInfo = {
                message: event.message,
                filename: event.filename,
                lineno: event.lineno,
                colno: event.colno,
                error: event.error ? event.error.stack : null,
                timestamp: new Date().toISOString(),
                userAgent: navigator.userAgent,
                url: window.location.href,
                userId: window.currentUserId || 'anonymous',
                sessionId: window.sessionId || 'unknown'
            };
            
            // Log to console
            console.error('JavaScript Error:', errorInfo);
            
            // Handle syntax errors
            if (event.error && event.error.message.includes('Unexpected token')) {
                console.warn('Syntax error detected, forcing page reload');
                setTimeout(function() {
                    window.location.reload();
                }, 1000);
                return;
            }
            
            // Handle startTime errors
            if (event.error && event.error.message.includes('startTime')) {
                errorCount++;
                if (errorCount >= maxErrors) {
                    console.warn('Too many startTime errors - forcing page refresh');
                    window.location.reload();
                }
                return;
            }
            
            // Prevent infinite loops for specific errors
            if (event.error && event.error.message.includes('startTime')) {
                console.warn('startTime error detected - preventing infinite loop');
                return;
            }
            
            // Log to server (with protection against infinite loops)
            if (window.ClinicLogger && !event.error?.message?.includes('timeout')) {
                window.ClinicLogger.error('JavaScript Error', errorInfo);
            }
            
            // Show user-friendly error for critical errors
            if (event.error && event.error.message.includes('startTime')) {
                if (typeof showNotification === 'function') {
                    showNotification('خطا در راه‌اندازی سیستم. لطفاً صفحه را بازخوانی کنید.', 'error');
                }
            }
        });
        
        // JavaScript Syntax Validation
        function validateJavaScriptSyntax(code) {
            try {
                new Function(code);
                return true;
            } catch (e) {
                console.error('JavaScript syntax error detected:', e.message);
                return false;
            }
        }
        
        // Global Syntax Error Prevention
        window.preventSyntaxErrors = function() {
            // Override console.error to catch syntax errors
            const originalError = console.error;
            console.error = function(...args) {
                if (args[0] && args[0].includes && args[0].includes('Unexpected token')) {
                    console.warn('Syntax error prevented, reloading page...');
                setTimeout(function() {
                    window.location.reload();
                }, 500);
                }
                originalError.apply(console, args);
            };
        };
        
        // Initialize syntax error prevention
        window.preventSyntaxErrors();
    </script>
    
    <!-- Production Optimized jQuery Loading -->
    <script>
        // Performance monitoring
        window.performanceMetrics = {
            startTime: performance.now(),
            jqueryLoadTime: null,
            domReadyTime: null,
            metrics: {}
        };
        
        // Enhanced jQuery Guard Function with timeout
        window.whenJQ = function(cb, timeout = 10000) {
            const startTime = performance.now();
            
            function checkJQuery() {
                if (typeof jQuery !== 'undefined' && typeof $ !== 'undefined') {
                    window.performanceMetrics.jqueryLoadTime = performance.now() - startTime;
                    console.log('✅ jQuery verified and ready in', window.performanceMetrics.jqueryLoadTime.toFixed(2), 'ms');
                    cb();
                } else if (performance.now() - startTime < timeout) {
                    setTimeout(checkJQuery, 50);
                } else {
                    console.error('❌ jQuery failed to load within timeout period');
                    if (window.ReceptionModules && window.ReceptionModules.errorHandler) {
                        window.ReceptionModules.errorHandler(new Error('jQuery load timeout'), 'jQueryLoad');
                    }
                }
            }
            
            checkJQuery();
        };
        
        // DOM Ready with performance tracking
        document.addEventListener('DOMContentLoaded', function() {
            window.performanceMetrics.domReadyTime = performance.now() - window.performanceMetrics.startTime;
            console.log('✅ DOM Ready in', window.performanceMetrics.domReadyTime.toFixed(2), 'ms');
        });
        
        // اطمینان از بارگذاری jQuery
        window.whenJQ(function() {
            window.jQueryReady = true;
            console.log('✅ jQuery is fully loaded and ready');
            
            // ✅ Initialize tooltips globally (با بررسی Popper.js)
            try {
                var hasPopper = false;
                try {
                    if (typeof window.Popper !== 'undefined' && typeof window.Popper.createPopper === 'function') {
                        hasPopper = true;
                    } else if (typeof Popper !== 'undefined' && typeof Popper.createPopper === 'function') {
                        hasPopper = true;
                    }
                } catch (e) {
                    hasPopper = false;
                }
                
                if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip && hasPopper) {
                    const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                    tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                        try {
                            new bootstrap.Tooltip(tooltipTriggerEl, { trigger: 'hover', html: true });
                        } catch (err) {
                            // اگر Popper خطا داد، از title استفاده کنیم
                            var $el = jQuery(tooltipTriggerEl);
                            var title = $el.data('bs-original-title') || $el.attr('title');
                            if (title) {
                                $el.attr('title', title);
                                $el.removeAttr('data-bs-toggle data-bs-html');
                            }
                        }
                    });
                } else if (!hasPopper && typeof bootstrap !== 'undefined') {
                    // Popper موجود نیست - از native tooltip استفاده کنیم
                    jQuery('[data-bs-toggle="tooltip"]').each(function() {
                        var $el = jQuery(this);
                        var title = $el.data('bs-original-title') || $el.attr('title');
                        if (title) {
                            $el.attr('title', title);
                            $el.removeAttr('data-bs-toggle data-bs-html data-bs-original-title');
                        }
                    });
                }
            } catch (err) {
                console.warn('🏥 V2: Error initializing tooltips in _Layout:', err);
            }
        });
        
        // Global error handling for production
        window.addEventListener('error', function(event) {
            console.error('❌ Global Error:', event.error);
            if (window.ReceptionModules && window.ReceptionModules.errorHandler) {
                window.ReceptionModules.errorHandler(event.error, 'GlobalError');
            }
        });
        
        // Unhandled promise rejection handling
        window.addEventListener('unhandledrejection', function(event) {
            console.error('❌ Unhandled Promise Rejection:', event.reason);
            if (window.ReceptionModules && window.ReceptionModules.errorHandler) {
                window.ReceptionModules.errorHandler(event.reason, 'UnhandledPromiseRejection');
            }
        });
    </script>
    
