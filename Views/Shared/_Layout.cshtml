    <!-- Stories Component JavaScript -->
    <script src="@Url.Content("~/Content/js/stories-component.js")?v=@System.Configuration.ConfigurationManager.AppSettings["AppVersion"]&t=@DateTime.Now.Ticks"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // --- 1. Initialize AOS (Animate on Scroll) for animations ---
            if (typeof AOS !== "undefined") {
                AOS.init({
                    duration: 700,
                    once: true,
                    offset: 100,
                });

                // Lazy AOS: فقط وقتی المان دیده شد اجرا شود
                const elements = document.querySelectorAll("[data-aos]");
                const observer = new IntersectionObserver((entries, obs) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("aos-animate");
                            obs.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1 });

                elements.forEach(el => observer.observe(el));
            }

            // --- 2. Navbar color change on scroll ---
            const navbar = document.querySelector('.main-navbar');
            if (navbar) {
                window.addEventListener('scroll', function() {
                    if (window.scrollY > 50) {
                        navbar.classList.add('scrolled');
                    } else {
                        navbar.classList.remove('scrolled');
                    }
                });
            }

            // --- 3. Professional Login Modal Manager ---
            (function() {
                const loginModal = document.getElementById('loginModal');
                const loginModalBackdrop = document.getElementById('loginModalBackdrop');
                const loginModalBody = document.getElementById('loginModalBody');
                const loginModalCloseBtn = document.getElementById('loginModalCloseBtn');
                const loginLink = document.getElementById('loginLink');
                
                if (!loginModal) return;
                
                // Load login content
                function loadLoginContent() {
                    loginModalBody.innerHTML = '<div class="d-flex justify-content-center p-5"><div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"><span class="visually-hidden">در حال بارگذاری...</span></div></div>';
                    
                    // ✅ دریافت returnUrl از data attribute
                    var returnUrl = loginModal.getAttribute('data-return-url') || window.location.href;
                    var loginModalUrl = '@Url.Action("LoginModal", "Account")' + (returnUrl ? '?returnUrl=' + encodeURIComponent(returnUrl) : '');
                    
                    fetch(loginModalUrl)
                        .then(response => response.text())
                        .then(html => {
                            loginModalBody.innerHTML = html;
                            // Execute any scripts in the loaded content
                            const scripts = loginModalBody.querySelectorAll('script');
                            scripts.forEach(oldScript => {
                                const newScript = document.createElement('script');
                                Array.from(oldScript.attributes).forEach(attr => {
                                    newScript.setAttribute(attr.name, attr.value);
                                });
                                newScript.textContent = oldScript.textContent || oldScript.innerHTML;
                                oldScript.parentNode.replaceChild(newScript, oldScript);
                            });
                            // Re-initialize jQuery handlers after scripts are executed
                            if (typeof jQuery !== 'undefined') {
                                $(document).ready(function() {
                                    // Trigger a custom event to re-initialize
                                    $(document).trigger('loginModalContentLoaded');
                                });
                            }
                        })
                        .catch(error => {
                            loginModalBody.innerHTML = '<div class="alert alert-danger m-3">خطا در بارگذاری فرم. لطفاً دوباره تلاش کنید.</div>';
                        });
                }
                
                // Open modal - ✅ Global function برای استفاده از صفحات دیگر
                window.openLoginModal = function(returnUrl) {
                    // ✅ ذخیره returnUrl در data attribute برای استفاده بعد از لاگین
                    if (returnUrl) {
                        loginModal.setAttribute('data-return-url', returnUrl);
                    }
                    loadLoginContent();
                    document.body.classList.add('login-modal-open');
                    loginModalBackdrop.classList.add('show');
                    loginModal.classList.add('show');
                    loginModal.setAttribute('aria-hidden', 'false');
                    // Focus first input after content loads
                    setTimeout(() => {
                        const nationalCodeInput = loginModalBody.querySelector('#NationalCode');
                        const firstOtpInput = loginModalBody.querySelector('#otp-inputs .otp-input:first-child');
                        const firstInput = nationalCodeInput || firstOtpInput;
                        if (firstInput) firstInput.focus();
                    }, 500);
                };
                
                // ✅ Alias برای backward compatibility
                function openModal() {
                    window.openLoginModal();
                }
                
                // Close modal
                function closeModal() {
                    loginModal.classList.remove('show');
                    loginModalBackdrop.classList.remove('show');
                    document.body.classList.remove('login-modal-open');
                    loginModal.setAttribute('aria-hidden', 'true');
                    // Reset form state
                    setTimeout(() => {
                        loginModalBody.innerHTML = '';
                    }, 300);
                }
                
                // Event: Click login link
                if (loginLink) {
                    loginLink.addEventListener('click', function(e) {
                        e.preventDefault();
                        openModal();
                    });
                }
                
                // Event: Close button
                if (loginModalCloseBtn) {
                    loginModalCloseBtn.addEventListener('click', closeModal);
                }
                
                // Event: Click backdrop - Professional handling
                if (loginModalBackdrop) {
                    loginModalBackdrop.addEventListener('click', function(e) {
                        // Only close if click is directly on backdrop (not on modal content)
                        if (e.target === loginModalBackdrop) {
                            closeModal();
                        }
                    });
                }
                
                // Event: Click outside modal content (on modal container)
                loginModal.addEventListener('click', function(e) {
                    // If click is on modal container itself (not on dialog/content), close modal
                    if (e.target === loginModal) {
                        closeModal();
                    }
                });
                
                // Prevent modal dialog/content clicks from closing modal
                const loginModalDialog = loginModal.querySelector('.login-modal-dialog');
                if (loginModalDialog) {
                    loginModalDialog.addEventListener('click', function(e) {
                        e.stopPropagation();
                    });
                }
                
                // Event: ESC key
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && loginModal.classList.contains('show')) {
                        closeModal();
                    }
                });
            })();

            // Function to handle the login form submission via AJAX
            function attachLoginFormHandler(form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const submitButton = form.querySelector('button[type="submit"]');
                    const spinner = submitButton.querySelector('.spinner-border');

                    submitButton.disabled = true;
                    if(spinner) spinner.classList.remove('d-none');

                    fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            toastr.success('ورود با موفقیت انجام شد!');
                            window.location.href = data.redirectUrl;
                        } else {
                            data.errors.forEach(error => toastr.error(error));
                        }
                    })
                    .catch(error => {
                        toastr.error('خطا در ارتباط با سرور.');
                    })
                    .finally(() => {
                        submitButton.disabled = false;
                        if(spinner) spinner.classList.add('d-none');
                    });
                });
            }

            // --- 4. Global Toastr configuration ---
            toastr.options = {
                "closeButton": true,              // نمایش دکمه بستن
                "debug": false,                   // غیر فعال کردن debug
                "newestOnTop": true,              // نمایش پیام جدید در بالای لیست
                "progressBar": true,              // نمایش نوار پیشرفت
                "positionClass": "toast-top-left",// موقعیت پیام (راست‌چین یا چپ‌چین)
                "preventDuplicates": true,        // جلوگیری از نمایش پیام تکراری
                "onclick": null,
                "showDuration": "300",            // زمان نمایش انیمیشن ورود
                "hideDuration": "1000",           // زمان نمایش انیمیشن خروج
                "timeOut": "5000",                // مدت زمان نمایش پیام
                "extendedTimeOut": "1000",        // مدت زمان اضافه در صورت hover
                "showEasing": "swing",
                "hideEasing": "linear",
                "showMethod": "fadeIn",           // افکت نمایش
                "hideMethod": "fadeOut",          // افکت مخفی شدن
                "rtl": true                        // فعال‌سازی راست‌چین برای فارسی
            };



            // --- 5. Display TempData messages from the server ---
            @if (TempData["SuccessMessage"] != null) {
                <text>toastr.success(@Html.Raw(Json.Encode(TempData["SuccessMessage"])), "موفقیت");</text>
            }
            @if (TempData["ErrorMessage"] != null) {
                <text>toastr.error(@Html.Raw(Json.Encode(TempData["ErrorMessage"])), "خطا");</text>
            }

        });
        
        // Standardized jQuery Guard Functions (using whenJQ)
        window.jQueryReady = window.whenJQ;
        window.ensureJQuery = window.whenJQ;
        
        // ✅ DEBUG: Authentication State Check (برای رفع مشکل نمایش آیکون پروفایل)
        $(document).ready(function() {
            // Check if authentication cookie exists
            var hasAuthCookie = document.cookie.indexOf('ClinicAppAuth=') !== -1;
            var hasUserMenu = $('#userProfileDropdown').length > 0;
            var hasLoginButton = $('.btn-login-modern').length > 0;
            
            // Log authentication state for debugging
            if (typeof window.ClinicLogger !== 'undefined') {
                window.ClinicLogger.log('Auth State Debug', {
                    hasAuthCookie: hasAuthCookie,
                    hasUserMenu: hasUserMenu,
                    hasLoginButton: hasLoginButton,
                    cookieExists: hasAuthCookie && !hasUserMenu
                });
            }
            
            // If cookie exists but UI shows login button, reload after short delay
            // This handles cases where sync hasn't completed yet
            if (hasAuthCookie && !hasUserMenu && hasLoginButton) {
                console.warn('⚠️ Authentication cookie exists but UI not synced - reloading in 500ms...');
                setTimeout(function() {
                    window.location.reload();
                }, 500);
            }
        });
    </script>
