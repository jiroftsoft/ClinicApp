@using Microsoft.AspNet.Identity
@using ClinicApp.Helpers
@using ClinicApp.Constants
@{
    // ✅ FIX: Multiple checks for authentication state
    var isAuthenticated = Request.IsAuthenticated;
    
    // ✅ FALLBACK: Check OWIN context if Request.IsAuthenticated is false
    // This ensures UI reflects authentication state even if sync hasn't happened yet
    if (!isAuthenticated && HttpContext.Current?.GetOwinContext() != null)
    {
        try
        {
            var owinContext = HttpContext.Current.GetOwinContext();
            var owinUser = owinContext.Authentication?.User;
            if (owinUser != null && owinUser.Identity.IsAuthenticated)
            {
                isAuthenticated = true;
                // Sync for this request to ensure consistency
                HttpContext.Current.User = owinUser;
            }
        }
        catch
        {
            // Silent fail - fallback to Request.IsAuthenticated
        }
    }
    
    var userName = isAuthenticated ? User.Identity.GetUserName() : string.Empty;
    var firstName = isAuthenticated ? User.Identity.GetFirstName() : string.Empty;
    var lastName = isAuthenticated ? User.Identity.GetLastName() : string.Empty;
    var fullName = !string.IsNullOrEmpty(firstName) && !string.IsNullOrEmpty(lastName) 
        ? $"{firstName} {lastName}" 
        : (!string.IsNullOrEmpty(firstName) ? firstName : userName);
    var userInitials = !string.IsNullOrEmpty(firstName) && !string.IsNullOrEmpty(lastName)
        ? $"{firstName[0]}{lastName[0]}"
        : (!string.IsNullOrEmpty(firstName) ? firstName[0].ToString() : (!string.IsNullOrEmpty(userName) ? userName[0].ToString() : "U"));
}

@if (isAuthenticated)
{
    @* ✅ Enterprise-Grade User Profile Menu - مثل مکتب خونه *@
    <div class="user-profile-menu">
        <div class="dropdown">
            <button class="user-profile-toggle" type="button" id="userProfileDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="منوی پروفایل کاربر">
                <div class="user-avatar">
                    <span class="user-initials">@userInitials</span>
                </div>
                <span class="user-name">@fullName</span>
                <i class="fas fa-chevron-down user-dropdown-icon"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end user-profile-dropdown" aria-labelledby="userProfileDropdown">
                @* Header Section *@
                <li class="dropdown-header user-profile-header">
                    <div class="user-info-header">
                        <div class="user-avatar-large">
                            <span class="user-initials-large">@userInitials</span>
                        </div>
                        <div class="user-details">
                            <div class="user-name-large">@fullName</div>
                            @if (!string.IsNullOrEmpty(userName))
                            {
                                <div class="user-email">@userName</div>
                            }
                        </div>
                    </div>
                </li>
                <li><hr class="dropdown-divider"></li>
                
                @* Menu Items - AJAX Navigation *@
                <li>
                    <a class="dropdown-item user-menu-item" href="@Url.Action("Profile", "Account")" data-ajax="true">
                        <i class="fas fa-user-circle"></i>
                        <span>پروفایل من</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item user-menu-item" href="@Url.Action("MyAppointments", "Appointment", new { area = "Patient" })" data-ajax="true">
                        <i class="fas fa-calendar-check"></i>
                        <span>نوبت‌های من</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item user-menu-item" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })" data-ajax="true">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>داشبورد</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item user-menu-item" href="@Url.Action("Index", "MedicalRecord", new { area = "Patient" })" data-ajax="true">
                        <i class="fas fa-file-medical"></i>
                        <span>پرونده الکترونیک</span>
                        <span class="badge badge-new">به زودی</span>
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                
                @* Settings & Logout *@
                <li>
                    <a class="dropdown-item user-menu-item" href="@Url.Action("Index", "Settings", new { area = "" })">
                        <i class="fas fa-cog"></i>
                        <span>تنظیمات</span>
                    </a>
                </li>
                <li>
                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item user-menu-item user-menu-logout" aria-label="خروج از حساب کاربری">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>خروج</span>
                        </button>
                    }
                </li>
            </ul>
        </div>
    </div>
}
else
{
    @* ✅ Guest User: Login Button - Modern & Professional *@
    <div class="user-profile-menu">
        <button type="button" class="btn-login-modern" onclick="window.openLoginModal && window.openLoginModal()" aria-label="ورود یا ثبت‌نام">
            <i class="fas fa-user"></i>
            <span>ورود / ثبت‌نام</span>
        </button>
    </div>
}
