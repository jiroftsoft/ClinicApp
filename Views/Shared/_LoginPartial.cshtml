@using Microsoft.AspNet.Identity
@using ClinicApp.Helpers
@using ClinicApp.Constants
@{
    // ✅ ENHANCED FIX: Check authentication state with multiple fallbacks
    // Priority: OWIN Context > Cookie Existence > Request.IsAuthenticated
    var isAuthenticated = false;
    var userName = string.Empty;
    var firstName = string.Empty;
    var lastName = string.Empty;
    
    try
    {
        // ✅ PRIORITY 1: Check OWIN context first (most reliable after login)
        var owinContext = HttpContext.Current?.GetOwinContext();
        if (owinContext != null)
        {
            var owinUser = owinContext.Authentication?.User;
            if (owinUser != null && owinUser.Identity.IsAuthenticated)
            {
                isAuthenticated = true;
                // ✅ Sync to HttpContext if not already synced
                if (!Request.IsAuthenticated || HttpContext.Current.User?.Identity?.Name != owinUser.Identity.Name)
                {
                    HttpContext.Current.User = owinUser;
                }
            }
        }
        
        // ✅ PRIORITY 2: Fallback to Request.IsAuthenticated
        if (!isAuthenticated && Request.IsAuthenticated)
        {
            isAuthenticated = true;
        }
        
        // ✅ PRIORITY 3: Check cookie existence as last resort
        if (!isAuthenticated && Request.Cookies["ClinicAppAuth"] != null)
        {
            // Cookie exists but not validated yet - this can happen immediately after redirect
            // Force a check on OWIN one more time
            if (owinContext != null)
            {
                var owinUser = owinContext.Authentication?.User;
                if (owinUser != null && owinUser.Identity.IsAuthenticated)
                {
                    isAuthenticated = true;
                    HttpContext.Current.User = owinUser;
                }
            }
        }
    }
    catch
    {
        // Silent fail - fallback to Request.IsAuthenticated
        isAuthenticated = Request.IsAuthenticated;
    }
    
    // ✅ Extract user information only if authenticated
    if (isAuthenticated)
    {
        userName = User.Identity.GetUserName() ?? string.Empty;
        firstName = User.Identity.GetFirstName() ?? string.Empty;
        lastName = User.Identity.GetLastName() ?? string.Empty;
    }
    
    var fullName = !string.IsNullOrEmpty(firstName) && !string.IsNullOrEmpty(lastName) 
        ? $"{firstName} {lastName}" 
        : (!string.IsNullOrEmpty(firstName) ? firstName : userName);
    var userInitials = !string.IsNullOrEmpty(firstName) && !string.IsNullOrEmpty(lastName)
        ? $"{firstName[0]}{lastName[0]}"
        : (!string.IsNullOrEmpty(firstName) ? firstName[0].ToString() : (!string.IsNullOrEmpty(userName) ? userName[0].ToString() : "U"));
}

@if (isAuthenticated)
{
    @* ✅ Enterprise-Grade User Profile Menu - مثل مکتب خونه *@
    <div class="user-profile-menu">
        <div class="dropdown">
            <button class="user-profile-toggle" type="button" id="userProfileDropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="منوی پروفایل کاربر">
                <div class="user-avatar">
                    <span class="user-initials">@userInitials</span>
                </div>
                <span class="user-name">@fullName</span>
                <i class="fas fa-chevron-down user-dropdown-icon"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end user-profile-dropdown" aria-labelledby="userProfileDropdown">
                @* Header Section *@
                <li class="dropdown-header user-profile-header">
                    <div class="user-info-header">
                        <div class="user-avatar-large">
                            <span class="user-initials-large">@userInitials</span>
                        </div>
                        <div class="user-details">
                            <div class="user-name-large">@fullName</div>
                            @if (!string.IsNullOrEmpty(userName))
                            {
                                <div class="user-email">@userName</div>
                            }
                        </div>
                    </div>
                </li>
                <li><hr class="dropdown-divider"></li>
                
                @* Menu Items - Full Page Navigation for Patient Area *@
                @* ✅ BEST PRACTICE: لینک به داشبورد و صفحات مربوطه *@
                <li>
                    <a class="dropdown-item user-menu-item" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })#overview" data-ajax="false">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>داشبورد</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item user-menu-item" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })#profile" data-ajax="false">
                        <i class="fas fa-user-circle"></i>
                        <span>پروفایل من</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item user-menu-item" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })#appointments" data-ajax="false">
                        <i class="fas fa-calendar-check"></i>
                        <span>نوبت‌های من</span>
                    </a>
                </li>
                <li>
                    <a class="dropdown-item user-menu-item" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })#medical-record" data-ajax="false">
                        <i class="fas fa-file-medical"></i>
                        <span>پرونده الکترونیک</span>
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                
                @* Settings & Logout *@
                <li>
                    <a class="dropdown-item user-menu-item" href="@Url.Action("Index", "Dashboard", new { area = "Patient" })#settings" data-ajax="false">
                        <i class="fas fa-cog"></i>
                        <span>تنظیمات</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("LogOff", "Account")" 
                       class="dropdown-item user-menu-item user-menu-logout-link"
                       onclick="event.preventDefault(); event.stopPropagation(); var f=document.createElement('form'); f.method='POST'; f.action=this.href; var t=document.createElement('input'); t.type='hidden'; t.name='__RequestVerificationToken'; t.value=document.querySelector('input[name=__RequestVerificationToken]').value; f.appendChild(t); document.body.appendChild(f); f.submit(); return false;"
                       aria-label="خروج از حساب کاربری">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>خروج</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
}
else
{
    @* ✅ Guest User: Login Button - Modern & Professional *@
    <div class="user-profile-menu">
        <button type="button" class="btn-login-modern" onclick="window.openLoginModal && window.openLoginModal()" aria-label="ورود یا ثبت‌نام">
            <i class="fas fa-user"></i>
            <span>ورود / ثبت‌نام</span>
        </button>
    </div>
}
