@model ClinicApp.ViewModels.CMS.PublicNewsletterSubscriptionViewModel

@* ============================================
   Newsletter Subscribe Partial - Production Ready
   ============================================
   - SRP: فرم اشتراک خبرنامه برای استفاده در Footer یا Home
   - UI/UX: طراحی کاربرپسند و حرفه‌ای
   - RTL Support: پشتیبانی کامل از راست‌به‌چپ
   ============================================ *@

<div class="newsletter-subscribe-widget">
    <h5 class="mb-3">
        <i class="fas fa-envelope"></i> اشتراک در خبرنامه
    </h5>
    <p class="text-muted small mb-3">
        با اشتراک در خبرنامه، از آخرین اخبار و رویدادهای کلینیک مطلع شوید.
    </p>

    @using (Html.BeginForm("Subscribe", "Newsletter", FormMethod.Post, new { @class = "newsletter-form", id = "newsletterSubscribeForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger small" })

        <div class="form-group mb-2">
            @Html.TextBoxFor(m => m.Email, new { 
                @class = "form-control", 
                placeholder = "آدرس ایمیل شما",
                type = "email",
                dir = "ltr",
                required = "required"
            })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
        </div>

        <div class="form-group mb-2">
            @Html.TextBoxFor(m => m.FullName, new { 
                @class = "form-control", 
                placeholder = "نام و نام خانوادگی (اختیاری)"
            })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
        </div>

        <button type="submit" class="btn btn-primary btn-block" id="newsletterSubscribeBtn">
            <i class="fas fa-paper-plane"></i> اشتراک
        </button>

        <small class="text-muted d-block mt-2 text-center">
            <i class="fas fa-shield-alt"></i> اطلاعات شما محفوظ است
        </small>
    }
</div>

@section Styles {
    <style>
        .newsletter-subscribe-widget {
            background: rgba(255, 255, 255, 0.1);
            padding: var(--spacing-lg, 1.5rem);
            border-radius: var(--radius-md, 8px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
        }
        .newsletter-subscribe-widget h5 {
            color: #ffffff;
            font-weight: var(--font-weight-semibold, 600);
            margin-bottom: var(--spacing-md, 1rem);
            display: flex;
            align-items: center;
            gap: var(--spacing-sm, 0.5rem);
        }
        .newsletter-subscribe-widget h5 i {
            color: var(--medical-success, #28a745);
        }
        .newsletter-subscribe-widget p {
            color: rgba(255, 255, 255, 0.85);
            font-size: var(--font-size-sm, 0.875rem);
            line-height: var(--line-height-normal, 1.5);
            margin-bottom: var(--spacing-md, 1rem);
        }
        .newsletter-form .form-control {
            border-radius: var(--radius-sm, 5px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.95);
            color: var(--medical-text, #212529);
            transition: all var(--transition-normal, 0.3s) ease;
        }
        .newsletter-form .form-control:focus {
            border-color: var(--medical-success, #28a745);
            box-shadow: 0 0 0 0.2rem rgba(40, 167, 69, 0.25);
            background: #ffffff;
        }
        .newsletter-form .form-control::placeholder {
            color: var(--medical-text-muted, #6c757d);
        }
        .newsletter-form .btn {
            border-radius: var(--radius-sm, 5px);
            font-weight: var(--font-weight-medium, 500);
            background: var(--medical-success, #28a745);
            border-color: var(--medical-success, #28a745);
            transition: all var(--transition-normal, 0.3s) ease;
        }
        .newsletter-form .btn:hover {
            background: var(--medical-success-dark, #1e7e34);
            border-color: var(--medical-success-dark, #1e7e34);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(40, 167, 69, 0.3);
        }
        .newsletter-subscribe-widget small {
            color: rgba(255, 255, 255, 0.7);
            font-size: var(--font-size-xs, 0.75rem);
        }
        .newsletter-subscribe-widget small i {
            color: var(--medical-success, #28a745);
        }
    </style>
}

@section Scripts {
    <script>
        // Vanilla JavaScript - بدون وابستگی به jQuery
        (function() {
            'use strict';
            
            function initNewsletterForm() {
                const form = document.getElementById('newsletterSubscribeForm');
                if (!form) return;
                
                const btn = document.getElementById('newsletterSubscribeBtn');
                if (!btn) return;
                
                form.addEventListener('submit', function(e) {
                    // Disable button and show loading
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> در حال ارسال...';
                    
                    // Form will submit normally, button will be re-enabled on page reload
                    // If there's an error, the page will reload and button will be enabled again
                });
            }
            
            // Initialize when DOM is ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initNewsletterForm);
            } else {
                initNewsletterForm();
            }
        })();
    </script>
}

