@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = "خطا";
    var message = ViewBag.ErrorMessage as string;
}

<h1 class="text-danger">خطا</h1>
<h2 class="text-danger">در پردازش درخواست شما خطایی رخ داده است.</h2>
@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="alert alert-warning mt-3" role="alert">@message</p>
}
