<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - کلینیک شفا</title>
    
    @* ✅ فرمت مناسب برای فیش پرینتر 58mm *@
    <style>
        /* Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        html, body {
            width: 58mm;
            max-width: 58mm;
            margin: 0;
            padding: 0;
            font-family: 'Courier New', monospace;
            font-size: 12px;
            background: white;
        }
        
        @* Print Styles *@
        @@media print {
            @@page {
                size: 58mm auto;
                margin: 0;
            }
            
            body {
                width: 58mm;
                max-width: 58mm;
                padding: 0;
            }
            
            /* حذف دکمه‌ها و عناصر غیرضروری */
            button, .no-print, nav, header, footer {
                display: none !important;
            }
        }
    </style>
    
    @RenderSection("styles", required: false)
</head>
<body>
    @RenderBody()
    
    @RenderSection("scripts", required: false)
</body>
</html>

