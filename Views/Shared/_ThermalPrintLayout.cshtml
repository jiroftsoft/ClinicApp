<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - کلینیک شفا</title>
    
    @* ✅ لود فونت‌های محلی فارسی (Vazir, Shabnam, Yekan) *@
    <link href="~/Content/css/local-fonts.css" rel="stylesheet" />
    
    @* ✅ فرمت مناسب برای فیش پرینتر (58mm/80mm) - Dynamic *@
    @{
        var printerType = ViewBag.PrinterType as string ?? "thermal";
        var printerWidth = printerType == "thermal" ? "80mm" : "58mm";
        var is80mm = printerWidth == "80mm";
    }
    <style>
        /* Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        html, body {
            width: @printerWidth;
            max-width: @printerWidth;
            margin: 0;
            padding: @(is80mm ? "1mm 0.5mm" : "0.5mm 0");
            @* ✅ استفاده از فونت فارسی Vazir برای قبض چاپ *@
            font-family: 'Vazir', 'Shabnam', 'Yekan', 'Tahoma', 'Arial', sans-serif;
            @if (is80mm)
            {
                <text>font-size: 12px;</text>
            }
            else
            {
                <text>font-size: 10px;</text>
            }
            line-height: 1.2;
            background: white;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        
        @* Print Styles *@
        @@media print {
            @@page {
                size: @printerWidth auto;
                margin: 0;
            }
            
            body {
                width: @printerWidth;
                max-width: @printerWidth;
                padding: @(is80mm ? "1mm 0.5mm" : "0.5mm 0");
                margin: 0;
            }
            
            /* حذف دکمه‌ها و عناصر غیرضروری */
            button, .no-print, nav, header, footer {
                display: none !important;
            }
        }
    </style>
    
    @RenderSection("styles", required: false)
</head>
<body>
    @RenderBody()
    
    @RenderSection("scripts", required: false)
</body>
</html>

