@using System.Collections.Generic
@using ClinicApp.ViewModels.Shared
@{
    ViewBag.Title = "مدیریت دستگاه‌های پوز";
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";
    
    // تنظیم Breadcrumb Navigation (مسیر سلسله مراتبی)
    ViewBag.Breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "پذیرش", Url = Url.Action("Index", "ReceptionV2"), Icon = "fas fa-user-plus", Tooltip = "بازگشت به صفحه اصلی پذیرش" },
        new BreadcrumbItem { Title = "مدیریت POS", Icon = "fas fa-credit-card", IsActive = true }
    };
}
<!-- ✅ POS Management Page - Single Instance -->
<div class="container-fluid" dir="rtl" id="pos-management-page">
  @Html.AntiForgeryToken()
  
  <!-- ✅ Header Section - Single Instance -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="m-0">مدیریت دستگاه‌های پوز</h5>
    <div class="d-flex gap-2">
      <a class="btn btn-primary" href="@Url.Action("CreateTerminal","PosManagement")">
        <i class="fas fa-plus me-2"></i>ایجاد ترمینال
      </a>
      <a class="btn btn-success" href="@Url.Action("Index","PosTest")" title="تست اتصال و عملکرد دستگاه‌های POS">
        <i class="fas fa-vial me-2"></i>تست POS
      </a>
      <button id="btnRefresh" class="btn btn-outline-secondary">
        <i class="fas fa-sync-alt me-2"></i>بروزرسانی
      </button>
      <a class="btn btn-outline-secondary" href="/ReceptionV2/Index">
        <i class="fas fa-arrow-right me-2"></i>بازگشت به پذیرش
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-striped table-hover m-0" id="pos-table">
          <thead class="table-light">
            <tr>
              <th>عنوان</th>
              <th>شماره ترمینال</th>
              <th>شماره پذیرنده</th>
              <th>Provider</th>
              <th>Protocol</th>
              <th>IP Address</th>
              <th>Port</th>
              <th>Active</th>
              <th>Default</th>
              <th style="width:320px">اقدامات</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td colspan="10" class="text-center text-muted py-4">
                <i class="fas fa-spinner fa-spin me-2"></i>در حال بارگذاری...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Network/Protocol Modal -->
<div class="modal fade" id="netModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">تنظیمات شبکه/پروتکل</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="net-id" />
        <div class="mb-3">
          <label class="form-label">آدرس IP</label>
          <input class="form-control" id="net-ip" placeholder="192.168.1.10" />
        </div>
        <div class="mb-3">
          <label class="form-label">پورت (اختیاری)</label>
          <input type="number" class="form-control" id="net-port" placeholder="5000 (پیش‌فرض)" min="1" max="65535" />
          <small class="form-text text-muted">
            <i class="fas fa-info-circle me-1"></i>
            اگر تنظیم نشود، از پورت پیش‌فرض 5000 استفاده می‌شود
          </small>
        </div>
        <div class="mb-3">
          <label class="form-label">MAC Address (اختیاری)</label>
          <input class="form-control" id="net-mac" placeholder="AA:BB:CC:DD:EE:FF" />
        </div>
        <div class="mb-3">
          <label class="form-label">Protocol</label>
          <select class="form-select" id="net-protocol">
            <option value="Tcp">TCP/IP</option>
            <option value="Serial">Serial</option>
            <option value="Api">API</option>
          </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
        <button type="button" class="btn btn-primary" id="net-save">ذخیره</button>
      </div>
    </div>
  </div>
</div>

<script>
// ✅ POS Management Module - Prevent Duplicate Execution
(function(){
  'use strict';
  
  // ✅ Prevent duplicate execution
  if (window.posManagementInitialized) {
    console.warn('⚠️ POS Management already initialized, skipping...');
    return;
  }
  window.posManagementInitialized = true;
  
  console.log('🏥 POS Management: Initializing module...');
  
  function getAntiForgeryToken() {
    var token = document.querySelector('input[name="__RequestVerificationToken"]');
    if (!token || !token.value) {
      console.warn('⚠️ POS: Anti-forgery token not found in form');
      // تلاش برای خواندن از meta tag
      var metaToken = document.querySelector('meta[name="__RequestVerificationToken"]');
      if (metaToken) {
        return metaToken.getAttribute('content') || '';
      }
    }
    return token ? token.value : '';
  }
  
  function formatIRR(amount) {
    if (!amount && amount !== 0) return '—';
    return Number(amount).toLocaleString('fa-IR') + ' ریال';
  }
  
  function loadTerminals() {
    var url = '/api/v1/pos/terminals'; // استفاده از API endpoint
    var tbody = document.querySelector('#pos-table tbody');
    
    if (!tbody) {
      console.error('❌ POS: Table body not found!');
      return;
    }
    
    // نمایش loading
    tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted py-4"><i class="fas fa-spinner fa-spin me-2"></i>در حال بارگذاری...</td></tr>';
    
    fetch(url, { 
      method: 'GET',
      credentials: 'same-origin',
      headers: {
        'Accept': 'application/json'
      }
    })
      .then(function(response) {
        if (!response.ok) {
          throw new Error('HTTP ' + response.status);
        }
        return response.json();
      })
      .then(function(res) {
        // ✅ سازگاری با ساختار ServiceResult
        var ok = (res && (res.Success === true || res.success === true));
        
        if (!ok) {
          console.error('🏥 POS: GetTerminals failed:', res);
          var errorMsg = res?.Message || res?.message || 'خطای نامشخص';
          tbody.innerHTML = '<tr><td colspan="10" class="text-center text-danger py-4">خطا در بارگذاری داده‌ها: ' + errorMsg + '</td></tr>';
          return;
        }
        
        // ✅ استخراج داده‌ها از ساختار ServiceResult
        var data = (res.Data && res.Data.items) || 
                   (res.data && res.data.items) ||
                   (res.items) ||
                   [];
        
        tbody.innerHTML = '';
        
        if (!data || data.length === 0) {
          tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted py-4">هیچ ترمینالی یافت نشد. <a href="@Url.Action("CreateTerminal","PosManagement")">ایجاد ترمینال جدید</a></td></tr>';
          return;
        }
        
        data.forEach(function(t) {
          var tr = document.createElement('tr');
          
          // تبدیل Protocol enum به string
          var protocolStr = 'Tcp'; // default
          if (t.Protocol !== undefined && t.Protocol !== null) {
            if (typeof t.Protocol === 'number') {
              // اگر عدد است، به string تبدیل کن
              protocolStr = t.Protocol === 1 ? 'Tcp' : (t.Protocol === 2 ? 'Serial' : (t.Protocol === 3 ? 'Api' : 'Tcp'));
            } else if (typeof t.Protocol === 'string') {
              protocolStr = t.Protocol;
            }
          }
          
          // تبدیل Provider enum به string
          var providerStr = t.ProviderType || t.Provider || '—';
          if (typeof providerStr === 'number') {
            providerStr = providerStr.toString();
          }
          
          tr.innerHTML = 
            '<td><strong>' + (t.Name || t.Title || '—') + '</strong></td>' +
            '<td>' + (t.TerminalId || '—') + '</td>' +
            '<td>' + (t.MerchantId || '—') + '</td>' +
            '<td><span class="badge bg-info">' + providerStr + '</span></td>' +
            '<td><span class="badge bg-secondary">' + protocolStr + '</span></td>' +
            '<td>' + (t.IpAddress || '—') + '</td>' +
            '<td>' + (t.Port || '—') + '</td>' +
            '<td>' + (t.IsActive ? '<span class="badge bg-success">فعال</span>' : '<span class="badge bg-danger">غیرفعال</span>') + '</td>' +
            '<td>' + (t.IsDefault ? '<span class="badge bg-primary">پیش‌فرض</span>' : '—') + '</td>' +
            '<td class="d-flex gap-1 flex-wrap">' +
              '<a class="btn btn-sm btn-outline-primary" href="@Url.Action("TerminalDetails","PosManagement")?id=' + t.Id + '" title="جزئیات">' +
                '<i class="fas fa-info-circle"></i>' +
              '</a>' +
              '<a class="btn btn-sm btn-outline-secondary" href="@Url.Action("EditTerminal","PosManagement")?id=' + t.Id + '" title="ویرایش">' +
                '<i class="fas fa-edit"></i>' +
              '</a>' +
              '<button data-id="' + t.Id + '" data-active="' + (!t.IsActive) + '" class="btn btn-sm btn-outline-warning btn-toggle-active" title="' + (t.IsActive ? 'غیرفعال کردن' : 'فعال کردن') + '">' +
                '<i class="fas fa-' + (t.IsActive ? 'ban' : 'check') + '"></i> ' + (t.IsActive ? 'غیرفعال' : 'فعال') +
              '</button>' +
              '<button data-id="' + t.Id + '" class="btn btn-sm btn-outline-success btn-set-default" title="تنظیم به عنوان پیش‌فرض"' + (t.IsDefault ? ' disabled' : '') + '>' +
                '<i class="fas fa-star"></i> پیش‌فرض' +
              '</button>' +
              '<button data-id="' + t.Id + '" data-ip="' + (t.IpAddress || '') + '" data-port="' + (t.Port || '') + '" data-mac="' + (t.MacAddress || '') + '" data-protocol="' + protocolStr + '" class="btn btn-sm btn-outline-dark btn-network" title="تنظیمات شبکه">' +
                '<i class="fas fa-network-wired"></i>' +
              '</button>' +
              (t.IsDefault ? '' : '<button data-id="' + t.Id + '" class="btn btn-sm btn-outline-danger btn-delete" title="حذف">' +
                '<i class="fas fa-trash"></i>' +
              '</button>') +
            '</td>';
          tbody.appendChild(tr);
        });
        
        console.log('✅ POS: Terminals loaded successfully:', data.length);
      })
      .catch(function(e) {
        console.error('❌ POS: Error loading terminals:', e);
        tbody.innerHTML = '<tr><td colspan="10" class="text-center text-danger py-4">خطا در ارتباط با سرور. لطفاً صفحه را Refresh کنید.</td></tr>';
      });
  }
  
  // ✅ Event Listeners - Prevent Duplicate Binding
  var btnRefresh = document.getElementById('btnRefresh');
  if (btnRefresh) {
    btnRefresh.addEventListener('click', function() {
      console.log('🏥 POS: Refresh button clicked');
      loadTerminals();
    });
  } else {
    console.error('❌ POS: Refresh button not found!');
  }
  
  // ✅ Initialize on DOM Ready - Single Execution
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      console.log('🏥 POS: DOM Ready - Loading terminals...');
      loadTerminals();
    });
  } else {
    // DOM already loaded
    console.log('🏥 POS: DOM Already Ready - Loading terminals...');
    loadTerminals();
  }
  
  // Toggle Active Status
  document.addEventListener('click', function(ev) {
    var btn = ev.target.closest('.btn-toggle-active');
    if (!btn) return;
    
    var id = parseInt(btn.getAttribute('data-id'), 10);
    var toActive = btn.getAttribute('data-active') === 'true';
    
    if (!confirm('آیا از ' + (toActive ? 'فعال' : 'غیرفعال') + ' کردن این ترمینال مطمئن هستید؟')) {
      return;
    }
    
    btn.disabled = true;
    fetch('/api/v1/pos/terminals/' + id + '/active?isActive=' + toActive, {
      method: 'POST',
      headers: {
        'RequestVerificationToken': getAntiForgeryToken()
      },
      credentials: 'same-origin'
    })
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function(res) {
        if (!(res && (res.Success || res.success))) {
          throw new Error(res?.Message || res?.message || 'خطا در تغییر وضعیت');
        }
        toastr.success('وضعیت ترمینال با موفقیت تغییر کرد');
        loadTerminals();
      })
      .catch(function(e) {
        console.error('❌ POS: Toggle active error:', e);
        toastr.error('خطا در تغییر وضعیت ترمینال');
        btn.disabled = false;
      });
  });
  
  // Set Default Terminal
  document.addEventListener('click', function(ev) {
    var btn = ev.target.closest('.btn-set-default');
    if (!btn) return;
    
    var id = parseInt(btn.getAttribute('data-id'), 10);
    
    if (!confirm('آیا می‌خواهید این ترمینال را به عنوان پیش‌فرض تنظیم کنید؟')) {
      return;
    }
    
    btn.disabled = true;
    fetch('/api/v1/pos/terminals/' + id + '/default', {
      method: 'POST',
      headers: {
        'RequestVerificationToken': getAntiForgeryToken()
      },
      credentials: 'same-origin'
    })
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function(res) {
        if (!(res && (res.Success || res.success))) {
          throw new Error(res?.Message || res?.message || 'خطا در تنظیم پیش‌فرض');
        }
        toastr.success('ترمینال با موفقیت به عنوان پیش‌فرض تنظیم شد');
        loadTerminals();
      })
      .catch(function(e) {
        console.error('❌ POS: Set default error:', e);
        toastr.error('خطا در تنظیم ترمینال پیش‌فرض');
        btn.disabled = false;
      });
  });
  
  // Open Network/Protocol Modal
  document.addEventListener('click', function(ev) {
    var btn = ev.target.closest('.btn-network');
    if (!btn) return;
    
    var id = btn.getAttribute('data-id');
    var ip = btn.getAttribute('data-ip') || '';
    var port = btn.getAttribute('data-port') || '';
    var mac = btn.getAttribute('data-mac') || '';
    var protocol = btn.getAttribute('data-protocol') || 'Tcp';
    
    console.log('🏥 POS: Opening network modal. ID:', id, 'Protocol:', protocol, 'IP:', ip, 'Port:', port, 'MAC:', mac);
    
    document.getElementById('net-id').value = id;
    document.getElementById('net-ip').value = ip;
    document.getElementById('net-port').value = port || '';
    document.getElementById('net-mac').value = mac;
    
    // تنظیم Protocol با fallback
    var protocolSelect = document.getElementById('net-protocol');
    if (protocolSelect) {
      protocolSelect.value = protocol || 'Tcp';
      console.log('🏥 POS: Protocol set to:', protocolSelect.value);
    } else {
      console.error('❌ POS: Protocol select element not found!');
    }
    
    var modalElement = document.getElementById('netModal');
    if (modalElement && typeof bootstrap !== 'undefined') {
      var modal = new bootstrap.Modal(modalElement);
      modal.show();
    } else {
      alert('Modal library not loaded');
    }
  });
  
  // Save Network/Protocol Settings
  document.addEventListener('click', function(ev) {
    var saveBtn = ev.target.closest('#net-save');
    if (!saveBtn) return;
    
    var id = parseInt(document.getElementById('net-id').value, 10);
    var ip = document.getElementById('net-ip').value.trim();
    var portInput = document.getElementById('net-port').value.trim();
    var port = portInput ? parseInt(portInput, 10) : null;
    var mac = document.getElementById('net-mac').value.trim() || null;
    var protocolSelect = document.getElementById('net-protocol');
    var protocol = protocolSelect ? protocolSelect.value : 'Tcp';
    
    console.log('🏥 POS: Saving network settings. ID:', id, 'Protocol:', protocol, 'IP:', ip, 'Port:', port, 'MAC:', mac);
    
    if (!id || id <= 0) {
      toastr.error('شناسه ترمینال نامعتبر است');
      return;
    }
    
    if (!ip) {
      toastr.warning('لطفاً آدرس IP را وارد کنید');
      return;
    }
    
    // Port validation: اگر port وارد شده اما نامعتبر است
    if (portInput && (isNaN(port) || port < 1 || port > 65535)) {
      toastr.warning('پورت باید بین 1 تا 65535 باشد یا خالی بگذارید');
      return;
    }
    
    // اعتبارسنجی Protocol
    var validProtocols = ['Tcp', 'Serial', 'Api'];
    if (!validProtocols.includes(protocol)) {
      console.warn('⚠️ POS: Invalid protocol:', protocol, 'Using default: Tcp');
      protocol = 'Tcp';
    }
    
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>در حال ذخیره...';
    
    // دریافت اطلاعات کامل ترمینال برای به‌روزرسانی
    fetch('/api/v1/pos/terminals/' + id, {
      method: 'GET',
      credentials: 'same-origin',
      headers: {
        'Accept': 'application/json'
      }
    })
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function(res) {
        if (!(res && res.Success && res.Data)) {
          throw new Error(res?.Message || res?.message || 'خطا در دریافت اطلاعات ترمینال');
        }
        
        var terminal = res.Data;
        
        // تبدیل Protocol string به enum number
        var protocolEnum = 1; // Tcp = 1
        if (protocol === 'Serial') {
          protocolEnum = 2;
        } else if (protocol === 'Api') {
          protocolEnum = 3;
        }
        
        // تبدیل Provider string به enum number (اگر لازم باشد)
        var providerEnum = terminal.provider || terminal.Provider;
        if (typeof providerEnum === 'string') {
          // اگر string است، باید به enum تبدیل شود - فعلاً همان را نگه می‌داریم
          providerEnum = terminal.provider || terminal.Provider;
        }
        
        var updateData = {
          Id: id,
          Title: terminal.title || terminal.Title || terminal.name || terminal.Name,
          Name: terminal.title || terminal.Title || terminal.name || terminal.Name,
          TerminalId: terminal.terminalId || terminal.TerminalId,
          MerchantId: terminal.merchantId || terminal.MerchantId,
          SerialNumber: terminal.serialNumber || terminal.SerialNumber,
          Provider: providerEnum,
          ProviderType: providerEnum,
          Protocol: protocolEnum, // ارسال به صورت عدد enum
          IpAddress: ip,
          Port: port, // می‌تواند null باشد
          MacAddress: mac || null,
          ConnectionString: null, // ConnectionString را null می‌کنیم تا از Port استفاده شود
          IsActive: terminal.isActive !== undefined ? terminal.isActive : terminal.IsActive,
          IsDefault: terminal.isDefault !== undefined ? terminal.isDefault : terminal.IsDefault
        };
        
        console.log('🏥 POS: Sending update request:', updateData);
        
        var token = getAntiForgeryToken();
        if (!token) {
          console.error('❌ POS: Anti-forgery token not found!');
          toastr.error('توکن امنیتی یافت نشد. لطفاً صفحه را Refresh کنید.');
          saveBtn.disabled = false;
          saveBtn.innerHTML = 'ذخیره';
          return;
        }
        
        console.log('🏥 POS: Anti-forgery token found:', token.substring(0, 20) + '...');
        
        return fetch('/api/v1/pos/terminals/' + id, {
          method: 'PUT',
          headers: {
            'RequestVerificationToken': token,
            'Content-Type': 'application/json; charset=utf-8'
          },
          credentials: 'same-origin', // مهم: برای ارسال cookie token
          body: JSON.stringify(updateData)
        });
      })
      .then(function(r) {
        if (!r.ok) {
          return r.text().then(function(text) {
            console.error('❌ POS: Update failed. Status:', r.status, 'Response:', text);
            throw new Error('HTTP ' + r.status + ': ' + text);
          });
        }
        return r.json();
      })
      .then(function(res) {
        if (!(res && (res.Success || res.success))) {
          throw new Error(res?.Message || res?.message || 'خطا در بروزرسانی تنظیمات');
        }
        
        var modalElement = document.getElementById('netModal');
        if (modalElement && typeof bootstrap !== 'undefined') {
          var modalInstance = bootstrap.Modal.getInstance(modalElement);
          if (modalInstance) {
            modalInstance.hide();
          }
        }
        
        toastr.success('تنظیمات شبکه/پروتکل با موفقیت به‌روزرسانی شد');
        loadTerminals();
      })
      .catch(function(e) {
        console.error('❌ POS: Update network error:', e);
        toastr.error('خطا در بروزرسانی تنظیمات: ' + (e.message || 'خطای نامشخص'));
      })
      .finally(function() {
        saveBtn.disabled = false;
        saveBtn.innerHTML = 'ذخیره';
      });
  });
  
  // Delete Terminal
  document.addEventListener('click', function(ev) {
    var btn = ev.target.closest('.btn-delete');
    if (!btn) return;
    
    var id = parseInt(btn.getAttribute('data-id'), 10);
    
    if (!confirm('آیا از حذف این ترمینال مطمئن هستید؟\nاین عمل قابل بازگشت نیست.')) {
      return;
    }
    
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    
    var formData = new FormData();
    formData.append('id', id);
    formData.append('__RequestVerificationToken', getAntiForgeryToken());
    
    fetch('@Url.Action("DeleteTerminal", "PosManagement")', {
      method: 'POST',
      body: formData,
      credentials: 'same-origin',
      headers: {
        'RequestVerificationToken': getAntiForgeryToken()
      }
    })
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function(res) {
        if (!(res && (res.success || res.Success))) {
          throw new Error(res?.message || res?.Message || 'خطا در حذف ترمینال');
        }
        toastr.success('ترمینال با موفقیت حذف شد');
        loadTerminals();
      })
      .catch(function(e) {
        console.error('❌ POS: Delete terminal error:', e);
        toastr.error('خطا در حذف ترمینال: ' + e.message);
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-trash"></i>';
      });
  });
  
})();
</script>
