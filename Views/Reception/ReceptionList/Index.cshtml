@model ClinicApp.ViewModels.Reception.ReceptionListViewModel
@{
    ViewBag.Title = "لیست پذیرش‌ها (مراجعات قبلی)";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* Anti-Forgery Token for AJAX *@
@using (Html.BeginForm("GetReceptionList", "ReceptionList", FormMethod.Post, new { id = "receptionList_af_form", style = "display:none" }))
{
    @Html.AntiForgeryToken()
}

<div class="container-fluid" dir="rtl">
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="m-0"><i class="fas fa-list me-2"></i>لیست پذیرش‌ها (مراجعات قبلی)</h5>
            <a href="@Url.Action("Index", "ReceptionV2")" class="btn btn-light btn-sm">
                <i class="fas fa-plus me-1"></i>پذیرش جدید
            </a>
        </div>
        
        <div class="card-body">
            @* فیلترها *@
            <div class="row g-3 mb-3" id="receptionListFilters">
                <div class="col-md-3">
                    <label class="form-label">کد ملی بیمار</label>
                    <input type="text" class="form-control" id="filterNationalCode" placeholder="کد ملی">
                </div>
                <div class="col-md-3">
                    <label class="form-label">نام بیمار</label>
                    <input type="text" class="form-control" id="filterPatientName" placeholder="نام بیمار">
                </div>
                <div class="col-md-2">
                    <label class="form-label">تاریخ از</label>
                    <input type="text" class="form-control persian-datepicker" id="filterDateFrom" placeholder="از تاریخ">
                </div>
                <div class="col-md-2">
                    <label class="form-label">تاریخ تا</label>
                    <input type="text" class="form-control persian-datepicker" id="filterDateTo" placeholder="تا تاریخ">
                </div>
                <div class="col-md-2">
                    <label class="form-label">وضعیت</label>
                    <select class="form-select" id="filterStatus">
                        <option value="">همه</option>
                        <option value="0">در انتظار</option>
                        <option value="1">تکمیل شده</option>
                        <option value="2">لغو شده</option>
                        <option value="3">در حال انجام</option>
                        <option value="4">نیاز به پرداخت بیشتر</option>
                    </select>
                </div>
                <div class="col-12">
                    <button type="button" class="btn btn-primary" id="btnSearch">
                        <i class="fas fa-search me-1"></i>جستجو
                    </button>
                    <button type="button" class="btn btn-secondary" id="btnReset">
                        <i class="fas fa-redo me-1"></i>پاک کردن فیلترها
                    </button>
                </div>
            </div>

            @* لیست پذیرش‌ها *@
            <div id="receptionListContainer">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <p class="mt-2 text-muted">در حال بارگذاری لیست پذیرش‌ها...</p>
                </div>
            </div>

            @* صفحه‌بندی *@
            <nav id="receptionListPagination" class="mt-3" aria-label="صفحه‌بندی">
                <ul class="pagination justify-content-center"></ul>
            </nav>
        </div>
    </div>
</div>

@* Modal پرداخت POS *@
@Html.Partial("../ReceptionV2/Partials/_PosPaymentModal")

@Styles.Render("~/content/reception.v2")
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
<script src="~/Scripts/reception.v2/reception-api.js"></script>
<script src="~/Scripts/reception.v2/reception-list.js"></script>
<script>
    window.ReceptionListConfig = {
        apiUrl: '@Url.Action("GetReceptionList", "ReceptionList")',
        paymentUrl: '/api/v1/pos/process-payment',
        finalizeUrl: '/api/v1/reception/finalize/pos',
        printReceiptUrl: '@Url.Action("PrintReceipt", "Reception", new { area = "" })',
        printInsuranceReceiptUrl: '@Url.Action("PrintInsuranceReceipt", "Reception", new { area = "" })'
    };
</script>

