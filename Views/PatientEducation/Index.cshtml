@model ClinicApp.ViewModels.CMS.PatientEducationMaterialIndexPageViewModel
@using ClinicApp.Models.Enums
@using ClinicApp.Extensions
@{
    ViewBag.Title = "مطالب آموزشی بیماران";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/patient-education.css")" />

<div class="patient-education-wrap" role="main" aria-label="مطالب آموزشی بیماران">
    <div class="container">
        <header class="patient-education-header">
            <h1 class="patient-education-title">
                <i class="fas fa-book-medical" aria-hidden="true"></i>
                مطالب آموزشی بیماران
            </h1>
            <p class="patient-education-subtitle">دسترسی به راهنماها و فایل‌های آموزشی برای مراقبت بهتر از سلامت شما</p>
        </header>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="patient-education-alert" role="alert">
                <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <nav class="patient-education-filter" aria-label="فیلتر دسته‌بندی">
            <span class="patient-education-filter-label">
                <i class="fas fa-filter" aria-hidden="true"></i>
                فیلتر بر اساس دسته‌بندی
            </span>
            <ul class="patient-education-filter-list">
                <li>
                    <a href="@Url.Action("Index")" class="@(Model.SearchModel?.Category == null ? "is-active" : "")" aria-current="@(Model.SearchModel?.Category == null ? "true" : null)">
                        همه دسته‌بندی‌ها
                    </a>
                </li>
                @if (Model.Categories != null)
                {
                    foreach (PatientEducationCategory cat in Model.Categories)
                    {
                        var isActive = Model.SearchModel?.Category == cat;
                        <li>
                            <a href="@Url.Action("Index", new { category = (int)cat })"
                               class="@(isActive ? "is-active" : "")"
                               aria-current="@(isActive ? "true" : null)">
                                @cat.GetDisplayName()
                            </a>
                        </li>
                    }
                }
            </ul>
        </nav>

        <div class="patient-education-grid" id="materialsContainer">
            @if (Model.Materials != null && Model.Materials.Items != null && Model.Materials.Items.Any())
            {
                foreach (var material in Model.Materials.Items)
                {
                    <article class="patient-education-card" aria-label="@material.Title">
                        <div class="patient-education-card-img-wrap">
                            @if (!string.IsNullOrEmpty(material.ThumbnailUrl))
                            {
                                <img src="@material.ThumbnailUrl" alt="@material.Title" loading="lazy" width="400" height="240" />
                            }
                            else if (!string.IsNullOrEmpty(material.ImageUrl))
                            {
                                <img src="@material.ImageUrl" alt="@material.Title" loading="lazy" width="400" height="240" />
                            }
                            else
                            {
                                <div class="patient-education-card-placeholder">
                                    <i class="fas fa-book-medical" aria-hidden="true"></i>
                                </div>
                            }
                        </div>
                        <div class="patient-education-card-body">
                            <span class="patient-education-card-category">@material.CategoryDisplay</span>
                            <h2 class="patient-education-card-title">
                                <a href="@Url.Action("Details", new { id = material.PatientEducationMaterialId })" aria-label="مشاهده: @material.Title">
                                    @material.Title
                                </a>
                            </h2>
                            <p class="patient-education-card-description">
                                @(string.IsNullOrEmpty(material.Description) ? "بدون توضیحات" : material.Description)
                            </p>
                            <div class="patient-education-card-footer">
                                <div class="patient-education-card-stats">
                                    @if (!string.IsNullOrEmpty(material.FileUrl))
                                    {
                                        <span title="فایل موجود"><i class="fas fa-file" aria-hidden="true"></i> فایل</span>
                                    }
                                    <span><i class="fas fa-eye" aria-hidden="true"></i> @material.ViewCount</span>
                                    <span><i class="fas fa-download" aria-hidden="true"></i> @material.DownloadCount</span>
                                </div>
                                <a href="@Url.Action("Details", new { id = material.PatientEducationMaterialId })"
                                   class="patient-education-card-btn"
                                   aria-label="مشاهده مطلب: @material.Title">
                                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                                    مشاهده
                                </a>
                            </div>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="patient-education-empty">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    <h2>مطلبی یافت نشد</h2>
                    <p>در حال حاضر مطلب آموزشی در این دسته‌بندی موجود نیست.</p>
                </div>
            }
        </div>

        @if (Model.Materials != null && Model.Materials.TotalPages > 1)
        {
            var currentCategory = Model.SearchModel?.Category;
            <nav class="patient-education-pagination-wrap" aria-label="صفحه‌بندی مطالب">
                <ul class="pagination justify-content-center">
                    @if (Model.Materials.HasPreviousPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { category = (int?)currentCategory, page = Model.Materials.PageNumber - 1 })" aria-label="صفحه قبلی">
                                <i class="fas fa-chevron-right" aria-hidden="true"></i> قبلی
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link"><i class="fas fa-chevron-right" aria-hidden="true"></i> قبلی</span>
                        </li>
                    }

                    @{
                        var startPage = Math.Max(1, Model.Materials.PageNumber - 2);
                        var endPage = Math.Min(Model.Materials.TotalPages, Model.Materials.PageNumber + 2);
                    }
                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { category = (int?)currentCategory, page = 1 })">1</a>
                        </li>
                        if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                    }
                    @for (var i = startPage; i <= endPage; i++)
                    {
                        if (i == Model.Materials.PageNumber)
                        {
                            <li class="page-item active">
                                <span class="page-link" aria-current="page">@i</span>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", new { category = (int?)currentCategory, page = i })">@i</a>
                            </li>
                        }
                    }
                    @if (endPage < Model.Materials.TotalPages)
                    {
                        if (endPage < Model.Materials.TotalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">…</span></li>
                        }
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { category = (int?)currentCategory, page = Model.Materials.TotalPages })">@Model.Materials.TotalPages</a>
                        </li>
                    }

                    @if (Model.Materials.HasNextPage)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { category = (int?)currentCategory, page = Model.Materials.PageNumber + 1 })" aria-label="صفحه بعدی">
                                بعدی <i class="fas fa-chevron-left" aria-hidden="true"></i>
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">بعدی <i class="fas fa-chevron-left" aria-hidden="true"></i></span>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
