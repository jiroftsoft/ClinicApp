@model ClinicApp.ViewModels.CMS.MedicalEquipmentDetailsViewModel
@{
    ViewBag.Title = Model.EquipmentName;
    ViewBag.MetaDescription = !string.IsNullOrWhiteSpace(Model.MetaDescription) ? Model.MetaDescription : (!string.IsNullOrWhiteSpace(Model.ShortDescription) ? Model.ShortDescription : Model.EquipmentName + " در کلینیک شفا");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/medical-equipment-details.css")" />

<div class="medical-equipment-details-wrap" role="main" aria-label="جزئیات تجهیز پزشکی">
    <div class="container">
        <!-- ناوبری بازگشت (الگوی ایرانی: مسیر واضح) -->
        <nav class="eqd-nav" aria-label="مسیر بازگشت">
            <a href="@Url.Action("Index", "MedicalEquipment")" class="eqd-back-link" aria-label="بازگشت به لیست تجهیزات پزشکی">
                <i class="fas fa-arrow-right" aria-hidden="true"></i>
                <span>بازگشت به لیست تجهیزات</span>
            </a>
        </nav>

        <!-- هیرو: تصویر + عنوان + یک خط بیمارپسند + دسته‌بندی -->
        <header class="eqd-hero" aria-labelledby="eqd-title">
            <div class="eqd-hero-image-wrap">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@(Model.EquipmentName + " در کلینیک شفا")" loading="lazy" decoding="async">
                }
                else
                {
                    <div class="eqd-hero-placeholder">
                        <i class="fas fa-x-ray" aria-hidden="true"></i>
                    </div>
                }
            </div>
            <div class="eqd-hero-content">
                <div class="eqd-hero-badges">
                    <span class="eqd-hero-badge"><i class="fas fa-tag" aria-hidden="true"></i> @Model.CategoryDisplayName</span>
                    @if (Model.IsFeatured)
                    {
                        <span class="eqd-hero-badge eqd-hero-badge-featured"><i class="fas fa-star" aria-hidden="true"></i> ویژه</span>
                    }
                </div>
                <h1 class="eqd-hero-title" id="eqd-title">@Model.EquipmentName</h1>
                @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                {
                    <p class="eqd-hero-lead">@Model.ShortDescription</p>
                }
            </div>
        </header>

        <div class="eqd-layout">
            <!-- ستون اصلی: توضیحات، ویژگی‌ها، مشخصات فنی، گالری، ویدیو -->
            <div class="eqd-main">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <section class="eqd-card" aria-labelledby="eqd-desc-head">
                        <h2 class="eqd-card-head" id="eqd-desc-head"><i class="fas fa-align-right" aria-hidden="true"></i> درباره این تجهیز</h2>
                        <div class="eqd-card-body eqd-prose">
                            @Html.Raw(Model.Description)
                        </div>
                    </section>
                }

                @if (Model.Features != null && Model.Features.Any())
                {
                    <section class="eqd-card" aria-labelledby="eqd-features-head">
                        <h2 class="eqd-card-head" id="eqd-features-head"><i class="fas fa-check-circle" aria-hidden="true"></i> ویژگی‌ها</h2>
                        <div class="eqd-card-body">
                            <ul class="eqd-feature-list">
                                @foreach (var feature in Model.Features)
                                {
                                    <li><i class="fas fa-check" aria-hidden="true"></i> @feature</li>
                                }
                            </ul>
                        </div>
                    </section>
                }

                @if (!string.IsNullOrEmpty(Model.TechnicalSpecifications))
                {
                    <section class="eqd-card" aria-labelledby="eqd-specs-head">
                        <h2 class="eqd-card-head" id="eqd-specs-head"><i class="fas fa-cogs" aria-hidden="true"></i> مشخصات فنی</h2>
                        <div class="eqd-card-body eqd-prose">
                            @Html.Raw(Model.TechnicalSpecifications)
                        </div>
                    </section>
                }

                @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                {
                    <section class="eqd-card" aria-labelledby="eqd-gallery-head">
                        <h2 class="eqd-card-head" id="eqd-gallery-head"><i class="fas fa-images" aria-hidden="true"></i> گالری تصاویر</h2>
                        <div class="eqd-card-body">
                            <div class="eqd-gallery">
                                @foreach (var imageUrl in Model.ImageUrls)
                                {
                                    <button type="button" class="eqd-gallery-item" data-eqd-image="@imageUrl" aria-label="بزرگنمایی تصویر">
                                        <img src="@imageUrl" alt="@Model.EquipmentName">
                                    </button>
                                }
                            </div>
                        </div>
                    </section>
                }

                @if (!string.IsNullOrEmpty(Model.VideoUrl))
                {
                    <section class="eqd-card" aria-labelledby="eqd-video-head">
                        <h2 class="eqd-card-head" id="eqd-video-head"><i class="fas fa-video" aria-hidden="true"></i> ویدیو معرفی</h2>
                        <div class="eqd-card-body">
                            <a href="@Model.VideoUrl" target="_blank" rel="noopener noreferrer" class="eqd-video-btn" aria-label="مشاهده ویدیو در یوتیوب">
                                <i class="fab fa-youtube" aria-hidden="true"></i> مشاهده ویدیو
                            </a>
                        </div>
                    </section>
                }
            </div>

            <!-- سایدبار: اعتماد + اطلاعات + CTA (الگوی پذیرش24 / دکترتو) -->
            <aside class="eqd-sidebar" aria-label="رزرو و تماس">
                <div class="eqd-trust-card">
                    <p class="eqd-trust-title">این تجهیز در کلینیک شفا</p>
                    <p class="eqd-trust-sub">تشخیص و درمان با استانداردهای روز</p>
                </div>

                <div class="eqd-info-card">
                    <div class="eqd-info-card-head"><i class="fas fa-info-circle" aria-hidden="true"></i> اطلاعات</div>
                    <div class="eqd-info-card-body">
                        <div class="eqd-info-row"><strong>دسته‌بندی</strong><span>@Model.CategoryDisplayName</span></div>
                        @if (!string.IsNullOrEmpty(Model.Model))
                        {
                            <div class="eqd-info-row"><strong>مدل</strong><span>@Model.Model</span></div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Manufacturer))
                        {
                            <div class="eqd-info-row"><strong>سازنده</strong><span>@Model.Manufacturer</span></div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Status))
                        {
                            <div class="eqd-info-row"><strong>وضعیت</strong><span>@GetStatusDisplayName(Model.Status)</span></div>
                        }
                        <div class="eqd-info-row"><strong>بازدید</strong><span>@Model.ViewCount</span></div>
                    </div>
                </div>

                <div class="eqd-cta-card">
                    <div class="eqd-cta-card-head"><i class="fas fa-calendar-check" aria-hidden="true"></i> نوبت و تماس</div>
                    <div class="eqd-cta-card-body">
                        <a href="@Url.Action("SelectDoctor", "AppointmentBooking", new { area = "Patient" })" class="eqd-cta-primary" aria-label="رزرو نوبت آنلاین">
                            <i class="fas fa-calendar-alt" aria-hidden="true"></i> رزرو نوبت
                        </a>
                        <a href="@Url.Action("Index", "Contact")" class="eqd-cta-secondary" aria-label="تماس با کلینیک">
                            <i class="fas fa-phone" aria-hidden="true"></i> تماس با کلینیک
                        </a>
                    </div>
                </div>

                <div class="eqd-legal-notice">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    <span>اطلاعات این صفحه صرفاً جهت آشنایی مراجعین است و به‌معنای تشخیص یا توصیه درمانی نیست.</span>
                </div>
            </aside>
        </div>
    </div>
</div>

<!-- مودال تصویر -->
<div class="modal fade" id="imageModal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="imageModalTitle">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalTitle">@Model.EquipmentName</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="بستن">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" alt="@Model.EquipmentName" class="eqd-modal-image">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.eqd-gallery-item').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var url = this.getAttribute('data-eqd-image');
                    if (url) {
                        document.getElementById('modalImage').setAttribute('src', url);
                        $('#imageModal').modal('show');
                    }
                });
            });
        })();
    </script>
}

@functions {
    private string GetStatusDisplayName(string status)
    {
        return status switch
        {
            "Active" => "فعال",
            "Maintenance" => "تعمیر",
            "Inactive" => "غیرفعال",
            _ => status ?? "نامشخص"
        };
    }
}
