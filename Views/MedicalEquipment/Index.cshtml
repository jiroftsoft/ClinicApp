@model ClinicApp.Interfaces.PagedResult<ClinicApp.ViewModels.CMS.MedicalEquipmentIndexViewModel>
@{
    ViewBag.Title = "تجهیزات پزشکی";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/medical-equipment-index.css")" />

<main class="meq-page" role="main" aria-label="لیست تجهیزات پزشکی">
    <div class="meq-container">
        <header class="meq-header">
            <h1 class="meq-title">
                <i class="fas fa-x-ray" aria-hidden="true"></i>
                تجهیزات پزشکی
            </h1>
            <p class="meq-lead">
                با استفاده از تجهیزات مدرن و استاندارد، دقت تشخیص و ایمنی درمان در کلینیک شفا در بالاترین سطح است.
            </p>
        </header>

        <!-- جستجو و فیلتر -->
        <section class="meq-search-card" aria-label="جستجو و فیلتر">
            @using (Html.BeginForm("Index", "MedicalEquipment", FormMethod.Get, new { @class = "meq-search-form" }))
            {
                <label for="meq-search" class="sr-only">جستجو در تجهیزات</label>
                <input type="text" id="meq-search" name="search" class="meq-search-input" placeholder="جستجو در نام یا توضیحات..." value="@ViewBag.Search" aria-label="عبارت جستجو">
                <label for="meq-category" class="sr-only">دسته‌بندی</label>
                <select id="meq-category" name="category" class="meq-search-select" aria-label="انتخاب دسته‌بندی">
                    <option value="">همه دسته‌ها</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in ViewBag.Categories)
                        {
                            <option value="@cat.Value" @(ViewBag.Category == cat.Value ? "selected" : "")>@cat.Text</option>
                        }
                    }
                </select>
                <button type="submit" class="meq-search-btn" aria-label="اجرای جستجو">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <span>جستجو</span>
                </button>
            }
        </section>

        @if (Model.Items != null && Model.Items.Any())
        {
            <section class="meq-grid" role="list">
                @foreach (var item in Model.Items)
                {
                    var detailUrl = Url.Action("Details", "MedicalEquipment", new { slug = !string.IsNullOrEmpty(item.Slug) ? item.Slug : item.EquipmentName?.Replace(" ", "-")?.ToLower() });
                    <article class="meq-card" role="listitem" aria-labelledby="meq-title-@item.MedicalEquipmentId">
                        <a href="@detailUrl" class="meq-card-link" aria-label="مشاهده جزئیات @item.EquipmentName">
                            <div class="meq-card-image-wrap">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@(item.EquipmentName + " در کلینیک شفا")" loading="lazy" decoding="async">
                                }
                                else
                                {
                                    <div class="meq-card-placeholder">
                                        <i class="fas fa-x-ray" aria-hidden="true"></i>
                                    </div>
                                }
                                <span class="meq-card-badge">@item.CategoryDisplayName</span>
                            </div>
                            <div class="meq-card-body">
                                <h2 class="meq-card-title" id="meq-title-@item.MedicalEquipmentId">@item.EquipmentName</h2>
                                @if (!string.IsNullOrEmpty(item.Model))
                                {
                                    <p class="meq-card-meta"><i class="fas fa-tag" aria-hidden="true"></i> @item.Model</p>
                                }
                                @if (!string.IsNullOrEmpty(item.ShortDescription))
                                {
                                    <p class="meq-card-desc">@(item.ShortDescription.Length > 120 ? item.ShortDescription.Substring(0, 120) + "…" : item.ShortDescription)</p>
                                }
                                <div class="meq-card-footer">
                                    <span class="meq-card-views"><i class="fas fa-eye" aria-hidden="true"></i> @item.ViewCount بازدید</span>
                                    <span class="meq-card-cta">مشاهده جزئیات <i class="fas fa-arrow-left" aria-hidden="true"></i></span>
                                </div>
                            </div>
                        </a>
                    </article>
                }
            </section>

            if (Model.TotalPages > 1)
            {
                <nav class="meq-pagination-wrap" aria-label="صفحه‌بندی">
                    <ul class="meq-pagination">
                        @if (Model.PageNumber > 1)
                        {
                            <li>
                                <a href="@Url.Action("Index", new { page = Model.PageNumber - 1, category = ViewBag.Category, search = ViewBag.Search })" aria-label="صفحه قبلی">
                                    <i class="fas fa-chevron-right" aria-hidden="true"></i> قبلی
                                </a>
                            </li>
                        }
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li>
                                @if (i == Model.PageNumber)
                                {
                                    <span class="meq-page-active" aria-current="page">@i</span>
                                }
                                else
                                {
                                    <a href="@Url.Action("Index", new { page = i, category = ViewBag.Category, search = ViewBag.Search })" aria-label="صفحه @i">@i</a>
                                }
                            </li>
                        }
                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <li>
                                <a href="@Url.Action("Index", new { page = Model.PageNumber + 1, category = ViewBag.Category, search = ViewBag.Search })" aria-label="صفحه بعد">
                                    بعدی <i class="fas fa-chevron-left" aria-hidden="true"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <section class="meq-empty" aria-live="polite">
                <i class="fas fa-x-ray" aria-hidden="true"></i>
                <h2 class="meq-empty-title">هیچ تجهیز پزشکی یافت نشد</h2>
                <p class="meq-empty-text">با عبارت یا دسته‌بندی دیگری جستجو کنید.</p>
            </section>
        }
    </div>
</main>
