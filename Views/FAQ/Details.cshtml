@model ClinicApp.ViewModels.CMS.FAQPublicViewModel
@{
    ViewBag.Title = Model.Question;
    ViewBag.MetaDescription = Model.Question;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/faq-pages.css")" />

<div class="faq-page-wrap" role="main" aria-label="جزئیات سوال متداول">
    <div class="container">
        <article class="faq-detail-article" itemscope itemtype="https://schema.org/Question">
            <header class="faq-detail-header">
                <h1 class="faq-detail-title" itemprop="name">@Model.Question</h1>
                <div class="faq-detail-meta">
                    <span class="badge badge-primary">@Model.CategoryDisplayName</span>
                    @if (Model.Tags != null && Model.Tags.Any())
                    {
                        foreach (var tag in Model.Tags)
                        {
                            <span class="badge badge-secondary">@tag</span>
                        }
                    }
                </div>
            </header>
            <div class="faq-detail-body">
                <div class="faq-detail-content" itemprop="acceptedAnswer" itemscope itemtype="https://schema.org/Answer">
                    <div itemprop="text">
                        @Html.Raw(Model.Answer)
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.RelatedLinkUrl))
                {
                    <a href="@Model.RelatedLinkUrl" target="_blank" rel="noopener noreferrer" class="faq-detail-more" aria-label="اطلاعات بیشتر">
                        <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                        اطلاعات بیشتر
                    </a>
                }
                <div class="faq-detail-actions">
                    <a href="@Url.Action("Index")" class="faq-detail-back" aria-label="بازگشت به لیست سوالات متداول">
                        <i class="fas fa-arrow-right" aria-hidden="true"></i>
                        بازگشت به لیست سوالات
                    </a>
                </div>
            </div>
        </article>
    </div>
</div>
