@model ClinicApp.ViewModels.CMS.FAQPublicIndexPageViewModel
@{
    ViewBag.Title = "سوالات متداول";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/faq-pages.css")" />

<div class="faq-page-wrap" role="main" aria-label="سوالات متداول">
    @Html.AntiForgeryToken()
    <div class="container">
        <header class="faq-page-header">
            <h1 class="faq-page-title">
                <i class="fas fa-question-circle" aria-hidden="true"></i>
                سوالات متداول
            </h1>
            <p class="faq-page-subtitle">پاسخ به سوالات رایج شما درباره کلینیک و خدمات</p>
        </header>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="faq-page-empty" role="alert" style="margin-bottom: 1.5rem;">
                <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                <p class="mb-0">@Model.ErrorMessage</p>
            </div>
        }

        @if (Model.Categories != null && Model.Categories.Any())
        {
            <nav class="faq-page-filter" aria-label="فیلتر دسته‌بندی">
                <span class="faq-page-filter-label">
                    <i class="fas fa-filter" aria-hidden="true"></i>
                    دسته‌بندی
                </span>
                <ul class="faq-page-filter-list">
                    <li>
                        <a href="@Url.Action("Index")"
                           class="@(string.IsNullOrEmpty(Model.SelectedCategory) ? "is-active" : "")"
                           aria-current="@(string.IsNullOrEmpty(Model.SelectedCategory) ? "true" : null)">
                            همه
                        </a>
                    </li>
                    @foreach (var cat in Model.Categories)
                    {
                        var isActive = Model.SelectedCategory == cat.Category;
                        <li>
                            <a href="@Url.Action("Index", new { category = cat.Category })"
                               class="@(isActive ? "is-active" : "")"
                               aria-current="@(isActive ? "true" : null)">
                                @cat.DisplayName (@cat.Count)
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

        <div class="faq-page-search">
            <form class="faq-page-search-form" role="search" aria-label="جستجو در سوالات" onsubmit="return false;">
                <label for="faqSearchInput" class="sr-only">جستجو در سوالات متداول</label>
                <input type="search"
                       id="faqSearchInput"
                       class="faq-page-search-input"
                       placeholder="جستجو در سوالات متداول..."
                       aria-label="جستجو در سوالات متداول"
                       autocomplete="off" />
                <button type="button" class="faq-page-search-btn" id="faqSearchBtn" aria-label="اجرای جستجو">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    جستجو
                </button>
            </form>
        </div>

        <div id="faqAccordionContainer">
            @if (Model.Items != null && Model.Items.Any())
            {
                <div class="faq-page-accordion" id="faqAccordion" role="tablist" aria-multiselectable="true">
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        var faq = Model.Items[i];
                        var collapseId = "faqCollapse" + i;
                        var headingId = "faqHeading" + i;
                        <div class="faq-page-card" role="tab" aria-expanded="false">
                            <div class="faq-page-question-wrap">
                                <button type="button"
                                        class="faq-page-question-btn"
                                        id="@headingId"
                                        data-toggle="collapse"
                                        data-target="#@collapseId"
                                        data-parent="#faqAccordion"
                                        aria-expanded="false"
                                        aria-controls="@collapseId"
                                        aria-label="باز کردن پاسخ: @faq.Question"
                                        data-faq-id="@faq.FAQId">
                                    <span class="faq-page-question-text">
                                        <strong>@faq.Question</strong>
                                        @if (faq.Tags != null && faq.Tags.Any())
                                        {
                                            <span class="faq-page-tags">
                                                @foreach (var tag in faq.Tags.Take(2))
                                                {
                                                    <span class="faq-page-tag">@tag</span>
                                                }
                                            </span>
                                        }
                                    </span>
                                    <i class="fas fa-chevron-down faq-page-chevron" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div id="@collapseId"
                                 class="collapse faq-page-answer-wrap"
                                 role="tabpanel"
                                 aria-labelledby="@headingId"
                                 data-parent="#faqAccordion">
                                <div class="faq-page-answer">
                                    @Html.Raw(faq.Answer)
                                </div>
                                @if (!string.IsNullOrEmpty(faq.RelatedLinkUrl))
                                {
                                    <div class="faq-page-related">
                                        <a href="@faq.RelatedLinkUrl" target="_blank" rel="noopener noreferrer" aria-label="اطلاعات بیشتر درباره این سوال">
                                            <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                                            اطلاعات بیشتر
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="faq-page-empty">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    <h2>هیچ سوال متداولی یافت نشد</h2>
                    <p>لطفاً دسته‌بندی دیگری را انتخاب کنید یا کلمه جستجوی دیگری وارد کنید.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var indexUrl = '@Url.Action("Index")';
            var searchUrl = '@Url.Action("Search", "FAQ")';
            var incrementUrl = '@Url.Action("IncrementView", "FAQ")';

            function incrementView(faqId) {
                if (!faqId) return;
                var xhr = new XMLHttpRequest();
                xhr.open('POST', incrementUrl, true);
                xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
                xhr.setRequestHeader('RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
                xhr.send('id=' + encodeURIComponent(faqId));
            }

            document.querySelectorAll('.faq-page-question-btn[data-faq-id]').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var id = this.getAttribute('data-faq-id');
                    if (id) incrementView(id);
                });
            });

            document.getElementById('faqSearchBtn').addEventListener('click', doSearch);
            document.getElementById('faqSearchInput').addEventListener('keypress', function(e) {
                if (e.key === 'Enter') { e.preventDefault(); doSearch(); }
            });

            function doSearch() {
                var term = (document.getElementById('faqSearchInput').value || '').trim();
                if (!term) {
                    alert('لطفاً کلمه‌ای برای جستجو وارد کنید');
                    return;
                }
                var container = document.getElementById('faqAccordionContainer');
                container.innerHTML = '<div class="faq-page-empty"><i class="fas fa-spinner fa-spin"></i><p>در حال جستجو...</p></div>';
                var formData = new FormData();
                formData.append('searchTerm', term);
                formData.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
                fetch(searchUrl, { method: 'POST', body: formData })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.success && data.data && data.data.length > 0) {
                            var html = '<div class="faq-page-results-label">';
                            html += 'نمایش نتایج جستجو برای «' + escapeHtml(term) + '» — ';
                            html += '<a href="' + indexUrl + '">پاک کردن و بازگشت به لیست</a></div>';
                            html += '<div class="faq-page-accordion">';
                            data.data.forEach(function(faq) {
                                html += '<div class="faq-page-card faq-page-card--expanded">';
                                html += '<div class="faq-page-question-wrap"><div class="faq-page-question-btn">';
                                html += '<span class="faq-page-question-text"><strong>' + escapeHtml(faq.Question) + '</strong></span>';
                                html += '</div></div>';
                                html += '<div class="faq-page-answer-wrap"><div class="faq-page-answer">' + (faq.Answer || '') + '</div>';
                                if (faq.RelatedLinkUrl) {
                                    html += '<div class="faq-page-related"><a href="' + escapeHtml(faq.RelatedLinkUrl) + '" target="_blank" rel="noopener noreferrer"><i class="fas fa-external-link-alt"></i> اطلاعات بیشتر</a></div>';
                                }
                                html += '</div></div>';
                            });
                            html += '</div>';
                            container.innerHTML = html;
                        } else {
                            container.innerHTML = '<div class="faq-page-empty"><i class="fas fa-info-circle"></i><h2>نتیجه‌ای یافت نشد</h2><p>لطفاً عبارت دیگری جستجو کنید یا <a href="' + indexUrl + '">به لیست بازگردید</a>.</p></div>';
                        }
                    })
                    .catch(function() {
                        container.innerHTML = '<div class="faq-page-empty"><i class="fas fa-exclamation-triangle"></i><h2>خطا در جستجو</h2><p><a href="' + indexUrl + '">بارگذاری مجدد صفحه</a></p></div>';
                    });
            }

            function escapeHtml(s) {
                if (!s) return '';
                var div = document.createElement('div');
                div.textContent = s;
                return div.innerHTML;
            }
        })();
    </script>
}
