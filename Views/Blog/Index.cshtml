@model ClinicApp.ViewModels.CMS.BlogIndexPageViewModel
@using ClinicApp.ViewModels.Shared
@{
    ViewBag.Title = "مقالات و آموزش سلامت";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var posts = Model?.Posts;
    var pagination = new PaginationViewModel
    {
        CurrentPage = posts?.PageNumber ?? 1,
        TotalPages = posts?.TotalPages ?? 0,
        TotalCount = posts?.TotalItems ?? 0,
        PageSize = posts?.PageSize ?? 12,
        ActionName = "Index",
        ControllerName = "Blog"
    };
    if (!string.IsNullOrEmpty(Model?.Category))
    {
        pagination.RouteValues["category"] = Model.Category;
    }
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/blog-section.css")" />
<link rel="stylesheet" href="@Url.Content("~/Content/css/blog-pages.css")" />

<main class="blog-page-wrap" role="main" aria-label="مقالات و آموزش سلامت">
    <div class="container">
        <header class="blog-page-header">
            <h1 class="blog-page-title">
                <i class="fas fa-book-medical" aria-hidden="true"></i>
                مقالات و آموزش سلامت
            </h1>
            <p class="blog-page-subtitle">پنجره دانش پزشکی معتبر کلینیک</p>
        </header>

        <div class="blog-posts-grid" id="blogPostsContainer">
            @if (posts != null && posts.Items != null && posts.Items.Any())
            {
                foreach (var post in posts.Items)
                {
                    <article class="blog-page-card" aria-label="@post.Title">
                        <div class="blog-page-card-img-wrap">
                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <img src="@post.ImageUrl" alt="@post.Title" loading="lazy" width="400" height="260" />
                            }
                            else if (!string.IsNullOrEmpty(post.ThumbnailUrl))
                            {
                                <img src="@post.ThumbnailUrl" alt="@post.Title" loading="lazy" width="400" height="260" />
                            }
                            else
                            {
                                <div class="blog-page-card-placeholder">
                                    <i class="fas fa-stethoscope" aria-hidden="true"></i>
                                </div>
                            }
                        </div>
                        <div class="blog-page-card-body">
                            @if (!string.IsNullOrEmpty(post.CategoryName))
                            {
                                <span class="blog-page-card-category">
                                    <i class="fas fa-tag" aria-hidden="true"></i>
                                    @post.CategoryName
                                </span>
                            }
                            <h2 class="blog-page-card-title">@post.Title</h2>
                            @if (!string.IsNullOrEmpty(post.Summary))
                            {
                                var summary = post.Summary.Length > 150 ? post.Summary.Substring(0, 150) + "…" : post.Summary;
                                <p class="blog-page-card-summary">@summary</p>
                            }
                            <div class="blog-page-card-meta">
                                @if (post.PublishedAt.HasValue)
                                {
                                    <span>
                                        <i class="fas fa-calendar-alt" aria-hidden="true"></i>
                                        @ClinicApp.Helpers.PersianDateHelper.ToPersianDate(post.PublishedAt.Value)
                                    </span>
                                }
                                <span>
                                    <i class="fas fa-eye" aria-hidden="true"></i>
                                    @post.ViewCount
                                </span>
                            </div>
                            <a href="@Url.Action("Post", "Blog", new { slug = !string.IsNullOrEmpty(post.Slug) ? post.Slug : post.BlogPostId.ToString() })"
                               class="blog-page-card-btn"
                               aria-label="مطالعه مقاله: @post.Title">
                                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                                مطالعه مقاله
                            </a>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="blog-page-empty" style="grid-column: 1 / -1;">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    <h4>هیچ مقاله‌ای یافت نشد</h4>
                    <p>در حال حاضر مقاله‌ای برای نمایش وجود ندارد.</p>
                </div>
            }
        </div>

        @if (posts != null && posts.TotalPages > 1)
        {
            <nav class="blog-pagination-wrap" aria-label="صفحه‌بندی مقالات">
                @Html.Partial("_PaginationPartial", pagination)
            </nav>
        }
    </div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var cards = document.querySelectorAll('.blog-page-card[aria-label]');
        cards.forEach(function (card, i) {
            card.style.animationDelay = (i * 0.05) + 's';
        });
    });
</script>
