@using ClinicApp.Extensions
@model ClinicApp.ViewModels.CMS.ContactFormTrackingViewModel
@{
    ViewBag.Title = "وضعیت پیام";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* ============================================
   Track Result - Production-Grade
   ============================================
   - نمایش وضعیت پیام با Tracking ID
   - UI/UX: طراحی رسمی و حرفه‌ای
   ============================================ *@

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/css/contact-track-page.css")?v=@System.Configuration.ConfigurationManager.AppSettings["AppVersion"]&t=@DateTime.Now.Ticks" />
}

<section class="track-result-section" aria-label="نتیجه جستجو">
    <div class="container">
        <div class="track-result-card">
            <div class="track-result-header">
                <div class="track-result-icon">
                    <i class="fas fa-file-alt" aria-hidden="true"></i>
                </div>
                <h1 class="track-result-title">وضعیت پیام شما</h1>
            </div>

            <div class="track-result-content">
                <div class="track-info-row">
                    <div class="track-info-label">
                        <i class="fas fa-barcode" aria-hidden="true"></i>
                        <span>شماره پیگیری:</span>
                    </div>
                    <div class="track-info-value">
                        <strong>@Model.TrackingId</strong>
                    </div>
                </div>

                <div class="track-info-row">
                    <div class="track-info-label">
                        <i class="fas fa-user" aria-hidden="true"></i>
                        <span>نام و نام خانوادگی:</span>
                    </div>
                    <div class="track-info-value">@Model.FullName</div>
                </div>

                <div class="track-info-row">
                    <div class="track-info-label">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                        <span>ایمیل:</span>
                    </div>
                    <div class="track-info-value">@Model.Email</div>
                </div>

                <div class="track-info-row">
                    <div class="track-info-label">
                        <i class="fas fa-tag" aria-hidden="true"></i>
                        <span>موضوع:</span>
                    </div>
                    <div class="track-info-value">@Model.Subject</div>
                </div>

                <div class="track-info-row">
                    <div class="track-info-label">
                        <i class="fas fa-folder" aria-hidden="true"></i>
                        <span>دسته‌بندی:</span>
                    </div>
                    <div class="track-info-value">@Model.CategoryDisplay</div>
                </div>

                <div class="track-info-row">
                    <div class="track-info-label">
                        <i class="fas fa-calendar-alt" aria-hidden="true"></i>
                        <span>تاریخ ارسال:</span>
                    </div>
                    <div class="track-info-value">@Model.CreatedAtPersian</div>
                </div>

                <div class="track-info-row status-row">
                    <div class="track-info-label">
                        <i class="fas fa-info-circle" aria-hidden="true"></i>
                        <span>وضعیت:</span>
                    </div>
                    <div class="track-info-value">
                        <span class="status-badge status-@Model.Status.ToString().ToLower()">
                            @Model.StatusDisplay
                        </span>
                    </div>
                </div>

                @if (Model.IsRead)
                {
                    <div class="track-info-row">
                        <div class="track-info-label">
                            <i class="fas fa-eye" aria-hidden="true"></i>
                            <span>خوانده شده:</span>
                        </div>
                        <div class="track-info-value">
                            <i class="fas fa-check-circle text-success" aria-hidden="true"></i>
                            <span>بله</span>
                            @if (Model.ReadAt.HasValue)
                            {
                                <span class="text-muted">(@Model.ReadAt.Value.ToPersianDate())</span>
                            }
                        </div>
                    </div>
                }

                @if (Model.HasReply)
                {
                    <div class="track-reply-section">
                        <div class="track-reply-header">
                            <i class="fas fa-reply" aria-hidden="true"></i>
                            <strong>پاسخ شما:</strong>
                        </div>
                        <div class="track-reply-content">
                            <p>پاسخ شما آماده است و در صورت نیاز از طریق ایمیل یا تماس تلفنی با شما ارتباط برقرار خواهیم کرد.</p>
                            @if (Model.RepliedAt.HasValue)
                            {
                                <p class="text-muted">
                                    <i class="fas fa-clock" aria-hidden="true"></i>
                                    تاریخ پاسخ: @Model.RepliedAtPersian
                                </p>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="track-no-reply">
                        <i class="fas fa-hourglass-half" aria-hidden="true"></i>
                        <p>پاسخ شما هنوز آماده نشده است. در ساعات کاری (شنبه تا پنجشنبه: 8:00 - 20:00) با شما تماس خواهیم گرفت.</p>
                    </div>
                }
            </div>

            <div class="track-result-actions">
                <a href="@Url.Action("Track", "Contact")" class="btn btn-track-again">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <span>جستجوی دیگر</span>
                </a>
                <a href="@Url.Action("Index", "Contact")" class="btn btn-contact-again">
                    <i class="fas fa-envelope" aria-hidden="true"></i>
                    <span>ارسال پیام جدید</span>
                </a>
                <a href="@Url.Action("Index", "Home")" class="btn btn-home">
                    <i class="fas fa-home" aria-hidden="true"></i>
                    <span>بازگشت به صفحه اصلی</span>
                </a>
            </div>
        </div>
    </div>
</section>
