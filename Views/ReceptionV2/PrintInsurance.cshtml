@model ClinicApp.ViewModels.Reception.ReceptionDetailsFullDto
@{
    ViewBag.Title = "چاپ قبض بیمه تکمیلی";
    Layout = "~/Views/Shared/_ThermalPrintLayout.cshtml";
    
    // ✅ Production-Grade: داده‌ها از Server-Side بارگذاری شده‌اند (بدون AJAX)
    var reception = Model;
    var hasData = reception != null;
    
    // محاسبه مبالغ
    var totalAmount = reception?.TotalAmount ?? 0;
    var baseInsuranceShare = reception?.BasePay ?? 0;
    var supplementaryInsuranceShare = reception?.SuppPay ?? 0;
    var patientShare = reception?.PatientPay ?? 0;
    
    // محاسبه سهم بیمه تکمیلی از Items
    var totalSupplementaryShare = 0m;
    var totalBaseShare = 0m;
    if (reception?.Items != null)
    {
        foreach (var item in reception.Items)
        {
            // استخراج سهم بیمه تکمیلی از SnapshotJson
            if (!string.IsNullOrEmpty(item.SnapshotJson))
            {
                try
                {
                    var snapshot = Newtonsoft.Json.JsonConvert.DeserializeObject<dynamic>(item.SnapshotJson);
                    if (snapshot?.SupplementaryPays != null)
                    {
                        totalSupplementaryShare += (decimal)snapshot.SupplementaryPays;
                    }
                    if (snapshot?.PrimaryPays != null)
                    {
                        totalBaseShare += (decimal)snapshot.PrimaryPays;
                    }
                }
                catch
                {
                    // اگر SnapshotJson parse نشد، از InsurerShareAmount استفاده کن
                    if (reception.BasePlanId.HasValue && reception.SupplementaryPlanId.HasValue)
                    {
                        totalBaseShare += item.InsurerShareAmount / 2;
                        totalSupplementaryShare += item.InsurerShareAmount - (item.InsurerShareAmount / 2);
                    }
                    else if (reception.SupplementaryPlanId.HasValue)
                    {
                        totalSupplementaryShare += item.InsurerShareAmount;
                    }
                }
            }
            else
            {
                // اگر SnapshotJson وجود ندارد، از InsurerShareAmount استفاده کن
                if (reception.BasePlanId.HasValue && reception.SupplementaryPlanId.HasValue)
                {
                    totalBaseShare += item.InsurerShareAmount / 2;
                    totalSupplementaryShare += item.InsurerShareAmount - (item.InsurerShareAmount / 2);
                }
                else if (reception.SupplementaryPlanId.HasValue)
                {
                    totalSupplementaryShare += item.InsurerShareAmount;
                }
            }
        }
    }
}

@if (!hasData)
{
    <div class="alert alert-danger">
        <h3>خطا در بارگذاری اطلاعات</h3>
        <p>اطلاعات پذیرش یافت نشد. لطفاً دوباره تلاش کنید.</p>
    </div>
}
else
{
    @* ✅ فرمت مناسب برای فیش پرینتر 58mm (SRP-330II) *@
    <div class="thermal-receipt" data-printer-width="58mm">
        @* Header *@
        <div class="receipt-header text-center">
            <h1 class="receipt-title">کلینیک شفا</h1>
            <p class="receipt-subtitle">قبض بیمه تکمیلی</p>
            <hr class="receipt-divider">
        </div>
        
        @* Reception Info *@
        <div class="receipt-section">
            <div class="receipt-row">
                <span class="receipt-label">شماره پذیرش:</span>
                <span class="receipt-value">@(reception.ReceptionNo ?? reception.ElectronicReceptionNumber ?? "-")</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">تاریخ:</span>
                <span class="receipt-value">@(reception.ReceptionDateShamsi ?? reception.ReceptionDate.ToString("yyyy/MM/dd") ?? "-")</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">ساعت:</span>
                <span class="receipt-value">@reception.ReceptionDate.ToString("HH:mm")</span>
            </div>
        </div>
        
        <hr class="receipt-divider">
        
        @* Patient Info *@
        <div class="receipt-section">
            <h2 class="receipt-section-title">بیمار</h2>
            <div class="receipt-row">
                <span class="receipt-label">نام:</span>
                <span class="receipt-value">@(reception.PatientFullName ?? "-")</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">کد ملی:</span>
                <span class="receipt-value">@(reception.PatientNationalCode ?? "-")</span>
            </div>
            <div class="receipt-row">
                <span class="receipt-label">موبایل:</span>
                <span class="receipt-value">@(reception.PatientPhoneNumber ?? "-")</span>
            </div>
        </div>
        
        <hr class="receipt-divider">
        
        @* Insurance Info *@
        <div class="receipt-section">
            <h2 class="receipt-section-title">اطلاعات بیمه تکمیلی</h2>
            <div class="receipt-row">
                <span class="receipt-label">نام بیمه تکمیلی:</span>
                <span class="receipt-value">@(reception.SupplementaryPlanName ?? "-")</span>
            </div>
            @if (!string.IsNullOrEmpty(reception.PatientNationalCode))
            {
                <div class="receipt-row">
                    <span class="receipt-label">شماره کارت:</span>
                    <span class="receipt-value">@reception.PatientNationalCode</span>
                </div>
            }
        </div>
        
        <hr class="receipt-divider">
        
        @* Doctor Info *@
        @if (!string.IsNullOrEmpty(reception.DoctorFullName))
        {
            <div class="receipt-section">
                <h2 class="receipt-section-title">پزشک</h2>
                <div class="receipt-row">
                    <span class="receipt-label">نام:</span>
                    <span class="receipt-value">@reception.DoctorFullName</span>
                </div>
                @if (!string.IsNullOrEmpty(reception.DoctorSpecialization))
                {
                    <div class="receipt-row">
                        <span class="receipt-label">تخصص:</span>
                        <span class="receipt-value">@reception.DoctorSpecialization</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(reception.DepartmentName))
                {
                    <div class="receipt-row">
                        <span class="receipt-label">بخش:</span>
                        <span class="receipt-value">@reception.DepartmentName</span>
                    </div>
                }
            </div>
            <hr class="receipt-divider">
        }
        
        @* Services *@
        @if (reception.Items != null && reception.Items.Any())
        {
            <div class="receipt-section">
                <h2 class="receipt-section-title">خدمات تحت پوشش بیمه تکمیلی</h2>
                <table class="services-table">
                    <thead>
                        <tr>
                            <th>خدمت</th>
                            <th>تعداد</th>
                            <th>قیمت</th>
                            <th>جمع</th>
                            <th>سهم بیمه تکمیلی</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in reception.Items)
                        {
                            var itemTotal = item.UnitPrice * item.Quantity;
                            var supplementaryShare = 0m;
                            var baseShare = 0m;
                            
                            // استخراج سهم بیمه تکمیلی از SnapshotJson
                            if (!string.IsNullOrEmpty(item.SnapshotJson))
                            {
                                try
                                {
                                    var snapshot = Newtonsoft.Json.JsonConvert.DeserializeObject<dynamic>(item.SnapshotJson);
                                    if (snapshot?.SupplementaryPays != null)
                                    {
                                        supplementaryShare = (decimal)snapshot.SupplementaryPays;
                                    }
                                    if (snapshot?.PrimaryPays != null)
                                    {
                                        baseShare = (decimal)snapshot.PrimaryPays;
                                    }
                                }
                                catch
                                {
                                    // اگر SnapshotJson parse نشد، از InsurerShareAmount استفاده کن
                                    if (reception.BasePlanId.HasValue && reception.SupplementaryPlanId.HasValue)
                                    {
                                        baseShare = item.InsurerShareAmount / 2;
                                        supplementaryShare = item.InsurerShareAmount - baseShare;
                                    }
                                    else if (reception.SupplementaryPlanId.HasValue)
                                    {
                                        supplementaryShare = item.InsurerShareAmount;
                                    }
                                }
                            }
                            else
                            {
                                // اگر SnapshotJson وجود ندارد، از InsurerShareAmount استفاده کن
                                if (reception.BasePlanId.HasValue && reception.SupplementaryPlanId.HasValue)
                                {
                                    baseShare = item.InsurerShareAmount / 2;
                                    supplementaryShare = item.InsurerShareAmount - baseShare;
                                }
                                else if (reception.SupplementaryPlanId.HasValue)
                                {
                                    supplementaryShare = item.InsurerShareAmount;
                                }
                            }
                            
                            <tr>
                                <td>@(item.ServiceName ?? "-")</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N0")</td>
                                <td>@itemTotal.ToString("N0")</td>
                                <td>@supplementaryShare.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <hr class="receipt-divider">
        }
        
        @* Totals *@
        <div class="receipt-section">
            <h2 class="receipt-section-title">خلاصه مالی بیمه تکمیلی</h2>
            <div class="receipt-row">
                <span class="receipt-label">مبلغ کل خدمات:</span>
                <span class="receipt-value">@totalAmount.ToString("N0") ریال</span>
            </div>
            @if (totalBaseShare > 0)
            {
                <div class="receipt-row">
                    <span class="receipt-label">سهم بیمه پایه:</span>
                    <span class="receipt-value">@totalBaseShare.ToString("N0") ریال</span>
                </div>
            }
            @if (totalSupplementaryShare > 0)
            {
                <div class="receipt-row receipt-total">
                    <span class="receipt-label">سهم بیمه تکمیلی:</span>
                    <span class="receipt-value">@totalSupplementaryShare.ToString("N0") ریال</span>
                </div>
            }
            @if (patientShare > 0)
            {
                <div class="receipt-row">
                    <span class="receipt-label">سهم بیمار:</span>
                    <span class="receipt-value">@patientShare.ToString("N0") ریال</span>
                </div>
            }
        </div>
        
        <hr class="receipt-divider">
        
        @* Footer *@
        <div class="receipt-footer text-center">
            <p>با تشکر از انتخاب شما</p>
            <p>کلینیک شفا</p>
            <p>@DateTime.Now.ToString("yyyy/MM/dd HH:mm")</p>
        </div>
    </div>
}

@* ✅ چاپ خودکار بعد از بارگذاری صفحه *@
<script>
    (function() {
        // چاپ خودکار بعد از بارگذاری صفحه
        window.addEventListener('load', function() {
            setTimeout(function() {
                window.print();
            }, 500);
        });
        
        // بستن پنجره بعد از چاپ (اختیاری)
        window.addEventListener('afterprint', function() {
            // می‌توانید این خط را حذف کنید اگر می‌خواهید پنجره باز بماند
            // setTimeout(function() { window.close(); }, 500);
        });
    })();
</script>

@* ✅ استایل‌های مخصوص فیش پرینتر *@
<style>
    .thermal-receipt {
        width: 58mm;
        max-width: 58mm;
        margin: 0 auto;
        padding: 5mm;
        font-family: 'Courier New', monospace;
        font-size: 11px;
        line-height: 1.4;
        direction: rtl;
    }
    
    .receipt-header {
        text-align: center;
        margin-bottom: 10px;
    }
    
    .receipt-title {
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 5px;
    }
    
    .receipt-subtitle {
        font-size: 12px;
        color: #28a745;
        margin-bottom: 5px;
    }
    
    .receipt-divider {
        border: none;
        border-top: 1px dashed #000;
        margin: 8px 0;
    }
    
    .receipt-section {
        margin-bottom: 10px;
    }
    
    .receipt-section-title {
        font-size: 12px;
        font-weight: bold;
        margin-bottom: 5px;
        text-align: center;
    }
    
    .receipt-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 3px;
        font-size: 10px;
    }
    
    .receipt-label {
        font-weight: bold;
    }
    
    .receipt-value {
        text-align: left;
    }
    
    .receipt-total {
        font-weight: bold;
        border-top: 1px solid #000;
        padding-top: 3px;
        margin-top: 5px;
    }
    
    .services-table {
        width: 100%;
        font-size: 9px;
        border-collapse: collapse;
        margin-top: 5px;
    }
    
    .services-table th,
    .services-table td {
        padding: 2px;
        text-align: center;
        border-bottom: 1px dotted #ccc;
    }
    
    .services-table th {
        font-weight: bold;
        background-color: #f5f5f5;
    }
    
    .receipt-footer {
        margin-top: 15px;
        padding-top: 10px;
        border-top: 1px dashed #000;
        font-size: 10px;
    }
    
    @@media print {
        body {
            margin: 0;
            padding: 0;
        }
        
        .thermal-receipt {
            width: 58mm;
            max-width: 58mm;
            margin: 0;
            padding: 0;
        }
        
        .no-print {
            display: none !important;
        }
    }
</style>
