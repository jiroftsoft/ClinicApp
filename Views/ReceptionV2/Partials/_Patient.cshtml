@model ClinicApp.ViewModels.Reception.PatientSectionVM
<div id="identity-panel" class="card mb-3">
  <div class="card-header d-flex justify-content-between align-items-center">
    <strong>اطلاعات هویتی</strong>
    <div>
      <button type="button" id="btnEditIdentity" class="btn btn-sm btn-outline-primary">✏️ ویرایش</button>
      <button type="button" id="btnSaveIdentity" class="btn btn-sm btn-success d-none">💾 ذخیره</button>
      <button type="button" id="btnCancelIdentity" class="btn btn-sm btn-secondary d-none">↩️ انصراف</button>
    </div>
  </div>
  <div class="card-body">
    <div class="row g-2">
      @Html.HiddenFor(m => m.PatientId, new { id = "Patient_PatientId" })
      
      <div class="col-md-3">
        <label class="form-label" for="Patient_NationalCode">کد ملی</label>
        @Html.TextBoxFor(m => m.NationalCode, new { @class = "form-control", id = "Patient_NationalCode", autocomplete = "off", placeholder = "10 رقمی" })
        @Html.ValidationMessageFor(m => m.NationalCode, null, new { @class = "text-danger small" })
        <button type="button" id="BtnPatientLookup" class="btn btn-sm btn-primary mt-1 w-100">🔍 جستجو</button>
      </div>
      
      <div class="col-md-3">
        <label class="form-label" for="firstName">نام</label>
        <input id="firstName" class="form-control" readonly autocomplete="given-name" aria-label="نام" />
      </div>
      
      <div class="col-md-3">
        <label class="form-label" for="lastName">نام خانوادگی</label>
        <input id="lastName" class="form-control" readonly autocomplete="family-name" aria-label="نام خانوادگی" />
      </div>
      
      <div class="col-md-3">
        <label class="form-label" for="fatherName">نام پدر</label>
        <input id="fatherName" class="form-control" readonly placeholder="—" autocomplete="off" aria-label="نام پدر" />
      </div>
      
      <div class="col-md-3">
        <label class="form-label" for="gender">جنسیت</label>
        <select id="gender" class="form-select" disabled aria-label="جنسیت">
          <option value="">—</option>
          <option value="Male">مذکر</option>
          <option value="Female">مونث</option>
        </select>
      </div>
      
      <div class="col-md-3">
        <label class="form-label" for="birthSh">تاریخ تولد</label>
        <input id="birthSh" class="form-control" placeholder="YYYY/MM/DD" readonly autocomplete="off" aria-label="تاریخ تولد" />
      </div>
      
      <div class="col-md-3">
        <label class="form-label" for="mobile">موبایل</label>
        <input id="mobile" class="form-control" readonly autocomplete="tel" aria-label="موبایل" />
      </div>
      
      <div class="col-md-3">
        <label class="form-label" for="phone">تلفن ثابت</label>
        <input id="phone" class="form-control" readonly placeholder="—" autocomplete="tel-national" aria-label="تلفن ثابت" />
      </div>
      
      <div class="col-md-12">
        <label class="form-label" for="address">آدرس</label>
        <textarea id="address" class="form-control" readonly rows="2" autocomplete="street-address" aria-label="آدرس"></textarea>
      </div>
    </div>
  </div>
</div>
