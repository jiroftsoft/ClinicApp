@model ClinicApp.ViewModels.Reception.PatientSectionVM
<div class="card mb-3">
  <div class="card-body row g-2">
    <div class="col-md-4">
      <label class="form-label">کدملی</label>
      <input id="Patient_NationalCode" class="form-control" value="@Model.NationalCode" autocomplete="off" />
    </div>
    <div class="col-md-4">
      <label class="form-label">نام و نام خانوادگی</label>
      <input id="Patient_FullName" class="form-control" value="@Model.FullName" />
    </div>
    <div class="col-md-4">
      <label class="form-label">موبایل</label>
      <input id="Patient_Mobile" class="form-control" value="@Model.Mobile" />
    </div>
  </div>
</div>
