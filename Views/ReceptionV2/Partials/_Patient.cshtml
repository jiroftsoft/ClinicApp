@model ClinicApp.ViewModels.Reception.PatientSectionVM
<div class="card mb-3">
  <div class="card-body row g-2">
    @Html.HiddenFor(m => m.PatientId, new { id = "Patient_PatientId" })
    <div class="col-md-4">
      @Html.LabelFor(m => m.NationalCode, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.NationalCode, new { @class = "form-control", id = "Patient_NationalCode", autocomplete = "off" })
      @Html.ValidationMessageFor(m => m.NationalCode, null, new { @class = "text-danger small" })
    </div>
    <div class="col-md-4">
      @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", id = "Patient_FullName" })
      @Html.ValidationMessageFor(m => m.FullName, null, new { @class = "text-danger small" })
    </div>
    <div class="col-md-4">
      @Html.LabelFor(m => m.Mobile, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control", id = "Patient_Mobile" })
      @Html.ValidationMessageFor(m => m.Mobile, null, new { @class = "text-danger small" })
    </div>
  </div>
  
</div>