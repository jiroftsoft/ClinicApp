@model ClinicApp.ViewModels.Reception.TotalsVM
<div class="card mb-3">
  <div class="card-header">جمع‌ها</div>
  <div class="card-body">
    <div class="d-flex justify-content-between"><span>مبلغ کل:</span><strong id="Gross" data-value="@Model.Gross">@Model.Gross</strong></div>
    <div class="d-flex justify-content-between"><span>سهم بیمه پایه:</span><strong id="InsurancePayable">@Model.BaseInsurance</strong></div>
    <div class="d-flex justify-content-between"><span>سهم بیمه تکمیلی:</span><strong id="SuppPayable">@Model.Supplementary</strong></div>
    <hr/>
    <div class="d-flex justify-content-between"><span>سهم بیمار:</span><strong id="PatientPayable" data-value="@Model.PatientPayable">@Model.PatientPayable</strong></div>
  </div>
</div>
