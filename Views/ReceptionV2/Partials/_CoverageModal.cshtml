@* Views/ReceptionV2/Partials/_CoverageModal.cshtml *@
<div id="rv2-coverage-modal" class="modal fade" tabindex="-1" dir="rtl">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title"><i class="fas fa-shield-alt me-2"></i> جزئیات پوشش بیمه</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
      </div>
      <div class="modal-body">
        <ul class="nav nav-tabs small" role="tablist">
          <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-base" role="tab">بیمه پایه</a></li>
          <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-supp" role="tab">بیمه تکمیلی</a></li>
          <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-eff" role="tab">جمع مؤثر</a></li>
        </ul>
        <div class="tab-content border border-top-0 p-3 small">
          <div id="tab-base" class="tab-pane fade show active">
            <div id="cov-base"><div class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-2"></i>در حال بارگذاری...</div></div>
          </div>
          <div id="tab-supp" class="tab-pane fade">
            <div id="cov-supp"><div class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-2"></i>در حال بارگذاری...</div></div>
          </div>
          <div id="tab-eff" class="tab-pane fade">
            <div id="cov-eff"><div class="text-center text-muted py-3"><i class="fas fa-spinner fa-spin me-2"></i>در حال بارگذاری...</div></div>
          </div>
        </div>

        <div class="mt-3 p-2 border rounded">
          <div class="fw-bold mb-2"><i class="fas fa-calculator me-2"></i> پیش‌نمایش قیمت خدمت</div>
          <div class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
              <label class="form-label small">کد خدمت/نام خدمت</label>
              <input type="text" id="cov-service-code" class="form-control form-control-sm" placeholder="مثلاً 970000 یا بخشی از نام">
            </div>
            <div class="col-12 col-md-3">
              <button id="cov-preview-btn" class="btn btn-primary btn-sm w-100">محاسبه</button>
            </div>
            <div class="col-12 col-md-3">
              <div id="cov-preview-result" class="small text-muted"></div>
            </div>
          </div>
        </div>

      </div>
      <div class="modal-footer py-2">
        <button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">بستن</button>
      </div>
    </div>
  </div>
</div>

