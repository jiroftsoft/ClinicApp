@* Views/ReceptionV2/Partials/_CoverageModal.cshtml *@
<style>
    /* ============================================
       استایل‌های حرفه‌ای برای مودال پوشش بیمه
       ============================================ */
    
    :root {
        --medical-blue: #2c5aa0;
        --medical-green: #10b981;
        --medical-orange: #f59e0b;
        --medical-red: #ef4444;
        --medical-gray: #6b7280;
        --bg-light: #f9fafb;
        --border-light: #e5e7eb;
    }
    
    #rv2-coverage-modal .modal-content {
        border-radius: 12px;
        border: none;
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }
    
    #rv2-coverage-modal .modal-header {
        background: linear-gradient(135deg, var(--medical-blue) 0%, #1e40af 100%);
        color: white;
        padding: 1.25rem;
        border-radius: 12px 12px 0 0;
        border-bottom: none;
    }
    
    #rv2-coverage-modal .modal-header .modal-title {
        font-size: 1.1rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    #rv2-coverage-modal .modal-header .btn-close {
        filter: brightness(0) invert(1);
        opacity: 0.8;
    }
    
    #rv2-coverage-modal .modal-header .btn-close:hover {
        opacity: 1;
    }
    
    #rv2-coverage-modal .modal-body {
        padding: 1.5rem;
        background-color: #fafbfc;
    }
    
    /* Tab Navigation - رسمی و خوانا */
    #rv2-coverage-modal .nav-tabs {
        border-bottom: 2px solid var(--border-light);
        margin-bottom: 0;
    }
    
    #rv2-coverage-modal .nav-tabs .nav-link {
        border: none;
        border-bottom: 3px solid transparent;
        color: #6b7280 !important;
        font-weight: 600;
        padding: 0.75rem 1.25rem;
        transition: all 0.2s;
        background: transparent;
    }
    
    #rv2-coverage-modal .nav-tabs .nav-link:hover {
        color: #2c5aa0 !important;
        border-bottom-color: #2c5aa0;
        background-color: rgba(44, 90, 160, 0.05);
    }
    
    #rv2-coverage-modal .nav-tabs .nav-link.active {
        color: #2c5aa0 !important;
        border-bottom-color: #2c5aa0;
        background-color: white;
        font-weight: 700;
    }
    
    /* Tab Content - خوانا و مرتب */
    #rv2-coverage-modal .tab-content {
        background: white;
        border: 1px solid var(--border-light);
        border-top: none;
        padding: 1.5rem;
        border-radius: 0 0 8px 8px;
        min-height: 250px;
    }
    
    /* Info Cards - کارت‌های اطلاعاتی */
    .coverage-info-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
        border: 1px solid var(--border-light);
        border-right: 4px solid var(--medical-blue);
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 0.75rem;
        transition: all 0.2s;
    }
    
    .coverage-info-card:hover {
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transform: translateY(-2px);
    }
    
    .coverage-label {
        font-size: 0.85rem;
        color: var(--medical-gray);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-bottom: 0.4rem;
        display: block;
    }
    
    .coverage-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1f2937;
    }
    
    .coverage-value.highlight {
        color: var(--medical-blue);
        font-size: 1.25rem;
    }
    
    /* Empty State */
    .coverage-empty-state {
        text-align: center;
        padding: 2rem;
        color: var(--medical-gray);
    }
    
    .coverage-empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.3;
    }
    
    /* Price Preview Section */
    .price-preview-section {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        border: 2px solid #f59e0b;
        border-radius: 8px;
        padding: 1.25rem;
        margin-top: 1.5rem;
    }
    
    .price-preview-section .section-title {
        font-weight: 700;
        font-size: 1rem;
        color: #92400e;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .price-preview-section .form-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #78350f;
        margin-bottom: 0.5rem;
    }
    
    .price-preview-section .form-control {
        border: 2px solid #fbbf24;
        border-radius: 6px;
        font-weight: 600;
    }
    
    .price-preview-section .form-control:focus {
        border-color: #f59e0b;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
    }
    
    .price-preview-section .btn-primary {
        background: var(--medical-orange);
        border: none;
        font-weight: 700;
        padding: 0.6rem 1.5rem;
    }
    
    .price-preview-section .btn-primary:hover {
        background: #d97706;
    }
    
    #cov-preview-result {
        background: white;
        padding: 1rem;
        border-radius: 6px;
        border: 2px solid #fbbf24;
        min-height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    /* Loading State */
    .coverage-loading {
        text-align: center;
        padding: 3rem;
        color: var(--medical-blue);
    }
    
    .coverage-loading i {
        font-size: 2rem;
        animation: spin 1s linear infinite;
    }
    
    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    
    /* Tariff Warning Badge در جدول */
    .tariff-warning {
        animation: pulse-warning 2s infinite;
        font-weight: 700;
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
    }
    
    @@keyframes pulse-warning {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
        }
        50% {
            box-shadow: 0 0 0 6px rgba(239, 68, 68, 0);
        }
    }
    
    /* Responsive */
    @@media (max-width: 768px) {
        #rv2-coverage-modal .modal-dialog {
            margin: 0.5rem;
        }
        
        .coverage-info-card {
            margin-bottom: 0.5rem;
        }
    }
</style>

<div id="rv2-coverage-modal" class="modal fade" tabindex="-1" dir="rtl">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">
          <i class="fas fa-shield-alt"></i>
          جزئیات پوشش بیمه
        </h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
      </div>
      <div class="modal-body">
        <ul class="nav nav-tabs" role="tablist">
          <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#tab-base" role="tab">
              <i class="fas fa-hospital-user me-1"></i>
              بیمه پایه
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#tab-supp" role="tab">
              <i class="fas fa-user-shield me-1"></i>
              بیمه تکمیلی
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#tab-eff" role="tab">
              <i class="fas fa-calculator me-1"></i>
              جمع مؤثر
            </a>
          </li>
        </ul>
        <div class="tab-content">
          <div id="tab-base" class="tab-pane fade show active">
            <div id="cov-base">
              <div class="coverage-loading">
                <i class="fas fa-spinner fa-spin"></i>
                <p class="mt-2">در حال بارگذاری...</p>
              </div>
            </div>
          </div>
          <div id="tab-supp" class="tab-pane fade">
            <div id="cov-supp">
              <div class="coverage-loading">
                <i class="fas fa-spinner fa-spin"></i>
                <p class="mt-2">در حال بارگذاری...</p>
              </div>
            </div>
          </div>
          <div id="tab-eff" class="tab-pane fade">
            <div id="cov-eff">
              <div class="coverage-loading">
                <i class="fas fa-spinner fa-spin"></i>
                <p class="mt-2">در حال بارگذاری...</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Price Preview Section -->
        <div class="price-preview-section">
          <div class="section-title">
            <i class="fas fa-calculator"></i>
            پیش‌نمایش قیمت خدمت
          </div>
          <div class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
              <label class="form-label">کد خدمت / نام خدمت</label>
              <input type="text" 
                     id="cov-service-code" 
                     class="form-control" 
                     placeholder="مثلاً 970000 یا بخشی از نام خدمت">
            </div>
            <div class="col-12 col-md-2">
              <button id="cov-preview-btn" class="btn btn-primary w-100">
                <i class="fas fa-search me-1"></i>
                محاسبه
              </button>
            </div>
            <div class="col-12 col-md-4">
              <div id="cov-preview-result" class="text-muted">
                <small>نتیجه اینجا نمایش داده می‌شود</small>
              </div>
            </div>
          </div>
        </div>

      </div>
      <div class="modal-footer" style="background-color: #fafbfc; border-top: 2px solid var(--border-light);">
        <button class="btn btn-secondary" data-bs-dismiss="modal">
          <i class="fas fa-times me-1"></i>
          بستن
        </button>
      </div>
    </div>
  </div>
</div>
