@model ClinicApp.ViewModels.Reception.InsuranceSectionVM
<div class="card mb-3">
  <div class="card-header">بیمه</div>
  <div class="card-body row g-2 align-items-end">
    <div class="col-md-6">
      @Html.LabelFor(m => m.BasePlanId, new { @class = "form-label" })
      @Html.DropDownListFor(m => m.BasePlanId, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-select", id = "BasePlanId" })
      @Html.ValidationMessageFor(m => m.BasePlanId, null, new { @class = "text-danger small" })
    </div>
    <div class="col-md-6">
      @Html.LabelFor(m => m.SupplementaryPlanId, new { @class = "form-label" })
      @Html.DropDownListFor(m => m.SupplementaryPlanId, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-select", id = "SuppPlanId" })
      @Html.ValidationMessageFor(m => m.SupplementaryPlanId, null, new { @class = "text-danger small" })
    </div>
    <div class="col-12">
      <button id="BtnSetInsurances" class="btn btn-outline-primary">ثبت/بازمحاسبه</button>
    </div>
  </div>
</div>