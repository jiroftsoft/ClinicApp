@model ClinicApp.ViewModels.Reception.ClinicDepartmentSectionVM
<div class="card mb-3">
  <div class="card-header">کلینیک / دپارتمان / پزشک</div>
  <div class="card-body row g-2">
    <div class="col-md-4">
      <label class="form-label">کلینیک</label>
      <select id="ClinicId" class="form-select"></select>
    </div>
    <div class="col-md-4">
      <label class="form-label">دپارتمان</label>
      <select id="DepartmentId" class="form-select"></select>
    </div>
    <div class="col-md-4">
      <label class="form-label">پزشک</label>
      <select id="DoctorId" class="form-select"></select>
    </div>
  </div>
</div>