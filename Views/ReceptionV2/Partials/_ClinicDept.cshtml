@model ClinicApp.ViewModels.Reception.ClinicDepartmentSectionVM
<div class="card mb-3">
  <div class="card-header">کلینیک / دپارتمان / پزشک</div>
  <div class="card-body row g-2">
    <div class="col-md-4">
      <label class="form-label" for="ClinicId">کلینیک</label>
      <select id="ClinicId" class="form-select" autocomplete="off" aria-label="کلینیک"></select>
    </div>
    <div class="col-md-4">
      <label class="form-label" for="DepartmentId">دپارتمان</label>
      <select id="DepartmentId" class="form-select" autocomplete="off" aria-label="دپارتمان"></select>
    </div>
    <div class="col-md-4">
      <label class="form-label" for="DoctorId">پزشک</label>
      <select id="DoctorId" class="form-select" autocomplete="off" aria-label="پزشک"></select>
    </div>
  </div>
</div>