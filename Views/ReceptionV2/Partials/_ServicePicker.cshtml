@model ClinicApp.ViewModels.Reception.ServicePickerSectionVM
<div class="card mb-3">
  <div class="card-header">انتخاب خدمت</div>
  <div class="card-body row g-2 align-items-end">
    <div class="col-md-8">
      <label class="form-label">خدمت</label>
      <select id="ServiceId" class="form-select"></select>
    </div>
    <div class="col-md-2">
      <label class="form-label">تعداد</label>
      <input id="Quantity" class="form-control" value="1" />
    </div>
    <div class="col-md-2">
      <button id="BtnAddItem" class="btn btn-success w-100">افزودن</button>
    </div>
  </div>
</div>
