@model ClinicApp.ViewModels.Reception.PaymentSectionVM
<div class="card">
  <div class="card-header">پرداخت</div>
  <div class="card-body row g-2">
    <div class="col-12">
      <div class="btn-group w-100">
        <button id="PayPOS" class="btn btn-outline-primary active w-50">POS</button>
        <button id="PayCash" class="btn btn-outline-secondary w-50">نقدی</button>
      </div>
    </div>
    <div class="col-6">
      @Html.LabelFor(m => m.RRN, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.RRN, new { @class = "form-control", id = "RRN" })
    </div>
    <div class="col-6">
      @Html.LabelFor(m => m.TraceNo, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.TraceNo, new { @class = "form-control", id = "TraceNo" })
    </div>
    <div class="col-6">
      @Html.LabelFor(m => m.TerminalId, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.TerminalId, new { @class = "form-control", id = "TerminalId" })
    </div>
    <div class="col-6">
      @Html.LabelFor(m => m.CardLast4, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.CardLast4, new { @class = "form-control", id = "CardLast4" })
      @Html.ValidationMessageFor(m => m.CardLast4, null, new { @class = "text-danger small" })
    </div>
    <div class="col-12"><button id="BtnFinalizePOS" class="btn btn-primary w-100">نهایی‌سازی</button></div>
  </div>
</div>