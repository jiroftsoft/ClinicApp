@model ClinicApp.ViewModels.Reception.PaymentSectionVM
<div class="card">
  <div class="card-header">پرداخت</div>
  <div class="card-body row g-2">
    <div class="col-12">
      <div class="btn-group w-100">
        <button id="PayPOS" class="btn btn-outline-primary active w-50">POS</button>
        <button id="PayCash" class="btn btn-outline-secondary w-50">نقدی</button>
      </div>
    </div>
    <div class="col-12">
      <button id="BtnSaveReception" class="btn btn-success w-100 mb-2">
        <i class="fas fa-save me-2"></i>ذخیره پذیرش
      </button>
      <button id="BtnFinalizePOS" class="btn btn-primary w-100 d-none">
        <i class="fas fa-credit-card me-2"></i>پرداخت و نهایی‌سازی
      </button>
      <button id="BtnContinueWithoutPayment" class="btn btn-outline-primary w-100 mt-2" type="button" title="بیمار فعلی به لیست مراجعه‌کنندگان می‌رود و می‌تواند بعداً تسویه کند؛ فرم برای پذیرش بیمار بعدی خالی می‌شود">
        <i class="fas fa-forward me-2"></i>ادامه (پذیرش بعدی)
      </button>
      <button id="BtnResetForm" class="btn btn-outline-danger w-100 mt-2" type="button" title="حذف پذیرش فعلی و پاک کردن فرم (فقط وقتی می‌خواهید پذیرش را لغو کنید)">
        <i class="fas fa-redo me-2"></i>پاک کردن فرم
      </button>
    </div>
  </div>
</div>