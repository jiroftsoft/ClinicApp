@model ClinicApp.ViewModels.Reception.ReceptionFormVM
@using System.Collections.Generic
@using ClinicApp.ViewModels.Shared
@{
    ViewBag.Title = "پذیرش (نسخه جدید)";
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";

    // تنظیم Breadcrumb Navigation (مسیر سلسله مراتبی)
    ViewBag.Breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "داشبورد", Url = Url.Action("Index", "Home"), Icon = "fas fa-home", Tooltip = "بازگشت به صفحه اصلی" },
        new BreadcrumbItem { Title = "پذیرش جدید", Icon = "fas fa-user-plus", IsActive = true }
    };

    // ✅ تنظیم SignalR URL برای استفاده در JavaScript
    var signalRUrl = System.Configuration.ConfigurationManager.AppSettings["SamanKishSignalRUrl"] ?? "http://localhost:5000/signalr";
}

@* Anti-Forgery Token for AJAX (MUST be before scripts to ensure token exists in DOM) *@
@using (Html.BeginForm("Index", "ReceptionV2", FormMethod.Post, new { id = "v2_af_form", style = "display:none" }))
{
    @Html.AntiForgeryToken()
}

@* Summary Header *@
@Html.Partial("Partials/_ReceptionSummaryHeader")

<div class="reception-pro container-fluid" dir="rtl">
    <!-- هدر پذیرش جدید: لیست پذیرش‌ها + دسترسی سریع صندوق (آیکون با راهنما) -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="m-0">
                <i class="fas fa-user-plus me-2"></i>پذیرش جدید
            </h5>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <a href="@Url.Action("Index", "ReceptionListV2")" class="btn btn-light btn-sm">
                    <i class="fas fa-list me-1"></i>لیست پذیرش‌ها
                </a>
                <span class="text-white-50 d-none d-md-inline">|</span>
                <div class="d-flex gap-1" role="group" aria-label="دسترسی سریع صندوق و پرداخت">
                    <a href="@Url.Action("Index", "PosManagement")"
                       class="btn btn-light btn-sm p-1 px-2 reception-quick-icon"
                       data-bs-toggle="tooltip" data-bs-placement="bottom"
                       title="تنظیمات پوز — مدیریت ترمینال‌های پرداخت و تنظیمات">
                        <i class="fas fa-credit-card" aria-hidden="true"></i>
                    </a>
                    <a href="@Url.Action("Sessions", "PosManagement")"
                       class="btn btn-light btn-sm p-1 px-2 reception-quick-icon"
                       data-bs-toggle="tooltip" data-bs-placement="bottom"
                       title="لیست جلسات صندوق — مشاهده و بستن جلسات نقدی">
                        <i class="fas fa-money-bill-wave" aria-hidden="true"></i>
                    </a>
                    <a href="@Url.Action("StartSession", "PosManagement")"
                       class="btn btn-light btn-sm p-1 px-2 reception-quick-icon"
                       data-bs-toggle="tooltip" data-bs-placement="bottom"
                       title="شروع جلسه صندوق — برای ثبت پرداخت‌های نقدی ابتدا جلسه را شروع کنید">
                        <i class="fas fa-play-circle text-success" aria-hidden="true"></i>
                    </a>
                    <a href="@Url.Action("Index", "CashierReport")"
                       class="btn btn-light btn-sm p-1 px-2 reception-quick-icon"
                       data-bs-toggle="tooltip" data-bs-placement="bottom"
                       title="گزارشات صندوق — گزارش روزانه و خلاصه صندوق‌داران">
                        <i class="fas fa-chart-bar" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <style>
        .reception-quick-icon { min-width: 2rem; }
        .reception-quick-icon:hover { opacity: 0.95; }
    </style>

    <div class="row mt-3">
        <div class="col-xl-8 col-lg-7">
            <section class="reception-pro__section">
                <button class="btn btn-link p-0 mb-2" data-bs-toggle="collapse" data-bs-target="#identity">مشخصات هویتی</button>
                <div id="identity" class="collapse show">
                    @Html.Partial("Partials/_Patient", Model.Patient)
                </div>
            </section>

            @Html.Partial("Partials/_Insurance", Model.Insurance)
            @Html.Partial("Partials/_ClinicDept", Model.ClinicDept)
            @Html.Partial("Partials/_ServicePicker", Model.ServicePicker)
            @Html.Partial("Partials/_ItemsGrid", Model.ServicePicker.SelectedItems)
        </div>

        <div class="col-xl-4 col-lg-5">
            <div class="reception-pro__sticky">
                @Html.Partial("Partials/_Totals", Model.Totals)
                @Html.Partial("Partials/_Payment", Model.Payment)
            </div>
        </div>
    </div>
</div>
@* Patient Fast Create Modal *@
@Html.Partial("Partials/_PatientFastCreateModal")

@* Coverage Modal *@
@Html.Partial("Partials/_CoverageModal")

@* POS Payment Modal - استفاده از ماژول جدید قابل استفاده مجدد *@
@Html.Partial("~/Views/Shared/Components/PosPaymentModal.cshtml")

@{
  var bootstrapJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model?.Bootstrap ?? (object)null);
  var signalrUrlJson = Newtonsoft.Json.JsonConvert.SerializeObject(signalRUrl ?? "");
}
@Styles.Render("~/content/reception.v2")
@Scripts.Render("~/bundles/reception.v2")
<textarea id="reception-bootstrap-json" style="display:none" aria-hidden="true">@Html.Raw(bootstrapJson)</textarea>
<textarea id="saman-kish-signalr-url-json" style="display:none" aria-hidden="true">@Html.Raw(signalrUrlJson)</textarea>
<script>
(function(){
  try {
    var el = document.getElementById('reception-bootstrap-json');
    var raw = el && el.value;
    window.ReceptionBootstrap = (raw && raw.trim()) ? JSON.parse(raw) : null;
  } catch (e) {
    console.warn('[ReceptionV2] Failed to parse ReceptionBootstrap:', e);
    window.ReceptionBootstrap = null;
  }
  try {
    var urlEl = document.getElementById('saman-kish-signalr-url-json');
    var urlRaw = urlEl && urlEl.value;
    if (urlRaw && urlRaw.trim()) {
      var parsed = JSON.parse(urlRaw);
      window.SamanKishSignalRUrl = (typeof parsed === 'string') ? parsed : '';
    } else {
      window.SamanKishSignalRUrl = '';
    }
  } catch (e) {
    console.warn('[ReceptionV2] Failed to parse SamanKishSignalRUrl:', e);
    window.SamanKishSignalRUrl = '';
  }
})();
</script>