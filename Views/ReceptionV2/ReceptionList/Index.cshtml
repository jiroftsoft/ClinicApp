@model ClinicApp.ViewModels.Reception.ReceptionListViewModel
@using System.Collections.Generic
@using ClinicApp.ViewModels.Shared
@{
    ViewBag.Title = "لیست پذیرش‌ها (مراجعات قبلی)";
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";
    
    // تنظیم Breadcrumb Navigation (مسیر سلسله مراتبی)
    ViewBag.Breadcrumbs = new List<BreadcrumbItem>
    {
        new BreadcrumbItem { Title = "داشبورد", Url = Url.Action("Index", "Home"), Icon = "fas fa-home", Tooltip = "بازگشت به صفحه اصلی" },
        new BreadcrumbItem { Title = "لیست پذیرش‌ها", Icon = "fas fa-list-alt", IsActive = true }
    };
}

@* Anti-Forgery Token for AJAX - چند منبع برای اطمینان *@
@{
    var token = Html.AntiForgeryToken().ToString();
    var tokenValue = token.Contains("value=\"") 
        ? token.Substring(token.IndexOf("value=\"") + 7).Split('"')[0] 
        : "";
}
@using (Html.BeginForm("GetReceptionList", "ReceptionListV2", FormMethod.Post, new { id = "receptionList_af_form", style = "display:none" }))
{
    @Html.AntiForgeryToken()
}
@* Meta tag برای دسترسی JavaScript *@
@if (!string.IsNullOrEmpty(tokenValue))
{
    <meta name="__RequestVerificationToken" content="@tokenValue" />
}

<div class="container-fluid" dir="rtl">
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="m-0"><i class="fas fa-list me-2"></i>لیست پذیرش‌ها (مراجعات قبلی)</h5>
            <div class="d-flex gap-2">
                @Html.ActionLink("پذیرش جدید", "Index", "ReceptionV2", new { area = "" }, new { @class = "btn btn-light btn-sm" })
            </div>
        </div>
        
        <div class="card-body">
            @* فیلترها *@
            <div class="row g-3 mb-3" id="receptionListFilters">
                <div class="col-md-3">
                    <label class="form-label">کد ملی بیمار</label>
                    <input type="text" class="form-control" id="filterNationalCode" placeholder="کد ملی">
                </div>
                <div class="col-md-3">
                    <label class="form-label">نام بیمار</label>
                    <input type="text" class="form-control" id="filterPatientName" placeholder="نام بیمار">
                </div>
                <div class="col-md-2">
                    <label class="form-label">تاریخ از</label>
                    <input type="text" class="form-control persian-datepicker" id="filterDateFrom" placeholder="از تاریخ">
                </div>
                <div class="col-md-2">
                    <label class="form-label">تاریخ تا</label>
                    <input type="text" class="form-control persian-datepicker" id="filterDateTo" placeholder="تا تاریخ">
                </div>
                <div class="col-md-2">
                    <label class="form-label">وضعیت</label>
                    <select class="form-select" id="filterStatus">
                        <option value="">همه</option>
                        <option value="0">در انتظار</option>
                        <option value="1">تکمیل شده</option>
                        <option value="2">لغو شده</option>
                        <option value="3">در حال انجام</option>
                        <option value="4">نیاز به پرداخت بیشتر</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">شماره پذیرش</label>
                    <input type="text" class="form-control" id="filterReceptionNo" placeholder="مثل: 1404-0816-00123">
                </div>
                <div class="col-md-3">
                    <label class="form-label">شماره الکترونیکی</label>
                    <input type="text" class="form-control" id="filterElectronicReceptionNumber" placeholder="مثل: 167-1404-0816-00123">
                    <small class="form-text text-muted">برای نمایش تمام پذیرش‌های یک بیمار</small>
                </div>
                <div class="col-12">
                    <button type="button" class="btn btn-primary" id="btnSearch">
                        <i class="fas fa-search me-1"></i>جستجو
                    </button>
                    <button type="button" class="btn btn-secondary" id="btnReset">
                        <i class="fas fa-redo me-1"></i>پاک کردن فیلترها
                    </button>
                </div>
            </div>

            @* لیست پذیرش‌ها *@
            <div id="receptionListContainer">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <p class="mt-2 text-muted">در حال بارگذاری لیست پذیرش‌ها...</p>
                </div>
            </div>

            @* صفحه‌بندی *@
            <nav id="receptionListPagination" class="mt-3" aria-label="صفحه‌بندی">
                <ul class="pagination justify-content-center"></ul>
            </nav>
        </div>
    </div>
</div>

@* Modal پرداخت POS - استفاده از ماژول جدید قابل استفاده مجدد *@
@Html.Partial("~/Views/Shared/Components/PosPaymentModal.cshtml")

@* Modal جزئیات پذیرش - حرفه‌ای و کاربردی برای محیط درمانی *@
<div class="modal fade" id="receptionDetailsModal" tabindex="-1" aria-labelledby="receptionDetailsModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="receptionDetailsModalLabel">
                    <i class="fas fa-file-medical me-2"></i>جزئیات پذیرش
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                @* Loading State *@
                <div id="receptionDetailsLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <p class="mt-3 text-muted">در حال دریافت اطلاعات...</p>
                </div>

                @* Content *@
                <div id="receptionDetailsContent" style="display: none;">
                    @* Header Info *@
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="card border-primary">
                                <div class="card-body">
                                    <h6 class="card-title text-primary"><i class="fas fa-id-card me-2"></i>اطلاعات پذیرش</h6>
                                    <div class="row g-2">
                                        <div class="col-6"><strong>شماره پذیرش:</strong></div>
                                        <div class="col-6" id="detailsReceptionNo">-</div>
                                        <div class="col-6"><strong>شماره الکترونیکی:</strong></div>
                                        <div class="col-6" id="detailsElectronicNumber">-</div>
                                        <div class="col-6"><strong>تاریخ پذیرش:</strong></div>
                                        <div class="col-6" id="detailsReceptionDate">-</div>
                                        <div class="col-6"><strong>وضعیت:</strong></div>
                                        <div class="col-6" id="detailsStatus">-</div>
                                        <div class="col-6"><strong>نوع:</strong></div>
                                        <div class="col-6" id="detailsType">-</div>
                                        <div class="col-6"><strong>اولویت:</strong></div>
                                        <div class="col-6" id="detailsPriority">-</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-info">
                                <div class="card-body">
                                    <h6 class="card-title text-info"><i class="fas fa-user me-2"></i>اطلاعات بیمار</h6>
                                    <div class="row g-2">
                                        <div class="col-6"><strong>نام:</strong></div>
                                        <div class="col-6" id="detailsPatientName">-</div>
                                        <div class="col-6"><strong>کد ملی:</strong></div>
                                        <div class="col-6" id="detailsPatientNationalCode">-</div>
                                        <div class="col-6"><strong>تلفن:</strong></div>
                                        <div class="col-6" id="detailsPatientPhone">-</div>
                                        <div class="col-6"><strong>جنسیت:</strong></div>
                                        <div class="col-6" id="detailsPatientGender">-</div>
                                        <div class="col-6"><strong>تاریخ تولد:</strong></div>
                                        <div class="col-6" id="detailsPatientBirthDate">-</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-success">
                                <div class="card-body">
                                    <h6 class="card-title text-success"><i class="fas fa-user-md me-2"></i>اطلاعات پزشک و دپارتمان</h6>
                                    <div class="row g-2">
                                        <div class="col-6"><strong>پزشک:</strong></div>
                                        <div class="col-6" id="detailsDoctorName">-</div>
                                        <div class="col-6"><strong>تخصص:</strong></div>
                                        <div class="col-6" id="detailsDoctorSpecialization">-</div>
                                        <div class="col-6"><strong>درجه:</strong></div>
                                        <div class="col-6" id="detailsDoctorDegree">-</div>
                                        <div class="col-6"><strong>دپارتمان:</strong></div>
                                        <div class="col-6" id="detailsDepartmentName">-</div>
                                        <div class="col-6"><strong>کلینیک:</strong></div>
                                        <div class="col-6" id="detailsClinicName">-</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Tabs *@
                    <ul class="nav nav-tabs mb-3" id="receptionDetailsTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="services-tab" data-bs-toggle="tab" data-bs-target="#services" type="button" role="tab">
                                <i class="fas fa-list-alt me-1"></i>خدمات (<span id="servicesCount">0</span>)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="financial-tab" data-bs-toggle="tab" data-bs-target="#financial" type="button" role="tab">
                                <i class="fas fa-money-bill-wave me-1"></i>اطلاعات مالی
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="payments-tab" data-bs-toggle="tab" data-bs-target="#payments" type="button" role="tab">
                                <i class="fas fa-credit-card me-1"></i>تراکنش‌های پرداخت (<span id="paymentsCount">0</span>)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="insurance-tab" data-bs-toggle="tab" data-bs-target="#insurance" type="button" role="tab">
                                <i class="fas fa-shield-alt me-1"></i>بیمه
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="audit-tab" data-bs-toggle="tab" data-bs-target="#audit" type="button" role="tab">
                                <i class="fas fa-history me-1"></i>تاریخچه
                            </button>
                        </li>
                    </ul>

                    @* Tab Content *@
                    <div class="tab-content" id="receptionDetailsTabContent">
                        @* Services Tab *@
                        <div class="tab-pane fade show active" id="services" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>کد خدمت</th>
                                            <th>نام خدمت</th>
                                            <th>تعداد</th>
                                            <th>قیمت واحد</th>
                                            <th>قیمت کل</th>
                                            <th>سهم بیمار</th>
                                            <th>سهم بیمه پایه</th>
                                            <th>سهم بیمه تکمیلی</th>
                                            <th>سهم کل بیمه</th>
                                        </tr>
                                    </thead>
                                    <tbody id="detailsServicesList">
                                        <tr><td colspan="9" class="text-center text-muted">در حال بارگذاری...</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        @* Financial Tab *@
                        <div class="tab-pane fade" id="financial" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card border-success mb-3">
                                        <div class="card-header bg-success text-white">
                                            <h6 class="mb-0"><i class="fas fa-calculator me-2"></i>خلاصه مالی</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-6"><strong>مبلغ کل:</strong></div>
                                                <div class="col-6 text-end" id="detailsTotalAmount">0 ریال</div>
                                                <div class="col-6"><strong>مبلغ ناخالص:</strong></div>
                                                <div class="col-6 text-end" id="detailsGross">0 ریال</div>
                                                <div class="col-6"><strong>سهم بیمار:</strong></div>
                                                <div class="col-6 text-end text-primary" id="detailsPatientShare">0 ریال</div>
                                                <div class="col-6"><strong>سهم بیمه پایه:</strong></div>
                                                <div class="col-6 text-end text-info" id="detailsBasePay">0 ریال</div>
                                                <div class="col-6"><strong>سهم بیمه تکمیلی:</strong></div>
                                                <div class="col-6 text-end text-info" id="detailsSuppPay">0 ریال</div>
                                                <div class="col-6"><strong>سهم کل بیمه:</strong></div>
                                                <div class="col-6 text-end text-info" id="detailsInsurerShare">0 ریال</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card border-warning mb-3">
                                        <div class="card-header bg-warning text-white">
                                            <h6 class="mb-0"><i class="fas fa-wallet me-2"></i>وضعیت پرداخت</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <div class="col-6"><strong>پرداخت شده:</strong></div>
                                                <div class="col-6 text-end text-success" id="detailsPaidAmount">0 ریال</div>
                                                <div class="col-6"><strong>باقی‌مانده:</strong></div>
                                                <div class="col-6 text-end" id="detailsRemainingAmount">0 ریال</div>
                                                <div class="col-12">
                                                    <div class="progress" style="height: 25px;">
                                                        <div class="progress-bar" id="detailsPaymentProgress" role="progressbar" style="width: 0%">0%</div>
                                                    </div>
                                                </div>
                                                <div class="col-12" id="detailsDebtStatus"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Payments Tab *@
                        <div class="tab-pane fade" id="payments" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>تاریخ</th>
                                            <th>مبلغ</th>
                                            <th>روش پرداخت</th>
                                            <th>وضعیت</th>
                                            <th>شماره تراکنش</th>
                                            <th>شماره مرجع</th>
                                            <th>توضیحات</th>
                                        </tr>
                                    </thead>
                                    <tbody id="detailsPaymentsList">
                                        <tr><td colspan="7" class="text-center text-muted">در حال بارگذاری...</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        @* Insurance Tab *@
                        <div class="tab-pane fade" id="insurance" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card border-primary mb-3">
                                        <div class="card-header bg-primary text-white">
                                            <h6 class="mb-0"><i class="fas fa-shield-alt me-2"></i>بیمه پایه</h6>
                                        </div>
                                        <div class="card-body">
                                            <div id="detailsBaseInsurance">
                                                <p class="text-muted">اطلاعاتی ثبت نشده است</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card border-info mb-3">
                                        <div class="card-header bg-info text-white">
                                            <h6 class="mb-0"><i class="fas fa-shield-alt me-2"></i>بیمه تکمیلی</h6>
                                        </div>
                                        <div class="card-body">
                                            <div id="detailsSupplementaryInsurance">
                                                <p class="text-muted">اطلاعاتی ثبت نشده است</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Audit Tab *@
                        <div class="tab-pane fade" id="audit" role="tabpanel">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card border-secondary mb-3">
                                        <div class="card-header bg-secondary text-white">
                                            <h6 class="mb-0"><i class="fas fa-user-plus me-2"></i>ایجاد</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-2">
                                                <div class="col-6"><strong>تاریخ:</strong></div>
                                                <div class="col-6" id="detailsCreatedAt">-</div>
                                                <div class="col-6"><strong>ایجاد کننده:</strong></div>
                                                <div class="col-6" id="detailsCreatedBy">-</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card border-secondary mb-3">
                                        <div class="card-header bg-secondary text-white">
                                            <h6 class="mb-0"><i class="fas fa-user-edit me-2"></i>آخرین ویرایش</h6>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-2">
                                                <div class="col-6"><strong>تاریخ:</strong></div>
                                                <div class="col-6" id="detailsUpdatedAt">-</div>
                                                <div class="col-6"><strong>ویرایش کننده:</strong></div>
                                                <div class="col-6" id="detailsUpdatedBy">-</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card border-secondary">
                                        <div class="card-header bg-secondary text-white">
                                            <h6 class="mb-0"><i class="fas fa-sticky-note me-2"></i>یادداشت‌ها</h6>
                                        </div>
                                        <div class="card-body">
                                            <div id="detailsNotes" class="text-muted" style="white-space: pre-wrap;">-</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>بستن
                </button>
                <button type="button" class="btn btn-primary" id="btnPrintReceptionDetails">
                    <i class="fas fa-print me-1"></i>چاپ
                </button>
            </div>
        </div>
    </div>
</div>

@Styles.Render("~/content/reception.v2")
@Scripts.Render("~/bundles/jquery")
@Scripts.Render("~/bundles/bootstrap")
@* SignalR و ماژول‌های POS Payment *@
<script src="~/Scripts/jquery.signalR-2.4.2.min.js"></script>
<script src="~/Scripts/pos-payment/pos-payment-client.js"></script>
<script src="~/Scripts/pos-payment/pos-payment-ui.js"></script>
<script src="~/Scripts/reception.v2/reception-api.js"></script>
<script src="~/Scripts/reception.v2/reception-list.js"></script>
<script>
    // ✅ تنظیم SignalR URL از Web.config برای استفاده در JavaScript
    @{
        var signalRUrl = System.Configuration.ConfigurationManager.AppSettings["SamanKishSignalRUrl"] ?? "http://localhost:5000/signalr";
    }
    window.SamanKishSignalRUrl = '@Html.Raw(signalRUrl)';
    
    window.ReceptionListConfig = {
        apiUrl: '@Url.Action("GetReceptionList", "ReceptionListV2")',
        paymentUrl: '/api/v1/pos/process-payment',
        finalizeUrl: '/api/v1/reception/finalize/pos',
        printReceiptUrl: '@Url.Action("PrintReceipt", "Reception", new { area = "" })',
        printInsuranceReceiptUrl: '@Url.Action("PrintInsuranceReceipt", "Reception", new { area = "" })'
    };
</script>

