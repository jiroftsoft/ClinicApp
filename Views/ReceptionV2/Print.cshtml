@model ClinicApp.ViewModels.Reception.ReceptionDetailsFullDto
@{
    ViewBag.Title = "چاپ رسید پذیرش";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
    
    // ✅ Production-Grade: داده‌ها از Server-Side بارگذاری شده‌اند (بدون AJAX)
    var reception = Model;
    var hasData = reception != null;
    
    // محاسبه مبالغ
    var totalAmount = reception?.TotalAmount ?? 0;
    var baseInsuranceShare = reception?.BasePay ?? 0;
    var supplementaryInsuranceShare = reception?.SuppPay ?? 0;
    var patientShare = reception?.PatientPay ?? 0;
    var paidAmount = reception?.PaidAmount ?? 0;
    var remainingAmount = reception?.RemainingAmount ?? 0;
    
    // دریافت آخرین تراکنش پرداخت
    var lastPayment = reception?.Transactions?
        .Where(t => t.Status == ClinicApp.Models.Enums.PaymentStatus.Success)
        .OrderByDescending(t => t.CreatedAt)
        .FirstOrDefault();
}

@if (!hasData)
{
    <div class="alert alert-danger">
        <h3>خطا در بارگذاری اطلاعات</h3>
        <p>اطلاعات پذیرش یافت نشد. لطفاً دوباره تلاش کنید.</p>
    </div>
}
else
{
    <div class="receipt-container">
        <div class="receipt-header">
            <h1>رسید پذیرش</h1>
            <div class="receipt-info">
                <p><strong>شماره پذیرش:</strong> <span>@(reception.ReceptionNo ?? reception.ElectronicReceptionNumber ?? "-")</span></p>
                <p><strong>تاریخ:</strong> <span>@(reception.ReceptionDateShamsi ?? reception.ReceptionDate.ToString("yyyy/MM/dd"))</span></p>
                <p><strong>ساعت:</strong> <span>@reception.ReceptionDate.ToString("HH:mm")</span></p>
            </div>
        </div>

        <div class="receipt-patient">
            <h2>اطلاعات بیمار</h2>
            <div class="patient-info">
                <p><strong>نام:</strong> <span>@(reception.PatientFullName ?? "-")</span></p>
                <p><strong>کد ملی:</strong> <span>@(reception.PatientNationalCode ?? "-")</span></p>
                <p><strong>موبایل:</strong> <span>@(reception.PatientPhoneNumber ?? "-")</span></p>
            </div>
        </div>

        <div class="receipt-doctor">
            <h2>اطلاعات پزشک</h2>
            <div class="doctor-info">
                <p><strong>نام پزشک:</strong> <span>@(reception.DoctorFullName ?? "-")</span></p>
                <p><strong>تخصص:</strong> <span>@(reception.DoctorSpecialization ?? "-")</span></p>
                <p><strong>بخش:</strong> <span>@(reception.DepartmentName ?? "-")</span></p>
            </div>
        </div>

        @if (reception.Items != null && reception.Items.Any())
        {
            <div class="receipt-services">
                <h2>خدمات</h2>
                <table class="services-table">
                    <thead>
                        <tr>
                            <th>نام خدمت</th>
                            <th>تعداد</th>
                            <th>قیمت واحد</th>
                            <th>جمع</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in reception.Items)
                        {
                            <tr>
                                <td>@(item.ServiceName ?? "-")</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N0") ریال</td>
                                <td>@item.TotalPrice.ToString("N0") ریال</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="receipt-totals">
            <h2>خلاصه مالی</h2>
            <div class="totals-info">
                <p><strong>مبلغ کل:</strong> <span>@totalAmount.ToString("N0") ریال</span></p>
                @if (baseInsuranceShare > 0)
                {
                    <p><strong>سهم بیمه پایه:</strong> <span>@baseInsuranceShare.ToString("N0") ریال</span></p>
                }
                @if (supplementaryInsuranceShare > 0)
                {
                    <p><strong>سهم بیمه تکمیلی:</strong> <span>@supplementaryInsuranceShare.ToString("N0") ریال</span></p>
                }
                <p><strong>سهم بیمار:</strong> <span>@patientShare.ToString("N0") ریال</span></p>
                <p><strong>پرداخت شده:</strong> <span>@paidAmount.ToString("N0") ریال</span></p>
                @if (remainingAmount > 0)
                {
                    <p><strong>باقی‌مانده:</strong> <span class="text-danger">@remainingAmount.ToString("N0") ریال</span></p>
                }
                @if (lastPayment != null)
                {
                    <p><strong>روش پرداخت:</strong> <span>@(lastPayment.MethodText ?? lastPayment.Method.ToString())</span></p>
                    if (lastPayment.Method == ClinicApp.Models.Enums.PaymentMethod.POS && !string.IsNullOrEmpty(lastPayment.ReferenceCode))
                    {
                        <p><strong>RRN:</strong> <span>@lastPayment.ReferenceCode</span></p>
                        if (!string.IsNullOrEmpty(lastPayment.TransactionId))
                        {
                            <p><strong>Trace No:</strong> <span>@lastPayment.TransactionId</span></p>
                        }
                    }
                }
            </div>
        </div>

        <div class="receipt-footer">
            <p>با تشکر از انتخاب شما</p>
            <p>کلینیک شفا</p>
            <p>@DateTime.Now.ToString("yyyy/MM/dd HH:mm")</p>
        </div>
    </div>
}

@* ✅ چاپ خودکار بعد از بارگذاری صفحه *@
<script>
    (function() {
        // چاپ خودکار بعد از بارگذاری صفحه
        window.addEventListener('load', function() {
            setTimeout(function() {
                window.print();
            }, 500);
        });
        
        // بستن پنجره بعد از چاپ (اختیاری)
        window.addEventListener('afterprint', function() {
            // می‌توانید این خط را حذف کنید اگر می‌خواهید پنجره باز بماند
            // setTimeout(function() { window.close(); }, 500);
        });
    })();
</script>

<style>
    .receipt-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
        font-family: 'Tahoma', sans-serif;
        direction: rtl;
    }

    .receipt-header {
        text-align: center;
        border-bottom: 2px solid #333;
        padding-bottom: 20px;
        margin-bottom: 20px;
    }

    .receipt-header h1 {
        color: #333;
        margin-bottom: 15px;
    }

    .receipt-info {
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
    }

    .receipt-info p {
        margin: 5px 0;
    }

    .receipt-patient,
    .receipt-doctor,
    .receipt-services,
    .receipt-totals {
        margin-bottom: 20px;
        border: 1px solid #ddd;
        padding: 15px;
        border-radius: 5px;
    }

    .receipt-patient h2,
    .receipt-doctor h2,
    .receipt-services h2,
    .receipt-totals h2 {
        color: #333;
        margin-bottom: 10px;
        border-bottom: 1px solid #eee;
        padding-bottom: 5px;
    }

    .patient-info,
    .doctor-info,
    .totals-info {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 10px;
    }

    .services-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    .services-table th,
    .services-table td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: center;
    }

    .services-table th {
        background-color: #f5f5f5;
        font-weight: bold;
    }

    .receipt-footer {
        text-align: center;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 2px solid #333;
    }

    .receipt-footer p {
        margin: 5px 0;
        font-weight: bold;
    }

    @@media print {
        body {
            margin: 0;
            padding: 0;
        }
        
        .receipt-container {
            max-width: none;
            margin: 0;
            padding: 10px;
        }
        
        .receipt-header,
        .receipt-patient,
        .receipt-doctor,
        .receipt-services,
        .receipt-totals {
            break-inside: avoid;
        }
    }
</style>