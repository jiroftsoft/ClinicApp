@model ClinicApp.ViewModels.CMS.InsuranceInfoPublicViewModel
@{
    ViewBag.Title = Model.InsuranceName;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="insurance-detail-page py-5" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%); min-height: 70vh;">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-primary text-white py-4">
                        <div class="d-flex align-items-center">
                            @if (!string.IsNullOrEmpty(Model.LogoUrl))
                            {
                                <img src="@Model.LogoUrl" alt="@Model.InsuranceName" class="mr-3" style="max-height: 60px;">
                            }
                            else if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                            {
                                <img src="@Model.ThumbnailUrl" alt="@Model.InsuranceName" class="mr-3" style="max-height: 60px;">
                            }
                            <div>
                                <h2 class="mb-0">@Model.InsuranceName</h2>
                                <span class="badge badge-light">
                                    <i class="@GetTypeIcon(Model.InsuranceType)"></i>
                                    @Model.TypeDisplayName
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="alert alert-info mb-4">
                                <strong>توضیحات:</strong> @Model.Description
                            </div>
                        }

                        @if (Model.CoveragePercentage.HasValue)
                        {
                            <div class="mb-4 text-center">
                                <div class="card bg-success text-white">
                                    <div class="card-body">
                                        <h3 class="mb-0">
                                            <i class="fas fa-percentage"></i>
                                            پوشش بیمه: @Model.CoveragePercentage.Value%
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.FullDescription))
                        {
                            <div class="mb-4">
                                <h4>اطلاعات کامل</h4>
                                <div class="insurance-content">
                                    @Html.Raw(Model.FullDescription)
                                </div>
                            </div>
                        }

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card border-left-primary">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <i class="fas fa-phone text-primary"></i>
                                            تماس
                                        </h5>
                                        @if (!string.IsNullOrEmpty(Model.ContactPhone))
                                        {
                                            <p class="card-text">
                                                <a href="tel:@Model.ContactPhone" class="btn btn-outline-primary">
                                                    <i class="fas fa-phone"></i> @Model.ContactPhone
                                                </a>
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="text-muted">اطلاعاتی موجود نیست</p>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card border-left-info">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <i class="fas fa-globe text-info"></i>
                                            وب‌سایت
                                        </h5>
                                        @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                                        {
                                            <p class="card-text">
                                                <a href="@Model.WebsiteUrl" target="_blank" class="btn btn-outline-info">
                                                    <i class="fas fa-external-link-alt"></i> بازدید از وب‌سایت
                                                </a>
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="text-muted">اطلاعاتی موجود نیست</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Address))
                        {
                            <div class="mb-4">
                                <h5>
                                    <i class="fas fa-map-marker-alt text-danger"></i>
                                    آدرس
                                </h5>
                                <p class="text-muted">@Model.Address</p>
                            </div>
                        }

                        <div class="border-top pt-4 mt-4">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-eye text-muted mr-2"></i>
                                        <span class="text-muted">@Model.ViewCount بازدید</span>
                                    </div>
                                </div>
                                <div class="col-md-6 text-right">
                                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                        <i class="fas fa-arrow-right"></i> بازگشت به لیست بیمه‌ها
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <style>
        .insurance-detail-page {
            position: relative;
        }

        .insurance-content {
            line-height: 2;
            color: #495057;
            font-size: 1.1rem;
        }

        .card.shadow-lg {
            border-radius: 15px;
        }
    </style>
}

@functions {
    private string GetTypeIcon(string insuranceType)
    {
        return insuranceType switch
        {
            "basic" => "fas fa-shield-alt",
            "supplementary" => "fas fa-plus-circle",
            "private" => "fas fa-building",
            "government" => "fas fa-landmark",
            _ => "fas fa-info-circle"
        };
    }
}

