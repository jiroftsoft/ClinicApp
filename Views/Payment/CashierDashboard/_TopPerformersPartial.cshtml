@model List<ClinicApp.Models.DTOs.Payment.CashierRanking>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i>
        داده‌ای برای نمایش وجود ندارد.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-striped">
            <thead class="bg-primary text-white">
                <tr>
                    <th>رتبه</th>
                    <th>نام منشی</th>
                    <th>تعداد تراکنش‌ها</th>
                    <th>مبلغ کل</th>
                    <th>نرخ موفقیت</th>
                    <th>تعداد اختلاف‌ها</th>
                    <th>امتیاز کلی</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var performer in Model)
                {
                    <tr>
                        <td>
                            @if (performer.Rank == 1)
                            {
                                <span class="badge badge-warning">
                                    <i class="fas fa-trophy"></i> @performer.Rank
                                </span>
                            }
                            else if (performer.Rank == 2)
                            {
                                <span class="badge badge-secondary">
                                    <i class="fas fa-medal"></i> @performer.Rank
                                </span>
                            }
                            else if (performer.Rank == 3)
                            {
                                <span class="badge badge-info">
                                    <i class="fas fa-award"></i> @performer.Rank
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-light">@performer.Rank</span>
                            }
                        </td>
                        <td>@performer.CashierName</td>
                        <td>@performer.TotalTransactions.ToString("N0")</td>
                        <td>@performer.TotalAmount.ToString("N0") ریال</td>
                        <td>
                            <span class="badge @(performer.SuccessRate >= 95 ? "badge-success" : performer.SuccessRate >= 90 ? "badge-warning" : "badge-danger")">
                                @performer.SuccessRate.ToString("F2")%
                            </span>
                        </td>
                        <td>
                            @if (performer.DiscrepancyCount > 0)
                            {
                                <span class="badge badge-danger">@performer.DiscrepancyCount</span>
                            }
                            else
                            {
                                <span class="badge badge-success">0</span>
                            }
                        </td>
                        <td>
                            <strong>@performer.OverallScore.ToString("F2")</strong>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

