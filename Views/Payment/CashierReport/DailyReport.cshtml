@model ClinicApp.ViewModels.Payment.CashierDailyReportViewModel
@using System.Globalization
@{
    ViewBag.Title = "گزارش روزانه - " + Model.Report.CashierName;
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";
    var reportDatePersian = Model.ReportDatePersian ?? ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.Report.Date);
}

@section Styles {
    <link href="~/Content/css/cashier-reports.css" rel="stylesheet" />
    <style>
        .cashier-daily-report { font-family: 'Vazir', 'Shabnam', 'Tahoma', sans-serif; direction: rtl; }
        .summary-card { min-height: 120px; }
        @@media print {
            .no-print { display: none !important; }
            .card { box-shadow: none; border: 1px solid #dee2e6; }
        }
    </style>
}

<div class="container-fluid cashier-daily-report">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <div>
                            <h3 class="card-title mb-0">
                                <i class="fas fa-calendar-day"></i>
                                گزارش روزانه - @Model.Report.CashierName
                            </h3>
                            <small class="text-muted">
                                تاریخ: @reportDatePersian
                            </small>
                        </div>
                        <div class="btn-group no-print mt-2 mt-md-0">
                            <button type="button" class="btn btn-success" onclick="exportToExcel()">
                                <i class="fas fa-file-excel"></i>
                                خروجی Excel
                            </button>
                            <button type="button" class="btn btn-danger" onclick="exportToPdf()">
                                <i class="fas fa-file-pdf"></i>
                                خروجی PDF
                            </button>
                            <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                                <i class="fas fa-print"></i>
                                چاپ
                            </button>
                            <a href="@Url.Action("Index", "CashierReport")" class="btn btn-secondary" title="بازگشت به لیست گزارشات">
                                <i class="fas fa-arrow-right"></i>
                                بازگشت
                            </a>
                            <a href="@Url.Action("Index", "ReceptionV2")" class="btn btn-outline-secondary" title="بازگشت به داشبورد پذیرش">
                                <i class="fas fa-tachometer-alt"></i>
                                داشبورد
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3 col-6 mb-3 mb-md-0">
            <div class="card text-white bg-primary summary-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">تعداد جلسات</h6>
                            <h3 class="mb-0">@Model.Report.SessionsOpened</h3>
                            <small>بسته شده: @Model.Report.SessionsClosed</small>
                        </div>
                        <div><i class="fas fa-door-open fa-2x opacity-50"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3 mb-md-0">
            <div class="card text-white bg-success summary-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">تراکنش‌ها</h6>
                            <h3 class="mb-0">@Model.Report.TotalTransactions.ToString("N0")</h3>
                            <small>موفق: @Model.Report.SuccessfulTransactions | ناموفق: @Model.Report.FailedTransactions</small>
                        </div>
                        <div><i class="fas fa-receipt fa-2x opacity-50"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3 mb-md-0">
            <div class="card text-white bg-info summary-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">مبلغ کل</h6>
                            <h3 class="mb-0">@Model.Report.TotalAmount.ToString("N0")</h3>
                            <small>@Model.CurrencyLabel</small>
                        </div>
                        <div><i class="fas fa-money-bill-wave fa-2x opacity-50"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3 mb-md-0">
            <div class="card text-white bg-warning summary-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">نرخ موفقیت</h6>
                            <h3 class="mb-0">@Model.Report.SuccessRate.ToString("F2")%</h3>
                            <small>میانگین: @Model.Report.AverageTransactionTime.ToString("F2") ثانیه</small>
                        </div>
                        <div><i class="fas fa-check-circle fa-2x opacity-50"></i></div>
                    </div>
                </div>
            </div>
        </div>
        @if (Model.Report.DiscrepancyCount > 0)
        {
            <div class="col-12 mt-2">
                <div class="card border-danger summary-card">
                    <div class="card-body bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0 text-danger">
                                    <i class="fas fa-exclamation-triangle"></i> اختلاف‌های مالی
                                </h6>
                                <h4 class="mb-0 text-danger">@Model.Report.DiscrepancyCount مورد — مجموع: @Model.Report.TotalDiscrepancy.ToString("N0") @Model.CurrencyLabel</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Transaction Breakdown -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-pie"></i>
                        تراکنش‌ها بر اساس روش پرداخت
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="text-center p-3 border rounded">
                                <h4 class="text-primary">@Model.Report.PosTransactions</h4>
                                <p class="mb-0">تراکنش POS</p>
                                <small class="text-muted">@Model.Report.PosAmount.ToString("N0") ریال</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center p-3 border rounded">
                                <h4 class="text-success">@Model.Report.CashTransactions</h4>
                                <p class="mb-0">تراکنش نقدی</p>
                                <small class="text-muted">@Model.Report.CashAmount.ToString("N0") ریال</small>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <canvas id="paymentMethodChart" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar"></i>
                        تراکنش‌ها بر اساس وضعیت
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="text-center p-3 border rounded bg-success text-white">
                                <h4>@Model.Report.SuccessfulTransactions</h4>
                                <p class="mb-0">موفق</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center p-3 border rounded bg-danger text-white">
                                <h4>@Model.Report.FailedTransactions</h4>
                                <p class="mb-0">ناموفق</p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <canvas id="transactionStatusChart" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sessions Table -->
    @if (Model.Report.Sessions != null && Model.Report.Sessions.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-list"></i>
                            جلسات (@Model.Report.Sessions.Count)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th>شماره جلسه</th>
                                        <th>زمان باز شدن</th>
                                        <th>زمان بسته شدن</th>
                                        <th>مدت زمان (دقیقه)</th>
                                        <th>موجودی اولیه</th>
                                        <th>موجودی نقدی</th>
                                        <th>موجودی POS</th>
                                        <th>تعداد تراکنش‌ها</th>
                                        <th>وضعیت</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in Model.Report.Sessions)
                                    {
                                        <tr>
                                            <td>@session.SessionNumber</td>
                                            <td>@ClinicApp.Helpers.PersianDateHelper.ToPersianDateTime(session.OpenedAt)</td>
                                            <td>@(session.ClosedAt.HasValue ? ClinicApp.Helpers.PersianDateHelper.ToPersianDateTime(session.ClosedAt.Value) : "-")</td>
                                            <td>@(session.DurationMinutes?.ToString("N0") ?? "-")</td>
                                            <td>@session.OpeningBalance.ToString("N0") ریال</td>
                                            <td>@session.CashBalance.ToString("N0") ریال</td>
                                            <td>@session.PosBalance.ToString("N0") ریال</td>
                                            <td>@session.TransactionCount</td>
                                            <td>
                                                <span class="badge @(session.Status == "Closed" ? "badge-success" : "badge-warning")">
                                                    @session.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Discrepancies -->
    @if (Model.Report.Discrepancies != null && Model.Report.Discrepancies.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-warning">
                    <div class="card-header bg-warning">
                        <h5 class="mb-0">
                            <i class="fas fa-exclamation-triangle"></i>
                            اختلاف‌ها (@Model.Report.DiscrepancyCount)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning">
                            <strong>مجموع اختلاف:</strong> @Model.Report.TotalDiscrepancy.ToString("N0") ریال
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="bg-warning">
                                    <tr>
                                        <th>نوع</th>
                                        <th>مبلغ مورد انتظار</th>
                                        <th>مبلغ واقعی</th>
                                        <th>اختلاف</th>
                                        <th>دلیل</th>
                                        <th>وضعیت</th>
                                        <th>زمان گزارش</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var discrepancy in Model.Report.Discrepancies)
                                    {
                                        <tr>
                                            <td>@discrepancy.Type</td>
                                            <td>@discrepancy.ExpectedAmount.ToString("N0") ریال</td>
                                            <td>@discrepancy.ActualAmount.ToString("N0") ریال</td>
                                            <td>
                                                <span class="badge @(discrepancy.Difference > 0 ? "badge-danger" : "badge-success")">
                                                    @discrepancy.Difference.ToString("N0") ریال
                                                </span>
                                            </td>
                                            <td>@(discrepancy.Reason ?? "-")</td>
                                            <td>
                                                <span class="badge badge-info">@discrepancy.Status</span>
                                            </td>
                                            <td>@ClinicApp.Helpers.PersianDateHelper.ToPersianDateTime(discrepancy.ReportedAt)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i>
                    هیچ اختلافی ثبت نشده است.
                </div>
            </div>
        </div>
    }

    @if (Model.GeneratedAtUtc.HasValue)
    {
        <div class="row no-print">
            <div class="col-12 text-muted small">
                <i class="fas fa-clock"></i> تولید گزارش: @Model.GeneratedAtUtc.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/Scripts/chart.min.js"></script>
    <script src="~/Scripts/payment/cashier-reports-charts.js"></script>
    <script>
        (function() {
            var exportParams = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new {
                cashierId = Model.Report.CashierId,
                date = Model.Report.Date.ToString("yyyy-MM-dd")
            }));
            window.getDailyReportExportParams = function() { return exportParams; };
        })();
        $(document).ready(function() {
            if (typeof CashierReportsCharts !== 'undefined') {
                var paymentMethodData = {
                    labels: ['POS', 'نقدی'],
                    datasets: [{
                        data: [@Model.Report.PosAmount.ToString(CultureInfo.InvariantCulture), @Model.Report.CashAmount.ToString(CultureInfo.InvariantCulture)],
                        backgroundColor: ['#007bff', '#28a745']
                    }]
                };
                CashierReportsCharts.createPieChart('paymentMethodChart', paymentMethodData);
                var transactionStatusData = {
                    labels: ['موفق', 'ناموفق'],
                    datasets: [{
                        label: 'تعداد تراکنش‌ها',
                        data: [@Model.Report.SuccessfulTransactions, @Model.Report.FailedTransactions],
                        backgroundColor: ['#28a745', '#dc3545']
                    }]
                };
                CashierReportsCharts.createBarChart('transactionStatusChart', transactionStatusData);
            }
        });
        function exportToExcel() {
            var p = window.getDailyReportExportParams();
            if (!p) return;
            var url = '@Url.Action("ExportToExcel", "CashierReport")' + '?cashierId=' + encodeURIComponent(p.cashierId) + '&fromDate=' + encodeURIComponent(p.date) + '&toDate=' + encodeURIComponent(p.date) + '&reportType=Daily';
            window.location.href = url;
        }
        function exportToPdf() {
            var p = window.getDailyReportExportParams();
            if (!p) return;
            var url = '@Url.Action("ExportToPdf", "CashierReport")' + '?cashierId=' + encodeURIComponent(p.cashierId) + '&fromDate=' + encodeURIComponent(p.date) + '&toDate=' + encodeURIComponent(p.date) + '&reportType=Daily';
            window.location.href = url;
        }
    </script>
}

