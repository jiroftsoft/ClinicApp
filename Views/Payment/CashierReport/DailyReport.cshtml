@model ClinicApp.ViewModels.Payment.CashierDailyReportViewModel
@{
    ViewBag.Title = "گزارش روزانه - " + Model.Report.CashierName;
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";
}

@section Styles {
    <link href="~/Content/css/cashier-reports.css" rel="stylesheet" />
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title mb-0">
                                <i class="fas fa-calendar-day"></i>
                                گزارش روزانه - @Model.Report.CashierName
                            </h3>
                            <small class="text-muted">
                                تاریخ: @ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.Report.Date)
                            </small>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-success" onclick="exportToExcel()">
                                <i class="fas fa-file-excel"></i>
                                Export Excel
                            </button>
                            <button type="button" class="btn btn-danger" onclick="exportToPdf()">
                                <i class="fas fa-file-pdf"></i>
                                Export PDF
                            </button>
                            <a href="@Url.Action("Index", "CashierReport")" class="btn btn-secondary">
                                <i class="fas fa-arrow-right"></i>
                                بازگشت
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">تعداد جلسات</h6>
                            <h3 class="mb-0">@Model.Report.SessionsOpened</h3>
                            <small>بسته شده: @Model.Report.SessionsClosed</small>
                        </div>
                        <div>
                            <i class="fas fa-door-open fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">تعداد تراکنش‌ها</h6>
                            <h3 class="mb-0">@Model.Report.TotalTransactions</h3>
                            <small>موفق: @Model.Report.SuccessfulTransactions | ناموفق: @Model.Report.FailedTransactions</small>
                        </div>
                        <div>
                            <i class="fas fa-receipt fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">مبلغ کل</h6>
                            <h3 class="mb-0">@Model.Report.TotalAmount.ToString("N0")</h3>
                            <small>ریال</small>
                        </div>
                        <div>
                            <i class="fas fa-money-bill-wave fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">نرخ موفقیت</h6>
                            <h3 class="mb-0">@Model.Report.SuccessRate.ToString("F2")%</h3>
                            <small>میانگین زمان: @Model.Report.AverageTransactionTime.ToString("F2") ثانیه</small>
                        </div>
                        <div>
                            <i class="fas fa-check-circle fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Transaction Breakdown -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-pie"></i>
                        تراکنش‌ها بر اساس روش پرداخت
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="text-center p-3 border rounded">
                                <h4 class="text-primary">@Model.Report.PosTransactions</h4>
                                <p class="mb-0">تراکنش POS</p>
                                <small class="text-muted">@Model.Report.PosAmount.ToString("N0") ریال</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center p-3 border rounded">
                                <h4 class="text-success">@Model.Report.CashTransactions</h4>
                                <p class="mb-0">تراکنش نقدی</p>
                                <small class="text-muted">@Model.Report.CashAmount.ToString("N0") ریال</small>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <canvas id="paymentMethodChart" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar"></i>
                        تراکنش‌ها بر اساس وضعیت
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <div class="text-center p-3 border rounded bg-success text-white">
                                <h4>@Model.Report.SuccessfulTransactions</h4>
                                <p class="mb-0">موفق</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="text-center p-3 border rounded bg-danger text-white">
                                <h4>@Model.Report.FailedTransactions</h4>
                                <p class="mb-0">ناموفق</p>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <canvas id="transactionStatusChart" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sessions Table -->
    @if (Model.Report.Sessions != null && Model.Report.Sessions.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-list"></i>
                            جلسات (@Model.Report.Sessions.Count)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th>شماره جلسه</th>
                                        <th>زمان باز شدن</th>
                                        <th>زمان بسته شدن</th>
                                        <th>مدت زمان (دقیقه)</th>
                                        <th>موجودی اولیه</th>
                                        <th>موجودی نقدی</th>
                                        <th>موجودی POS</th>
                                        <th>تعداد تراکنش‌ها</th>
                                        <th>وضعیت</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in Model.Report.Sessions)
                                    {
                                        <tr>
                                            <td>@session.SessionNumber</td>
                                            <td>@ClinicApp.Helpers.PersianDateHelper.ToPersianDateTime(session.OpenedAt)</td>
                                            <td>@(session.ClosedAt.HasValue ? ClinicApp.Helpers.PersianDateHelper.ToPersianDateTime(session.ClosedAt.Value) : "-")</td>
                                            <td>@(session.DurationMinutes?.ToString("N0") ?? "-")</td>
                                            <td>@session.OpeningBalance.ToString("N0") ریال</td>
                                            <td>@session.CashBalance.ToString("N0") ریال</td>
                                            <td>@session.PosBalance.ToString("N0") ریال</td>
                                            <td>@session.TransactionCount</td>
                                            <td>
                                                <span class="badge @(session.Status == "Closed" ? "badge-success" : "badge-warning")">
                                                    @session.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Discrepancies -->
    @if (Model.Report.Discrepancies != null && Model.Report.Discrepancies.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-warning">
                    <div class="card-header bg-warning">
                        <h5 class="mb-0">
                            <i class="fas fa-exclamation-triangle"></i>
                            اختلاف‌ها (@Model.Report.DiscrepancyCount)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-warning">
                            <strong>مجموع اختلاف:</strong> @Model.Report.TotalDiscrepancy.ToString("N0") ریال
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="bg-warning">
                                    <tr>
                                        <th>نوع</th>
                                        <th>مبلغ مورد انتظار</th>
                                        <th>مبلغ واقعی</th>
                                        <th>اختلاف</th>
                                        <th>دلیل</th>
                                        <th>وضعیت</th>
                                        <th>زمان گزارش</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var discrepancy in Model.Report.Discrepancies)
                                    {
                                        <tr>
                                            <td>@discrepancy.Type</td>
                                            <td>@discrepancy.ExpectedAmount.ToString("N0") ریال</td>
                                            <td>@discrepancy.ActualAmount.ToString("N0") ریال</td>
                                            <td>
                                                <span class="badge @(discrepancy.Difference > 0 ? "badge-danger" : "badge-success")">
                                                    @discrepancy.Difference.ToString("N0") ریال
                                                </span>
                                            </td>
                                            <td>@(discrepancy.Reason ?? "-")</td>
                                            <td>
                                                <span class="badge badge-info">@discrepancy.Status</span>
                                            </td>
                                            <td>@ClinicApp.Helpers.PersianDateHelper.ToPersianDateTime(discrepancy.ReportedAt)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i>
                    هیچ اختلافی ثبت نشده است.
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script src="~/Scripts/payment/cashier-reports-charts.js"></script>
    
    <script>
        $(document).ready(function() {
            // Initialize Charts
            if (typeof CashierReportsCharts !== 'undefined') {
                // Payment Method Chart (Pie)
                var paymentMethodData = {
                    labels: ['POS', 'نقدی'],
                    datasets: [{
                        data: [@Model.Report.PosAmount, @Model.Report.CashAmount],
                        backgroundColor: ['#007bff', '#28a745']
                    }]
                };
                CashierReportsCharts.createPieChart('paymentMethodChart', paymentMethodData);

                // Transaction Status Chart (Bar)
                var transactionStatusData = {
                    labels: ['موفق', 'ناموفق'],
                    datasets: [{
                        label: 'تعداد تراکنش‌ها',
                        data: [@Model.Report.SuccessfulTransactions, @Model.Report.FailedTransactions],
                        backgroundColor: ['#28a745', '#dc3545']
                    }]
                };
                CashierReportsCharts.createBarChart('transactionStatusChart', transactionStatusData);
            }
        });

        function exportToExcel() {
            var cashierId = '@Model.Report.CashierId';
            var date = '@Model.Report.Date.ToString("yyyy-MM-dd")';
            var url = '@Url.Action("ExportToExcel", "CashierReport")' + 
                '?cashierId=' + cashierId + 
                '&fromDate=' + date + 
                '&toDate=' + date + 
                '&reportType=Daily';
            
            window.location.href = url;
        }

        function exportToPdf() {
            var cashierId = '@Model.Report.CashierId';
            var date = '@Model.Report.Date.ToString("yyyy-MM-dd")';
            var url = '@Url.Action("ExportToPdf", "CashierReport")' + 
                '?cashierId=' + cashierId + 
                '&fromDate=' + date + 
                '&toDate=' + date + 
                '&reportType=Daily';
            
            window.location.href = url;
        }
    </script>
}

