@model ClinicApp.ViewModels.Payment.CashierAllCashiersSummaryViewModel
@{
    ViewBag.Title = "خلاصه تمام منشی‌ها";
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";
}

@section Styles {
    <link href="~/Content/css/cashier-reports.css" rel="stylesheet" />
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title mb-0">
                                <i class="fas fa-users"></i>
                                خلاصه تمام منشی‌ها
                            </h3>
                            <small class="text-muted">
                                @if (Model.Filter.StartDate.HasValue && Model.Filter.EndDate.HasValue)
                                {
                                    <text>
                                        از @ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.Filter.StartDate.Value) 
                                        تا @ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.Filter.EndDate.Value)
                                    </text>
                                }
                            </small>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-success" onclick="exportToExcel()">
                                <i class="fas fa-file-excel"></i>
                                Export Excel
                            </button>
                            <button type="button" class="btn btn-danger" onclick="exportToPdf()">
                                <i class="fas fa-file-pdf"></i>
                                Export PDF
                            </button>
                            <a href="@Url.Action("Index", "CashierReport")" class="btn btn-secondary">
                                <i class="fas fa-arrow-right"></i>
                                بازگشت
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Stats -->
    @if (Model.Summaries != null && Model.Summaries.Any())
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card text-white bg-primary">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">تعداد منشی‌ها</h6>
                                <h3 class="mb-0">@Model.Summaries.Count</h3>
                            </div>
                            <div>
                                <i class="fas fa-users fa-2x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-success">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">کل تراکنش‌ها</h6>
                                <h3 class="mb-0">@Model.Summaries.Sum(s => s.TransactionCount).ToString("N0")</h3>
                            </div>
                            <div>
                                <i class="fas fa-receipt fa-2x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-info">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">مبلغ کل</h6>
                                <h3 class="mb-0">@Model.Summaries.Sum(s => s.TotalAmount).ToString("N0")</h3>
                                <small>ریال</small>
                            </div>
                            <div>
                                <i class="fas fa-money-bill-wave fa-2x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-white bg-warning">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="card-title mb-0">میانگین نرخ موفقیت</h6>
                                <h3 class="mb-0">@(Model.Summaries.Any() ? Model.Summaries.Average(s => s.SuccessRate).ToString("F2") : "0")%</h3>
                            </div>
                            <div>
                                <i class="fas fa-check-circle fa-2x opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-chart-bar"></i>
                            مقایسه تعداد تراکنش‌ها
                        </h5>
                    </div>
                    <div class="card-body">
                        <canvas id="transactionCountChart" height="300"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-chart-bar"></i>
                            مقایسه مبالغ
                        </h5>
                    </div>
                    <div class="card-body">
                        <canvas id="totalAmountChart" height="300"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-chart-bar"></i>
                            مقایسه نرخ موفقیت
                        </h5>
                    </div>
                    <div class="card-body">
                        <canvas id="successRateChart" height="300"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cashiers Table -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-list"></i>
                            لیست منشی‌ها (@Model.Summaries.Count)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover" id="cashiers-table">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th>رتبه</th>
                                        <th>نام منشی</th>
                                        <th>تعداد جلسات</th>
                                        <th>تعداد تراکنش‌ها</th>
                                        <th>مبلغ کل</th>
                                        <th>نرخ موفقیت</th>
                                        <th>تعداد اختلاف‌ها</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var summary in Model.Summaries.OrderBy(s => s.Rank))
                                    {
                                        <tr>
                                            <td>
                                                @if (summary.Rank == 1)
                                                {
                                                    <span class="badge badge-warning">
                                                        <i class="fas fa-trophy"></i> @summary.Rank
                                                    </span>
                                                }
                                                else if (summary.Rank == 2)
                                                {
                                                    <span class="badge badge-secondary">
                                                        <i class="fas fa-medal"></i> @summary.Rank
                                                    </span>
                                                }
                                                else if (summary.Rank == 3)
                                                {
                                                    <span class="badge badge-info">
                                                        <i class="fas fa-award"></i> @summary.Rank
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-light">@summary.Rank</span>
                                                }
                                            </td>
                                            <td>@summary.CashierName</td>
                                            <td>@summary.SessionCount</td>
                                            <td>@summary.TransactionCount.ToString("N0")</td>
                                            <td>@summary.TotalAmount.ToString("N0") ریال</td>
                                            <td>
                                                <span class="badge @(summary.SuccessRate >= 95 ? "badge-success" : summary.SuccessRate >= 90 ? "badge-warning" : "badge-danger")">
                                                    @summary.SuccessRate.ToString("F2")%
                                                </span>
                                            </td>
                                            <td>
                                                @if (summary.DiscrepancyCount > 0)
                                                {
                                                    <span class="badge badge-danger">@summary.DiscrepancyCount</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success">0</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("DailyReport", "CashierReport", new { cashierId = summary.CashierId, date = Model.Filter.StartDate ?? DateTime.Today })" 
                                                   class="btn btn-sm btn-primary">
                                                    <i class="fas fa-eye"></i>
                                                    مشاهده
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    داده‌ای برای نمایش وجود ندارد.
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/Scripts/chart.min.js"></script>
    <script src="~/Scripts/payment/cashier-reports-charts.js"></script>
    
    <script>
        $(document).ready(function() {
            // Initialize Charts
            if (typeof CashierReportsCharts !== 'undefined' && @(Model.Summaries?.Count ?? 0) > 0) {
                var summaries = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Summaries.OrderBy(s => s.Rank)));
                
                // Transaction Count Chart
                var transactionCountLabels = summaries.map(function(s) { return s.CashierName; });
                var transactionCountData = summaries.map(function(s) { return s.TransactionCount; });
                
                var transactionCountChartData = {
                    labels: transactionCountLabels,
                    datasets: [{
                        label: 'تعداد تراکنش‌ها',
                        data: transactionCountData,
                        backgroundColor: '#007bff'
                    }]
                };
                CashierReportsCharts.createBarChart('transactionCountChart', transactionCountChartData);

                // Total Amount Chart
                var totalAmountData = summaries.map(function(s) { return s.TotalAmount; });
                
                var totalAmountChartData = {
                    labels: transactionCountLabels,
                    datasets: [{
                        label: 'مبلغ (ریال)',
                        data: totalAmountData,
                        backgroundColor: '#28a745'
                    }]
                };
                CashierReportsCharts.createBarChart('totalAmountChart', totalAmountChartData);

                // Success Rate Chart
                var successRateData = summaries.map(function(s) { return s.SuccessRate; });
                
                var successRateChartData = {
                    labels: transactionCountLabels,
                    datasets: [{
                        label: 'نرخ موفقیت (%)',
                        data: successRateData,
                        backgroundColor: '#ffc107'
                    }]
                };
                CashierReportsCharts.createBarChart('successRateChart', successRateChartData);
            }
        });

        function exportToExcel() {
            var fromDate = '@(Model.Filter?.StartDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd"))';
            var toDate = '@(Model.Filter?.EndDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))';
            var url = '@Url.Action("ExportToExcel", "CashierReport")' + 
                '?cashierId=all' + 
                '&fromDate=' + fromDate + 
                '&toDate=' + toDate + 
                '&reportType=AllCashiers';
            
            window.location.href = url;
        }

        function exportToPdf() {
            var fromDate = '@(Model.Filter?.StartDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd"))';
            var toDate = '@(Model.Filter?.EndDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))';
            var url = '@Url.Action("ExportToPdf", "CashierReport")' + 
                '?cashierId=all' + 
                '&fromDate=' + fromDate + 
                '&toDate=' + toDate + 
                '&reportType=AllCashiers';
            
            window.location.href = url;
        }
    </script>
}

