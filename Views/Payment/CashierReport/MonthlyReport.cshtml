@model ClinicApp.ViewModels.Payment.CashierMonthlyReportViewModel
@{
    ViewBag.Title = "گزارش ماهانه - " + Model.Report.CashierName;
    Layout = "~/Views/Shared/_ReceptionLayout.cshtml";
    
    var monthNames = new[] { "", "فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند" };
    var monthName = Model.Report.Month >= 1 && Model.Report.Month <= 12 ? monthNames[Model.Report.Month] : Model.Report.Month.ToString();
}

@section Styles {
    <link href="~/Content/css/cashier-reports.css" rel="stylesheet" />
}

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title mb-0">
                                <i class="fas fa-calendar-alt"></i>
                                گزارش ماهانه - @Model.Report.CashierName
                            </h3>
                            <small class="text-muted">
                                @monthName @Model.Report.Year
                            </small>
                        </div>
                        <div class="btn-group">
                            <button type="button" class="btn btn-success" onclick="exportToExcel()">
                                <i class="fas fa-file-excel"></i>
                                Export Excel
                            </button>
                            <button type="button" class="btn btn-danger" onclick="exportToPdf()">
                                <i class="fas fa-file-pdf"></i>
                                Export PDF
                            </button>
                            <a href="@Url.Action("Index", "CashierReport")" class="btn btn-secondary" title="بازگشت به لیست گزارشات">
                                <i class="fas fa-arrow-right"></i>
                                بازگشت
                            </a>
                            <a href="@Url.Action("Index", "ReceptionV2")" class="btn btn-outline-secondary" title="بازگشت به داشبورد پذیرش">
                                <i class="fas fa-tachometer-alt"></i>
                                داشبورد
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">تعداد جلسات</h6>
                            <h3 class="mb-0">@Model.Report.TotalSessions</h3>
                        </div>
                        <div>
                            <i class="fas fa-door-open fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">تعداد تراکنش‌ها</h6>
                            <h3 class="mb-0">@Model.Report.TotalTransactions</h3>
                        </div>
                        <div>
                            <i class="fas fa-receipt fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">مبلغ کل</h6>
                            <h3 class="mb-0">@Model.Report.TotalAmount.ToString("N0")</h3>
                            <small>ریال</small>
                        </div>
                        <div>
                            <i class="fas fa-money-bill-wave fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">میانگین نرخ موفقیت</h6>
                            <h3 class="mb-0">@Model.Report.AverageSuccessRate.ToString("F2")%</h3>
                            <small>میانگین زمان: @Model.Report.AverageTransactionTime.ToString("F2") ثانیه</small>
                        </div>
                        <div>
                            <i class="fas fa-check-circle fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Performance Highlights -->
    @if (Model.Report.BestDay.HasValue || Model.Report.WorstDay.HasValue)
    {
        <div class="row mb-4">
            <div class="col-md-6">
                @if (Model.Report.BestDay.HasValue)
                {
                    <div class="card border-success">
                        <div class="card-body">
                            <h5 class="text-success">
                                <i class="fas fa-trophy"></i>
                                بهترین روز
                            </h5>
                            <p class="mb-0">
                                <strong>@ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.Report.BestDay.Value)</strong>
                            </p>
                        </div>
                    </div>
                }
            </div>
            <div class="col-md-6">
                @if (Model.Report.WorstDay.HasValue)
                {
                    <div class="card border-warning">
                        <div class="card-body">
                            <h5 class="text-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                                بدترین روز
                            </h5>
                            <p class="mb-0">
                                <strong>@ClinicApp.Helpers.PersianDateHelper.ToPersianDate(Model.Report.WorstDay.Value)</strong>
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Charts -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-line"></i>
                        روند تراکنش‌ها در طول ماه
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="monthlyTransactionsChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-area"></i>
                        روند مبالغ در طول ماه
                    </h5>
                </div>
                <div class="card-body">
                    <canvas id="monthlyAmountsChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Daily Reports Table -->
    @if (Model.Report.DailyReports != null && Model.Report.DailyReports.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-list"></i>
                            گزارش روزانه (@Model.Report.DailyReports.Count روز)
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="bg-primary text-white">
                                    <tr>
                                        <th>تاریخ</th>
                                        <th>تعداد جلسات</th>
                                        <th>تعداد تراکنش‌ها</th>
                                        <th>مبلغ کل</th>
                                        <th>نرخ موفقیت</th>
                                        <th>تعداد اختلاف‌ها</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dailyReport in Model.Report.DailyReports.OrderByDescending(d => d.Date))
                                    {
                                        <tr>
                                            <td>@ClinicApp.Helpers.PersianDateHelper.ToPersianDate(dailyReport.Date)</td>
                                            <td>@dailyReport.SessionsOpened</td>
                                            <td>@dailyReport.TotalTransactions</td>
                                            <td>@dailyReport.TotalAmount.ToString("N0") ریال</td>
                                            <td>
                                                <span class="badge @(dailyReport.SuccessRate >= 95 ? "badge-success" : dailyReport.SuccessRate >= 90 ? "badge-warning" : "badge-danger")">
                                                    @dailyReport.SuccessRate.ToString("F2")%
                                                </span>
                                            </td>
                                            <td>
                                                @if (dailyReport.DiscrepancyCount > 0)
                                                {
                                                    <span class="badge badge-danger">@dailyReport.DiscrepancyCount</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success">0</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("DailyReport", "CashierReport", new { cashierId = dailyReport.CashierId, date = dailyReport.Date })" 
                                                   class="btn btn-sm btn-primary">
                                                    <i class="fas fa-eye"></i>
                                                    مشاهده
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    داده‌ای برای نمایش وجود ندارد.
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/Scripts/chart.min.js"></script>
    <script src="~/Scripts/payment/cashier-reports-charts.js"></script>
    
    <script>
        $(document).ready(function() {
            // Initialize Charts
            if (typeof CashierReportsCharts !== 'undefined' && @Model.Report.DailyReports.Count > 0) {
                // Prepare data for charts
                var dailyReports = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Report.DailyReports.OrderBy(d => d.Date)));
                
                // Monthly Transactions Chart (Line)
                var transactionLabels = dailyReports.map(function(d) {
                    return d.Date.split('T')[0]; // Extract date part
                });
                var transactionData = dailyReports.map(function(d) {
                    return d.TotalTransactions;
                });
                
                var monthlyTransactionsData = {
                    labels: transactionLabels,
                    datasets: [{
                        label: 'تعداد تراکنش‌ها',
                        data: transactionData,
                        borderColor: '#007bff',
                        backgroundColor: 'rgba(0, 123, 255, 0.1)',
                        tension: 0.4
                    }]
                };
                CashierReportsCharts.createLineChart('monthlyTransactionsChart', monthlyTransactionsData);

                // Monthly Amounts Chart (Area)
                var amountData = dailyReports.map(function(d) {
                    return d.TotalAmount;
                });
                
                var monthlyAmountsData = {
                    labels: transactionLabels,
                    datasets: [{
                        label: 'مبلغ (ریال)',
                        data: amountData,
                        borderColor: '#28a745',
                        backgroundColor: 'rgba(40, 167, 69, 0.2)',
                        fill: true,
                        tension: 0.4
                    }]
                };
                CashierReportsCharts.createAreaChart('monthlyAmountsChart', monthlyAmountsData);
            }
        });

        function exportToExcel() {
            var cashierId = '@Model.Report.CashierId';
            var year = @Model.Report.Year;
            var month = @Model.Report.Month;
            var url = '@Url.Action("ExportToExcel", "CashierReport")' + 
                '?cashierId=' + cashierId + 
                '&fromDate=' + year + '-' + month + '-01' + 
                '&toDate=' + year + '-' + month + '-31' + 
                '&reportType=Monthly';
            
            window.location.href = url;
        }

        function exportToPdf() {
            var cashierId = '@Model.Report.CashierId';
            var year = @Model.Report.Year;
            var month = @Model.Report.Month;
            var url = '@Url.Action("ExportToPdf", "CashierReport")' + 
                '?cashierId=' + cashierId + 
                '&fromDate=' + year + '-' + month + '-01' + 
                '&toDate=' + year + '-' + month + '-31' + 
                '&reportType=Monthly';
            
            window.location.href = url;
        }
    </script>
}

