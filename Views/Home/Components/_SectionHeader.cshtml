@*
    _SectionHeader.cshtml
    Reusable section header component for consistent styling
    
    Single Responsibility: نمایش Header یکپارچه برای تمام Sections
    طبق: DEVELOPMENT_CONTRACT.md, Componentization Rules
*@
@{
    var title = ViewBag.SectionTitle as string ?? "بخش";
    var subtitle = ViewBag.SectionSubtitle as string;
    var icon = ViewBag.SectionIcon as string;
    var showIcon = ViewBag.ShowIcon ?? true;
}

<div class="section-header">
    @if (showIcon && !string.IsNullOrEmpty(icon))
    {
        <div class="section-header-icon">
            <i class="@icon" aria-hidden="true"></i>
        </div>
    }
    <h2 class="section-title">@title</h2>
    @if (!string.IsNullOrEmpty(subtitle))
    {
        <p class="section-subtitle">@subtitle</p>
    }
</div>

