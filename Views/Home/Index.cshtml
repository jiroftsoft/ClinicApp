@model ClinicApp.ViewModels.HomePageViewModel
@{
    ViewBag.Title = "خانه";
}

<div class="container body-content py-5">
    <div class="homepage-layout">
        <main class="animate-section homepage-main-content" id="mainContent">
            <!-- Announcements Section (Important Announcements) - Lazy Load -->
            @if (Model.Announcements != null && Model.Announcements.Any())
            {
                <section class="announcements-section" data-lazy-load="true" data-section-type="announcements" data-section-id="announcements">
                    @Html.Partial("~/Views/Home/Sections/_AnnouncementsSection.cshtml", Model.Announcements)
                </section>
            }

            <!-- Promotional Events Section (تخفیف‌ها و جشنواره‌های ویژه) -->
            @if (Model.PromotionalEvents != null && Model.PromotionalEvents.Any())
            {
                <section class="promotional-events-section" data-lazy-load="true" data-section-type="promotional-events" data-section-id="promotional-events">
                    @Html.Partial("~/Views/Home/Sections/_PromotionalEventsSection.cshtml", Model.PromotionalEvents)
                </section>
            }

            <!-- Hero Section (Critical - Above-the-fold) -->
            @if (Model.Hero != null)
            {
                <section class="hero-section">
                    @Html.Partial("~/Views/Home/Sections/_HeroSection.cshtml", Model.Hero)
                </section>
            }

            <!-- Value Proposition Section (Critical - Above-the-fold) -->
            @if (Model.ValueProposition != null)
            {
                <section class="value-proposition-section">
                    @Html.Partial("~/Views/Home/Sections/_ValuePropositionSection.cshtml", Model.ValueProposition)
                </section>
            }

            <!-- Services Section - Lazy Load -->
            @if (Model.Services != null && Model.Services.Services != null && Model.Services.Services.Any())
            {
                <section class="services-section" data-lazy-load="true" data-section-type="services" data-section-id="services">
                    @Html.Partial("~/Views/Home/Sections/_ServicesSection.cshtml", Model.Services)
                </section>
            }

            <!-- Medical Services Info Section - Lazy Load -->
            @if (Model.MedicalServiceInfos != null && Model.MedicalServiceInfos.Any())
            {
                <section class="medical-services-section" data-lazy-load="true" data-section-type="medical-services" data-section-id="medical-services">
                    @Html.Partial("~/Views/Home/Sections/_MedicalServicesSection.cshtml", Model.MedicalServiceInfos)
                </section>
            }

            <!-- Medical Equipment Section - Lazy Load -->
            @if (Model.MedicalEquipments != null && Model.MedicalEquipments.Any())
            {
                <section class="medical-equipment-section" data-lazy-load="true" data-section-type="medical-equipment" data-section-id="medical-equipment">
                    @Html.Partial("~/Views/Home/Sections/_MedicalEquipmentSection.cshtml", Model)
                </section>
            }

            <!-- Insurance Info Section - Lazy Load -->
            @if (Model.InsuranceInfos != null && Model.InsuranceInfos.Any())
            {
                <section class="insurance-carousel-section" data-lazy-load="true" data-section-type="insurance" data-section-id="insurance">
                    @Html.Partial("~/Views/Home/Sections/_InsuranceInfoSection.cshtml", Model.InsuranceInfos)
                </section>
            }

            <!-- Doctors Section - Lazy Load -->
            @if (Model.Doctors != null && Model.Doctors.Doctors != null && Model.Doctors.Doctors.Any())
            {
                <section class="doctors-section" data-lazy-load="true" data-section-type="doctors" data-section-id="doctors">
                    @Html.Partial("~/Views/Home/Sections/_DoctorsSection.cshtml", Model.Doctors)
                </section>
            }

            <!-- Quick Appointment Section (Critical - Above-the-fold) -->
            @if (Model.QuickAppointment != null)
            {
                <section class="quick-appointment-section">
                    @Html.Partial("~/Views/Home/Sections/_QuickAppointmentSection.cshtml", Model.QuickAppointment)
                </section>
            }

            <!-- Testimonials Section - Lazy Load -->
            @if (Model.Testimonials != null && Model.Testimonials.Testimonials != null && Model.Testimonials.Testimonials.Any())
            {
                <section class="testimonials-section" data-lazy-load="true" data-section-type="testimonials" data-section-id="testimonials">
                    @Html.Partial("~/Views/Home/Sections/_TestimonialsSection.cshtml", Model.Testimonials)
                </section>
            }

            <!-- Gallery Section - Lazy Load -->
            @if (Model.Gallery != null && Model.Gallery.Items != null && Model.Gallery.Items.Any())
            {
                <section class="gallery-section" data-lazy-load="true" data-section-type="gallery" data-section-id="gallery">
                    @Html.Partial("~/Views/Home/Sections/_GallerySection.cshtml", Model.Gallery)
                </section>
            }

            <!-- Blog Section - Lazy Load -->
            @if (Model.Blog != null && Model.Blog.Posts != null && Model.Blog.Posts.Any())
            {
                <section class="blog-section" data-lazy-load="true" data-section-type="blog" data-section-id="blog">
                    @Html.Partial("~/Views/Home/Sections/_BlogSection.cshtml", Model.Blog)
                </section>
            }

            <!-- Health Tips Section - Lazy Load -->
            @if (Model.HealthTips != null && Model.HealthTips.Any())
            {
                <section class="health-tips-section" data-lazy-load="true" data-section-type="health-tips" data-section-id="health-tips">
                    @Html.Partial("~/Views/Home/Sections/_HealthTipsSection.cshtml", Model.HealthTips)
                </section>
            }

            <!-- Video Section - Lazy Load -->
            @if (Model.Videos != null)
            {
                <section class="video-section" data-lazy-load="true" data-section-type="video" data-section-id="video">
                    @Html.Partial("~/Views/Home/Sections/_VideoSection.cshtml", Model.Videos)
                </section>
            }

            <!-- Stories Section - Lazy Load -->
            @if (Model.Stories != null && Model.Stories.Any())
            {
                <section class="stories-section" data-lazy-load="true" data-section-type="stories" data-section-id="stories">
                    @Html.Partial("~/Views/Home/Sections/_StoriesSection.cshtml", Model.Stories)
                </section>
            }

            <!-- FAQ Section - Lazy Load -->
            @if (Model.FAQs != null && Model.FAQs.Any())
            {
                <section class="faq-section" data-lazy-load="true" data-section-type="faq" data-section-id="faq">
                    @Html.Partial("~/Views/Home/Sections/_FAQSection.cshtml", Model.FAQs)
                </section>
            }

            <!-- Contact Section - Lazy Load -->
            @if (Model.Contact != null)
            {
                <section class="contact-section" data-lazy-load="true" data-section-type="contact" data-section-id="contact">
                    @Html.Partial("~/Views/Home/Sections/_ContactSection.cshtml", Model.Contact)
                </section>
            }

        </main>

        <!-- Professional Medical Sidebar -->
        @if (Model.Sidebar != null)
        {
            <aside class="homepage-sidebar" role="complementary" aria-label="منوی کناری کلینیک">
                @Html.Partial("~/Views/Home/Sections/_SidebarSection.cshtml", Model.Sidebar)
            </aside>
        }
        else if (Model.SidebarSliders != null && Model.SidebarSliders.Any())
        {
            @* Fallback to old sidebar sliders if new sidebar is not available *@
            <aside class="homepage-sidebar" role="complementary" aria-label="اسلایدر سایدبار">
                @Html.Partial("~/Views/Home/Sections/_SidebarSliderSection.cshtml", Model.SidebarSliders)
            </aside>
        }
    </div>

    <!-- Footer Slider Section (Outside Homepage Layout) -->
    @if (Model.FooterSliders != null && Model.FooterSliders.Any())
    {
        @Html.Partial("~/Views/Home/Sections/_FooterSliderSection.cshtml", Model.FooterSliders)
    }

    @section Styles {
        @* CSS برای main-menu-quick-actions حذف شد - بخش "دسترسی سریع" حذف شده است (چون sidebar navigation دارد) *@
        <link rel="stylesheet" href="@Url.Content("~/Content/css/homepage-layout.css")" />
        <link rel="stylesheet" href="@Url.Content("~/Content/css/homepage-sections-spacing.css")" />
        <link rel="stylesheet" href="@Url.Content("~/Content/css/section-states.css")" />
        <link rel="stylesheet" href="@Url.Content("~/Content/css/section-header.css")" />
        @* CSS Bundle برای تمام Section ها - بهینه‌سازی Performance (کاهش HTTP Requests از 11+ به 1) *@
        @Styles.Render("~/Content/css/homepage-sections")
    }

    @section Scripts {
        <script src="@Url.Content("~/Content/js/homepage-animations.js")"></script>
        <script src="@Url.Content("~/Content/js/homepage-lazy-load.js")"></script>
        <script src="@Url.Content("~/Content/js/homepage-section-manager.js")"></script>
    }

</div>
