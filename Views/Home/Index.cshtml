@model ClinicApp.ViewModels.HomePageViewModel
@{
    ViewBag.Title = "خانه";
}

<div class="container body-content py-5">
    <div class="homepage-layout">
        <main class="animate-section homepage-main-content" id="mainContent">
            <!-- Announcements Section (Important Announcements) - Lazy Load -->
            @if (Model.Announcements != null && Model.Announcements.Any())
            {
                <section class="announcements-section" data-lazy-load="true" data-section-type="announcements" data-section-id="announcements" aria-label="اطلاعیه‌های مهم">
                    @{
                        Html.RenderPartial("Sections/_AnnouncementsSection", Model.Announcements);
                    }
                </section>
            }

            <!-- Promotional Events Section (تخفیف‌ها و جشنواره‌های ویژه) -->
            @if (Model.PromotionalEvents != null && Model.PromotionalEvents.Any())
            {
                <section class="promotional-events-section" data-lazy-load="true" data-section-type="promotional-events" data-section-id="promotional-events" aria-label="تخفیف‌ها و جشنواره‌ها">
                    @{
                        Html.RenderPartial("Sections/_PromotionalEventsSection", Model.PromotionalEvents);
                    }
                </section>
            }

            <!-- Hero Section (Critical - Above-the-fold) -->
            @if (Model.Hero != null)
            {
                <section class="hero-section" aria-label="اسلایدر صفحه اصلی">
                    @{
                        Html.RenderPartial("Sections/_HeroSection", Model.Hero);
                    }
                </section>
            }

            <!-- Value Proposition Section (Critical - Above-the-fold) -->
            @if (Model.ValueProposition != null)
            {
                <section class="value-proposition-section" aria-label="ویژگی‌های کلینیک">
                    @{
                        Html.RenderPartial("Sections/_ValuePropositionSection", Model.ValueProposition);
                    }
                </section>
            }

            <!-- Services Section - Lazy Load -->
            @if (Model.Services != null && Model.Services.Services != null && Model.Services.Services.Any())
            {
                <section class="services-section" data-lazy-load="true" data-section-type="services" data-section-id="services" aria-label="@Model.Services.SectionTitle">
                    @{
                        Html.RenderPartial("Sections/_ServicesSection", Model.Services);
                    }
                </section>
            }

            <!-- Medical Services Info Section - Lazy Load -->
            @if (Model.MedicalServiceInfos != null && Model.MedicalServiceInfos.Any())
            {
                <section class="medical-services-section" data-lazy-load="true" data-section-type="medical-services" data-section-id="medical-services" aria-label="خدمات پزشکی">
                    @{
                        Html.RenderPartial("Sections/_MedicalServicesSection", Model.MedicalServiceInfos);
                    }
                </section>
            }

            <!-- Medical Equipment Section - Lazy Load -->
            @if (Model.MedicalEquipments != null && Model.MedicalEquipments.Any())
            {
                <section class="medical-equipment-section" data-lazy-load="true" data-section-type="medical-equipment" data-section-id="medical-equipment" aria-label="تجهیزات پزشکی">
                    @{
                        Html.RenderPartial("Sections/_MedicalEquipmentSection", Model);
                    }
                </section>
            }

            <!-- Insurance Info Section - Lazy Load -->
            @if (Model.InsuranceInfos != null && Model.InsuranceInfos.Any())
            {
                <section class="insurance-carousel-section" data-lazy-load="true" data-section-type="insurance" data-section-id="insurance" aria-label="بیمه‌های طرف قرارداد">
                    @{
                        Html.RenderPartial("Sections/_InsuranceInfoSection", Model.InsuranceInfos);
                    }
                </section>
            }

            <!-- Doctors Section - Lazy Load -->
            @if (Model.Doctors != null && Model.Doctors.Doctors != null && Model.Doctors.Doctors.Any())
            {
                <section class="doctors-section" data-lazy-load="true" data-section-type="doctors" data-section-id="doctors" aria-label="پزشکان کلینیک">
                    @{
                        Html.RenderPartial("Sections/_DoctorsSection", Model.Doctors);
                    }
                </section>
            }

            <!-- Quick Appointment Section (Critical - Above-the-fold) -->
            @if (Model.QuickAppointment != null)
            {
                <section class="quick-appointment-section" aria-label="رزرو نوبت سریع">
                    @{
                        Html.RenderPartial("Sections/_QuickAppointmentSection", Model.QuickAppointment);
                    }
                </section>
            }

            <!-- پربازدیدترین تخصص‌ها (مشابه دکترتو) -->
            @if (Model.PopularSpecialties != null && Model.PopularSpecialties.Items != null && Model.PopularSpecialties.Items.Any())
            {
                <section class="popular-specialties-section" data-lazy-load="true" data-section-type="popular-specialties" data-section-id="popular-specialties" aria-labelledby="popular-specialties-heading">
                    @{
                        Html.RenderPartial("Sections/_PopularSpecialtiesSection", Model.PopularSpecialties);
                    }
                </section>
            }

            <!-- Testimonials Section - Lazy Load -->
            @if (Model.Testimonials != null && Model.Testimonials.Testimonials != null && Model.Testimonials.Testimonials.Any())
            {
                <section class="testimonials-section" data-lazy-load="true" data-section-type="testimonials" data-section-id="testimonials" aria-label="نظرات بیماران">
                    @{
                        Html.RenderPartial("Sections/_TestimonialsSection", Model.Testimonials);
                    }
                </section>
            }

            <!-- Gallery Section - Lazy Load -->
            @if (Model.Gallery != null && Model.Gallery.Items != null && Model.Gallery.Items.Any())
            {
                <section class="gallery-section" data-lazy-load="true" data-section-type="gallery" data-section-id="gallery" aria-label="گالری تصاویر">
                    @{
                        Html.RenderPartial("Sections/_GallerySection", Model.Gallery);
                    }
                </section>
            }

            <!-- Blog Section - Lazy Load -->
            @if (Model.Blog != null && Model.Blog.Posts != null && Model.Blog.Posts.Any())
            {
                <section class="blog-section magazine-blog-section" data-lazy-load="true" data-section-type="blog" data-section-id="blog" aria-labelledby="blog-section-heading">
                    @{
                        Html.RenderPartial("Sections/_BlogSection", Model.Blog);
                    }
                </section>
            }

            <!-- Health Tips Section - Lazy Load -->
            @if (Model.HealthTips != null && Model.HealthTips.Any())
            {
                <section class="health-tips-section" data-lazy-load="true" data-section-type="health-tips" data-section-id="health-tips" aria-label="نکات سلامت">
                    @{
                        Html.RenderPartial("Sections/_HealthTipsSection", Model.HealthTips);
                    }
                </section>
            }

            <!-- Video Section - Lazy Load -->
            @if (Model.Videos != null)
            {
                <section class="video-section" data-lazy-load="true" data-section-type="video" data-section-id="video" aria-label="ویدئوها">
                    @{
                        Html.RenderPartial("Sections/_VideoSection", Model.Videos);
                    }
                </section>
            }

            <!-- Stories فقط در Layout (زیر ناوبری) نمایش داده می‌شود؛ در انتهای صفحه تکرار نمی‌شود. -->

            <!-- FAQ Section - Lazy Load -->
            @if (Model.FAQs != null && Model.FAQs.Any())
            {
                <section class="faq-section" data-lazy-load="true" data-section-type="faq" data-section-id="faq" aria-label="سوالات متداول">
                    @{
                        Html.RenderPartial("Sections/_FAQSection", Model.FAQs);
                    }
                </section>
            }

            @* تماس با ما: اطلاعات کامل در فوتر و صفحهٔ اختصاصی «تماس با ما» است (الگوی دیجی‌کالا / پروداکشن). سکشن تکراری حذف شد؛ فقط CTA برای هدایت به صفحه تماس. *@
            <section class="contact-cta-section" aria-label="دعوت به تماس">
                <div class="contact-cta-inner">
                    <p class="contact-cta-text">سوال یا پیشنهادی دارید؟ اطلاعات تماس و فرم پیام در صفحهٔ تماس با ما در دسترس است.</p>
                    <a href="@Url.Action("Index", "Contact")" class="contact-cta-button" aria-label="رفتن به صفحه تماس با ما">
                        <i class="fas fa-envelope" aria-hidden="true"></i>
                        <span>تماس با ما</span>
                    </a>
                </div>
            </section>

        </main>

        @* سایدبار از صفحهٔ اصلی حذف شده است (طبق Docs/HOMEPAGE-SIDEBAR-DECISION.md) برای خوانایی بیشتر و هماهنگی با بهترین روش‌های سایت‌های مرجع. رزرو نوبت در منو و هیرو؛ تماس و ساعات در فوتر. *@
        @* در صورت نیاز می‌توان سایدبار را در صفحات دیگر (مثلاً تماس با ما) با RenderPartial("Sections/_SidebarSection", ...) نمایش داد. *@
    </div>

    @* سکشن اسلایدر فوتر (بالای فوتر) حذف شد — تکراری؛ فوتر سایت بلافاصله پس از محتوای اصلی نمایش داده می‌شود. *@

    @section Styles {
        @* CSS برای main-menu-quick-actions حذف شد - بخش "دسترسی سریع" حذف شده است (چون sidebar navigation دارد) *@
        <link rel="stylesheet" href="@Url.Content("~/Content/css/homepage-layout.css")" />
        <link rel="stylesheet" href="@Url.Content("~/Content/css/homepage-sections-spacing.css")" />
        <link rel="stylesheet" href="@Url.Content("~/Content/css/section-states.css")" />
        <link rel="stylesheet" href="@Url.Content("~/Content/css/section-header.css")" />
        @* CSS Bundle برای تمام Section ها - بهینه‌سازی Performance (کاهش HTTP Requests از 11+ به 1) *@
        @Styles.Render("~/Content/css/homepage-sections")
    }

    @section Scripts {
        <script src="@Url.Content("~/Content/js/faq-accordion.js")?v=@System.Configuration.ConfigurationManager.AppSettings["AppVersion"]"></script>
        <script src="@Url.Content("~/Content/js/homepage-animations.js")"></script>
        <script src="@Url.Content("~/Content/js/homepage-lazy-load.js")"></script>
        <script src="@Url.Content("~/Content/js/homepage-section-manager.js")"></script>
    }

</div>
