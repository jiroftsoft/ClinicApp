@model ClinicApp.ViewModels.HomePageViewModel
@{
    ViewBag.Title = "خانه";
}

<main class="animate-section" id="mainContent">
    <!-- Announcements Section (Important Announcements) -->
    @if (Model.Announcements != null && Model.Announcements.Any())
    {
        @Html.Partial("~/Views/Home/Sections/_AnnouncementsSection.cshtml", Model.Announcements)
    }
    
    <!-- Hero Section -->
    @if (Model.Hero != null)
    {
        @Html.Partial("~/Views/Home/Sections/_HeroSection.cshtml", Model.Hero)
    }
    
    <!-- Value Proposition Section -->
    @if (Model.ValueProposition != null)
    {
        @Html.Partial("~/Views/Home/Sections/_ValuePropositionSection.cshtml", Model.ValueProposition)
    }
    
    <!-- Services Section -->
    @if (Model.Services != null)
    {
        @Html.Partial("~/Views/Home/Sections/_ServicesSection.cshtml", Model.Services)
    }
    
    <!-- Medical Services Info Section -->
    @if (Model.MedicalServiceInfos != null && Model.MedicalServiceInfos.Any())
    {
        @Html.Partial("~/Views/Home/Sections/_MedicalServicesSection.cshtml", Model.MedicalServiceInfos)
    }
    
    <!-- Doctors Section -->
    @if (Model.Doctors != null)
    {
        @Html.Partial("~/Views/Home/Sections/_DoctorsSection.cshtml", Model.Doctors)
    }
    
    <!-- Quick Appointment Section -->
    @if (Model.QuickAppointment != null)
    {
        @Html.Partial("~/Views/Home/Sections/_QuickAppointmentSection.cshtml", Model.QuickAppointment)
    }
    
    <!-- Testimonials Section -->
    @if (Model.Testimonials != null)
    {
        @Html.Partial("~/Views/Home/Sections/_TestimonialsSection.cshtml", Model.Testimonials)
    }
    
    <!-- Gallery Section -->
    @if (Model.Gallery != null)
    {
        @Html.Partial("~/Views/Home/Sections/_GallerySection.cshtml", Model.Gallery)
    }
    
    <!-- Blog Section -->
    @if (Model.Blog != null)
    {
        @Html.Partial("~/Views/Home/Sections/_BlogSection.cshtml", Model.Blog)
    }
    
    <!-- Video Section -->
    @if (Model.Videos != null)
    {
        @Html.Partial("~/Views/Home/Sections/_VideoSection.cshtml", Model.Videos)
    }
    
    <!-- Health Tips Section -->
    @if (Model.HealthTips != null && Model.HealthTips.Any())
    {
        @Html.Partial("~/Views/Home/Sections/_HealthTipsSection.cshtml", Model.HealthTips)
    }
    
    <!-- Insurance Info Section -->
    @if (Model.InsuranceInfos != null && Model.InsuranceInfos.Any())
    {
        @Html.Partial("~/Views/Home/Sections/_InsuranceInfoSection.cshtml", Model.InsuranceInfos)
    }
    
    <!-- FAQ Section -->
    @if (Model.FAQs != null && Model.FAQs.Any())
    {
        @Html.Partial("~/Views/Home/Sections/_FAQSection.cshtml", Model.FAQs)
    }
    
    <!-- Emergency Contacts Section -->
    @if (Model.EmergencyContacts != null && Model.EmergencyContacts.Any())
    {
        @Html.Partial("~/Views/Home/Sections/_EmergencyContactsSection.cshtml", Model.EmergencyContacts)
    }
    
    <!-- Medical Equipment Section -->
    @if (Model.MedicalEquipments != null && Model.MedicalEquipments.Any())
    {
        @Html.Partial("~/Views/Home/Sections/_MedicalEquipmentSection.cshtml", Model)
    }
    
    <!-- Contact Section -->
    @if (Model.Contact != null)
    {
        @Html.Partial("~/Views/Home/Sections/_ContactSection.cshtml", Model.Contact)
    }
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // فعال کردن انیمیشن‌ها برای بخش اصلی
            const mainContent = document.getElementById('mainContent');
            if (mainContent) {
                setTimeout(() => {
                    mainContent.style.opacity = '1';
                    mainContent.style.transform = 'translateY(0)';
                }, 200);
            }

            // اضافه کردن انیمیشن به بخش‌های مختلف هنگام اسکرول
            const animatedSections = document.querySelectorAll('.animate-section');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('animated');
                    }
                });
            }, {
                threshold: 0.1
            });

            animatedSections.forEach(section => {
                observer.observe(section);
            });
        });
    </script>
}
