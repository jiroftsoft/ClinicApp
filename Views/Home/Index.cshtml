@model ClinicApp.ViewModels.HomePageViewModel
@{
    ViewBag.Title = "خانه";
}

<main class="animate-section" id="mainContent">
    <!-- Announcements Section (Important Announcements) -->
    @Html.Action("AnnouncementsSection", "Home")
    
    <!-- Hero Section -->
    @Html.Action("HeroSection", "Home")
    
    <!-- Value Proposition Section -->
    @Html.Action("ValuePropositionSection", "Home")
    
    <!-- Services Section -->
    @Html.Action("ServicesSection", "Home")
    
    <!-- Medical Services Info Section -->
    @Html.Action("MedicalServicesSection", "Home")
    
    <!-- Doctors Section -->
    @Html.Action("DoctorsSection", "Home")
    
    <!-- Quick Appointment Section -->
    @Html.Action("QuickAppointmentSection", "Home")
    
    <!-- Testimonials Section -->
    @Html.Action("TestimonialsSection", "Home")
    
    <!-- Gallery Section -->
    @Html.Action("GallerySection", "Home")
    
    <!-- Blog Section -->
    @Html.Action("BlogSection", "Home")
    
    <!-- Health Tips Section -->
    @Html.Action("HealthTipsSection", "Home")
    
    <!-- Insurance Info Section -->
    @Html.Action("InsuranceInfoSection", "Home")
    
    <!-- FAQ Section -->
    @Html.Action("FAQSection", "Home")
    
    <!-- Emergency Contacts Section -->
    @Html.Action("EmergencyContactsSection", "Home")
    
    <!-- Medical Equipment Section -->
    @Html.Action("MedicalEquipmentSection", "Home")
    
    <!-- Contact Section -->
    @Html.Action("ContactSection", "Home")
</main>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // فعال کردن انیمیشن‌ها برای بخش اصلی
            const mainContent = document.getElementById('mainContent');
            if (mainContent) {
                setTimeout(() => {
                    mainContent.style.opacity = '1';
                    mainContent.style.transform = 'translateY(0)';
                }, 200);
            }

            // اضافه کردن انیمیشن به بخش‌های مختلف هنگام اسکرول
            const animatedSections = document.querySelectorAll('.animate-section');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('animated');
                    }
                });
            }, {
                threshold: 0.1
            });

            animatedSections.forEach(section => {
                observer.observe(section);
            });
        });
    </script>
}
