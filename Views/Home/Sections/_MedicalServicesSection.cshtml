@model List<ClinicApp.ViewModels.CMS.MedicalServiceInfoPublicViewModel>
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
}

<section class="medical-services-section py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="section-title text-white mb-3">
                    <i class="fas fa-stethoscope"></i>
                    خدمات پزشکی ما
                </h2>
                <p class="section-subtitle text-white-50">خدمات تخصصی و حرفه‌ای برای سلامت شما</p>
            </div>
        </div>

        <div class="row">
            @foreach (var service in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card medical-service-card h-100 shadow-lg border-0">
                        @if (!string.IsNullOrEmpty(service.ThumbnailUrl))
                        {
                            <img src="@service.ThumbnailUrl" class="card-img-top" alt="@service.ServiceTitle" style="height: 200px; object-fit: cover;">
                        }
                        else if (!string.IsNullOrEmpty(service.ImageUrl))
                        {
                            <img src="@service.ImageUrl" class="card-img-top" alt="@service.ServiceTitle" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-gradient-primary d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="fas fa-stethoscope fa-3x text-white"></i>
                            </div>
                        }
                        
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                <span class="badge badge-primary">
                                    <i class="fas fa-tag"></i>
                                    @service.ServiceCategoryName
                                </span>
                            </div>
                            
                            <h5 class="card-title font-weight-bold">@service.ServiceTitle</h5>
                            
                            @if (!string.IsNullOrEmpty(service.Description))
                            {
                                <p class="card-text text-muted flex-grow-1">@(service.Description.Length > 120 ? service.Description.Substring(0, 120) + "..." : service.Description)</p>
                            }
                            
                            @if (service.Features != null && service.Features.Any())
                            {
                                <div class="mb-3">
                                    <small class="text-muted">
                                        <i class="fas fa-check-circle text-success"></i>
                                        @string.Join(", ", service.Features.Take(2))
                                    </small>
                                </div>
                            }
                            
                            <div class="mt-auto pt-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    @if (service.Price.HasValue)
                                    {
                                        <span class="badge badge-success">
                                            <i class="fas fa-money-bill-wave"></i>
                                            @(service.Price.Value.ToString("N0")) ریال
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(service.EstimatedDuration))
                                    {
                                        <small class="text-muted">
                                            <i class="fas fa-clock"></i> @service.EstimatedDuration
                                        </small>
                                    }
                                </div>
                                
                                <a href="@Url.Action("Details", "MedicalServiceInfo", new { slug = service.Slug })" class="btn btn-primary btn-block">
                                    <i class="fas fa-arrow-left"></i> اطلاعات بیشتر
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row mt-4">
            <div class="col-12 text-center">
                <a href="@Url.Action("Index", "MedicalServiceInfo")" class="btn btn-light btn-lg">
                    <i class="fas fa-list"></i> مشاهده همه خدمات
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .medical-services-section {
        position: relative;
        overflow: hidden;
    }

    .medical-service-card {
        border-radius: 15px;
        transition: all 0.3s ease;
        overflow: hidden;
    }

    .medical-service-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.3) !important;
    }

    .medical-service-card .card-img-top {
        transition: transform 0.3s ease;
    }

    .medical-service-card:hover .card-img-top {
        transform: scale(1.1);
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 700;
    }

    .section-subtitle {
        font-size: 1.1rem;
    }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    @@media (max-width: 768px) {
        .section-title {
            font-size: 2rem;
        }
    }
</style>

