@model ClinicApp.ViewModels.GallerySectionViewModel

@if (Model.Items != null && Model.Items.Any())
{
    <section class="gallery-section mb-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="h1" style="color: var(--primary-color); font-weight: 700;">@Model.SectionTitle</h2>
                <p class="lead text-muted" style="max-width: 700px; margin: 1rem auto;">
                    @Model.SectionSubtitle
                </p>
            </div>

            <div class="row">
                @foreach (var item in Model.Items)
                {
                    <div class="col-md-4 col-lg-3 mb-4">
                        <div class="card gallery-item h-100" style="border-radius: 16px; overflow: hidden; cursor: pointer;">
                            <img src="@item.ImageUrl" 
                                 class="card-img-top w-100" 
                                 alt="@item.Title"
                                 style="height: 200px; object-fit: cover; transition: transform 0.5s ease;"
                                 onerror="this.src='/Content/Images/default-gallery.jpg'">
                            @if (!string.IsNullOrEmpty(item.Title))
                            {
                                <div class="card-body p-3">
                                    <h5 class="card-title mb-0">@item.Title</h5>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

