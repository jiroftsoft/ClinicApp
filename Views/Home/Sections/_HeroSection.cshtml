@model ClinicApp.ViewModels.HeroSectionViewModel
@using System.Web

@* ============================================
   Hero Section - Production Ready
   ============================================
   - SRP: هر بخش مسئولیت مشخص دارد
   - Error Handling: مدیریت خطاها
   - Logging: لاگ‌های کامل برای Debug
   - Performance: بهینه‌سازی برای Production
   ============================================ *@

@{
    // ============================================
    // INITIALIZATION & VALIDATION
    // ============================================
    var hasModel = Model != null;
    var hasSlides = hasModel && Model.Slides != null && Model.Slides.Any();
    var validSlides = new List<ClinicApp.ViewModels.HeroSlideViewModel>();
    
    // Console Logging برای Debug
    <script>
        console.group('🔍 Hero Section - Initialization');
        console.log('Model is null:', @(hasModel ? "false" : "true"));
        console.log('Has Slides:', @(hasSlides ? "true" : "false"));
        
        @if (hasModel)
        {
            <text>
            console.log('Model.Slides count:', @(Model.Slides?.Count ?? 0));
            </text>
        }
    </script>
    
    if (hasSlides)
    {
        // فیلتر کردن اسلایدهای معتبر (فقط اسلایدهایی که تصویر دارند)
        validSlides = Model.Slides
            .Where(s => !string.IsNullOrWhiteSpace(s.ImageUrl) || !string.IsNullOrWhiteSpace(s.ThumbnailUrl))
            .ToList();
            
        <script>
            console.log('Valid Slides Count:', @validSlides.Count);
            @for (int i = 0; i < validSlides.Count && i < 5; i++)
            {
                var slide = validSlides[i];
                <text>
                console.log('Slide @(i + 1):', {
                    id: @slide.SliderId,
                    title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(slide.Title ?? ""))',
                    imageUrl: '@Html.Raw(HttpUtility.JavaScriptStringEncode(slide.ImageUrl ?? ""))',
                    thumbnailUrl: '@Html.Raw(HttpUtility.JavaScriptStringEncode(slide.ThumbnailUrl ?? ""))'
                });
                </text>
            }
        </script>
    }
    
    <script>
        console.log('Will Render Hero Section:', @(validSlides.Any() ? "true" : "false"));
        console.groupEnd();
    </script>
}

@* ============================================
   RENDERING LOGIC
   ============================================ *@
@if (!hasModel)
{
    @* Model null است - چیزی نمایش نمی‌دهیم *@
    <script>
        console.warn('⚠️ Hero Section: Model is null - Skipping render');
    </script>
}
else if (!validSlides.Any())
{
    @* هیچ اسلاید معتبری وجود ندارد *@
    <script>
        console.warn('⚠️ Hero Section: No valid slides found - Skipping render');
        @if (hasSlides)
        {
            <text>
            console.warn('⚠️ Hero Section: Total slides:', @Model.Slides.Count, 'but none have valid images');
            </text>
        }
    </script>
}
else
{
    @* ============================================
       STYLES LOADING
       ============================================ *@
    <link rel="stylesheet" href="@Url.Content("~/Content/css/hero-section.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/css/hero-carousel.css")" />
    
    <script>
        console.log('✅ Hero Section: Loading stylesheets');
    </script>
    
    @* ============================================
       CAROUSEL vs SINGLE SLIDE
       ============================================ *@
    if (validSlides.Count > 1)
    {
        @* ============================================
           MULTIPLE SLIDES - CAROUSEL
           ============================================ *@
        <script>
            console.log('🎠 Hero Section: Rendering Carousel with', @validSlides.Count, 'slides');
        </script>
        
        <div id="heroCarousel" 
             class="hero-carousel" 
             role="region" 
             aria-label="اسلایدر صفحه اصلی"
             data-slides-count="@validSlides.Count">
            <div class="carousel-inner">
                @for (int i = 0; i < validSlides.Count; i++)
                {
                    var slide = validSlides[i];
                    var imageUrl = !string.IsNullOrWhiteSpace(slide.ImageUrl) 
                        ? slide.ImageUrl 
                        : slide.ThumbnailUrl;
                    
                    // نرمال‌سازی مسیر تصویر
                    if (!string.IsNullOrWhiteSpace(imageUrl))
                    {
                        if (imageUrl.StartsWith("~/", StringComparison.OrdinalIgnoreCase))
                        {
                            imageUrl = imageUrl.Substring(1);
                        }
                        if (!imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) && 
                            !imageUrl.StartsWith("/", StringComparison.OrdinalIgnoreCase))
                        {
                            imageUrl = "/" + imageUrl.TrimStart('/', '\\');
                        }
                        imageUrl = imageUrl.Trim();
                    }
                    
                    <div class="carousel-item @(i == 0 ? "active" : "")" 
                         role="group" 
                         aria-roledescription="slide" 
                         aria-label="اسلاید @(i + 1) از @validSlides.Count"
                         data-slide-index="@i"
                         data-slide-id="@slide.SliderId">
                        <div class="hero-slide" 
                             style="background-image: url('@imageUrl'); background-size: cover; background-position: center; background-repeat: no-repeat;" 
                             data-image-url="@imageUrl"
                             data-slide-index="@i">
                            <div class="hero-slide-content">
                                @if (!string.IsNullOrEmpty(slide.Title))
                                {
                                    <h1 class="hero-slide-title">@slide.Title</h1>
                                }
                                @if (!string.IsNullOrEmpty(slide.Description))
                                {
                                    <p class="hero-slide-description">@slide.Description</p>
                                }
                                @if (!string.IsNullOrEmpty(slide.LinkUrl))
                                {
                                    <div class="hero-slide-buttons">
                                        <a href="@slide.LinkUrl" 
                                           class="hero-slide-button hero-slide-button-primary"
                                           aria-label="مشاهده بیشتر درباره @slide.Title">
                                            <i class="fas fa-arrow-left"></i>
                                            <span>@(slide.ButtonText ?? "مشاهده بیشتر")</span>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <script>
                        console.log('✅ Slide @(i + 1) rendered:', {
                            id: @slide.SliderId,
                            title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(slide.Title ?? ""))',
                            imageUrl: '@Html.Raw(HttpUtility.JavaScriptStringEncode(imageUrl ?? ""))',
                            isActive: @(i == 0 ? "true" : "false"),
                            computedStyle: 'url(\'@Html.Raw(HttpUtility.JavaScriptStringEncode(imageUrl ?? ""))\')'
                        });
                        
                        // Verify image exists
                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                        {
                            <text>
                            (function() {
                                var img = new Image();
                                img.onload = function() {
                                    console.log('✅ Image @(i + 1) loaded successfully:', '@Html.Raw(HttpUtility.JavaScriptStringEncode(imageUrl ?? ""))');
                                };
                                img.onerror = function() {
                                    console.error('❌ Image @(i + 1) FAILED to load:', '@Html.Raw(HttpUtility.JavaScriptStringEncode(imageUrl ?? ""))');
                                };
                                img.src = '@Html.Raw(HttpUtility.JavaScriptStringEncode(imageUrl ?? ""))';
                            })();
                            </text>
                        }
                    </script>
                }
            </div>
            
            @* Carousel Controls *@
            <button class="hero-carousel-controls prev" 
                    type="button" 
                    aria-label="اسلاید قبلی"
                    aria-controls="heroCarousel"
                    data-action="prev">
                <i class="fas fa-chevron-right" aria-hidden="true"></i>
            </button>
            <button class="hero-carousel-controls next" 
                    type="button" 
                    aria-label="اسلاید بعدی"
                    aria-controls="heroCarousel"
                    data-action="next">
                <i class="fas fa-chevron-left" aria-hidden="true"></i>
            </button>
            
            @* Carousel Indicators *@
            <ol class="hero-carousel-indicators" role="tablist">
                @for (int i = 0; i < validSlides.Count; i++)
                {
                    <li class="hero-carousel-indicator @(i == 0 ? "active" : "")" 
                        role="tab" 
                        aria-label="اسلاید @(i + 1)"
                        data-slide-to="@i"
                        aria-selected="@(i == 0 ? "true" : "false")"
                        tabindex="@(i == 0 ? "0" : "-1")"></li>
                }
            </ol>
        </div>
        
        <script>
            console.log('✅ Hero Carousel: HTML structure rendered');
            console.log('✅ Hero Carousel: Controls and indicators added');
        </script>
        
        @* Load Carousel Script Immediately - Inline for immediate execution *@
        <script>
            console.log('📜 Hero Section: Loading carousel script immediately');
        </script>
        <script src="@Url.Content("~/Content/js/hero-carousel.js")?v=@System.Configuration.ConfigurationManager.AppSettings["AppVersion"]"></script>
        <script>
            console.log('✅ Hero Section: Carousel script loaded');
            
            // Immediate verification and manual init if needed
            (function() {
                var checkCount = 0;
                var maxChecks = 10;
                
                function checkCarousel() {
                    checkCount++;
                    console.log('[Hero Carousel] Check attempt', checkCount);
                    
                    if (typeof window.HeroCarousel !== 'undefined') {
                        console.log('✅ Hero Carousel API available');
                        console.log('Current slide:', window.HeroCarousel.getCurrentIndex() + 1, 'of', window.HeroCarousel.getTotalSlides());
                        return;
                    }
                    
                    if (typeof window.initHeroCarousel === 'function') {
                        console.log('[Hero Carousel] Manual initialization available');
                        // Try manual init after a short delay
                        setTimeout(function() {
                            window.initHeroCarousel();
                        }, 500);
                        return;
                    }
                    
                    if (checkCount < maxChecks) {
                        setTimeout(checkCarousel, 200);
                    } else {
                        console.error('❌ Hero Carousel: Failed to initialize after', maxChecks, 'attempts');
                    }
                }
                
                // Start checking
                setTimeout(checkCarousel, 100);
            })();
        </script>
    }
    else
    {
        @* ============================================
           SINGLE SLIDE
           ============================================ *@
        var slide = validSlides.FirstOrDefault();
        var singleImageUrl = slide?.ImageUrl;
        
        if (string.IsNullOrWhiteSpace(singleImageUrl))
        {
            singleImageUrl = slide?.ThumbnailUrl;
        }
        
        // نرمال‌سازی مسیر تصویر
        if (!string.IsNullOrWhiteSpace(singleImageUrl))
        {
            if (singleImageUrl.StartsWith("~/", StringComparison.OrdinalIgnoreCase))
            {
                singleImageUrl = singleImageUrl.Substring(1);
            }
            if (!singleImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) && 
                !singleImageUrl.StartsWith("/", StringComparison.OrdinalIgnoreCase))
            {
                singleImageUrl = "/" + singleImageUrl.TrimStart('/', '\\');
            }
            singleImageUrl = singleImageUrl.Trim();
        }
        
        <script>
            console.log('📄 Hero Section: Rendering Single Slide');
            console.log('Single Slide Data:', {
                id: @(slide?.SliderId ?? 0),
                title: '@Html.Raw(HttpUtility.JavaScriptStringEncode(slide?.Title ?? ""))',
                imageUrl: '@Html.Raw(HttpUtility.JavaScriptStringEncode(singleImageUrl ?? ""))'
            });
        </script>
        
        if (slide != null && !string.IsNullOrWhiteSpace(singleImageUrl))
        {
            <section class="hero-section animate-fade-in" 
                     role="banner" 
                     aria-label="بخش اصلی صفحه">
                @if (!string.IsNullOrWhiteSpace(singleImageUrl))
                {
                    <div class="background-overlay" 
                         style="background-image: url('@singleImageUrl');"
                         data-image-url="@singleImageUrl"></div>
                }
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-10">
                            @if (!string.IsNullOrEmpty(slide.Title))
                            {
                                <h1 class="hero-title">@slide.Title</h1>
                            }
                            @if (!string.IsNullOrEmpty(slide.Description))
                            {
                                <p class="hero-subtitle">@slide.Description</p>
                            }
                            <div class="d-flex flex-wrap justify-content-center gap-3 hero-buttons">
                                @if (!string.IsNullOrEmpty(slide.LinkUrl))
                                {
                                    <a href="@slide.LinkUrl" 
                                       class="btn btn-medical-primary animate-scale-in"
                                       aria-label="مشاهده بیشتر درباره @slide.Title">
                                        <i class="fas fa-calendar-check me-2"></i> 
                                        @(slide.ButtonText ?? "مشاهده بیشتر")
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(Model.SecondaryButtonUrl))
                                {
                                    <a href="@Model.SecondaryButtonUrl" 
                                       class="btn btn-medical-outline-primary animate-scale-in"
                                       aria-label="@Model.SecondaryButtonText">
                                        <i class="fas fa-video me-2"></i> 
                                        @Model.SecondaryButtonText
                                    </a>
                                }
                            </div>
                            @if (Model.Statistics != null && Model.Statistics.Any())
                            {
                                <div class="mt-4 hero-stats" role="list" aria-label="آمار کلینیک">
                                    @foreach (var stat in Model.Statistics)
                                    {
                                        <div class="d-flex align-items-center stat-item" role="listitem">
                                            <i class="@stat.Icon me-2" aria-hidden="true"></i>
                                            <span>@stat.Value @stat.Label</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>
            
            <script>
                console.log('✅ Hero Section: Single slide rendered successfully');
            </script>
        }
        else
        {
            <script>
                console.error('❌ Hero Section: Single slide data is invalid', {
                    slide: @(slide != null ? "exists" : "null"),
                    imageUrl: '@Html.Raw(HttpUtility.JavaScriptStringEncode(singleImageUrl ?? ""))'
                });
            </script>
        }
    }
    
    <script>
        console.log('✅ Hero Section: Rendering completed');
    </script>
}

@* ============================================
   SCRIPTS LOADING - Additional verification
   ============================================ *@
@section scripts {
    @* Additional debug scripts if needed *@
    @if (validSlides.Count > 1)
    {
        <script>
            // Verify carousel is initialized after a delay
            setTimeout(function() {
                console.log('[Hero Carousel] 🔍 Verification check...');
                if (typeof window.HeroCarousel !== 'undefined') {
                    console.log('✅ Hero Carousel: Verified initialized');
                    console.log('Current slide:', window.HeroCarousel.getCurrentIndex() + 1, 'of', window.HeroCarousel.getTotalSlides());
                } else {
                    console.warn('⚠️ Hero Carousel: Not initialized - attempting manual init');
                    if (typeof window.initHeroCarousel === 'function') {
                        window.initHeroCarousel();
                    } else {
                        console.error('❌ Hero Carousel: initHeroCarousel function not found');
                    }
                }
            }, 3000);
        </script>
    }
}

