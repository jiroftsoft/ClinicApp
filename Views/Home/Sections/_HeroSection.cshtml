@model ClinicApp.ViewModels.HeroSectionViewModel

<section class="hero-section text-center py-5 mb-5" style="background: linear-gradient(135deg, #f0f7ff, #e6f3ff); border-radius: 20px; overflow: hidden; position: relative; margin-bottom: 3.5rem !important;">
    @if (!string.IsNullOrEmpty(Model.BackgroundImageUrl))
    {
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: url('@Model.BackgroundImageUrl') center/cover; opacity: 0.1;"></div>
    }
    <div class="container" style="position: relative; z-index: 2;">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <h1 class="hero-title" style="color: var(--primary-color); font-weight: 700; font-size: 2.8rem; margin-bottom: 1.2rem;">
                    @Model.Title
                </h1>
                <p class="lead hero-subtitle" style="font-size: 1.35rem; color: var(--dark-color); max-width: 800px; margin: 0 auto 1.8rem; line-height: 1.7;">
                    @Model.Subtitle
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-3 hero-buttons">
                    @if (!string.IsNullOrEmpty(Model.PrimaryButtonUrl))
                    {
                        <a href="@Model.PrimaryButtonUrl" class="btn btn-primary btn-lg px-5 py-3">
                            <i class="fas fa-calendar-check me-2"></i> @Model.PrimaryButtonText
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(Model.SecondaryButtonUrl))
                    {
                        <a href="@Model.SecondaryButtonUrl" class="btn btn-outline-primary btn-lg px-5 py-3">
                            <i class="fas fa-video me-2"></i> @Model.SecondaryButtonText
                        </a>
                    }
                </div>
                @if (Model.Statistics != null && Model.Statistics.Any())
                {
                    <div class="mt-4 hero-stats" style="display: flex; justify-content: center; gap: 25px; flex-wrap: wrap;">
                        @foreach (var stat in Model.Statistics)
                        {
                            <div class="d-flex align-items-center">
                                <i class="@stat.Icon text-success me-2" style="font-size: 1.4rem;"></i>
                                <span style="font-weight: 500;">@stat.Value @stat.Label</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

