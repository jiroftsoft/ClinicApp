@model ClinicApp.ViewModels.DoctorsSectionViewModel

<section class="doctors-section mb-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="h1" style="color: var(--primary-color); font-weight: 700;">@Model.SectionTitle</h2>
            <p class="lead text-muted" style="max-width: 700px; margin: 1rem auto;">
                @Model.SectionSubtitle
            </p>
        </div>

        <div class="row">
            @if (Model.Doctors != null && Model.Doctors.Any())
            {
                foreach (var doctor in Model.Doctors)
                {
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card hover-scale h-100" style="border-radius: 16px; overflow: hidden; transition: all 0.4s ease;">
                            <div style="height: 220px; overflow: hidden;">
                                <img src="@doctor.PhotoUrl" 
                                     class="card-img-top w-100 h-100" 
                                     alt="@doctor.FullName - @doctor.Specialization"
                                     style="object-fit: cover; transition: transform 0.5s ease;"
                                     onerror="this.src='/Content/Images/default-doctor.jpg'">
                            </div>
                            <div class="card-body text-center p-4">
                                <h3 class="h5 mb-1" style="color: var(--primary-color);">@doctor.FullName</h3>
                                <p class="text-muted mb-3">@doctor.Specialization</p>
                                @if (doctor.Rating.HasValue)
                                {
                                    <div class="d-flex justify-content-center mb-3">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Floor(doctor.Rating.Value))
                                            {
                                                <i class="fas fa-star text-warning"></i>
                                            }
                                            else if (i - 0.5 <= (double)doctor.Rating.Value)
                                            {
                                                <i class="fas fa-star-half-alt text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star text-warning"></i>
                                            }
                                        }
                                    </div>
                                }
                                <p class="text-muted mb-4" style="min-height: 60px; display: flex; align-items: center; justify-content: center;">
                                    @doctor.Bio
                                </p>
                                <a href="@doctor.ProfileUrl" class="btn btn-outline-primary w-100 py-2">
                                    مشاهده پروفایل <i class="fas fa-arrow-left me-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.ViewAllDoctorsUrl))
        {
            <div class="text-center mt-4">
                <a href="@Model.ViewAllDoctorsUrl" class="btn btn-primary btn-lg px-5 py-3">
                    <i class="fas fa-user-md me-2"></i> مشاهده تمامی پزشکان
                </a>
            </div>
        }
    </div>
</section>

