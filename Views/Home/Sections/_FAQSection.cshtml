@model List<ClinicApp.ViewModels.CMS.FAQPublicViewModel>
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
}

@* CSS از باندل homepage-sections لود می‌شود *@
<section class="faq-section animate-fade-in" aria-label="سوالات متداول">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">
                <i class="fas fa-question-circle"></i>
                سوالات متداول
            </h2>
            <p class="section-subtitle">پاسخ به سوالات رایج شما</p>
        </div>

        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="accordion" id="faqAccordion" role="tablist" aria-multiselectable="true">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var faq = Model[i];
                        var collapseId = $"faqCollapse{i}";
                        var headingId = $"faqHeading{i}";
                        
                        <div class="faq-card animate-in" style="animation-delay: @(0.1 * i)s;">
                            <div class="card-header" id="@headingId" role="tab">
                                <button class="btn-link" 
                                        type="button" 
                                        data-toggle="collapse" 
                                        data-target="#@collapseId" 
                                        aria-expanded="@(i == 0 ? "true" : "false")" 
                                        aria-controls="@collapseId"
                                        data-faq-id="@faq.FAQId"
                                        role="button"
                                        aria-controls="@collapseId">
                                    <div class="faq-question-text">
                                        <i class="fas fa-chevron-down faq-chevron"></i>
                                        <strong>@faq.Question</strong>
                                    </div>
                                    @if (faq.Tags != null && faq.Tags.Any())
                                    {
                                        <div class="faq-tags">
                                            @foreach (var tag in faq.Tags.Take(2))
                                            {
                                                <span class="faq-tag">@tag</span>
                                            }
                                        </div>
                                    }
                                </button>
                            </div>
                            <div id="@collapseId" 
                                 class="collapse @(i == 0 ? "show" : "")" 
                                 role="tabpanel"
                                 aria-labelledby="@headingId" 
                                 data-parent="#faqAccordion">
                                <div class="card-body">
                                    <div class="faq-answer">
                                        @Html.Raw(faq.Answer)
                                    </div>
                                    @if (!string.IsNullOrEmpty(faq.RelatedLinkUrl))
                                    {
                                        <div class="faq-related-link">
                                            <a href="@faq.RelatedLinkUrl" 
                                               class="btn btn-medical-primary"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               aria-label="اطلاعات بیشتر درباره @faq.Question">
                                                <i class="fas fa-external-link-alt me-2"></i> اطلاعات بیشتر
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="text-center mt-4">
                    <a href="@Url.Action("Index", "FAQ")" 
                       class="btn btn-medical-primary btn-lg btn-view-all animate-scale-in" 
                       style="animation-delay: @(0.1 * Model.Count)s;">
                        <i class="fas fa-list me-2"></i> مشاهده همه سوالات متداول
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
@* اسکریپت faq-accordion از Index Scripts لود می‌شود (در پارشال @section اجرا نمی‌شود) *@

