@model List<ClinicApp.ViewModels.CMS.FAQPublicViewModel>
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
}

<section class="faq-section py-5" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="section-title mb-3">
                    <i class="fas fa-question-circle text-primary"></i>
                    سوالات متداول
                </h2>
                <p class="section-subtitle text-muted">پاسخ به سوالات رایج شما</p>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8 offset-lg-2">
                <div class="accordion" id="faqAccordion">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var faq = Model[i];
                        var collapseId = $"faqCollapse{i}";
                        var headingId = $"faqHeading{i}";
                        
                        <div class="card mb-3 shadow-sm faq-card">
                            <div class="card-header bg-white" id="@headingId">
                                <h5 class="mb-0">
                                    <button class="btn btn-link btn-block text-left text-dark" type="button" 
                                            data-toggle="collapse" data-target="#@collapseId" 
                                            aria-expanded="@(i == 0 ? "true" : "false")" 
                                            aria-controls="@collapseId"
                                            onclick="incrementFAQView(@faq.FAQId)">
                                        <i class="fas fa-chevron-@(i == 0 ? "down" : "right") mr-2"></i>
                                        <strong>@faq.Question</strong>
                                        @if (faq.Tags != null && faq.Tags.Any())
                                        {
                                            <span class="float-left">
                                                @foreach (var tag in faq.Tags.Take(2))
                                                {
                                                    <span class="badge badge-secondary badge-sm mr-1">@tag</span>
                                                }
                                            </span>
                                        }
                                    </button>
                                </h5>
                            </div>
                            <div id="@collapseId" class="collapse @(i == 0 ? "show" : "")" 
                                 aria-labelledby="@headingId" data-parent="#faqAccordion">
                                <div class="card-body">
                                    <div class="faq-answer">
                                        @Html.Raw(faq.Answer)
                                    </div>
                                    @if (!string.IsNullOrEmpty(faq.RelatedLinkUrl))
                                    {
                                        <div class="mt-3">
                                            <a href="@faq.RelatedLinkUrl" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-external-link-alt"></i> اطلاعات بیشتر
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="text-center mt-4">
                    <a href="@Url.Action("Index", "FAQ")" class="btn btn-primary btn-lg">
                        <i class="fas fa-list"></i> مشاهده همه سوالات متداول
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function incrementFAQView(faqId) {
            // افزایش تعداد بازدید بدون رفرش صفحه
            $.ajax({
                url: '@Url.Action("IncrementView", "FAQ")',
                type: 'POST',
                data: { id: faqId },
                success: function() {
                    // ViewCount افزایش یافت
                },
                error: function() {
                    // خطا در افزایش ViewCount نباید باعث مشکل شود
                }
            });
        }

        // انیمیشن برای باز و بسته شدن FAQ
        $('#faqAccordion').on('show.bs.collapse', function (e) {
            $(e.target).prev('.card-header').find('.fa-chevron-right').removeClass('fa-chevron-right').addClass('fa-chevron-down');
        });

        $('#faqAccordion').on('hide.bs.collapse', function (e) {
            $(e.target).prev('.card-header').find('.fa-chevron-down').removeClass('fa-chevron-down').addClass('fa-chevron-right');
        });
    </script>
}

<style>
    .faq-section {
        position: relative;
        overflow: hidden;
    }

    .faq-card {
        border: none;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    .faq-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.15) !important;
    }

    .faq-card .card-header {
        border-bottom: 2px solid #e9ecef;
        border-radius: 10px 10px 0 0 !important;
    }

    .faq-card .btn-link {
        text-decoration: none;
        color: #2c3e50;
        font-weight: 600;
        padding: 1rem;
    }

    .faq-card .btn-link:hover {
        color: #007bff;
    }

    .faq-card .btn-link:focus {
        box-shadow: none;
    }

    .faq-answer {
        line-height: 1.8;
        color: #495057;
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .section-subtitle {
        font-size: 1.1rem;
    }

    @media (max-width: 768px) {
        .section-title {
            font-size: 2rem;
        }
    }
</style>

