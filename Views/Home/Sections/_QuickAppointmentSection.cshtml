@model ClinicApp.ViewModels.QuickAppointmentViewModel

<section class="quick-appointment-section text-center py-5 mb-5" style="background: linear-gradient(135deg, var(--primary-color), #1a5a8c); border-radius: 20px; color: white;">
    <div class="container">
        <h2 class="h1 mb-4" style="font-weight: 700;">@Model.SectionTitle</h2>
        <p class="lead mb-5" style="max-width: 700px; margin: 0 auto; line-height: 1.8; opacity: 0.9;">
            @Model.SectionSubtitle
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="@Model.AppointmentUrl" class="btn btn-light btn-lg px-5 py-3">
                <i class="fas fa-calendar-check me-2"></i> رزرو نوبت آنلاین
            </a>
        </div>
    </div>
</section>

