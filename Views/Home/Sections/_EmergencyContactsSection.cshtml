@model List<ClinicApp.ViewModels.CMS.EmergencyContactPublicViewModel>
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
    
    // فقط اولین شماره اضطراری (معمولاً 115)
    var primaryContact = Model.FirstOrDefault();
    if (primaryContact == null || string.IsNullOrEmpty(primaryContact.PhoneNumber))
    {
        return;
    }
    
    // پاک کردن شماره از کاراکترهای غیرضروری برای tel: link
    var cleanPhoneNumber = primaryContact.PhoneNumber.Replace("-", "").Replace(" ", "").Replace("(", "").Replace(")", "");
}

@* CSS در Layout لود می‌شود *@
<section class="emergency-contact-sticky-bar" role="alert" aria-live="polite" aria-label="تماس اضطراری">
    <div class="emergency-sticky-container">
        <div class="emergency-sticky-content">
            <div class="emergency-sticky-icon">
                <i class="fas fa-phone-alt" aria-hidden="true"></i>
            </div>
            <div class="emergency-sticky-text">
                <span class="emergency-sticky-label">تماس اضطراری:</span>
                <a href="tel:@cleanPhoneNumber" 
                   class="emergency-sticky-phone" 
                   aria-label="تماس اضطراری: @primaryContact.PhoneNumber"
                   title="کلیک برای تماس: @primaryContact.PhoneNumber">
                    @primaryContact.PhoneNumber
                </a>
            </div>
            <a href="tel:@cleanPhoneNumber" 
               class="emergency-sticky-button" 
               aria-label="تماس فوری: @primaryContact.PhoneNumber">
                <i class="fas fa-phone" aria-hidden="true"></i>
                <span>تماس</span>
            </a>
        </div>
    </div>
</section>
