@model List<ClinicApp.ViewModels.CMS.EmergencyContactPublicViewModel>
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
}

<section class="emergency-contacts-section py-5" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="section-title text-white mb-3">
                    <i class="fas fa-phone-alt"></i>
                    تماس‌های اضطراری
                </h2>
                <p class="section-subtitle text-white-50">در مواقع اضطراری با ما تماس بگیرید</p>
            </div>
        </div>

        <div class="row">
            @foreach (var contact in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="card emergency-contact-card h-100 shadow-lg border-0 text-center">
                        <div class="card-body p-4">
                            @if (!string.IsNullOrEmpty(contact.IconUrl))
                            {
                                <img src="@contact.IconUrl" alt="@contact.Title" class="mb-3" style="max-height: 60px; max-width: 100%; object-fit: contain;">
                            }
                            else
                            {
                                <div class="mb-3">
                                    <i class="fas fa-phone-alt fa-3x text-white"></i>
                                </div>
                            }
                            
                            <h5 class="card-title font-weight-bold text-white mb-2">@contact.Title</h5>
                            
                            <div class="mb-3">
                                <span class="badge badge-light">
                                    @contact.TypeDisplayName
                                </span>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(contact.ShortDescription))
                            {
                                <p class="card-text text-white-50 small mb-3">
                                    @(contact.ShortDescription.Length > 80 ? contact.ShortDescription.Substring(0, 80) + "..." : contact.ShortDescription)
                                </p>
                            }
                            
                            <div class="mt-auto">
                                <a href="tel:@contact.PhoneNumber" class="btn btn-light btn-block mb-2">
                                    <i class="fas fa-phone"></i> @contact.PhoneNumber
                                </a>
                                
                                @if (!string.IsNullOrEmpty(contact.WhatsAppUrl))
                                {
                                    <a href="@contact.WhatsAppUrl" target="_blank" class="btn btn-success btn-sm btn-block mb-2">
                                        <i class="fab fa-whatsapp"></i> واتساپ
                                    </a>
                                }
                                
                                @if (!string.IsNullOrEmpty(contact.TelegramUrl))
                                {
                                    <a href="@contact.TelegramUrl" target="_blank" class="btn btn-info btn-sm btn-block">
                                        <i class="fab fa-telegram"></i> تلگرام
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .emergency-contacts-section {
        position: relative;
        overflow: hidden;
    }

    .emergency-contact-card {
        border-radius: 15px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }

    .emergency-contact-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.3) !important;
        background: rgba(255, 255, 255, 0.15);
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 700;
    }

    .section-subtitle {
        font-size: 1.1rem;
    }

    @@media (max-width: 768px) {
        .section-title {
            font-size: 2rem;
        }
    }
</style>

