@model ClinicApp.ViewModels.BlogSectionViewModel
@{
    if (Model == null || Model.Posts == null || !Model.Posts.Any()) { return; }
    var posts = Model.Posts.Take(6).ToList();
}
@* آخرین مطالب مجلهٔ سلامت — الگو: دکترتو، مجله‌ای؛ کارت مقاله با تصویر، عنوان، خلاصه، متا، CTA *@
<div class="blog-inner">
    <div class="blog-container">
        <header class="blog-header">
            <h2 class="blog-title" id="blog-section-heading">
                <i class="fas fa-newspaper" aria-hidden="true"></i>
                @(Model.SectionTitle ?? "آخرین مطالب مجلهٔ سلامت")
            </h2>
            @if (!string.IsNullOrEmpty(Model.ViewAllPostsUrl))
            {
                <a href="@Model.ViewAllPostsUrl" class="blog-view-all-link" aria-label="مشاهده همه مقالات">
                    <span>@(Model.SectionSubtitle ?? "همه مقالات")</span>
                    <i class="fas fa-chevron-left" aria-hidden="true"></i>
                </a>
            }
        </header>

        <div class="blog-grid" role="list">
            @foreach (var post in posts)
            {
                var summaryText = !string.IsNullOrEmpty(post.Summary)
                    ? (post.Summary.Length > 120 ? post.Summary.Substring(0, 120).Trim() + "…" : post.Summary)
                    : "";
                <article class="blog-card-wrapper" role="listitem">
                    <a href="@post.PostUrl" class="blog-card" aria-label="مطالعه مقاله: @post.Title">
                        <div class="blog-image-wrapper">
                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <img src="@post.ImageUrl"
                                     class="blog-image"
                                     alt=""
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.onerror=null; this.src='/Content/Images/default-blog.jpg';">
                            }
                            else
                            {
                                <div class="blog-image-placeholder" aria-hidden="true">
                                    <i class="fas fa-stethoscope" aria-hidden="true"></i>
                                </div>
                            }
                        </div>
                        <div class="blog-content">
                            <h3 class="blog-post-title">@post.Title</h3>
                            @if (!string.IsNullOrEmpty(summaryText))
                            {
                                <p class="blog-post-summary">@summaryText</p>
                            }
                            <div class="blog-meta">
                                @if (!string.IsNullOrEmpty(post.CategoryName))
                                {
                                    <span class="blog-category" aria-label="دسته‌بندی: @post.CategoryName">
                                        <i class="fas fa-tag" aria-hidden="true"></i>
                                        @post.CategoryName
                                    </span>
                                }
                                @if (post.PublishedAt.HasValue)
                                {
                                    <time class="blog-date" datetime="@post.PublishedAt.Value.ToString("yyyy-MM-dd")" aria-label="تاریخ انتشار">
                                        <i class="fas fa-calendar-alt" aria-hidden="true"></i>
                                        @ClinicApp.Helpers.PersianDateHelper.ToPersianDate(post.PublishedAt.Value)
                                    </time>
                                }
                            </div>
                            <span class="blog-button">
                                <span>مطالعه مقاله</span>
                                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                            </span>
                        </div>
                    </a>
                </article>
            }
        </div>

        <div class="blog-legal-notice" role="note" aria-label="توجه">
            <p class="blog-legal-text">
                <i class="fas fa-info-circle" aria-hidden="true"></i>
                <strong>توجه:</strong> محتوای این بخش جنبهٔ آموزشی دارد و جایگزین مشاوره یا تشخیص پزشکی نیست.
            </p>
        </div>
    </div>
</div>
<script>
(function() {
    function run() {
        var cards = document.querySelectorAll('.blog-section .blog-card');
        if (cards.length === 0) return;
        var observer = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
                if (entry.isIntersecting) {
                    entry.target.closest('.blog-card-wrapper').classList.add('animate-in');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.05, rootMargin: '0px 0px -30px 0px' });
        cards.forEach(function(c) { observer.observe(c); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
})();
</script>
