@model ClinicApp.ViewModels.BlogSectionViewModel

@if (Model.Posts != null && Model.Posts.Any())
{
    <section class="blog-section mb-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="h1" style="color: var(--primary-color); font-weight: 700;">@Model.SectionTitle</h2>
                <p class="lead text-muted" style="max-width: 700px; margin: 1rem auto;">
                    @Model.SectionSubtitle
                </p>
            </div>

            <div class="row">
                @foreach (var post in Model.Posts)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100" style="border-radius: 16px; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                            {
                                <img src="@post.ImageUrl" 
                                     class="card-img-top" 
                                     alt="@post.Title"
                                     style="height: 200px; object-fit: cover;"
                                     onerror="this.src='/Content/Images/default-blog.jpg'">
                            }
                            <div class="card-body p-4">
                                <h3 class="h5 mb-3" style="color: var(--primary-color);">@post.Title</h3>
                                <p class="text-muted mb-3">@post.Summary</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">
                                        @if (post.PublishedAt.HasValue)
                                        {
                                            @post.PublishedAt.Value.ToString("yyyy/MM/dd")
                                        }
                                    </small>
                                    <a href="@post.PostUrl" class="btn btn-sm btn-outline-primary">
                                        ادامه مطلب <i class="fas fa-arrow-left me-2"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.ViewAllPostsUrl))
            {
                <div class="text-center mt-4">
                    <a href="@Model.ViewAllPostsUrl" class="btn btn-primary btn-lg px-5 py-3">
                        <i class="fas fa-book me-2"></i> مشاهده همه مقالات
                    </a>
                </div>
            }
        </div>
    </section>
}

