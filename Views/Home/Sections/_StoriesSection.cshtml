@model List<ClinicApp.ViewModels.CMS.StoryPublicViewModel>
@using System.Web.Mvc
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
}

@* سکشن اصلی در Index است؛ محتوا بدون تکراری بودن landmark *@
<div class="stories-inner" role="region" aria-label="استوری‌ها">
    <div class="stories-container">
        <div class="stories-scroll-wrapper">
            <div class="stories-list" id="storiesList">
                @foreach (var story in Model)
                {
                    <div class="story-item" 
                         data-story-id="@story.StoryId"
                         data-video-url="@story.VideoUrl"
                         data-video-type="@story.VideoType"
                         data-link-url="@(story.LinkUrl ?? "")"
                         data-button-text="@(story.ButtonText ?? "")"
                         role="button"
                         tabindex="0"
                         aria-label="استوری: @story.Title">
                        <div class="story-thumbnail-wrapper">
                            @if (!string.IsNullOrEmpty(story.ThumbnailUrl))
                            {
                                <img src="@Url.Content(story.ThumbnailUrl)" 
                                     alt="@story.Title" 
                                     class="story-thumbnail"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="story-thumbnail-placeholder">
                                    <i class="fas fa-video" aria-hidden="true"></i>
                                </div>
                            }
                            <div class="story-overlay">
                                <div class="story-play-icon">
                                    <i class="fas fa-play" aria-hidden="true"></i>
                                </div>
                            </div>
                            @if (story.Duration.HasValue)
                            {
                                <div class="story-duration">
                                    @FormatDuration(story.Duration.Value)
                                </div>
                            }
                        </div>
                        <div class="story-title">
                            @story.Title
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* Video Player Modal - بهینه‌سازی شده برای RTL و Production *@
<div class="modal fade" id="storyVideoModal" tabindex="-1" role="dialog" aria-labelledby="storyVideoModalLabel" aria-hidden="true" data-backdrop="true" data-keyboard="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" 
                        class="close modal-close-btn" 
                        data-dismiss="modal" 
                        aria-label="بستن"
                        title="بستن (ESC)">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
                <h5 class="modal-title" id="storyVideoModalLabel">پخش ویدیو</h5>
            </div>
            <div class="modal-body">
                <div id="storyVideoPlayer" class="story-video-player">
                    <!-- ویدیو در اینجا لود می‌شود -->
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string FormatDuration(int seconds)
    {
        var minutes = seconds / 60;
        var remainingSeconds = seconds % 60;
        return $"{minutes}:{remainingSeconds:D2}";
    }
}
