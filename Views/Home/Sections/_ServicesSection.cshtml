@model ClinicApp.ViewModels.ServicesSectionViewModel

<section class="services-section mb-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="h1" style="color: var(--primary-color); font-weight: 700;">@Model.SectionTitle</h2>
            <p class="lead text-muted" style="max-width: 700px; margin: 1rem auto;">
                @Model.SectionSubtitle
            </p>
        </div>

        <div class="row">
            @if (Model.Services != null && Model.Services.Any())
            {
                @foreach (var service in Model.Services)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card service-card h-100 hover-scale" style="border-radius: 16px; overflow: hidden; transition: all 0.4s ease;">
                            <div class="card-body p-4 text-center">
                                <div class="mb-4" style="height: 80px; display: flex; align-items: center; justify-content: center;">
                                    <i class="@service.Icon" style="font-size: 3.5rem; color: var(--primary-color);"></i>
                                </div>
                                <h3 class="h5 mb-3" style="color: var(--primary-color);">@service.Title</h3>
                                <p class="text-muted mb-4" style="min-height: 100px;">
                                    @service.Description
                                </p>
                                @if (service.Price.HasValue)
                                {
                                    <p class="text-primary mb-3" style="font-weight: 600; font-size: 1.1rem;">
                                        @service.Price.Value.ToString("N0") تومان
                                    </p>
                                }
                                <a href="@service.DetailsUrl" class="btn btn-outline-primary w-100 py-2">
                                    جزئیات بیشتر <i class="fas fa-arrow-left me-2"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

