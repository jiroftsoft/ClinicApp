@model ClinicApp.ViewModels.ServicesSectionViewModel

<section class="modern-services-section" aria-label="@Model.SectionTitle">
    <div class="modern-services-container container">
        @* Header Section *@
        <div class="modern-services-header">
            <h2 class="modern-services-title">@Model.SectionTitle</h2>
            <p class="modern-services-subtitle">@Model.SectionSubtitle</p>
        </div>

        @* Services Grid *@
        @if (Model != null && Model.Services != null && Model.Services.Any())
        {
            <div class="modern-services-grid">
                @foreach (var service in Model.Services)
                {
                    <article class="modern-service-card" role="article" aria-labelledby="service-title-@service.ServiceId">
                        @* Card Header with Icon *@
                        <div class="modern-service-header">
                            <div class="modern-service-icon-wrapper">
                                <i class="@service.Icon modern-service-icon" aria-hidden="true"></i>
                            </div>
                            @if (!string.IsNullOrEmpty(service.CategoryName))
                            {
                                <span class="modern-service-category-badge" aria-label="دسته‌بندی: @service.CategoryName">
                                    @service.CategoryName
                                </span>
                            }
                        </div>

                        @* Card Content *@
                        <div class="modern-service-content">
                            <h3 class="modern-service-title" id="service-title-@service.ServiceId">
                                @service.Title
                            </h3>
                            <p class="modern-service-description">
                                @service.Description
                            </p>

                            @* Price Section *@
                            @if (service.Price.HasValue)
                            {
                                <div class="modern-service-price-wrapper">
                                    <span class="modern-service-price-label">قیمت:</span>
                                    <span class="modern-service-price" aria-label="@service.Price.Value.ToString("N0") تومان">
                                        <span class="modern-service-price-currency">تومان</span>
                                        @service.Price.Value.ToString("N0")
                                    </span>
                                </div>
                            }

                            @* CTA Button *@
                            <a href="@service.DetailsUrl" class="modern-service-button" aria-label="مشاهده جزئیات @service.Title">
                                <span>جزئیات بیشتر</span>
                                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>

            @* View All Button *@
            <div class="modern-services-view-all">
                <a href="@Url.Action("Index", "MedicalServiceInfo")" class="modern-services-view-all-button" aria-label="مشاهده تمام خدمات">
                    <span>مشاهده تمام خدمات</span>
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                </a>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">در حال حاضر خدماتی برای نمایش وجود ندارد.</p>
            </div>
        }
    </div>
</section>
@* CSS از باندل homepage-sections لود می‌شود *@

