@model ClinicApp.ViewModels.ValuePropositionViewModel

<section class="value-proposition-section py-5 mb-5">
    <div class="container">
        <div class="row">
            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <div class="col-md-6 col-lg-3 mb-4">
                        <div class="card h-100 text-center p-4 border-0 shadow-sm">
                            <div class="mb-3" style="height: 80px; display: flex; align-items: center; justify-content: center;">
                                <i class="@item.Icon" style="font-size: 3.5rem; color: var(--primary-color);"></i>
                            </div>
                            <h3 class="h5 mb-3" style="color: var(--primary-color);">@item.Title</h3>
                            <p class="text-muted">@item.Description</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

