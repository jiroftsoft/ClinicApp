@model List<ClinicApp.ViewModels.CMS.HealthTipPublicViewModel>
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
    
    // محدود کردن به 3-4 نکته
    var tipsToShow = Model.Take(4).ToList();
}

@* CSS از باندل homepage-sections لود می‌شود *@
<div class="health-tips-inner">
    <div class="container">
        <div class="health-tips-header">
            <h2 class="health-tips-title">
                <i class="fas fa-heartbeat" aria-hidden="true"></i>
                نکات سلامت
            </h2>
            <p class="health-tips-subtitle">راهنمایی‌های کوتاه و کاربردی برای حفظ سلامت شما</p>
        </div>

        @* Compact Cards Grid *@
        <div class="health-tips-grid">
            @for (int i = 0; i < tipsToShow.Count; i++)
            {
                var tip = tipsToShow[i];
                <article class="health-tip-compact-card" tabindex="0" role="article" aria-label="@tip.Title">
                    @* Badge کوچک *@
                    <div class="health-tip-badge">
                        <i class="fas fa-heartbeat" aria-hidden="true"></i>
                        <span>نکته سلامت</span>
                    </div>
                    
                    @* عنوان کوتاه (حداکثر 1 خط) *@
                    <h3 class="health-tip-title">@tip.Title</h3>
                    
                    @* توضیح خیلی کوتاه (2 خط، 200-250 کاراکتر) *@
                    @if (!string.IsNullOrEmpty(tip.Summary))
                    {
                        <p class="health-tip-description">
                            @{
                                var description = tip.Summary;
                                var maxLength = 250;
                                if (description.Length > maxLength)
                                {
                                    description = description.Substring(0, maxLength).Trim() + "...";
                                }
                            }
                            @description
                        </p>
                    }
                    
                    @* CTA: "راهنمای بیشتر" *@
                    <a href="@Url.Action("Details", "HealthTip", new { slug = tip.Slug })" 
                       class="health-tip-cta" 
                       aria-label="راهنمای بیشتر درباره @tip.Title">
                        <span>راهنمای بیشتر</span>
                        <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    </a>
                </article>
            }
        </div>
    </div>
</div>
