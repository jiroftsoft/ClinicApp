@model List<ClinicApp.ViewModels.CMS.HealthTipPublicViewModel>
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/health-tips-section.css")" />

<section class="health-tips-section animate-fade-in">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">
                <i class="fas fa-heartbeat"></i>
                نکات سلامت
            </h2>
            <p class="section-subtitle">راهنمایی‌های مفید برای حفظ سلامت شما</p>
        </div>

        <div class="row">
            @for (int i = 0; i < Model.Count; i++)
            {
                var tip = Model[i];
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="health-tip-card animate-in" style="animation-delay: @(0.1 * i)s;">
                        @if (!string.IsNullOrEmpty(tip.ThumbnailUrl))
                        {
                            <img src="@tip.ThumbnailUrl" 
                                 class="card-img-top" 
                                 alt="@tip.Title"
                                 loading="lazy"
                                 onerror="this.src='/Content/Images/default-health-tip.jpg'">
                        }
                        else if (!string.IsNullOrEmpty(tip.ImageUrl))
                        {
                            <img src="@tip.ImageUrl" 
                                 class="card-img-top" 
                                 alt="@tip.Title"
                                 loading="lazy"
                                 onerror="this.src='/Content/Images/default-health-tip.jpg'">
                        }
                        else
                        {
                            <div class="default-image-placeholder">
                                <i class="fas fa-heartbeat"></i>
                            </div>
                        }
                        
                        <div class="card-body">
                            <div class="mb-2">
                                <span class="badge-category category-@tip.Category?.ToLower()">
                                    <i class="@GetCategoryIcon(tip.Category)"></i>
                                    @tip.CategoryDisplayName
                                </span>
                            </div>
                            
                            <h5 class="card-title">@tip.Title</h5>
                            
                            @if (!string.IsNullOrEmpty(tip.Summary))
                            {
                                <p class="card-text">@(tip.Summary.Length > 120 ? tip.Summary.Substring(0, 120) + "..." : tip.Summary)</p>
                            }
                            
                            <div class="tip-meta">
                                <small class="meta-item">
                                    <i class="fas fa-eye"></i> @tip.ViewCount بازدید
                                </small>
                                <small class="meta-item">
                                    <i class="fas fa-share-alt"></i> @tip.ShareCount اشتراک
                                </small>
                            </div>
                            
                            <a href="@Url.Action("Details", "HealthTip", new { slug = tip.Slug })" 
                               class="btn btn-medical-primary btn-read-more w-100"
                               aria-label="مطالعه بیشتر درباره @tip.Title">
                                <i class="fas fa-arrow-left me-2"></i> مطالعه بیشتر
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row mt-4">
            <div class="col-12 text-center">
                <a href="@Url.Action("Index", "HealthTip")" 
                   class="btn btn-medical-primary btn-lg btn-view-all animate-scale-in" 
                   style="animation-delay: @(0.1 * Model.Count)s;">
                    <i class="fas fa-list me-2"></i> مشاهده همه نکات سلامت
                </a>
            </div>
        </div>
    </div>
</section>

@functions {
    private string GetCategoryIcon(string category)
    {
        return category switch
        {
            "prevention" => "fas fa-shield-alt",
            "nutrition" => "fas fa-apple-alt",
            "exercise" => "fas fa-running",
            "diseases" => "fas fa-stethoscope",
            "general" => "fas fa-heart",
            _ => "fas fa-info-circle"
        };
    }
}

