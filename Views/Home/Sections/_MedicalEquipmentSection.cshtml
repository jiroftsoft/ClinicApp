@model ClinicApp.ViewModels.HomePageViewModel
@{
    var equipments = (Model?.MedicalEquipments ?? new List<ClinicApp.ViewModels.CMS.MedicalEquipmentPublicViewModel>()).Take(4).ToList();
}

@* سکشن تجهیزات پزشکی — Trust Signal (ر.ک. Docs/MEDICAL-EQUIPMENT-SECTION-GUIDE.md) *@
@* الگو: Mayo / Cleveland — غیرتبلیغاتی، توضیح ساده برای بیمار، Grid نه Carousel *@
@if (equipments == null || !equipments.Any()) { return; }

<div class="medical-equipment-inner medical-equipment-showcase">
    <div class="container">
        <header class="equipment-showcase-header section-header" aria-labelledby="equipment-section-heading">
            <h2 class="equipment-showcase-title section-title" id="equipment-section-heading">تجهیزات پیشرفته، تشخیص دقیق‌تر</h2>
            <p class="equipment-showcase-subtitle section-subtitle">
                در کلینیک شفا از تجهیزات مدرن و استاندارد استفاده می‌شود تا دقت تشخیص و ایمنی درمان در بالاترین سطح باشد.
            </p>
        </header>

        <div class="equipment-showcase-grid" role="list">
            @foreach (var equipment in equipments)
            {
                var patientText = !string.IsNullOrWhiteSpace(equipment.ShortDescription)
                    ? equipment.ShortDescription
                    : (string.IsNullOrWhiteSpace(equipment.Description) ? null : ClinicApp.Helpers.StringHelper.StripHtmlAndTruncate(equipment.Description, 100));
                <article class="equipment-showcase-card" role="listitem" aria-labelledby="equipment-title-@equipment.MedicalEquipmentId">
                    <div class="equipment-card-image-wrapper">
                        @if (!string.IsNullOrEmpty(equipment.ImageUrl))
                        {
                            <img src="@equipment.ImageUrl"
                                 alt="@(equipment.EquipmentName + " در کلینیک شفا")"
                                 class="equipment-card-image"
                                 loading="lazy"
                                 decoding="async"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                        }
                        <div class="equipment-card-image-placeholder" style="@(string.IsNullOrEmpty(equipment.ImageUrl) ? "display: flex;" : "display: none;")">
                            <i class="fas fa-x-ray" aria-hidden="true"></i>
                        </div>
                    </div>
                    <div class="equipment-card-content">
                        <h3 class="equipment-card-name" id="equipment-title-@equipment.MedicalEquipmentId">@equipment.EquipmentName</h3>
                        @if (!string.IsNullOrWhiteSpace(patientText))
                        {
                            <p class="equipment-card-use">@patientText</p>
                        }
                        <a href="@Url.Action("Details", "MedicalEquipment", new { slug = equipment.Slug })"
                           class="equipment-card-button"
                           aria-label="مشاهده جزئیات @equipment.EquipmentName">
                            <span>مشاهده جزئیات</span>
                            <i class="fas fa-arrow-left" aria-hidden="true"></i>
                        </a>
                    </div>
                </article>
            }
        </div>

        @if ((Model?.MedicalEquipments?.Count ?? 0) > 4)
        {
            <div class="equipment-showcase-footer">
                <a href="@Url.Action("Index", "MedicalEquipment")"
                   class="equipment-showcase-view-all"
                   aria-label="مشاهده همه تجهیزات">
                    <span>مشاهده همه تجهیزات</span>
                    <i class="fas fa-arrow-left" aria-hidden="true"></i>
                </a>
            </div>
        }

        <div class="equipment-showcase-legal-notice">
            <p class="equipment-legal-text">
                <i class="fas fa-info-circle" aria-hidden="true"></i>
                <span>اطلاعات تجهیزات صرفاً جهت آشنایی مراجعین بوده و به‌معنای تشخیص یا توصیه درمانی نیست.</span>
            </p>
        </div>
    </div>
</div>
