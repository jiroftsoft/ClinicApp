@model ClinicApp.ViewModels.HomePageViewModel
@{
    var equipments = Model?.MedicalEquipments ?? new List<ClinicApp.ViewModels.CMS.MedicalEquipmentPublicViewModel>();
}

<link rel="stylesheet" href="@Url.Content("~/Content/css/medical-equipment-section.css")" />

@if (equipments != null && equipments.Any())
{
    <section class="medical-equipment-section animate-fade-in">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="section-title">
                    <i class="fas fa-x-ray"></i>
                    تجهیزات پزشکی مدرن
                </h2>
                <p class="section-subtitle">با استفاده از پیشرفته‌ترین تجهیزات پزشکی، بهترین خدمات را به شما ارائه می‌دهیم</p>
            </div>

            <div class="row">
                @for (int i = 0; i < equipments.Take(6).Count(); i++)
                {
                    var equipment = equipments.ElementAt(i);
                    <div class="col-md-4 col-lg-4 mb-4">
                        <div class="equipment-card animate-in" style="animation-delay: @(0.1 * i)s;">
                            <div class="equipment-image-wrapper">
                                @if (!string.IsNullOrEmpty(equipment.ImageUrl))
                                {
                                    <img src="@equipment.ImageUrl" 
                                         alt="@equipment.EquipmentName"
                                         class="equipment-image"
                                         loading="lazy"
                                         onerror="this.src='/Content/Images/default-equipment.jpg'">
                                }
                                else
                                {
                                    <div class="default-image-placeholder">
                                        <i class="fas fa-x-ray"></i>
                                    </div>
                                }
                                <div class="equipment-category">
                                    @equipment.CategoryDisplayName
                                </div>
                            </div>
                            <div class="equipment-content">
                                <h4>@equipment.EquipmentName</h4>
                                @if (!string.IsNullOrEmpty(equipment.Model))
                                {
                                    <p class="equipment-model">
                                        <i class="fas fa-tag"></i> <strong>مدل:</strong> @equipment.Model
                                    </p>
                                }
                                @if (!string.IsNullOrEmpty(equipment.ShortDescription))
                                {
                                    <p class="equipment-description">
                                        @(equipment.ShortDescription.Length > 100 ? equipment.ShortDescription.Substring(0, 100) + "..." : equipment.ShortDescription)
                                    </p>
                                }
                                @if (equipment.Features != null && equipment.Features.Any())
                                {
                                    <div class="equipment-features">
                                        @foreach (var feature in equipment.Features.Take(3))
                                        {
                                            <span class="feature-badge">
                                                <i class="fas fa-check-circle"></i> @feature
                                            </span>
                                        }
                                    </div>
                                }
                                <div class="equipment-footer">
                                    <a href="@Url.Action("Details", "MedicalEquipment", new { slug = equipment.Slug })" 
                                       class="btn btn-medical-primary btn-details"
                                       aria-label="مشاهده جزئیات @equipment.EquipmentName">
                                        <i class="fas fa-arrow-left me-2"></i> مشاهده جزئیات
                                    </a>
                                    <small class="view-count">
                                        <i class="fas fa-eye"></i> @equipment.ViewCount
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (equipments.Count > 6)
            {
                <div class="row mt-4">
                    <div class="col-12 text-center">
                        <a href="@Url.Action("Index", "MedicalEquipment")" 
                           class="btn btn-medical-primary btn-lg btn-view-all animate-scale-in" 
                           style="animation-delay: @(0.1 * Math.Min(6, equipments.Count))s;">
                            <i class="fas fa-list me-2"></i> مشاهده همه تجهیزات
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>
}

