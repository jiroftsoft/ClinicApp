@model ClinicApp.ViewModels.HomePageViewModel
@{
    var equipments = Model?.MedicalEquipments ?? new List<ClinicApp.ViewModels.CMS.MedicalEquipmentPublicViewModel>();
}

@* CSS در Index.cshtml لود می‌شود *@

@if (equipments != null && equipments.Any())
{
    <section class="medical-equipment-showcase" aria-label="تجهیزات پزشکی مدرن">
        <div class="container">
            @* Header Section *@
            <div class="equipment-showcase-header">
                <h2 class="equipment-showcase-title">تجهیزات پزشکی مدرن</h2>
                <p class="equipment-showcase-subtitle">
                    استفاده از تجهیزات پیشرفته برای تشخیص دقیق‌تر و خدمات ایمن‌تر
                </p>
            </div>

            @* Equipment Grid *@
            <div class="equipment-showcase-grid">
                @foreach (var equipment in equipments.Take(6))
                {
                    <article class="equipment-showcase-card" role="article" aria-labelledby="equipment-title-@equipment.MedicalEquipmentId">
                        @* Equipment Image *@
                        <div class="equipment-card-image-wrapper">
                            @if (!string.IsNullOrEmpty(equipment.ImageUrl))
                            {
                                <img src="@equipment.ImageUrl" 
                                     alt="@equipment.EquipmentName"
                                     class="equipment-card-image"
                                     loading="lazy"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            }
                            <div class="equipment-card-image-placeholder" style="@(string.IsNullOrEmpty(equipment.ImageUrl) ? "display: flex;" : "display: none;")">
                                <i class="fas fa-x-ray" aria-hidden="true"></i>
                            </div>
                        </div>

                        @* Equipment Content *@
                        <div class="equipment-card-content">
                            @* Equipment Name *@
                            <h3 class="equipment-card-name" id="equipment-title-@equipment.MedicalEquipmentId">
                                @equipment.EquipmentName
                            </h3>

                            @* Equipment Model *@
                            @if (!string.IsNullOrEmpty(equipment.Model))
                            {
                                <p class="equipment-card-model" aria-label="مدل: @equipment.Model">
                                    <span class="equipment-model-label">مدل:</span>
                                    <span class="equipment-model-value">@equipment.Model</span>
                                </p>
                            }

                            @* Equipment Features (3-4 مورد) *@
                            @if (equipment.Features != null && equipment.Features.Any())
                            {
                                <ul class="equipment-card-features" role="list">
                                    @foreach (var feature in equipment.Features.Take(4))
                                    {
                                        <li class="equipment-feature-item" role="listitem">
                                            <i class="fas fa-check-circle" aria-hidden="true"></i>
                                            <span>@feature</span>
                                        </li>
                                    }
                                </ul>
                            }

                            @* CTA Button *@
                            <a href="@Url.Action("Details", "MedicalEquipment", new { slug = equipment.Slug })" 
                               class="equipment-card-button" 
                               aria-label="مشاهده جزئیات @equipment.EquipmentName">
                                <span>مشاهده جزئیات</span>
                                <i class="fas fa-arrow-left" aria-hidden="true"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>

            @* View All Button *@
            @if (equipments.Count > 6)
            {
                <div class="equipment-showcase-footer">
                    <a href="@Url.Action("Index", "MedicalEquipment")" 
                       class="equipment-showcase-view-all" 
                       aria-label="مشاهده تمام تجهیزات">
                        <span>مشاهده تمام تجهیزات</span>
                        <i class="fas fa-arrow-left" aria-hidden="true"></i>
                    </a>
                </div>
            }

            @* Legal Notice *@
            <div class="equipment-showcase-legal-notice">
                <p class="equipment-legal-text">
                    <i class="fas fa-info-circle" aria-hidden="true"></i>
                    <span>اطلاعات تجهیزات صرفاً جهت آشنایی مراجعین بوده و به‌معنای تشخیص یا توصیه درمانی نیست.</span>
                </p>
            </div>
        </div>
    </section>
}
