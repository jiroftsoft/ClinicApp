@model ClinicApp.ViewModels.SidebarViewModel

@* CSS در Index.cshtml لود می‌شود *@

@if (Model != null)
{
    <aside class="medical-sidebar-modern" 
           role="complementary" 
           aria-label="منوی کناری کلینیک"
           id="medicalSidebar">
        
        @* Quick Appointment Section *@
        @if (Model.QuickAppointment != null)
        {
            <section class="sidebar-card sidebar-appointment-card" 
                     aria-labelledby="quickAppointmentTitle">
                <div class="sidebar-card-header">
                    <h3 id="quickAppointmentTitle" class="sidebar-card-title">
                        <i class="fas fa-calendar-check" aria-hidden="true"></i>
                        <span>@Model.QuickAppointment.Title</span>
                    </h3>
                </div>
                <div class="sidebar-card-content">
                    <p class="sidebar-card-subtitle">@Model.QuickAppointment.Subtitle</p>
                    <a href="@Model.QuickAppointment.AppointmentUrl" 
                       class="sidebar-appointment-button"
                       aria-label="@Model.QuickAppointment.ButtonText"
                       tabindex="0">
                        <i class="fas fa-calendar-alt" aria-hidden="true"></i>
                        <span>@Model.QuickAppointment.ButtonText</span>
                    </a>
                </div>
            </section>
        }

        @* Quick Links Section *@
        @if (Model.QuickLinks != null && Model.QuickLinks.Any())
        {
            <section class="sidebar-card sidebar-links-card" 
                     aria-labelledby="quickLinksTitle">
                <div class="sidebar-card-header">
                    <h3 id="quickLinksTitle" class="sidebar-card-title">
                        <i class="fas fa-link" aria-hidden="true"></i>
                        <span>لینک‌های سریع</span>
                    </h3>
                </div>
                <nav class="sidebar-card-content" role="navigation" aria-label="لینک‌های سریع">
                    <ul class="sidebar-links-list" role="list">
                        @foreach (var link in Model.QuickLinks.OrderBy(l => l.Order))
                        {
                            <li role="listitem">
                                <a href="@link.Url" 
                                   class="sidebar-link-item"
                                   @(link.IsExternal ? "target=\"_blank\" rel=\"noopener noreferrer\"" : "")
                                   aria-label="@link.Title"
                                   tabindex="0">
                                    <i class="@link.Icon" aria-hidden="true"></i>
                                    <span>@link.Title</span>
                                    @if (!string.IsNullOrEmpty(link.BadgeText))
                                    {
                                        <span class="sidebar-link-badge @link.BadgeClass" aria-label="@link.BadgeText">@link.BadgeText</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </section>
        }

        @* Contact Info Section *@
        @if (Model.ContactInfo != null)
        {
            <section class="sidebar-card sidebar-contact-card" 
                     aria-labelledby="contactInfoTitle">
                <div class="sidebar-card-header">
                    <h3 id="contactInfoTitle" class="sidebar-card-title">
                        <i class="fas fa-phone-alt" aria-hidden="true"></i>
                        <span>اطلاعات تماس</span>
                    </h3>
                </div>
                <div class="sidebar-card-content">
                    <div class="sidebar-contact-list">
                        @if (!string.IsNullOrEmpty(Model.ContactInfo.PhoneNumber))
                        {
                            <a href="@Model.ContactInfo.PhoneLink" 
                               class="sidebar-contact-item"
                               aria-label="تماس تلفنی: @Model.ContactInfo.PhoneNumber"
                               tabindex="0">
                                <i class="fas fa-phone" aria-hidden="true"></i>
                                <span>@Model.ContactInfo.PhoneNumber</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.ContactInfo.WhatsAppNumber))
                        {
                            <a href="@Model.ContactInfo.WhatsAppLink" 
                               class="sidebar-contact-item sidebar-contact-whatsapp"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="واتساپ: @Model.ContactInfo.WhatsAppNumber"
                               tabindex="0">
                                <i class="fab fa-whatsapp" aria-hidden="true"></i>
                                <span>@Model.ContactInfo.WhatsAppNumber</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.ContactInfo.Email))
                        {
                            <a href="@Model.ContactInfo.EmailLink" 
                               class="sidebar-contact-item"
                               aria-label="ایمیل: @Model.ContactInfo.Email"
                               tabindex="0">
                                <i class="fas fa-envelope" aria-hidden="true"></i>
                                <span>@Model.ContactInfo.Email</span>
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(Model.ContactInfo.Address))
                        {
                            <div class="sidebar-contact-item sidebar-contact-address">
                                <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                                <span>@Model.ContactInfo.Address</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.ContactInfo.GoogleMapsLink))
                        {
                            <a href="@Model.ContactInfo.GoogleMapsLink" 
                               class="sidebar-contact-item sidebar-contact-map"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="مشاهده نقشه در Google Maps"
                               tabindex="0">
                                <i class="fas fa-map" aria-hidden="true"></i>
                                <span>مشاهده نقشه</span>
                            </a>
                        }
                    </div>
                </div>
            </section>
        }

        @* Working Hours Section *@
        @if (Model.WorkingHours != null)
        {
            <section class="sidebar-card sidebar-hours-card" 
                     aria-labelledby="workingHoursTitle">
                <div class="sidebar-card-header">
                    <h3 id="workingHoursTitle" class="sidebar-card-title">
                        <i class="fas fa-clock" aria-hidden="true"></i>
                        <span>@Model.WorkingHours.Title</span>
                    </h3>
                </div>
                <div class="sidebar-card-content">
                    <div class="sidebar-status-badge @(Model.WorkingHours.IsOpenNow ? "status-open" : "status-closed")" 
                         role="status"
                         aria-live="polite">
                        <span class="status-indicator" aria-hidden="true"></span>
                        <span class="status-text">@Model.WorkingHours.CurrentStatus</span>
                    </div>
                    @if (Model.WorkingHours.WorkingDays != null && Model.WorkingHours.WorkingDays.Any())
                    {
                        <ul class="sidebar-working-days-list" role="list">
                            @foreach (var day in Model.WorkingHours.WorkingDays)
                            {
                                <li class="sidebar-working-day @(day.IsOpen ? "" : "day-closed")" role="listitem">
                                    <span class="working-day-name">@day.DayName</span>
                                    <span class="working-day-hours">@day.Hours</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        }

        @* Emergency Contacts Section *@
        @if (Model.EmergencyContacts != null && Model.EmergencyContacts.Any())
        {
            <section class="sidebar-card sidebar-emergency-card" 
                     aria-labelledby="emergencyTitle">
                <div class="sidebar-card-header sidebar-emergency-header">
                    <h3 id="emergencyTitle" class="sidebar-card-title sidebar-emergency-title">
                        <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                        <span>تماس‌های اضطراری</span>
                    </h3>
                </div>
                <div class="sidebar-card-content">
                    <ul class="sidebar-emergency-list" role="list">
                        @foreach (var contact in Model.EmergencyContacts)
                        {
                            <li role="listitem">
                                <a href="tel:@(contact.PhoneNumber?.Replace("-", "").Replace(" ", "").Replace("(", "").Replace(")", ""))" 
                                   class="sidebar-emergency-item"
                                   aria-label="تماس اضطراری: @contact.Title - @contact.PhoneNumber"
                                   tabindex="0">
                                    <div class="emergency-item-icon">
                                        <i class="fas fa-phone-alt" aria-hidden="true"></i>
                                    </div>
                                    <div class="emergency-item-content">
                                        @if (!string.IsNullOrEmpty(contact.Title))
                                        {
                                            <span class="emergency-item-title">@contact.Title</span>
                                        }
                                        <span class="emergency-item-phone">@contact.PhoneNumber</span>
                                    </div>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </section>
        }

        @* Health Tips Section *@
        @if (Model.HealthTips != null && Model.HealthTips.Any())
        {
            <section class="sidebar-card sidebar-tips-card" 
                     aria-labelledby="healthTipsTitle">
                <div class="sidebar-card-header">
                    <h3 id="healthTipsTitle" class="sidebar-card-title">
                        <i class="fas fa-heartbeat" aria-hidden="true"></i>
                        <span>نکات سلامت</span>
                    </h3>
                </div>
                <div class="sidebar-card-content">
                    <ul class="sidebar-tips-list" role="list">
                        @foreach (var tip in Model.HealthTips)
                        {
                            <li role="listitem">
                                <article class="sidebar-tip-card">
                                    <div class="sidebar-tip-content">
                                        <h4 class="sidebar-tip-title">
                                            <a href="@Url.Action("Details", "HealthTip", new { id = tip.HealthTipId })" 
                                               aria-label="مشاهده نکته سلامت: @tip.Title"
                                               tabindex="0">
                                                @tip.Title
                                            </a>
                                        </h4>
                                        @if (!string.IsNullOrEmpty(tip.Summary))
                                        {
                                            <p class="sidebar-tip-summary">@tip.Summary</p>
                                        }
                                    </div>
                                </article>
                            </li>
                        }
                    </ul>
                </div>
            </section>
        }

        @* Announcements Section *@
        @if (Model.Announcements != null && Model.Announcements.Any())
        {
            <section class="sidebar-card sidebar-announcements-card" 
                     aria-labelledby="announcementsTitle">
                <div class="sidebar-card-header">
                    <h3 id="announcementsTitle" class="sidebar-card-title">
                        <i class="fas fa-bullhorn" aria-hidden="true"></i>
                        <span>اعلانات</span>
                    </h3>
                </div>
                <div class="sidebar-card-content">
                    <ul class="sidebar-announcements-list" role="list">
                        @foreach (var announcement in Model.Announcements)
                        {
                            <li role="listitem">
                                <article class="sidebar-announcement-card">
                                    <h4 class="sidebar-announcement-title">
                                        <a href="@Url.Action("Details", "Announcement", new { id = announcement.AnnouncementId })" 
                                           aria-label="مشاهده اعلان: @announcement.Title"
                                           tabindex="0">
                                            @announcement.Title
                                        </a>
                                    </h4>
                                    @if (announcement.StartDate.HasValue)
                                    {
                                        <time class="sidebar-announcement-date" 
                                              datetime="@announcement.StartDate.Value.ToString("yyyy-MM-dd")"
                                              aria-label="تاریخ شروع: @announcement.StartDate.Value.ToString("yyyy/MM/dd")">
                                            @announcement.StartDate.Value.ToString("yyyy/MM/dd")
                                        </time>
                                    }
                                </article>
                            </li>
                        }
                    </ul>
                </div>
            </section>
        }

        @* Sidebar Sliders Section *@
        @if (Model.Sliders != null && Model.Sliders.Any())
        {
            <section class="sidebar-card sidebar-sliders-card" 
                     aria-labelledby="slidersTitle">
                <div class="sidebar-card-header">
                    <h3 id="slidersTitle" class="sidebar-card-title">
                        <i class="fas fa-images" aria-hidden="true"></i>
                        <span>تصاویر ویژه</span>
                    </h3>
                </div>
                <div class="sidebar-card-content">
                    <div class="sidebar-sliders-container">
                        @foreach (var slider in Model.Sliders)
                        {
                            <article class="sidebar-slider-card">
                                @if (!string.IsNullOrEmpty(slider.ImageUrl))
                                {
                                    <div class="sidebar-slider-image-wrapper">
                                        <img src="@slider.ImageUrl" 
                                             alt="@slider.Title"
                                             class="sidebar-slider-image"
                                             loading="lazy"
                                             aria-hidden="true">
                                    </div>
                                }
                                <div class="sidebar-slider-content">
                                    @if (!string.IsNullOrEmpty(slider.Title))
                                    {
                                        <h4 class="sidebar-slider-title">@slider.Title</h4>
                                    }
                                    @if (!string.IsNullOrEmpty(slider.Description))
                                    {
                                        <p class="sidebar-slider-description">@slider.Description</p>
                                    }
                                    @if (!string.IsNullOrEmpty(slider.LinkUrl))
                                    {
                                        <a href="@slider.LinkUrl" 
                                           class="sidebar-slider-link"
                                           aria-label="مشاهده بیشتر درباره @slider.Title"
                                           tabindex="0">
                                            <span>@(slider.ButtonText ?? "مشاهده بیشتر")</span>
                                            <i class="fas fa-arrow-left" aria-hidden="true"></i>
                                        </a>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </div>
            </section>
        }

    </aside>
}
