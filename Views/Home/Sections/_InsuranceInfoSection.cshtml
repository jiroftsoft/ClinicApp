@model List<ClinicApp.ViewModels.CMS.InsuranceInfoPublicViewModel>
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
    
    // Service خودش فقط Featured و Active را برمی‌گرداند
    // مرتب‌سازی بر اساس InsuranceInfoId
    var insurances = Model.OrderBy(i => i.InsuranceInfoId).ToList();
}

@* CSS و JS را مستقیماً در Partial View لود می‌کنیم چون @section در Partial View کار نمی‌کند *@
<link rel="stylesheet" href="@Url.Content("~/Content/plugins/Swiper/swiper-bundle.min.css")?v=@System.Configuration.ConfigurationManager.AppSettings["AppVersion"]&t=@DateTime.Now.Ticks" />
<link rel="stylesheet" href="@Url.Content("~/Content/css/insurance-info-section.css")?v=@System.Configuration.ConfigurationManager.AppSettings["AppVersion"]&t=@DateTime.Now.Ticks" />

<section class="insurance-info-section" aria-label="بیمه‌های طرف قرارداد">
    <div class="container">
        @* Header *@
        <div class="insurance-info-header">
            <h2 class="insurance-info-title">
                <i class="fas fa-shield-alt" aria-hidden="true"></i>
                بیمه‌های طرف قرارداد
            </h2>
            <p class="insurance-info-subtitle">همکاری رسمی با بیمه‌های معتبر کشور</p>
        </div>

        @* Linear Logo Slider *@
        <div class="insurance-logo-slider-wrapper">
            <div class="swiper insurance-logo-slider" id="insuranceLogoSlider">
                <div class="swiper-wrapper">
                    @foreach (var insurance in insurances)
                    {
                        <div class="swiper-slide">
                            @if (!string.IsNullOrEmpty(insurance.Slug))
                            {
                                <a href="@Url.Action("Details", "InsuranceInfo", new { slug = insurance.Slug })" 
                                   class="insurance-logo-item" 
                                   aria-label="مشاهده جزئیات @insurance.InsuranceName"
                                   title="@insurance.InsuranceName">
                                    <div class="insurance-logo-circle">
                                        @if (!string.IsNullOrEmpty(insurance.LogoUrl))
                                        {
                                            <img src="@insurance.LogoUrl" 
                                                 alt="@insurance.InsuranceName"
                                                 class="insurance-logo-image"
                                                 loading="lazy"
                                                 decoding="async"
                                                 onerror="this.onerror=null; this.src=''; this.parentElement.innerHTML='<div class=\'insurance-logo-fallback\'><i class=\'fas fa-shield-alt\'></i></div>';">
                                        }
                                        else if (!string.IsNullOrEmpty(insurance.ThumbnailUrl))
                                        {
                                            <img src="@insurance.ThumbnailUrl" 
                                                 alt="@insurance.InsuranceName"
                                                 class="insurance-logo-image"
                                                 loading="lazy"
                                                 decoding="async"
                                                 onerror="this.onerror=null; this.src=''; this.parentElement.innerHTML='<div class=\'insurance-logo-fallback\'><i class=\'fas fa-shield-alt\'></i></div>';">
                                        }
                                        else
                                        {
                                            <div class="insurance-logo-fallback">
                                                <i class="fas fa-shield-alt" aria-hidden="true"></i>
                                            </div>
                                        }
                                    </div>
                                </a>
                            }
                            else
                            {
                                <div class="insurance-logo-item" 
                                     aria-label="@insurance.InsuranceName"
                                     title="@insurance.InsuranceName">
                                    <div class="insurance-logo-circle">
                                        @if (!string.IsNullOrEmpty(insurance.LogoUrl))
                                        {
                                            <img src="@insurance.LogoUrl" 
                                                 alt="@insurance.InsuranceName"
                                                 class="insurance-logo-image"
                                                 loading="lazy"
                                                 decoding="async"
                                                 onerror="this.onerror=null; this.src=''; this.parentElement.innerHTML='<div class=\'insurance-logo-fallback\'><i class=\'fas fa-shield-alt\'></i></div>';">
                                        }
                                        else if (!string.IsNullOrEmpty(insurance.ThumbnailUrl))
                                        {
                                            <img src="@insurance.ThumbnailUrl" 
                                                 alt="@insurance.InsuranceName"
                                                 class="insurance-logo-image"
                                                 loading="lazy"
                                                 decoding="async"
                                                 onerror="this.onerror=null; this.src=''; this.parentElement.innerHTML='<div class=\'insurance-logo-fallback\'><i class=\'fas fa-shield-alt\'></i></div>';">
                                        }
                                        else
                                        {
                                            <div class="insurance-logo-fallback">
                                                <i class="fas fa-shield-alt" aria-hidden="true"></i>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Legal Notice *@
        <div class="insurance-legal-notice">
            <p class="insurance-legal-text">
                <i class="fas fa-info-circle" aria-hidden="true"></i>
                همکاری‌ها بر اساس قراردادهای رسمی و معتبر انجام می‌شود.
            </p>
        </div>
    </div>
</section>

<script>
    (function() {
        'use strict';
        
        // Dynamic loading of Swiper.js
        function loadSwiperScript(callback) {
            if (typeof Swiper !== 'undefined') {
                if (callback) callback();
                return;
            }
            var script = document.createElement('script');
            script.src = '@Url.Content("~/Content/plugins/Swiper/swiper-bundle.min.js")?v=@System.Configuration.ConfigurationManager.AppSettings["AppVersion"]&t=@DateTime.Now.Ticks';
            script.async = false;
            script.defer = false;
            script.onload = function() {
                console.log('✅ Swiper.js loaded successfully for Insurance Info');
                if (callback) callback();
            };
            script.onerror = function() {
                console.error('❌ Failed to load Swiper.js for Insurance Info');
            };
            document.head.appendChild(script);
        }
        
        function initInsuranceSlider() {
            const sliderElement = document.getElementById('insuranceLogoSlider');
            if (!sliderElement) {
                console.warn('Insurance logo slider element not found.');
                return;
            }
            
            if (typeof Swiper === 'undefined') {
                console.warn('Swiper.js is not loaded. Retrying in 500ms...');
                setTimeout(initInsuranceSlider, 500);
                return;
            }
            
            if (sliderElement.swiper) {
                console.log('Insurance logo slider already initialized.');
                return;
            }
            
            try {
                // ✅ شمارش تعداد slides برای تصمیم‌گیری در مورد loop mode
                const slides = sliderElement.querySelectorAll('.swiper-slide');
                const slidesCount = slides ? slides.length : 0;
                const shouldLoop = slidesCount > 6; // فقط اگر بیش از 6 slide باشد، loop فعال می‌شود
                
                const insuranceSlider = new Swiper('#insuranceLogoSlider', {
                    direction: 'horizontal',
                    loop: shouldLoop, // ✅ فقط اگر slides کافی باشد
                    rtl: true,
                    freeMode: true,
                    autoplay: {
                        delay: 4000, // 4 ثانیه - حرکت آهسته
                        disableOnInteraction: false,
                        pauseOnMouseEnter: true
                    },
                    speed: 3000, // سرعت حرکت آهسته (3 ثانیه)
                    slidesPerView: 'auto',
                    spaceBetween: 32,
                    grabCursor: false,
                    allowTouchMove: true,
                    breakpoints: {
                        320: {
                            slidesPerView: 3,
                            spaceBetween: 20
                        },
                        576: {
                            slidesPerView: 4,
                            spaceBetween: 24
                        },
                        768: {
                            slidesPerView: 5,
                            spaceBetween: 28
                        },
                        992: {
                            slidesPerView: 6,
                            spaceBetween: 32
                        },
                        1200: {
                            slidesPerView: 8,
                            spaceBetween: 40
                        }
                    },
                    // بدون Navigation و Pagination
                    navigation: false,
                    pagination: false,
                    // Accessibility
                    a11y: {
                        enabled: true,
                        prevSlideMessage: 'اسلاید قبلی',
                        nextSlideMessage: 'اسلاید بعدی'
                    }
                });
                
                console.log('✅ Insurance logo slider initialized successfully');
            } catch (error) {
                console.error('❌ Error initializing insurance logo slider:', error);
            }
        }
        
        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                loadSwiperScript(initInsuranceSlider);
            });
        } else {
            loadSwiperScript(initInsuranceSlider);
        }
    })();
</script>
