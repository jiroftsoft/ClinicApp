@model List<ClinicApp.ViewModels.CMS.InsuranceInfoPublicViewModel>
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
}

@* ============================================
   Professional Insurance Logo Carousel - Production Ready
   ============================================
   - Design: Clean, professional, medical-friendly
   - Technology: Swiper.js (Lightweight, Fast, RTL Support)
   - Features: Autoplay, Loop, Responsive, Touch Support
   - Performance: Optimized, Lazy Loading
   ============================================ *@

<section class="insurance-carousel-section" role="region" aria-label="بیمه‌های طرف قرارداد">
    <div class="insurance-carousel-container">
        @* Section Header *@
        <div class="carousel-section-header">
            <div class="header-icon-wrapper">
                <i class="fas fa-shield-alt" aria-hidden="true"></i>
            </div>
            <h2 class="carousel-section-title">
                <span>بیمه‌های طرف قرارداد</span>
            </h2>
            <p class="carousel-section-desc">
                مراکز درمانی ما با معتبرترین بیمه‌های کشور همکاری دارند
            </p>
        </div>

        @* Swiper Carousel *@
        <div class="insurance-carousel-wrapper">
            <div class="swiper insurance-logo-carousel" id="insuranceCarousel">
                <div class="swiper-wrapper">
                    @foreach (var insurance in Model.OrderBy(i => i.InsuranceInfoId))
                    {
                        <div class="swiper-slide">
                            <a href="@Url.Action("Details", "InsuranceInfo", new { slug = insurance.Slug })" 
                               class="insurance-logo-item"
                               aria-label="مشاهده جزئیات @insurance.InsuranceName"
                               title="@insurance.InsuranceName">
                                <div class="logo-image-wrapper">
                                    @if (!string.IsNullOrEmpty(insurance.LogoUrl))
                                    {
                                        <img src="@insurance.LogoUrl" 
                                             alt="@insurance.InsuranceName"
                                             class="insurance-logo-image"
                                             loading="lazy"
                                             decoding="async"
                                             onerror="this.onerror=null; this.src=''; this.parentElement.innerHTML='<div class=\'logo-fallback\'><i class=\'fas fa-shield-alt\'></i></div>';">
                                    }
                                    else if (!string.IsNullOrEmpty(insurance.ThumbnailUrl))
                                    {
                                        <img src="@insurance.ThumbnailUrl" 
                                             alt="@insurance.InsuranceName"
                                             class="insurance-logo-image"
                                             loading="lazy"
                                             decoding="async"
                                             onerror="this.onerror=null; this.src=''; this.parentElement.innerHTML='<div class=\'logo-fallback\'><i class=\'fas fa-shield-alt\'></i></div>';">
                                    }
                                    else
                                    {
                                        <div class="logo-fallback">
                                            <i class="fas fa-shield-alt" aria-hidden="true"></i>
                                            <span class="fallback-text">@insurance.InsuranceName</span>
                                        </div>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(insurance.InsuranceName))
                                {
                                    <div class="logo-name" aria-hidden="true">@insurance.InsuranceName</div>
                                }
                            </a>
                        </div>
                    }
                </div>
                
                @* Navigation Arrows (Optional - Hidden by default for clean look) *@
                <div class="swiper-button-next insurance-carousel-next" aria-label="بعدی"></div>
                <div class="swiper-button-prev insurance-carousel-prev" aria-label="قبلی"></div>
                
                @* Pagination (Optional - Hidden by default) *@
                <div class="swiper-pagination insurance-carousel-pagination"></div>
            </div>
        </div>

        @* View All Link *@
        <div class="carousel-section-footer">
            <a href="@Url.Action("Index", "InsuranceInfo")" 
               class="view-all-insurances-link"
               aria-label="مشاهده تمام بیمه‌های طرف قرارداد">
                <i class="fas fa-list" aria-hidden="true"></i>
                <span>مشاهده همه بیمه‌ها</span>
            </a>
        </div>
    </div>
</section>

@functions {
    private string GetTypeIcon(string insuranceType)
    {
        return insuranceType?.ToLower() switch
        {
            "basic" => "fas fa-shield-alt",
            "supplementary" => "fas fa-plus-circle",
            "private" => "fas fa-building",
            "government" => "fas fa-landmark",
            _ => "fas fa-info-circle"
        };
    }
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/plugins/Swiper/swiper-bundle.min.css")?v=@DateTime.Now.Ticks" />
    <link rel="stylesheet" href="@Url.Content("~/Content/css/insurance-carousel.css")?v=@DateTime.Now.Ticks" />
}

@section scripts {
    <script>
        // Dynamic loading with proper order and cache busting
        (function() {
            'use strict';
            
            // Check if already loaded
            if (window.insuranceCarouselLoaded) {
                return;
            }
            
            function loadSwiperScript(callback) {
                // Check if Swiper is already loaded
                if (typeof Swiper !== 'undefined') {
                    if (callback) callback();
                    return;
                }
                
                var script = document.createElement('script');
                script.src = '@Url.Content("~/Content/plugins/Swiper/swiper-bundle.min.js")?v=@DateTime.Now.Ticks&nocache=' + new Date().getTime();
                script.async = false;
                script.defer = false;
                script.onload = function() {
                    console.log('✅ Swiper.js loaded successfully');
                    if (callback) callback();
                };
                script.onerror = function() {
                    console.error('❌ Failed to load Swiper.js');
                };
                document.head.appendChild(script);
            }
            
            function loadCarouselScript() {
                var script = document.createElement('script');
                script.src = '@Url.Content("~/Content/js/insurance-carousel.js")?v=@DateTime.Now.Ticks&nocache=' + new Date().getTime();
                script.async = false;
                script.defer = false;
                document.body.appendChild(script);
                window.insuranceCarouselLoaded = true;
            }
            
            // Load Swiper first, then carousel script
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function() {
                    loadSwiperScript(loadCarouselScript);
                });
            } else {
                loadSwiperScript(loadCarouselScript);
            }
        })();
    </script>
}
