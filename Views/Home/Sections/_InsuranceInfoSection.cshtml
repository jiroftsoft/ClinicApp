@model List<ClinicApp.ViewModels.CMS.InsuranceInfoPublicViewModel>
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
    var insurances = Model.OrderBy(i => i.InsuranceInfoId).ToList();
    var displayCount = Math.Min(insurances.Count, 10);
    var forDisplay = insurances.Take(displayCount).ToList();
}
@* سکشن بیمه‌های طرف قرارداد — الگو: Mayo/Cleveland (Trust، نه CTA تهاجمی) *@
@* Logo Grid (نه Carousel)، Grayscale + Hover رنگی، متن راهنما *@

<div class="insurance-info-inner">
    <div class="container">
        <header class="insurance-info-header">
            <h2 class="insurance-info-title" id="insurance-section-heading">
                <i class="fas fa-shield-alt" aria-hidden="true"></i>
                بیمه‌های طرف قرارداد
            </h2>
            <p class="insurance-info-subtitle">همکاری رسمی با بیمه‌های معتبر کشور</p>
        </header>

        <div class="insurance-logo-grid" role="list" aria-label="لوگوهای بیمه‌های طرف قرارداد">
            @foreach (var insurance in forDisplay)
            {
                var tooltipText = insurance.InsuranceName + (string.IsNullOrEmpty(insurance.TypeDisplayName) ? "" : " — " + insurance.TypeDisplayName);
                if (!string.IsNullOrEmpty(insurance.Slug))
                {
                    <a href="@Url.Action("Details", "InsuranceInfo", new { slug = insurance.Slug })"
                       class="insurance-logo-item"
                       role="listitem"
                       aria-label="@("مشاهده جزئیات " + insurance.InsuranceName)"
                       title="@tooltipText">
                        <div class="insurance-logo-circle">
                            @if (!string.IsNullOrEmpty(insurance.LogoUrl))
                            {
                                <img src="@insurance.LogoUrl"
                                     alt="@(insurance.InsuranceName + " طرف قرارداد با کلینیک شفا")"
                                     class="insurance-logo-image"
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.onerror=null; this.style.display='none'; var n=this.nextElementSibling; if(n) n.style.display='flex';">
                            }
                            else if (!string.IsNullOrEmpty(insurance.ThumbnailUrl))
                            {
                                <img src="@insurance.ThumbnailUrl"
                                     alt="@(insurance.InsuranceName + " طرف قرارداد با کلینیک شفا")"
                                     class="insurance-logo-image"
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.onerror=null; this.style.display='none'; var n=this.nextElementSibling; if(n) n.style.display='flex';">
                            }
                            <div class="insurance-logo-fallback" style="@(string.IsNullOrEmpty(insurance.LogoUrl) && string.IsNullOrEmpty(insurance.ThumbnailUrl) ? "display: flex;" : "display: none;")">
                                <i class="fas fa-shield-alt" aria-hidden="true"></i>
                            </div>
                        </div>
                    </a>
                }
                else
                {
                    <div class="insurance-logo-item"
                         role="listitem"
                         aria-label="@insurance.InsuranceName"
                         title="@tooltipText">
                        <div class="insurance-logo-circle">
                            @if (!string.IsNullOrEmpty(insurance.LogoUrl))
                            {
                                <img src="@insurance.LogoUrl"
                                     alt="@(insurance.InsuranceName + " طرف قرارداد با کلینیک شفا")"
                                     class="insurance-logo-image"
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.onerror=null; this.style.display='none'; var n=this.nextElementSibling; if(n) n.style.display='flex';">
                            }
                            else if (!string.IsNullOrEmpty(insurance.ThumbnailUrl))
                            {
                                <img src="@insurance.ThumbnailUrl"
                                     alt="@(insurance.InsuranceName + " طرف قرارداد با کلینیک شفا")"
                                     class="insurance-logo-image"
                                     loading="lazy"
                                     decoding="async"
                                     onerror="this.onerror=null; this.style.display='none'; var n=this.nextElementSibling; if(n) n.style.display='flex';">
                            }
                            <div class="insurance-logo-fallback" style="@(string.IsNullOrEmpty(insurance.LogoUrl) && string.IsNullOrEmpty(insurance.ThumbnailUrl) ? "display: flex;" : "display: none;")">
                                <i class="fas fa-shield-alt" aria-hidden="true"></i>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <p class="insurance-legal-notice">
            <i class="fas fa-info-circle" aria-hidden="true"></i>
            برای اطلاع از جزئیات پوشش بیمه و خدمات مشمول، لطفاً قبل از مراجعه با پذیرش هماهنگ کنید.
        </p>
    </div>
</div>
