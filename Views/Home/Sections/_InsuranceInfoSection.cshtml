@model List<ClinicApp.ViewModels.CMS.InsuranceInfoPublicViewModel>
@{
    if (Model == null || !Model.Any())
    {
        return;
    }
}

<section class="insurance-info-section py-5" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="section-title mb-3">
                    <i class="fas fa-shield-alt text-primary"></i>
                    بیمه‌های طرف قرارداد
                </h2>
                <p class="section-subtitle text-muted">بیمه‌هایی که با کلینیک ما همکاری می‌کنند</p>
            </div>
        </div>

        <div class="row">
            @foreach (var insurance in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="card insurance-card h-100 shadow-sm border-0">
                        <div class="card-body text-center p-4">
                            @if (!string.IsNullOrEmpty(insurance.LogoUrl))
                            {
                                <img src="@insurance.LogoUrl" alt="@insurance.InsuranceName" class="mb-3" style="max-height: 80px; max-width: 100%; object-fit: contain;">
                            }
                            else if (!string.IsNullOrEmpty(insurance.ThumbnailUrl))
                            {
                                <img src="@insurance.ThumbnailUrl" alt="@insurance.InsuranceName" class="mb-3" style="max-height: 80px; max-width: 100%; object-fit: contain;">
                            }
                            else
                            {
                                <div class="mb-3">
                                    <i class="fas fa-shield-alt fa-3x text-primary"></i>
                                </div>
                            }
                            
                            <h5 class="card-title font-weight-bold mb-2">@insurance.InsuranceName</h5>
                            
                            <div class="mb-2">
                                <span class="badge badge-info">
                                    <i class="@GetTypeIcon(insurance.InsuranceType)"></i>
                                    @insurance.TypeDisplayName
                                </span>
                            </div>
                            
                            @if (insurance.CoveragePercentage.HasValue)
                            {
                                <div class="mb-3">
                                    <span class="badge badge-success badge-lg">
                                        <i class="fas fa-percentage"></i>
                                        پوشش @insurance.CoveragePercentage.Value%
                                    </span>
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(insurance.Description))
                            {
                                <p class="card-text text-muted small mb-3">
                                    @(insurance.Description.Length > 100 ? insurance.Description.Substring(0, 100) + "..." : insurance.Description)
                                </p>
                            }
                            
                            <div class="mt-auto">
                                <a href="@Url.Action("Details", "InsuranceInfo", new { slug = insurance.Slug })" class="btn btn-outline-primary btn-sm btn-block">
                                    <i class="fas fa-info-circle"></i> اطلاعات بیشتر
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row mt-4">
            <div class="col-12 text-center">
                <a href="@Url.Action("Index", "InsuranceInfo")" class="btn btn-primary btn-lg">
                    <i class="fas fa-list"></i> مشاهده همه بیمه‌ها
                </a>
            </div>
        </div>
    </div>
</section>

@functions {
    private string GetTypeIcon(string insuranceType)
    {
        return insuranceType switch
        {
            "basic" => "fas fa-shield-alt",
            "supplementary" => "fas fa-plus-circle",
            "private" => "fas fa-building",
            "government" => "fas fa-landmark",
            _ => "fas fa-info-circle"
        };
    }
}

<style>
    .insurance-info-section {
        position: relative;
        overflow: hidden;
    }

    .insurance-card {
        border-radius: 15px;
        transition: all 0.3s ease;
    }

    .insurance-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.2) !important;
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .section-subtitle {
        font-size: 1.1rem;
    }

    .badge-lg {
        font-size: 1rem;
        padding: 0.5rem 1rem;
    }

    @media (max-width: 768px) {
        .section-title {
            font-size: 2rem;
        }
    }
</style>

