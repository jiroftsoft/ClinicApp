@model ClinicApp.ViewModels.ContactSectionViewModel

<link rel="stylesheet" href="@Url.Content("~/Content/css/contact-section.css")" />

<section class="contact-section animate-fade-in" aria-label="اطلاعات تماس">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">@Model.SectionTitle</h2>
        </div>

        <!-- Emergency Contacts (Strongly-Typed) -->
        @if (Model.EmergencyContacts != null && Model.EmergencyContacts.Any())
        {
            <div class="row mb-5">
                <div class="col-12">
                    <div class="emergency-contacts-card">
                        <div class="card-header">
                            <h5>
                                <i class="fas fa-exclamation-triangle"></i>
                                تماس‌های اضطراری
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                @foreach (var contact in Model.EmergencyContacts)
                                {
                                    <div class="col-md-4 mb-3">
                                        <div class="emergency-contact-item">
                                            @if (!string.IsNullOrEmpty(contact.IconUrl))
                                            {
                                                <img src="@contact.IconUrl" 
                                                     alt="@contact.Title" 
                                                     class="contact-icon"
                                                     loading="lazy"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                                <div class="default-icon" style="display: none;">
                                                    <i class="fas fa-phone-alt"></i>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="default-icon">
                                                    <i class="fas fa-phone-alt"></i>
                                                </div>
                                            }
                                            <div class="contact-info">
                                                <div class="contact-title">@contact.Title</div>
                                                <a href="tel:@contact.PhoneNumber" 
                                                   class="btn btn-phone"
                                                   aria-label="تماس با @contact.Title - @contact.PhoneNumber">
                                                    <i class="fas fa-phone"></i> @contact.PhoneNumber
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-6 mb-4">
                @if (Model.ClinicInfo != null)
                {
                    <div class="clinic-info-card animate-in" style="animation-delay: 0.1s;">
                        <h3>@Model.ClinicInfo.Name</h3>
                        
                        <div class="clinic-info-item">
                            <i class="fas fa-map-marker-alt info-icon"></i>
                            <div class="info-content">
                                <strong>آدرس:</strong> @Model.ClinicInfo.Address
                            </div>
                        </div>
                        
                        <div class="clinic-info-item">
                            <i class="fas fa-phone info-icon"></i>
                            <div class="info-content">
                                <strong>تلفن:</strong> 
                                <a href="tel:@Model.ClinicInfo.PhoneNumber">@Model.ClinicInfo.PhoneNumber</a>
                            </div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.ClinicInfo.Email))
                        {
                            <div class="clinic-info-item">
                                <i class="fas fa-envelope info-icon"></i>
                                <div class="info-content">
                                    <strong>ایمیل:</strong> 
                                    <a href="mailto:@Model.ClinicInfo.Email">@Model.ClinicInfo.Email</a>
                                </div>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.ClinicInfo.WorkingHours))
                        {
                            <div class="clinic-info-item">
                                <i class="fas fa-clock info-icon"></i>
                                <div class="info-content">
                                    <strong>ساعات کاری:</strong> @Model.ClinicInfo.WorkingHours
                                </div>
                            </div>
                        }
                        
                        @if (Model.ClinicInfo.WorkingDays != null && Model.ClinicInfo.WorkingDays.Any())
                        {
                            <div class="mt-4">
                                <h5 class="mb-3" style="color: var(--heading-color); font-weight: 700;">ساعات کاری هفتگی:</h5>
                                <ul class="working-days-list">
                                    @foreach (var day in Model.ClinicInfo.WorkingDays)
                                    {
                                        <li>
                                            <span class="day-name">@day.DayName:</span>
                                            <span class="day-hours @(day.IsOpen ? "open" : "closed")">
                                                @day.Hours
                                            </span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.WhatsAppLink))
                        {
                            <div class="mt-4">
                                <a href="@Model.WhatsAppLink" 
                                   target="_blank" 
                                   rel="noopener noreferrer"
                                   class="btn btn-whatsapp"
                                   aria-label="تماس از طریق واتساپ">
                                    <i class="fab fa-whatsapp"></i> تماس از طریق واتساپ
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
            
            <div class="col-lg-6 mb-4">
                @if (!string.IsNullOrEmpty(Model.GoogleMapsEmbedUrl))
                {
                    <div class="maps-card animate-in" style="animation-delay: 0.2s;">
                        <iframe src="@Model.GoogleMapsEmbedUrl" 
                                width="100%" 
                                height="450" 
                                allowfullscreen="" 
                                loading="lazy" 
                                referrerpolicy="no-referrer-when-downgrade"
                                title="نقشه موقعیت کلینیک"
                                aria-label="نقشه موقعیت کلینیک">
                        </iframe>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

