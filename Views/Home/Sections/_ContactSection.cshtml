@model ClinicApp.ViewModels.ContactSectionViewModel

@* CSS در Index.cshtml لود می‌شود *@

<section class="contact-section-modern" aria-label="تماس با ما">
    <div class="container">
        @* Header Section *@
        <div class="contact-section-header">
            <h2 class="contact-section-title">@(Model.SectionTitle ?? "تماس با ما")</h2>
            <p class="contact-section-subtitle">
                در خدمت شما هستیم تا بهترین خدمات درمانی را دریافت کنید
            </p>
        </div>

        @* Main Content Grid *@
        <div class="contact-section-grid">
            @* Left Column: Clinic Information *@
            <div class="contact-info-column">
                @if (Model.ClinicInfo != null)
                {
                    @* Clinic Name Card *@
                    <div class="contact-info-card clinic-name-card">
                        <div class="contact-card-icon-wrapper">
                            <i class="fas fa-hospital" aria-hidden="true"></i>
                        </div>
                        <h3 class="clinic-name">@Model.ClinicInfo.Name</h3>
                    </div>

                    @* Address Card *@
                    <div class="contact-info-card">
                        <div class="contact-card-header">
                            <div class="contact-card-icon-wrapper">
                                <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                            </div>
                            <h4 class="contact-card-title">آدرس</h4>
                        </div>
                        <div class="contact-card-content">
                            <p class="contact-card-text">@Model.ClinicInfo.Address</p>
                            @if (!string.IsNullOrEmpty(Model.GoogleMapsLink))
                            {
                                <a href="@Model.GoogleMapsLink" 
                                   target="_blank" 
                                   rel="noopener noreferrer"
                                   class="contact-card-link"
                                   aria-label="مشاهده نقشه در Google Maps">
                                    <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                                    <span>مشاهده در نقشه</span>
                                </a>
                            }
                        </div>
                    </div>

                    @* Phone Card *@
                    if (!string.IsNullOrEmpty(Model.ClinicInfo.PhoneNumber))
                    {
                        <div class="contact-info-card">
                            <div class="contact-card-header">
                                <div class="contact-card-icon-wrapper">
                                    <i class="fas fa-phone" aria-hidden="true"></i>
                                </div>
                                <h4 class="contact-card-title">تلفن</h4>
                            </div>
                            <div class="contact-card-content">
                                <a href="tel:@Model.ClinicInfo.PhoneNumber.Replace("-", "").Replace(" ", "").Replace("(", "").Replace(")", "")" 
                                   class="contact-card-phone"
                                   aria-label="تماس: @Model.ClinicInfo.PhoneNumber">
                                    @Model.ClinicInfo.PhoneNumber
                                </a>
                            </div>
                        </div>
                    }

                    @* Email Card *@
                    if (!string.IsNullOrEmpty(Model.ClinicInfo.Email))
                    {
                        <div class="contact-info-card">
                            <div class="contact-card-header">
                                <div class="contact-card-icon-wrapper">
                                    <i class="fas fa-envelope" aria-hidden="true"></i>
                                </div>
                                <h4 class="contact-card-title">ایمیل</h4>
                            </div>
                            <div class="contact-card-content">
                                <a href="mailto:@Model.ClinicInfo.Email" 
                                   class="contact-card-email"
                                   aria-label="ارسال ایمیل به: @Model.ClinicInfo.Email">
                                    @Model.ClinicInfo.Email
                                </a>
                            </div>
                        </div>
                    }

                    @* Working Hours Card *@
                    if (Model.ClinicInfo.WorkingDays != null && Model.ClinicInfo.WorkingDays.Any())
                    {
                        <div class="contact-info-card working-hours-card">
                            <div class="contact-card-header">
                                <div class="contact-card-icon-wrapper">
                                    <i class="fas fa-clock" aria-hidden="true"></i>
                                </div>
                                <h4 class="contact-card-title">ساعات کاری</h4>
                            </div>
                            <div class="contact-card-content">
                                <div class="working-hours-table">
                                    @foreach (var day in Model.ClinicInfo.WorkingDays)
                                    {
                                        <div class="working-hours-row">
                                            <span class="working-day-name">@day.DayName</span>
                                            <span class="working-day-hours @(day.IsOpen ? "working-hours-open" : "working-hours-closed")">
                                                @if (day.IsOpen)
                                                {
                                                    <i class="fas fa-check-circle" aria-hidden="true"></i>
                                                    <span>@day.Hours</span>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-times-circle" aria-hidden="true"></i>
                                                    <span>تعطیل</span>
                                                }
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @* WhatsApp Button *@
                    if (!string.IsNullOrEmpty(Model.WhatsAppLink))
                    {
                        <div class="contact-info-card whatsapp-card">
                            <a href="@Model.WhatsAppLink" 
                               target="_blank" 
                               rel="noopener noreferrer"
                               class="whatsapp-button"
                               aria-label="تماس از طریق واتساپ">
                                <i class="fab fa-whatsapp" aria-hidden="true"></i>
                                <span>تماس از طریق واتساپ</span>
                            </a>
                        </div>
                    }
                }
            </div>

            @* Right Column: Map or Emergency Contacts *@
            <div class="contact-map-column">
                @* Google Maps *@
                @if (!string.IsNullOrEmpty(Model.GoogleMapsEmbedUrl))
                {
                    <div class="contact-map-card">
                        <div class="contact-map-header">
                            <h4 class="contact-map-title">
                                <i class="fas fa-map" aria-hidden="true"></i>
                                <span>موقعیت کلینیک</span>
                            </h4>
                        </div>
                        <div class="contact-map-wrapper">
                            <iframe src="@Model.GoogleMapsEmbedUrl" 
                                    width="100%" 
                                    height="100%"
                                    style="border:0; border-radius: 0 0 8px 8px;"
                                    allowfullscreen="" 
                                    loading="lazy" 
                                    referrerpolicy="no-referrer-when-downgrade"
                                    title="نقشه موقعیت کلینیک"
                                    aria-label="نقشه موقعیت کلینیک">
                            </iframe>
                        </div>
                    </div>
                }

                @* Emergency Contacts (اگر نقشه نباشد یا در کنار نقشه) *@
                @if (Model.EmergencyContacts != null && Model.EmergencyContacts.Any())
                {
                    <div class="contact-emergency-card">
                        <div class="contact-emergency-header">
                            <div class="contact-emergency-icon-wrapper">
                                <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                            </div>
                            <h4 class="contact-emergency-title">تماس‌های اضطراری</h4>
                        </div>
                        <div class="contact-emergency-content">
                            @foreach (var contact in Model.EmergencyContacts)
                            {
                                <div class="contact-emergency-item">
                                    <div class="emergency-item-icon">
                                        <i class="fas fa-phone-alt" aria-hidden="true"></i>
                                    </div>
                                    <div class="emergency-item-content">
                                        @if (!string.IsNullOrEmpty(contact.Title))
                                        {
                                            <span class="emergency-item-title">@contact.Title</span>
                                        }
                                        <a href="tel:@contact.PhoneNumber.Replace("-", "").Replace(" ", "").Replace("(", "").Replace(")", "")" 
                                           class="emergency-item-phone"
                                           aria-label="تماس اضطراری: @contact.PhoneNumber">
                                            @contact.PhoneNumber
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
