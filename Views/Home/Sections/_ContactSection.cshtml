@model ClinicApp.ViewModels.ContactSectionViewModel

<section class="contact-section mb-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="h1" style="color: var(--primary-color); font-weight: 700;">@Model.SectionTitle</h2>
        </div>

        <!-- Emergency Contacts (اگر در ViewBag موجود باشد) -->
        @if (ViewBag.EmergencyContacts != null)
        {
            <div class="row mb-5">
                <div class="col-12">
                    <div class="card border-danger shadow-sm">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-exclamation-triangle"></i>
                                تماس‌های اضطراری
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                @foreach (var contact in ViewBag.EmergencyContacts)
                                {
                                    <div class="col-md-4 mb-3">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(contact.IconUrl))
                                            {
                                                <img src="@contact.IconUrl" alt="@contact.Title" class="mr-3" style="max-height: 40px;">
                                            }
                                            else
                                            {
                                                <i class="fas fa-phone-alt fa-2x text-danger mr-3"></i>
                                            }
                                            <div>
                                                <strong>@contact.Title</strong>
                                                <br />
                                                <a href="tel:@contact.PhoneNumber" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-phone"></i> @contact.PhoneNumber
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            <div class="col-lg-6 mb-4">
                @if (Model.ClinicInfo != null)
                {
                    <div class="card h-100 p-4" style="border-radius: 16px;">
                        <h3 class="h4 mb-4" style="color: var(--primary-color);">@Model.ClinicInfo.Name</h3>
                        
                        <div class="mb-3">
                            <i class="fas fa-map-marker-alt text-primary me-2"></i>
                            <strong>آدرس:</strong> @Model.ClinicInfo.Address
                        </div>
                        
                        <div class="mb-3">
                            <i class="fas fa-phone text-primary me-2"></i>
                            <strong>تلفن:</strong> 
                            <a href="tel:@Model.ClinicInfo.PhoneNumber">@Model.ClinicInfo.PhoneNumber</a>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.ClinicInfo.Email))
                        {
                            <div class="mb-3">
                                <i class="fas fa-envelope text-primary me-2"></i>
                                <strong>ایمیل:</strong> 
                                <a href="mailto:@Model.ClinicInfo.Email">@Model.ClinicInfo.Email</a>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.ClinicInfo.WorkingHours))
                        {
                            <div class="mb-3">
                                <i class="fas fa-clock text-primary me-2"></i>
                                <strong>ساعات کاری:</strong> @Model.ClinicInfo.WorkingHours
                            </div>
                        }
                        
                        @if (Model.ClinicInfo.WorkingDays != null && Model.ClinicInfo.WorkingDays.Any())
                        {
                            <div class="mt-4">
                                <h5 class="mb-3">ساعات کاری هفتگی:</h5>
                                <ul class="list-unstyled">
                                    @foreach (var day in Model.ClinicInfo.WorkingDays)
                                    {
                                        <li class="mb-2">
                                            <strong>@day.DayName:</strong> 
                                            <span class="@(day.IsOpen ? "text-success" : "text-muted")">
                                                @day.Hours
                                            </span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(Model.WhatsAppLink))
                        {
                            <div class="mt-4">
                                <a href="@Model.WhatsAppLink" target="_blank" class="btn btn-success">
                                    <i class="fab fa-whatsapp me-2"></i> تماس از طریق واتساپ
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
            
            <div class="col-lg-6 mb-4">
                @if (!string.IsNullOrEmpty(Model.GoogleMapsEmbedUrl))
                {
                    <div class="card h-100" style="border-radius: 16px; overflow: hidden;">
                        <iframe src="@Model.GoogleMapsEmbedUrl" 
                                width="100%" 
                                height="450" 
                                style="border:0;" 
                                allowfullscreen="" 
                                loading="lazy" 
                                referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

