@model ClinicApp.ViewModels.TestimonialsSectionViewModel

<section class="testimonials-section mb-5" style="background: #f8fafc; border-radius: 20px; padding: 3rem 0;">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="h1" style="color: var(--primary-color); font-weight: 700;">@Model.SectionTitle</h2>
            <p class="lead text-muted" style="max-width: 700px; margin: 1rem auto;">
                @Model.SectionSubtitle
            </p>
        </div>

        <div class="row justify-content-center">
            @if (Model.Testimonials != null && Model.Testimonials.Any())
            {
                foreach (var testimonial in Model.Testimonials)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 p-4" style="border-radius: 16px; border: none; box-shadow: var(--shadow-sm);">
                            <div class="mb-3">
                                <i class="fas fa-quote-left" style="color: var(--primary-color); font-size: 1.8rem;"></i>
                            </div>
                            <p class="text-muted mb-4" style="line-height: 1.8; min-height: 120px; display: flex; align-items: center;">
                                "@testimonial.Comment"
                            </p>
                            <div class="d-flex align-items-center mt-auto">
                                <div class="me-3" style="width: 50px; height: 50px; border-radius: 50%; background: var(--primary-color); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                                    @testimonial.PatientInitials
                                </div>
                                <div>
                                    <h4 class="h6 mb-0" style="color: var(--primary-color);">@testimonial.PatientName</h4>
                                    <div class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Floor(testimonial.Rating))
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            else if (i - 0.5 <= (double)testimonial.Rating)
                                            {
                                                <i class="fas fa-star-half-alt"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star"></i>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

