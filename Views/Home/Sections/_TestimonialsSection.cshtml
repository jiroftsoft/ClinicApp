@model ClinicApp.ViewModels.TestimonialsSectionViewModel

@if (Model == null || Model.Testimonials == null || !Model.Testimonials.Any()) { return; }
<div class="testimonials-inner">
    <div class="container">
            <div class="testimonials-header">
                <h2 class="testimonials-title">@Model.SectionTitle</h2>
                <p class="testimonials-subtitle">@Model.SectionSubtitle</p>
            </div>

            @* Swiper Carousel - کنترل دستی (AutoPlay خاموش) *@
            <div class="swiper testimonials-carousel" id="testimonialsCarousel">
                <div class="swiper-wrapper">
                    @foreach (var testimonial in Model.Testimonials)
                    {
                        var tName = testimonial.PatientName ?? "";
                        var tFirst = tName.Split(' ').FirstOrDefault() ?? tName;
                        var tService = !string.IsNullOrEmpty(testimonial.DoctorName) ? testimonial.DoctorName : "خدمات کلینیک";
                        <div class="swiper-slide">
                            <article class="testimonial-card" tabindex="0" role="article" aria-label="نظر @tFirst درباره @tService">
                                @* 1. Rating (اختیاری) *@
                                @if (testimonial.Rating > 0)
                                {
                                    <div class="testimonial-rating" role="img" aria-label="امتیاز @testimonial.Rating از 5">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Floor(testimonial.Rating))
                                            {
                                                <i class="fas fa-star testimonial-rating-star filled" aria-hidden="true"></i>
                                            }
                                            else if (i - 0.5 <= (double)testimonial.Rating)
                                            {
                                                <i class="fas fa-star-half-alt testimonial-rating-star half" aria-hidden="true"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star testimonial-rating-star empty" aria-hidden="true"></i>
                                            }
                                        }
                                    </div>
                                }

                                @* 2. Comment (متن کوتاه - حداکثر 2-3 خط) *@
                                @if (!string.IsNullOrEmpty(testimonial.Comment))
                                {
                                    <p class="testimonial-comment">
                                        @{
                                            var comment = testimonial.Comment;
                                            var maxLength = 150; // حداکثر 2-3 خط
                                            if (comment.Length > maxLength)
                                            {
                                                comment = comment.Substring(0, maxLength) + "...";
                                            }
                                        }
                                        @comment
                                    </p>
                                }

                                @* 3. Patient Info (Privacy Friendly: نام کوچک + شهر/سن) *@
                                <div class="testimonial-patient-info">
                                    @{
                                        var patientName = testimonial.PatientName ?? "";
                                        var firstName = patientName.Split(' ').FirstOrDefault() ?? patientName;
                                        var serviceType = !string.IsNullOrEmpty(testimonial.DoctorName) ? testimonial.DoctorName : "خدمات کلینیک";
                                    }
                                    
                                    <div class="testimonial-avatar">
                                        @if (!string.IsNullOrEmpty(testimonial.PhotoUrl))
                                        {
                                            <img src="@testimonial.PhotoUrl" 
                                                 alt="@firstName" 
                                                 class="testimonial-avatar-image"
                                                 loading="lazy"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                            <div class="testimonial-avatar-fallback" style="display: none;">
                                                @testimonial.PatientInitials
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="testimonial-avatar-fallback">
                                                @testimonial.PatientInitials
                                            </div>
                                        }
                                    </div>
                                    
                                    <div class="testimonial-patient-details">
                                        <h3 class="testimonial-patient-name">@firstName</h3>
                                        <p class="testimonial-service-type" aria-label="نوع خدمت: @serviceType">
                                            @serviceType
                                        </p>
                                    </div>
                                </div>
                            </article>
                        </div>
                    }
                </div>

                @* Navigation Arrows *@
                <div class="swiper-button-next testimonials-carousel-next" aria-label="بعدی"></div>
                <div class="swiper-button-prev testimonials-carousel-prev" aria-label="قبلی"></div>

                @* Pagination *@
                <div class="swiper-pagination testimonials-carousel-pagination"></div>
            </div>

            @* Legal Notice *@
            <div class="testimonials-legal-notice">
                <p class="testimonials-legal-text">
                    <i class="fas fa-shield-alt" aria-hidden="true"></i>
                    نظرات منتشرشده پس از بررسی و بدون ذکر اطلاعات هویتی نمایش داده می‌شوند.
                </p>
            </div>
        </div>
</div>
@* CSS testimonials از باندل؛ Swiper CSS زیر *@
<link rel="stylesheet" href="@Url.Content("~/Content/js/plugins/Swiper/swiper-bundle.min.css")?v=@System.Configuration.ConfigurationManager.AppSettings["AppVersion"]" />

<script>
    (function() {
        'use strict';
        
        // Dynamic loading of Swiper.js
        function loadSwiperScript(callback) {
            if (typeof Swiper !== 'undefined') {
                if (callback) callback();
                return;
            }
            
            var script = document.createElement('script');
            script.src = '@Url.Content("~/Content/js/plugins/Swiper/swiper-bundle.min.js")?v=@System.Configuration.ConfigurationManager.AppSettings["AppVersion"]&t=@DateTime.Now.Ticks';
            script.async = false;
            script.defer = false;
            script.onload = function() { if (callback) callback(); };
            script.onerror = function() { };
            document.head.appendChild(script);
        }
        
        function initTestimonialsCarousel() {
            const carouselElement = document.getElementById('testimonialsCarousel');
            if (!carouselElement) return;
            
            if (typeof Swiper === 'undefined') {
                setTimeout(initTestimonialsCarousel, 500);
                return;
            }
            if (carouselElement.swiper) return;
            
            try {
                const testimonialsCarousel = new Swiper('#testimonialsCarousel', {
                    direction: 'horizontal',
                    loop: false, // بدون Loop برای رسمی بودن
                    rtl: true, // Right-to-Left for Persian
                    
                    // Autoplay خاموش (طبق درخواست کاربر)
                    autoplay: false,
                    
                    speed: 600,
                    
                    // Slides per view (Responsive)
                    slidesPerView: 1,
                    spaceBetween: 24,
                    
                    breakpoints: {
                        320: {
                            slidesPerView: 1,
                            spaceBetween: 16,
                        },
                        768: {
                            slidesPerView: 2,
                            spaceBetween: 20,
                        },
                        992: {
                            slidesPerView: 3,
                            spaceBetween: 24,
                        }
                    },
                    
                    // Navigation
                    navigation: {
                        nextEl: '.testimonials-carousel-next',
                        prevEl: '.testimonials-carousel-prev',
                    },
                    
                    // Pagination
                    pagination: {
                        el: '.testimonials-carousel-pagination',
                        clickable: true,
                        dynamicBullets: true,
                    },
                    
                    // Keyboard Control
                    keyboard: {
                        enabled: true,
                        onlyInViewport: true,
                    },
                    
                    // Accessibility
                    a11y: {
                        enabled: true,
                        prevSlideMessage: 'اسلاید قبلی',
                        nextSlideMessage: 'اسلاید بعدی',
                        paginationBulletMessage: 'برو به اسلاید {{index}}',
                    }
                });
            } catch (e) { }
        }
        
        // Load Swiper first, then initialize carousel
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
                loadSwiperScript(initTestimonialsCarousel);
            });
        } else {
            loadSwiperScript(initTestimonialsCarousel);
        }
    })();
</script>
