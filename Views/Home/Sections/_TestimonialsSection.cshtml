@model ClinicApp.ViewModels.TestimonialsSectionViewModel
@{
    if (Model == null || Model.Testimonials == null || !Model.Testimonials.Any()) { return; }
    var items = Model.Testimonials.Take(6).ToList();
}
@* سکشن نظرات بیماران — الگو: دکترتو، پذیرش۲۴، دیجی‌کالا (Social Proof) *@
@* Grid دسکتاپ ۳ کارت، موبایل Swipe با scroll-snap، بدون Swiper، حداکثر ۶ نظر *@

<div class="testimonials-inner">
    <div class="testimonials-container">
        <header class="testimonials-header">
            <h2 class="testimonials-title" id="testimonials-section-heading">
                <i class="fas fa-quote-right" aria-hidden="true"></i>
                @(Model.SectionTitle ?? "نظرات بیماران ما")
            </h2>
            <p class="testimonials-subtitle">@(Model.SectionSubtitle ?? "تجربه مراجعه بیماران به کلینیک شفا")</p>
        </header>

        <div class="testimonials-grid-wrap" role="list" aria-label="نظرات بیماران">
            <div class="testimonials-grid" id="testimonialsGrid">
                @foreach (var t in items)
                {
                    var rawComment = (t.Comment ?? "").Trim();
                    var comment = rawComment.Length > 150 ? rawComment.Substring(0, 150).Trim() + "…" : rawComment;
                    var displayName = !string.IsNullOrEmpty(t.PatientInitials)
                        ? t.PatientInitials
                        : GetPartialName(t.PatientName);
                    var serviceLabel = !string.IsNullOrEmpty(t.DoctorName)
                        ? "مراجعه به " + t.DoctorName
                        : "خدمات کلینیک";
                    <article class="testimonial-card" role="listitem" aria-labelledby="testimonial-quote-@t.TestimonialId">
                        @if (t.Rating > 0)
                        {
                            <div class="testimonial-stars" role="img" aria-label="امتیاز @t.Rating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) از ۵">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Floor((double)t.Rating))
                                    { <i class="fas fa-star testimonial-star filled" aria-hidden="true"></i> }
                                    else if (i - 0.5 <= (double)t.Rating)
                                    { <i class="fas fa-star-half-alt testimonial-star half" aria-hidden="true"></i> }
                                    else
                                    { <i class="far fa-star testimonial-star empty" aria-hidden="true"></i> }
                                }
                            </div>
                        }
                        <blockquote class="testimonial-quote @(string.IsNullOrEmpty(comment) ? "testimonial-quote--empty" : "")" id="testimonial-quote-@t.TestimonialId">
                            @(string.IsNullOrEmpty(comment) ? "\u00A0" : (object)comment)
                        </blockquote>
                        <div class="testimonial-author">
                            <div class="testimonial-avatar">
                                @if (!string.IsNullOrEmpty(t.PhotoUrl))
                                {
                                    <img src="@t.PhotoUrl" alt="" class="testimonial-avatar-img" loading="lazy" decoding="async" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <span class="testimonial-avatar-initials" style="display: none;" aria-hidden="true">@(t.PatientInitials ?? displayName)</span>
                                }
                                else
                                {
                                    <span class="testimonial-avatar-initials" aria-hidden="true">@(t.PatientInitials ?? displayName)</span>
                                }
                            </div>
                            <div class="testimonial-meta">
                                <span class="testimonial-name">@displayName</span>
                                <span class="testimonial-service" aria-label="نوع مراجعه">@serviceLabel</span>
                            </div>
                        </div>
                        @if (t.IsVerified)
                        {
                            <span class="testimonial-verified" aria-label="بیمار تأییدشده">
                                <i class="fas fa-check-circle" aria-hidden="true"></i>
                                بیمار تأییدشده
                            </span>
                        }
                    </article>
                }
            </div>
        </div>

        <p class="testimonials-legal">
            <i class="fas fa-shield-alt" aria-hidden="true"></i>
            نظرات پس از بررسی و بدون ذکر اطلاعات هویتی نمایش داده می‌شوند.
        </p>
    </div>
</div>

@functions {
    private string GetPartialName(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "بیمار";
        var parts = fullName.Trim().Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "بیمار";
        if (parts.Length == 1) return parts[0].Length > 1 ? parts[0].Substring(0, 1) + "." : parts[0];
        return parts[0] + ". " + (parts[1].Length > 0 ? parts[1].Substring(0, 1) : "");
    }
}
