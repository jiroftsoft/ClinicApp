@{
    ViewBag.Title = "ورود / ثبت‌نام";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<div class="login-form-container">
                <p id="card-subtitle" class="text-center text-muted mb-4" style="font-size: 0.95rem;">برای ادامه لطفاً کد ملی خود را وارد کنید</p>

                <div id="step-national-code">
                    @using (Html.BeginForm("CheckUser", "Account", FormMethod.Post, new { id = "form-check-user" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label for="NationalCode" class="form-label">کد ملی</label>
                            <input type="tel" id="NationalCode" name="NationalCode" class="form-control text-center" maxlength="10" autocomplete="off" placeholder="کد ملی ۱۰ رقمی خود را وارد کنید" />
                            <div class="text-danger d-block mt-1" data-valmsg-for="NationalCode"></div>
                        </div>
                        <div class="d-grid mt-3">
                            <button type="submit" class="btn btn-primary">
                                <span class="button-text">ادامه</span>
                                <span class="spinner"></span>
                            </button>
                        </div>
                    }
                </div>

                <div id="step-register-phone" style="display:none;">
                    <p id="register-prompt" class="text-center text-info mb-3"></p>
                    @using (Html.BeginForm("SendRegistrationOtp", "Account", FormMethod.Post, new { id = "form-send-reg-otp" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="NationalCode" />
                        <div class="form-group">
                            <label for="PhoneNumber" class="form-label">شماره موبایل</label>
                            <input type="tel" id="PhoneNumber" name="PhoneNumber" class="form-control" placeholder="مثال: ۰۹۱۲۳۴۵۶۷۸۹" />
                            <div class="text-danger d-block mt-1" data-valmsg-for="PhoneNumber"></div>
                        </div>
                        <div class="d-grid mt-3">
                            <button type="submit" class="btn btn-primary">
                                <span class="button-text">ارسال کد تایید</span>
                                <span class="spinner"></span>
                            </button>
                        </div>
                    }
                </div>

                <div id="step-otp" style="display:none;">
                    <p id="otp-prompt" class="text-center text-success mb-3"></p>
                    @using (Html.BeginForm("VerifyLoginOtp", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { id = "form-verify-otp" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="NationalCode" />
                        <input type="hidden" name="PhoneNumber" />
                        <input type="hidden" id="combined-otp-code" name="OtpCode" />
                        <div class="form-group text-center">
                            <label for="otp-input-1" class="form-label">کد تایید</label>
                            <div id="otp-inputs" class="d-flex justify-content-center gap-2" dir="ltr">
                                <input type="tel" id="otp-input-1" class="form-control otp-input text-center" maxlength="1" />
                                <input type="tel" id="otp-input-2" class="form-control otp-input text-center" maxlength="1" />
                                <input type="tel" id="otp-input-3" class="form-control otp-input text-center" maxlength="1" />
                                <input type="tel" id="otp-input-4" class="form-control otp-input text-center" maxlength="1" />
                                <input type="tel" id="otp-input-5" class="form-control otp-input text-center" maxlength="1" />
                                <input type="tel" id="otp-input-6" class="form-control otp-input text-center" maxlength="1" />
                            </div>
                            <div id="otp-error" class="text-danger mt-2"></div>
                        </div>
                        <div class="d-grid mt-3">
                            <button type="submit" class="btn btn-success">
                                <span class="button-text">تایید و ورود</span>
                                <span class="spinner"></span>
                            </button>
                        </div>
                        <div class="text-center mt-3">
                            <span id="countdown-timer"></span>
                            <a href="#" id="resend-otp-link" style="display: none;">ارسال مجدد کد</a>
                        </div>
                    }
                </div>

            </div>
</div>

@section Scripts {
    @Html.Partial("_ValidationToasts")
    <script>
    (function ($) {
        // --- CONFIG & STATE ---
        const RESEND_TIMER_SECONDS = 120;
        let state = { nationalCode: '', phoneNumber: '', isRegistrationFlow: false };
        let countdownInterval;

        // --- UI ELEMENTS & INITIALIZATION ---
        const ui = {
            panels: {
                nationalCode: $('#step-national-code'),
                registerPhone: $('#step-register-phone'),
                otp: $('#step-otp')
            },
            forms: {
                checkUser: $('#form-check-user'),
                sendRegOtp: $('#form-send-reg-otp'),
                verifyOtp: $('#form-verify-otp')
            },
            otpInputs: $('.otp-input'),
            otpError: $('#otp-error'),
            hiddenOtpInput: $('#combined-otp-code'),
            countdownTimer: $('#countdown-timer'),
            resendLink: $('#resend-otp-link'),
            init: function() {
                this.bindForms();
                this.bindOtpInputs();
            },
            showPanel: function(panel) {
                Object.values(this.panels).forEach(p => p.hide());
                panel.fadeIn();
            },
            bindForms: function() {
                ui.forms.checkUser.on('submit', handleCheckUserSubmit);
                ui.forms.sendRegOtp.on('submit', handleSendRegOtpSubmit);
                ui.forms.verifyOtp.on('submit', handleVerifyOtpSubmit);
                ui.resendLink.on('click', handleResendOtp);
            },
            bindOtpInputs: function() {
                this.otpInputs.on('input', function() {
                    const $this = $(this);
                    if ($this.val().length === 1 && $this.next('.otp-input').length) {
                        $this.next('.otp-input').focus();
                    }
                    
                    // ✅ ADDED: Auto-submit on typing 6th digit
                    let otp = '';
                    ui.otpInputs.each(function() { otp += $(this).val(); });
                    if (otp.length === 6) {
                        ui.otpInputs.last().blur();
                        console.log('⚡ DEBUG: Auto-submitting form (Input/Type)...');
                        ui.forms.verifyOtp.trigger('submit');
                    }
                }).on('keydown', function(e) {
                    if (e.key === "Backspace" && $(this).val().length === 0 && $(this).prev('.otp-input').length) {
                        $(this).prev('.otp-input').focus();
                    }
                }).on('paste', function(e) {
                    e.preventDefault();
                    const pasteData = (e.originalEvent.clipboardData || window.clipboardData).getData('text');
                    const digits = pasteData.replace(/\D/g, '');
                    if (digits.length > 0) {
                        ui.otpInputs.each(function(i) {
                            if (i < digits.length) $(this).val(digits[i]);
                        });
                        
                        const lastInput = ui.otpInputs.eq(Math.min(5, digits.length - 1));
                        lastInput.focus();
                        if (digits.length >= 6) {
                            lastInput.blur();
                            console.log('⚡ DEBUG: Auto-submitting form (Paste)...');
                            // ✅ CRITICAL FIX: Use trigger('submit') instead of .submit()
                            // .submit() bypasses jQuery event handlers (causing page refresh)
                            // .trigger('submit') ensures handleVerifyOtpSubmit is called (AJAX)
                            ui.forms.verifyOtp.trigger('submit');
                        }
                    }
                });
            }
        };

        // --- CORE EVENT HANDLERS ---
        function handleCheckUserSubmit(e) {
            e.preventDefault();
            console.log('🔍 DEBUG: handleCheckUserSubmit called');
            const form = $(this);
            state.nationalCode = form.find('#NationalCode').val();
            console.log('🔍 DEBUG: NationalCode extracted:', state.nationalCode ? state.nationalCode.substring(0, 3) + '****' : 'null');
            
            if (state.nationalCode.length !== 10 || !/^\d{10}$/.test(state.nationalCode)) {
                console.warn('⚠️ DEBUG: Invalid NationalCode format');
                $('[data-valmsg-for="NationalCode"]').text('کد ملی باید ۱۰ رقم باشد.');
                return;
            }
            $('[data-valmsg-for="NationalCode"]').text('');

            submitAjax(form,
                // onSuccess Callback
                (response) => {
                    console.log('✅ DEBUG: handleCheckUserSubmit onSuccess - Response:', response);
                    // ✅ CRITICAL FIX: بررسی code برای تشخیص نوع کاربر
                    if (response && response.code === 'USER_ALREADY_EXISTS') {
                        // کاربر موجود است - باید لاگین کند
                        console.log('✅ DEBUG: User already exists, calling sendLoginOtp');
                        state.isRegistrationFlow = false;
                        toastr.info(response.message);
                        // ✅ اطمینان از اینکه spinner قبلی بسته شده است
                        const button = form.find('button[type="submit"]');
                        showButtonSpinner(button, false);
                        // ✅ فراخوانی sendLoginOtp با کمی تاخیر برای اطمینان از بسته شدن spinner
                        setTimeout(() => {
                            console.log('⏰ DEBUG: Executing sendLoginOtp after timeout');
                            sendLoginOtp();
                        }, 100);
                    } else if (response && response.code === 'USER_IS_NEW') {
                        // کاربر جدید است - باید ثبت‌نام کند
                        console.log('✅ DEBUG: New user, showing registration form');
                        state.isRegistrationFlow = true;
                        toastr.success(response.message);
                        $('#card-subtitle').text("این کد ملی ثبت‌نام نشده. لطفاً شماره موبایل خود را وارد کنید.");
                        ui.forms.sendRegOtp.find('input[name="NationalCode"]').val(state.nationalCode);
                        ui.showPanel(ui.panels.registerPhone);
                        $('#PhoneNumber').focus();
                    } else {
                        // Fallback برای سایر موارد
                        console.log('✅ DEBUG: Fallback case - showing success message');
                        toastr.success(response && response.message ? response.message : "عملیات موفقیت‌آمیز بود!");
                    }
                },
                // onError Callback (برای خطاهای واقعی)
                (response) => {
                    console.error('❌ DEBUG: handleCheckUserSubmit onError - Response:', response);
                    const errorMessage = response && response.message ? response.message : "خطایی رخ داده است.";
                    toastr.error(errorMessage);
                }
            );
        }

        function handleSendRegOtpSubmit(e) {
            e.preventDefault();
            const form = $(this);
            state.phoneNumber = form.find('#PhoneNumber').val();
            submitAjax(form, response => {
                toastr.success(response.message);
                $('#otp-prompt').html(`کد تایید به شماره <strong>${state.phoneNumber}</strong> ارسال شد.`);
                ui.forms.verifyOtp.find('input[name="NationalCode"]').val(state.nationalCode);
                ui.forms.verifyOtp.find('input[name="PhoneNumber"]').val(state.phoneNumber);
                ui.showPanel(ui.panels.otp);
                ui.otpInputs.first().focus();
                startCountdown();
            });
        }

        function handleVerifyOtpSubmit(e) {
            console.log('🛡️ DEBUG: handleVerifyOtpSubmit called! Preventing default...');
            e.preventDefault();
            const form = $(this);
            let otp = '';
            ui.otpInputs.each(function() { otp += $(this).val(); });
            ui.hiddenOtpInput.val(otp);

            if (otp.length !== 6) {
                ui.otpError.text('کد تایید باید ۶ رقم باشد.');
                return;
            }
            ui.otpError.text('');

            const actionUrl = state.isRegistrationFlow ? '@Url.Action("VerifyRegistrationOtp", "Account")' : '@Url.Action("VerifyLoginOtp", "Account")';
            form.attr('action', actionUrl);
            
            console.log('🔍 DEBUG: Submitting OTP form', {
                actionUrl: actionUrl,
                isRegistrationFlow: state.isRegistrationFlow,
                nationalCode: state.nationalCode
            });

            submitAjax(form, response => {
                console.log('✅ DEBUG: AJAX Success Response:', response);
                
                if(response.success && response.redirectUrl) {
                    console.log('✅ DEBUG: Login successful, redirecting to:', response.redirectUrl);
                    toastr.success(response.message || "عملیات موفقیت‌آمیز بود!");
                    
                    // ✅ ENHANCED FIX: Add delay to ensure cookie is fully set before redirect
                    // This gives OWIN middleware time to process the authentication cookie
                    setTimeout(function() {
                        console.log('🔄 DEBUG: Executing redirect NOW to:', response.redirectUrl);
                        // ✅ Use window.location.href for cleaner redirect
                        // This ensures browser fully processes the cookie before loading new page
                        window.location.href = response.redirectUrl;
                    }, 800); // Increased delay to 800ms for better reliability
                } else {
                    console.error('❌ DEBUG: Response missing success or redirectUrl:', response);
                }
            }, response => {
                console.error('❌ DEBUG: AJAX Error Response:', response);
                ui.otpError.text(response.message);
                ui.otpInputs.val('').first().focus();
            });
        }

        function handleResendOtp(e) {
            e.preventDefault();
            if (state.isRegistrationFlow) {
                ui.forms.sendRegOtp.submit();
            } else {
                sendLoginOtp();
            }
        }

        // --- HELPER FUNCTIONS ---
        function sendLoginOtp() {
            // ✅ اطمینان از اینکه nationalCode تنظیم شده است
            if (!state.nationalCode || state.nationalCode.length !== 10) {
                console.error('❌ DEBUG: Invalid nationalCode in sendLoginOtp', state.nationalCode);
                toastr.error("کد ملی معتبر نیست. لطفاً دوباره تلاش کنید.");
                return;
            }

            const token = ui.forms.checkUser.find('input[name="__RequestVerificationToken"]').val();
            if (!token) {
                console.error('❌ DEBUG: Missing anti-forgery token in sendLoginOtp');
                toastr.error("خطای امنیتی. لطفاً صفحه را رفرش کنید.");
                return;
            }

            const data = {
                __RequestVerificationToken: token,
                NationalCode: state.nationalCode
            };
            const button = ui.panels.nationalCode.find('button[type="submit"]');
            showButtonSpinner(button, true);

            console.log('📤 DEBUG: SendLoginOtp Request Starting', {
                url: '@Url.Action("SendLoginOtp", "Account")',
                nationalCode: state.nationalCode ? state.nationalCode.substring(0, 3) + '****' : 'null'
            });

            $.ajax({
                url: '@Url.Action("SendLoginOtp", "Account")',
                type: 'POST',
                data: data,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function(response) {
                    console.log('📥 DEBUG: SendLoginOtp Response Received:', response);
                    showButtonSpinner(button, false);
                    if(response && response.success) {
                        $('#otp-prompt').text("کد ورود به شماره موبایل ثبت شده شما ارسال شد.");
                        ui.forms.verifyOtp.find('input[name="NationalCode"]').val(state.nationalCode);
                        ui.showPanel(ui.panels.otp);
                        ui.otpInputs.first().focus();
                        startCountdown();
                    } else {
                        const errorMessage = response && response.message ? response.message : "خطا در ارسال کد ورود.";
                        console.error('❌ DEBUG: SendLoginOtp failed', {response, errorMessage});
                        toastr.error(errorMessage);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('💥 DEBUG: SendLoginOtp AJAX Error:', {
                        xhr: xhr,
                        status: status,
                        error: error,
                        responseText: xhr.responseText,
                        statusCode: xhr.status
                    });
                    showButtonSpinner(button, false);
                    let errorMessage = "خطا در ارتباط با سرور. لطفاً دوباره تلاش کنید.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = xhr.responseJSON.message;
                    }
                    toastr.error(errorMessage);
                },
                complete: function() {
                    showButtonSpinner(button, false);
                }
            });
        }

        function submitAjax(form, onSuccess, onError) {
            // ✅ CRITICAL FIX: بررسی validation قبل از ارسال
            if (!form.valid()) {
                console.warn('⚠️ DEBUG: Form validation failed', form.validate().errorList);
                return;
            }
            const button = form.find('button[type="submit"]');
            showButtonSpinner(button, true);
            
            const ajaxUrl = form.attr('action');
            const ajaxData = form.serialize();
            
            console.log('📤 DEBUG: AJAX Request Starting', {
                url: ajaxUrl,
                data: ajaxData,
                hasXRequestedWith: true
            });

            $.ajax({
                url: ajaxUrl,
                type: 'POST',
                data: ajaxData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'  // ✅ CRITICAL FIX: Ensure Request.IsAjaxRequest() returns true
                },
                success: function(response) {
                    console.log('📥 DEBUG: AJAX Response Received:', response);
                    showButtonSpinner(button, false); // ✅ CRITICAL FIX: بستن spinner در success
                    if (response && response.success) {
                        if (onSuccess) {
                            onSuccess(response);
                        } else {
                            toastr.success(response.message || "عملیات موفقیت‌آمیز بود!");
                        }
                    } else {
                        if (onError) {
                            onError(response);
                        } else {
                            toastr.error(response && response.message ? response.message : "خطایی رخ داده است.");
                        }
                    }
                },
                error: (xhr, status, error) => {
                    console.error('💥 DEBUG: AJAX Error:', {xhr, status, error, responseText: xhr.responseText});
                    showButtonSpinner(button, false); // ✅ CRITICAL FIX: بستن spinner در error
                    toastr.error("خطای شبکه یا سرور. لطفاً دقایقی دیگر تلاش کنید.");
                },
                complete: () => {
                    // ✅ CRITICAL FIX: اطمینان از بسته شدن spinner در complete
                    showButtonSpinner(button, false);
                }
            });
        }

        function showButtonSpinner(button, show) {
            button.prop('disabled', show);
            const textSpan = button.find('.button-text');
            const spinnerSpan = button.find('.spinner');
            if (show) {
                textSpan.hide();
                spinnerSpan.addClass('spinner-border spinner-border-sm');
            } else {
                textSpan.show();
                spinnerSpan.removeClass('spinner-border spinner-border-sm');
            }
        }

        function startCountdown() {
            clearInterval(countdownInterval);
            ui.resendLink.hide();
            ui.countdownTimer.show();
            let timer = RESEND_TIMER_SECONDS;

            const updateTimer = () => {
                const minutes = Math.floor(timer / 60);
                const seconds = timer % 60;
                ui.countdownTimer.text(`ارسال مجدد کد تا ${minutes}:${seconds.toString().padStart(2, '0')} دیگر`);
            };

            updateTimer();
            countdownInterval = setInterval(() => {
                timer--;
                if (timer < 0) {
                    clearInterval(countdownInterval);
                    ui.countdownTimer.hide();
                    ui.resendLink.show();
                } else {
                    updateTimer();
                }
            }, 1000);
        }

        // --- INITIALIZE THE SCRIPT ---
        ui.init();

    })(jQuery);
    </script>
}