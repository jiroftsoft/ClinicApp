@{
    ViewBag.Title = "ورود / ثبت‌نام";
    Layout = null;
}

<div class="login-form-container">
    <p id="card-subtitle" class="text-center text-muted mb-4" style="font-size: 0.95rem;">برای ادامه لطفاً کد ملی خود را وارد کنید</p>

    <div id="step-national-code">
        @using (Html.BeginForm("CheckUser", "Account", FormMethod.Post, new { id = "form-check-user" }))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="NationalCode" class="form-label">کد ملی</label>
                <input type="tel" id="NationalCode" name="NationalCode" class="form-control text-center" maxlength="10" autocomplete="off" placeholder="کد ملی ۱۰ رقمی خود را وارد کنید" />
                <div class="text-danger d-block mt-1" id="national-code-error" data-valmsg-for="NationalCode"></div>
                <small class="form-text text-muted" id="national-code-hint" style="display: none;"></small>
            </div>
            <div class="d-grid mt-3">
                <button type="submit" class="btn btn-primary">
                    <span class="button-text">ادامه</span>
                    <span class="spinner"></span>
                </button>
            </div>
        }
    </div>

    <div id="step-register-phone" style="display:none;">
        <p id="register-prompt" class="text-center text-info mb-3"></p>
        @using (Html.BeginForm("SendRegistrationOtp", "Account", FormMethod.Post, new { id = "form-send-reg-otp" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="NationalCode" />
            <div class="form-group">
                <label for="PhoneNumber" class="form-label">شماره موبایل</label>
                <input type="tel" id="PhoneNumber" name="PhoneNumber" class="form-control" placeholder="مثال: ۰۹۱۲۳۴۵۶۷۸۹" maxlength="11" dir="ltr" />
                <div class="text-danger d-block mt-1" id="phone-number-error" data-valmsg-for="PhoneNumber"></div>
                <small class="form-text text-muted" id="phone-number-hint" style="display: none;"></small>
            </div>
            <div class="d-grid mt-3">
                <button type="submit" class="btn btn-primary">
                    <span class="button-text">ارسال کد تایید</span>
                    <span class="spinner"></span>
                </button>
            </div>
        }
    </div>

    <div id="step-otp" style="display:none;">
        <p id="otp-prompt" class="text-center text-success mb-3"></p>
        @using (Html.BeginForm("VerifyLoginOtp", "Account", FormMethod.Post, new { id = "form-verify-otp" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="NationalCode" />
            <input type="hidden" name="PhoneNumber" />
            <input type="hidden" id="combined-otp-code" name="OtpCode" />
            if (!string.IsNullOrEmpty(ViewBag.ReturnUrl))
            {
                <text>
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                </text>
            }
            <div class="form-group text-center">
                <label for="otp-input-1" class="form-label">کد تایید</label>
                <div id="otp-inputs" class="d-flex justify-content-center gap-2" dir="ltr">
                    <input type="tel" id="otp-input-1" class="form-control otp-input text-center" maxlength="1" />
                    <input type="tel" id="otp-input-2" class="form-control otp-input text-center" maxlength="1" />
                    <input type="tel" id="otp-input-3" class="form-control otp-input text-center" maxlength="1" />
                    <input type="tel" id="otp-input-4" class="form-control otp-input text-center" maxlength="1" />
                    <input type="tel" id="otp-input-5" class="form-control otp-input text-center" maxlength="1" />
                    <input type="tel" id="otp-input-6" class="form-control otp-input text-center" maxlength="1" />
                </div>
                <div id="otp-error" class="text-danger mt-2"></div>
            </div>
            <div class="d-grid mt-3">
                <button type="submit" class="btn btn-success">
                    <span class="button-text">تایید و ورود</span>
                    <span class="spinner"></span>
                </button>
            </div>
            <div class="text-center mt-3">
                <span id="countdown-timer"></span>
                <a href="#" id="resend-otp-link" style="display: none;">ارسال مجدد کد</a>
                <p class="text-muted small mt-2" id="resend-hint" style="display: none;">
                    در صورت عدم دریافت، پس از پایان زمان می‌توانید مجدداً درخواست دهید.
                </p>
            </div>
        }
    </div>
</div>

@Html.Partial("_ValidationToasts")
<script>
    (function ($) {
        // --- CONFIG & STATE ---
        var config = {
            otpLength: 6,
            countdownSeconds: 120
        };
        
        var state = {
            countdownInterval: null,
            remainingSeconds: 0,
            isRegistrationFlow: false, // ✅ Track whether we're in registration or login flow
            nationalCode: null, // ✅ Store national code for registration
            phoneNumber: null, // ✅ Store phone number for registration
            failedAttempts: 0 // ✅ Track failed OTP attempts for incremental delay
        };

        // --- UTILITY FUNCTIONS ---
        function showButtonSpinner(button, show) {
            var $button = $(button);
            var $spinner = $button.find('.spinner');
            var $text = $button.find('.button-text');
            
            if (show) {
                $spinner.addClass('spinner-border spinner-border-sm');
                $text.hide();
                $button.prop('disabled', true);
            } else {
                $spinner.removeClass('spinner-border spinner-border-sm');
                $text.show();
                $button.prop('disabled', false);
            }
        }
        
        // ✅ Helper function for displaying user-friendly error messages (مکتب خونه style)
        function showErrorMessage(response, defaultMessage) {
            if (!response) {
                toastr.error(defaultMessage || 'خطایی رخ داده است. لطفاً دوباره تلاش کنید.');
                return;
            }
            
            var message = response.message || defaultMessage || 'خطایی رخ داده است.';
            var code = response.code;
            
            // ✅ Map error codes to user-friendly messages (مکتب خونه style)
            var errorMessages = {
                'DUPLICATE_PHONE_NUMBER': 'این شماره موبایل قبلاً در سیستم ثبت شده است. لطفاً شماره دیگری وارد کنید یا با این شماره وارد شوید.',
                'INVALID_PHONE_NUMBER': 'شماره موبایل وارد شده معتبر نیست. لطفاً شماره موبایل خود را به درستی وارد کنید.',
                'INVALID_NATIONAL_CODE': 'کد ملی وارد شده معتبر نیست. لطفاً کد ملی ۱۰ رقمی خود را وارد کنید.',
                'USER_NOT_FOUND': 'کاربری با این مشخصات یافت نشد. لطفاً اطلاعات خود را بررسی کنید.',
                'OTP_INVALID_OR_EXPIRED': 'کد تایید نامعتبر یا منقضی شده است. لطفاً کد جدیدی دریافت کنید.',
                'OTP_ATTEMPTS_EXCEEDED': 'تعداد تلاش‌های شما برای وارد کردن کد تایید بیش از حد مجاز است. لطفاً کد جدیدی دریافت کنید.',
                'RATE_LIMIT_EXCEEDED': 'تعداد درخواست‌های شما بیش از حد مجاز است. لطفاً چند دقیقه صبر کنید و دوباره تلاش کنید.',
                'ACCOUNT_LOCKED': 'حساب کاربری شما به دلیل تلاش‌های ناموفق متعدد قفل شده است. لطفاً بعداً تلاش کنید.',
                'SYSTEM_ERROR': 'خطای سیستمی رخ داده است. لطفاً با پشتیبانی تماس بگیرید.',
                'PHONE_MISMATCH': 'اطلاعات تایید نامعتبر است. لطفاً دوباره تلاش کنید.'
            };
            
            // ✅ Use mapped message if available, otherwise use response message
            var finalMessage = errorMessages[code] || message;
            
            // ✅ Display with appropriate styling (مکتب خونه style: clear, friendly, actionable)
            toastr.error(finalMessage, '', {
                timeOut: 5000, // ✅ Show longer for important errors
                closeButton: true,
                progressBar: true,
                positionClass: 'toast-top-center'
            });
        }

        function resetForm(formId) {
            $('#' + formId)[0].reset();
            $('#' + formId + ' .text-danger').text('');
            $('#' + formId + ' [data-valmsg-for]').text('');
        }
        
        // ✅ OPTIMIZATION: Real-time phone number formatting (09xx) - Digikala style
        function formatPhoneNumber(value) {
            if (!value) return '';
            
            // Remove all non-digits
            var digits = value.replace(/\D/g, '');
            
            // Auto-add 0 if starts with 9
            if (digits.length > 0 && digits.charAt(0) === '9' && !digits.startsWith('09')) {
                digits = '0' + digits;
            }
            
            // Limit to 11 digits (09xxxxxxxxx)
            if (digits.length > 11) {
                digits = digits.substring(0, 11);
            }
            
            return digits;
        }
        
        // ✅ OPTIMIZATION: Real-time national code validation
        function validateNationalCode(value, updateInput) {
            // Default: update input only if explicitly requested (to prevent infinite loops)
            if (typeof updateInput === 'undefined') {
                updateInput = false;
            }
            
            if (!value) {
                $('#NationalCode').removeClass('is-invalid is-valid');
                $('#national-code-error').text('');
                $('#national-code-hint').hide();
                return false;
            }
            
            var $input = $('#NationalCode');
            var $error = $('#national-code-error');
            var $hint = $('#national-code-hint');
            
            // Remove all non-digits
            var digits = value.replace(/\D/g, '');
            
            // Limit to 10 digits
            if (digits.length > 10) {
                digits = digits.substring(0, 10);
            }
            
            // Update input value only if explicitly requested (prevents infinite loop)
            if (updateInput && $input.val() !== digits) {
                $input.val(digits);
            }
            
            // Real-time validation
            if (digits.length === 0) {
                $input.removeClass('is-invalid is-valid');
                $error.text('');
                $hint.hide();
                return false;
            } else if (digits.length < 10) {
                $input.addClass('is-invalid').removeClass('is-valid');
                $error.text('کد ملی باید ۱۰ رقم باشد');
                $hint.text('در حال وارد کردن: ' + digits.length + ' / ۱۰');
                $hint.show().removeClass('text-success').addClass('text-muted');
                return false;
            } else if (digits.length === 10) {
                // Basic format validation (all digits same = invalid)
                if (/^(\d)\1{9}$/.test(digits)) {
                    $input.addClass('is-invalid').removeClass('is-valid');
                    $error.text('کد ملی معتبر نیست');
                    $hint.hide();
                    return false;
                } else {
                    $input.addClass('is-valid').removeClass('is-invalid');
                    $error.text('');
                    $hint.text('✓ فرمت صحیح است');
                    $hint.show().removeClass('text-muted').addClass('text-success');
                    return true;
                }
            }
            
            return false;
        }
        
        // ✅ OPTIMIZATION: Real-time phone number validation
        function validatePhoneNumber(value, updateInput) {
            // Default: update input only if explicitly requested (to prevent infinite loops)
            if (typeof updateInput === 'undefined') {
                updateInput = false;
            }
            
            if (!value) {
                $('#PhoneNumber').removeClass('is-invalid is-valid');
                $('#phone-number-error').text('');
                $('#phone-number-hint').hide();
                return false;
            }
            
            var $input = $('#PhoneNumber');
            var $error = $('#phone-number-error');
            var $hint = $('#phone-number-hint');
            
            // Format phone number
            var formatted = formatPhoneNumber(value);
            
            // Update input value only if explicitly requested (prevents infinite loop)
            if (updateInput && $input.val() !== formatted) {
                $input.val(formatted);
            }
            
            // Real-time validation
            if (formatted.length === 0) {
                $input.removeClass('is-invalid is-valid');
                $error.text('');
                $hint.hide();
                return false;
            } else if (!formatted.startsWith('09')) {
                $input.addClass('is-invalid').removeClass('is-valid');
                $error.text('شماره موبایل باید با ۰۹ شروع شود');
                $hint.text('در حال وارد کردن: ' + formatted);
                $hint.show().removeClass('text-success').addClass('text-muted');
                return false;
            } else if (formatted.length < 11) {
                $input.addClass('is-invalid').removeClass('is-valid');
                $error.text('شماره موبایل باید ۱۱ رقم باشد');
                $hint.text('در حال وارد کردن: ' + formatted.length + ' / ۱۱');
                $hint.show().removeClass('text-success').addClass('text-muted');
                return false;
            } else if (formatted.length === 11) {
                // Validate mobile operator (09xx where xx is 10-99)
                var operator = formatted.substring(2, 4);
                if (operator < '10' || operator > '99') {
                    $input.addClass('is-invalid').removeClass('is-valid');
                    $error.text('شماره موبایل معتبر نیست');
                    $hint.hide();
                    return false;
                } else {
                    $input.addClass('is-valid').removeClass('is-invalid');
                    $error.text('');
                    $hint.text('✓ فرمت صحیح است');
                    $hint.show().removeClass('text-muted').addClass('text-success');
                    return true;
                }
            }
            
            return false;
        }

        // --- STEP MANAGEMENT ---
        function showStep(stepId) {
            $('[id^="step-"]').hide();
            $('#' + stepId).show();
        }

        // --- OTP HANDLING - Delegated to OTPManager (SRP Compliance) ---
        function setupOtpInputs() {
            // Use OTPManager if available (SRP: Single Responsibility)
            if (typeof window.OTPManager !== 'undefined') {
                window.OTPManager.init();
                return;
            }
            
            // Fallback: Basic implementation if OTPManager not loaded
            var $inputs = $('#otp-inputs .otp-input');
            $inputs.off('input keydown paste keyup focus');
            
            $inputs.on('input', function() {
                var $this = $(this);
                var value = $this.val().replace(/\D/g, '');
                if (value.length > 1) value = value.charAt(0);
                $this.val(value);
                
                if (value.length === 1) {
                    var index = $inputs.index($this);
                    if (index < $inputs.length - 1) {
                        setTimeout(function() { $inputs.eq(index + 1).focus(); }, 50);
                    } else {
                        updateCombinedOtp();
                    }
                } else {
                    updateCombinedOtp();
                }
            });
            
            $inputs.on('keydown', function(e) {
                var $this = $(this);
                var index = $inputs.index($this);
                var value = $this.val();
                
                if (e.key === 'ArrowLeft' && index > 0) {
                    e.preventDefault();
                    $inputs.eq(index - 1).focus();
                } else if (e.key === 'ArrowRight' && index < $inputs.length - 1) {
                    e.preventDefault();
                    $inputs.eq(index + 1).focus();
                } else if (e.key === 'Backspace') {
                    if (value === '' && index > 0) {
                        e.preventDefault();
                        $inputs.eq(index - 1).val('').focus();
                        updateCombinedOtp();
                    } else if (value !== '') {
                        $this.val('');
                        updateCombinedOtp();
                    }
                } else if (!/^\d$/.test(e.key) && !['Delete', 'Tab', 'Enter'].includes(e.key)) {
                    e.preventDefault();
                }
            });
            
            $inputs.on('paste', function(e) {
                e.preventDefault();
                var digits = (e.originalEvent.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').substring(0, config.otpLength);
                if (digits.length > 0) {
                    $inputs.val('');
                    digits.split('').forEach(function(digit, i) {
                        if (i < $inputs.length) $inputs.eq(i).val(digit);
                    });
                    $inputs.eq(Math.min(digits.length - 1, $inputs.length - 1)).focus();
                    updateCombinedOtp();
                }
            });
            
            $inputs.on('keyup focus', function() {
                updateCombinedOtp();
                if ($(this).val()) $(this).select();
            });
        }

        function updateCombinedOtp() {
            var otp = $('#otp-inputs .otp-input').map(function() {
                return $(this).val();
            }).get().join('');
            
            // Ensure only digits
            otp = otp.replace(/\D/g, '');
            
            $('#combined-otp-code').val(otp);
            
            // Auto-submit when complete (only if all 6 digits entered)
            if (otp.length === config.otpLength) {
                // Small delay to ensure value is set
                setTimeout(function() {
                    $('#form-verify-otp').submit();
                }, 100);
            }
        }

        // --- COUNTDOWN TIMER ---
        function startCountdown() {
            state.remainingSeconds = config.countdownSeconds;
            var minutes = Math.floor(state.remainingSeconds / 60);
            var seconds = state.remainingSeconds % 60;
            $('#countdown-timer').text('ارسال مجدد کد تا ' + minutes + ':' + (seconds < 10 ? '0' : '') + seconds);
            $('#resend-otp-link').hide();
            $('#resend-hint').show(); // ✅ Show hint message
            
            if (state.countdownInterval) {
                clearInterval(state.countdownInterval);
            }
            
            state.countdownInterval = setInterval(function() {
                state.remainingSeconds--;
                
                if (state.remainingSeconds > 0) {
                    var minutes = Math.floor(state.remainingSeconds / 60);
                    var seconds = state.remainingSeconds % 60;
                    $('#countdown-timer').text('ارسال مجدد کد تا ' + minutes + ':' + (seconds < 10 ? '0' : '') + seconds);
                } else {
                    clearInterval(state.countdownInterval);
                    $('#countdown-timer').text('');
                    $('#resend-otp-link').show();
                    $('#resend-hint').hide(); // ✅ Hide hint when resend is available
                }
            }, 1000);
        }

        // --- FORM SUBMISSIONS ---
        // Use event delegation to ensure handler works even after dynamic content load
        $(document).off('submit', '#form-check-user').on('submit', '#form-check-user', function(e) {
            e.preventDefault();
            var $form = $(this);
            var $button = $form.find('button[type="submit"]');
            var nationalCode = $('#NationalCode').val().trim();
            
            // ✅ OPTIMIZATION: Clear previous errors
            $form.find('.text-danger').text('');
            $form.find('[data-valmsg-for]').text('');
            $('#NationalCode').removeClass('is-invalid is-valid');
            
            // ✅ OPTIMIZATION: Validate before submit
            if (!nationalCode) {
                $('#NationalCode').addClass('is-invalid');
                $('#national-code-error').text('لطفاً کد ملی خود را وارد کنید.');
                showErrorMessage(null, 'لطفاً کد ملی خود را وارد کنید.');
                return;
            }
            
            // ✅ OPTIMIZATION: Validate format
            if (!validateNationalCode(nationalCode)) {
                $('#NationalCode').addClass('is-invalid');
                showErrorMessage(null, 'کد ملی وارد شده معتبر نیست.');
                return;
            }
            
            showButtonSpinner($button, true);
            
            $.ajax({
                url: $form.attr('action'),
                method: 'POST',
                data: $form.serialize(),
                dataType: 'json', // Ensure JSON parsing
                success: function(response) {
                    // ✅ Handle USER_ALREADY_EXISTS - کاربر موجود است، باید لاگین کند (MUST be first check)
                    if (response && response.code === 'USER_ALREADY_EXISTS') {
                        // ✅ Reset registration flow state for login
                        state.isRegistrationFlow = false;
                        state.nationalCode = $('#NationalCode').val();
                        
                        showButtonSpinner($button, false);
                        $button.prop('disabled', false);
                        sendLoginOtp();
                        return;
                    }
                    
                    // Handle USER_IS_NEW (success: true) - ✅ Start registration flow
                    if (response.success && response.code === 'USER_IS_NEW') {
                        // ✅ Set registration flow state
                        state.isRegistrationFlow = true;
                        state.nationalCode = $('#NationalCode').val();
                        
                        showStep('step-register-phone');
                        $('#register-prompt').text(response.message || 'برای ثبت‌نام شماره موبایل خود را وارد کنید');
                        $('input[name="NationalCode"]').val(state.nationalCode);
                        showButtonSpinner($button, false);
                        $button.prop('disabled', false);
                        
                        // ✅ Focus phone number input
                        setTimeout(function() {
                            $('#PhoneNumber').focus();
                        }, 100);
                        return;
                    }
                    
                    // ✅ Handle SUCCESS code (fallback for backward compatibility)
                    if (response.success && response.code === 'SUCCESS' && response.message && response.message.indexOf('ثبت نام') !== -1) {
                        // This is likely a registration flow response
                        state.isRegistrationFlow = true;
                        state.nationalCode = $('#NationalCode').val();
                        
                        showStep('step-register-phone');
                        $('#register-prompt').text(response.message || 'برای ثبت‌نام شماره موبایل خود را وارد کنید');
                        $('input[name="NationalCode"]').val(state.nationalCode);
                        showButtonSpinner($button, false);
                        $button.prop('disabled', false);
                        
                        setTimeout(function() {
                            $('#PhoneNumber').focus();
                        }, 100);
                        return;
                    }
                    
                    // Handle validation errors
                    if (response.errors && Object.keys(response.errors).length > 0) {
                        $.each(response.errors, function(field, messages) {
                            var $errorContainer = $form.find('[data-valmsg-for="' + field + '"]');
                            if ($errorContainer.length) {
                                $errorContainer.text(messages[0] || 'خطا در این فیلد');
                            }
                        });
                        showButtonSpinner($button, false);
                        $button.prop('disabled', false);
                        return;
                    }
                    
                    // ✅ Handle other errors with user-friendly messages
                    if (!response.success) {
                        showErrorMessage(response, 'خطا در بررسی کد ملی');
                        showButtonSpinner($button, false);
                        $button.prop('disabled', false);
                        return;
                    }
                    
                    showButtonSpinner($button, false);
                    $button.prop('disabled', false);
                },
                error: function(xhr, status, error) {
                    console.error('CheckUser AJAX Error:', { xhr: xhr, status: status, error: error });
                    if (xhr.status === 400) {
                        try {
                            var errorResponse = JSON.parse(xhr.responseText);
                            if (errorResponse.errors) {
                                $.each(errorResponse.errors, function(field, messages) {
                                    var $errorContainer = $form.find('[data-valmsg-for="' + field + '"]');
                                    if ($errorContainer.length) {
                                        $errorContainer.text(messages[0] || 'خطا در این فیلد');
                                    }
                                });
                            } else {
                                showErrorMessage(errorResponse, 'خطا در بررسی کد ملی');
                            }
                        } catch (e) {
                            showErrorMessage(null, 'خطا در بررسی کد ملی');
                        }
                    } else {
                        showErrorMessage(null, 'خطا در ارتباط با سرور. لطفاً اتصال اینترنت خود را بررسی کنید.');
                    }
                    showButtonSpinner($button, false);
                    $button.prop('disabled', false);
                },
                complete: function() {
                    // Spinner handled in each branch
                }
            });
        });

        // Rate limiting state for sendLoginOtp
        var sendOtpCooldown = false;
        var sendOtpCooldownTimer = null;

        function sendLoginOtp() {
            // ✅ Reset registration flow state for login
            state.isRegistrationFlow = false;
            
            var nationalCode = $('#NationalCode').val() || state.nationalCode;
            
            if (!nationalCode || nationalCode.length !== 10) {
                showErrorMessage({ code: 'INVALID_NATIONAL_CODE', message: 'کد ملی معتبر نیست. لطفاً کد ملی ۱۰ رقمی خود را وارد کنید.' });
                return;
            }
            
            // ✅ Store national code in state
            state.nationalCode = nationalCode;
            
            // Check cooldown
            if (sendOtpCooldown) {
