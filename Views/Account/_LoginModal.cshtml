                        }
                    } else if (xhr.status === 429) {
                        $('#otp-error').text('تعداد درخواست‌ها بیش از حد مجاز است. لطفاً چند لحظه صبر کنید.');
                    } else {
                        showErrorMessage(null, 'خطا در ارتباط با سرور. لطفاً اتصال اینترنت خود را بررسی کنید.');
                    }
                    // Clear and focus first input
                    $('#otp-inputs .otp-input').val('');
                    $('#combined-otp-code').val('');
                    $('#otp-inputs .otp-input:first').focus();
                    updateCombinedOtp();
                    showButtonSpinner($button, false);
                    $button.prop('disabled', false);
                    // ✅ Reset submission flag
                    isSubmitting = false;
                }
            });
        });

        $('#resend-otp-link').on('click', function(e) {
            e.preventDefault();
            var $link = $(this);
            
            // ✅ OPTIMIZATION: Prevent resend during countdown
            if (state.remainingSeconds > 0) {
                toastr.warning('در صورت عدم دریافت، پس از پایان زمان می‌توانید مجدداً درخواست دهید.');
                return;
            }
            
            // ✅ Get values from state or form
            var nationalCode = state.nationalCode || $('input[name="NationalCode"]').val() || $('#NationalCode').val();
            var phoneNumber = state.phoneNumber || $('input[name="PhoneNumber"]').val() || $('#PhoneNumber').val();
            
            if (!nationalCode) {
                showErrorMessage(null, 'کد ملی یافت نشد. لطفاً دوباره تلاش کنید.');
                return;
            }
            
            // ✅ OPTIMIZATION: Disable link during request and show loading state
            $link.prop('disabled', true).css('opacity', '0.6').text('در حال ارسال...');
            
            // ✅ Determine flow type: registration if phoneNumber exists or state.isRegistrationFlow is true
            if (state.isRegistrationFlow || phoneNumber) {
                // Resend registration OTP
                if (!phoneNumber) {
                    showErrorMessage(null, 'شماره موبایل یافت نشد. لطفاً دوباره تلاش کنید.');
                    $link.prop('disabled', false).css('opacity', '1');
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("SendRegistrationOtp", "Account")',
                    method: 'POST',
                    dataType: 'json',
                    data: { 
                        NationalCode: nationalCode, 
                        PhoneNumber: phoneNumber,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success) {
                            toastr.success('کد تایید مجدداً ارسال شد');
                            // Clear OTP inputs
                            $('#otp-inputs .otp-input').val('');
                            $('#combined-otp-code').val('');
                            $('#otp-error').text('');
                            state.failedAttempts = 0; // ✅ Reset failed attempts on resend
                            startCountdown(); // ✅ Restart countdown after resend
                            // Focus first OTP input
                            setTimeout(function() {
                                $('#otp-inputs .otp-input:first').focus();
                            }, 100);
                        } else {
                            showErrorMessage(response, 'خطا در ارسال مجدد کد');
                        }
                        $link.prop('disabled', false).css('opacity', '1').text('ارسال مجدد کد');
                    },
                    error: function(xhr, status, error) {
                        console.error('ResendRegistrationOtp AJAX Error:', { xhr: xhr, status: status, error: error });
                        if (xhr.status === 429) {
                            showErrorMessage({ code: 'RATE_LIMIT_EXCEEDED', message: 'تعداد درخواست‌های شما بیش از حد مجاز است. لطفاً چند دقیقه صبر کنید و دوباره تلاش کنید.' });
                        } else {
                            showErrorMessage(null, 'خطا در ارسال مجدد کد. لطفاً دوباره تلاش کنید.');
                        }
                        $link.prop('disabled', false).css('opacity', '1').text('ارسال مجدد کد');
                    }
                });
            } else {
                // Resend login OTP
                sendLoginOtp();
                $link.prop('disabled', false).css('opacity', '1').text('ارسال مجدد کد');
            }
        });

        // ✅ OPTIMIZATION: Setup real-time validation for National Code
        var isUpdatingNationalCode = false; // Flag to prevent infinite loops
        $(document).on('input', '#NationalCode', function() {
            if (isUpdatingNationalCode) return; // Prevent infinite loop
            
            var $this = $(this);
            var value = $this.val();
            
            // Remove non-digits and limit length
            var digits = value.replace(/\D/g, '');
            if (digits.length > 10) {
                digits = digits.substring(0, 10);
            }
            
            // Update input value only if changed
            if ($this.val() !== digits) {
                isUpdatingNationalCode = true;
                $this.val(digits);
                isUpdatingNationalCode = false;
            }
            
            // Validate
            validateNationalCode(digits, false);
        });
        
        $(document).on('blur', '#NationalCode', function() {
            var value = $(this).val();
            validateNationalCode(value, false);
        });
        
        // ✅ OPTIMIZATION: Setup real-time formatting and validation for Phone Number
        var isUpdatingPhoneNumber = false; // Flag to prevent infinite loops
        $(document).on('input', '#PhoneNumber', function() {
            if (isUpdatingPhoneNumber) return; // Prevent infinite loop
            
            var $this = $(this);
            var value = $this.val();
            
            // Format phone number
            var formatted = formatPhoneNumber(value);
            
            // Update input value only if changed
            if ($this.val() !== formatted) {
                isUpdatingPhoneNumber = true;
                $this.val(formatted);
                isUpdatingPhoneNumber = false;
            }
            
            // Validate
            validatePhoneNumber(formatted, false);
        });
        
        $(document).on('blur', '#PhoneNumber', function() {
            var value = $(this).val();
            validatePhoneNumber(value, false);
        });
        
        // ✅ OPTIMIZATION: Prevent paste of invalid characters
        $(document).on('paste', '#NationalCode, #PhoneNumber', function(e) {
            var $this = $(this);
            setTimeout(function() {
                var value = $this.val();
                if ($this.attr('id') === 'NationalCode') {
                    validateNationalCode(value, false);
                } else if ($this.attr('id') === 'PhoneNumber') {
                    validatePhoneNumber(value, false);
                }
            }, 10);
        });
        
        // Initialize when DOM is ready
        $(document).ready(function() {
            setupOtpInputs();
            
            // ✅ OPTIMIZATION: Focus first input on load
            setTimeout(function() {
                $('#NationalCode').focus();
            }, 100);
        });
    })(jQuery);
</script>

