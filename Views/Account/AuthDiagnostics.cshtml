@{
    ViewBag.Title = "Authentication Diagnostics";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Auth Diagnostics</title>
    <style>
        body { font-family: monospace; padding: 20px; background: #f5f5f5; }
        .section { background: white; padding: 15px; margin: 10px 0; border-radius: 5px; }
        .success { color: green; }
        .error { color: red; }
        .warning { color: orange; }
        h3 { margin-top: 0; }
    </style>
</head>
<body>
    <h1>🔍 Authentication Diagnostics</h1>
    
    <div class="section">
        <h3>1. Request.IsAuthenticated</h3>
        <p class="@(Request.IsAuthenticated ? "success" : "error")">
            @Request.IsAuthenticated
        </p>
    </div>
    
    <div class="section">
        <h3>2. User.Identity.IsAuthenticated</h3>
        <p class="@(User.Identity.IsAuthenticated ? "success" : "error")">
            @User.Identity.IsAuthenticated
        </p>
    </div>
    
    <div class="section">
        <h3>3. User.Identity.Name</h3>
        <p>@(User.Identity.Name ?? "NULL")</p>
    </div>
    
    <div class="section">
        <h3>4. OWIN Context</h3>
        @{
            var owinContext = HttpContext.Current?.GetOwinContext();
            var owinUser = owinContext?.Authentication?.User;
            var isOwinAuth = owinUser != null && owinUser.Identity.IsAuthenticated;
        }
        <p class="@(isOwinAuth ? "success" : "error")">
            OWIN Authenticated: @isOwinAuth<br/>
            OWIN Name: @(owinUser?.Identity?.Name ?? "NULL")
        </p>
    </div>
    
    <div class="section">
        <h3>5. Authentication Cookies</h3>
        @{
            var authCookie = Request.Cookies[".AspNet.ApplicationCookie"];
            var customCookie = Request.Cookies["ClinicAppAuth"];
        }
        <p>
            .AspNet.ApplicationCookie: @(authCookie != null ? "EXISTS" : "NOT FOUND")<br/>
            ClinicAppAuth: @(customCookie != null ? "EXISTS" : "NOT FOUND")
        </p>
    </div>
    
    <div class="section">
        <h3>6. Claims</h3>
        @if (User.Identity.IsAuthenticated)
        {
            var identity = User.Identity as System.Security.Claims.ClaimsIdentity;
            if (identity != null)
            {
                <ul>
                    @foreach (var claim in identity.Claims)
                    {
                        <li>@claim.Type: @claim.Value</li>
                    }
                </ul>
            }
            else
            {
                <p class="warning">Identity is not ClaimsIdentity</p>
            }
        }
        else
        {
            <p class="error">Not authenticated - no claims available</p>
        }
    </div>
    
    <div class="section">
        <h3>7. Session</h3>
        <p>
            SessionID: @(Session?.SessionID ?? "NULL")<br/>
            Session Timeout: @(Session?.Timeout ?? 0) minutes
        </p>
    </div>
    
    <div class="section">
        <a href="@Url.Action("Index", "Home")">← Back to Home</a>
    </div>
</body>
</html>

